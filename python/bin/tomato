#!/bin/sh
# tomato run FILE [ENTRY [INPUTS...]] [--llvm FILE.ll ...]
# tomato compile FILE [-o OUT] [--llvm FILE.ll ...]
# Uses the .venv next to the package when there is one (it has llvmlite for `!x` calls).
src="$0"
while [ -L "$src" ]; do
  dir=$(cd "$(dirname "$src")" && pwd)
  src=$(readlink "$src")
  case "$src" in /*) ;; *) src="$dir/$src" ;; esac
done
root="$(cd "$(dirname "$src")/.." && pwd)"
py="$root/.venv/bin/python"
[ -x "$py" ] || py=python3
PYTHONPATH="$root${PYTHONPATH:+:$PYTHONPATH}" exec "$py" -m tomato "$@"
