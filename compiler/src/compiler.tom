# The Tomato compiler, written in Tomato (D38a). It compiles itself, and it is the only implementation.
#
# It takes the syntax tree from compiler/src/parser.tom and writes LLVM IR text that links with the C runtime
# (runtime/tomato_rt.c). compile_module at the end is the entry point: it loads the built-ins (std/builtin/) and every imported module,
# collects the classes, interfaces and functions (Mod), then compiles each function (Gen) and adds the type tables.
# Types are written as short texts: int, str, list[int], @Class, %Interface, U:a;b for a union, str? for str | None, and
# iN / uN for fixed-width integers. Heap values are reference counted: whoever an expression's value is handed to owns it.
# A problem with the program is raised as a CompileError and reported by diag.tom.
from parser import Node, Val, parse, is_operator_marker, ParseError, val_node, val_nodes, vn, mk, vs, vz, vlist, vtuple, vnodes, vb
from lexer import LexError, parse_format_spec
from diag import Diagnostic, format_error, closest
from lint import lint_items, falls_through

class NeedsEarlyCopy(Error):
    # a copy of a generic class is first made after code that loops over every class that fits an Iterable or Sized type was
    # compiled, so that code missed it: the compile starts again with the copy made first (D60a). The message is the class and its type arguments
    @init
    def make(self, message: str):
        Error.start(self, message)

export class CompileError(Error):
    line: int = 0
    col: int = 0

    @init
    def make(self, message: str, line: int, col: int = 0):
        Error.start(self, message)
        self.line = line
        self.col = col

def basic_type(name: str) -> bool:
    return name == 'int' or name == 'bool' or name == 'str' or name == 'File' or name == 'float'

def is_list(t: str) -> bool:
    return t.startswith('list[') or t.startswith('tuple[')

def is_dict(t: str) -> bool:
    return t.startswith('dict[')

# a tuple of mixed item types, tuple[str, int]: written 'tup[' and its item types joined by ','. It has a fixed length and is stored
# like an object with one 8-byte field per item (after the reference count and type code), so the runtime frees and traces it as one
def is_mtuple(t: str) -> bool:
    return t.startswith('tup[')

def mtuple_items(t: str) -> list[str]:
    inner = t[4:-1]
    parts: list[str] = []
    depth = 0
    start = 0
    for k in range(len(inner)):
        ch = inner[k]
        if ch == '[':
            depth += 1
        elif ch == ']':
            depth -= 1
        elif ch == ',' and depth == 0:
            parts.append(inner[start:k])
            start = k + 1
    parts.append(inner[start:])
    return parts

# the number of names `a, b = value` or `for a, b in pairs` takes the value apart into, when n is the hidden variable the parser
# holds the value in (named _unpack..x2 or _pairs..x2); -1 for any other expression
def unpack_count(n: Node) -> int:
    if n.kind != 'Name':
        return -1
    name = n.fields[0].text
    if not (name.startswith('_unpack') or name.startswith('_pairs')) or name.rfind('x') < 0:
        return -1
    digits = name[name.rfind('x') + 1:]
    if not digits.isdigit():
        return -1
    return int(digits)

def mtuple_type(items: list[str]) -> str:
    return 'tup[' + ','.join(items) + ']'

def is_set(t: str) -> bool:
    return t.startswith('set[')

# the type inside the brackets: the item type of list[T], tuple[T] and set[T], the value type of dict[V] (whose keys are text)
def elem_of(t: str) -> str:
    return t[t.find('[') + 1:-1]

def set_elem(t: str) -> str:
    return elem_of(t)

def dict_value(t: str) -> str:
    return elem_of(t)

def is_class(t: str) -> bool:
    return t.startswith('@')

def is_iface(t: str) -> bool:
    return t.startswith('%')

def is_union(t: str) -> bool:
    # a union of several types is written 'U:' and its members (sorted, so the same members always give the same type) joined by ';'
    return t.startswith('U:')

def union_members(t: str) -> list[str]:
    return t[2:].split(';')

def union_type(members: list[str]) -> str:
    return 'U:' + ';'.join(sorted(members))

# a function value, fn(A, B) -> R, is written 'fn[A,B>R]' (R is None when it returns nothing)
def is_fn(t: str) -> bool:
    return t.startswith('fn[')

# the position of the > that ends the parameter types of a function type
def fn_arrow(t: str) -> int:
    depth = 0
    for k in range(3, len(t) - 1):
        ch = t[k]
        if ch == '[':
            depth += 1
        elif ch == ']':
            depth -= 1
        elif ch == '>' and depth == 0:
            return k
    return -1

def fn_result(t: str) -> str:
    return t[fn_arrow(t) + 1:-1]

# the types in a comma-separated list of types, splitting only at the commas outside brackets ('' gives none)
def split_types(inner: str) -> list[str]:
    parts: list[str] = []
    if inner == '':
        return parts
    depth = 0
    start = 0
    for k, ch in enumerate(inner):
        if ch == '[':
            depth += 1
        elif ch == ']':
            depth -= 1
        elif ch == ',' and depth == 0:
            parts.append(inner[start:k])
            start = k + 1
    parts.append(inner[start:])
    return parts

# the parameter types of a function type
def fn_params(t: str) -> list[str]:
    return split_types(t[3:fn_arrow(t)])

# The built-in interfaces (D50a): 'I:T' is Iterable[T], 'Z' is Sized and 'IZ:T' is Iterable[T] & Sized. A value of one of these types
# is a box like a union's, holding whatever concrete value was passed (a list, text, a range, an object with @iter or @len).
def is_dyn(t: str) -> bool:
    return t == 'Z' or t.startswith('I:') or t.startswith('IZ:')

def dyn_iterable(t: str) -> bool:
    return t != 'Z'

def dyn_sized(t: str) -> bool:
    return t == 'Z' or t.startswith('IZ:')

# the item type of an Iterable type
def dyn_item(t: str) -> str:
    if t.startswith('IZ:'):
        return t[3:]
    return t[2:]

# lists, tuples, sets and dicts share one layout, so one box member stands for all of them
def dyn_seq() -> str:
    return 'list[int]'

def box_kind(member: str) -> int:
    # how the runtime prints a boxed value: 1 whole number, 3 float, 4 text, 5 bool, 6 anything else
    if member == 'int':
        return 1
    if member == 'float':
        return 3
    if member == 'str':
        return 4
    if member == 'bool':
        return 5
    return 6

def digits_value(s: str) -> int:
    # the number a text of ASCII digits writes, or -1 when it is not all such digits (isdigit() also takes other scripts' digits)
    if len(s) == 0:
        return -1
    for d in s:
        if d not in '0123456789':
            return -1
    v = 0
    for c in s:
        v = v * 10 + ord(c) - ord('0')
    return v

def is_fixed(t: str) -> bool:
    # int[length=N] is written iN and uint[length=N] uN
    if len(t) < 2:
        return False
    if not (t.startswith('i') or t.startswith('u')):
        return False
    return digits_value(t[1:]) > 0

def is_numeric(t: str) -> bool:
    return t == 'int' or is_fixed(t)

def bits_of(t: str) -> int:
    if t == 'int':
        return 64
    return digits_value(t[1:])

def is_signed(t: str) -> bool:
    return t == 'int' or t.startswith('i')

def contains(outer: str, inner: str) -> bool:
    # every value of integer type inner is a value of outer
    if is_signed(outer):
        if is_signed(inner):
            return bits_of(outer) >= bits_of(inner)
        return bits_of(outer) > bits_of(inner)
    if is_signed(inner):
        return False
    return bits_of(outer) >= bits_of(inner)

def fits_literal(n: int, t: str, negative: bool) -> bool:
    # does the literal n (written with a minus sign when negative) fit the integer type t?
    bits = bits_of(t)
    if is_signed(t):
        if bits >= 64:
            return True
        if negative:
            return n <= 2 ** (bits - 1)
        return n <= 2 ** (bits - 1) - 1
    if negative:
        return n == 0
    if bits >= 63:
        return True
    return n <= 2 ** bits - 1

def operator_marker_of(op: str) -> str:
    # the marker of the method that implements an operator ('' when the operator cannot be customised)
    if op == '+':
        return 'add'
    if op == '-':
        return 'sub'
    if op == '*':
        return 'mul'
    if op == '/':
        return 'div'
    if op == '//':
        return 'floordiv'
    if op == '%':
        return 'mod'
    if op == '**':
        return 'pow'
    if op == '==' or op == '!=':
        return 'eq'
    if op == '<':
        return 'lt'
    if op == '<=':
        return 'le'
    if op == '>':
        return 'gt'
    if op == '>=':
        return 'ge'
    if op == '&':
        return 'bitand'
    if op == '|':
        return 'bitor'
    if op == '^':
        return 'bitxor'
    return ''

def signed_cc(op: str) -> str:
    # the icmp condition of a comparison operator on signed numbers (or on the result of a three-way compare against 0)
    if op == '!=':
        return 'ne'
    if op == '<':
        return 'slt'
    if op == '<=':
        return 'sle'
    if op == '>':
        return 'sgt'
    if op == '>=':
        return 'sge'
    return 'eq'

# An async function runs as a frame: a heap object holding its variables and where it stopped. These fields come first, then the variables.
# 0 resume function, 1 where it stopped, 2 status (0 running, 1 done, 2 failed), 3 the tasks waiting for it, 4 its error, 5 and 6 the error line and kind,
# 7 text handed in by input, 8 the result, 9 the statuses it yielded, 10 how many of them were read
const FRAME_FIXED = 13

def is_task(t: str) -> bool:
    return t.startswith('task[')

def task_result(t: str) -> str:
    # task[T] and task[T, S] hold T, with 'None' for a function that returns nothing
    inner = elem_of(t)
    cut = inner.find(';')
    if cut >= 0:
        return inner[:cut]
    return inner

def task_status(t: str) -> str:
    inner = elem_of(t)
    cut = inner.find(';')
    if cut >= 0:
        return inner[cut + 1:]
    return ''

def contains_await(n: Node) -> bool:
    if n.kind == 'Await':
        return True
    for f in n.fields:
        if val_has_await(f):
            return True
    return False

def val_has_await(v: Val) -> bool:
    if v.tag == 'n':
        return contains_await(val_node(v))
    if v.tag == 'l' or v.tag == 't':
        for item in v.items:
            if val_has_await(item):
                return True
    return False

def task_type_of(info: FuncInfo) -> str:
    res = info.ret
    if res == '':
        res = 'None'
    if info.yields != '':
        return f'task[{res};{info.yields}]'
    return f'task[{res}]'

def is_optional(t: str) -> bool:
    return t.endswith('?')

def strip_optional(t: str) -> str:
    if is_optional(t):
        return t[:-1]
    return t

def is_rc(t: str) -> bool:
    # heap values are reference counted; None is the null pointer, which counting ignores (D23b)
    return t == 'str' or is_task(t) or is_list(t) or is_dict(t) or is_set(t) or is_class(t) or is_iface(t) or t == 'None' or is_optional(t) or is_union(t) or is_dyn(t) or is_mtuple(t)

def shown_generic(name: str) -> str:
    # a copy of a generic class, as Box[int]: its type arguments are kept in the internal form inside the name
    at = name.find('[')
    parts: list[str] = [shown(p) for p in split_types(name[at + 1:-1])]
    return name[:at] + '[' + ', '.join(parts) + ']'

def shown(t: str) -> str:
    # a type as the user writes it
    if is_fn(t):
        shown_params: list[str] = [shown(p) for p in fn_params(t)]
        res = fn_result(t)
        if res == 'None':
            return 'fn(' + ', '.join(shown_params) + ')'
        return 'fn(' + ', '.join(shown_params) + ') -> ' + shown(res)
    if is_task(t):
        if task_status(t) != '':
            return f'task[{shown(task_result(t))}, {shown(task_status(t))}]'
        return f'task[{shown(task_result(t))}]'
    if t == 'Z':
        return 'Sized'
    if t.startswith('I:'):
        return f'Iterable[{shown(dyn_item(t))}]'
    if t.startswith('IZ:'):
        return f'Iterable[{shown(dyn_item(t))}] & Sized'
    if is_optional(t):
        return f'{shown(strip_optional(t))} | None'
    if is_class(t) and t.find('[') > 0:
        return shown_generic(t[1:])
    if is_class(t) or is_iface(t):
        return t[1:]
    if is_union(t):
        parts: list[str] = [shown(m) for m in union_members(t)]
        return ' | '.join(parts)
    if t.startswith('tuple['):
        return f'tuple[{shown(elem_of(t))}]'
    if is_mtuple(t):
        shown_items: list[str] = [shown(m) for m in mtuple_items(t)]
        return 'tuple[' + ', '.join(shown_items) + ']'
    if is_list(t):
        return f'list[{shown(elem_of(t))}]'
    if is_dict(t):
        return f'dict[str, {shown(dict_value(t))}]'
    if is_set(t):
        return f'set[{shown(set_elem(t))}]'
    if is_fixed(t):
        if t.startswith('i'):
            return 'int[length=' + t[1:] + ']'
        return 'uint[length=' + t[1:] + ']'
    return t

def llvm_type(t: str) -> str:
    if is_rc(t) or t == 'File' or is_fn(t):
        return 'ptr'
    if t == 'float':
        return 'double'
    if is_fixed(t):
        return 'i' + t[1:]
    return 'i64'

def zero_of(t: str) -> str:
    # the value a function returns when it never stored one
    if t == 'int':
        return '1'
    if is_rc(t) or is_fn(t):
        return 'null'
    if t == 'float':
        return '0.0'
    return '0'

# a class or interface name that nothing declares or imports
def not_found(what: str, name: str, line: int) -> CompileError:
    return CompileError(f"the {what} '{name}' does not exist\ncheck its spelling, or import it with 'from module import {name}'", line)

class Ex:
    # a compiled expression: the register or constant that holds it, and its Tomato type
    reg: str = ''
    ty: str = ''
    fresh: bool = False       # an int that the code holding it owns (it frees it or moves it into a place that keeps it), not one borrowed from a variable
    small: bool = False       # an int known to be in the small form, which owns nothing
    list_name: str = ''     # the local list this was read from, when its length and data are kept in registers (see keep_lists)
    unchecked: str = ''     # a float result of + - * whose finite check is left to the operator that uses it (the check on that one covers it)

def ex(reg: str, ty: str) -> Ex:
    e = Ex()
    e.reg = reg
    e.ty = ty
    return e

def exf(reg: str, ty: str) -> Ex:
    # an owned value: a number that nobody else holds (the result of arithmetic or of a call)
    e = ex(reg, ty)
    e.fresh = True
    return e

def exs(reg: str, ty: str) -> Ex:
    # a number known to be small (a length, a position, a loop counter)
    e = ex(reg, ty)
    e.small = True
    return e

def ret_ex(reg: str, ty: str) -> Ex:
    # what a call gave back: the callee hands over a value of its own, so an int is owned
    if ty == 'int':
        return exf(reg, ty)
    return ex(reg, ty)

def small_text(reg: str) -> bool:
    # a constant tagged whole number (written in the IR as digits), which owns nothing
    return reg != '' and (reg[0].isdigit() or reg[0] == '-')

def elem_rc(t: str) -> str:
    # the runtime's flag for list items and table values of type t: 1 reference counted, 2 an int (a big number is copied), 0 plain
    if is_rc(t):
        return '1'
    if t == 'int':
        return '2'
    return '0'

def item_width(t: str) -> int:
    # the bytes one item takes in the storage of a list of type t. A list whose item type is fixed (bool, i8..i32, u8..u32)
    # keeps its items at that width, without the 8-byte slot; every other list, and every tuple, keeps 8-byte slots.
    # A float is already a plain 8-byte double and an int is one tagged 8-byte word (a big number is a pointer in it).
    if not t.startswith('list['):
        return 8
    e = elem_of(t)
    if e == 'bool':
        return 1
    if is_fixed(e):
        b = bits_of(e)
        if b == 8 or b == 16 or b == 32:
            return b // 8
    return 8

def list_flags(t: str) -> str:
    # the runtime's copy flag for the items of a list of type t (elem_rc) plus, for compact items, their width in bytes times 4
    w = item_width(t)
    if w != 8:
        return str(w * 4)
    return elem_rc(elem_of(t))

def item_llvm(w: int) -> str:
    # the LLVM type of one stored item of width w
    return 'i' + str(w * 8)

def pure_read(n: Node) -> bool:
    # an expression that only reads variables and fields, so no user code runs while it is evaluated
    if n.kind == 'Name' or n.kind == 'IntLit' or n.kind == 'FloatLit' or n.kind == 'BoolLit' or n.kind == 'StrLit':
        return True
    if n.kind == 'Attr':
        return pure_read(val_node(n.fields[0]))
    if n.kind == 'UnOp':
        return pure_read(val_node(n.fields[1]))
    return False

def self_update_leaves(name: str, n: Node) -> int:
    # for `name = <n>`: how many times the variable is read in n, or -1 when n is not an arithmetic tree that can hand the old
    # number to an operation. Only + - * and a division or modulo by a non-zero constant (they cannot stop the program after
    # the old number is used up); every other leaf is a literal or a variable.
    if n.kind == 'IntLit':
        return 0
    if n.kind == 'Name':
        if n.fields[0].text == name:
            return 1
        return 0
    if n.kind != 'BinOp':
        return -1
    op = n.fields[0].text
    left = val_node(n.fields[1])
    right = val_node(n.fields[2])
    if op == '//' or op == '%':
        if right.kind != 'IntLit' or right.fields[0].num == 0:
            return -1
    elif op != '+' and op != '-' and op != '*':
        return -1
    a = self_update_leaves(name, left)
    b = self_update_leaves(name, right)
    if a < 0 or b < 0:
        return -1
    return a + b

def self_update(name: str, n: Node) -> bool:
    # `x = 3 * x + 1`, `x = x // 2`, `x = x + 1`: x is read once and the right side is built from + - * and constant divisors
    return n.kind == 'BinOp' and self_update_leaves(name, n) == 1

# the names a lambda body reads
def names_read(n: Node, out: list[str]):
    if n.kind == 'Name':
        out.append(n.fields[0].text)
    for f in n.fields:
        names_read_val(f, out)

def names_read_val(v: Val, out: list[str]):
    if v.tag == 'n':
        names_read(val_node(v), out)
    elif v.tag == 'l' or v.tag == 't':
        for it in v.items:
            names_read_val(it, out)

def has_comp(n: Node) -> bool:
    # does this expression contain a list comprehension (the one expression that assigns to variables)?
    if n.kind == 'ListComp':
        return True
    for f in n.fields:
        if val_has_comp(f):
            return True
    return False

def val_has_comp(v: Val) -> bool:
    if v.tag == 'n':
        return has_comp(val_node(v))
    if v.tag == 'l' or v.tag == 't':
        for it in v.items:
            if val_has_comp(it):
                return True
    return False

# ---- integer ranges (see Gen.range_of and Gen.loop_facts). A Rng is an interval that certainly holds the number in an int
# local. Only the open side of a bound is unbounded: a lower bound at -RANGE_INF or below means "no lower bound" and an upper
# bound at RANGE_INF or above means "no upper bound"; every other bound is the number it says (a lower bound of 2^64 is the
# number 2^64). Bounds are only ever moved outwards (b_clamp), so an interval never loses a value. Facts maps int locals to their intervals at one point
# of a function. A local with no entry may hold anything, including the word 0 of a slot nothing has written yet: only a
# local last assigned an int that the program computed (a literal, arithmetic, a range loop's variable) gets an entry, and
# refining a local by a condition never creates one, so an entry inside the small range always means a tagged small int.
# A float local can have an entry too (fl is True): its value is then certainly finite (no infinity, no NaN) and lies in the
# interval, whose bounds are whole numbers rounded outwards (see frng). A bound at FLOAT_INF or beyond, on either side, means
# only "finite". The real bound is 2^1024; the cap is far below it, so a result inside the cap needs no finite check.
const RANGE_INF = 18446744073709551616
const SMALL_LO = -4611686018427387904
const SMALL_HI = 4611686018427387903
const REFINE_DEPTH = 5
const FLOAT_INF = 115792089237316195423570985008687907853269984665640564039457584007913129639936
const FLOAT_EXACT = 9007199254740992

class Rng:
    lo: int = 0
    hi: int = 0
    fl: bool = False          # the interval of a float

class Facts:
    m: dict[str, Rng] = {}
    dead: bool = False        # no run of the program reaches this point

class LoopAI:
    # what the analysis of one loop body collected: the facts at each continue and each break that belongs to the loop
    conts: list[Facts] = []
    brks: list[Facts] = []

class LoopFacts:
    head: Facts = Facts()     # at the loop head, before the condition
    post: Facts = Facts()     # after the loop

def rng(lo: int, hi: int) -> Rng:
    r = Rng()
    r.lo = lo
    r.hi = hi
    return r

def rng_small(r: Rng) -> bool:
    return not r.fl and r.lo >= SMALL_LO and r.hi <= SMALL_HI

def b_clamp(x: int) -> int:
    # keeps the numbers small: a lower bound above RANGE_INF becomes RANGE_INF (a smaller lower bound), an upper bound below
    # -RANGE_INF becomes -RANGE_INF, and anything beyond on the open side becomes unbounded. Each move is outwards.
    if x >= RANGE_INF:
        return RANGE_INF
    if x <= -RANGE_INF:
        return -RANGE_INF
    return x

def b_add(x: int, y: int, upper: bool) -> int:
    # the sum of two lower bounds (upper False) or two upper bounds; only an unbounded side stays unbounded
    if upper:
        if x >= RANGE_INF or y >= RANGE_INF:
            return RANGE_INF
    elif x <= -RANGE_INF or y <= -RANGE_INF:
        return -RANGE_INF
    return b_clamp(x + y)

def b_ext(x: int, lower: bool) -> int:
    # a bound as an extended number: -1 for "no lower bound", 1 for "no upper bound", else 0 (the bound is the number x)
    if lower and x <= -RANGE_INF:
        return -1
    if not lower and x >= RANGE_INF:
        return 1
    return 0

def b_mul(x: int, xlower: bool, y: int, ylower: bool) -> int:
    # one corner of an interval product; an unbounded factor gives an unbounded product (0 times it is 0, as in interval
    # arithmetic: the other corners give the unbounded side)
    kx = b_ext(x, xlower)
    ky = b_ext(y, ylower)
    if (kx == 0 and x == 0) or (ky == 0 and y == 0):
        return 0
    if kx != 0 or ky != 0:
        sx = kx if kx != 0 else (1 if x > 0 else -1)
        sy = ky if ky != 0 else (1 if y > 0 else -1)
        return RANGE_INF if sx == sy else -RANGE_INF
    return x * y

def b_min(x: int, y: int) -> int:
    return x if x < y else y

def b_max(x: int, y: int) -> int:
    return x if x > y else y

def rng_add(a: Rng, b: Rng) -> Rng:
    return rng(b_add(a.lo, b.lo, False), b_add(a.hi, b.hi, True))

def rng_neg(a: Rng) -> Rng:
    return rng(-a.hi, -a.lo)

def rng_mul(a: Rng, b: Rng) -> Rng:
    p1 = b_mul(a.lo, True, b.lo, True)
    p2 = b_mul(a.lo, True, b.hi, False)
    p3 = b_mul(a.hi, False, b.lo, True)
    p4 = b_mul(a.hi, False, b.hi, False)
    # the smallest corner as a lower bound and the largest as an upper bound, each moved outwards to fit
    return rng(b_clamp(b_min(b_min(p1, p2), b_min(p3, p4))), b_clamp(b_max(b_max(p1, p2), b_max(p3, p4))))

def rng_floordiv(a: Rng, d: int) -> Rng:
    # a // d for a constant d != 0; floor division is monotone in a (increasing for d > 0, decreasing for d < 0)
    if d > 0:
        lo = -RANGE_INF if a.lo <= -RANGE_INF else b_clamp(a.lo // d)
        hi = RANGE_INF if a.hi >= RANGE_INF else b_clamp(a.hi // d)
        return rng(lo, hi)
    lo = -RANGE_INF if a.hi >= RANGE_INF else b_clamp(a.hi // d)
    hi = RANGE_INF if a.lo <= -RANGE_INF else b_clamp(a.lo // d)
    return rng(lo, hi)

# ---- float intervals. fl(x) stands for a real number rounded to the nearest float. Rounding keeps order, so a result that lies
# between two whole numbers which are floats themselves still does after rounding; f_bound moves a bound outwards to such a number.
def f_bound(x: int, upper: bool) -> int:
    # every whole number up to 2^53 is a float; a larger bound moves outwards to a power of two, which is one too
    if x >= -FLOAT_EXACT and x <= FLOAT_EXACT:
        return x
    m = x if x > 0 else -x
    if m >= FLOAT_INF:
        if (x > 0) == upper:
            return FLOAT_INF if upper else -FLOAT_INF
        m = FLOAT_INF                 # on the inner side: a bound nearer to 0 is further out
    p = FLOAT_EXACT
    while p * 2 <= m:
        p *= 2
    if (x > 0) == upper and p < m:
        p *= 2
    return p if x > 0 else -p

def frng(lo: int, hi: int) -> Rng:
    r = rng(f_bound(lo, False), f_bound(hi, True))
    r.fl = True
    return r

def frng_any() -> Rng:
    return frng(-FLOAT_INF, FLOAT_INF)

def frng_bounded(r: Rng) -> bool:
    return r.lo > -FLOAT_INF and r.hi < FLOAT_INF

def frng_of(r: Rng) -> Rng | None:
    # an interval as a float's: a float's own, or an int's after its conversion to a float (an unbounded int may be too big)
    if r.fl:
        return r
    if r.lo <= -RANGE_INF or r.hi >= RANGE_INF:
        return None
    return frng(r.lo, r.hi)

def frng_hull(m: int) -> Rng:
    return frng(-m, m)

def frng_reach(r: Rng) -> int:
    # the largest magnitude in r
    return b_max(r.hi, -r.lo)

def float_literal_range(mantissa: int, scale: int) -> Rng | None:
    # the interval of the literal mantissa / 10^scale
    if scale <= 0:
        if scale < -80:
            return None
        v = mantissa * 10 ** -scale
        return frng(v, v)
    if scale > 400:
        return None
    d = 10 ** scale
    return frng(mantissa // d, (mantissa + d - 1) // d)

def frng_op(op: str, a: Rng, b: Rng) -> Rng:
    # + - * of two floats that did not fail: finite, and inside the interval of the exact result
    if not (frng_bounded(a) and frng_bounded(b)):
        return frng_any()
    if op == '+':
        return frng(a.lo + b.lo, a.hi + b.hi)
    if op == '-':
        return frng(a.lo - b.hi, a.hi - b.lo)
    p1 = a.lo * b.lo
    p2 = a.lo * b.hi
    p3 = a.hi * b.lo
    p4 = a.hi * b.hi
    return frng(b_min(b_min(p1, p2), b_min(p3, p4)), b_max(b_max(p1, p2), b_max(p3, p4)))

def root_bound(h: int) -> int:
    # a whole number r for which fl(x * x) <= h means -r <= x <= r: the smallest power of two with r * r >= 2 * h. (For |x| > r
    # the exact square is above 2 * h and above 1, so its rounded value, off by one part in 2^53 at most, is above h.)
    r = 1
    while r * r < 2 * h:
        r *= 2
    return r

def rng_empty(lo: int, hi: int) -> bool:
    # no number lies in [lo, hi]; an unbounded side is never empty
    return lo > -RANGE_INF and hi < RANGE_INF and lo > hi

def facts_new() -> Facts:
    f = Facts()
    m: dict[str, Rng] = {}
    f.m = m
    return f

def facts_dead() -> Facts:
    f = facts_new()
    f.dead = True
    return f

def facts_copy(f: Facts) -> Facts:
    g = facts_new()
    g.dead = f.dead
    for k in f.m:
        g.m[k] = f.m[k]
    return g

def facts_kill(f: Facts, names: list[str]) -> Facts:
    g = facts_new()
    g.dead = f.dead
    for k in f.m:
        if k not in names:
            g.m[k] = f.m[k]
    return g

def facts_set(f: Facts, name: str, r: Rng) -> Facts:
    g = facts_copy(f)
    g.m[name] = r
    return g

def facts_join(a: Facts, b: Facts) -> Facts:
    # the facts that hold on both ways in: each interval grows to cover both, and a local known on one side only is unknown
    if a.dead:
        return facts_copy(b)
    if b.dead:
        return facts_copy(a)
    g = facts_new()
    for k in a.m:
        if k in b.m:
            x = a.m[k]
            y = b.m[k]
            if x.fl == y.fl:
                r = rng(b_min(x.lo, y.lo), b_max(x.hi, y.hi))
                r.fl = x.fl
                g.m[k] = r
    return g

def facts_widen(old: Facts, nxt: Facts) -> Facts:
    # a bound that is still moving is dropped, so the loop analysis ends after a few rounds
    if old.dead:
        return facts_copy(nxt)
    if nxt.dead:
        return facts_copy(old)
    g = facts_new()
    for k in nxt.m:
        if k in old.m:
            x = old.m[k]
            y = nxt.m[k]
            if x.fl != y.fl:
                continue
            top = FLOAT_INF if x.fl else RANGE_INF
            lo = x.lo if y.lo >= x.lo else -top
            hi = x.hi if y.hi <= x.hi else top
            r = rng(lo, hi)
            r.fl = x.fl
            g.m[k] = r
    return g

def facts_same(a: Facts, b: Facts) -> bool:
    if a.dead or b.dead:
        return a.dead == b.dead
    if len(a.m) != len(b.m):
        return False
    for k in a.m:
        if k not in b.m:
            return False
        if a.m[k].lo != b.m[k].lo or a.m[k].hi != b.m[k].hi or a.m[k].fl != b.m[k].fl:
            return False
    return True

def bound_names(n: Node, out: list[str]):
    # every local a statement or expression can assign, over-approximated: assignment and declaration targets, loop variables
    # (of comprehensions too, and the names a `for k, v in d.items()` loop sets directly) and catch names. A lambda has its own scope.
    k = n.kind
    if k == 'Lambda':
        return
    if k == 'Assign':
        t = val_node(n.fields[0])
        if t.kind == 'Name':
            out.append(t.fields[0].text)
    elif k == 'Declare' or k == 'For' or k == 'AsyncFor':
        if n.fields[0].tag == 's':
            out.append(n.fields[0].text)
        if k == 'For' and len(n.fields) > 3:
            for v in n.fields[3].items:
                out.append(v.text)
    elif k == 'Try':
        for h in n.fields[1].items:
            if h.items[1].tag == 's':
                out.append(h.items[1].text)
    for f in n.fields:
        bound_names_val(f, out)

def bound_names_val(v: Val, out: list[str]):
    if v.tag == 'n':
        bound_names(val_node(v), out)
    elif v.tag == 'l' or v.tag == 't':
        for it in v.items:
            bound_names_val(it, out)

def comp_names(n: Node, out: list[str]):
    # the loop variables of the list comprehensions in n, which the comprehension assigns while n runs
    if n.kind == 'ListComp':
        bound_names(n, out)
        return
    if n.kind == 'Lambda':
        return
    for f in n.fields:
        comp_names_val(f, out)

def comp_names_val(v: Val, out: list[str]):
    if v.tag == 'n':
        comp_names(val_node(v), out)
    elif v.tag == 'l' or v.tag == 't':
        for it in v.items:
            comp_names_val(it, out)

def loop_jump(n: Node) -> bool:
    # a break or continue in n that leaves the loop around n (not one of a loop inside n)
    k = n.kind
    if k == 'Break' or k == 'Continue':
        return True
    if k == 'For' or k == 'While' or k == 'AsyncFor' or k == 'ListComp' or k == 'Lambda':
        return False
    for f in n.fields:
        if loop_jump_val(f):
            return True
    return False

def loop_jump_val(v: Val) -> bool:
    if v.tag == 'n':
        return loop_jump(val_node(v))
    if v.tag == 'l' or v.tag == 't':
        for it in v.items:
            if loop_jump_val(it):
                return True
    return False

def flip_compare(op: str) -> str:
    # a OP b is b flip(OP) a
    if op == '<':
        return '>'
    if op == '>':
        return '<'
    if op == '<=':
        return '>='
    if op == '>=':
        return '<='
    return op

def negate_compare(op: str) -> str:
    # not (a OP b) for whole numbers
    if op == '<':
        return '>='
    if op == '>=':
        return '<'
    if op == '>':
        return '<='
    if op == '<=':
        return '>'
    if op == '==':
        return '!='
    return '=='

def is_compare_op(op: str) -> bool:
    return op == '==' or op == '!=' or op == '<' or op == '<=' or op == '>' or op == '>='

class FuncInfo:
    name: str = ''
    line: int = 0            # the line of the def
    owner: str = ''          # the class a method belongs to, or ''
    ret: str = ''
    ptypes: list[str] = []   # without self
    pnames: list[str] = []   # the names of the parameters, in order
    stars: int = 0           # how many trailing parameters are *args or **kwargs
    has_varargs: bool = False
    has_kwargs: bool = False
    defaults: list[Node] = []     # the default values of the last parameters, in order
    is_init: bool = False
    op: str = ''           # the operator a method implements (@add and the other operator markers), or ''
    is_override: bool = False
    is_private: bool = False
    is_gen: bool = False     # the body has a yield: a generator, only usable as what a for loop loops over
    is_async: bool = False   # async def: calling it makes a task, which await or start runs
    yields: str = ''        # what an async function yields as status, or ''
    key: str = ''            # the program-wide name of a function (module.name outside the main program)
    module: str = 'main'
    targs: dict[str, str] = {}   # what the type parameters of a generic class or function stand for in this copy (D60a)

class ImportInfo:
    importer: str = ''
    module: str = ''
    names: list[str] = []
    line: int = 0

class IfaceInfo:
    name: str = ''
    module: str = 'main'
    parents: list[str] = []
    reqs: list[FuncInfo] = []     # the methods the interface itself requires (without self)
    line: int = 0

class FieldInfo:
    name: str = ''
    ty: str = ''
    is_private: bool = False
    is_const: bool = False
    owner: str = ''                # the class that declares the field
    default: Node | None = None   # the starting value, when the field has one

class ClassInfo:
    name: str = ''                # the program-wide key (module.Name outside the main program)
    display: str = ''             # the name as written
    module: str = 'main'
    node: Node | None = None
    fields: list[FieldInfo] = []  # parent fields first
    init: str = ''                # the name of the @init method, or ''
    parent: str = ''              # the parent class, or ''
    ifaces: list[str] = []        # the interfaces the class declares it implements
    done: bool = False            # fields and defaults are complete (inherited ones come first)
    is_frame: bool = False        # the frame of an async function, made by the compiler: no constructor or methods
    line: int = 0
    targs: dict[str, str] = {}    # the type arguments of a copy of a generic class (D60a)
    generic: str = ''             # the generic class this is a copy of, or ''
    populated: bool = True        # the methods of a copy of a generic class are in mod.infos

class Body:
    # a compiled function whose text is not final yet (see finish_bodies)
    symbol: str = ''
    head: str = ''
    lines: list[str] = []
    raises: bool = False          # it can leave an error pending when it returns
    uses: list[str] = []          # the program functions it mentions (it may call them)
    checks: list[int] = []        # the lines that test for an error after a direct call; each ends with `; @function`
    epilogue: int = 0             # the line of its `epilogue:` label

# the largest loop nest, in nodes, that is compiled twice (see Gen.nest_loop)
const NEST_NODES = 700

def range_for(s: Node) -> bool:
    # for i in range(...)
    it = val_node(s.fields[1])
    return len(s.fields) == 3 and it.kind == 'Call' and val_node(it.fields[0]).kind == 'Name' and val_node(it.fields[0]).fields[0].text == 'range' and len(val_nodes(it.fields[1])) > 0 and len(val_nodes(it.fields[1])) <= 3

def nest_expr(n: Node) -> bool:
    # no expression in a nest may hold a loop of its own, a lambda or an await
    if n.kind == 'ListComp' or n.kind == 'Lambda' or n.kind == 'Await' or n.kind == 'Start':
        return False
    for f in n.fields:
        if not nest_expr_val(f):
            return False
    return True

def nest_expr_val(v: Val) -> bool:
    if v.tag == 'n':
        return nest_expr(val_node(v))
    if v.tag == 'l' or v.tag == 't':
        for it in v.items:
            if not nest_expr_val(it):
                return False
    return True

def nest_shape(s: Node) -> bool:
    # a loop nest is made only of these statements; another kind of loop, or a try, inside keeps the outer loop from being one
    # (the loops inside are looked at on their own)
    k = s.kind
    if k == 'For':
        it = val_node(s.fields[1])
        return (range_for(s) or (it.kind == 'Name' and len(s.fields) == 3)) and nest_expr(it) and nest_shapes(val_nodes(s.fields[2]))
    if k == 'While':
        return nest_expr(val_node(s.fields[0])) and nest_shapes(val_nodes(s.fields[1]))
    if k == 'If':
        for branch in s.fields[0].items:
            if not nest_expr(val_node(branch.items[0])) or not nest_shapes(val_nodes(branch.items[1])):
                return False
        return s.fields[1].tag != 'l' or nest_shapes(val_nodes(s.fields[1]))
    if k == 'Multi':
        return nest_shapes(val_nodes(s.fields[0]))
    if k == 'Assign' or k == 'Declare' or k == 'ExprStmt' or k == 'Return' or k == 'Raise':
        return nest_expr(s)
    return k == 'Break' or k == 'Continue' or k == 'Pass'

def nest_lists(n: Node, out: list[str]):
    # the variables that the `for x in xs` loops of a nest walk
    if n.kind == 'For' and val_node(n.fields[1]).kind == 'Name':
        out.append(val_node(n.fields[1]).fields[0].text)
    for f in n.fields:
        nest_lists_val(f, out)

def nest_lists_val(v: Val, out: list[str]):
    if v.tag == 'n':
        nest_lists(val_node(v), out)
    elif v.tag == 'l' or v.tag == 't':
        for it in v.items:
            nest_lists_val(it, out)

def nest_shapes(body: list[Node]) -> bool:
    for s in body:
        if not nest_shape(s):
            return False
    return True

def nest_number(s: Node, counter: list[int], on: bool):
    # numbers the statements of a nest (Node.spot), or takes the numbers off again
    counter[0] += 1
    s.spot = counter[0] if on else 0
    k = s.kind
    if k == 'For':
        nest_numbers(val_nodes(s.fields[2]), counter, on)
    elif k == 'While':
        nest_numbers(val_nodes(s.fields[1]), counter, on)
    elif k == 'Multi':
        nest_numbers(val_nodes(s.fields[0]), counter, on)
    elif k == 'If':
        for branch in s.fields[0].items:
            nest_numbers(val_nodes(branch.items[1]), counter, on)
        if s.fields[1].tag == 'l':
            nest_numbers(val_nodes(s.fields[1]), counter, on)

def nest_numbers(body: list[Node], counter: list[int], on: bool):
    for s in body:
        nest_number(s, counter, on)

def fast_linear(n: Node, out: list[int]) -> str:
    # the variable x when n is a * x + b for constants (a and b are added to out), else ''
    c = fast_line_of(n)
    if c.name == '' or c.name == '?':
        return ''
    out.append(c.a)
    out.append(c.b)
    return c.name

class Line:
    # a * name + b; no name means the constant b, and the name '?' anything else
    name: str = ''
    a: int = 0
    b: int = 0

def line_of(name: str, a: int, b: int) -> Line:
    r = Line()
    r.name = name
    r.a = a
    r.b = b
    if abs(a) > 1000000000 or abs(b) > 1000000000:
        r.name = '?'
    return r

def fast_line_of(n: Node) -> Line:
    if n.kind == 'IntLit':
        return line_of('', 0, n.fields[0].num)
    if n.kind == 'UnOp':
        return line_of('', 0, -val_node(n.fields[1]).fields[0].num)
    if n.kind == 'Name':
        return line_of(n.fields[0].text, 1, 0)
    if n.kind != 'BinOp':
        return line_of('?', 0, 0)
    op = n.fields[0].text
    if op != '+' and op != '-' and op != '*':
        return line_of('?', 0, 0)
    x = fast_line_of(val_node(n.fields[1]))
    y = fast_line_of(val_node(n.fields[2]))
    if x.name == '?' or y.name == '?':
        return line_of('?', 0, 0)
    if op == '*':
        if x.name == '':
            return line_of(y.name, x.b * y.a, x.b * y.b)
        if y.name == '':
            return line_of(x.name, y.b * x.a, y.b * x.b)
        return line_of('?', 0, 0)
    sign = 1 if op == '+' else -1
    if x.name != '' and y.name != '' and x.name != y.name:
        return line_of('?', 0, 0)
    return line_of(x.name if x.name != '' else y.name, x.a + sign * y.a, x.b + sign * y.b)

class Binding:
    # a name a module can see, and the program-wide key it stands for
    module: str = ''
    name: str = ''
    key: str = ''
    exported: bool = False

class Mod:
    # what every function of the program shares
    mode: int = 1                 # error output: 1 debug (full text), 2 release (short codes) (D34b)
    errors: list[str] = []        # the messages of std/errors.txt: the code of a message is its line number (release mode)
    strings: list[str] = []       # the text constants, in the order they are numbered
    string_index: dict[str, int] = {}
    infos: list[FuncInfo] = []
    llvm_decls: list[FuncInfo] = []    # the `!name(...)` functions the program declares (D27a)
    consts: dict[str, Node] = {}  # module constants (export const pi = 3.14): the literal each program-wide name stands for
    decls: list[str] = []         # extra declarations (the overflow intrinsics the program uses)
    codes: list[str] = []         # the heap types the program uses; a type's code is 2 plus its place here
    code_index: dict[str, int] = {}
    classes: list[ClassInfo] = []
    frames: list[ClassInfo] = []  # the frames of the async functions
    ifaces: list[IfaceInfo] = []
    slots: list[str] = []         # method names, one vtable slot each
    cur: str = 'main'             # the module whose names are being resolved
    loading: str = ''             # the module being parsed, for a syntax error
    scope: list[Binding] = []     # the names each module can see, in the order they were declared
    helpers: dict[str, FuncInfo] = {}  # functions the compiler writes for itself (printing a list, sorted, ...), by kind and type
    extra_funcs: list[Node] = []
    lambda_count: int = 0
    func_nodes: list[Node] = []   # the FuncDef of each entry of infos, in the same order
    sources: dict[str, str] = {}  # the source text of each module loaded (for showing an error's line)
    helper_count: int = 0
    main_path: str = ''           # the file name shown for the main program
    warnings: list[str] = []      # the finished text of each warning (compiler/src/lint.tom), shown after a program compiles
    tvars: dict[str, str] = {}    # the type parameters in scope and the types they stand for (D60a)
    generics: dict[str, Node] = {}      # the generic classes and functions, by program-wide name
    generic_mods: dict[str, str] = {}   # the module that declared each
    instance_funcs: dict[str, str] = {} # the copies of generic functions made so far: name and type arguments to key
    pending: list[ClassInfo] = []       # copies of generic classes whose methods are not in infos yet
    late: bool = False                  # the bodies are being compiled: a new copy is complete at once
    populating: bool = False            # populate_pending is running: a copy made meanwhile waits for its loop
    instance_count: int = 0
    preload: list[str] = []             # copies of generic classes to make before any body is compiled (see NeedsEarlyCopy)
    dyn_seen: list[str] = []            # the Iterable and Sized types whose loops and lengths are compiled over the classes there are so far
    flat_cache: dict[str, bool] = {}       # flat_type answers, by type
    bodies: list[Body] = []                # the functions compiled so far
    pure_cache: dict[str, bool] = {}       # pure answers, by function key
    float_cache: dict[str, str] = {}       # the copies made by float_copy
    small_cache: dict[str, bool] = {}      # has_small answers, by function symbol
    override_cache: dict[str, bool] = {}   # overridden answers, by class and method name

    def code_of(self, t: str) -> int:
        if t in self.code_index:
            return self.code_index[t]
        self.codes.append(t)
        code = len(self.codes) + 1
        self.code_index[t] = code
        return code

    def error_kind(self, message: str) -> int:
        # compiler-emitted runtime failures use the longest matching runtime prefix in std/errors.txt
        best = 0
        best_len = 0
        for k, known in enumerate(self.errors):
            at = known.find(' ')
            if at < 0 or known.startswith('CompileError '):
                continue
            text = known[at + 1:]
            if len(text) > best_len and message.startswith(text):
                best = k + 1
                best_len = len(text)
        return best

    def compile_error_kind(self, message: str) -> int:
        # the id of a compile-time error: the CompileError entry of std/errors.txt whose template ({} is any text)
        # fits the first line of the message, the one with the most fixed text; 0 if none. Ids are found by matching
        # the text, not attached at the raise sites: a new message needs one line in std/errors.txt (tests/run.sh checks
        # every template in the compiler has one), and a general template such as "{} has no method '{}'" only applies
        # when no more specific one fits.
        head = message.split('\n')[0]
        best = 0
        best_len = 0
        for k, known in enumerate(self.errors):
            if not known.startswith('CompileError '):
                continue
            pieces = known[13:].split('{}')
            fixed = len(known) - 13 - 2 * (len(pieces) - 1)
            if fixed <= best_len or not head.startswith(pieces[0]):
                continue
            if len(pieces) == 1 and head != pieces[0]:
                continue
            at = len(pieces[0])
            fits = True
            for piece in pieces[1:-1]:
                found = head.find(piece, at)
                if found < 0:
                    fits = False
                    break
                at = found + len(piece)
            if len(pieces) > 1:
                fits = fits and head[at:].endswith(pieces[-1])
            if fits:
                best = k + 1
                best_len = fixed
        return best

    def error_id(self, kind: int) -> str:
        if kind == 0:
            return ''
        if kind < 10:
            return f'E0{kind}'
        return f'E{kind}'

    def error_class(self, kind: int) -> str:
        if kind == 0:
            return 'RuntimeError'
        known = self.errors[kind - 1]
        return known[:known.find(' ')]

    def declare(self, text: str):
        if text not in self.decls:
            self.decls.append(text)

    def intern(self, s: str) -> str:
        if s not in self.string_index:
            self.string_index[s] = len(self.strings)
            self.strings.append(s)
        return f'@.str.{self.string_index[s]}'

    def helper(self, kind: str, ty: str, line: int) -> FuncInfo:
        # a function the compiler writes in Tomato for one kind of value (showing a list, sorting one, ...), made the first time it
        # is needed and compiled with the program
        key = f'{kind}:{ty}'
        if key in self.helpers:
            return self.helpers[key]
        self.helper_count += 1
        name = f'_{kind}{self.helper_count}'
        fkey = key_of('builtin', name)
        saved = self.cur
        self.cur = 'builtin'
        saved_vars = self.tvars
        self.tvars = {}
        self.declare_name('builtin', name, fkey, False, 0)
        text = helper_source(self, name, kind, ty, line)
        item = val_nodes(parse(text).fields[0])[0]
        info = function_info(item, self, '')
        helper_types(self, info, kind, ty)
        self.cur = saved
        self.tvars = saved_vars
        self.helpers[key] = info
        self.infos.append(info)
        self.func_nodes.append(item)
        self.extra_funcs.append(item)
        return info

    def node_of(self, info: FuncInfo) -> Node:
        for k, f in enumerate(self.infos):
            if f.key == info.key and f.owner == info.owner and f.name == info.name:
                return self.func_nodes[k]
        raise CompileError(f"internal compiler error: no definition for '{info.name}'", 0)

    def find(self, key: str, line: int) -> FuncInfo:
        for f in self.infos:
            if f.key == key and f.owner == '':
                return f
        raise CompileError(f"the function '{key}' does not exist", line)

    def has_func(self, key: str) -> bool:
        for f in self.infos:
            if f.key == key and f.owner == '':
                return True
        return False

    def lookup_method(self, cls: str, name: str) -> FuncInfo | None:
        # the method as the class or its nearest parent defines it
        for f in self.infos:
            if f.name == name and f.owner == cls:
                return f
        c = self.find_class(cls, 0)
        if c.parent != '':
            return self.lookup_method(c.parent, name)
        return None

    def find_op(self, cls: str, marker: str) -> FuncInfo | None:
        # the method of the class (or its nearest parent) marked as implementing this operator
        for fi in self.infos:
            if fi.owner == cls and fi.op == marker:
                return fi
        c = self.find_class(cls, 0)
        if c.parent != '':
            return self.find_op(c.parent, marker)
        return None

    def has_op(self, cls: str, marker: str) -> bool:
        found = self.find_op(cls, marker)
        return found is not None and not found.is_async

    def find_method(self, cls: str, name: str, line: int) -> FuncInfo:
        found = self.lookup_method(cls, name)
        if found is None:
            raise CompileError(f"'{cls}' has no method '{name}'", line)
        return found

    def resolve(self, name: str) -> str:
        # the program-wide key a name written in the current module stands for, or '' (D24c)
        found = self.binding(self.cur, name)
        if found is None:
            found = self.binding('builtin', name)
        if found is None:
            return ''
        return found.key

    def binding(self, module: str, name: str) -> Binding | None:
        for b in self.scope:
            if b.module == module and b.name == name:
                return b
        return None

    def class_key(self, name: str, line: int) -> str:
        key = self.resolve(name)
        if key == '' or not self.has_class(key):
            raise not_found('class', name, line)
        return key

    def iface_key(self, name: str, line: int) -> str:
        key = self.resolve(name)
        if key == '' or not self.has_iface(key):
            raise not_found('interface', name, line)
        return key

    def declare_name(self, module: str, name: str, key: str, exported: bool, line: int):
        if self.binding(module, name) is not None:
            raise CompileError(f"'{name}' is defined twice in module '{module}'\nrename one of them", line)
        b = Binding()
        b.module = module
        b.name = name
        b.key = key
        b.exported = exported
        self.scope.append(b)

    def exported_key(self, module: str, name: str, line: int) -> str:
        b = self.binding(module, name)
        if b is not None:
            if not b.exported:
                raise CompileError(f"module '{module}' does not export '{name}'\nput 'export' before its definition in {module}.tom", line)
            return b.key
        raise CompileError(f"module '{module}' has no '{name}'\ncheck the spelling in {module}.tom", line)

    def has_iface(self, name: str) -> bool:
        for i in self.ifaces:
            if i.name == name:
                return True
        return False

    def find_iface(self, name: str, line: int) -> IfaceInfo:
        for i in self.ifaces:
            if i.name == name:
                return i
        raise not_found('interface', name, line)

    def iface_closure(self, name: str, out: list[str]):
        # the interface and every interface it extends
        if name in out:
            return
        out.append(name)
        for p in self.find_iface(name, 0).parents:
            self.iface_closure(p, out)

    def class_ifaces(self, cls: str) -> list[str]:
        # every interface a class satisfies: its own, its parents', and what those extend
        out: list[str] = []
        c = self.find_class(cls, 0)
        for i in c.ifaces:
            self.iface_closure(i, out)
        if c.parent != '':
            for i in self.class_ifaces(c.parent):
                self.iface_closure(i, out)
        return out

    def requirement(self, iface: str, name: str) -> FuncInfo | None:
        # the method an interface (or one it extends) requires
        closure: list[str] = []
        self.iface_closure(iface, closure)
        for i in closure:
            for r in self.find_iface(i, 0).reqs:
                if r.name == name:
                    return r
        return None

    def slot_of(self, name: str) -> int:
        for k, n in enumerate(self.slots):
            if n == name:
                return k
        raise CompileError(f'internal compiler error: no method table slot for {name}', 0)

    def assignable(self, a: str, b: str) -> bool:
        # may a value of type a be used where b is wanted (no conversion needed)?
        if a == b or self.subclass(a, b):
            return True
        if is_dyn(a) and is_dyn(b):
            return self.dyn_covers(a, b)
        if is_iface(b):
            if is_class(a) and self.has_class(a[1:]):
                return b[1:] in self.class_ifaces(a[1:])
            if is_iface(a):
                closure: list[str] = []
                self.iface_closure(a[1:], closure)
                return b[1:] in closure
            return False
        if is_union(a) and is_union(b):
            # a narrowed union (some members ruled out) shares the box of the whole one
            for m in union_members(a):
                if m not in union_members(b):
                    return False
            return True
        if is_optional(b):
            return a == 'None' or self.assignable(a, strip_optional(b))
        return False

    # what a for loop yields from a value of type vt, or '' when it cannot loop over one
    def iter_item(self, vt: str) -> str:
        if vt == 'str' or is_dict(vt):
            return 'str'
        if is_list(vt) or is_set(vt):
            return elem_of(vt)
        if is_class(vt) and self.has_class(vt[1:]):
            f = self.find_op(vt[1:], 'iter')
            if f is not None:
                return f.ret
        return ''

    # does len() work on a value of type vt?
    def has_length(self, vt: str) -> bool:
        if vt == 'str' or is_list(vt) or is_dict(vt) or is_set(vt):
            return True
        if is_class(vt) and self.has_class(vt[1:]):
            f = self.find_op(vt[1:], 'len')
            return f is not None and len(f.ptypes) == 0 and f.ret == 'int'
        return False

    # may a value of the concrete type vt be used as the interface type dyn? (no `implements` needed: having the method is enough)
    def dyn_accepts(self, vt: str, dyn: str) -> bool:
        if dyn_iterable(dyn) and self.iter_item(vt) != dyn_item(dyn):
            return False
        return not dyn_sized(dyn) or self.has_length(vt)

    # does the interface type a give everything the interface type b does?
    def dyn_covers(self, a: str, b: str) -> bool:
        if dyn_iterable(b) and not (dyn_iterable(a) and dyn_item(a) == dyn_item(b)):
            return False
        return not dyn_sized(b) or dyn_sized(a)

    # the concrete types a value of an interface type can be holding: the shared container layout, text and every class that fits
    def dyn_members(self, dyn: str) -> list[str]:
        self.dyn_seen.append(dyn)
        out = [dyn_seq()]
        if self.dyn_accepts('str', dyn):
            out.append('str')
        for c in self.classes:
            if self.dyn_accepts('@' + c.name, dyn):
                out.append(f'@{c.name}')
        return out

    def subclass(self, a: str, b: str) -> bool:
        # is class a (written '@A') the same as b or a descendant of it?
        if a == b:
            return True
        if not (is_class(a) and is_class(b)) or not self.has_class(a[1:]):
            return False
        c = self.find_class(a[1:], 0)
        if c.parent == '':
            return False
        return self.subclass(f'@{c.parent}', b)

    def has_class(self, name: str) -> bool:
        for c in self.classes:
            if c.name == name:
                return True
        return False

    def find_class(self, name: str, line: int) -> ClassInfo:
        for c in self.classes:
            if c.name == name:
                return c
        raise not_found('class', name, line)

    def flat_type(self, t: str) -> bool:
        # a value of this static type can never be part of a reference cycle: text, or an object whose class has no
        # reference-counted fields and no subclass (a subclass could add some). Its release skips the cycle-collector test.
        if t == 'str':
            return True
        if not is_class(t):
            return False
        if t in self.flat_cache:
            return self.flat_cache[t]
        found = False
        ans = True
        for c in self.classes:
            if c.name == t[1:]:
                found = True
                if c.is_frame or not c.done or not c.populated:
                    return False
                for f in c.fields:
                    if is_rc(f.ty):
                        ans = False
            if c.parent == t[1:]:
                ans = False
        if not found:
            return False
        self.flat_cache[t] = ans
        return ans

    def overridden(self, cls: str, name: str) -> bool:
        # can an object of class cls, or of a class below it, have another method of this name than the one cls itself uses?
        # Copies of generic classes are made while bodies are compiled, so the generic classes below cls count as if they existed.
        key = f'{cls}.{name}'
        if key in self.override_cache:
            return self.override_cache[key]
        found = False
        for f in self.infos:
            if f.name == name and f.owner != '' and f.owner != cls and self.subclass(f'@{f.owner}', f'@{cls}'):
                found = True
                break
        if not found:
            for gk, node in self.generics.items():
                if node.kind != 'ClassDef' or node.fields[1].tag != 's':
                    continue
                saved = self.cur
                self.cur = self.generic_mods[gk]
                parent = self.class_key(node.fields[1].text, node.line)
                self.cur = saved
                if not self.subclass(f'@{parent}', f'@{cls}'):
                    continue
                for m in val_nodes(node.fields[4]):
                    if m.fields[0].text == name:
                        found = True
        self.override_cache[key] = found
        return found

    def pure(self, key: str) -> bool:
        if key in self.pure_cache:
            return self.pure_cache[key]
        self.pure_cache[key] = False            # (a function that calls itself is not looked into)
        info = self.find(key, 0)
        ok = not info.is_async and not info.is_gen and info.stars == 0 and len(info.defaults) == 0 and pure_number(info.ret)
        for t in info.ptypes:
            if not pure_number(t):
                ok = False
        if ok:
            saved = self.cur
            self.cur = info.module
            ok = self.pure_body(val_nodes(self.node_of(info).fields[3]))
            self.cur = saved
        self.pure_cache[key] = ok
        return ok

    def pure_body(self, body: list[Node]) -> bool:
        for s in body:
            k = s.kind
            if k == 'If':
                for branch in s.fields[0].items:
                    if not self.pure_expr(val_node(branch.items[0])) or not self.pure_body(val_nodes(branch.items[1])):
                        return False
                if s.fields[1].tag == 'l' and not self.pure_body(val_nodes(s.fields[1])):
                    return False
            elif k == 'Assign':
                if val_node(s.fields[0]).kind != 'Name' or not self.pure_expr(val_node(s.fields[1])):
                    return False
            elif k == 'Declare':
                if not self.pure_expr(val_node(s.fields[2])):
                    return False
            elif k == 'Return':
                if s.fields[0].tag == 'n' and not self.pure_expr(val_node(s.fields[0])):
                    return False
            elif k != 'Raise' and k != 'Pass':      # (a raise ends the call; what its message is made of does not matter)
                return False
        return True

    def pure_expr(self, n: Node) -> bool:
        k = n.kind
        if k == 'Name' or k == 'IntLit' or k == 'FloatLit' or k == 'BoolLit':
            return True
        if k == 'UnOp':
            return self.pure_expr(val_node(n.fields[1]))
        if k == 'BinOp':
            return self.pure_expr(val_node(n.fields[1])) and self.pure_expr(val_node(n.fields[2]))
        if k == 'Cond':
            return self.pure_expr(val_node(n.fields[0])) and self.pure_expr(val_node(n.fields[1])) and self.pure_expr(val_node(n.fields[2]))
        if k != 'Call' or len(n.fields[2].items) > 0:
            return False
        for a in val_nodes(n.fields[1]):
            if not self.pure_expr(a):
                return False
        f = val_node(n.fields[0])
        if f.kind == 'LlvmRef':
            return f.fields[0].text == 'tomato_math1' or f.fields[0].text == 'tomato_math2' or f.fields[0].text == 'tomato_is_finite'
        if f.kind != 'Name':
            return False
        if f.fields[0].text == 'float' or f.fields[0].text == 'int':
            return True
        key = self.resolve(f.fields[0].text)
        return key != '' and key not in self.generics and not self.has_class(key) and self.has_func(key) and self.pure(key)

    def float_copy(self, key: str) -> str:
        # std/math.tom takes `int | float`, which a call passes in a box. A function of it that is called with floats only, and whose
        # body does not ask which of the two it got (except _f, which turns it into a float), is compiled again for floats.
        name = key + '.f'
        if name in self.float_cache:
            return self.float_cache[name]
        self.float_cache[name] = ''
        info = self.find(key, 0)
        if info.module != 'math' or 'U:float;int' not in info.ptypes or info.ret != 'float' or info.is_async or info.is_gen or info.stars > 0 or len(info.defaults) > 0:
            return ''
        node = self.node_of(info)
        if info.name != '_f' and asks_type(node):
            return ''
        copy = FuncInfo()
        copy.name = info.name
        copy.line = info.line
        copy.ret = info.ret
        copy.module = info.module
        copy.pnames = info.pnames
        copy.ptypes = ['float' if t == 'U:float;int' else t for t in info.ptypes]
        copy.key = name
        self.infos.append(copy)
        self.func_nodes.append(node)
        self.extra_funcs.append(node)
        self.float_cache[name] = name
        return name

    def field_index(self, c: ClassInfo, name: str, line: int) -> int:
        k = field_position(c, name)
        if k >= 0:
            return k
        raise CompileError(f"'{c.name}' has no field '{name}'", line)

    def has_none_member(self, members: list[Node]) -> bool:
        for m in members:
            if m.fields[0].text == 'None':
                return True
        return False

    def union_of(self, members: list[Node]) -> str:
        # a union of several types (D23g): each member is a type the compiler knows, none repeated
        names: list[str] = []
        for m in members:
            inner = self.type_name(vn(m))
            if inner == '' or is_fixed(inner) or is_optional(inner):
                return ''
            parts = union_members(inner) if is_union(inner) else [inner]
            for x in parts:
                if x in names:
                    return ''
                names.append(x)
        return union_type(names)

    # ---- generic classes and functions (D60a): `class Box[T]` and `def first[T](items: list[T]) -> T`. Nothing is compiled for the
    # declaration itself; each use with other types makes a copy in which every T stands for a type (the type arguments).
    def is_generic(self, key: str, kind: str) -> bool:
        return key in self.generics and self.generics[key].kind == kind

    def type_params_of(self, key: str) -> list[str]:
        node = self.generics[key]
        return [tp.text for tp in node.fields[-1].items]

    def class_args(self, c: ClassInfo) -> list[str]:
        return [c.targs[tp] for tp in self.type_params_of(c.generic)]

    def arg_key(self, args: list[str]) -> str:
        return ','.join(args)

    # the copy of a generic class for these type arguments (made the first time it is asked for); returns its program-wide name
    def instance_class(self, gkey: str, args: list[str], line: int) -> str:
        tparams = self.type_params_of(gkey)
        node = self.generics[gkey]
        if len(args) != len(tparams):
            raise CompileError(f"'{node.fields[0].text}' takes {plural(len(tparams), 'type argument')}, but {len(args)} given", line)
        key = f'{gkey}[{self.arg_key(args)}]'
        if self.has_class(key):
            return key
        c = ClassInfo()
        c.name = key
        c.display = shown('@' + key)
        c.module = self.generic_mods[gkey]
        c.node = node
        c.line = node.line
        c.generic = gkey
        c.populated = False
        for k, tp in enumerate(tparams):
            c.targs[tp] = args[k]
        saved = self.cur
        self.cur = c.module
        if node.fields[1].tag == 's':
            c.parent = self.class_key(node.fields[1].text, node.line)
        for iv in node.fields[2].items:
            c.ifaces.append(self.iface_key(iv.text, node.line))
        self.cur = saved
        self.classes.append(c)
        self.pending.append(c)
        if self.late and not self.populating:
            self.populate_pending()
        return key

    # give the copies made so far their methods (they are compiled with the program like any other function)
    def populate_pending(self):
        if self.populating:
            return
        self.populating = True
        while len(self.pending) > 0:
            c = self.pending.pop(0)
            saved = self.cur
            saved_vars = self.tvars
            resolve_class(self, c)
            self.cur = c.module
            self.tvars = c.targs
            for m in val_nodes(class_def(c).fields[4]):
                info = function_info(m, self, c.name)
                info.targs = c.targs
                self.infos.append(info)
                self.func_nodes.append(m)
                self.extra_funcs.append(m)
                if m.fields[6].tag == 's' and m.fields[6].text == 'init':
                    c.init = info.name
            self.tvars = saved_vars
            c.populated = True
            self.cur = saved
            if self.late:
                check_classes(self)
                check_class_shapes(self)
                for d in self.dyn_seen:
                    if self.dyn_accepts('@' + c.name, d):
                        self.populating = False
                        raise NeedsEarlyCopy(c.generic + '\n' + '\n'.join(self.class_args(c)))
        self.populating = False

    # the copy of a generic function for these type arguments
    def instance_func(self, gkey: str, args: list[str], line: int) -> FuncInfo:
        tparams = self.type_params_of(gkey)
        node = self.generics[gkey]
        if gkey == 'asyncio.gather' and args == ['None']:
            raise CompileError('gather() gives the results of the tasks, but these tasks give none\nwait for them with: await asyncio.wait_all(tasks)', line)
        if len(args) != len(tparams):
            raise CompileError(f"'{node.fields[0].text}' takes {plural(len(tparams), 'type argument')}, but {len(args)} given", line)
        name = f'{gkey}[{self.arg_key(args)}]'
        if name in self.instance_funcs:
            return self.find(self.instance_funcs[name], line)
        binds: dict[str, str] = {}
        for k, tp in enumerate(tparams):
            binds[tp] = args[k]
        saved = self.cur
        saved_vars = self.tvars
        self.cur = self.generic_mods[gkey]
        self.tvars = binds
        info = function_info(node, self, '')
        self.cur = saved
        self.tvars = saved_vars
        self.instance_count += 1
        info.targs = binds
        info.key = f'{gkey}.g{self.instance_count}'
        self.instance_funcs[name] = info.key
        self.infos.append(info)
        self.func_nodes.append(node)
        self.extra_funcs.append(node)
        return info

    # are these types patterns, with a $T standing for a type still to be found?
    def pattern_mode(self, targs: list[str]) -> bool:
        for ta in targs:
            if '$' in ta:
                return True
        return False

    def type_delim(self, c: str) -> bool:
        return c in '[],>;?|:'

    # does the real type act fit the pattern pat, whose $T parts stand for types still to be found? Records them in binds.
    def unify(self, pat: str, act: str, binds: dict[str, str]) -> bool:
        if (pat.startswith('I:') or pat.startswith('IZ:')) and '$' in pat:
            item = ''
            if is_dyn(act):
                if dyn_iterable(act):
                    item = dyn_item(act)
            else:
                item = self.iter_item(act)
            if item == '':
                return False
            return self.unify(dyn_item(pat), item, binds)
        i = 0
        j = 0
        while i < len(pat):
            c = pat[i]
            if c == '$':
                end = i + 1
                while end < len(pat) and not self.type_delim(pat[end]):
                    end += 1
                name = pat[i + 1:end]
                stop = pat[end] if end < len(pat) else ''
                k = j
                depth = 0
                while k < len(act):
                    d = act[k]
                    if depth == 0 and stop != '' and d == stop:
                        break
                    if d == '[':
                        depth += 1
                    elif d == ']':
                        if depth == 0:
                            break
                        depth -= 1
                    k += 1
                found = act[j:k]
                if found == '':
                    return False
                if name in binds:
                    if binds[name] != found:
                        return False
                else:
                    binds[name] = found
                i = end
                j = k
            else:
                if j >= len(act) or act[j] != c:
                    return False
                i += 1
                j += 1
        return j == len(act)

    # `Iterable[T] & Sized`: the built-in interfaces joined (D50a); the other uses of & are not built yet
    def dyn_intersection(self, members: list[Node]) -> str:
        item = ''
        sized = False
        for m in members:
            part = self.type_name(vn(m))
            if part == 'Z':
                sized = True
            elif part.startswith('I:') and (item == '' or item == dyn_item(part)):
                item = dyn_item(part)
            else:
                return ''
        if item == '':
            return 'Z'
        if sized:
            return f'IZ:{item}'
        return f'I:{item}'

    # fn(A, B) -> R is written fn[A,B>R] inside the compiler, with None for no result (a function value is a plain pointer)
    def fn_type(self, t: Node) -> str:
        parts: list[str] = []
        for p in val_nodes(t.fields[2]):
            pt = self.type_name(vn(p))
            if pt == '' or pt == 'None':
                return ''
            parts.append(pt)
        res = 'None'
        if t.fields[3].tag == 'n':
            res = self.type_name(t.fields[3])
            if res == '':
                if val_node(t.fields[3]).fields[0].text != 'None':
                    return ''
                res = 'None'
        return 'fn[' + ','.join(parts) + '>' + res + ']'

    def type_name(self, v: Val) -> str:
        # the name of a type the compiler knows: int, bool, str, a declared class ('@Name') or a list of those; '' otherwise
        if v.tag != 'n':
            return ''
        t = val_node(v)
        name = t.fields[0].text
        if t.fields[1].tag == 'z' and t.fields[2].tag == 'z' and name in self.tvars:
            return self.tvars[name]
        if (name == 'int' or name == 'uint') and t.fields[1].tag == 'n':
            length = val_node(t.fields[1])
            if length.kind != 'IntLit' or length.fields[0].num < 1 or length.fields[0].num > 64:
                return ''
            if name == 'int':
                return f'i{length.fields[0].num}'
            return f'u{length.fields[0].num}'
        if name == 'fn' and t.fields[1].tag == 'z' and t.fields[2].tag != 'n' and t.fields[2].tag != 'z':
            return self.fn_type(t)
        if name == 'union':
            members = val_nodes(t.fields[2])
            if len(members) != 2 or not self.has_none_member(members):
                if self.has_none_member(members):
                    return ''
                return self.union_of(members)
            other = members[0]
            if other.fields[0].text == 'None':
                other = members[1]
            elif members[1].fields[0].text != 'None':
                return ''
            wrapped = self.type_name(vn(other))
            if not (wrapped == 'str' or is_list(wrapped) or is_dict(wrapped) or is_set(wrapped) or is_class(wrapped) or is_iface(wrapped) or is_mtuple(wrapped)):
                return ''
            return f'{wrapped}?'
        if name == 'task' and t.fields[2].tag == 'n' and t.fields[1].tag == 'z':
            res = self.type_name(t.fields[2])
            if res == '' and val_node(t.fields[2]).fields[0].text == 'None':
                res = 'None'
            if res == '' or is_fixed(res):
                return ''
            if t.fields[3].tag == 'n':
                st = self.type_name(t.fields[3])
                if st == '' or is_fixed(st):
                    return ''
                return f'task[{res};{st}]'
            return f'task[{res}]'
        if name == 'intersection':
            return self.dyn_intersection(val_nodes(t.fields[2]))
        if name == 'Iterable' and t.fields[2].tag == 'n' and self.resolve(name) == '':
            item = self.type_name(t.fields[2])
            if item == '' or is_optional(item):
                return ''
            return f'I:{item}'
        if name == 'Sized' and t.fields[2].tag == 'z' and t.fields[1].tag == 'z' and self.resolve(name) == '':
            return 'Z'
        if name == 'set' and t.fields[2].tag == 'n':
            member = self.type_name(t.fields[2])
            if member == 'str' or member == 'int' or member == 'bool':
                return f'set[{member}]'
            return ''
        if name == 'dict' and t.fields[2].tag == 'n' and t.fields[3].tag == 'n':
            if self.type_name(t.fields[2]) != 'str':
                return ''
            inner = self.type_name(t.fields[3])
            if inner == '' or is_fixed(inner):
                return ''
            return f'dict[{inner}]'
        if name == 'tuple' and t.fields[2].tag == 'l':
            # tuple[str, int]: a fixed number of items, each of its own type
            item_types: list[str] = []
            for tv in t.fields[2].items:
                tit = self.type_name(tv)
                if tit == '' or is_fixed(tit):
                    return ''
                item_types.append(tit)
            return mtuple_type(item_types)
        if (name == 'list' or name == 'tuple') and t.fields[2].tag == 'n' and t.fields[1].tag == 'z':
            inner = self.type_name(t.fields[2])
            if inner == '' or is_fixed(inner):
                return ''
            return f'{name}[{inner}]'
        gkey = self.resolve(name)
        if gkey != '' and self.is_generic(gkey, 'ClassDef'):
            if t.fields[2].tag != 'n' or t.fields[1].tag != 'z':
                raise CompileError(f"'{name}' is generic, so it needs its type arguments: {name}[{', '.join(self.type_params_of(gkey))}]", t.line)
            targs: list[str] = [self.type_name(t.fields[2])]
            if t.fields[3].tag == 'n':
                targs.append(self.type_name(t.fields[3]))
            if '' in targs:
                return ''
            if self.pattern_mode(targs):
                return f'@{gkey}[{self.arg_key(targs)}]'
            return '@' + self.instance_class(gkey, targs, t.line)
        if t.fields[2].tag != 'z' or t.fields[1].tag != 'z':
            return ''
        if basic_type(name):
            return name
        key = self.resolve(name)
        if key != '' and self.has_class(key):
            return f'@{key}'
        if key != '' and self.has_iface(key):
            return f'%{key}'
        return ''

!tomato_str_nbytes(s: str) -> int
!tomato_str_byte(s: str, i: int) -> int

def escape_byte(b: int) -> str:
    # one byte of a text constant as LLVM writes it: printable ASCII as itself, anything else as \XX (D17a-b: text is UTF-8)
    ascii = ' !"#$%&\'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~'
    if b >= 32 and b < 127 and b != 34 and b != 92:
        return ascii[b - 32]
    digits = '0123456789ABCDEF'
    return f'\\{digits[b // 16]}{digits[b % 16]}'

def escape_text(s: str) -> str:
    body = ''
    for i in range(!tomato_str_nbytes(s)):
        body += escape_byte(!tomato_str_byte(s, i))
    return body

def string_global(index: int, s: str) -> str:
    size = str(!tomato_str_nbytes(s) + 1)
    body = escape_text(s)
    return '@.str.' + str(index) + ' = private constant { i64, i64, i64, i64, [' + size + ' x i8] } { i64 -1, i64 1, i64 ' + str(!tomato_str_nbytes(s)) + ', i64 ' + str(len(s)) + ', [' + size + ' x i8] c"' + body + '\\00" }'

def string_c(index: int, s: str) -> str:
    # a plain C copy, which is what tomato_fail prints
    return '@.str.' + str(index) + '.c = private constant [' + str(!tomato_str_nbytes(s) + 1) + ' x i8] c"' + escape_text(s) + '\\00"'

class TryInfo:
    # a try statement being compiled (D22a)
    catch_l: str = ''         # where an error raised in the body goes
    prop_l: str = ''          # where an error leaving the statement goes (after the finally block runs)
    final: list[Node] = []
    has_final: bool = False
    loop_depth: int = 0
    state: str = 'body'       # 'body' while compiling the try body, then 'post'

class GenCtx:
    # one generator being compiled into a for loop: where the loop variable lives, the loop body, and the scope not currently in use
    var: str = ''
    ty: str = ''
    body: list[Node] = []
    end: str = ''
    try_depth: int = 0
    slots: dict[str, str] = {}
    types: dict[str, str] = {}
    narrowed: list[str] = []
    settled: list[str] = []
    ret: str = ''
    owner: str = ''
    in_init: bool = False
    module: str = ''
    targs: dict[str, str] = {}

class CompCtx:
    # a list comprehension being compiled: the slot holding the new list and its type (known once the first item is compiled)
    holder: str = ''
    ty: str = ''

class Gen:
    # one function being compiled
    comps: list[CompCtx] = []     # the list comprehensions being compiled, innermost last
    mod: Mod = Mod()
    lines: list[str] = []
    allocas: list[str] = []
    rc_slots: list[str] = []
    held: list[Ex] = []           # owned temporaries waiting while the rest of an expression is evaluated: a failing check releases them
    flat_slots: list[str] = []    # the rc_slots whose type can never be in a cycle (released with tomato_release_flat)
    int_slots: list[str] = []     # the places that own an int (a big number in one is freed with the function)
    assigned: list[str] = []      # the names of variables that are written (a name given to slot()) after the parameters were set up
    kw: list[Val] = []            # the keyword arguments of the call being compiled, picked up by call_function
    narrowed: list[str] = []      # variables that are narrowed from a union inside the branch being compiled
    take_name: str = ''           # `x = x + 1`: the int local whose one read in the right side hands its number over to the operation
    mark_prefix: str = ''        # inside a small-int loop: the prefix of the labels its fast copy jumps back to (see small_loop)
    list_lens: dict[str, str] = {}    # local lists that the loops being compiled cannot change: the register that holds the length
    list_in_slots: dict[str, bool] = {}   # for each: those are the slots that hold them
    list_datas: dict[str, str] = {}   # of each, and the one that holds the address of its items (see keep_lists)
    nest: str = ''               # the label prefix of the loop nest being compiled (see nest_loop)
    nest_fast: bool = False      # its fast copy is being compiled
    nest_off: bool = False       # inside a statement that a nest compiles whole: no new nest starts there
    nest_names: list[str] = []   # the int variables that are small all through the fast copy
    nest_count: int = 0          # the statements of the fast copy that were compiled as such
    grouping: bool = False       # a run of float assignments is being compiled: its finite checks wait in group_checks (the value and the difference that is not a number when it is wrong)
    group_checks: list[list[str]] = []
    nest_slots: dict[str, str] = {}      # the hidden slots of its loops, which both copies use
    nest_keeps: dict[str, list[str]] = {}    # the lists whose length and data each of its loops keeps
    nest_plain: list[int] = []   # its small-int loops, which have a fast copy of their own
    nest_entries: list[str] = [] # the loops of the fast copy, by number
    nest_heads: list[list[str]] = []     # the loop heads of the general copy: line, label that goes on, number of the loop
    short: bool = False          # the function is short enough to ask to be inlined
    bail: str = ''               # where the fast copy goes when a number is not small, an index is out of range, ...
    fast_over: str = ''          # whether an operation worked out ahead overflowed (see fast_choice)
    fuse_at: int = 0             # the next leaf of the fused expression being compiled (see fused)
    fuse_used: bool = False      # its fast copy can branch to the slow copy
    calm_types: dict[str, str] = {}   # while a loop is checked (see calm): the types of the variables it makes
    taken: Ex = ex('', '')        # that read (fresh while an operation has not used it up)
    settled: list[str] = []       # the narrowed variables whose narrowing lasts to the end of the block (after an if that left)
    after: list[list[str]] = []   # for each of those: its name, slot and type before, put back when the block ends
    slots: dict[str, str] = {}
    types: dict[str, str] = {}
    n: int = 0
    terminated: bool = False
    breaks: list[str] = []
    conts: list[str] = []
    loop_depth: int = 0
    tries: list[TryInfo] = []
    try_depth: int = 0
    slot_count: int = 0
    line: int = 0
    fname: str = ''           # the function's name as a call trace shows it (Class.method for a method)
    owner: str = ''           # the class whose method is being compiled, or ''
    in_init: bool = False
    ret: str = ''
    gens: list[GenCtx] = []   # the generators being compiled into for loops, innermost last (only the first gen_n count)
    gen_n: int = 0
    is_async: bool = False     # compiling an async function: its variables live in a heap frame so it can stop and go on later
    frame_code: int = 0        # the type code of that frame
    frame_types: list[str] = []   # the type of each frame field after the fixed ones
    awaits: int = 0            # the number of places this function can stop at
    ret_yields: str = ''        # what a yield gives out, for an async function with a status
    async_ok: bool = False     # the call being compiled is directly under await or start, so it may be an async call
    fresh_frame: bool = False  # the last call made a new task frame
    fresh_reg: str = ''        # the register that frame is in
    lifted: int = 0            # how many awaits were moved into statements of their own
    defer_float: bool = False  # the binop about to be compiled is an operand of a float + - *, so it may leave its finite check to that operator
    facts: Facts = facts_new()      # the integer ranges known at the point being compiled (see range_of)
    facts_off: int = 0              # inside a try, a generator or another place whose statements can be entered from more than one point
    for_body: Facts = facts_new()   # the facts at the start of each pass through the body of the for loop being compiled
    for_entry: Facts = facts_new()  # the facts where that for loop starts (its range bounds are evaluated there)

    def tmp(self, hint: str) -> str:
        self.n += 1
        return f'%{hint}.{self.n}'

    def label(self, hint: str) -> str:
        self.n += 1
        return f'{hint}.{self.n}'

    def emit(self, text: str):
        if self.terminated:
            self.lines.append(self.label('dead') + ':')
            self.terminated = False
        self.lines.append(f'  {text}')

    def place(self, label: str):
        self.lines.append(f'{label}:')
        self.terminated = False

    def br(self, label: str):
        self.emit(f'br label %{label}')
        self.terminated = True

    def cond_br(self, c: str, yes: str, no: str):
        self.emit(f'br i1 {c}, label %{yes}, label %{no}')
        self.terminated = True

    def cold_br(self, c: str, bad: str, good: str):
        # a branch that is almost never taken (release mode: the interpreter on the website does not read the weights)
        if self.mod.mode == 2:
            self.emit(f'br i1 {c}, label %{bad}, label %{good}, !prof !0')
            self.terminated = True
        else:
            self.cond_br(c, bad, good)

    def bail_if(self, c: str, live: list[Ex] = []):
        # leave the fast copy of a loop nest for the same statement of the general copy. Nothing of the statement has had an effect
        # yet; the temporaries it holds are let go.
        ok = self.label('inside')
        waiting = False
        for e in live + self.held:
            if not e.reg.startswith('%bl.') and (is_rc(e.ty) or (e.ty == 'int' and e.fresh and not e.small)):
                waiting = True
        if not waiting:
            self.cold_br(c, self.bail, ok)
            self.place(ok)
            return
        out = self.label('leave')
        self.cold_br(c, out, ok)
        self.place(out)
        for e2 in live:
            self.release(e2)
        self.release_held()
        self.br(self.bail)
        self.place(ok)

    def old_is_small(self, addr: str, live: list[Ex]) -> bool:
        # in the fast copy of a loop nest, a place that is about to be overwritten must hold a small number, so it frees nothing
        if self.bail == '':
            return False
        old = self.tmp('was')
        self.emit(f'{old} = load i64, ptr {addr}')
        self.need_small(ex(old, 'int'), live)
        return True

    def need_small(self, e: Ex, live: list[Ex] = []) -> Ex:
        # in the fast copy of a loop nest every number is small; one that is not (from a list, a field or a call) leaves it
        if self.bail == '' or e.ty != 'int' or e.small or small_text(e.reg):
            return e
        bit = self.arith('and', e.reg, '1')
        c = self.tmp('notsmall')
        self.emit(f'{c} = icmp eq i64 {bit}, 0')
        self.bail_if(c, live + [e] if e.fresh else live)
        return exs(e.reg, 'int')

    def unwind_target(self) -> str:
        # where an error raised here goes: the innermost try's catch (or its finally once past the body), else out of
        # the function, which returns early so that its caller can check (D22a)
        if self.try_depth > 0:
            t = self.tries[self.try_depth - 1]
            if t.state == 'body':
                return t.catch_l
            return t.prop_l
        return 'epilogue'

    def slot(self, name: str, ty: str, line: int) -> str:
        self.assigned.append(name)
        if name in self.slots:
            if self.types[name] != ty:
                raise CompileError(f"the variable '{name}' already has type {shown(self.types[name])}, so it cannot be redeclared as {shown(ty)}", line)
            return self.slots[name]
        return self.new_slot(name, ty)

    def make_slot(self, reg: str, ty: str):
        # a place for a value: a stack slot, or a field of the frame in an async function. A value that needs releasing starts out null.
        if self.is_async:
            self.frame_types.append(ty)
            self.allocas.append(f'  {reg} = getelementptr %class.{self.frame_code}, ptr %frame, i32 0, i32 {str(len(self.frame_types) - 1 + FRAME_FIXED + 2)}')
            if is_rc(ty):
                self.rc_slots.append(reg)
                if self.mod.flat_type(ty):
                    self.flat_slots.append(reg)
            elif ty == 'int':
                self.int_slots.append(reg)
            return
        self.allocas.append(f'  {reg} = alloca {llvm_type(ty)}')
        if is_rc(ty):
            self.allocas.append(f'  store ptr null, ptr {reg}')
            self.rc_slots.append(reg)
            if self.mod.flat_type(ty):
                self.flat_slots.append(reg)
        elif ty == 'int':
            self.allocas.append(f'  store i64 0, ptr {reg}')
            self.int_slots.append(reg)

    def new_slot(self, name: str, ty: str) -> str:
        self.slot_count += 1
        reg = f'%v.{name}.{self.slot_count}'
        self.make_slot(reg, ty)
        self.slots[name] = reg
        self.types[name] = ty
        return reg

    def hidden_slot(self, hint: str) -> str:
        reg = self.tmp(hint)
        self.make_slot(reg, 'u64')
        return reg

    def hidden_int_slot(self, hint: str) -> str:
        reg = self.tmp(hint)
        self.make_slot(reg, 'int')
        return reg

    def hidden_rc_slot(self, hint: str) -> str:
        reg = self.tmp(hint)
        self.make_slot(reg, 'str')
        return reg

    # ---- reference counting
    def retain(self, e: Ex):
        # e was just read from a place that keeps its value (a field, a list item): take a reference of our own. A big int cannot
        # be shared, so e becomes a copy that we own.
        if is_rc(e.ty):
            self.emit(f'call void @tomato_retain(ptr {e.reg})')
        elif e.ty == 'int':
            d = self.tmp('dup')
            self.emit(f'{d} = call i64 @tomato_int_dup(i64 {e.reg})')
            e.reg = d
            e.fresh = True

    def slot_release(self, reg: str) -> str:
        if reg in self.flat_slots:
            return 'tomato_release_flat'
        return 'tomato_release'

    def release_fn(self, ty: str) -> str:
        if self.mod.flat_type(ty):
            return 'tomato_release_flat'
        return 'tomato_release'

    def release(self, e: Ex):
        # a borrowed read of a local (see expr_b) holds no reference of its own, so there is nothing to release
        if is_rc(e.ty) and not e.reg.startswith('%bl.'):
            self.emit(f'call void @{self.release_fn(e.ty)}(ptr {e.reg})')
        elif e.ty == 'int' and e.fresh and not e.small and not small_text(e.reg):
            self.emit(f'call void @tomato_int_free(i64 {e.reg})')

    def owned(self, e: Ex) -> Ex:
        # e as a value the caller may keep: an int borrowed from a variable is copied, everything else is already owned
        if e.ty == 'int' and not e.fresh and not e.small and not small_text(e.reg):
            d = self.tmp('dup')
            self.emit(f'{d} = call i64 @tomato_int_dup(i64 {e.reg})')
            return exf(d, 'int')
        return e

    def can_borrow(self, n: Node, others: list[Node]) -> bool:
        # a plain local that holds a heap value can be read without retain/release when it is only looked at while the current
        # operation runs: the local itself keeps the value alive, and nothing in an expression can assign to a local of this
        # function except a list comprehension that reuses its name (calls run in their own frames, there are no closures)
        if n.kind != 'Name':
            return False
        name = n.fields[0].text
        if name not in self.slots or not is_rc(self.types[name]):
            return False
        for o in others:
            if has_comp(o):
                return False
        return True

    def expr_b(self, n: Node, others: list[Node]) -> Ex:
        # like expr, but a local variable is lent without a retain; release() ignores the result. others are the expressions
        # evaluated while the lent value is in use.
        if self.can_borrow(n, others):
            name = n.fields[0].text
            r = self.tmp('bl')
            self.emit(f'{r} = load ptr, ptr {self.slots[name]}')
            lent = ex(r, self.types[name])
            if name in self.list_lens:
                lent.list_name = name
            return lent
        return self.expr(n)

    # ---- lists that a loop only reads. A loop is calm when nothing in it can run user code or change the length of any list: only
    # assignments, ifs and range loops over numbers, list items and fields. A local list that a calm loop does not assign keeps its
    # length and the address of its items, so they are loaded once, in front of the loop, into registers.
    def calm(self, n: Node) -> bool:
        t = self.peek_type(n)
        if not (t == 'int' or t == 'float' or t == 'bool' or t == 'str' or ((is_list(t) or is_class(t)) and not is_optional(t))):
            return False
        return self.calm_parts(n)

    def calm_parts(self, n: Node) -> bool:
        k = n.kind
        if k == 'Name' or k == 'IntLit' or k == 'FloatLit' or k == 'BoolLit' or k == 'StrLit':
            return True
        if k == 'UnOp':
            return self.calm(val_node(n.fields[1]))
        if k == 'BinOp':
            return self.calm(val_node(n.fields[1])) and self.calm(val_node(n.fields[2]))
        if k == 'Index':
            return self.calm(val_node(n.fields[0])) and self.calm(val_node(n.fields[1]))
        if k == 'Attr':
            return self.quiet_read(val_node(n.fields[0]))
        if k == 'Call':                     # peek_type knows its type: len(), or a user function, which may do anything
            f = val_node(n.fields[0])
            if f.kind != 'Name':
                return False
            if f.fields[0].text == 'len':
                return self.calm(val_nodes(n.fields[1])[0])
            if len(n.fields[2].items) > 0 or not self.pure_call(f):
                return False
            for a in val_nodes(n.fields[1]):
                if not self.calm(a):
                    return False
            return True
        return False

    def pure_call(self, f: Node) -> bool:
        # a call of a function of numbers that only computes: whatever it reads are its own parameters and variables, and it changes
        # nothing else (it may raise)
        if f.fields[0].text in self.slots:
            return False
        key = self.mod.resolve(f.fields[0].text)
        if key == '' or key in self.mod.generics or self.mod.has_class(key) or not self.mod.has_func(key):
            return False
        return self.mod.pure(key)

    def calm_block(self, body: list[Node]) -> bool:
        for s in body:
            if not self.calm_stmt(s):
                return False
        return True

    def calm_stmt(self, s: Node) -> bool:
        k = s.kind
        if k == 'Pass' or k == 'Break' or k == 'Continue':
            return True
        if k == 'Multi':
            return self.calm_block(val_nodes(s.fields[0]))
        if k == 'Assign':
            t = val_node(s.fields[0])
            if not self.calm(val_node(s.fields[1])):
                return False
            if t.kind == 'Name':
                name = t.fields[0].text
                if name not in self.slots:       # its type is only known once it is compiled, and later statements may use it
                    self.calm_types[name] = self.peek_type(val_node(s.fields[1]))
                return True
            if t.kind == 'Index':
                return self.peek_type(val_node(t.fields[0])).startswith('list[') and self.calm(t)
            return t.kind == 'Attr' and self.calm(t)
        if k == 'If':
            for branch in s.fields[0].items:
                if not self.calm(val_node(branch.items[0])) or not self.calm_block(val_nodes(branch.items[1])):
                    return False
            return s.fields[1].tag != 'l' or self.calm_block(val_nodes(s.fields[1]))
        if k == 'While':
            return self.calm(val_node(s.fields[0])) and self.calm_block(val_nodes(s.fields[1]))
        if k == 'For':
            it = val_node(s.fields[1])
            if len(s.fields) > 3 or it.kind != 'Call' or val_node(it.fields[0]).kind != 'Name' or val_node(it.fields[0]).fields[0].text != 'range':
                return False
            for b in val_nodes(it.fields[1]):
                if not self.calm(b):
                    return False
            if s.fields[0].text not in self.slots:
                self.calm_types[s.fields[0].text] = 'int'
            return self.calm_block(val_nodes(s.fields[2]))
        return False

    def indexed_names(self, n: Node, out: list[str]):
        # the local lists that n takes items of
        if n.kind == 'Index' and val_node(n.fields[0]).kind == 'Name':
            name = val_node(n.fields[0]).fields[0].text
            if name in self.slots and is_list(self.types[name]) and not is_optional(self.types[name]) and name not in out:
                out.append(name)
        for f in n.fields:
            self.indexed_names_val(f, out)

    def indexed_names_val(self, v: Val, out: list[str]):
        if v.tag == 'n':
            self.indexed_names(val_node(v), out)
        elif v.tag == 'l' or v.tag == 't':
            for it in v.items:
                self.indexed_names_val(it, out)

    def keep_lists(self, loop: Node, parts: list[Node], cond: Node | None = None) -> list[str]:
        # called in front of a loop: loads the length and the address of the items of each local list that the loop reads items of
        # and, being calm, cannot change. Gives the names that it added; drop_lists takes them off again after the loop.
        added: list[str] = []
        if self.is_async or self.gen_n > 0:
            return added
        names: list[str] = []
        self.indexed_names(loop, names)
        bound: list[str] = []
        bound_names(loop, bound)
        names = [x for x in names if x not in bound and x not in self.list_lens]
        in_nest = self.nest != '' and loop.spot > 0
        if in_nest and self.nest_fast:        # exactly the lists that the general copy keeps: either copy can go on in the other
            names = self.nest_keeps[str(loop.spot)] if str(loop.spot) in self.nest_keeps else []
            names = [x for x in names if x not in self.list_lens]
        if len(names) == 0:
            return added
        if not (in_nest and self.nest_fast):
            self.calm_types = {}
            calm = self.calm_block(parts)
            if calm and cond is not None:
                calm = self.calm(cond)
            self.calm_types = {}
            if not calm:
                return added
        if in_nest and not self.nest_fast:
            self.nest_keeps[str(loop.spot)] = names
        for name in names:
            l = self.tmp('lst')
            self.emit(f'{l} = load ptr, ptr {self.slots[name]}')
            isnull = self.tmp('unset')
            self.emit(f'{isnull} = icmp eq ptr {l}, null')        # a variable nothing has assigned yet: a list with no items
            some = self.label('haslist')
            none = self.label('nolist')
            join = self.label('keep')
            self.cond_br(isnull, none, some)
            self.place(none)
            self.br(join)
            self.place(some)
            lenp = self.tmp('lenp')
            self.emit(f'{lenp} = getelementptr {{ i64, i64, i64, i64, ptr }}, ptr {l}, i32 0, i32 2')
            ln = self.tmp('len')
            self.emit(f'{ln} = load i64, ptr {lenp}')
            datap = self.tmp('datap')
            self.emit(f'{datap} = getelementptr {{ i64, i64, i64, i64, ptr }}, ptr {l}, i32 0, i32 4')
            data = self.tmp('data')
            self.emit(f'{data} = load ptr, ptr {datap}')
            self.br(join)
            self.place(join)
            klen = self.tmp('keeplen')
            self.emit(f'{klen} = phi i64 [ 0, %{none} ], [ {ln}, %{some} ]')
            kdata = self.tmp('keepdata')
            self.emit(f'{kdata} = phi ptr [ null, %{none} ], [ {data}, %{some} ]')
            if in_nest:                       # in slots, which both copies of the nest share
                lslot = self.loop_slot(loop, f'keep.{name}.n')
                dkey = f'{loop.spot}keep.{name}.d'
                if dkey not in self.nest_slots:
                    self.nest_slots[dkey] = self.tmp('keep.d')
                    self.allocas.append(f'  {self.nest_slots[dkey]} = alloca ptr')
                dslot = self.nest_slots[dkey]
                self.emit(f'store i64 {klen}, ptr {lslot}')
                self.emit(f'store ptr {kdata}, ptr {dslot}')
                klen = lslot
                kdata = dslot
            self.list_lens[name] = klen
            self.list_datas[name] = kdata
            self.list_in_slots[name] = in_nest
            added.append(name)
        return added

    def drop_lists(self, added: list[str]):
        for name in added:
            self.list_lens.remove(name)
            self.list_datas.remove(name)
            self.list_in_slots.remove(name)

    def list_length(self, lst: Ex) -> str:
        if lst.list_name != '' and lst.list_name in self.list_lens:
            if self.list_in_slots[lst.list_name]:
                kn = self.tmp('len')
                self.emit(f'{kn} = load i64, ptr {self.list_lens[lst.list_name]}')
                return kn
            return self.list_lens[lst.list_name]
        lenp = self.tmp('lenp')
        self.emit(f'{lenp} = getelementptr {{ i64, i64, i64, i64, ptr }}, ptr {lst.reg}, i32 0, i32 2')
        ln = self.tmp('len')
        self.emit(f'{ln} = load i64, ptr {lenp}')
        return ln

    def store_owned(self, slot: str, e: Ex, old_small: bool = False):
        # the slot takes over the reference and releases what it held (an int slot known to hold a small number frees nothing)
        if is_rc(e.ty):
            old = self.tmp('old')
            self.emit(f'{old} = load ptr, ptr {slot}')
            self.emit(f'store ptr {e.reg}, ptr {slot}')
            self.emit(f'call void @{self.slot_release(slot)}(ptr {old})')
        elif e.ty == 'int':
            v = self.owned(e)                 # copied first: it may be the very number the slot is about to drop
            if old_small:
                self.emit(f'store i64 {v.reg}, ptr {slot}')
                return
            old = self.tmp('old')
            self.emit(f'{old} = load i64, ptr {slot}')
            self.emit(f'store i64 {v.reg}, ptr {slot}')
            self.emit(f'call void @tomato_int_free(i64 {old})')
        else:
            self.emit(f'store {llvm_type(e.ty)} {e.reg}, ptr {slot}')

    def unwrap(self, e: Ex, line: int, live: list[Ex] = []) -> Ex:
        # an optional used where a value is needed: stop when it is None (D23b)
        if not is_optional(e.ty):
            return e
        bad = self.tmp('isnone')
        self.emit(f'{bad} = icmp eq ptr {e.reg}, null')
        self.fail_if(bad, 'None where a value is needed', live)
        return ex(e.reg, strip_optional(e.ty))

    def resize(self, e: Ex, to: str) -> Ex:
        # the same number in another integer type that holds all of its values
        if e.ty == to:
            return e
        if to == 'int' and e.ty != 'int':
            if bits_of(e.ty) < 62:
                return self.tag_small(self.widen(e, 64))
            return self.int_from_machine(self.widen(e, 64), is_signed(e.ty))
        fb = bits_of(e.ty)
        tb = bits_of(to)
        if fb == tb:
            return ex(e.reg, to)
        r = self.tmp('ext')
        op = 'sext' if is_signed(e.ty) else 'zext'
        self.emit(f'{r} = {op} {llvm_type(e.ty)} {e.reg} to {llvm_type(to)}')
        return ex(r, to)

    def want(self, e: Ex, ty: str, line: int, what: str) -> Ex:
        # check that e fits the type ty and return it as that type (a number is widened, an optional unwrapped)
        if is_class(e.ty) and e.ty != '@bitarray.bitarray' and (ty == '@bitarray.bitarray' or (is_union(ty) and '@bitarray.bitarray' in union_members(ty))) and self.mod.has_op(e.ty[1:], 'bitarray'):
            # an object whose class has a method marked @bitarray is used as the bitarray that method returns
            conv = self.mod.find_op(e.ty[1:], 'bitarray')
            if len(conv.ptypes) != 0 or conv.ret != '@bitarray.bitarray':
                raise CompileError(f"the @bitarray method '{conv.name}' must take nothing besides self and return a bitarray", line)
            e = self.marker_call(e, conv, [], line)
        if is_optional(e.ty) and not is_optional(ty) and ty != 'None' and self.mod.assignable(strip_optional(e.ty), ty):
            self.unwrap(e, line)
            return ex(e.reg, strip_optional(e.ty))
        if e.ty == ty:
            return e
        if is_numeric(e.ty) and is_numeric(ty):
            if not contains(ty, e.ty):
                raise CompileError(f'{what} has type {shown(e.ty)}, but {shown(ty)} is expected\nconvert it explicitly first', line)
            return self.resize(e, ty)
        if is_union(ty) and not is_union(e.ty):
            return self.box_value(e, ty, line, what)
        if is_dyn(ty) and not is_dyn(e.ty):
            return self.box_dyn(e, ty, line, what)
        if not self.mod.assignable(e.ty, ty):
            raise CompileError(f'{what} has type {shown(e.ty)}, but {shown(ty)} is expected', line)
        return e

    def union_member_for(self, vt: str, ty: str) -> str:
        # the member of union ty that a value of type vt belongs to: the same type first, else one it can be used as; '' when none
        members = union_members(ty)
        if vt in members:
            return vt
        for m in members:
            if self.mod.assignable(vt, m):
                return m
        return ''

    def box_value(self, e: Ex, ty: str, line: int, what: str) -> Ex:
        # a value stored where a union is wanted: a small heap object holding the value and which member it is
        member = self.union_member_for(e.ty, ty)
        if member == '':
            raise CompileError(f'{what} has type {shown(e.ty)}, but {shown(ty)} is expected', line)
        if is_numeric(e.ty) and e.ty != member:
            raise CompileError(f'{what} has type {shown(e.ty)}, but {shown(ty)} is expected', line)
        return self.box_as(e, member, ty)

    def box_as(self, e: Ex, member: str, ty: str) -> Ex:
        e = self.owned(e)
        b = self.tmp('box')
        self.emit(b + ' = call ptr @tomato_alloc(i64 32, i64 ' + str(self.mod.code_of('box:' + member)) + ')')
        p = self.tmp('payload')
        self.emit(f'{p} = getelementptr i8, ptr {b}, i64 16')
        self.emit(f'store {llvm_type(member)} {e.reg}, ptr {p}')
        k = self.tmp('kind')
        self.emit(f'{k} = getelementptr i8, ptr {b}, i64 24')
        self.emit(f'store i64 {box_kind(member)}, ptr {k}')
        return ex(b, ty)

    def box_dyn(self, e: Ex, ty: str, line: int, what: str) -> Ex:
        # a value stored where Iterable[T] or Sized is wanted (D50a). A set or dict that will be looped over is boxed as a
        # snapshot of its keys, which is what a for loop over it walks anyway.
        if not self.mod.dyn_accepts(e.ty, ty):
            raise CompileError(f'{what} has type {shown(e.ty)}, but {shown(ty)} is expected', line)
        if not (is_list(e.ty) or is_dict(e.ty) or is_set(e.ty)):
            return self.box_as(e, e.ty, ty)
        if dyn_iterable(ty) and not is_list(e.ty):
            keys = f'list[{elem_of(e.ty)}]'
            if is_dict(e.ty):
                keys = 'list[str]'
            snap = self.tmp('keys')
            self.emit(f'{snap} = call ptr @tomato_dict_keys(ptr {e.reg}, i64 {self.mod.code_of(keys)}, i64 {item_width(keys)})')
            self.release(e)
            e = ex(snap, keys)
        return self.box_as(e, dyn_seq(), ty)

    def unbox_value(self, box: Ex, member: str) -> Ex:
        # the value inside a union, as a new reference when it is a heap value
        p = self.tmp('payload')
        self.emit(f'{p} = getelementptr i8, ptr {box.reg}, i64 16')
        v = self.tmp('inner')
        self.emit(f'{v} = load {llvm_type(member)}, ptr {p}')
        e = ex(v, member)
        self.retain(e)
        return e

    def box_is(self, box: Ex, member: str) -> str:
        # an i1: is this union holding that member?
        tp = self.tmp('tp')
        self.emit(f'{tp} = getelementptr {{ i64, i64 }}, ptr {box.reg}, i32 0, i32 1')
        raw = self.tmp('rawcode')
        self.emit(f'{raw} = load i64, ptr {tp}')
        code = self.tmp('code')
        self.emit(f'{code} = and i64 {raw}, 4294967295')
        c = self.tmp('isbox')
        self.emit(c + ' = icmp eq i64 ' + code + ', ' + str(self.mod.code_of('box:' + member)))
        return c

    # ---- small instructions
    def truth(self, e: Ex, line: int) -> str:
        e = self.want(e, 'bool', line, 'a condition')
        r = self.tmp('cond')
        self.emit(f'{r} = icmp ne i64 {e.reg}, 0')
        return r

    def bool_of(self, i1: str) -> Ex:
        r = self.tmp('b')
        self.emit(f'{r} = zext i1 {i1} to i64')
        return ex(r, 'bool')

    def arith(self, op: str, a: str, b: str) -> str:
        r = self.tmp('t')
        self.emit(f'{r} = {op} i64 {a}, {b}')
        return r

    def icmp(self, cc: str, a: str, b: str) -> Ex:
        c = self.tmp('cmp')
        self.emit(f'{c} = icmp {cc} i64 {a}, {b}')
        return self.bool_of(c)

    def common_type(self, a: str, b: str, line: int) -> str:
        if contains(a, b):
            return a
        if contains(b, a):
            return b
        raise CompileError(f'these integer types have no common type: {shown(a)} and {shown(b)}\nconvert one of them explicitly first', line)

    # ---- unlimited-size integers (D05c): an int is a tagged word, and the runtime does the arithmetic
    def int_call(self, name: str, a: str, b: str) -> Ex:
        r = self.tmp('int')
        self.emit(f'{r} = call i64 @tomato_int_{name}(i64 {a}, i64 {b})')
        return exf(r, 'int')

    def consumable(self, e: Ex) -> bool:
        return e.ty == 'int' and e.fresh and not e.small and not small_text(e.reg)

    def consume_mask(self, x: Ex, y: Ex) -> int:
        # which operands an operation frees itself (those we own): bit 0 for x, bit 1 for y. Their Ex values are used up.
        m = 0
        if self.consumable(x):
            m += 1
        if self.consumable(y) and y.reg != x.reg:
            m += 2
        if m % 2 == 1:
            x.fresh = False
        if m >= 2:
            y.fresh = False
        return m

    def int_call_c(self, name: str, x: Ex, y: Ex) -> Ex:
        # like int_call, and the operation frees the operands that are ours when they turn out to be big numbers
        m = self.consume_mask(x, y)
        if m == 0:
            return self.int_call(name, x.reg, y.reg)
        r = self.tmp('int')
        self.emit(f'{r} = call i64 @tomato_int_{name}_c(i64 {x.reg}, i64 {y.reg}, i32 {m})')
        return exf(r, 'int')

    def tag_small(self, raw: str) -> Ex:
        # a machine number known to be small (a length, a loop counter, a position) as an int
        s = self.tmp('shl')
        self.emit(f'{s} = shl nsw i64 {raw}, 1')
        t = self.tmp('tag')
        self.emit(f'{t} = or i64 {s}, 1')
        return exs(t, 'int')

    def int_from_machine(self, raw: str, signed: bool) -> Ex:
        # any 64-bit machine number (or an unsigned one) as an int
        r = self.tmp('int')
        if signed:
            self.emit(f'{r} = call i64 @tomato_int_from_i64(i64 {raw})')
        else:
            self.emit(f'{r} = call i64 @tomato_int_from_u64(i64 {raw})')
        return exf(r, 'int')

    def int_raw(self, e: Ex, live: list[Ex] = []) -> str:
        # the machine number for places that need one (an index, a range bound). The int is used up.
        if e.small:
            return self.arith('ashr', e.reg, '1')
        if not e.small and not small_text(e.reg):
            # Keep the extra range test off the tagged small-integer path.
            tagged = self.tmp('rawtag')
            small = self.tmp('rawsmall')
            check = self.label('rawcheck')
            ready = self.label('rawready')
            self.emit(f'{tagged} = and i64 {e.reg}, 1')
            self.emit(f'{small} = icmp ne i64 {tagged}, 0')
            self.cond_br(small, ready, check)
            self.place(check)
            fits = self.tmp('rawfits')
            large = self.tmp('rawlarge')
            self.emit(f'{fits} = call i32 @tomato_int_in_range(i64 {e.reg}, i32 64, i32 1)')
            self.emit(f'{large} = icmp eq i32 {fits}, 0')
            self.fail_if(large, 'the number is too big here', live + [e])
            self.br(ready)
            self.place(ready)
        r = self.tmp('raw')
        if self.consumable(e):
            self.emit(f'{r} = call i64 @tomato_int_raw_c(i64 {e.reg}, i32 1)')
            e.fresh = False              # used up: a second release must not free it again
            return r
        self.emit(f'{r} = call i64 @tomato_int_raw(i64 {e.reg})')
        return r

    def pow2_shift(self, y: Ex) -> int:
        # a constant divisor that is a power of two (2, 4, 8, ...): the shift count, else -1
        if not small_text(y.reg):
            return -1
        v = (int(y.reg) - 1) // 2
        if v < 2:
            return -1
        k = 0
        while v > 1:
            if v % 2 != 0:
                return -1
            v //= 2
            k += 1
        return k

    def nonzero_const(self, y: Ex) -> bool:
        # a constant divisor that is certainly not zero (no check is needed)
        return small_text(y.reg) and int(y.reg) != 1 and int(y.reg) != 0

    def int_pow2_call(self, name: str, x: Ex, k: int) -> Ex:
        # x // 2**k and x % 2**k on a small number are a shift and a mask; a big number takes the general path
        m = self.consume_mask(x, ex('0', 'int'))
        r = self.tmp('int')
        self.emit(f'{r} = call i64 @tomato_int_{name}_c(i64 {x.reg}, i32 {k}, i32 {m})')
        return exf(r, 'int')

    def int_zero_check(self, b: Ex, message: str, live: list[Ex] = []):
        if b.small:
            z = self.tmp('zero')
            self.emit(f'{z} = icmp ult i64 {b.reg}, 2')
            self.fail_if(z, message, live)
            return
        sign = self.tmp('sign')
        self.emit(f'{sign} = call i32 @tomato_int_sign(i64 {b.reg})')
        zero = self.tmp('zero')
        self.emit(f'{zero} = icmp eq i32 {sign}, 0')
        self.fail_if(zero, message, live)

    def num_arith(self, op: str, a: Ex, b: Ex, line: int, known: Rng | None = None) -> Ex:
        # + - * with an overflow stop, in the type both operands fit. known: the interval of the result (see range_of)
        t = self.common_type(a.ty, b.ty, line)
        x = self.resize(a, t)
        y = self.resize(b, t)
        if t == 'int' and known is not None and rng_small(known) and (x.small or small_text(x.reg)) and (y.small or small_text(y.reg)):
            return self.small_arith(op, x, y)
        if t == 'int' and self.bail != '' and (x.small or small_text(x.reg)) and (y.small or small_text(y.reg)):
            if op == 'mul':
                pm = self.fast_checked('smul', self.fuse_form(ex(x.reg, 'T'), 'D').reg, self.fuse_form(ex(y.reg, 'T'), 'R').reg, self.bail)
                return exs(self.arith('or', pm, '1'), 'int')
            return exs(self.fast_checked('s' + op, x.reg, self.fuse_form(ex(y.reg, 'T'), 'D').reg, self.bail), 'int')
        if t == 'int':
            return self.int_call_c(op, x, y)
        llt = llvm_type(t)
        sg = 's' if is_signed(t) else 'u'
        intr = f'llvm.{sg}{op}.with.overflow.{llt}'
        self.mod.declare(f'declare {{{llt}, i1}} @{intr}({llt}, {llt})')
        pair = self.tmp('pair')
        self.emit(f'{pair} = call {{{llt}, i1}} @{intr}({llt} {x.reg}, {llt} {y.reg})')
        r = self.tmp('r')
        self.emit(f'{r} = extractvalue {{{llt}, i1}} {pair}, 0')
        ov = self.tmp('ov')
        self.emit(f'{ov} = extractvalue {{{llt}, i1}} {pair}, 1')
        self.fail_if(ov, 'integer overflow')
        return ex(r, t)

    def small_arith(self, op: str, x: Ex, y: Ex) -> Ex:
        # + - * of two small numbers whose result is known to be small: plain 64-bit arithmetic on the tagged words, with no tag
        # test and no overflow check. For x = 2a+1 and y = 2b+1: x + (y - 1) = 2(a+b)+1, x - (y - 1) = 2(a-b)+1 and
        # (x - 1) * (y >> 1) + 1 = 2ab+1; nothing overflows because the result is small.
        r = self.tmp('small')
        if op == 'mul':
            xm = str(int(x.reg) - 1) if small_text(x.reg) else self.arith('sub', x.reg, '1')
            yh = str((int(y.reg) - 1) // 2) if small_text(y.reg) else self.arith('ashr', y.reg, '1')
            p = self.tmp('prod')
            self.emit(f'{p} = mul nsw i64 {xm}, {yh}')
            self.emit(f'{r} = or i64 {p}, 1')
            return exs(r, 'int')
        ym = str(int(y.reg) - 1) if small_text(y.reg) else self.arith('sub', y.reg, '1')
        self.emit(f'{r} = {op} nsw i64 {x.reg}, {ym}')
        return exs(r, 'int')

    # ---- fused integer arithmetic (release mode). An expression of two or more + - * (and // or % by a positive constant) on
    # ints, such as `(self.x + self.v * round) % 1000003`, is compiled as one unit: the numbers it starts from (its leaves) are
    # worked out first, from left to right; then one test of all their tags together leads to a fast copy that works on the
    # tagged words, with nothing but an overflow test per operation; a big number or an overflow leads to a slow copy
    # that does the whole expression again from the same leaves with the runtime's general operations. The operations
    # themselves cannot raise and run no user code, so working out the leaves first changes nothing a program can see.
    def peek_type(self, n: Node) -> str:
        # the type of a simple expression, without compiling it, or '' when it is not one of the simple cases known here
        k = n.kind
        if k == 'IntLit':
            return 'int' if n.fields[0].num < 2 ** 61 else ''
        if k == 'UnOp':
            inner = self.peek_type(val_node(n.fields[1]))
            if n.fields[0].text == 'not':
                return 'bool' if inner == 'bool' else ''
            if n.fields[0].text == '-' and inner == 'float':
                return 'float'
            return 'int' if n.fields[0].text == '-' and val_node(n.fields[1]).kind == 'IntLit' and inner == 'int' else ''
        if k == 'FloatLit':
            return 'float'
        if k == 'BoolLit':
            return 'bool'
        if k == 'StrLit':
            return 'str'
        if k == 'Name':
            name = n.fields[0].text
            if name in self.slots:
                return self.types[name]
            if name in self.calm_types:
                return self.calm_types[name]
            ck = self.mod.resolve(name)
            if ck != '' and ck in self.mod.consts:
                return self.peek_type(self.mod.consts[ck])
            return ''
        if k == 'Attr':
            at = self.peek_type(val_node(n.fields[0]))
            if not is_class(at) or not self.mod.has_class(at[1:]):
                return ''
            c = self.mod.find_class(at[1:], n.line)
            pos = field_position(c, n.fields[1].text)
            return c.fields[pos].ty if pos >= 0 else ''
        if k == 'Index':
            bt = self.peek_type(val_node(n.fields[0]))
            if is_list(bt) and not is_mtuple(bt) and not is_optional(bt) and self.peek_type(val_node(n.fields[1])) == 'int':
                return elem_of(bt)
            if bt == 'str' and self.peek_type(val_node(n.fields[1])) == 'int':
                return 'str'
            return ''
        if k == 'BinOp':
            op = n.fields[0].text
            lt = self.peek_type(val_node(n.fields[1]))
            rt2 = self.peek_type(val_node(n.fields[2]))
            if op == 'and' or op == 'or':
                return 'bool' if lt == 'bool' and rt2 == 'bool' else ''
            if lt == 'str' and rt2 == 'str':
                return 'bool' if op == '==' or op == '!=' or op == '<' or op == '<=' or op == '>' or op == '>=' else ''
            if lt == 'bool' and rt2 == 'bool':
                return 'bool' if op == '==' or op == '!=' else ''
            if not (lt == 'int' or lt == 'float') or not (rt2 == 'int' or rt2 == 'float'):
                return ''
            if op == '==' or op == '!=' or op == '<' or op == '<=' or op == '>' or op == '>=':
                return 'bool'
            if op == '+' or op == '-' or op == '*':
                return 'int' if lt == 'int' and rt2 == 'int' else 'float'
            if op == '//' or op == '%' or op == '&' or op == '|' or op == '^' or op == '>>' or op == '<<':
                return 'int' if lt == 'int' and rt2 == 'int' else ''
            return 'float' if op == '/' else ''
        if k == 'Call':
            f = val_node(n.fields[0])
            if f.kind == 'Name' and f.fields[0].text == 'len' and 'len' not in self.slots:
                args = val_nodes(n.fields[1])
                at3 = self.peek_type(args[0]) if len(args) == 1 else ''
                return 'int' if (is_list(at3) or at3 == 'str') and not is_optional(at3) else ''
            if f.kind == 'Name' and f.fields[0].text not in self.slots:
                key = self.mod.resolve(f.fields[0].text)
                if key != '' and key not in self.mod.generics and not self.mod.has_class(key) and self.mod.has_func(key):
                    info = self.mod.find(key, n.line)
                    if not info.is_async and not info.is_gen:
                        return info.ret
            elif f.kind == 'Attr':
                rt = self.peek_type(val_node(f.fields[0]))
                if is_class(rt) and self.mod.has_class(rt[1:]) and field_position(self.mod.find_class(rt[1:], n.line), f.fields[1].text) < 0:
                    found = self.mod.lookup_method(rt[1:], f.fields[1].text)
                    if found is not None and not found.is_async and not found.is_gen:
                        return found.ret
        return ''

    def quiet_read(self, n: Node) -> bool:
        # can this expression (whose type peek_type knows) be worked out without running any user code?
        if n.kind == 'Attr':
            return self.quiet_read(val_node(n.fields[0]))
        if n.kind == 'Index' or n.kind == 'BinOp':
            at = 0 if n.kind == 'Index' else 1
            return self.quiet_read(val_node(n.fields[at])) and self.quiet_read(val_node(n.fields[at + 1]))
        return n.kind == 'Name' or n.kind == 'IntLit' or n.kind == 'UnOp'

    def fuse_ops(self, n: Node, leaves: list[Node]) -> int:
        # how many operations the fused expression n has (its leaves are added to leaves), or -1 when it cannot be fused
        if n.kind == 'BinOp':
            op = n.fields[0].text
            left = val_node(n.fields[1])
            right = val_node(n.fields[2])
            if op == '+' or op == '-' or op == '*':
                a = self.fuse_ops(left, leaves)
                if a < 0:
                    return -1
                b = self.fuse_ops(right, leaves)
                return -1 if b < 0 else a + b + 1
            if (op == '//' or op == '%') and right.kind == 'IntLit' and right.fields[0].num > 0 and right.fields[0].num < 2 ** 60:
                a2 = self.fuse_ops(left, leaves)
                return -1 if a2 < 0 else a2 + 1
        if len(leaves) >= 12 or self.peek_type(n) != 'int':
            return -1
        leaves.append(n)
        return 0

    def fusable(self, n: Node) -> bool:
        if self.mod.mode != 2 or n.kind != 'BinOp':
            return False
        leaves: list[Node] = []
        return self.fuse_ops(n, leaves) >= (1 if self.bail != '' else 2)

    def fuse_update(self, name: str, n: Node) -> bool:
        # `name = <n>` where n is a fused expression that reads the variable directly exactly once: the operation may take the old
        # number over (see self_update), because it is used up only after every leaf has been worked out
        leaves: list[Node] = []
        if self.bail != '' or self.mod.mode != 2 or n.kind != 'BinOp' or self.fuse_ops(n, leaves) < 2:
            return False
        count = 0
        for leaf in leaves:
            if leaf.kind == 'Name' and leaf.fields[0].text == name:
                count += 1
            elif leaf.kind != 'Name':
                # the taken number is the first read of the name, so no read may hide inside another leaf
                inside: list[str] = []
                names_read(leaf, inside)
                if name in inside or has_comp(leaf):
                    return False
        return count == 1

    def fused(self, n: Node) -> Ex:
        nodes: list[Node] = []
        self.fuse_ops(n, nodes)
        leaves: list[Ex] = []
        held_before = len(self.held)
        for k, leaf in enumerate(nodes):
            lend = True
            for later in nodes[k + 1:]:
                if not self.quiet_read(later):
                    lend = False
            e = self.need_small(self.operand(leaf, lend))
            leaves.append(e)
            if leaf.kind != 'Name':             # a variable's number stays the variable's until the operation takes it
                self.hold(e)
        self.drop_held(held_before)
        test = ''
        for e2 in leaves:
            if not e2.small and not small_text(e2.reg):
                test = e2.reg if test == '' else self.arith('and', test, e2.reg)
        if self.bail != '':                     # the fast copy of a loop nest: the general copy is the slow copy
            self.fuse_at = 0
            return exs(self.fuse_form(self.fuse_fast(n, leaves, self.bail), 'T').reg, 'int')
        slow = self.label('fuseslow')
        join = self.label('fusejoin')
        self.fuse_used = False
        if test != '':
            bit = self.arith('and', test, '1')
            c = self.tmp('small')
            self.emit(f'{c} = icmp ne i64 {bit}, 0')
            fast = self.label('fusefast')
            self.cond_br(c, fast, slow)
            self.place(fast)
            self.fuse_used = True
        self.fuse_at = 0
        r = self.fuse_fast(n, leaves, slow)
        value = self.fuse_form(r, 'T').reg
        small_result = n.fields[0].text == '%'
        if not self.fuse_used:                  # nothing can go wrong: there is no slow copy
            return exs(value, 'int')
        done = self.label('fuseok')
        self.br(done)
        self.place(done)
        self.br(join)
        self.place(slow)
        self.fuse_at = 0
        sv = self.fuse_slow(n, leaves)
        self.br(join)
        self.place(join)
        out = self.tmp('fused')
        self.emit(f'{out} = phi i64 [ {value}, %{done} ], [ {sv.reg}, %{slow} ]')
        e3 = exf(out, 'int')
        e3.small = small_result                 # the remainder of a division by a constant that fits a word always fits
        return e3

    def fuse_form(self, e: Ex, form: str) -> Ex:
        # a number of the fast copy in the form that is asked for. e.ty is its form now: 'T' the tagged word 2v+1, 'D' the word 2v, 'R' v itself
        if e.ty == form:
            return e
        if small_text(e.reg):                   # a constant (always tagged)
            return ex(str(int(e.reg) - 1) if form == 'D' else str((int(e.reg) - 1) // 2), form)
        if form == 'R':
            return ex(self.arith('ashr', e.reg, '1'), 'R')
        if e.ty == 'R':
            d = self.tmp('dbl')
            self.emit(f'{d} = shl nsw i64 {e.reg}, 1')
            if form == 'D':
                return ex(d, 'D')
            return ex(self.arith('or', d, '1'), 'T')
        if form == 'T':
            return ex(self.arith('or', e.reg, '1'), 'T')
        return ex(self.arith('sub', e.reg, '1'), 'D')

    def fuse_check(self, op: str, a: str, b: str, proved: bool, slow: str) -> str:
        if proved:
            r = self.tmp('r')
            self.emit(f'{r} = {op} nsw i64 {a}, {b}')
            return r
        self.fuse_used = True
        return self.fast_checked('s' + op, a, b, slow)

    def fuse_fast(self, n: Node, leaves: list[Ex], slow: str) -> Ex:
        op = n.fields[0].text if n.kind == 'BinOp' else ''
        right = val_node(n.fields[2]) if n.kind == 'BinOp' else n
        if op == '//' or op == '%':
            if right.kind != 'IntLit' or right.fields[0].num <= 0 or right.fields[0].num >= 2 ** 60:
                op = ''
        elif op != '+' and op != '-' and op != '*':
            op = ''
        if op == '':
            e = leaves[self.fuse_at]
            self.fuse_at += 1
            return ex(e.reg, 'T')
        a = self.fuse_fast(val_node(n.fields[1]), leaves, slow)
        if op == '//' or op == '%':
            d = right.fields[0].num
            at = self.fuse_form(a, 'T')         # floor division of 2v+1 by 2d gives floor(v / d), and the remainder is 2(v mod d)+1
            k = 0
            p = d
            while p > 1 and p % 2 == 0:
                p //= 2
                k += 1
            plus = False                        # is the number divided known not to be negative?
            if self.tracking():
                known = self.range_of(val_node(n.fields[1]), self.facts)
                if known is not None:
                    plus = known.lo >= 0
            if p == 1:
                if op == '//':
                    return ex(self.arith('ashr', at.reg, str(k + 1)), 'R')
                return ex(self.arith('and', at.reg, str(2 ** (k + 1) - 1)), 'T')
            rem = self.arith('srem', at.reg, str(2 * d))
            if op == '%':
                if plus:
                    return ex(rem, 'T')
                sign = self.arith('ashr', rem, '63')
                fix = self.arith('and', sign, str(2 * d))
                return ex(self.arith('add', rem, fix), 'T')
            q = self.arith('sdiv', at.reg, str(2 * d))
            if plus:
                return ex(q, 'R')
            return ex(self.arith('add', q, self.arith('ashr', rem, '63')), 'R')
        b = self.fuse_fast(right, leaves, slow)
        proved = False
        if self.tracking():
            interval = self.range_of(n, self.facts)
            if interval is not None:
                proved = rng_small(interval)
        if op == '*':
            if small_text(a.reg) or a.ty == 'R':              # the number that is already plain (or a constant) is the factor
                return ex(self.fuse_check('mul', self.fuse_form(b, 'D').reg, self.fuse_form(a, 'R').reg, proved, slow), 'D')
            return ex(self.fuse_check('mul', self.fuse_form(a, 'D').reg, self.fuse_form(b, 'R').reg, proved, slow), 'D')
        if a.ty == 'R':
            a = self.fuse_form(a, 'D')
        if b.ty == 'R':
            b = self.fuse_form(b, 'D')
        if op == '+':
            if a.ty == 'T' and b.ty == 'T':
                if small_text(a.reg):
                    a = self.fuse_form(a, 'D')
                else:
                    b = self.fuse_form(b, 'D')
            form = 'T' if a.ty == 'T' or b.ty == 'T' else 'D'
            return ex(self.fuse_check('add', a.reg, b.reg, proved, slow), form)
        if b.ty == 'T':
            b = self.fuse_form(b, 'D')
        return ex(self.fuse_check('sub', a.reg, b.reg, proved, slow), a.ty)

    def fuse_slow(self, n: Node, leaves: list[Ex]) -> Ex:
        op = n.fields[0].text if n.kind == 'BinOp' else ''
        name = ''
        if op == '+':
            name = 'add'
        elif op == '-':
            name = 'sub'
        elif op == '*':
            name = 'mul'
        elif op == '//' or op == '%':
            d = val_node(n.fields[2])
            if d.kind == 'IntLit' and d.fields[0].num > 0 and d.fields[0].num < 2 ** 60:
                name = 'floordiv' if op == '//' else 'mod'
        if name == '':
            leaf = leaves[self.fuse_at]
            self.fuse_at += 1
            return leaf
        a = self.fuse_slow(val_node(n.fields[1]), leaves)
        b = ex('', '')
        if op == '//' or op == '%':
            b = ex(str(val_node(n.fields[2]).fields[0].num * 2 + 1), 'int')
        else:
            b = self.fuse_slow(val_node(n.fields[2]), leaves)
        m = self.consume_mask(a, b)
        r = self.tmp('big')
        self.emit(f'{r} = call i64 @tomato_int_{name}_slow(i64 {a.reg}, i64 {b.reg}, i32 {m})')
        return exf(r, 'int')

    def int_equal_const(self, op: str, x: Ex, k: Ex) -> Ex:
        # x == 3 and x != 0: a big number is never equal to a small constant (a big number is always outside the small range), so
        # comparing the words is enough: no tag test, no call. The word 0 (a slot nobody has written) is the number 0 too.
        c = self.tmp('cmp')
        cc = 'eq'
        if op == '!=':
            cc = 'ne'
        if k.reg == '1':
            if op == '==':
                self.emit(f'{c} = icmp ult i64 {x.reg}, 2')
            else:
                self.emit(f'{c} = icmp ugt i64 {x.reg}, 1')
        else:
            self.emit(f'{c} = icmp {cc} i64 {x.reg}, {k.reg}')
        if self.consumable(x):
            self.emit(f'call void @tomato_int_free(i64 {x.reg})')
            x.fresh = False
        return self.bool_of(c)

    def int_compare(self, op: str, x: Ex, y: Ex) -> Ex:
        if op == '==' or op == '!=':
            if small_text(y.reg) and y.reg[0].isdigit() and not small_text(x.reg):
                return self.int_equal_const(op, x, y)
            if small_text(x.reg) and x.reg[0].isdigit() and not small_text(y.reg):
                return self.int_equal_const(op, y, x)
        # Small ints (odd words) order like the numbers they hold. The runtime handles other representations.
        cc = signed_cc(op)
        m = self.consume_mask(x, y)
        both = ''
        if (small_text(x.reg) or x.small) and (small_text(y.reg) or y.small):
            both = ''
        elif (small_text(x.reg) or x.small):
            both = y.reg
        elif (small_text(y.reg) or y.small):
            both = x.reg
        else:
            both = self.tmp('both')
            self.emit(f'{both} = and i64 {x.reg}, {y.reg}')
        if both == '':
            r = self.tmp('cmp')
            self.emit(f'{r} = icmp {cc} i64 {x.reg}, {y.reg}')
            return self.bool_of(r)
        bit = self.tmp('smallbit')
        self.emit(f'{bit} = and i64 {both}, 1')
        small = self.tmp('small')
        self.emit(f'{small} = icmp ne i64 {bit}, 0')
        fast = self.label('cmpfast')
        slow = self.label('cmpslow')
        join = self.label('cmpjoin')
        self.cond_br(small, fast, slow)
        self.place(fast)
        fr = self.tmp('cmp')
        self.emit(f'{fr} = icmp {cc} i64 {x.reg}, {y.reg}')
        self.br(join)
        self.place(slow)
        c = self.tmp('icmp')
        self.emit(f'{c} = call i32 @tomato_int_cmp_c(i64 {x.reg}, i64 {y.reg}, i32 {m})')
        sr = self.tmp('cmp')
        self.emit(f'{sr} = icmp {cc} i32 {c}, 0')
        self.br(join)
        self.place(join)
        r = self.tmp('cmp')
        self.emit(f'{r} = phi i1 [ {fr}, %{fast} ], [ {sr}, %{slow} ]')
        return self.bool_of(r)

    def num_compare(self, op: str, a: Ex, b: Ex, line: int) -> Ex:
        t = self.common_type(a.ty, b.ty, line)
        x = self.resize(a, t)
        y = self.resize(b, t)
        if t == 'int':
            return self.int_compare(op, x, y)
        cc = signed_cc(op)
        if cc.startswith('s') and not is_signed(t):
            cc = 'u' + cc[1:]
        c = self.tmp('cmp')
        self.emit(f'{c} = icmp {cc} {llvm_type(t)} {x.reg}, {y.reg}')
        return self.bool_of(c)

    def num_modulo(self, a: Ex, b: Ex, line: int) -> Ex:
        # Python-style: the result has the sign of the divisor (D05au); a zero divisor stops the program
        t = self.common_type(a.ty, b.ty, line)
        x = self.resize(a, t)
        y = self.resize(b, t)
        if t == 'int':
            k = self.pow2_shift(y)
            if k > 0:
                return self.int_pow2_call('modp2', x, k)
            if not self.nonzero_const(y):
                self.int_zero_check(y, 'modulo by zero', [x, y])
            both_small = (x.small or small_text(x.reg)) and (y.small or small_text(y.reg))
            rest = self.int_call_c('mod', x, y)
            rest.small = both_small             # it lies between 0 and the divisor
            return rest
        llt = llvm_type(t)
        zero = self.tmp('zero')
        self.emit(f'{zero} = icmp eq {llt} {y.reg}, 0')
        self.fail_if(zero, 'modulo by zero')
        if not is_signed(t):
            r = self.tmp('urem')
            self.emit(f'{r} = urem {llt} {x.reg}, {y.reg}')
            return ex(r, t)
        r = self.tmp('srem')
        self.emit(f'{r} = srem {llt} {x.reg}, {y.reg}')
        mix = self.tmp('mix')
        self.emit(f'{mix} = xor {llt} {r}, {y.reg}')
        differ = self.tmp('differ')
        self.emit(f'{differ} = icmp slt {llt} {mix}, 0')
        nonzero = self.tmp('nonzero')
        self.emit(f'{nonzero} = icmp ne {llt} {r}, 0')
        fix = self.tmp('fix')
        self.emit(f'{fix} = and i1 {differ}, {nonzero}')
        amount = self.tmp('amount')
        self.emit(f'{amount} = select i1 {fix}, {llt} {y.reg}, {llt} 0')
        out = self.tmp('mod')
        self.emit(f'{out} = add {llt} {r}, {amount}')
        return ex(out, t)

    def num_floor_divide(self, a: Ex, b: Ex, line: int) -> Ex:
        # //: the quotient rounded toward minus infinity, like Python; a zero divisor stops the program
        t = self.common_type(a.ty, b.ty, line)
        x = self.resize(a, t)
        y = self.resize(b, t)
        if t == 'int':
            k = self.pow2_shift(y)
            if k > 0:
                return self.int_pow2_call('floordivp2', x, k)
            if not self.nonzero_const(y):
                self.int_zero_check(y, 'division by zero', [x, y])
            return self.need_small(self.int_call_c('floordiv', x, y))
        llt = llvm_type(t)
        zero = self.tmp('zero')
        self.emit(f'{zero} = icmp eq {llt} {y.reg}, 0')
        self.fail_if(zero, 'division by zero')
        if not is_signed(t):
            r = self.tmp('udiv')
            self.emit(f'{r} = udiv {llt} {x.reg}, {y.reg}')
            return ex(r, t)
        least = self.tmp('least')
        self.emit(f'{least} = shl {llt} 1, {bits_of(t) - 1}')
        is_least = self.tmp('isleast')
        self.emit(f'{is_least} = icmp eq {llt} {x.reg}, {least}')
        is_minus = self.tmp('isminus')
        self.emit(f'{is_minus} = icmp eq {llt} {y.reg}, -1')
        both = self.tmp('both')
        self.emit(f'{both} = and i1 {is_least}, {is_minus}')
        self.fail_if(both, 'integer overflow')
        q = self.tmp('sdiv')
        self.emit(f'{q} = sdiv {llt} {x.reg}, {y.reg}')
        r = self.tmp('srem')
        self.emit(f'{r} = srem {llt} {x.reg}, {y.reg}')
        mix = self.tmp('mix')
        self.emit(f'{mix} = xor {llt} {r}, {y.reg}')
        differ = self.tmp('differ')
        self.emit(f'{differ} = icmp slt {llt} {mix}, 0')
        nonzero = self.tmp('nonzero')
        self.emit(f'{nonzero} = icmp ne {llt} {r}, 0')
        fix = self.tmp('fix')
        self.emit(f'{fix} = and i1 {differ}, {nonzero}')
        amount = self.tmp('amount')
        self.emit(f'{amount} = select i1 {fix}, {llt} 1, {llt} 0')
        out = self.tmp('floor')
        self.emit(f'{out} = sub {llt} {q}, {amount}')
        return ex(out, t)

    def num_bitwise(self, op: str, a: Ex, b: Ex, line: int) -> Ex:
        # & | ^ on two's-complement integers of the common type
        t = self.common_type(a.ty, b.ty, line)
        x = self.resize(a, t)
        y = self.resize(b, t)
        if t == 'int':
            if not ((x.small or small_text(x.reg)) and (y.small or small_text(y.reg))):
                both = self.tmp('bittags')
                tag = self.tmp('bittag')
                large = self.tmp('bitlarge')
                self.emit(f'{both} = and i64 {x.reg}, {y.reg}')
                self.emit(f'{tag} = and i64 {both}, 1')
                self.emit(f'{large} = icmp eq i64 {tag}, 0')
                self.fail_if(large, 'the bitwise operators & | ^ do not work on very large integers', [x, y])
            else:                             # tagged words 2v+1: the tags take care of themselves, except that ^ clears them
                word = self.arith('and' if op == '&' else ('or' if op == '|' else 'xor'), x.reg, y.reg)
                return exs(self.arith('or', word, '1') if op == '^' else word, 'int')
            code = '0'
            if op == '|':
                code = '1'
            elif op == '^':
                code = '2'
            r = self.tmp('bit')
            self.emit(f'{r} = call i64 @tomato_int_bitop(i64 {x.reg}, i64 {y.reg}, i32 {code})')
            self.release(x)
            self.release(y)
            return exs(r, 'int')
        ins = 'and'
        if op == '|':
            ins = 'or'
        elif op == '^':
            ins = 'xor'
        r = self.tmp('bit')
        self.emit(f'{r} = {ins} {llvm_type(t)} {x.reg}, {y.reg}')
        return ex(r, t)

    def num_shift(self, op: str, a: Ex, b: Ex, line: int) -> Ex:
        # << and >> on whole numbers: the result has the type of the left operand; the count is any whole number that is not
        # negative. A fixed-width result is range-checked like the other arithmetic.
        x = self.resize(a, 'int')
        y = self.resize(b, 'int')
        if (x.small or small_text(x.reg)) and small_text(y.reg) and op == '>>' and int(y.reg) > 0 and int(y.reg) < 120 and a.ty == 'int':
            return exs(self.arith('or', self.arith('ashr', x.reg, str((int(y.reg) - 1) // 2)), '1'), 'int')      # a constant count, of a small number
        tag = self.tmp('shifttag')
        big = self.tmp('shiftbig')
        long = self.tmp('shiftlong')
        large = self.tmp('shiftlarge')
        negative = self.tmp('shiftnegative')
        self.emit(f'{tag} = and i64 {y.reg}, 1')
        self.emit(f'{big} = icmp eq i64 {tag}, 0')
        # The runtime accepts a count below 2**31. A small integer is encoded as 2*n+1.
        self.emit(f'{long} = icmp sge i64 {y.reg}, 4294967297')
        self.emit(f'{large} = or i1 {big}, {long}')
        self.fail_if(large, 'the shift count is too big', [x, y])
        self.emit(f'{negative} = icmp slt i64 {y.reg}, 0')
        self.fail_if(negative, 'negative shift count', [x, y])
        name = 'shl' if op == '<<' else 'shr'
        was_small = (x.small or small_text(x.reg)) and (y.small or small_text(y.reg))
        r = self.int_call_c(name, x, y)
        if was_small and op == '>>':
            r.small = True
        r = self.need_small(r)
        if a.ty != 'int':
            return self.convert_explicit(r, a.ty, line)
        return r

    def num_power(self, a: Ex, b: Ex, line: int) -> Ex:
        # ** on integers: whole-number powers that stop on overflow or a negative exponent; the result type is the
        # common type, converted back with a range check when it is a fixed width
        t = self.common_type(a.ty, b.ty, line) if a.ty != 'int' and b.ty != 'int' else 'int'
        x = self.resize(a, 'int')
        y = self.resize(b, 'int')
        sign = self.tmp('expsign')
        self.emit(f'{sign} = call i32 @tomato_int_sign(i64 {y.reg})')
        negative = self.tmp('negexp')
        self.emit(f'{negative} = icmp slt i32 {sign}, 0')
        self.fail_if(negative, 'a negative exponent needs a float', [x, y])
        if not y.small and not small_text(y.reg):
            tag = self.tmp('exptag')
            large = self.tmp('explarge')
            self.emit(f'{tag} = and i64 {y.reg}, 1')
            self.emit(f'{large} = icmp eq i64 {tag}, 0')
            self.fail_if(large, 'the exponent is too big', [x, y])
        r = self.tmp('pow')
        self.emit(f'{r} = call i64 @tomato_int_pow(i64 {x.reg}, i64 {y.reg})')
        self.release(x)
        self.release(y)
        if t != 'int':
            return self.convert_explicit(exf(r, 'int'), t, line)
        return exf(r, 'int')

    def as_double(self, e: Ex, live: list[Ex] = []) -> str:
        if e.ty == 'float':
            return e.reg
        return self.to_double(e, live)

    def finite_known(self, n: Node | None) -> bool:
        # the result of the float operation n is known to be finite, so it needs no check
        if n is None or not self.tracking():
            return False
        r = self.range_of(n, self.facts)
        return r is not None and r.fl and frng_bounded(r)

    def float_op(self, op: str, a: Ex, b: Ex, line: int, defer: bool = False, node: Node | None = None) -> Ex:
        # arithmetic and comparison when either side is a float: the other side is converted to a float. node: the whole expression
        if not (a.ty == 'float' or is_numeric(a.ty)) or not (b.ty == 'float' or is_numeric(b.ty)):
            raise CompileError(f"cannot use '{op}' with {shown(a.ty)} and {shown(b.ty)}", line)
        x = self.as_double(a, [b])
        y = self.as_double(b)
        if op == '+' or op == '-' or op == '*':
            ins = 'fadd'
            if op == '-':
                ins = 'fsub'
            elif op == '*':
                ins = 'fmul'
            r = self.tmp('f')
            self.emit(f'{r} = {ins} double {x}, {y}')
            # inf and NaN never become finite again under + - *, so one check on the last result of a chain covers the whole chain
            result = ex(r, 'float')
            if not self.finite_known(node):
                if defer:
                    result.unchecked = r
                else:
                    self.check_finite(r)
            return result
        if op == '/' or op == '//' or op == '%':
            zero = self.tmp('fzero')
            self.emit(f'{zero} = fcmp oeq double {y}, 0.0')
            if op == '%':
                self.fail_if(zero, 'modulo by zero')
            else:
                self.fail_if(zero, 'division by zero')
            r = self.tmp('f')
            if op == '/':
                self.emit(f'{r} = fdiv double {x}, {y}')
            elif op == '//':
                self.emit(f'{r} = call double @tomato_floor_div_f64(double {x}, double {y})')
            else:
                self.emit(f'{r} = call double @tomato_mod_f64(double {x}, double {y})')
            if not self.finite_known(node):
                self.check_finite(r)
            return ex(r, 'float')
        if op == '**':
            r = self.tmp('f')
            self.emit(f'{r} = call double @tomato_pow_f64(double {x}, double {y})')
            self.check_finite(r)
            return ex(r, 'float')
        cc = ''
        if op == '==':
            cc = 'oeq'
        elif op == '!=':
            cc = 'une'
        elif op == '<':
            cc = 'olt'
        elif op == '<=':
            cc = 'ole'
        elif op == '>':
            cc = 'ogt'
        elif op == '>=':
            cc = 'oge'
        else:
            raise CompileError(f"'{op}' does not work on floats\nuse it on integers, or use / // or ** on floats", line)
        c = self.tmp('fcmp')
        self.emit(f'{c} = fcmp {cc} double {x}, {y}')
        return self.bool_of(c)

    def flush_unchecked(self, e: Ex):
        if e.unchecked != '':
            self.check_finite(e.unchecked)
            e.unchecked = ''

    def float_chain(self, n: Node) -> bool:
        # a + - * expression, whose finite check may be left to the + - * that uses it
        if n.kind != 'BinOp':
            return False
        op = n.fields[0].text
        return op == '+' or op == '-' or op == '*'

    def float_pure(self, n: Node) -> int:
        # 2: a float read or float arithmetic that can fail only with infinity or NaN; 1: an integer read or literal;
        # 0: anything else. A class operand can call a custom operator, and an optional operand can fail when unwrapped.
        # (An int operand is converted by to_double, which stops with "an int is too large to be a float" when it does not fit,
        # so it never brings infinity into a chain.)
        k = n.kind
        if k == 'FloatLit':
            return 2
        if k == 'IntLit':
            return 1
        if k == 'Name':
            name = n.fields[0].text
            if name not in self.slots:
                return 0
            ty = self.types[name]
            if ty == 'float':
                return 2
            return 1 if is_numeric(ty) else 0
        if self.bail != '' and (k == 'Attr' or k == 'Index') and self.calm(n):
            return 2 if self.peek_type(n) == 'float' else 1      # (a failing read leaves the fast copy, whatever was checked before it)
        if k == 'BinOp' and self.float_chain(n):
            x = self.float_pure(val_node(n.fields[1]))
            y = self.float_pure(val_node(n.fields[2]))
            if x > 0 and y > 0 and (x == 2 or y == 2):
                return 2
        return 0

    def check_finite(self, r: str, message: str = 'the float result is infinite or not a number', live: list[Ex] = []):
        # a float result that is infinite or not a number stops the program (P58). live: operands the failure path must free
        if self.mod.mode == 2 and len(live) == 0 and message == 'the float result is infinite or not a number':
            # one comparison: x - x is not a number when x is infinite or not a number, and 0 otherwise
            none = self.tmp('diff')
            self.emit(f'{none} = fsub double {r}, {r}')
            if self.grouping:
                self.group_checks.append([r, none])
                return
            wrong = self.tmp('notfinite')
            self.emit(f'{wrong} = fcmp uno double {none}, 0.0')
            self.fail_if(wrong, message)
            return
        d = self.tmp('diff')
        self.emit(f'{d} = fsub double {r}, {r}')
        ok = self.tmp('finite')
        self.emit(f'{ok} = fcmp oeq double {d}, 0.0')
        bad = self.tmp('notfinite')
        self.emit(f'{bad} = xor i1 {ok}, true')
        self.fail_if(bad, message, live)

    def float_call(self, v: Ex, line: int) -> Ex:
        # float(x): a whole number or a float as a float, or text written as a number
        if v.ty == 'str':
            return self.text_to_float(v)
        if v.ty == 'float':
            return v
        if is_numeric(v.ty):
            return ex(self.to_double(v), 'float')
        raise CompileError(f'float() takes a number, but this is {shown(v.ty)}', line)

    def text_to_int(self, v: Ex) -> Ex:
        # int(text): a whole number written in decimal, spaces around it allowed; anything else raises a RuntimeError (the
        # runtime gives the word 0, which is never a number it makes)
        r = self.tmp('parsed')
        self.emit(f'{r} = call i64 @tomato_text_int(ptr {v.reg})')
        self.release(v)
        bad = self.tmp('notint')
        self.emit(f'{bad} = icmp eq i64 {r}, 0')
        self.fail_if(bad, 'the text is not a whole number')
        return exf(r, 'int')

    def text_to_float(self, v: Ex) -> Ex:
        ok = self.tmp('isfloat')
        self.emit(f'{ok} = call i32 @tomato_text_float_ok(ptr {v.reg})')
        bad = self.tmp('notfloat')
        self.emit(f'{bad} = icmp eq i32 {ok}, 0')
        r = self.tmp('parsed')
        self.emit(f'{r} = call double @tomato_text_float(ptr {v.reg})')
        self.release(v)
        self.fail_if(bad, 'the text is not a number')
        return ex(r, 'float')

    def float_to_int(self, v: Ex, line: int) -> Ex:
        # int(x) on a float: the whole part, towards zero (P58); infinity and NaN stop
        d = self.tmp('diff')
        self.emit(f'{d} = fsub double {v.reg}, {v.reg}')
        ok = self.tmp('finite')
        self.emit(f'{ok} = fcmp oeq double {d}, 0.0')
        bad = self.tmp('notfinite')
        self.emit(f'{bad} = xor i1 {ok}, true')
        self.fail_if(bad, 'a float that is infinite or not a number cannot become an int')
        r = self.tmp('whole')
        self.emit(f'{r} = call i64 @tomato_f64_to_int(double {v.reg})')
        return exf(r, 'int')

    def float_literal(self, mantissa: int, scale: int) -> Ex:
        # the digits as a decimal constant, which LLVM rounds to the nearest float
        text = f'{mantissa}.0e'
        if scale > 0:
            text += f'-{scale}'
        else:
            text += f'+{-scale}'
        return ex(text, 'float')

    def to_double(self, e: Ex, live: list[Ex] = []) -> str:
        # a whole number as a float, rounded once to the nearest (ties to even). An int that does not fit stops the program
        # (P58, D05af). live: other owned operands of the same operation, which the failure path frees
        if e.ty == 'int' and e.small and not small_text(e.reg):
            # a small number is the tagged word 2v+1: v is one shift away
            v = self.arith('ashr', e.reg, '1')
            d = self.tmp('fp')
            self.emit(f'{d} = sitofp i64 {v} to double')
            return d
        if e.ty == 'int':
            d = self.tmp('fp')
            self.emit(f'{d} = call double @tomato_int_to_f64(i64 {e.reg})')
            self.release(e)
            if not small_text(e.reg):
                self.check_finite(d, 'an int is too large to be a float', live)
            return d
        r = self.tmp('fp')
        op = 'sitofp' if is_signed(e.ty) else 'uitofp'
        self.emit(f'{r} = {op} {llvm_type(e.ty)} {e.reg} to double')
        return r

    def num_divide(self, a: Ex, b: Ex, line: int, node: Node | None = None) -> Ex:
        # int / int: the exact quotient rounded once to a float (D05ad), however large the operands
        if (a.ty != 'int' and bits_of(a.ty) <= 32) and (b.ty != 'int' and bits_of(b.ty) <= 32):
            # both fit a double exactly, so the hardware division is that one rounding
            zero = self.tmp('zero')
            self.emit(f'{zero} = icmp eq {llvm_type(b.ty)} {b.reg}, 0')
            self.fail_if(zero, 'division by zero', [a, b])
            q = self.tmp('div')
            self.emit(f'{q} = fdiv double {self.to_double(a)}, {self.to_double(b)}')
        else:
            x = self.resize(a, 'int')
            y = self.resize(b, 'int')
            self.int_zero_check(y, 'division by zero', [x, y])
            q = self.int_quotient(x, y)
            self.release(x)
            self.release(y)
        if not self.finite_known(node):
            self.check_finite(q)
        return ex(q, 'float')

    def int_quotient(self, x: Ex, y: Ex) -> str:
        # x / y of two ints (y not zero) as a double, rounded once. Two small numbers of at most 53 bits are exact as doubles, so
        # the division itself is that one rounding; anything else goes to the runtime, which divides the exact values
        # (infinite when the quotient is too large: the caller checks)
        tests: list[str] = []
        both = ''
        if not (small_text(x.reg) or x.small) and not (small_text(y.reg) or y.small):
            both = self.tmp('divtags')
            self.emit(f'{both} = and i64 {x.reg}, {y.reg}')
        elif not (small_text(x.reg) or x.small):
            both = x.reg
        elif not (small_text(y.reg) or y.small):
            both = y.reg
        if both != '':
            bit = self.tmp('divbit')
            self.emit(f'{bit} = and i64 {both}, 1')
            tagged = self.tmp('divsmall')
            self.emit(f'{tagged} = icmp ne i64 {bit}, 0')
            tests.append(tagged)
        for e in [x, y]:
            if small_text(e.reg):
                lit = (int(e.reg) - 1) // 2
                if lit >= -9007199254740992 and lit <= 9007199254740992:
                    continue
            v = self.tmp('divval')
            self.emit(f'{v} = ashr i64 {e.reg}, 1')
            sh = self.tmp('divshift')
            self.emit(f'{sh} = add i64 {v}, 9007199254740992')
            near = self.tmp('divnear')
            self.emit(f'{near} = icmp ule i64 {sh}, 18014398509481984')
            tests.append(near)
        fast = self.label('divfast')
        slow = self.label('divslow')
        join = self.label('divjoin')
        cond = ''
        for t in tests:
            if cond == '':
                cond = t
            else:
                c = self.tmp('divall')
                self.emit(f'{c} = and i1 {cond}, {t}')
                cond = c
        if cond == '':
            cond = 'true'
        self.cond_br(cond, fast, slow)
        self.place(fast)
        fx = self.tmp('fx')
        fy = self.tmp('fy')
        vx = self.arith('ashr', x.reg, '1')
        vy = self.arith('ashr', y.reg, '1')
        self.emit(f'{fx} = sitofp i64 {vx} to double')
        self.emit(f'{fy} = sitofp i64 {vy} to double')
        fq = self.tmp('div')
        self.emit(f'{fq} = fdiv double {fx}, {fy}')
        self.br(join)
        self.place(slow)
        sq = self.tmp('div')
        self.emit(f'{sq} = call double @tomato_int_div_f64(i64 {x.reg}, i64 {y.reg})')
        self.br(join)
        self.place(join)
        q = self.tmp('div')
        self.emit(f'{q} = phi double [ {fq}, %{fast} ], [ {sq}, %{slow} ]')
        return q

    def convert_explicit(self, v: Ex, target: str, line: int) -> Ex:
        # int[length=N](x): the same number in another integer type, or a stop when it does not fit (D05p)
        if v.ty == 'str' and target == 'int':
            return self.text_to_int(v)
        if not is_numeric(v.ty):
            raise CompileError(f'this conversion needs an integer, but the value is {shown(v.ty)}', line)
        if target == 'int' or contains(target, v.ty):
            return self.resize(v, target)
        if v.ty == 'int':
            ok = self.tmp('inrange')
            sg = '1' if is_signed(target) else '0'
            self.emit(f'{ok} = call i32 @tomato_int_in_range(i64 {v.reg}, i32 {bits_of(target)}, i32 {sg})')
            bad = self.tmp('bad')
            self.emit(f'{bad} = icmp eq i32 {ok}, 0')
            self.fail_if(bad, 'the number does not fit the integer type', [v])
            low = self.tmp('low')
            self.emit(f'{low} = call i64 @tomato_int_low64(i64 {v.reg})')
            self.release(v)
            if bits_of(target) == 64:
                return ex(low, target)
            cut = self.tmp('cut')
            self.emit(f'{cut} = trunc i64 {low} to {llvm_type(target)}')
            return ex(cut, target)
        width = bits_of(v.ty)
        if bits_of(target) > width:
            width = bits_of(target)
        width += 1
        wide = ex(self.widen(v, width), 'int')
        cut = self.tmp('cut')
        self.emit(f'{cut} = trunc i{width} {wide.reg} to {llvm_type(target)}')
        back = self.tmp('back')
        op = 'sext' if is_signed(target) else 'zext'
        self.emit(f'{back} = {op} {llvm_type(target)} {cut} to i{width}')
        bad = self.tmp('bad')
        self.emit(f'{bad} = icmp ne i{width} {wide.reg}, {back}')
        self.fail_if(bad, 'the number does not fit the integer type')
        return ex(cut, target)

    def widen(self, v: Ex, width: int) -> str:
        if bits_of(v.ty) == width:
            return v.reg
        r = self.tmp('wide')
        op = 'sext' if is_signed(v.ty) else 'zext'
        self.emit(f'{r} = {op} {llvm_type(v.ty)} {v.reg} to i{width}')
        return r

    def trace(self, first: bool):
        # debug mode: add this function and the current line to the call trace of the error leaving it (the first frame starts a new trace)
        if self.mod.mode != 1 or self.fname == '':
            return
        if first:
            self.emit('call void @tomato_trace_clear()')
        self.emit('call void @tomato_trace(ptr ' + self.mod.intern(self.fname) + f'.c, i32 {self.line})')

    def hold(self, e: Ex):
        # e is an owned temporary that stays alive while another operand is evaluated: if that raises, the error path frees it
        self.held.append(e)

    def drop_held(self, n: int):
        self.held = self.held[:n]

    def release_held(self):
        # on an error path: free every temporary still waiting in an enclosing expression (newest first)
        for e in reversed(self.held):
            self.release(e)

    def fail_if(self, bad: str, message: str, live: list[Ex] = []):
        # bad is an i1; when true, raise the specific RuntimeError subclass (D22a). live are the owned operands of the
        # failing operation itself, which the error path frees together with the temporaries held by the enclosing expressions.
        self.fail_with(bad, self.mod.error_class(self.mod.error_kind(message)), message, live)

    def fail_with(self, bad: str, cls: str, message: str, live: list[Ex] = []):
        if self.bail != '':
            self.bail_if(bad, live)           # the general copy raises the error
            return
        stop = self.label('stop')
        ok = self.label('ok')
        self.cond_br(bad, stop, ok)
        self.place(stop)
        for v in live:
            self.release(v)
        self.raise_here(cls, self.mod.intern(message), False, self.mod.error_id(self.mod.error_kind(message)))
        self.place(ok)

    def raise_here(self, cls: str, text: str, owned: bool, id: str):
        # raise a runtime failure of class cls with the message text (a text value; owned: released once the error holds it) and
        # leave the function
        self.release_held()
        err = self.tmp('err')
        args = 'ptr ' + text
        if self.mod.has_class(cls) and len(self.mod.find_method(cls, self.mod.find_class(cls, self.line).init, self.line).ptypes) == 2:
            args += ', ptr ' + self.mod.intern(id if id != '' else 'E371')
        self.emit(err + ' = call ptr @tomato.new.' + str(self.mod.code_of('@' + cls)) + '(' + args + ')')
        if owned:
            self.emit(f'call void @tomato_release(ptr {text})')
        self.emit(f'store ptr {err}, ptr @tomato_exc')
        self.emit(f'store i32 {self.line}, ptr @tomato_exc_line')
        self.emit('store i32 1, ptr @tomato_exc_rt')
        self.trace(True)
        self.emit('store i32 1, ptr @tomato_exc_seen')
        self.br(self.unwind_target())

    # ---- expressions
    def expr(self, n: Node, expected: str = '') -> Ex:
        k = n.kind
        if k == 'Await':
            return self.await_expr(n)
        if k == 'Start':
            return self.start_expr(n)
        if k == 'IntLit':
            return self.int_literal(n.fields[0].num, expected, False, n.line)
        if k == 'FloatLit':
            return self.float_literal(n.fields[0].num, n.fields[1].num)
        if k == 'BoolLit':
            if n.fields[0].flag:
                return ex('1', 'bool')
            return ex('0', 'bool')
        if k == 'StrLit':
            return ex(self.mod.intern(n.fields[0].text), 'str')
        if k == 'Name':
            name = n.fields[0].text
            if name == 'None' and name not in self.slots:
                return ex('null', 'None')
            if name not in self.slots:
                ck = self.mod.resolve(name)
                if ck in self.mod.consts:
                    return self.expr(self.mod.consts[ck], expected)
                if ck != '' and self.mod.has_func(ck):
                    return self.func_value(name, ck, n.line)
                raise CompileError(f"name '{name}' is not defined{self.name_hint(name)}", n.line)
            ty = self.types[name]
            r = self.tmp('l')
            self.emit(f'{r} = load {llvm_type(ty)}, ptr {self.slots[name]}')
            e = ex(r, ty)
            if ty == 'int' and self.bail != '':
                if not self.fact_small(name):
                    return self.need_small(e)
                e.small = True
                return e
            if ty == 'int' and self.fact_small(name):
                e.small = True         # its interval is inside the small range: a tagged word that owns nothing
            if ty != 'int':
                self.retain(e)         # an int is lent: whoever keeps it copies it (see owned)
            elif self.take_name == name:
                e.fresh = True         # `x = x + 1`: the operation frees this number itself if it is big, so the store need not
                self.taken = e
                self.take_name = ''
            return e
        if k == 'UnOp':
            op = n.fields[0].text
            if op == '-' and val_node(n.fields[1]).kind == 'IntLit':
                return self.int_literal(val_node(n.fields[1]).fields[0].num, expected, True, n.line)
            if op == '~':
                return self.invert_op(n)
            v = self.expr(val_node(n.fields[1]), expected)
            if op == '-' and v.ty == 'float':
                negated = self.tmp('fneg')
                self.emit(f'{negated} = fneg double {v.reg}')
                return ex(negated, 'float')
            if op == '-':
                if not is_numeric(v.ty):
                    raise CompileError(f"cannot use '-' on {shown(v.ty)}\nonly numbers can be negated", n.line)
                if not is_signed(v.ty):
                    raise CompileError("cannot use '-' on an unsigned number\nconvert it to a signed int first", n.line)
                return self.num_arith('sub', ex('1' if v.ty == 'int' else '0', v.ty), v, n.line)     # (a number's zero is the word 1)
            v = self.want(v, 'bool', n.line, 'the operand of not')
            return ex(self.arith('xor', v.reg, '1'), 'bool')
        if k == 'BinOp':
            return self.binop(n, expected)
        if k == 'TypeCall':
            return self.type_call(n)
        if k == 'Call':
            return self.call(n, False)
        if k == 'ListLit' or k == 'TupleLit':
            return self.list_lit(n, strip_optional(expected))
        if k == 'MapLit':
            return self.map_lit(n, strip_optional(expected))
        if k == 'SetLit':
            return self.set_lit(n, strip_optional(expected))
        if k == 'Attr':
            return self.field_get(n)
        if k == 'Index':
            return self.index(n)
        if k == 'Slice':
            return self.slice(n)
        if k == 'Cond':
            return self.conditional(n, expected)
        if k == 'ListComp':
            return self.list_comp(n)
        if k == 'Lambda':
            return self.lambda_value(n, expected)
        raise CompileError(f'this kind of expression ({k}) is not supported', n.line)

    def conditional(self, n: Node, expected: str) -> Ex:
        # a if condition else b: only the chosen side runs. Both sides have one type; None with a class, text or list gives an
        # optional of it. The value goes through a slot, so the sides need no phi.
        c = self.truth(self.expr(val_node(n.fields[0])), n.line)
        yes = self.label('then')
        no = self.label('else')
        end = self.label('endcond')
        self.cond_br(c, yes, no)
        self.place(yes)
        a = self.expr(val_node(n.fields[1]), expected)
        wide = is_union(expected) or is_optional(expected)
        if wide:
            a = self.want(a, expected, n.line, 'the value of a conditional expression')
        ty = a.ty
        if wide:
            ty = expected
        res = self.hidden_slot('cond')
        if is_rc(a.ty):
            res = self.hidden_rc_slot('cond')
        elif a.ty == 'int':
            res = self.hidden_int_slot('cond')
        self.store_owned(res, a)
        self.br(end)
        self.place(no)
        hint = ty
        if ty == 'None':
            hint = expected
        b = self.expr(val_node(n.fields[2]), hint)
        if b.ty != ty:
            if ty == 'None' and (b.ty == 'str' or is_list(b.ty) or is_class(b.ty)):
                ty = f'{b.ty}?'
            elif b.ty == 'None' and (ty == 'str' or is_list(ty) or is_class(ty)):
                ty = f'{ty}?'
            elif self.mod.assignable(b.ty, ty) or is_union(ty) or (is_numeric(b.ty) and is_numeric(ty) and contains(ty, b.ty)):
                b = self.want(b, ty, n.line, 'the else value of a conditional expression')
            elif is_class(a.ty) and is_class(b.ty) and self.mod.assignable(a.ty, b.ty):
                ty = b.ty
            else:
                raise CompileError(f'the two values of this conditional expression have different types: {shown(a.ty)} and {shown(b.ty)}\nconvert one so that both have the same type', n.line)
        self.store_owned(res, b)
        self.br(end)
        self.place(end)
        r = self.tmp('cond')
        self.emit(f'{r} = load {llvm_type(ty)}, ptr {res}')
        v = ex(r, ty)
        self.retain(v)
        return v

    def list_comp(self, n: Node) -> Ex:
        # [item for x in items if cond]: the list is built by an ordinary for loop whose body is a CompAppend statement. The
        # list's type is the type of the first item compiled, so the line that creates the list is filled in afterwards.
        holder = self.hidden_rc_slot('comp')
        ctx = CompCtx()
        ctx.holder = holder
        self.emit('; the new list goes here')
        at = len(self.lines) - 1
        self.comps.append(ctx)
        if self.tracking():
            self.for_facts(val_node(n.fields[0]))
        else:
            self.for_stmt(val_node(n.fields[0]))
        self.comps.pop()
        if ctx.ty == '':
            raise CompileError('the items of this list comprehension have no type', n.line)
        old = self.tmp('old')
        fresh = self.tmp('list')
        self.lines[at] = f'  {fresh} = call ptr @tomato_list_new(i64 {self.mod.code_of(ctx.ty)})\n  {old} = load ptr, ptr {holder}\n  store ptr {fresh}, ptr {holder}\n  call void @tomato_release(ptr {old})'
        lst = self.tmp('comp')
        self.emit(f'{lst} = load ptr, ptr {holder}')
        v = ex(lst, ctx.ty)
        self.retain(v)
        return v

    def comp_append(self, s: Node):
        ctx = self.comps[-1]
        item = val_node(s.fields[0])
        if ctx.ty == '':
            v = self.expr(item)
            if v.ty == '' or v.ty == 'None':
                raise CompileError('the type of the items of this list comprehension cannot be guessed\nmake the item a value with a type', s.line)
            ctx.ty = f'list[{v.ty}]'
        else:
            v = self.want(self.expr(item, elem_of(ctx.ty)), elem_of(ctx.ty), s.line, 'a list item')
        lst = self.tmp('lst')
        self.emit(f'{lst} = load ptr, ptr {ctx.holder}')
        v = self.owned(v)
        self.push_item(lst, ctx.ty, v)     # the list takes the reference

    def sequence_op(self, op: str, a: Ex, b: Ex, line: int) -> Ex:
        # list + list, tuple + tuple, list * n, n * list, text * n and n * text; an empty type when the operands are something else
        if op == '+' and is_list(a.ty) and a.ty == b.ty:
            rc = list_flags(a.ty)
            r = self.tmp('joined')
            self.emit(f'{r} = call ptr @tomato_list_concat(ptr {a.reg}, ptr {b.reg}, i32 {rc})')
            self.release(a)
            self.release(b)
            return ex(r, a.ty)
        if op == '*' and (is_list(a.ty) or a.ty == 'str') and is_numeric(b.ty):
            return self.repeat_value(a, b, line)
        if op == '*' and (is_list(b.ty) or b.ty == 'str') and is_numeric(a.ty):
            return self.repeat_value(b, a, line)
        return ex('', '')

    def repeat_value(self, seq: Ex, count: Ex, line: int) -> Ex:
        n = self.want(count, 'int', line, 'the repeat count')
        r = self.tmp('repeated')
        if seq.ty == 'str':
            self.emit(f'{r} = call ptr @tomato_str_repeat(ptr {seq.reg}, i64 {self.int_raw(n, [seq])})')
        else:
            rc = list_flags(seq.ty)
            self.emit(f'{r} = call ptr @tomato_list_repeat(ptr {seq.reg}, i64 {self.int_raw(n, [seq])}, i32 {rc})')
        self.release(seq)
        return ex(r, seq.ty)

    def call_helper(self, info: FuncInfo, values: list[Ex]) -> Ex:
        # call a helper function the compiler wrote; it only borrows its arguments
        parts: list[str] = [f'{llvm_type(v.ty)} {v.reg}' for v in values]
        r = self.tmp('help')
        self.emit(r + ' = call ' + self.ret_llvm(info) + ' ' + function_symbol(self.mod, info) + '(' + ', '.join(parts) + ')')
        self.check_error(values, function_symbol(self.mod, info))
        for v2 in values:
            self.release(v2)
        return ret_ex(r, info.ret)

    def marker_call(self, a: Ex, info: FuncInfo, args: list[Ex], line: int) -> Ex:
        # run the method that a protocol marker (@len, @get, @slice, @contains, @reversed) names on the object a; a and the arguments are released
        parts: list[str] = ['ptr ' + a.reg]
        for b in args:
            parts.append(f'{llvm_type(b.ty)} {b.reg}')
        symbol = self.method_symbol(a, info)
        text = 'call ' + self.ret_llvm(info) + ' ' + symbol + '(' + ', '.join(parts) + ')'
        result = ex('', '')
        if info.ret == '':
            self.emit(text)
        else:
            r = self.tmp('mark')
            self.emit(f'{r} = {text}')
            result = ret_ex(r, info.ret)
        values = [a] + args
        self.check_error(values, symbol)
        for v in values:
            self.release(v)
        return result

    def object_slice(self, s: Ex, n: Node) -> Ex:
        # obj[a:b:c] on an object whose class has a method marked @slice(start, stop, step, flags): the flags say which of the three
        # were written (1 start, 2 stop, 4 step), the numbers that were not written are 0
        f = self.mod.find_op(s.ty[1:], 'slice')
        if f is None or len(f.ptypes) != 4 or f.ret == '':
            raise CompileError("'" + s.ty[1:] + "' objects cannot be sliced\nadd a method marked @slice that takes start, stop, step and flags (four ints)", n.line)
        flags = 0
        lo = ex('1', 'int')
        hi = ex('1', 'int')
        step = ex('1', 'int')
        held_before = len(self.held)
        self.hold(s)                              # the object and the bounds so far are freed by the error path if a later bound raises
        if n.fields[1].tag == 'n':
            lo = self.want(self.expr(val_node(n.fields[1])), 'int', n.line, 'a slice start')
            self.hold(lo)
            flags += 1
        if n.fields[2].tag == 'n':
            hi = self.want(self.expr(val_node(n.fields[2])), 'int', n.line, 'a slice end')
            self.hold(hi)
            flags += 2
        if len(n.fields) > 3 and n.fields[3].tag == 'n':
            step = self.want(self.expr(val_node(n.fields[3])), 'int', n.line, 'a slice step')
            flags += 4
        self.drop_held(held_before)               # from here the call owns them: it releases them, also when the method raises
        return self.marker_call(s, f, [lo, hi, step, self.tag_small(str(flags))], n.line)

    def list_call(self, args: list[Node], line: int) -> Ex:
        # list(x): a new list of the items of a list, or of anything with a method marked @iter (a range, a progress bar, your own class)
        if len(args) != 1:
            raise CompileError('list() takes exactly one argument: a list or a range', line)
        v = self.unwrap(self.expr(args[0]), line)
        if is_class(v.ty) and self.mod.has_op(v.ty[1:], 'iter'):
            return self.call_helper(self.mod.helper('tolist', v.ty, line), [v])
        if is_list(v.ty) and not v.ty.startswith('tuple['):
            rc = list_flags(v.ty)
            r = self.tmp('copy')
            self.emit(f'{r} = call ptr @tomato_list_slice(ptr {v.reg}, i64 0, i64 0, i64 1, i32 0, i32 {rc})')
            self.release(v)
            return ex(r, v.ty)
        raise CompileError(f'list() takes a list or something that can be looped over (a range, or an object with an @iter method), but this is {shown(v.ty)}', line)

    def list_builtin(self, name: str, args: list[Node], line: int) -> Ex:
        # sorted, reversed, sum, min and max of a list
        lst = ex('', '')
        if (name == 'min' or name == 'max') and len(args) >= 2:
            held_before = len(self.held)
            first = self.expr(args[0])
            items: list[Ex] = [first]
            self.hold(first)                    # the values so far are freed by the error path if a later one raises
            for a in args[1:]:
                items.append(self.want(self.expr(a), first.ty, line, 'every value given to ' + name + '()'))
                self.hold(items[-1])
            self.drop_held(held_before)
            lst = self.build_tuple(f'list[{first.ty}]', items)
        else:
            if len(args) != 1:
                raise CompileError(f'{name}() takes one list', line)
            lst = self.unwrap(self.expr(args[0]), line)
        if is_class(lst.ty):
            if name == 'reversed':
                rf = self.mod.find_op(lst.ty[1:], 'reversed')
                if rf is not None:
                    return self.marker_call(lst, rf, [], line)
            if not self.mod.has_op(lst.ty[1:], 'iter'):
                raise CompileError(f'{name}() takes a list or an object with a method marked @iter, but this is {shown(lst.ty)}', line)
            if name == 'sorted' or name == 'reversed':
                lst = self.call_helper(self.mod.helper('tolist', lst.ty, line), [lst])
            else:
                return self.call_helper(self.mod.helper(name, lst.ty, line), [lst])
        if not is_list(lst.ty):
            raise CompileError(f'{name}() takes a list or a range, but this is {shown(lst.ty)}', line)
        elem = elem_of(lst.ty)
        if name == 'reversed':
            rc = list_flags(lst.ty)
            r = self.tmp('reversed')
            self.emit(f'{r} = call ptr @tomato_list_slice(ptr {lst.reg}, i64 0, i64 0, i64 -1, i32 4, i32 {rc})')
            self.release(lst)
            return ex(r, lst.ty)
        if not (elem == 'int' or elem == 'float' or (elem == 'str' and name != 'sum')):
            wanted = 'numbers or text' if name != 'sum' else 'numbers'
            raise CompileError(f'{name}() needs a list of {wanted}, but this is {shown(lst.ty)}', line)
        if name == 'sorted':
            # the runtime sorts a copy: 0 = int, 1 = float, 2 = str
            kind = '0' if elem == 'int' else ('1' if elem == 'float' else '2')
            r = self.tmp('sorted')
            self.emit(f'{r} = call ptr @tomato_list_sorted(ptr {lst.reg}, i32 {kind})')
            self.release(lst)
            return ex(r, lst.ty)
        info = self.mod.helper(name, lst.ty, line)
        return self.call_helper(info, [lst])

    # the list a function like sorted, map and filter works on: a list, or an object with a method marked @iter (copied into a list)
    def list_arg(self, a: Node, name: str, line: int) -> Ex:
        lst = self.unwrap(self.expr(a), line)
        if is_class(lst.ty) and self.mod.has_op(lst.ty[1:], 'iter'):
            lst = self.call_helper(self.mod.helper('tolist', lst.ty, line), [lst])
        if not is_list(lst.ty):
            raise CompileError(f'{name}() takes a list or a range, but this is {shown(lst.ty)}', line)
        return lst

    # sorted(xs, key=f) and sorted(xs, cmp=f): a new list, stable (D-fn); the work is done by _sorted_key and _sorted_cmp in std/builtin/sorting.tom
    def sorted_by(self, args: list[Node], keywords: list[Val], line: int) -> Ex:
        if len(args) != 1:
            raise CompileError('sorted() takes one list, and then key= or cmp=', line)
        if len(keywords) != 1:
            raise CompileError('sorted() takes key= or cmp=, not both', line)
        kname = keywords[0].items[0].text
        if kname != 'key' and kname != 'cmp':
            raise CompileError(f"sorted() has no parameter named '{kname}'\nit takes key= (a function giving what to sort by) or cmp= (a function comparing two items)", line)
        lst = self.list_arg(args[0], 'sorted', line)
        return self.sorted_keyed(lst, keywords, line)

    # the same on a list that is already evaluated (it is used up): the keyword is key= or cmp=
    def sorted_keyed(self, lst: Ex, keywords: list[Val], line: int) -> Ex:
        kname = keywords[0].items[0].text
        elem = elem_of(lst.ty)
        want_fn = 'fn[' + elem + '>?]'
        if kname == 'cmp':
            want_fn = 'fn[' + elem + ',' + elem + '>int]'
        fv = self.expr(val_node(keywords[0].items[1]), want_fn)
        if not is_fn(fv.ty):
            raise CompileError(f'{kname}= needs a function, but this is {shown(fv.ty)}', line)
        if kname == 'cmp':
            if fv.ty != want_fn:
                raise CompileError(f'cmp= needs a function of two {shown(elem)} items that returns an int, but this is {shown(fv.ty)}\nit returns a negative number, zero or a positive number', line)
            info = self.mod.instance_func(self.mod.resolve('_sorted_cmp'), [elem], line)
            et = llvm_type(elem)
            if item_width(lst.ty) != 8 or (et != 'i64' and et != 'ptr'):
                return self.call_helper(info, [lst, fv])
            # native builds: the runtime merge sort calls the function directly; where it cannot (the browser's interpreter), the sort
            # written in Tomato (_sorted_cmp) runs instead. Both are the same stable merge sort.
            res = self.hidden_slot('cmpsorted')
            can = self.tmp('callbacks')
            self.emit(f'{can} = call i32 @tomato_callbacks()')
            use = self.tmp('native')
            self.emit(f'{use} = icmp ne i32 {can}, 0')
            nat = self.label('natsort')
            slow = self.label('tomsort')
            done = self.label('sortdone')
            self.cond_br(use, nat, slow)
            self.place(nat)
            rn = self.tmp('natsorted')
            self.emit(f'{rn} = call ptr @tomato_list_sorted_cmp(ptr {lst.reg}, ptr {fv.reg}, ptr @tomato_exc, i32 {list_flags(lst.ty)})')
            self.check_error([lst])
            self.release(lst)
            self.emit(f'store ptr {rn}, ptr {res}')
            self.br(done)
            self.place(slow)
            rs = self.call_helper(info, [lst, fv])
            self.emit(f'store ptr {rs.reg}, ptr {res}')
            self.br(done)
            self.place(done)
            r2 = self.tmp('sorted')
            self.emit(f'{r2} = load ptr, ptr {res}')
            return ex(r2, lst.ty)
        params = fn_params(fv.ty)
        if len(params) != 1 or params[0] != elem:
            raise CompileError(f'key= needs a function of one {shown(elem)} item, but this is {shown(fv.ty)}', line)
        kt = fn_result(fv.ty)
        if kt != 'int' and kt != 'float' and kt != 'str':
            raise CompileError(f'the key function must return an int, a float or text, but this one returns {shown(kt)}', line)
        # the keys are worked out here, once per item; the runtime sorts them (stable) and builds the result
        info = self.mod.instance_func(self.mod.resolve('_keys'), [elem, kt], line)
        keys = self.tmp('keys')
        self.emit(f'{keys} = call ptr {function_symbol(self.mod, info)}(ptr {lst.reg}, ptr {fv.reg})')
        self.check_error([lst])
        kind = '0' if kt == 'int' else ('1' if kt == 'float' else '2')
        r = self.tmp('sortedby')
        self.emit(f'{r} = call ptr @tomato_list_sorted_by(ptr {lst.reg}, ptr {keys}, i32 {kind}, i32 {list_flags(lst.ty)})')
        self.release(ex(keys, f'list[{kt}]'))
        self.release(lst)
        return ex(r, lst.ty)

    # map(f, xs) and filter(f, xs): a new list (D-fn)
    def map_filter(self, name: str, args: list[Node], keywords: list[Val], line: int) -> Ex:
        if len(keywords) > 0 or len(args) != 2:
            raise CompileError(f'{name}() takes a function and a list: {name}(f, xs)', line)
        lst = self.list_arg(args[1], name, line)
        elem = elem_of(lst.ty)
        want_fn = 'fn[' + elem + '>?]'
        if name == 'filter':
            want_fn = 'fn[' + elem + '>bool]'
        fv = self.expr(args[0], want_fn)
        if not is_fn(fv.ty):
            raise CompileError(f'the first argument of {name}() must be a function, but this is {shown(fv.ty)}', line)
        params = fn_params(fv.ty)
        if len(params) != 1 or params[0] != elem:
            raise CompileError(f'{name}() needs a function of one {shown(elem)} item, but this is {shown(fv.ty)}', line)
        res = fn_result(fv.ty)
        if name == 'filter':
            if res != 'bool':
                raise CompileError(f'the function given to filter() must return a bool, but this one returns {shown(res)}', line)
            return self.call_helper(self.mod.instance_func(self.mod.resolve('_filter'), [elem], line), [fv, lst])
        if res == 'None' or is_fixed(res):
            raise CompileError(f'the function given to map() must return a value, but this one returns {shown(res)}', line)
        return self.call_helper(self.mod.instance_func(self.mod.resolve('_map'), [elem, res], line), [fv, lst])

    def list_slot(self, lst: Ex, i: Ex, live: list[Ex] = []) -> str:
        # the address of item i, after a bounds check
        ln = self.list_length(lst)
        bad = self.tmp('oob')
        self.emit(f'{bad} = icmp uge i64 {i.reg}, {ln}')
        self.fail_if(bad, 'index out of range', live)
        data = ''
        if lst.list_name != '' and lst.list_name in self.list_datas:
            data = self.list_datas[lst.list_name]
            if self.list_in_slots[lst.list_name]:
                kd = data
                data = self.tmp('data')
                self.emit(f'{data} = load ptr, ptr {kd}')
        else:
            datap = self.tmp('datap')
            self.emit(f'{datap} = getelementptr {{ i64, i64, i64, i64, ptr }}, ptr {lst.reg}, i32 0, i32 4')
            data = self.tmp('data')
            self.emit(f'{data} = load ptr, ptr {datap}')
        addr = self.tmp('addr')
        w = item_width(lst.ty)
        unit = item_llvm(w)
        self.emit(f'{addr} = getelementptr {unit}, ptr {data}, i64 {i.reg}')
        return addr

    def load_item(self, lt: str, addr: str, hint: str) -> str:
        # the item at addr in a list of type lt, as the register of its Tomato value (a compact item is widened)
        elem = elem_of(lt)
        item = self.tmp(hint)
        if elem == 'bool' and item_width(lt) == 1:
            raw = self.tmp('raw')
            self.emit(f'{raw} = load i8, ptr {addr}')
            self.emit(f'{item} = zext i8 {raw} to i64')
        else:
            self.emit(f'{item} = load {llvm_type(elem)}, ptr {addr}')
        return item

    def store_item(self, lt: str, v: Ex, addr: str):
        # v (not a heap value) into the slot at addr of a list of type lt
        if item_width(lt) == 1 and elem_of(lt) == 'bool':
            raw = self.tmp('raw')
            self.emit(f'{raw} = trunc i64 {v.reg} to i8')
            self.emit(f'store i8 {raw}, ptr {addr}')
        else:
            self.emit(f'store {llvm_type(v.ty)} {v.reg}, ptr {addr}')

    def push_item(self, lst: str, lt: str, v: Ex):
        # append v (already owned) to the list in register lst, whose type is lt
        slot = self.tmp('slot')
        self.emit(f'{slot} = call ptr @tomato_list_push(ptr {lst}, i64 {item_width(lt)})')
        self.store_item(lt, v, slot)

    def field_addr(self, obj: Ex, name: str, line: int) -> str:
        if not is_class(obj.ty):
            raise CompileError(f'a value of type {shown(obj.ty)} has no fields', line)
        c = self.mod.find_class(obj.ty[1:], line)
        idx = self.mod.field_index(c, name, line)
        addr = self.tmp('fld')
        self.emit(f'{addr} = getelementptr %class.{self.mod.code_of(obj.ty)}, ptr {obj.reg}, i32 0, i32 {str(idx + 2)}')
        return addr

    def field_type(self, obj: Ex, name: str, line: int) -> str:
        c = self.mod.find_class(obj.ty[1:], line)
        return c.fields[self.mod.field_index(c, name, line)].ty

    def check_field_access(self, obj: Ex, name: str, writing: bool, line: int):
        # private fields belong to their class (D12ac, D12r); a const field is set only by its own class's @init (D12o)
        c = self.mod.find_class(obj.ty[1:], line)
        fld = c.fields[self.mod.field_index(c, name, line)]
        if fld.is_private and self.owner != fld.owner:
            raise CompileError(f"the field '{name}' is private to class '{fld.owner}'\nonly its own methods can use it", line)
        if writing and fld.is_const and not (self.in_init and self.owner == fld.owner):
            raise CompileError(f"the const field '{name}' cannot be changed after the object is created", line)

    def lent_base(self, base: Node) -> Ex:
        # the object or list that a field or item is read from, when it is itself a field or item of a local: lent, not retained
        if base.kind == 'Index':
            return self.index(base, False, True)
        return self.field_get(base, False, True)

    def field_get(self, n: Node, lend: bool = False, as_base: bool = False) -> Ex:
        # lend: the result is a number that the caller uses up at once; as_base: the caller only reads from the result and lets it go.
        # In both cases a value read from a local (or from something lent) is not copied: the local stays alive and nothing runs
        # in between, so nothing can change what it points at.
        base = val_node(n.fields[0])
        if (lend or as_base or self.bail != '') and (base.kind == 'Attr' or base.kind == 'Index'):
            obj = self.unwrap(self.lent_base(base), n.line)
        else:
            obj = self.unwrap(self.expr_b(base, []), n.line)
        name = n.fields[1].text
        if is_class(obj.ty):
            self.check_field_access(obj, name, False, n.line)
        addr = self.field_addr(obj, name, n.line)
        ft = self.field_type(obj, name, n.line)
        lent = obj.reg.startswith('%bl.') and ((lend and ft == 'int') or (as_base and is_rc(ft)))
        v = self.tmp('bl' if lent else 'f')
        self.emit(f'{v} = load {llvm_type(ft)}, ptr {addr}')
        e = ex(v, ft)
        if self.bail != '' and ft == 'int':
            e = self.need_small(e, [obj])
            self.release(obj)
            return e
        if lent:
            return e
        self.retain(e)
        self.release(obj)
        return e

    def assign_field(self, s: Node, target: Node):
        obj = self.unwrap(self.expr_b(val_node(target.fields[0]), [val_node(s.fields[1])]), s.line)
        name = target.fields[1].text
        if is_class(obj.ty):
            self.check_field_access(obj, name, True, s.line)
        ft = self.field_type(obj, name, s.line)
        v = self.expr(val_node(s.fields[1]), ft)
        v = self.want(v, ft, s.line, 'the assigned value')
        addr = self.field_addr(obj, name, s.line)
        self.store_owned(addr, v, v.ty == 'int' and self.old_is_small(addr, [v, obj]))
        self.release(obj)

    def list_lit(self, n: Node, expected: str) -> Ex:
        items = val_nodes(n.fields[0])
        t = ''
        first = ex('', '')
        kind = 'tuple' if n.kind == 'TupleLit' else 'list'
        if kind == 'tuple' and is_mtuple(expected):
            return self.mtuple_lit(n, expected, [])
        if is_list(expected) and expected.startswith(kind + '['):
            t = expected
        else:
            if len(items) == 0:
                raise CompileError(f'the type of an empty {kind} cannot be guessed\ndeclare it, such as: xs: {kind}[int] = []', n.line)
            first = self.expr(items[0])
            if first.ty == '':
                raise CompileError(f'a {kind} item needs a value', n.line)
            t = f'{kind}[{first.ty}]'
            if kind == 'tuple' and len(items) > 1:
                # the items are evaluated in order; when one cannot be a first.ty, the tuple has mixed item types: (1, 'a')
                held_first = len(self.held)
                done: list[Ex] = [self.owned(first)]
                self.hold(done[0])
                mixed = False
                for k in range(1, len(items)):
                    v = self.expr(items[k], first.ty)
                    if v.ty == '' or v.ty == 'None':
                        raise CompileError(f'a tuple item needs a value', n.line)
                    if not (v.ty == first.ty or self.mod.assignable(v.ty, first.ty) or (is_numeric(v.ty) and is_numeric(first.ty) and contains(first.ty, v.ty)) or (is_union(first.ty) and not is_union(v.ty) and self.union_member_for(v.ty, first.ty) != '')):
                        mixed = True
                    v = self.owned(v)
                    self.hold(v)
                    done.append(v)
                self.drop_held(held_first)
                if mixed:
                    types: list[str] = [d.ty for d in done]
                    return self.mtuple_lit(n, mtuple_type(types), done)
                return self.tuple_of(t, done, n.line)
        lst = self.tmp('list')
        self.emit(f'{lst} = call ptr @tomato_list_new(i64 {self.mod.code_of(t)})')
        held_before = len(self.held)
        self.hold(ex(lst, t))                 # the items pushed so far are freed with it if a later item raises
        for k, item in enumerate(items):
            v = ex('', '')
            if k == 0 and first.ty != '':
                v = first
            else:
                v = self.expr(item, elem_of(t))
            v = self.want(v, elem_of(t), n.line, 'a list item')
            v = self.owned(v)
            self.push_item(lst, t, v)     # the list takes the reference
        self.drop_held(held_before)
        return ex(lst, t)

    def tuple_of(self, t: str, values: list[Ex], line: int) -> Ex:
        # a tuple of one item type from values already evaluated and owned
        lst = self.tmp('list')
        self.emit(f'{lst} = call ptr @tomato_list_new(i64 {self.mod.code_of(t)})')
        for v in values:
            w = self.want(v, elem_of(t), line, 'a tuple item')
            self.push_item(lst, t, w)
        return ex(lst, t)

    def mtuple_lit(self, n: Node, t: str, done: list[Ex]) -> Ex:
        # a tuple of mixed item types: (name, [1, 2]). done holds the items already evaluated (owned); the rest are evaluated here,
        # each as its own type. The tuple is made once every item is ready, so an item that raises leaves nothing half-built.
        items = val_nodes(n.fields[0])
        want_types = mtuple_items(t)
        if len(items) != len(want_types):
            raise CompileError(f'this tuple has {plural(len(items), "item")}, but {shown(t)} has {len(want_types)}', n.line)
        held_before = len(self.held)
        values: list[Ex] = []
        for k, item in enumerate(items):
            v = ex('', '')
            if k < len(done):
                v = done[k]
            else:
                v = self.expr(item, want_types[k])
            v = self.owned(self.want(v, want_types[k], n.line, 'a tuple item'))
            self.hold(v)
            values.append(v)
        self.drop_held(held_before)
        r = self.tmp('tup')
        self.emit(f'{r} = call ptr @tomato_alloc(i64 {16 + 8 * len(values)}, i64 {self.mod.code_of(t)})')
        for k, v in enumerate(values):
            p = self.tmp('itemp')
            self.emit(f'{p} = getelementptr i8, ptr {r}, i64 {16 + 8 * k}')
            self.emit(f'store {llvm_type(v.ty)} {v.reg}, ptr {p}')
        return ex(r, t)

    def mtuple_item(self, s: Ex, at: int, line: int) -> Ex:
        # item `at` of a tuple of mixed item types, as a value of its own (the tuple is released)
        types = mtuple_items(s.ty)
        k = at
        if k < 0:
            k += len(types)
        if k < 0 or k >= len(types):
            raise CompileError(f'index {at} is out of range: {shown(s.ty)} has {plural(len(types), "item")}', line)
        p = self.tmp('itemp')
        self.emit(f'{p} = getelementptr i8, ptr {s.reg}, i64 {16 + 8 * k}')
        r = self.tmp('item')
        self.emit(f'{r} = load {llvm_type(types[k])}, ptr {p}')
        e = ex(r, types[k])
        self.retain(e)
        self.release(s)
        return e

    def const_index(self, n: Node) -> int:
        # the position written in t[0] or t[-1] on a tuple of mixed item types; -1000000 when it is not a whole-number literal
        if n.kind == 'IntLit':
            return n.fields[0].num
        if n.kind == 'UnOp' and n.fields[0].text == '-' and val_node(n.fields[1]).kind == 'IntLit':
            return 0 - val_node(n.fields[1]).fields[0].num
        return -1000000

    def key_word(self, k: Ex) -> str:
        # a key as the 64-bit word the runtime hashes: the number itself, or the text's address
        if k.ty != 'str':
            return k.reg
        r = self.tmp('kw')
        self.emit(f'{r} = ptrtoint ptr {k.reg} to i64')
        return r

    def new_set(self, t: str) -> Ex:
        kind = '1' if set_elem(t) == 'str' else '0'
        if set_elem(t) == 'int':
            kind = '2'                  # a table that copies big numbers
        r = self.tmp('set')
        self.emit(f'{r} = call ptr @tomato_dict_new(i64 {self.mod.code_of(t)}, i64 0, i32 {kind})')
        return ex(r, t)

    def set_lit(self, n: Node, expected: str) -> Ex:
        items = val_nodes(n.fields[0])
        t = expected
        first = ex('', '')
        if not is_set(expected):
            first = self.expr(items[0])
            t = f'set[{first.ty}]'
            if not is_set(t) or not (first.ty == 'str' or first.ty == 'int' or first.ty == 'bool'):
                raise CompileError('a set can hold only int, bool or str values', n.line)
        st = self.new_set(t)
        held_before = len(self.held)
        self.hold(st)
        for k, item in enumerate(items):
            v = ex('', '')
            if k == 0 and first.ty != '':
                v = first
            else:
                v = self.expr(item, set_elem(t))
            v = self.want(v, set_elem(t), n.line, 'a set element')
            slot = self.tmp('slot')
            self.emit(f'{slot} = call ptr @tomato_dict_insert(ptr {st.reg}, i64 {self.key_word(v)}, i32 0)')
            self.release(v)
        self.drop_held(held_before)
        return st

    def map_lit(self, n: Node, expected: str) -> Ex:
        pairs = n.fields[0].items
        if is_set(expected) and len(pairs) == 0:
            return self.new_set(expected)
        if len(pairs) == 0 and not is_dict(expected):
            raise CompileError('the type of an empty {} cannot be guessed\ndeclare it, such as: m: dict[str, int] = {}', n.line)
        # without a dict type to take from the context, the value type is the first value's, as for a list literal (the keys are text)
        first_k = ex('', '')
        first_v = ex('', '')
        t = expected
        if not is_dict(expected):
            before = len(self.held)
            first_k = self.want(self.expr(val_node(pairs[0].items[0])), 'str', n.line, 'a dict key')
            self.hold(first_k)
            first_v = self.expr(val_node(pairs[0].items[1]))
            self.drop_held(before)
            if first_v.ty == '' or first_v.ty == 'None':
                raise CompileError('a dict value needs a value that is not None\ndeclare the type, such as: m: dict[str, int] = {...}', n.line)
            t = f'dict[{first_v.ty}]'
        value_t = dict_value(t)
        d = self.tmp('dict')
        self.emit(f'{d} = call ptr @tomato_dict_new(i64 {self.mod.code_of(t)}, i64 8, i32 1)')
        held_before = len(self.held)
        self.hold(ex(d, t))
        for j, pair in enumerate(pairs):
            k = ex('', '')
            if j == 0 and first_k.ty != '':
                k = first_k
            else:
                k = self.want(self.expr(val_node(pair.items[0])), 'str', n.line, 'a dict key')
            self.hold(k)
            v = ex('', '')
            if j == 0 and first_v.ty != '':
                v = first_v
            else:
                v = self.expr(val_node(pair.items[1]), value_t)
            self.drop_held(held_before + 1)
            v = self.want(v, value_t, n.line, 'a dict value')
            slot = self.tmp('slot')
            self.emit(f'{slot} = call ptr @tomato_dict_insert(ptr {d}, i64 {self.key_word(k)}, i32 1)')
            dup = self.tmp('dup')
            self.emit(f'{dup} = icmp eq ptr {slot}, null')
            self.fail_if(dup, 'duplicate key in a dict literal', [k, v])
            v = self.owned(v)
            self.emit(f'store {llvm_type(v.ty)} {v.reg}, ptr {slot}')
            self.release(k)
        self.drop_held(held_before)
        return ex(d, t)

    def int_literal(self, v: int, expected: str, negative: bool, line: int) -> Ex:
        # a whole-number literal takes the integer type its context wants (D05s-w), else int
        t = expected if is_fixed(expected) else 'int'
        if not fits_literal(v, t, negative):
            raise CompileError(f'{v} does not fit in {shown(t)}\nuse a wider type, or a value in its range', line)
        if t == 'int':
            if v >= 2 ** 61:
                text = str(v)
                if negative:
                    text = f'-{text}'
                r = self.tmp('big')
                self.emit(f'{r} = call i64 @tomato_int_parse(ptr {self.mod.intern(text)})')
                return exf(r, 'int')
            if negative:
                return ex(str(1 - v * 2), t)
            return ex(str(v * 2 + 1), t)
        if negative:
            return ex(str(-v), t)
        return ex(str(v), t)

    def const_eval(self, n: Node) -> int:
        # the value of a tree of whole-number literals joined by + - * (and a minus sign)
        if n.kind == 'IntLit':
            return n.fields[0].num
        if n.kind == 'UnOp':
            return -self.const_eval(val_node(n.fields[1]))
        a = self.const_eval(val_node(n.fields[1]))
        b = self.const_eval(val_node(n.fields[2]))
        op = n.fields[0].text
        if op == '+':
            return a + b
        if op == '-':
            return a - b
        return a * b

    def is_zero_literal(self, n: Node) -> bool:
        if n.kind == 'IntLit':
            return n.fields[0].num == 0
        if n.kind == 'FloatLit':
            return n.fields[0].num == 0
        if n.kind == 'UnOp' and n.fields[0].text == '-':
            return self.is_zero_literal(val_node(n.fields[1]))
        return False

    def literal_only(self, n: Node) -> bool:
        if n.kind == 'IntLit':
            return True
        if n.kind == 'UnOp' and n.fields[0].text == '-':
            return self.literal_only(val_node(n.fields[1]))
        if n.kind == 'BinOp':
            op = n.fields[0].text
            return (op == '+' or op == '-' or op == '*') and self.literal_only(val_node(n.fields[1])) and self.literal_only(val_node(n.fields[2]))
        return False

    def type_call(self, n: Node) -> Ex:
        # int[length=8](x) and uint[length=8](x): an explicit conversion that stops when the number does not fit
        t = val_node(n.fields[0])
        target = self.mod.type_name(vn(t))
        if not is_fixed(target):
            raise CompileError('this conversion is not supported\nonly int(), float(), str() and int[length=N] / uint[length=N] conversions exist', n.line)
        args = val_nodes(n.fields[1])
        v = self.expr(args[0])
        return self.convert_explicit(v, target, n.line)

    def plain_num(self, n: Node) -> bool:
        # an expression made only of numbers read from local variables and their fields, literals and arithmetic: no user code can run
        # while it is evaluated (an operator on an object, or an item of an object, could), so a number lent before it stays valid
        k = n.kind
        if k == 'IntLit' or k == 'FloatLit' or k == 'BoolLit':
            return True
        if k == 'Name':
            name = n.fields[0].text
            if name not in self.slots:
                return False
            t = self.types[name]
            return t == 'float' or t == 'bool' or is_numeric(t)
        if k == 'Attr':
            b = val_node(n.fields[0])
            if b.kind != 'Name' or b.fields[0].text not in self.slots or not is_class(self.types[b.fields[0].text]):
                return False
            c = self.mod.find_class(self.types[b.fields[0].text][1:], n.line)
            at = field_position(c, n.fields[1].text)
            if at < 0:
                return False
            t2 = c.fields[at].ty
            return t2 == 'float' or t2 == 'bool' or is_numeric(t2)
        if k == 'UnOp':
            return self.plain_num(val_node(n.fields[1]))
        if k == 'BinOp':
            op = n.fields[0].text
            if op == 'and' or op == 'or' or op == 'in' or op == 'is' or op == 'is not':
                return False
            return self.plain_num(val_node(n.fields[1])) and self.plain_num(val_node(n.fields[2]))
        return False

    def operand(self, n: Node, lend: bool) -> Ex:
        # an operand of an arithmetic or comparison operator. With lend, a number read from a field or a list item of a local is
        # not copied: nothing runs between the read and the operator that uses it up, so nothing can change what it points at.
        if lend and n.kind == 'Attr':
            return self.field_get(n, True)
        if lend and n.kind == 'Index':
            return self.index(n, True)
        return self.expr(n)

    def index(self, n: Node, lend: bool = False, as_base: bool = False) -> Ex:
        base = val_node(n.fields[0])
        if (lend or as_base) and (base.kind == 'Attr' or base.kind == 'Index') and (pure_read(val_node(n.fields[1])) or self.plain_num(val_node(n.fields[1]))):
            s = self.unwrap(self.lent_base(base), n.line)
        elif self.bail != '' and (base.kind == 'Attr' or base.kind == 'Index'):
            s = self.unwrap(self.lent_base(base), n.line)       # nothing that the fast copy of a loop nest evaluates can let go of it
        else:
            s = self.unwrap(self.expr_b(base, [val_node(n.fields[1])]), n.line)
        held_before = len(self.held)
        self.hold(s)                              # a fresh base is freed by the error path if the index expression raises
        if is_dict(s.ty):
            k = self.expr(val_node(n.fields[1]))
            k = self.want(k, 'str', n.line, 'a dict key')
            self.drop_held(held_before)
            slot = self.tmp('slot')
            self.emit(f'{slot} = call ptr @tomato_dict_find(ptr {s.reg}, i64 {self.key_word(k)})')
            missing = self.tmp('missing')
            self.emit(f'{missing} = icmp eq ptr {slot}, null')
            self.fail_if(missing, 'the key is not there', [k, s])
            vt = dict_value(s.ty)
            r = self.tmp('val')
            self.emit(f'{r} = load {llvm_type(vt)}, ptr {slot}')
            e = ex(r, vt)
            self.retain(e)
            self.release(k)
            self.release(s)
            return e
        if is_mtuple(s.ty):
            self.drop_held(held_before)
            want_count = unpack_count(base)
            have = len(mtuple_items(s.ty))
            if want_count >= 0 and want_count != have:
                # a, b, c = pair: the tuple's length is known here, so a wrong number of names is found before the program runs
                raise CompileError(f'cannot unpack {plural(have, "value")} into {plural(want_count, "variable")}\n{shown(s.ty)} has {have} items', n.line)
            at = self.const_index(val_node(n.fields[1]))
            if at == -1000000:
                raise CompileError(f'the items of {shown(s.ty)} have different types, so its index must be a number written out, such as t[0]', n.line)
            return self.mtuple_item(s, at, n.line)
        if is_class(s.ty):
            g = self.mod.find_op(s.ty[1:], 'get')
            if g is None or len(g.ptypes) != 1 or g.ret == '':
                raise CompileError("'" + s.ty[1:] + "' objects cannot be indexed\nadd a method marked @get that takes the index and returns the item", n.line)
            gi = self.want(self.expr(val_node(n.fields[1])), g.ptypes[0], n.line, 'an index')
            self.drop_held(held_before)
            return self.marker_call(s, g, [gi], n.line)
        if is_list(s.ty):
            li = self.expr(val_node(n.fields[1]))
            li = self.want(li, 'int', n.line, 'an index')
            self.drop_held(held_before)
            addr = self.list_slot(s, ex(self.norm_index(s, self.int_raw(li, [s]), val_node(n.fields[1])), 'int'), [s])
            lent = s.reg.startswith('%bl.') and ((lend and elem_of(s.ty) == 'int') or (as_base and is_rc(elem_of(s.ty))))
            item = self.load_item(s.ty, addr, 'bl' if lent else 'item')
            e = ex(item, elem_of(s.ty))
            if self.bail != '' and e.ty == 'int':
                e = self.need_small(e, [s])
                self.release(s)
                return e
            if lent:
                return e
            self.retain(e)
            self.release(s)
            return e
        s = self.want(s, 'str', n.line, 'the value being indexed')
        i = self.expr(val_node(n.fields[1]))
        i = self.want(i, 'int', n.line, 'an index')
        self.drop_held(held_before)
        r = self.tmp('ch')
        self.emit(f'{r} = call ptr @tomato_str_index(ptr {s.reg}, i64 {self.int_raw(i, [s])})')
        bad = self.tmp('oob')
        self.emit(f'{bad} = icmp eq ptr {r}, null')
        self.fail_if(bad, 'index out of range', [s])
        self.release(s)
        return ex(r, 'str')

    def norm_index(self, s: Ex, i: str, n: Node | None = None) -> str:
        # a negative position counts from the end, as in Python: i + len when i < 0. n is the index as written, when there is one
        if n is not None:
            if self.tracking():
                known = self.range_of(n, self.facts)
                if known is not None:
                    if known.lo >= 0:
                        return i
                    if self.bail != '' and known.hi < 0:
                        return self.arith('add', i, self.list_length(s))
            if self.bail != '':
                return i                  # taken as not negative: a negative one fails the bounds test, and the general copy handles it
        ln = self.list_length(s)
        neg = self.tmp('neg')
        self.emit(f'{neg} = icmp slt i64 {i}, 0')
        shifted = self.tmp('shifted')
        self.emit(f'{shifted} = add i64 {i}, {ln}')
        r = self.tmp('pos')
        self.emit(f'{r} = select i1 {neg}, i64 {shifted}, i64 {i}')
        return r

    def slice(self, n: Node) -> Ex:
        s = self.unwrap(self.expr(val_node(n.fields[0])), n.line)
        if is_class(s.ty):
            return self.object_slice(s, n)
        if not (s.ty == 'str' or is_list(s.ty)):
            raise CompileError(f'only text, lists, tuples and ranges can be sliced, but this is {shown(s.ty)}', n.line)
        flags = 0
        lo = '0'
        hi = '0'
        step = '1'
        held_before = len(self.held)
        self.hold(s)
        if n.fields[1].tag == 'n':
            e = self.want(self.expr(val_node(n.fields[1])), 'int', n.line, 'a slice start')
            lo = self.int_raw(e)
            flags += 1
        if n.fields[2].tag == 'n':
            e2 = self.want(self.expr(val_node(n.fields[2])), 'int', n.line, 'a slice end')
            hi = self.int_raw(e2)
            flags += 2
        if len(n.fields) > 3 and n.fields[3].tag == 'n':
            e3 = self.want(self.expr(val_node(n.fields[3])), 'int', n.line, 'a slice step')
            step = self.int_raw(e3)
            flags += 4
        self.drop_held(held_before)
        r = self.tmp('part')
        if s.ty == 'str':
            self.emit(f'{r} = call ptr @tomato_str_slice3(ptr {s.reg}, i64 {lo}, i64 {hi}, i64 {step}, i32 {flags})')
        else:
            rc = list_flags(s.ty)
            self.emit(f'{r} = call ptr @tomato_list_slice(ptr {s.reg}, i64 {lo}, i64 {hi}, i64 {step}, i32 {flags}, i32 {rc})')
        bad = self.tmp('zero')
        self.emit(f'{bad} = icmp eq ptr {r}, null')
        self.fail_if(bad, 'slice step cannot be zero', [s])
        self.release(s)
        return ex(r, s.ty)

    def membership(self, a: Ex, b: Ex, line: int) -> Ex:
        if is_class(b.ty):
            cf = self.mod.find_op(b.ty[1:], 'contains')
            if cf is None or len(cf.ptypes) != 1 or cf.ret != 'bool':
                raise CompileError("'in' does not work with '" + b.ty[1:] + "' objects\nadd a method marked @contains that takes the value and returns bool", line)
            a = self.want(a, cf.ptypes[0], line, 'the left side of in')
            return self.marker_call(b, cf, [a], line)
        if b.ty == 'str':
            a = self.want(a, 'str', line, 'the left side of in')
            c = self.tmp('c')
            self.emit(f'{c} = call i32 @tomato_str_contains(ptr {b.reg}, ptr {a.reg})')
            i1 = self.tmp('flag')
            self.emit(f'{i1} = icmp ne i32 {c}, 0')
            self.release(a)
            self.release(b)
            return self.bool_of(i1)
        if is_set(b.ty) or is_dict(b.ty):
            a = self.want(a, set_elem(b.ty) if is_set(b.ty) else 'str', line, 'the left side of in')
            slot = self.tmp('slot')
            self.emit(f'{slot} = call ptr @tomato_dict_find(ptr {b.reg}, i64 {self.key_word(a)})')
            i1 = self.tmp('flag')
            self.emit(f'{i1} = icmp ne ptr {slot}, null')
            self.release(a)
            self.release(b)
            return self.bool_of(i1)
        if is_list(b.ty):
            return self.list_contains(a, b, line)
        raise CompileError(f"'in' does not work with {shown(b.ty)}\nit works on lists, sets, dicts and text", line)

    def list_contains(self, a: Ex, lst: Ex, line: int) -> Ex:
        # walk the items and compare each with ==, stopping at the first match (basic item types only)
        elem = elem_of(lst.ty)
        if not (elem == 'int' or elem == 'bool' or elem == 'str'):
            raise CompileError("'in' can search only lists of int, bool or str", line)
        a = self.want(a, elem, line, 'the left side of in')
        found = self.hidden_slot('in.found')
        counter = self.hidden_slot('in.i')
        self.emit(f'store i64 0, ptr {found}')
        self.emit(f'store i64 0, ptr {counter}')
        head = self.label('inhead')
        body = self.label('inbody')
        step = self.label('instep')
        end = self.label('inend')
        self.br(head)
        self.place(head)
        i = self.tmp('i')
        self.emit(f'{i} = load i64, ptr {counter}')
        lenp = self.tmp('lenp')
        self.emit(f'{lenp} = getelementptr {{ i64, i64, i64, i64, ptr }}, ptr {lst.reg}, i32 0, i32 2')
        ln = self.tmp('n')
        self.emit(f'{ln} = load i64, ptr {lenp}')
        go = self.tmp('go')
        self.emit(f'{go} = icmp slt i64 {i}, {ln}')
        self.cond_br(go, body, end)
        self.place(body)
        addr = self.list_slot(lst, ex(i, 'int'))
        item = self.load_item(lst.ty, addr, 'item')
        hit = self.tmp('hit')
        if elem == 'str':
            c = self.tmp('c')
            self.emit(f'{c} = call i32 @tomato_str_cmp(ptr {item}, ptr {a.reg})')
            self.emit(f'{hit} = icmp eq i32 {c}, 0')
        elif elem == 'int':
            c = self.tmp('c')
            self.emit(f'{c} = call i32 @tomato_int_cmp(i64 {item}, i64 {a.reg})')
            self.emit(f'{hit} = icmp eq i32 {c}, 0')
        else:
            self.emit(f'{hit} = icmp eq i64 {item}, {a.reg}')
        yes = self.label('inhit')
        self.cond_br(hit, yes, step)
        self.place(yes)
        self.emit(f'store i64 1, ptr {found}')
        self.br(end)
        self.place(step)
        cur = self.tmp('cur')
        self.emit(f'{cur} = load i64, ptr {counter}')
        nxt = self.tmp('next')
        self.emit(f'{nxt} = add i64 {cur}, 1')
        self.emit(f'store i64 {nxt}, ptr {counter}')
        self.br(head)
        self.place(end)
        f = self.tmp('found')
        self.emit(f'{f} = load i64, ptr {found}')
        i1 = self.tmp('flag')
        self.emit(f'{i1} = icmp ne i64 {f}, 0')
        self.release(a)
        self.release(lst)
        return self.bool_of(i1)

    def char_of(self, n: Node) -> bool:
        # text[i] for a text in a variable
        return n.kind == 'Index' and val_node(n.fields[0]).kind == 'Name' and self.can_borrow(val_node(n.fields[0]), [val_node(n.fields[1])]) and self.peek_type(val_node(n.fields[0])) == 'str'

    def char_equal(self, op: str, other: Node, ch: Node, flipped: bool, line: int) -> Ex:
        # text[i] compared for equality with another text: no one-character text is made. flipped: text[i] was on the left (the
        # other side is then a variable or a literal, so it does not matter which is read first)
        held_before = len(self.held)
        o = self.expr_b(other, [val_node(ch.fields[1])])
        if o.ty != 'str':
            raise CompileError(f"cannot use '{op}' with {shown(o.ty)} and {shown('str')}", line)
        self.hold(o)
        t = self.expr_b(val_node(ch.fields[0]), [val_node(ch.fields[1])])
        i = self.want(self.expr(val_node(ch.fields[1])), 'int', line, 'an index')
        self.drop_held(held_before)
        raw = self.int_raw(i, [o])
        c = self.tmp('same')
        self.emit(f'{c} = call i32 @tomato_str_char_eq(ptr {t.reg}, i64 {raw}, ptr {o.reg})')
        bad = self.tmp('oob')
        self.emit(f'{bad} = icmp slt i32 {c}, 0')
        self.fail_if(bad, 'index out of range', [o])
        self.release(o)
        r = self.tmp('same')
        self.emit(f'{r} = icmp {"eq" if op == "!=" else "ne"} i32 {c}, 0')
        return self.bool_of(r)

    def compare_text(self, op: str, a: Ex, b: Ex) -> Ex:
        c = self.tmp('cmp32')
        self.emit(f'{c} = call i32 @tomato_str_cmp(ptr {a.reg}, ptr {b.reg})')
        cc = signed_cc(op)
        r = self.tmp('c')
        self.emit(f'{r} = icmp {cc} i32 {c}, 0')
        self.release(a)
        self.release(b)
        return self.bool_of(r)

    def logic(self, n: Node, op: str) -> Ex:
        # and / or: the right side only runs when the left side does not decide the answer
        a = self.expr(val_node(n.fields[1]))
        a = self.want(a, 'bool', n.line, 'the left side of ' + op)
        res = self.hidden_slot('logic')
        self.emit(f'store i64 {a.reg}, ptr {res}')
        c = self.truth(a, n.line)
        rhs = self.label('rhs')
        end = self.label('endlogic')
        if op == 'and':
            self.cond_br(c, rhs, end)
        else:
            self.cond_br(c, end, rhs)
        self.place(rhs)
        b = self.expr(val_node(n.fields[2]))
        b = self.want(b, 'bool', n.line, 'the right side of ' + op)
        self.emit(f'store i64 {b.reg}, ptr {res}')
        self.br(end)
        self.place(end)
        r = self.tmp('logic')
        self.emit(f'{r} = load i64, ptr {res}')
        return ex(r, 'bool')

    def type_operand(self, n: Node) -> str:
        # the right side of `x in Type` (D23f): a type name that is not a variable; '' when it is something else
        if n.kind == 'Index':
            # a type with type arguments: tuple[str, int], list[int], set[str] or dict[str, int]
            base = val_node(n.fields[0])
            if base.kind == 'Name' and base.fields[0].text not in self.slots and base.fields[0].text in ['tuple', 'list', 'set', 'dict'] and n.fields[1].tag == 'n':
                saved = self.mod.cur
                tt = self.mod.type_name(vn(self.type_node_of(n)))
                self.mod.cur = saved
                if tt == '':
                    raise CompileError('this type is not supported here', n.line)
                return tt
            return ''
        if n.kind != 'Name':
            return ''
        name = n.fields[0].text
        if name in self.slots:
            return ''
        if name == 'None':
            return 'None'
        if basic_type(name) and name != 'File':
            return name
        key = self.mod.resolve(name)
        if key != '' and self.mod.has_class(key):
            return f'@{key}'
        if key != '' and self.mod.has_iface(key):
            return f'%{key}'
        return ''

    def type_test(self, left: Node, tt: str, line: int) -> Ex:
        # x in Type: true when the value's type is Type (a class name also matches its subclasses)
        a = self.expr(left)
        acc = ''
        c = ''
        if is_union(a.ty):
            for m in union_members(a.ty):
                if self.mod.assignable(m, tt):
                    c = self.box_is(a, m)
                    if acc == '':
                        acc = c
                    else:
                        merged = self.tmp('either')
                        self.emit(f'{merged} = or i1 {acc}, {c}')
                        acc = merged
            if acc == '':
                acc = self.tmp('no')
                self.emit(f'{acc} = icmp ne i64 0, 0')
        elif is_optional(a.ty):
            acc = self.tmp('opt')
            if tt == 'None':
                self.emit(f'{acc} = icmp eq ptr {a.reg}, null')
            elif self.mod.assignable(strip_optional(a.ty), tt):
                self.emit(f'{acc} = icmp ne ptr {a.reg}, null')
            else:
                self.emit(f'{acc} = icmp ne i64 0, 0')
        else:
            acc = self.tmp('static')
            if self.mod.assignable(a.ty, tt):
                self.emit(f'{acc} = icmp eq i64 0, 0')
            else:
                self.emit(f'{acc} = icmp ne i64 0, 0')
        self.release(a)
        return self.bool_of(acc)

    def binop(self, n: Node, expected: str) -> Ex:
        op = n.fields[0].text
        defer = self.defer_float
        self.defer_float = False
        if op == 'and' or op == 'or':
            return self.logic(n, op)
        if not is_fixed(expected) and self.fusable(n):
            return self.fused(n)
        if op == '+':
            chain: list[Node] = []
            self.concat_parts(n, chain)
            if len(chain) <= 16 and (self.is_text_part(chain[0]) or self.is_text_part(chain[1])):
                return self.fused_concat(chain, n.line)
        left = val_node(n.fields[1])
        right = val_node(n.fields[2])
        if (op == '/' or op == '//' or op == '%') and self.is_zero_literal(right):
            raise CompileError('division by zero: the divisor is the constant 0', n.line)
        if (op == '+' or op == '-' or op == '*') and is_fixed(expected) and self.literal_only(n):
            total = self.const_eval(n)
            negative_total = total < 0
            if negative_total:
                total = -total
            if not fits_literal(total, expected, negative_total):
                raise CompileError(f'the constant {self.const_eval(n)} does not fit in {shown(expected)}', n.line)
        if op == 'in' and self.type_operand(right) != '':
            return self.type_test(left, self.type_operand(right), n.line)
        if op == '==' or op == '!=':
            if self.char_of(right) and self.peek_type(left) == 'str':
                return self.char_equal(op, left, right, False, n.line)
            if self.char_of(left) and (right.kind == 'StrLit' or (right.kind == 'Name' and self.peek_type(right) == 'str')):
                return self.char_equal(op, right, left, True, n.line)
        a = ex('', '')
        b = ex('', '')
        held_before = len(self.held)
        if (op == '+' or op == '-' or op == '*') and self.literal_only(n) and is_fixed(expected):
            a = self.expr(left, expected)
            b = self.expr(right, expected)
        elif (op == '+' or op == '-' or op == '*') and self.literal_only(left) and not self.literal_only(right):
            b = self.expr(right)
            hint = b.ty if is_fixed(b.ty) else ''
            a = self.expr(left, hint)
        elif (op == '+' or op == '-' or op == '*') and self.literal_only(right) and not self.literal_only(left):
            a = self.expr(left)
            hint = a.ty if is_fixed(a.ty) else ''
            b = self.expr(right, hint)
        else:
            can_defer = op == '+' or op == '-' or op == '*'
            self.defer_float = can_defer and self.float_chain(left) and self.float_pure(right) > 0
            a = self.operand(left, pure_read(right) or self.plain_num(right))
            self.hold(a)                       # freed by the error path if the right side raises
            # A custom operator or an optional left operand cannot absorb the right operand's check.
            self.defer_float = can_defer and (a.ty == 'float' or is_numeric(a.ty)) and self.float_chain(right)
            b = self.operand(right, True)
            self.defer_float = False
        covered = a.unchecked != '' or b.unchecked != ''
        if covered and not ((op == '+' or op == '-' or op == '*') and (a.ty == 'float' or b.ty == 'float') and (a.ty == 'float' or is_numeric(a.ty)) and (b.ty == 'float' or is_numeric(b.ty))):
            self.flush_unchecked(a)
            self.flush_unchecked(b)
        self.drop_held(held_before)
        is_compare = op == '==' or op == '!=' or op == '<' or op == '<=' or op == '>' or op == '>='
        if op == 'in':
            return self.membership(a, b, n.line)
        if not ((op == 'is' or op == 'is not' or op == '==' or op == '!=') and (a.ty == 'None' or b.ty == 'None')):
            a = self.unwrap(a, n.line, [b])
            b = self.unwrap(b, n.line, [a])
        if (op == 'is' or op == 'is not' or op == '==' or op == '!=') and (a.ty == 'None' or b.ty == 'None'):
            if not is_rc(a.ty) or not is_rc(b.ty):
                other = a.ty
                if a.ty == 'None':
                    other = b.ty
                raise CompileError(f'a value of type {shown(other)} is never None, so it cannot be compared with None\nonly a value that can be None (such as T | None) may be compared with None', n.line)
            cc = 'ne' if op == 'is not' or op == '!=' else 'eq'
            c = self.tmp('isnone')
            self.emit(f'{c} = icmp {cc} ptr {a.reg}, {b.reg}')
            self.release(a)
            self.release(b)
            return self.bool_of(c)
        if is_class(a.ty) and operator_marker_of(op) != '' and (self.mod.has_op(a.ty[1:], operator_marker_of(op)) or not (op == '==' or op == '!=')):
            return self.operator_call(a, b, op, n.line)
        if (op == '==' or op == '!=') and (a.ty.startswith('list[') or b.ty.startswith('list[')):
            return self.list_equal(op, a, b, n.line)
        if (op == '==' or op == '!=') and (is_mtuple(a.ty) or is_mtuple(b.ty)):
            return self.mtuple_equal(op, a, b, n.line)
        if (op == '+' or op == '*') and (is_list(a.ty) or is_list(b.ty) or a.ty == 'str' or b.ty == 'str'):
            joined = self.sequence_op(op, a, b, n.line)
            if joined.ty != '':
                return joined
        if a.ty == 'str' or b.ty == 'str':
            if a.ty != b.ty:
                raise CompileError(f"cannot use '{op}' with {shown(a.ty)} and {shown(b.ty)}", n.line)
            if op == '+':
                r = self.tmp('cat')
                self.emit(f'{r} = call ptr @tomato_str_concat(ptr {a.reg}, ptr {b.reg})')
                self.release(a)
                self.release(b)
                return ex(r, 'str')
            if is_compare:
                return self.compare_text(op, a, b)
            raise CompileError(f"'{op}' does not work on text\nit works with numbers; use + to join text", n.line)
        if op == 'xor':
            a = self.want(a, 'bool', n.line, 'the left side of ' + op)
            b = self.want(b, 'bool', n.line, 'the right side of ' + op)
            return ex(self.arith(op, a.reg, b.reg), 'bool')
        if a.ty == 'float' or b.ty == 'float':
            return self.float_op(op, a, b, n.line, defer, n)
        if is_compare and a.ty == 'bool' and b.ty == 'bool':
            if op != '==' and op != '!=':
                raise CompileError('bool values cannot be ordered with < or >\nuse == or != to compare them', n.line)
        elif not (is_numeric(a.ty) and is_numeric(b.ty)):
            raise CompileError(f"cannot use '{op}' with {shown(a.ty)} and {shown(b.ty)}", n.line)
        if is_numeric(a.ty):
            known: Rng | None = None
            if (op == '+' or op == '-' or op == '*') and self.tracking():
                known = self.range_of(n, self.facts)
            if op == '+':
                return self.num_arith('add', a, b, n.line, known)
            if op == '-':
                return self.num_arith('sub', a, b, n.line, known)
            if op == '*':
                return self.num_arith('mul', a, b, n.line, known)
            if op == '%':
                return self.num_modulo(a, b, n.line)
            if op == '/':
                return self.num_divide(a, b, n.line, n)
            if op == '//':
                return self.num_floor_divide(a, b, n.line)
            if op == '**':
                return self.num_power(a, b, n.line)
            if op == '&' or op == '|' or op == '^':
                return self.num_bitwise(op, a, b, n.line)
            if op == '<<' or op == '>>':
                return self.num_shift(op, a, b, n.line)
            if is_compare:
                return self.num_compare(op, a, b, n.line)
        elif is_compare:
            if op == '==':
                return self.icmp('eq', a.reg, b.reg)
            return self.icmp('ne', a.reg, b.reg)
        raise CompileError(f"the operator '{op}' is not supported here", n.line)

    def list_equal(self, op: str, a: Ex, b: Ex, line: int) -> Ex:
        # xs == ys: the same length and every pair of items equal (items compare by their own ==); both lists must have the same type
        if a.ty != b.ty:
            raise CompileError(f"cannot use '{op}' with {shown(a.ty)} and {shown(b.ty)}\nlists are equal only when they have the same type", line)
        if not self.list_comparable(elem_of(a.ty)):
            raise CompileError(f"cannot use '{op}' on {shown(a.ty)}\nits items cannot be compared with ==", line)
        r = ex('', 'bool')
        if item_width(a.ty) != 8:
            # compact items (bool, fixed-width integers) are equal exactly when their bytes are
            c = self.tmp('same')
            self.emit(f'{c} = call i32 @tomato_list_eq_bytes(ptr {a.reg}, ptr {b.reg}, i64 {item_width(a.ty)})')
            i1 = self.tmp('flag')
            self.emit(f'{i1} = icmp ne i32 {c}, 0')
            self.release(a)
            self.release(b)
            r = self.bool_of(i1)
        else:
            info = self.mod.instance_func(self.mod.resolve('_list_eq'), [elem_of(a.ty)], line)
            r = self.call_helper(info, [a, b])
        if op == '!=':
            return ex(self.arith('xor', r.reg, '1'), 'bool')
        return r

    def mtuple_equal(self, op: str, a: Ex, b: Ex, line: int) -> Ex:
        # (a, 1) == (b, 2) on two tuples of the same mixed item types: every pair of items equal, compared position by position
        if a.ty != b.ty:
            raise CompileError(f"cannot use '{op}' with {shown(a.ty)} and {shown(b.ty)}\ntuples are equal only when they have the same type", line)
        if not self.list_comparable(a.ty):
            raise CompileError(f"cannot use '{op}' on {shown(a.ty)}\nits items cannot be compared with ==", line)
        r = self.call_helper(self.mod.helper('eq', a.ty, line), [a, b])
        if op == '!=':
            return ex(self.arith('xor', r.reg, '1'), 'bool')
        return r

    def list_comparable(self, t: str) -> bool:
        if t.startswith('list['):
            return self.list_comparable(elem_of(t))
        if is_mtuple(t):
            for m in mtuple_items(t):
                if not self.list_comparable(m):
                    return False
            return True
        return t == 'str' or t == 'bool' or t == 'float' or is_numeric(t) or (is_class(t) and self.mod.has_op(t[1:], 'eq'))

    def invert_op(self, n: Node) -> Ex:
        # ~x on an object whose class has a method marked @invert (taking nothing besides self)
        v = self.unwrap(self.expr(val_node(n.fields[1])), n.line)
        if v.ty == 'int':
            r = self.tmp('not')
            self.emit(f'{r} = call i64 @tomato_int_not(i64 {v.reg})')
            self.release(v)
            return exf(r, 'int')
        if is_fixed(v.ty):
            r = self.tmp('not')
            self.emit(f'{r} = xor {llvm_type(v.ty)} {v.reg}, -1')
            return ex(r, v.ty)
        if not is_class(v.ty):
            raise CompileError(f"cannot use '~' on {shown(v.ty)}\nit works on whole numbers and on objects whose class has a method marked @invert", n.line)
        f = self.mod.find_op(v.ty[1:], 'invert')
        if f is None or len(f.ptypes) != 0 or f.ret == '':
            raise CompileError("cannot use '~' on '" + v.ty[1:] + "' objects\nadd a method marked @invert that takes nothing and returns the result", n.line)
        return self.marker_call(v, f, [], n.line)

    def operator_call(self, a: Ex, b: Ex, op: str, line: int) -> Ex:
        # a + b on a class whose method is marked @add (and the same for the other operators): the method of the left
        # operand runs with the right operand as its one argument (D12l)
        marker = operator_marker_of(op)
        found = self.mod.find_op(a.ty[1:], marker)
        if found is None:
            raise CompileError("cannot use '" + op + "' on '" + a.ty[1:] + "' objects\nadd a method marked @" + marker + ' to the class', line)
        info = found
        if len(info.ptypes) != 1:
            raise CompileError(f"the @{marker} method '{info.name}' must take exactly one argument besides self", line)
        b = self.want(b, info.ptypes[0], line, 'the right operand of ' + op)
        values: list[Ex] = [a, b]
        symbol = self.method_symbol(a, info)
        text = f'call {self.ret_llvm(info)} {symbol}(ptr {a.reg}, {llvm_type(b.ty)} {b.reg})'
        result = ex('', '')
        if info.ret == '':
            self.emit(text)
        else:
            r = self.tmp('op')
            self.emit(f'{r} = {text}')
            result = ret_ex(r, info.ret)
        self.check_error(values, symbol)
        self.release(a)
        self.release(b)
        if marker == 'eq' or marker == 'lt' or marker == 'le' or marker == 'gt' or marker == 'ge':
            if result.ty != 'bool':
                raise CompileError(f"the @{marker} method '{info.name}' must return bool", line)
        if op == '!=':
            return ex(self.arith('xor', result.reg, '1'), 'bool')
        return result

    def call(self, n: Node, statement: bool) -> Ex:
        f = val_node(n.fields[0])
        if f.kind == 'LlvmRef':
            if len(n.fields[2].items) > 0:
                raise CompileError('an LLVM function cannot take keyword arguments', n.line)
            return self.llvm_call(n, f.fields[0].text)
        if f.kind == 'Attr':
            self.kw = n.fields[2].items
            target = val_node(f.fields[0])
            if target.kind == 'Name' and target.fields[0].text not in self.slots and self.mod.resolve(target.fields[0].text) != '' and self.mod.has_class(self.mod.resolve(target.fields[0].text)):
                return self.qualified_call(n, f, self.mod.resolve(target.fields[0].text))
            return self.method_call(n, f)
        if f.kind == 'Index' and val_node(f.fields[0]).kind == 'Name' and val_node(f.fields[0]).fields[0].text not in self.slots and self.mod.resolve(val_node(f.fields[0]).fields[0].text) in self.mod.generics:
            return self.explicit_call(self.mod.resolve(val_node(f.fields[0]).fields[0].text), n, f, val_nodes(n.fields[1]))
        if f.kind == 'Index' or f.kind == 'Call':
            self.kw = n.fields[2].items
            callee = self.expr(f)
            if is_fn(callee.ty):
                return self.call_value(callee, val_nodes(n.fields[1]), n.line, 'this function value')
            self.kw = []
            raise CompileError(f'this is {shown(callee.ty)}, not a function, so it cannot be called', n.line)
        if f.kind != 'Name':
            raise CompileError('only a function name can be called here\ncalling the result of another expression is not supported', n.line)
        name = f.fields[0].text
        if len(n.fields[2].items) > 0 and name in ['print', 'open', 'len', 'str', 'int', 'input', 'sleep']:
            raise CompileError(f"'{name}' does not take keyword arguments", n.line)
        args = val_nodes(n.fields[1])
        if name in self.slots and is_fn(self.types[name]):
            self.kw = n.fields[2].items
            return self.call_value(self.expr(f), args, n.line, "the function value '" + name + "'")
        if name == 'print':
            if not statement:
                raise CompileError("print() gives no value, so it cannot be used inside an expression", n.line)
            self.print_call(args)
            return ex('', '')
        if name == 'open':
            return self.open_call(args, n.line)
        if name == 'input' and name not in self.slots and self.mod.resolve(name) == '':
            return self.input_call(args, n.line)
        if name == 'clock' and name not in self.slots and self.mod.resolve(name) == '':
            if len(args) > 0:
                raise CompileError('clock() takes no arguments', n.line)
            c = self.tmp('clock')
            self.emit(f'{c} = call double @tomato_clock()')
            return ex(c, 'float')
        if name == 'sleep' and name not in self.slots and self.mod.resolve(name) == '':
            raise CompileError("sleep() is async, so it must be awaited\nwrite: await sleep(seconds)  inside an async def", n.line)
        if name == '_http_wait' and name not in self.slots and self.mod.resolve(name) == '':
            raise CompileError("_http_wait() is async, so it must be awaited\nwrite: await _http_wait(handle)  inside an async def", n.line)
        if (name == '_settle' or name == '_park' or name == '_fd_wait') and name not in self.slots and self.mod.resolve(name) == '':
            raise CompileError(f"{name}() is async, so it must be awaited\nwrite: await {name}(...)  inside an async def", n.line)
        if name == '_unpark' and name not in self.slots and self.mod.resolve(name) == '':
            return self.unpark_call(args, n.line)
        if name == 'len':
            return self.len_call(args, n.line)
        if name == 'str':
            return self.str_call(args, n.line)
        if name == '_repr_box' and len(args) == 1 and name not in self.slots and self.mod.resolve(name) == '':
            # the text of a union value inside a printed container: text is quoted, as Python does
            bv = self.expr(args[0])
            return self.union_text(bv, True, n.line)
        if name == '_format_spec' and len(args) == 2 and name not in self.slots and self.mod.resolve(name) == '':
            return self.format_call(args, n.line)
        if name == 'float' and len(args) == 1:
            return self.float_call(self.expr(args[0]), n.line)
        if name == 'int' and len(args) == 1:
            conv = self.expr(args[0])
            if conv.ty == 'float':
                return self.float_to_int(conv, n.line)
            return self.convert_explicit(conv, 'int', n.line)
        key = self.mod.resolve(name)
        if key == '' and name in ['abs', 'chr', 'ord'] and name not in self.slots:
            return self.number_text_builtin(name, args, n.line)
        if key == '' and name == 'round' and name not in self.slots:
            return self.round_call(args, n.fields[2].items, n.line)
        if key == '' and name in ['divmod', 'any', 'all'] and name not in self.slots:
            # written in Tomato, in std/builtin/ (_divmod in numbers.tom, _any and _all in lists.tom)
            self.kw = n.fields[2].items
            return self.helper_call('_' + name, name, ex('', ''), args, n.line)
        if key == '' and name == 'sorted' and len(n.fields[2].items) > 0:
            return self.sorted_by(args, n.fields[2].items, n.line)
        if key == '' and (name == 'map' or name == 'filter') and name not in self.slots:
            return self.map_filter(name, args, n.fields[2].items, n.line)
        if key == '' and name in ['sorted', 'reversed', 'sum', 'min', 'max']:
            self.kw = []
            return self.list_builtin(name, args, n.line)
        if name == 'range' and name not in self.slots:
            # range(...) is a value of the builtin class `range` (std/builtin/range.tom); range(a, b, c) is its constructor
            if len(args) < 1 or len(args) > 3 or len(n.fields[2].items) > 0:
                raise CompileError('range() takes 1 to 3 whole-number arguments: range(stop), range(start, stop) or range(start, stop, step)', n.line)
            if len(args) < 3:
                helper = self.mod.resolve(f'_range{len(args)}')
                self.kw = []
                return self.call_function(self.mod.find(helper, n.line), '@tomato.' + helper, ex('', ''), args, n.line)
        if key == '' and name == 'list':
            return self.list_call(args, n.line)
        if key == '':
            raise CompileError(self.unknown_function(name), n.line)
        if key in self.mod.generics:
            return self.generic_call(key, n, args)
        if self.mod.has_class(key):
            if len(n.fields[2].items) > 0:
                raise CompileError('keyword arguments are not supported when creating an object\npass the arguments by position', n.line)
            return self.construct(self.mod.find_class(key, n.line), args, n.line)
        if self.mod.mode == 2 and self.mod.late and len(n.fields[2].items) == 0 and len(args) > 0:
            floats = True
            target2 = self.mod.find(key, n.line)
            for k, a in enumerate(args):
                if k < len(target2.ptypes) and target2.ptypes[k] == 'U:float;int' and self.peek_type(a) != 'float':
                    floats = False
            if floats and len(args) == len(target2.ptypes) and target2.module == 'math' and self.mod.float_copy(key) != '':
                key = self.mod.float_copy(key)
        self.kw = n.fields[2].items
        return self.call_function(self.mod.find(key, n.line), '@tomato.' + key, ex('', ''), args, n.line)

    # ---- generic classes and functions (D60a)
    # the type of an argument, found by compiling it and throwing the code away (it is compiled again for real afterwards)
    def arg_type(self, a: Node) -> str:
        mark = len(self.lines)
        ty = ''
        # an argument is not directly under await or start, even when its call is (await wait_for(f(), 1) must say f is async)
        outer_ok = self.async_ok
        outer_fresh = self.fresh_frame
        awaits = self.awaits
        self.async_ok = False
        try:
            ty = self.expr(a).ty
        catch CompileError as e:
            if 'so it must be awaited or started' in e.message:
                raise e      # the real mistake, rather than "cannot tell what T is"
            ty = ''          # such as an empty list, whose type only the other arguments settle
        self.async_ok = outer_ok
        self.fresh_frame = outer_fresh
        self.awaits = awaits             # the places it stopped at go with the lines
        self.lines = self.lines[:mark]
        self.terminated = False
        return ty

    # what each type parameter of a generic class or function stands for, found from the types of the arguments
    def infer_targs(self, gkey: str, params: list[Node], args: list[Node], line: int) -> list[str]:
        saved = self.mod.cur
        saved_vars = self.mod.tvars
        self.mod.cur = self.mod.generic_mods[gkey]
        tparams = self.mod.type_params_of(gkey)
        pattern: dict[str, str] = {}
        for tp in tparams:
            pattern[tp] = '$' + tp
        self.mod.tvars = pattern
        patterns = [self.mod.type_name(p.fields[1]) for p in params]
        self.mod.cur = saved
        self.mod.tvars = saved_vars
        binds: dict[str, str] = {}
        for k, a in enumerate(args):
            if k < len(patterns) and '$' in patterns[k]:
                self.mod.unify(patterns[k], self.arg_type(a), binds)
        out: list[str] = []
        for tp in tparams:
            if tp not in binds:
                raise CompileError(f"cannot tell what {tp} is in this call of '{self.mod.generics[gkey].fields[0].text}'\n{tp} comes from the types of the arguments: pass a value that has it, or write the type out, as in {self.mod.generics[gkey].fields[0].text}[int](...)", line)
            out.append(binds[tp])
        return out

    def generic_class_init(self, gkey: str) -> list[Node]:
        for m in val_nodes(self.mod.generics[gkey].fields[4]):
            if m.fields[6].tag == 's' and m.fields[6].text == 'init':
                return [p for p in val_nodes(m.fields[1]) if p.fields[0].text != 'self']
        return []

    # a type written as an expression, such as the `str` in Stack[str]() or the `list[int]` in Box[list[int]](...), as a type node
    def type_node_of(self, n: Node) -> Node:
        if n.kind == 'Name':
            return mk('TypeRef', n.line, [vs(n.fields[0].text), vz(), vz(), vz()])
        if n.kind == 'Index':
            base = val_node(n.fields[0])
            if base.kind == 'Name' and n.fields[1].tag == 'n':
                arg = val_node(n.fields[1])
                if arg.kind == 'TupleLit':
                    # several types in one index: tuple[str, int] (a fixed length, an own type per item) or dict[str, int]
                    parts = [self.type_node_of(item) for item in val_nodes(arg.fields[0])]
                    if base.fields[0].text == 'tuple':
                        return mk('TypeRef', n.line, [vs('tuple'), vz(), vnodes(parts), vz()])
                    if base.fields[0].text == 'dict' and len(parts) == 2:
                        return mk('TypeRef', n.line, [vs('dict'), vz(), vn(parts[0]), vn(parts[1])])
                    raise CompileError(f"'{base.fields[0].text}' does not take several types here\nonly tuple[A, B] and dict[K, V] are written with more than one type", n.line)
                return mk('TypeRef', n.line, [vs(base.fields[0].text), vz(), vn(self.type_node_of(arg)), vz()])
        raise CompileError('this is not a type\nwrite the type of the items, such as Stack[str]()', n.line)

    # Name[Type](args): a generic class or function used with its type argument written out
    def explicit_call(self, gkey: str, n: Node, f: Node, args: list[Node]) -> Ex:
        g = self.mod.generics[gkey]
        if f.fields[1].tag != 'n':
            raise CompileError('this is not a type\nwrite the type of the items, such as Stack[str]()', n.line)
        saved = self.mod.cur
        targ = self.mod.type_name(vn(self.type_node_of(val_node(f.fields[1]))))
        self.mod.cur = saved
        if targ == '':
            raise CompileError('this type is not supported here', n.line)
        if g.kind == 'ClassDef':
            if len(n.fields[2].items) > 0:
                raise CompileError('keyword arguments are not supported when creating an object\npass the arguments by position', n.line)
            ckey = self.mod.instance_class(gkey, [targ], n.line)
            return self.construct(self.mod.find_class(ckey, n.line), args, n.line)
        info = self.mod.instance_func(gkey, [targ], n.line)
        self.kw = n.fields[2].items
        return self.call_function(info, '@tomato.' + info.key, ex('', ''), args, n.line)

    def generic_call(self, gkey: str, n: Node, args: list[Node]) -> Ex:
        g = self.mod.generics[gkey]
        if g.kind == 'ClassDef':
            if len(n.fields[2].items) > 0:
                raise CompileError('keyword arguments are not supported when creating an object\npass the arguments by position', n.line)
            targs = self.infer_targs(gkey, self.generic_class_init(gkey), args, n.line)
            ckey = self.mod.instance_class(gkey, targs, n.line)
            return self.construct(self.mod.find_class(ckey, n.line), args, n.line)
        targs = self.infer_targs(gkey, val_nodes(g.fields[1]), args, n.line)
        info = self.mod.instance_func(gkey, targs, n.line)
        self.kw = n.fields[2].items
        return self.call_function(info, '@tomato.' + info.key, ex('', ''), args, n.line)

    # f'{x:spec}': the lexer wrote _format_spec(x, 'spec') after checking the form of the spec; the type of x says what the
    # spec may hold. The work is done by _fmt_str, _fmt_int and _fmt_float in std/builtin/format.tom.
    def format_call(self, args: list[Node], line: int) -> Ex:
        spec = parse_format_spec(args[1].fields[0].text, line, 0)
        v = self.expr(args[0])
        if is_fixed(v.ty):
            v = self.convert_explicit(v, 'int', line)
        if v.ty != 'str' and v.ty != 'int' and v.ty != 'float':
            raise CompileError(f'a format spec needs a text, an int or a float, but this value is {shown(v.ty)}\nleave the spec out, or make text with str() first', line)
        what = 'text' if v.ty == 'str' else v.ty
        if v.ty == 'str':
            if spec.sign != '':
                raise CompileError(f"a format spec for text cannot have a sign\nremove '{spec.sign}'", line)
            if spec.comma:
                raise CompileError("a format spec for text cannot have a ','\nthousands separators are for numbers", line)
            if spec.kind != '' and spec.kind != 's':
                raise CompileError(f"the format type '{spec.kind}' is for numbers, but this value is text\nuse s, or leave the type out", line)
        elif spec.kind == 's':
            raise CompileError(f"the format type 's' is for text, but this value is {what}\nleave the type out, or use d, f, e or g", line)
        elif v.ty == 'float' and spec.kind == 'd':
            raise CompileError("the format type 'd' is for whole numbers, but this value is float\nuse f, e or g, or leave the type out", line)
        elif v.ty == 'int' and spec.precision >= 0 and spec.kind not in ['f', 'e', 'g']:
            raise CompileError("a format spec for an int cannot have a precision unless its type is f, e or g\nremove the '.' and the digits after it", line)
        fill = ex(self.mod.intern(spec.fill), 'str')
        align = ex(self.mod.intern(spec.align), 'str')
        sign = ex(self.mod.intern(spec.sign), 'str')
        zero = ex('1' if spec.zero else '0', 'bool')
        comma = ex('1' if spec.comma else '0', 'bool')
        width = self.tag_small(str(spec.width))
        if v.ty == 'str':
            return self.builtin_call('_fmt_str', [v, fill, align, zero, width, self.tag_small(str(spec.precision))], line)
        if v.ty == 'int' and spec.kind not in ['f', 'e', 'g']:
            return self.builtin_call('_fmt_int', [v, fill, align, sign, zero, width, comma], line)
        if v.ty == 'int':
            v = self.float_call(v, line)
        kind = ex(self.mod.intern(spec.kind), 'str')
        return self.builtin_call('_fmt_float', [v, fill, align, sign, zero, width, comma, self.tag_small(str(spec.precision)), kind], line)

    # round(x) and round(x, ndigits): an int or a float; round(x) is an int, round(x, ndigits) has the type of x
    def round_call(self, args: list[Node], keywords: list[Val], line: int) -> Ex:
        nodes: list[Node] = [a for a in args]
        for kv in keywords:
            if kv.items[0].text != 'ndigits' or len(nodes) != 1:
                raise CompileError('round() takes a number and optionally ndigits: round(x) or round(x, ndigits)', line)
            nodes.append(val_node(kv.items[1]))
        if len(nodes) < 1 or len(nodes) > 2:
            raise CompileError('round() takes a number and optionally ndigits: round(x) or round(x, ndigits)', line)
        x = self.expr(nodes[0])
        if x.ty != 'int' and x.ty != 'float':
            raise CompileError(f'round() takes an int or a float, but this is {shown(x.ty)}', line)
        if len(nodes) == 1:
            if x.ty == 'int':
                return x
            return self.builtin_call('_round_float0', [x], line)
        held_before = len(self.held)
        self.hold(x)
        digits = self.want(self.expr(nodes[1]), 'int', line, 'ndigits of round')
        self.drop_held(held_before)
        return self.builtin_call('_round_' + x.ty, [x, digits], line)

    # a call of a function of the built-ins (std/builtin/) under the built-in name `public` (messages and keywords use it); when recv
    # is a value, it is the first parameter of the function (the object of a text method) and the others are `args`
    def helper_call(self, helper: str, public: str, recv: Ex, args: list[Node], line: int) -> Ex:
        key = self.mod.resolve(helper)
        info = self.mod.find(key, line)
        shown_info = FuncInfo()
        shown_info.name = public
        shown_info.line = info.line
        shown_info.ret = info.ret
        shown_info.ptypes = info.ptypes
        shown_info.pnames = info.pnames
        if recv.ty != '':
            shown_info.ptypes = info.ptypes[1:]
            shown_info.pnames = info.pnames[1:]
        shown_info.defaults = info.defaults
        shown_info.key = key
        shown_info.module = info.module
        return self.call_function(shown_info, '@tomato.' + key, recv, args, line)

    def number_text_builtin(self, name: str, args: list[Node], line: int) -> Ex:
        # abs(x) for an int or a float (std/builtin/numbers.tom), chr(n) and ord(c)
        if len(args) != 1 or len(self.kw) > 0:
            raise CompileError(f"'{name}' takes exactly one argument", line)
        v = self.expr(args[0])
        if name == 'abs':
            if v.ty == 'int':
                return self.builtin_call('_abs_int', [v], line)
            if v.ty == 'float':
                return self.builtin_call('_abs_float', [v], line)
            if is_fixed(v.ty):
                if not is_signed(v.ty):
                    return v
                # a fixed-width int: -x with an overflow stop (only the smallest value overflows), kept when x is not negative
                llt = llvm_type(v.ty)
                intr = f'llvm.ssub.with.overflow.{llt}'
                self.mod.declare(f'declare {{{llt}, i1}} @{intr}({llt}, {llt})')
                pair = self.tmp('pair')
                self.emit(f'{pair} = call {{{llt}, i1}} @{intr}({llt} 0, {llt} {v.reg})')
                negated = self.tmp('neg')
                self.emit(f'{negated} = extractvalue {{{llt}, i1}} {pair}, 0')
                ov = self.tmp('ov')
                self.emit(f'{ov} = extractvalue {{{llt}, i1}} {pair}, 1')
                self.fail_if(ov, 'integer overflow')
                below = self.tmp('below')
                self.emit(f'{below} = icmp slt {llt} {v.reg}, 0')
                r = self.tmp('abs')
                self.emit(f'{r} = select i1 {below}, {llt} {negated}, {llt} {v.reg}')
                return ex(r, v.ty)
            raise CompileError(f'abs() takes an int or a float, but this is {shown(v.ty)}', line)
        if name == 'chr':
            v = self.want(v, 'int', line, 'the argument of chr')
            # a number too big for a machine word is a heap number (low bit clear): out of range as well
            tagbit = self.tmp('tagbit')
            self.emit(f'{tagbit} = and i64 {v.reg}, 1')
            huge = self.tmp('huge')
            self.emit(f'{huge} = icmp eq i64 {tagbit}, 0')
            self.fail_if(huge, 'chr() takes a number from 0 to 1114111, not a surrogate', [v])
            raw = self.int_raw(v)
            high = self.tmp('toobig')
            self.emit(f'{high} = icmp ugt i64 {raw}, 1114111')
            low = self.tmp('surrogate')
            self.emit(f'{low} = sub i64 {raw}, 55296')
            sur = self.tmp('insurrogate')
            self.emit(f'{sur} = icmp ult i64 {low}, 2048')
            bad = self.tmp('badchar')
            self.emit(f'{bad} = or i1 {high}, {sur}')
            self.fail_if(bad, 'chr() takes a number from 0 to 1114111, not a surrogate')
            r = self.tmp('char')
            self.emit(f'{r} = call ptr @tomato_str_chr(i64 {raw})')
            return ex(r, 'str')
        v = self.want(v, 'str', line, 'the argument of ord')
        n = self.tmp('alen')
        self.emit(f'{n} = call i64 @tomato_str_len(ptr {v.reg})')
        bad = self.tmp('notone')
        self.emit(f'{bad} = icmp ne i64 {n}, 1')
        self.fail_if(bad, 'ord() takes a text of exactly one character', [v])
        r = self.tmp('code')
        self.emit(f'{r} = call i64 @tomato_str_ord(ptr {v.reg})')
        self.release(v)
        return self.tag_small(r)

    def llvm_type_of(self, t: str) -> str:
        # how an LLVM function sees a Tomato type: a bool is one bit there
        if t == 'bool':
            return 'i1'
        return llvm_type(t)

    def llvm_call(self, n: Node, name: str) -> Ex:
        # a call to a declared LLVM function (D27b): the declaration gives the types, the linker the body
        found: list[FuncInfo] = [d for d in self.mod.llvm_decls if d.name == name]
        if len(found) == 0:
            raise CompileError(f"the LLVM function '!{name}' is not declared\nadd a line like '!{name}(a: int) -> int' at the top level of the file", n.line)
        info = found[0]
        args = val_nodes(n.fields[1])
        if len(args) != len(info.ptypes):
            raise CompileError("the LLVM function '!" + name + "' takes " + plural(len(info.ptypes), 'argument') + ', but ' + str(len(args)) + ' given', n.line)
        parts: list[str] = []
        types: list[str] = []
        held: list[Ex] = []
        held_before = len(self.held)
        for k, a in enumerate(args):
            v = self.expr(a, info.ptypes[k])
            v = self.want(v, info.ptypes[k], n.line, 'argument ' + str(k + 1) + ' of !' + name)
            reg = v.reg
            if v.ty == 'bool':
                reg = self.tmp('bit')
                self.emit(f'{reg} = trunc i64 {v.reg} to i1')
            elif v.ty == 'int':
                reg = self.int_raw(v)          # the arguments before it are held, so a failure here frees them too
            held.append(v)
            self.hold(v)                        # freed by the error path if a later argument raises
            parts.append(f'{self.llvm_type_of(v.ty)} {reg}')
            types.append(self.llvm_type_of(v.ty))
        self.drop_held(held_before)
        ret = self.llvm_type_of(info.ret) if info.ret != '' else 'void'
        self.mod.declare('declare ' + ret + ' @' + name + '(' + ', '.join(types) + ')')
        text = 'call ' + ret + ' @' + name + '(' + ', '.join(parts) + ')'
        r = ''
        if info.ret == '':
            self.emit(text)
        else:
            r = self.tmp('llvm')
            self.emit(f'{r} = {text}')
        for h in held:
            self.release(h)
        if info.ret == '':
            return ex('', '')
        if info.ret == 'bool':
            w = self.tmp('flag')
            self.emit(f'{w} = zext i1 {r} to i64')
            return ex(w, 'bool')
        if info.ret == 'int':
            return self.int_from_machine(r, True)
        return ex(r, info.ret)

    # a named function used as a value (D-fn): its address, with the type fn(parameters) -> result
    def func_value(self, name: str, key: str, line: int) -> Ex:
        if key in self.mod.generics:
            raise CompileError(f"'{name}' is generic, so it cannot be used as a value yet\nwrite a plain function that calls it", line)
        info = self.mod.find(key, line)
        if info.is_async or info.is_gen or info.has_varargs or info.has_kwargs:
            raise CompileError(f"'{name}' cannot be used as a value: an async function, a generator and a function with *args or **kwargs have no function type", line)
        res = info.ret
        if res == '':
            res = 'None'
        return ex('@tomato.' + key, 'fn[' + ','.join(info.ptypes) + '>' + res + ']')

    # a lambda (x -> expression): it becomes a function of its own, so it can use only its parameters and global names. The expected type
    # gives the parameter types; its result may be written ? (to find out from the body).
    def lambda_value(self, n: Node, expected: str) -> Ex:
        names: list[str] = [v.text for v in n.fields[0].items]
        body = val_node(n.fields[1])
        if not is_fn(expected):
            raise CompileError('a lambda needs to know its parameter types\nuse it where a function is expected, such as sorted(xs, key=x -> x.age), or give the variable a type: f: fn(int) -> int = x -> x + 1', n.line)
        ptypes = fn_params(expected)
        if len(ptypes) != len(names):
            raise CompileError('this lambda takes ' + plural(len(names), 'parameter') + ', but ' + shown(expected) + ' takes ' + str(len(ptypes)), n.line)
        used: list[str] = []
        names_read(body, used)
        for u in used:
            if u in self.slots and u not in names:
                raise CompileError(f"a lambda cannot use the variable '{u}' from the function around it\nit can use its own parameters and global names; pass the value as a parameter", n.line)
        res = fn_result(expected)
        if res == '?':
            mark = len(self.lines)
            saved_slots: dict[str, str] = {}
            saved_types: dict[str, str] = {}
            for k, nm in enumerate(names):
                if nm in self.slots:
                    saved_slots[nm] = self.slots[nm]
                    saved_types[nm] = self.types[nm]
                self.new_slot(nm, ptypes[k])
            res = self.expr(body).ty
            self.lines = self.lines[:mark]
            self.terminated = False
            keep_s: dict[str, str] = {}
            keep_t: dict[str, str] = {}
            for key in self.slots:
                if key in saved_slots:
                    keep_s[key] = saved_slots[key]
                    keep_t[key] = saved_types[key]
                elif key not in names:
                    keep_s[key] = self.slots[key]
                    keep_t[key] = self.types[key]
            self.slots = keep_s
            self.types = keep_t
            if res == '' or res == 'None':
                raise CompileError('the body of this lambda gives no value', n.line)
        self.mod.lambda_count += 1
        fname = f'_lambda{self.mod.lambda_count}'
        binds: dict[str, str] = {}
        params: list[Node] = []
        for k, nm in enumerate(names):
            binds[f'__p{k}'] = ptypes[k]
            params.append(mk('Param', n.line, [vs(nm), vn(mk('TypeRef', n.line, [vs(f'__p{k}'), vz(), vz(), vz()])), vz(), vz()]))
        binds['__r'] = res
        ret_stmt = mk('Return', n.line, [vn(body)])
        item = mk('FuncDef', n.line, [vs(fname), vnodes(params), vn(mk('TypeRef', n.line, [vs('__r'), vz(), vz(), vz()])), vnodes([ret_stmt]), vb(False), vb(False), vz(), vb(False), vb(False), vz()])
        saved_vars = self.mod.tvars
        self.mod.tvars = binds
        info = function_info(item, self.mod, '')
        self.mod.tvars = saved_vars
        info.targs = binds
        self.mod.infos.append(info)
        self.mod.func_nodes.append(item)
        self.mod.extra_funcs.append(item)
        return ex('@tomato.' + info.key, 'fn[' + ','.join(ptypes) + '>' + res + ']')

    # call a function value: the callee only borrows its arguments, like any call
    def call_value(self, fv: Ex, args: list[Node], line: int, what: str) -> Ex:
        if len(self.kw) > 0:
            self.kw = []
            raise CompileError('a function value does not take keyword arguments\npass the arguments by position', line)
        ptypes = fn_params(fv.ty)
        res = fn_result(fv.ty)
        if len(args) != len(ptypes):
            raise CompileError(what + ' takes ' + plural(len(ptypes), 'argument') + ', but ' + str(len(args)) + ' given', line)
        values: list[Ex] = []
        held_before = len(self.held)
        for k, a in enumerate(args):
            v = self.expr(a, ptypes[k])
            values.append(self.want(v, ptypes[k], line, 'argument ' + str(k + 1) + ' of ' + what))
            self.hold(values[-1])
        self.drop_held(held_before)
        parts: list[str] = [f'{llvm_type(v2.ty)} {v2.reg}' for v2 in values]
        callee = fv.reg
        result = ex('', '')
        if res == 'None':
            self.emit('call void ' + callee + '(' + ', '.join(parts) + ')')
        else:
            r = self.tmp('call')
            self.emit(f'{r} = call {llvm_type(res)} {callee}(' + ', '.join(parts) + ')')
            result = ret_ex(r, res)
        self.check_error(values)
        for v3 in values:
            self.release(v3)
        return result

    def call_function(self, info: FuncInfo, symbol: str, receiver: Ex, args: list[Node], line: int) -> Ex:
        if info.is_async:
            return self.call_info(info, symbol, receiver, args, line)
        # the arguments of a plain function are not directly under await or start, but what the call is part of may be: in
        # await pick().send(1) the call of send is
        outer_ok = self.async_ok
        self.async_ok = False
        r = self.call_info(info, symbol, receiver, args, line)
        self.async_ok = outer_ok
        return r

    def call_info(self, info: FuncInfo, symbol: str, receiver: Ex, args: list[Node], line: int) -> Ex:
        if info.is_async:
            if not self.async_ok:
                raise CompileError(f"'{info.name}' is async, so it must be awaited or started\nwrite: await {info.name}(...)   or   start {info.name}(...)", line)
            self.async_ok = False
            if info.owner == '':
                symbol = f'@tomato.async.{info.key}'
        if info.is_gen:
            raise CompileError(f"'{info.name}' is a generator (it uses yield), so it can only be used as what a for loop loops over\nwrite: for x in {info.name}(...):", line)
        # a function, or a method when `receiver` holds the object; the callee only borrows its arguments
        keywords = self.kw
        self.kw = []
        nfixed = len(info.ptypes) - info.stars
        required = nfixed - len(info.defaults)
        if len(args) > nfixed and not info.has_varargs:
            raise CompileError("'" + info.name + "' takes " + plural(nfixed, 'argument') + ', but ' + str(len(args)) + ' given', line)
        values: list[Ex] = []
        held_before = len(self.held)
        if receiver.ty != '':
            values.append(receiver)
            self.hold(receiver)               # the argument values below are held too, until the call itself (see check_error)
        slots: list[Ex] = []        # one per fixed parameter: its value, or an empty Ex until a keyword or a default fills it
        for pi in range(nfixed):
            slots.append(ex('', ''))
        extra: list[Ex] = []        # the positional values beyond the named parameters (for *args)
        k = 0
        v = ex('', '')
        around: list[Node] = [a0 for a0 in args]
        for kv0 in keywords:
            around.append(val_node(kv0.items[1]))
        for d0 in info.defaults:
            around.append(d0)
        for a in args:
            if k < nfixed:
                if not info.is_async and a.kind == 'Name' and a.fields[0].text in self.slots and self.types[a.fields[0].text] == info.ptypes[k]:
                    v = self.expr_b(a, around)          # the callee only borrows it, and so does the call
                else:
                    v = self.expr(a, info.ptypes[k])
                v = self.want(v, info.ptypes[k], line, 'argument ' + str(k + 1) + " of '" + info.name + "' (the parameter '" + info.pnames[k] + "')")
                slots[k] = v
                self.hold(v)
            else:
                v = self.expr(a, elem_of(info.ptypes[nfixed]))
                v = self.want(v, elem_of(info.ptypes[nfixed]), line, 'an extra argument of ' + info.name)
                extra.append(v)
                self.hold(v)
            k += 1
        extra_names: list[str] = []
        extra_values: list[Ex] = []
        at = 0
        for kv in keywords:
            kname = kv.items[0].text
            at = -1
            for pi in range(nfixed):
                if info.pnames[pi] == kname:
                    at = pi
            if at >= 0:
                if slots[at].ty != '':
                    raise CompileError(f"the argument '{kname}' of '{info.name}' is given twice", line)
                v = self.expr(val_node(kv.items[1]), info.ptypes[at])
                v = self.want(v, info.ptypes[at], line, "argument '" + kname + "' of '" + info.name + "'")
                slots[at] = v
                self.hold(v)
            elif info.has_kwargs:
                if kname in extra_names:
                    raise CompileError(f"the keyword argument '{kname}' is given twice", line)
                kt = dict_value(info.ptypes[-1])
                v = self.expr(val_node(kv.items[1]), kt)
                v = self.want(v, kt, line, 'keyword argument ' + kname + " of '" + info.name + "'")
                extra_names.append(kname)
                extra_values.append(v)
                self.hold(v)
            else:
                raise CompileError(f"'{info.name}' has no parameter named '{kname}'", line)
        for pi in range(nfixed):               # the caller supplies the defaults it left out (D19c)
            if slots[pi].ty == '':
                if pi < required:
                    raise CompileError(f"'{info.name}' needs a value for '{info.pnames[pi]}'", line)
                v = self.expr(info.defaults[pi - required], info.ptypes[pi])
                v = self.want(v, info.ptypes[pi], line, 'the default of argument ' + str(pi + 1) + " of '" + info.name + "'")
                slots[pi] = v
                self.hold(v)
            values.append(slots[pi])
        self.drop_held(held_before)
        if info.has_varargs:
            values.append(self.build_tuple(info.ptypes[nfixed], extra))
        if info.has_kwargs:
            values.append(self.build_kwargs(info.ptypes[-1], extra_names, extra_values))
        parts: list[str] = [f'{llvm_type(v2.ty)} {v2.reg}' for v2 in values]
        if symbol.startswith('@') and not info.is_async and has_small(self.mod, info):
            all_small = True
            for v0 in values:
                if v0.ty == 'int' and not v0.small and not small_text(v0.reg):
                    all_small = False
            if all_small:
                symbol += '.small'
        text = 'call ' + self.ret_llvm(info) + ' ' + symbol + '(' + ', '.join(parts) + ')'
        result = ex('', '')
        if info.is_async:
            fr = self.tmp('frame')
            self.emit(fr + ' = call ptr ' + symbol + '(' + ', '.join(parts) + ')')
            for v4 in values:
                self.release(v4)
            self.fresh_frame = True
            self.fresh_reg = fr
            return ex(fr, task_type_of(info))
        if info.ret == '':
            self.emit(text)
        else:
            r = self.tmp('call')
            self.emit(f'{r} = {text}')
            result = ret_ex(r, info.ret)
        self.check_error(values, symbol)
        for v3 in values:
            self.release(v3)
        return self.need_small(result)

    def build_tuple(self, t: str, items: list[Ex]) -> Ex:
        lst = self.tmp('varargs')
        self.emit(f'{lst} = call ptr @tomato_list_new(i64 {self.mod.code_of(t)})')
        for it0 in items:
            it = self.owned(it0)
            self.push_item(lst, t, it)
        return ex(lst, t)

    def build_kwargs(self, t: str, names: list[str], items: list[Ex]) -> Ex:
        d = self.tmp('kwargs')
        self.emit(f'{d} = call ptr @tomato_dict_new(i64 {self.mod.code_of(t)}, i64 8, i32 1)')
        for k, it0 in enumerate(items):
            it = self.owned(it0)
            key = ex(self.mod.intern(names[k]), 'str')
            slot = self.tmp('slot')
            self.emit(f'{slot} = call ptr @tomato_dict_insert(ptr {d}, i64 {self.key_word(key)}, i32 1)')
            self.emit(f'store {llvm_type(it.ty)} {it.reg}, ptr {slot}')
        return ex(d, t)

    def check_error(self, values: list[Ex], callee: str = ''):
        # an error raised by the callee is pending: drop the borrowed arguments and leave this function (D22a). callee is the
        # function that was called, when the call was direct: finish_bodies removes the test if that function cannot raise.
        ex1 = self.tmp('ex')
        self.emit(f'{ex1} = load ptr, ptr @tomato_exc')
        has = self.tmp('has')
        if callee.startswith('@'):
            self.emit(f'{has} = icmp ne ptr {ex1}, null ; {callee}')
        else:
            self.emit(f'{has} = icmp ne ptr {ex1}, null')
        bad = self.label('raised')
        fine = self.label('fine')
        self.cond_br(has, bad, fine)
        self.place(bad)
        self.trace(False)
        for v in values:
            self.release(v)
        self.release_held()
        self.br(self.unwind_target())
        self.place(fine)

    def construct(self, c: ClassInfo, args: list[Node], line: int) -> Ex:
        # Name(args): allocate, set the declared defaults, run @init (the constructor function does all three)
        ptypes: list[str] = []
        if c.init != '':
            ptypes = self.mod.find_method(c.name, c.init, line).ptypes
        defaults: list[Node] = []
        if c.init != '':
            defaults = self.mod.find_method(c.name, c.init, line).defaults
        required = len(ptypes) - len(defaults)
        if len(args) < required or len(args) > len(ptypes):
            raise CompileError("'" + c.name + "' takes " + plural(len(ptypes), 'argument') + ', but ' + str(len(args)) + ' given', line)
        values = self.args_with_defaults(args, ptypes, defaults, line, c.name)
        parts: list[str] = [f'{llvm_type(v.ty)} {v.reg}' for v in values]
        r = self.tmp('obj')
        symbol = '@tomato.new.' + str(self.mod.code_of('@' + c.name))
        self.emit(f'{r} = call ptr {symbol}(' + ', '.join(parts) + ')')
        self.check_error(values, symbol)
        for v in values:
            self.release(v)
        return ex(r, '@' + c.name)

    def method_symbol(self, obj: Ex, info: FuncInfo) -> str:
        # what to call for the method info of obj: the method itself when no class below the static one overrides it (the call is
        # then direct, so it can be inlined), else the function a virtual lookup finds
        if is_class(obj.ty) and self.mod.late and not self.mod.overridden(obj.ty[1:], info.name):
            return function_symbol(self.mod, info)
        return self.dispatch(obj, info.name)

    def dispatch(self, obj: Ex, name: str) -> str:
        # a virtual lookup: the object's type code picks a method table, the method name picks the slot
        tp = self.tmp('tp')
        self.emit(f'{tp} = getelementptr {{ i64, i64 }}, ptr {obj.reg}, i32 0, i32 1')
        raw = self.tmp('rawcode')
        self.emit(f'{raw} = load i64, ptr {tp}')
        code = self.tmp('code')
        self.emit(f'{code} = and i64 {raw}, 4294967295')
        vts = self.tmp('vts')
        self.emit(f'{vts} = getelementptr ptr, ptr @tomato_vtables, i64 {code}')
        vt = self.tmp('vt')
        self.emit(f'{vt} = load ptr, ptr {vts}')
        fp = self.tmp('fp')
        self.emit(f'{fp} = getelementptr ptr, ptr {vt}, i64 {self.mod.slot_of(name)}')
        f = self.tmp('f')
        self.emit(f'{f} = load ptr, ptr {fp}')
        return f

    def qualified_call(self, n: Node, f: Node, cls: str) -> Ex:
        # Class.method(self, args): the parent's version of a method, called on an object we already have (D12ao)
        info = self.mod.find_method(cls, f.fields[1].text, n.line)
        if info.is_private and self.owner != info.owner:
            raise CompileError(f"the method '{info.name}' is private to class '{info.owner}'\nonly its own methods can call it", n.line)
        args = val_nodes(n.fields[1])
        if info.op == 'static':
            # a method marked @static is called on the class itself (bitarray.from_hex('A2')): it runs on a fresh object made by the class's @init with no arguments
            made = mk('Call', n.line, [vn(val_node(f.fields[0])), vnodes([]), vlist([])])
            kw = self.kw
            self.kw = []
            fresh = self.expr(made)
            self.kw = kw
            return self.call_function(info, function_symbol(self.mod, info), fresh, args, n.line)
        if len(args) == 0:
            raise CompileError(f"'{cls}.{info.name}' needs an object as its first argument", n.line)
        obj = self.expr(args[0])
        if not self.mod.subclass(obj.ty, '@' + cls):
            raise CompileError(f"the first argument must be a '{cls}' object", n.line)
        return self.call_function(info, function_symbol(self.mod, info), obj, args[1:], n.line)

    def method_call(self, n: Node, f: Node) -> Ex:
        name = f.fields[1].text
        args = val_nodes(n.fields[1])
        recv = val_node(f.fields[0])
        if recv.kind == 'Name' and recv.fields[0].text in self.slots and self.borrowable_receiver(self.types[recv.fields[0].text], name):
            obj = self.unwrap(self.expr_b(recv, args), n.line)
        else:
            obj = self.unwrap(self.expr(recv), n.line)
        return self.method_on(obj, n, name, args)

    def method_on(self, obj: Ex, n: Node, name: str, args: list[Node]) -> Ex:
        if obj.ty.startswith('tuple[') and name in ['append', 'pop', 'insert', 'extend', 'sort', 'reverse']:
            raise CompileError(f"a tuple cannot be changed, so it has no '{name}'\nuse a list if the items must change", n.line)
        if is_list(obj.ty) and name == 'append':
            if len(args) != 1:
                raise CompileError(f'append() takes 1 argument, but {len(args)} given', n.line)
            held_before = len(self.held)
            self.hold(obj)
            v = self.expr(args[0], elem_of(obj.ty))
            v = self.want(v, elem_of(obj.ty), n.line, 'the appended item')
            self.drop_held(held_before)
            v = self.owned(v)
            self.push_item(obj.reg, obj.ty, v)
            self.release(obj)
            return ex('', '')
        if is_list(obj.ty) and obj.ty.startswith('list[') and name in ['pop', 'insert', 'extend', 'sort', 'reverse']:
            return self.list_method(obj, name, args, n.fields[2].items, n.line)
        if is_task(obj.ty):
            return self.task_method(obj, name, args, n.line)
        if is_set(obj.ty):
            return self.set_method(obj, name, args, n.line)
        if is_dict(obj.ty):
            return self.dict_method(obj, name, args, n.line)
        if obj.ty == 'str':
            if name in text_helper_methods():
                self.kw = n.fields[2].items
                return self.helper_call('_str_' + name, name, obj, args, n.line)
            return self.text_method(obj, name, args, n.line)
        if obj.ty == 'File':
            return self.file_method(obj, name, args, n.line)
        if is_iface(obj.ty):
            req = self.mod.requirement(obj.ty[1:], name)
            if req is None:
                raise CompileError("the interface '" + obj.ty[1:] + "' has no method '" + name + "'", n.line)
            return self.call_function(req, self.dispatch(obj, name), obj, args, n.line)
        if is_class(obj.ty) and field_position(self.mod.find_class(obj.ty[1:], n.line), name) >= 0 and is_fn(self.field_type(obj, name, n.line)):
            fvt = self.field_type(obj, name, n.line)
            fv = self.tmp('fv')
            self.emit(f'{fv} = load ptr, ptr {self.field_addr(obj, name, n.line)}')
            self.release(obj)
            return self.call_value(ex(fv, fvt), args, n.line, "the function value '" + name + "'")
        if is_class(obj.ty):
            info = self.mod.find_method(obj.ty[1:], name, n.line)
            if info.is_private and self.owner != info.owner:
                raise CompileError(f"the method '{name}' is private to class '{info.owner}'\nonly its own methods can call it", n.line)
            return self.call_function(info, self.method_symbol(obj, info), obj, args, n.line)
        raise CompileError(self.no_method(name, obj.ty), n.line)

    def list_len(self, lst: Ex) -> str:
        lenp = self.tmp('lenp')
        self.emit(f'{lenp} = getelementptr {{ i64, i64, i64, i64, ptr }}, ptr {lst.reg}, i32 0, i32 2')
        ln = self.tmp('len')
        self.emit(f'{ln} = load i64, ptr {lenp}')
        return ln

    def list_method(self, obj: Ex, name: str, args: list[Node], keywords: list[Val], line: int) -> Ex:
        # pop, insert, extend, sort and reverse change the list in place; items move without copying (the width is that of the list's storage)
        elem = elem_of(obj.ty)
        w = item_width(obj.ty)
        if len(keywords) > 0 and name != 'sort':
            raise CompileError(f"{name}() does not take keyword arguments", line)
        if name == 'pop':
            if len(args) > 1:
                raise CompileError('pop() takes at most 1 argument: pop() or pop(index)', line)
            idx = ''
            if len(args) == 1:
                li = self.want(self.expr(args[0]), 'int', line, 'the index given to pop()')
                idx = self.int_raw(li, [obj])
            empty = self.tmp('empty')
            self.emit(f'{empty} = icmp eq i64 {self.list_len(obj)}, 0')
            self.fail_if(empty, 'pop from an empty list', [obj])
            if len(args) == 0:
                idx = self.tmp('last')
                self.emit(f'{idx} = sub i64 {self.list_len(obj)}, 1')
            else:
                idx = self.norm_index(obj, idx)
            addr = self.list_slot(obj, ex(idx, 'int'), [obj])
            item = self.load_item(obj.ty, addr, 'popped')
            self.emit(f'call void @tomato_list_remove_at(ptr {obj.reg}, i64 {idx}, i64 {w})')
            self.release(obj)
            return ret_ex(item, elem)
        if name == 'insert':
            if len(args) != 2:
                raise CompileError('insert() takes an index and an item: insert(index, item)', line)
            li = self.want(self.expr(args[0]), 'int', line, 'the index given to insert()')
            raw = self.int_raw(li, [obj])
            held_before = len(self.held)
            self.hold(obj)
            v = self.expr(args[1], elem)
            v = self.want(v, elem, line, 'the inserted item')
            self.drop_held(held_before)
            v = self.owned(v)
            # 0 up to the length is allowed (a negative index counts from the end); anything else is out of range
            idx = self.norm_index(obj, raw)
            bad = self.tmp('oob')
            self.emit(f'{bad} = icmp ugt i64 {idx}, {self.list_len(obj)}')
            self.fail_if(bad, 'index out of range', [v, obj])
            slot = self.tmp('slot')
            self.emit(f'{slot} = call ptr @tomato_list_insert_slot(ptr {obj.reg}, i64 {idx}, i64 {w})')
            self.store_item(obj.ty, v, slot)
            self.release(obj)
            return ex('', '')
        if name == 'extend':
            if len(args) != 1:
                raise CompileError('extend() takes one list: extend(other)', line)
            other = self.unwrap(self.expr(args[0], obj.ty), line)
            if other.ty != obj.ty:
                raise CompileError(f'extend() needs a list of the same type, {shown(obj.ty)}, but this is {shown(other.ty)}', line)
            self.emit(f'call void @tomato_list_extend(ptr {obj.reg}, ptr {other.reg}, i32 {list_flags(obj.ty)})')
            self.release(other)
            self.release(obj)
            return ex('', '')
        if name == 'reverse':
            if len(args) > 0:
                raise CompileError('reverse() takes no arguments', line)
            self.emit(f'call void @tomato_list_reverse(ptr {obj.reg}, i64 {w})')
            self.release(obj)
            return ex('', '')
        # sort: a sorted copy is made (as sorted() does) and its contents are swapped into the list
        if len(args) > 0:
            raise CompileError('sort() takes no positional arguments, only key= or cmp=', line)
        if len(keywords) > 1:
            raise CompileError('sort() takes key= or cmp=, not both', line)
        if not obj.reg.startswith('%bl.') and is_rc(obj.ty):
            self.emit(f'call void @tomato_retain(ptr {obj.reg})')       # the sorting code uses up its list; this one is kept
        copy = ex('', '')
        if len(keywords) == 1:
            kname = keywords[0].items[0].text
            if kname != 'key' and kname != 'cmp':
                raise CompileError(f"sort() has no parameter named '{kname}'\nit takes key= (a function giving what to sort by) or cmp= (a function comparing two items)", line)
            copy = self.sorted_keyed(obj, keywords, line)
        else:
            if not (elem == 'int' or elem == 'float' or elem == 'str'):
                raise CompileError(f'sort() needs a list of numbers or text, but this is {shown(obj.ty)}\nuse sort(key=...) or sort(cmp=...) for other items', line)
            kind = '0' if elem == 'int' else ('1' if elem == 'float' else '2')
            r = self.tmp('sorted')
            self.emit(f'{r} = call ptr @tomato_list_sorted(ptr {obj.reg}, i32 {kind})')
            copy = ex(r, obj.ty)
        self.emit(f'call void @tomato_list_swap(ptr {obj.reg}, ptr {copy.reg})')
        self.release(copy)
        self.release(obj)
        return ex('', '')

    def borrowable_receiver(self, ty: str, name: str) -> bool:
        # receivers whose method code only looks at them and releases them at the end: lists, sets, dicts, objects and interfaces
        t = strip_optional(ty)
        return is_list(t) or is_set(t) or is_dict(t) or is_class(t) or is_iface(t)

    def task_method(self, t: Ex, name: str, args: list[Node], line: int) -> Ex:
        # t.done() says whether the task has finished (in any way) and t.cancel() asks it to stop (D58d); neither waits
        if len(args) > 0:
            raise CompileError(f'a task method takes no arguments: t.{name}()', line)
        if name == 'cancel':
            self.emit(f'call void @tomato_task_cancel(ptr {t.reg})')
            self.release(t)
            return ex('', '')
        if name == 'done':
            st = self.tmp('status')
            self.emit(st + ' = load i64, ptr ' + self.frame_field(t.reg, 2, 'u64'))
            fin = self.tmp('finished')
            self.emit(f'{fin} = icmp ne i64 {st}, 0')
            w = self.tmp('flag')
            self.emit(f'{w} = zext i1 {fin} to i64')
            self.release(t)
            return ex(w, 'bool')
        raise CompileError(f"a task has no method '{name}'\nthe methods are done() and cancel()", line)

    def dict_method(self, d: Ex, name: str, args: list[Node], line: int) -> Ex:
        vt = dict_value(d.ty)
        if name == 'get':
            if len(args) != 1 and len(args) != 2:
                raise CompileError("get() takes a key and optionally a default value: get(key) or get(key, default)", line)
            if len(args) == 1 and not (vt == 'str' or is_list(vt) or is_dict(vt) or is_set(vt) or is_class(vt) or is_iface(vt)):
                raise CompileError(f"get(key) gives None for a missing key, but a value of type {shown(vt)} cannot be None\nwrite get(key, default), or check 'key in d' first", line)
            held_before = len(self.held)
            self.hold(d)                        # freed by the error path if the key or the default raises
            k = self.want(self.expr(args[0]), 'str', line, 'a dict key')
            self.hold(k)
            fallback = ex('', '')
            if len(args) == 2:
                fallback = self.owned(self.want(self.expr(args[1], vt), vt, line, 'the default of get'))
            self.drop_held(held_before)
            if len(args) == 1:
                slot1 = self.tmp('slot')
                self.emit(f'{slot1} = call ptr @tomato_dict_find(ptr {d.reg}, i64 {self.key_word(k)})')
                gone = self.tmp('missing')
                self.emit(f'{gone} = icmp eq ptr {slot1}, null')
                hit1 = self.label('gothit')
                miss1 = self.label('gotmiss')
                join1 = self.label('gotjoin')
                self.cond_br(gone, miss1, hit1)
                self.place(hit1)
                found1 = self.tmp('val')
                self.emit(f'{found1} = load ptr, ptr {slot1}')
                self.retain(ex(found1, vt))
                self.br(join1)
                self.place(miss1)
                self.br(join1)
                self.place(join1)
                r1 = self.tmp('got')
                self.emit(f'{r1} = phi ptr [{found1}, %{hit1}], [null, %{miss1}]')
                self.release(k)
                self.release(d)
                return ret_ex(r1, vt + '?')
            slot = self.tmp('slot')
            self.emit(f'{slot} = call ptr @tomato_dict_find(ptr {d.reg}, i64 {self.key_word(k)})')
            missing = self.tmp('missing')
            self.emit(f'{missing} = icmp eq ptr {slot}, null')
            hit = self.label('gothit')
            miss = self.label('gotmiss')
            join = self.label('gotjoin')
            self.cond_br(missing, miss, hit)
            self.place(hit)
            found = self.tmp('val')
            self.emit(f'{found} = load {llvm_type(vt)}, ptr {slot}')
            got = ex(found, vt)
            self.retain(got)
            self.release(fallback)
            self.br(join)
            self.place(miss)
            self.br(join)
            self.place(join)
            r = self.tmp('got')
            self.emit(f'{r} = phi {llvm_type(vt)} [{got.reg}, %{hit}], [{fallback.reg}, %{miss}]')
            self.release(k)
            self.release(d)
            return ret_ex(r, vt)
        if name == 'remove':
            # d.remove(key) takes an entry out, releasing its value; the key must be there (check with 'key in d')
            if len(args) != 1:
                raise CompileError('remove() takes a key: remove(key)', line)
            held_before = len(self.held)
            self.hold(d)
            k = self.want(self.expr(args[0]), 'str', line, 'a dict key')
            self.drop_held(held_before)
            kw = self.key_word(k)
            slot = self.tmp('slot')
            self.emit(f'{slot} = call ptr @tomato_dict_find(ptr {d.reg}, i64 {kw})')
            missing = self.tmp('missing')
            self.emit(f'{missing} = icmp eq ptr {slot}, null')
            self.fail_if(missing, 'the key is not in the dict', [k, d])
            old = self.tmp('old')
            self.emit(f'{old} = load {llvm_type(vt)}, ptr {slot}')
            self.emit(f'call i32 @tomato_dict_delete(ptr {d.reg}, i64 {kw})')
            self.release(exf(old, vt))       # last: it can start a collection, which must not find the value in the dict
            self.release(k)
            self.release(d)
            return ex('', '')
        if name not in ['keys', 'values', 'items']:
            raise CompileError(self.no_method(name, d.ty), line)
        if len(args) != 0:
            raise CompileError(f"'{name}' takes no arguments", line)
        if name == 'keys':
            r = self.tmp('keys')
            self.emit(r + ' = call ptr @tomato_dict_keys(ptr ' + d.reg + ', i64 ' + str(self.mod.code_of('list[str]')) + ', i64 8)')
            self.release(d)
            return ex(r, 'list[str]')
        if name == 'values':
            t = f'list[{vt}]'
            r = self.tmp('values')
            self.emit(f'{r} = call ptr @tomato_dict_values(ptr {d.reg}, i64 {self.mod.code_of(t)}, i64 {item_width(t)}, i32 {elem_rc(vt)})')
            self.release(d)
            return ex(r, t)
        if name == 'items':
            # each pair is a tuple of two item types, tuple[str, V], made by the runtime
            pt = mtuple_type(['str', vt])
            t = f'list[{pt}]'
            r = self.tmp('items')
            self.emit(f'{r} = call ptr @tomato_dict_pairs(ptr {d.reg}, i64 {self.mod.code_of(t)}, i64 {self.mod.code_of(pt)}, i32 {elem_rc(vt)})')
            self.release(d)
            return ex(r, t)
        raise CompileError(self.no_method(name, d.ty), line)

    def set_method(self, st: Ex, name: str, args: list[Node], line: int) -> Ex:
        if (name == 'add' or name == 'remove' or name == 'discard') and len(args) == 1:
            held_before = len(self.held)
            self.hold(st)
            v = self.expr(args[0], set_elem(st.ty))
            v = self.want(v, set_elem(st.ty), line, 'the set element')
            self.drop_held(held_before)
            kw = self.key_word(v)
            if name == 'add':
                self.emit(f'call ptr @tomato_dict_insert(ptr {st.reg}, i64 {kw}, i32 0)')
            elif name == 'discard':
                self.emit(f'call i32 @tomato_dict_delete(ptr {st.reg}, i64 {kw})')
            else:
                slot = self.tmp('slot')
                self.emit(f'{slot} = call ptr @tomato_dict_find(ptr {st.reg}, i64 {kw})')
                missing = self.tmp('missing')
                self.emit(f'{missing} = icmp eq ptr {slot}, null')
                self.fail_if(missing, 'the element is not there', [v, st])
                self.emit(f'call i32 @tomato_dict_delete(ptr {st.reg}, i64 {kw})')
            self.release(v)
            self.release(st)
            return ex('', '')
        raise CompileError(self.no_method(name, 'set'), line)

    # the text arguments of a method of the text obj; while each is evaluated, obj and the ones before it are freed by
    # the error path if it raises
    def text_args(self, obj: Ex, name: str, args: list[Node], count: int, line: int) -> list[Ex]:
        if len(args) != count:
            raise CompileError("'" + name + "' takes " + plural(count, 'argument') + ', but ' + str(len(args)) + ' given', line)
        held_before = len(self.held)
        self.hold(obj)
        out: list[Ex] = []
        for a in args:
            v = self.expr(a)
            v = self.want(v, 'str', line, 'the argument of ' + name)
            out.append(v)
            self.hold(v)
        self.drop_held(held_before)
        return out

    def not_empty(self, v: Ex, name: str, live: list[Ex]):
        n = self.tmp('alen')
        self.emit(f'{n} = call i64 @tomato_str_len(ptr {v.reg})')
        bad = self.tmp('empty')
        self.emit(f'{bad} = icmp eq i64 {n}, 0')
        self.fail_if(bad, 'an empty text cannot be used to ' + name, live)

    # an argument of a method of the text obj, evaluated while obj and the values in `also` are freed by the error path
    # if it raises
    def text_method_arg(self, obj: Ex, also: list[Ex], a: Node, ty: str, line: int, what: str) -> Ex:
        held_before = len(self.held)
        self.hold(obj)
        for e in also:
            self.hold(e)
        v = self.want(self.expr(a), ty, line, what)
        self.drop_held(held_before)
        return v

    def builtin_call(self, name: str, values: list[Ex], line: int) -> Ex:
        # a call to a function written in the built-ins (std/builtin/), with arguments that are already computed
        return self.call_helper(self.mod.find(self.mod.resolve(name), line), values)

    def text_method(self, obj: Ex, name: str, args: list[Node], line: int) -> Ex:
        if (name == 'find' or name == 'rfind' or name == 'count') and (len(args) == 2 or len(args) == 3):
            # find(sub, start), find(sub, start, end), and the same for rfind and count
            a = self.text_args(obj, name, args[:1], 1, line)
            start = self.text_method_arg(obj, a, args[1], 'int', line, 'the start of ' + name)
            stop = '4611686018427387903'
            if len(args) == 3:
                end = self.text_method_arg(obj, [a[0], start], args[2], 'int', line, 'the end of ' + name)
                stop = self.int_raw(end, [obj, a[0], start])
            mode = '0'
            if name == 'rfind':
                mode = '1'
            elif name == 'count':
                mode = '2'
            r = self.tmp('found')
            self.emit(f'{r} = call i64 @tomato_str_search(ptr {obj.reg}, ptr {a[0].reg}, i64 {self.int_raw(start, [obj, a[0]])}, i64 {stop}, i32 {mode})')
            self.release(a[0])
            self.release(obj)
            return self.tag_small(r)
        if name == 'find' or name == 'rfind' or name == 'count' or name == 'startswith' or name == 'endswith':
            a = self.text_args(obj, name, args, 1, line)
            if name == 'find' or name == 'rfind' or name == 'count':
                r = self.tmp('found')
                self.emit(f'{r} = call i64 @tomato_str_{name}(ptr {obj.reg}, ptr {a[0].reg})')
                self.release(a[0])
                self.release(obj)
                return self.tag_small(r)
            c = self.tmp('c')
            self.emit(f'{c} = call i32 @tomato_str_{name}(ptr {obj.reg}, ptr {a[0].reg})')
            i1 = self.tmp('flag')
            self.emit(f'{i1} = icmp ne i32 {c}, 0')
            self.release(a[0])
            self.release(obj)
            return self.bool_of(i1)
        if name == 'replace':
            a = self.text_args(obj, name, args, 2, line)
            self.not_empty(a[0], 'replace', [obj, a[0], a[1]])
            r = self.tmp('replaced')
            self.emit(f'{r} = call ptr @tomato_str_replace(ptr {obj.reg}, ptr {a[0].reg}, ptr {a[1].reg})')
            self.release(a[0])
            self.release(a[1])
            self.release(obj)
            return ex(r, 'str')
        if name == 'split':
            a = self.text_args(obj, name, args, 1, line)
            self.not_empty(a[0], 'split', [obj, a[0]])
            r = self.tmp('pieces')
            self.emit(r + ' = call ptr @tomato_str_split(ptr ' + obj.reg + ', ptr ' + a[0].reg + ', i64 ' + str(self.mod.code_of('list[str]')) + ', i64 8)')
            self.release(a[0])
            self.release(obj)
            return ex(r, 'list[str]')
        if name == 'join':
            if len(args) != 1:
                raise CompileError("join() takes exactly one list[str]", line)
            lst = self.text_method_arg(obj, [], args[0], 'list[str]', line, 'the argument of join')
            r = self.tmp('joined')
            self.emit(f'{r} = call ptr @tomato_str_join(ptr {obj.reg}, ptr {lst.reg})')
            self.release(lst)
            self.release(obj)
            return ex(r, 'str')
        if (name == 'upper' or name == 'lower' or name == 'strip') and len(args) == 0:
            r = self.tmp('changed')
            self.emit(f'{r} = call ptr @tomato_str_{name}(ptr {obj.reg})')
            self.release(obj)
            return ex(r, 'str')
        if name in ['strip', 'lstrip', 'rstrip'] and len(args) == 1:
            chars = self.text_method_arg(obj, [], args[0], 'str', line, 'the characters to strip')
            return self.builtin_call(f'_str_{name}_chars', [obj, chars], line)
        if (name == 'isalpha' or name == 'isdigit') and len(args) == 0:
            # Unicode letters and digits, from the runtime's tables (tools/gen_ctype_table.c)
            c = self.tmp('c')
            self.emit(f'{c} = call i32 @tomato_str_{name}(ptr {obj.reg})')
            i1 = self.tmp('flag')
            self.emit(f'{i1} = icmp ne i32 {c}, 0')
            self.release(obj)
            return self.bool_of(i1)
        if name in ['isspace', 'lstrip', 'rstrip'] and len(args) == 0:
            # written in Tomato, in the built-ins (std/builtin/)
            return self.builtin_call(f'_str_{name}', [obj], line)
        raise CompileError(self.no_method(name, 'str'), line)

    def file_method(self, f: Ex, name: str, args: list[Node], line: int) -> Ex:
        if name == 'read' and len(args) == 0:
            r = self.tmp('text')
            self.emit(f'{r} = call ptr @tomato_file_read(ptr {f.reg})')
            return ex(r, 'str')
        if name == 'write' and len(args) == 1:
            v = self.expr(args[0])
            v = self.want(v, 'str', line, 'the argument of write')
            self.emit(f'call void @tomato_file_write(ptr {f.reg}, ptr {v.reg})')
            self.release(v)
            return ex('', '')
        if name == 'close' and len(args) == 0:
            self.emit(f'call void @tomato_file_close(ptr {f.reg})')
            return ex('', '')
        raise CompileError(self.no_method(name, 'File'), line)

    def open_call(self, args: list[Node], line: int) -> Ex:
        if len(args) < 1 or len(args) > 2:
            raise CompileError('open() takes a path, and optionally a mode, both as text: open(path) or open(path, mode)', line)
        path = self.expr(args[0])
        path = self.want(path, 'str', line, 'the path')
        mode = ex(self.mod.intern('r'), 'str')
        if len(args) == 2:
            held_before = len(self.held)
            self.hold(path)
            mode = self.expr(args[1])
            mode = self.want(mode, 'str', line, 'the mode')
            self.drop_held(held_before)
        r = self.tmp('file')
        self.emit(f'{r} = call ptr @tomato_file_open(ptr {path.reg}, ptr {mode.reg})')
        bad = self.tmp('nofile')
        self.emit(f'{bad} = icmp eq ptr {r}, null')
        # Caught errors retain the path and reason in both debug and release modes.
        stop = self.label('stop')
        ok = self.label('ok')
        self.cond_br(bad, stop, ok)
        self.place(stop)
        text = self.tmp('why')
        self.emit(f'{text} = call ptr @tomato_open_error(ptr {path.reg})')
        self.release(path)
        self.release(mode)
        self.raise_here('IOError', text, True, 'E25')
        self.place(ok)
        self.release(path)
        self.release(mode)
        return ex(r, 'File')

    def input_call(self, args: list[Node], line: int) -> Ex:
        raise CompileError("input() is async, so it must be awaited\nwrite: await input(prompt)  inside an async def", line)

    # ---- async: an async function runs as a frame (see FRAME_FIXED); await and yield are the places it can stop and go on later
    def frame_field(self, h: str, k: int, ty: str) -> str:
        # the address of fixed field k of the frame h. Every frame starts with the same fields, so this names them with a type of their own:
        # the object header, seven whole numbers, three pointers, then the result (the sizes of pointers differ between native and browser code).
        res = llvm_type(ty) if k == 12 and ty != '' else 'i64'
        p = self.tmp('ff')
        self.emit(f'{p} = getelementptr {{ i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, ptr, ptr, ptr, {res} }}, ptr {h}, i32 0, i32 {str(k + 2)}')
        return p

    def suspend_here(self, cancellable: bool = True):
        # stop this function; it goes on from the next line when something runs the frame again
        self.awaits += 1
        k = self.awaits
        self.emit(f'store i64 {k}, ptr %state.p')
        self.br('suspend')
        self.place(f'rs.{k}')
        if cancellable:
            self.check_cancel()

    def check_cancel(self):
        # a task cancelled with t.cancel() raises CancelledError here, at its next wait (D58d)
        c = self.tmp('cancel')
        self.emit(f'{c} = call i32 @tomato_task_cancelled(ptr %frame)')
        bad = self.tmp('wascancelled')
        self.emit(f'{bad} = icmp ne i32 {c}, 0')
        self.fail_with(bad, 'CancelledError', 'the task was cancelled')

    def need_async(self, what: str, line: int):
        if not self.is_async:
            raise CompileError(f"'{what}' can only be used inside an async function\nwrite async def instead of def", line)

    def check_unread(self):
        # raise here the error of a task this one started that failed and was dropped without being awaited (D58a)
        e = self.tmp('unread')
        self.emit(f'{e} = call ptr @tomato_pending_pop(ptr %frame, ptr @tomato_exc_line, ptr @tomato_exc_rt)')
        has = self.tmp('hasunread')
        self.emit(f'{has} = icmp ne ptr {e}, null')
        bad = self.label('unreaderror')
        ok = self.label('nounread')
        self.cond_br(has, bad, ok)
        self.place(bad)
        self.emit(f'store ptr {e}, ptr @tomato_exc')
        self.emit('store i32 1, ptr @tomato_exc_seen')
        self.br(self.unwind_target())
        self.place(ok)

    def await_handle(self, holder: str, result: str, inline: bool) -> Ex:
        # the task in the slot `holder` (owned): wait until it is done, then take its result, or raise its error. When only this
        # task waits on it (await f(...)), a cancel reaches that call itself (D76b); one that comes after it finished must not
        # throw its result away, so it is raised at the next wait instead
        chk = self.label('awaiting')
        wait = self.label('mustwait')
        take = self.label('finished')
        bad = self.label('taskfailed')
        good = self.label('taskdone')
        self.br(chk)
        self.place(chk)
        if not inline:
            self.check_unread()
        h = self.tmp('task')
        self.emit(f'{h} = load ptr, ptr {holder}')
        st = self.tmp('status')
        self.emit(st + ' = load i64, ptr ' + self.frame_field(h, 2, 'u64'))
        done = self.tmp('isdone')
        self.emit(f'{done} = icmp ne i64 {st}, 0')
        self.cond_br(done, take, wait)
        self.place(wait)
        self.emit(f'call void @tomato_task_wait(ptr {h}, ptr %frame)')
        self.suspend_here(not inline)
        self.br(chk)
        self.place(take)
        failed = self.tmp('failed')
        self.emit(f'{failed} = icmp eq i64 {st}, 2')
        self.cond_br(failed, bad, good)
        self.place(bad)
        self.emit(f'call void @tomato.task.raise(ptr {h})')
        self.emit(f'store ptr null, ptr {holder}')       # first: the release can start a collection, which follows the slot
        self.emit(f'call void @tomato_release(ptr {h})')
        self.br(self.unwind_target())
        self.place(good)
        out = ex('', '')
        if result != '' and result != 'None':
            # the task keeps its result, since it can be awaited again (D51b): the awaiting code gets its own reference
            # (or its own copy of a big number)
            rp = self.frame_field(h, 12, result)
            r = self.tmp('result')
            self.emit(f'{r} = load {llvm_type(result)}, ptr {rp}')
            out = ex(r, result)
            self.retain(out)
        self.emit(f'store ptr null, ptr {holder}')       # first: the release can start a collection, which follows the slot
        self.emit(f'call void @tomato_release(ptr {h})')
        return out

    def await_expr(self, n: Node) -> Ex:
        self.need_async('await', n.line)
        inner = val_node(n.fields[0])
        if inner.kind == 'Call' and val_node(inner.fields[0]).kind == 'Name':
            name = val_node(inner.fields[0]).fields[0].text
            if name == 'input' and name not in self.slots and self.mod.resolve(name) == '':
                return self.await_input(val_nodes(inner.fields[1]), n.line)
            if name == 'sleep' and name not in self.slots and self.mod.resolve(name) == '':
                return self.await_sleep(val_nodes(inner.fields[1]), n.line)
            if name == '_http_wait' and name not in self.slots and self.mod.resolve(name) == '':
                return self.await_http(val_nodes(inner.fields[1]), n.line)
            if name == '_settle' and name not in self.slots and self.mod.resolve(name) == '':
                return self.await_settle(val_nodes(inner.fields[1]), n.line)
            if name == '_fd_wait' and name not in self.slots and self.mod.resolve(name) == '':
                return self.await_fd(val_nodes(inner.fields[1]), n.line)
            if name == '_park' and name not in self.slots and self.mod.resolve(name) == '':
                return self.await_park(val_nodes(inner.fields[1]), n.line)
        # an error waiting for this task (D58a) is raised before the call is made: raised later it would throw away what the call
        # did, or leave it running with nobody to wait for it
        self.check_unread()
        self.async_ok = True
        self.fresh_frame = False
        t = self.expr(inner)
        self.async_ok = False
        if not is_task(t.ty):
            raise CompileError(f'only a task can be awaited, but this is {shown(t.ty)}\nawait an async function call such as await work(), or a task made with start', n.line)
        fresh = self.fresh_frame and t.reg == self.fresh_reg
        hidden = self.fresh_frame and not fresh      # the new task came through something else: await [f()][0]
        self.fresh_frame = False
        holder = self.hidden_rc_slot('await.task')
        self.store_owned(holder, t)
        if fresh:
            h0 = self.tmp('child')
            self.emit(f'{h0} = load ptr, ptr {holder}')
            self.emit(f'call void @tomato_task_inline(ptr {h0})')         # only this task waits on it: a cancel reaches into it
            self.emit('call void @tomato.sched.step(ptr ' + h0 + ')')      # a child runs at once, up to its first stop
        if hidden:
            h1 = self.tmp('child')
            self.emit(f'{h1} = load ptr, ptr {holder}')
            un = self.tmp('unstarted')
            self.emit(f'{un} = call i32 @tomato_task_unstarted(ptr {h1})')
            isun = self.tmp('isunstarted')
            self.emit(f'{isun} = icmp ne i32 {un}, 0')
            run = self.label('runchild')
            on = self.label('childruns')
            self.cond_br(isun, run, on)
            self.place(run)
            self.emit('call void @tomato.sched.step(ptr ' + h1 + ')')
            self.br(on)
            self.place(on)
        return self.await_handle(holder, task_result(t.ty), fresh)

    def await_sleep(self, args: list[Node], line: int) -> Ex:
        # await sleep(seconds): wait that long (D58c); other tasks run meanwhile
        if len(args) != 1:
            raise CompileError('sleep() takes the number of seconds to wait: await sleep(1.5)', line)
        v = self.expr(args[0])
        if not (v.ty == 'float' or is_numeric(v.ty)):
            raise CompileError(f'sleep() takes a number of seconds, but this is {shown(v.ty)}', line)
        secs = v.reg
        if v.ty != 'float':
            secs = self.to_double(v)
        self.check_unread()
        self.emit(f'call void @tomato_sleep_wait(ptr %frame, double {secs})')
        self.release(v)
        self.suspend_here()
        return ex('', '')

    def await_http(self, args: list[Node], line: int) -> Ex:
        # await _http_wait(handle): the library std/requests uses this to wait for a request; other tasks run meanwhile
        if len(args) != 1:
            raise CompileError('_http_wait() takes the request handle: await _http_wait(handle)', line)
        v = self.expr(args[0])
        v = self.want(v, 'int', line, 'the request handle')
        raw = self.int_raw(v)
        self.check_unread()
        self.emit(f'call void @tomato_http_wait(ptr %frame, i64 {raw})')
        self.release(v)
        self.suspend_here()
        return ex('', '')

    # Three waits for std/asyncio, which builds gather, wait_for and Queue on them (they are not meant for programs):
    #   await _settle(t)       waits until the task t has finished, in any way, without taking its result or its error, so an
    #                          error raised here is this task's own (it was cancelled); `await t` afterwards does not wait
    #   await _park(waiters)   puts this task at the end of the list waiters (a list[task[None]]) and stops it until another task
    #                          gives it to _unpark; a cancelled task raises and is still in the list
    #   _unpark(t)             makes the parked task t ready again; False (and nothing happens) when t is not parked
    def await_settle(self, args: list[Node], line: int) -> Ex:
        if len(args) != 1:
            raise CompileError('_settle() takes one task: await _settle(t)', line)
        t = self.expr(args[0])
        if not is_task(t.ty):
            raise CompileError(f'_settle() takes a task, but this is {shown(t.ty)}', line)
        holder = self.hidden_rc_slot('settle.task')
        self.store_owned(holder, t)
        chk = self.label('settling')
        wait = self.label('settlewait')
        end = self.label('settled')
        self.br(chk)
        self.place(chk)
        self.check_unread()
        h = self.tmp('task')
        self.emit(f'{h} = load ptr, ptr {holder}')
        st = self.tmp('status')
        self.emit(st + ' = load i64, ptr ' + self.frame_field(h, 2, 'u64'))
        done = self.tmp('isdone')
        self.emit(f'{done} = icmp ne i64 {st}, 0')
        self.cond_br(done, end, wait)
        self.place(wait)
        self.emit(f'call void @tomato_task_wait(ptr {h}, ptr %frame)')
        self.suspend_here()
        self.br(chk)
        self.place(end)
        self.emit(f'store ptr null, ptr {holder}')       # first: the release can start a collection, which follows the slot
        self.emit(f'call void @tomato_release(ptr {h})')
        return ex('', '')

    def await_park(self, args: list[Node], line: int) -> Ex:
        if len(args) != 1:
            raise CompileError('_park() takes the list of parked tasks: await _park(waiters)', line)
        self.check_unread()                   # first, so an error raised here leaves nothing to release
        v = self.expr(args[0])
        if v.ty != 'list[task[None]]':
            raise CompileError(f'_park() takes a list[task[None]], but this is {shown(v.ty)}', line)
        self.emit(f'call void @tomato_park(ptr %frame, ptr {v.reg})')
        self.release(v)
        self.suspend_here()
        return ex('', '')

    def unpark_call(self, args: list[Node], line: int) -> Ex:
        if len(args) != 1:
            raise CompileError('_unpark() takes one task: _unpark(t)', line)
        t = self.expr(args[0])
        if not is_task(t.ty):
            raise CompileError(f'_unpark() takes a task, but this is {shown(t.ty)}', line)
        r = self.tmp('unparked')
        self.emit(f'{r} = call i32 @tomato_unpark(ptr {t.reg})')
        w = self.tmp('flag')
        self.emit(f'{w} = zext i32 {r} to i64')
        self.release(t)
        return ex(w, 'bool')

    def await_fd(self, args: list[Node], line: int) -> Ex:
        # await _fd_wait(fd, mode): std/socket waits until a descriptor can be read (mode 1) or written (mode 2)
        if len(args) != 2:
            raise CompileError('_fd_wait() takes a descriptor and a mode: await _fd_wait(fd, 1)', line)
        v = self.want(self.expr(args[0]), 'int', line, 'the descriptor')
        raw = self.int_raw(v)
        m = self.want(self.expr(args[1]), 'int', line, 'the mode')
        rawm = self.int_raw(m)
        self.check_unread()
        self.emit(f'call void @tomato_fd_wait(ptr %frame, i64 {raw}, i64 {rawm})')
        self.release(v)
        self.release(m)
        self.suspend_here()
        return ex('', '')

    def await_input(self, args: list[Node], line: int) -> Ex:
        if len(args) > 1:
            raise CompileError('input() takes an optional prompt as text: await input() or await input(prompt)', line)
        prompt = ex(self.mod.intern(''), 'str')
        if len(args) == 1:
            prompt = self.expr(args[0])
            prompt = self.want(prompt, 'str', line, 'the prompt')
        self.check_unread()
        self.emit(f'call void @tomato_input_wait(ptr %frame, ptr {prompt.reg})')
        self.release(prompt)
        self.suspend_here()
        ip = self.frame_field('%frame', 9, 'str')
        r = self.tmp('line')
        self.emit(f'{r} = load ptr, ptr {ip}')
        self.emit(f'store ptr null, ptr {ip}')
        bad = self.tmp('noinput')
        self.emit(f'{bad} = icmp eq ptr {r}, null')
        self.fail_with(bad, 'EOFError', 'there is no more input to read')
        return ex(r, 'str')

    def start_expr(self, n: Node) -> Ex:
        self.need_async('start', n.line)
        inner = val_node(n.fields[0])
        if inner.kind != 'Call':
            raise CompileError("'start' needs a call of an async function, such as start work()", n.line)
        # a start can be an argument of the call an await or start is about to make (await gather([start f()])), so the
        # permission of that call is given back afterwards
        outer_ok = self.async_ok
        self.async_ok = True
        self.fresh_frame = False
        t = self.expr(inner)
        self.async_ok = outer_ok
        if not is_task(t.ty) or not self.fresh_frame or t.reg != self.fresh_reg:
            raise CompileError("'start' needs a call of an async function, such as start work()", n.line)
        self.fresh_frame = False
        self.launch(t)
        return t

    def launch(self, t: Ex):
        # the task t starts running when this one next waits
        self.emit('call void @tomato_retain(ptr %frame)')          # the starter gets the error if the task fails unread
        who = self.tmp('starter')
        self.emit(f'{who} = ptrtoint ptr %frame to i64')
        self.emit('store i64 ' + who + ', ptr ' + self.frame_field(t.reg, 7, 'u64'))
        self.emit('call void @tomato_q_push(ptr ' + t.reg + ')')      # the scheduler holds it too until it has run

    def async_for(self, s: Node):
        # async for x in task: each status the task yields, as it arrives; ends when the task is done
        self.need_async('async for', s.line)
        t = self.expr(val_node(s.fields[1]))
        if is_class(t.ty):
            it = self.mod.find_op(t.ty[1:], 'iter')
            if it is not None and it.is_async:        # an object whose @iter is async: its task is made and started here
                self.async_ok = True
                self.fresh_frame = False
                t = self.call_function(it, self.method_symbol(t, it), t, [], s.line)
                self.async_ok = False
                self.fresh_frame = False
                self.launch(t)
        if not is_task(t.ty) or task_status(t.ty) == '':
            raise CompileError(f'async for needs a task that yields statuses, but this is {shown(t.ty)}\nthe async function must say what it yields: async def work() -> int yields str:', s.line)
        elem = task_status(t.ty)
        holder = self.hidden_rc_slot('asyncfor.task')
        self.store_owned(holder, t)
        var = self.slot(s.fields[0].text, elem, s.line)
        head = self.label('statuses')
        have = self.label('havestatus')
        nomore = self.label('nostatus')
        wait = self.label('waitstatus')
        end = self.label('endstatuses')
        self.br(head)
        self.place(head)
        self.check_unread()
        h = self.tmp('task')
        self.emit(f'{h} = load ptr, ptr {holder}')
        q = self.tmp('queue')
        self.emit(q + ' = load ptr, ptr ' + self.frame_field(h, 11, 'str'))
        curp = self.frame_field(h, 6, 'u64')
        cur = self.tmp('read')
        self.emit(f'{cur} = load i64, ptr {curp}')
        lenp = self.tmp('lenp')
        self.emit(f'{lenp} = getelementptr {{ i64, i64, i64, i64, ptr }}, ptr {q}, i32 0, i32 2')
        ln = self.tmp('len')
        self.emit(f'{ln} = load i64, ptr {lenp}')
        more = self.tmp('more')
        self.emit(f'{more} = icmp slt i64 {cur}, {ln}')
        self.cond_br(more, have, nomore)
        self.place(have)
        addr = self.list_slot(ex(q, 'list[' + elem + ']'), ex(cur, 'int'))
        item = self.load_item('list[' + elem + ']', addr, 'status')
        e = ex(item, elem)
        self.retain(e)
        self.store_owned(var, e)
        nxt = self.tmp('next')
        self.emit(f'{nxt} = add i64 {cur}, 1')
        self.emit(f'store i64 {nxt}, ptr {curp}')
        self.push_loop(end, head)
        self.block(val_nodes(s.fields[2]))
        self.loop_depth -= 1
        if not self.terminated:
            self.br(head)
        self.place(nomore)
        st = self.tmp('status')
        self.emit(st + ' = load i64, ptr ' + self.frame_field(h, 2, 'u64'))
        fin = self.tmp('isdone')
        self.emit(f'{fin} = icmp ne i64 {st}, 0')
        self.cond_br(fin, end, wait)
        self.place(wait)
        self.emit(f'call void @tomato_task_wait(ptr {h}, ptr %frame)')
        self.suspend_here()
        self.br(head)
        self.place(end)
        o = self.tmp('drop')
        self.emit(f'{o} = load ptr, ptr {holder}')
        self.emit(f'store ptr null, ptr {holder}')       # first: the release can start a collection, which follows the slot
        self.emit(f'call void @tomato_release(ptr {o})')

    def async_yield(self, s: Node):
        # yield value in an async function: a status for whoever reads the task; then other tasks get a turn
        if self.ret_yields == '':
            raise CompileError("this async function does not say what it yields\nwrite it after the return type: async def work() -> int yields str:", s.line)
        v = self.expr(val_node(s.fields[0]), self.ret_yields)
        self.check_unread()
        v = self.want(v, self.ret_yields, s.line, 'the yielded status')
        v = self.owned(v)
        q = self.tmp('queue')
        self.emit(q + ' = load ptr, ptr ' + self.frame_field('%frame', 11, 'str'))
        self.push_item(q, 'list[' + v.ty + ']', v)
        self.emit('call void @tomato_wake_waiters(ptr %frame)')
        self.emit('call void @tomato_q_push(ptr %frame)')
        self.suspend_here()

    # An await can stop the function, and everything it was in the middle of computing would be lost, so every await is
    # first moved out of its expression into a statement of its own (x = await f()) whose only unfinished state is in variables.
    def lift(self, e: Node, out: list[Node], top: bool) -> Node:
        if e.kind == 'Await':
            copy = mk('Await', e.line, [vn(self.lift(val_node(e.fields[0]), out, False))])
            if top:
                return copy
            self.lifted += 1
            name = f'_await{self.lifted}'
            out.append(mk('Assign', e.line, [vn(mk('Name', e.line, [vs(name)])), vn(copy)]))
            return mk('Name', e.line, [vs(name)])
        if e.kind == 'ListComp':
            # the awaits in its items and filter run once for each item, so they stay in its loop (hoist moves them within it); those
            # in what it loops over run once, before it
            loop = val_node(e.fields[0])
            it = self.lift(val_node(loop.fields[1]), out, False)
            comp = mk('ListComp', e.line, [vn(mk('For', loop.line, [loop.fields[0], vn(it)] + loop.fields[2:]))] + e.fields[1:])
            comp.exported = e.exported
            if top or not val_has_await(loop.fields[2]):
                return comp
            # the loop stops and goes on, so the list is built in a statement of its own, with nothing half computed around it
            self.lifted += 1
            cname = f'_await{self.lifted}'
            out.append(mk('Assign', e.line, [vn(mk('Name', e.line, [vs(cname)])), vn(comp)]))
            return mk('Name', e.line, [vs(cname)])
        if e.kind == 'Start':
            # start f(await g()): the awaits among its arguments are moved out like any other
            return mk('Start', e.line, [vn(self.lift(val_node(e.fields[0]), out, False))])
        if e.kind == 'BinOp' and (e.fields[0].text == 'and' or e.fields[0].text == 'or') and contains_await(val_node(e.fields[2])):
            return self.lift_short_circuit(e, out)
        if e.kind == 'Cond' and (contains_await(val_node(e.fields[1])) or contains_await(val_node(e.fields[2]))):
            raise CompileError("an await cannot be in either value of a conditional expression\nuse an if statement and await inside it", e.line)
        copy2 = mk(e.kind, e.line, [self.lift_val(f, out) for f in e.fields])
        copy2.exported = e.exported
        return copy2

    def lift_short_circuit(self, e: Node, out: list[Node]) -> Node:
        # a and await b()  becomes  _await = a; if _await: (the await) _await = b; so the right side runs only when it is needed.
        # For or the test is not _await.
        self.lifted += 1
        name = f'_await{self.lifted}'
        left = self.lift(val_node(e.fields[1]), out, False)
        out.append(mk('Assign', e.line, [vn(mk('Name', e.line, [vs(name)])), vn(left)]))
        test = mk('Name', e.line, [vs(name)])
        if e.fields[0].text == 'or':
            test = mk('UnOp', e.line, [vs('not'), vn(test)])
        body: list[Node] = []
        right = self.lift(val_node(e.fields[2]), body, False)
        body.append(mk('Assign', e.line, [vn(mk('Name', e.line, [vs(name)])), vn(right)]))
        out.append(mk('If', e.line, [vlist([vtuple([vn(test), vnodes(body)])]), vz()]))
        return mk('Name', e.line, [vs(name)])

    def lift_val(self, v: Val, out: list[Node]) -> Val:
        if v.tag == 'n':
            return vn(self.lift(val_node(v), out, False))
        if v.tag == 'l':
            return vlist([self.lift_val(item, out) for item in v.items])
        if v.tag == 't':
            return vtuple([self.lift_val(item, out) for item in v.items])
        return v

    def hoist(self, s: Node) -> list[Node]:
        # the statements that run in place of s: its awaits as statements of their own, then s without them
        out: list[Node] = []
        k = s.kind
        if k == 'Assign' or k == 'Return' or k == 'ExprStmt' or k == 'Declare' or k == 'Raise' or k == 'Yield' or k == 'CompAppend':
            cf: list[Val] = []
            for j, f in enumerate(s.fields):
                if f.tag == 'n':
                    child = val_node(f)
                    is_top = (child.kind == 'Await' or child.kind == 'ListComp') and ((k == 'Assign' and j == 1 and val_node(s.fields[0]).kind == 'Name') or (k == 'Declare' and j == 2) or k == 'Return' or k == 'ExprStmt')
                    cf.append(vn(self.lift(child, out, is_top)))
                else:
                    cf.append(f)
            out.append(mk(k, s.line, cf))
            return out
        if k == 'If':
            branches = s.fields[0].items
            first = branches[0].items
            later = len(branches)          # the first elif whose condition has an await: it and what follows move into the else branch
            for b in range(1, len(branches)):
                if later == len(branches) and contains_await(val_node(branches[b].items[0])):
                    later = b
            cond = self.lift(val_node(first[0]), out, False)
            kept = [vtuple([vn(cond), first[1]])] + branches[1:later]
            orelse = s.fields[1]
            if later < len(branches):
                orelse = vnodes(self.hoist(mk('If', s.line, [vlist(branches[later:]), s.fields[1]])))
            out.append(mk('If', s.line, [vlist(kept), orelse]))
            return out
        if k == 'For' or k == 'AsyncFor':
            it = self.lift(val_node(s.fields[1]), out, False)
            # the fields after the iterable stay as they are (for k, v in d.items() keeps its names in field 3)
            out.append(mk(k, s.line, [s.fields[0], vn(it)] + s.fields[2:]))
            return out
        if k == 'While' and contains_await(val_node(s.fields[0])):
            # while await more(): body  becomes  while True: (the await, then: if not condition: break), body
            body: list[Node] = []
            cond2 = self.lift(val_node(s.fields[0]), body, False)
            body.append(mk('If', s.line, [vlist([vtuple([vn(mk('UnOp', s.line, [vs('not'), vn(cond2)])), vnodes([mk('Break', s.line, [])])])]), vz()]))
            for st in s.fields[1].items:
                body.append(val_node(st))
            out.append(mk('While', s.line, [vn(mk('BoolLit', s.line, [vb(True)])), vnodes(body)]))
            return out
        out.append(s)
        return out

    def ret_llvm(self, info: FuncInfo) -> str:
        if info.ret == '':
            return 'void'
        return llvm_type(info.ret)

    def len_call(self, args: list[Node], line: int) -> Ex:
        if len(args) != 1:
            raise CompileError('len() takes exactly one argument', line)
        if args[0].kind == 'Name' and args[0].fields[0].text in self.slots and not is_dyn(self.types[args[0].fields[0].text]):
            v = self.expr_b(args[0], [])
        else:
            v = self.expr(args[0])
        if is_dyn(v.ty):
            return self.len_dyn(v, line)
        if is_union(v.ty):
            return self.union_len(v, line)
        return self.len_of(v, line)

    # len() of a value of a Sized type: ask whichever kind of value the box holds, and keep the answer in a slot
    def len_dyn(self, box: Ex, line: int) -> Ex:
        if not dyn_sized(box.ty):
            raise CompileError(f'len() needs a value with a length, but this is {shown(box.ty)}\nuse Sized, or Iterable[T] & Sized', line)
        holder = self.hidden_rc_slot('len.dyn')
        self.store_owned(holder, box)
        answer = self.hidden_slot('len.answer')
        join = self.label('endlen')
        for member in self.mod.dyn_members(box.ty):
            held = self.tmp('held')
            self.emit(f'{held} = load ptr, ptr {holder}')
            yes = self.label('lenis')
            no = self.label('lennot')
            self.cond_br(self.box_is(ex(held, box.ty), member), yes, no)
            self.place(yes)
            inner = self.unbox_value(ex(held, box.ty), member)
            n = self.len_of(inner, line)
            self.emit(f'store i64 {n.reg}, ptr {answer}')
            self.br(join)
            self.place(no)
        self.br(join)
        self.place(join)
        r = self.tmp('answer')
        self.emit(f'{r} = load i64, ptr {answer}')
        return ex(r, 'int')

    def union_len(self, v: Ex, line: int) -> Ex:
        # len() of a union: the length of whichever member it holds (every member must have one)
        for m in union_members(v.ty):
            if not (is_list(m) or is_dict(m) or is_set(m) or m == 'str' or (is_class(m) and self.mod.has_op(m[1:], 'len'))):
                raise CompileError(f'len() needs every member of {shown(v.ty)} to have a length, but {shown(m)} does not', line)
        result = self.hidden_slot('len.of')
        end = self.label('endlen')
        members = union_members(v.ty)
        then = ''
        nxt = ''
        for k, m in enumerate(members):
            if k < len(members) - 1:
                then = self.label('lenthen')
                nxt = self.label('lennext')
                self.cond_br(self.box_is(v, m), then, nxt)
                self.place(then)
            n = self.len_of(self.unbox_value(v, m), line)
            self.emit(f'store i64 {n.reg}, ptr {result}')
            self.br(end)
            if k < len(members) - 1:
                self.place(nxt)
        self.place(end)
        self.release(v)
        r = self.tmp('len')
        self.emit(f'{r} = load i64, ptr {result}')
        return ex(r, 'int')

    def len_of(self, v: Ex, line: int) -> Ex:
        if is_class(v.ty):
            f = self.mod.find_op(v.ty[1:], 'len')
            if f is None or len(f.ptypes) != 0 or f.ret != 'int':
                raise CompileError("'" + v.ty[1:] + "' objects have no length\nadd a method marked @len that takes no argument and returns int", line)
            return self.marker_call(v, f, [], line)
        if is_mtuple(v.ty):
            self.release(v)
            return exs(str(2 * len(mtuple_items(v.ty)) + 1), 'int')
        r = self.tmp('len')
        if is_list(v.ty) or is_dict(v.ty) or is_set(v.ty):
            lenp = self.tmp('lenp')
            self.emit(f'{lenp} = getelementptr {{ i64, i64, i64, i64, ptr }}, ptr {v.reg}, i32 0, i32 2')
            self.emit(f'{r} = load i64, ptr {lenp}')
        else:
            v = self.want(v, 'str', line, 'the argument of len')
            self.emit(f'{r} = call i64 @tomato_str_len(ptr {v.reg})')
        self.release(v)
        return self.tag_small(r)

    def class_text(self, v: Ex, line: int) -> Ex:
        # print and str() of an object whose class has a method marked @str: that method's text (P65)
        found = self.mod.find_op(v.ty[1:], 'str')
        if found is None:
            raise CompileError("'" + v.ty[1:] + "' objects cannot be printed or converted to text\nadd a method marked @str that returns text", line)
        info = found
        if len(info.ptypes) != 0 or info.ret != 'str':
            raise CompileError(f"the @str method '{info.name}' must take no argument besides self and return str", line)
        r = self.tmp('shown')
        symbol = self.method_symbol(v, info)
        self.emit(f'{r} = call ptr {symbol}(ptr {v.reg})')
        self.check_error([v], symbol)
        return ex(r, 'str')

    def show_text(self, v: Ex, line: int) -> Ex:
        # a list, tuple, set or dict as text, the way Python shows it: [1, 'a'] (the argument is released)
        info = self.mod.helper('show', v.ty, line)
        r = self.tmp('shown')
        self.emit(f'{r} = call ptr {function_symbol(self.mod, info)}(ptr {v.reg})')
        self.check_error([v], function_symbol(self.mod, info))
        self.release(v)
        return ex(r, 'str')

    def union_text(self, v: Ex, quoted: bool, line: int) -> Ex:
        # a union value as text (the argument is released). A whole number, float, text or bool member is shown by the runtime
        # (quoted inside a container when `quoted`); a list, tuple, set, dict or object member the box cannot show by itself is
        # found by its member type code and shown by that member's own helper, so `[1, ('a', 2)]` prints as Python does
        shown_members: list[str] = []
        for m in union_members(v.ty):
            if is_showable_member(self.mod, m):
                shown_members.append(m)
        r = self.tmp('text')
        if len(shown_members) == 0:
            fn = 'tomato_box_str'
            if quoted:
                fn = 'tomato_box_repr'
            self.emit(f'{r} = call ptr @{fn}(ptr {v.reg})')
            self.release(v)
            return ex(r, 'str')
        res = self.hidden_rc_slot('shown')
        end = self.label('ushownend')
        held_before = len(self.held)
        self.hold(v)                           # freed by the error path if a member's text raises (an @str method can)
        for m in shown_members:
            yes = self.label('ushow')
            no = self.label('ushownot')
            self.cond_br(self.box_is(v, m), yes, no)
            self.place(yes)
            inner = self.unbox_value(v, m)
            if is_class(m):
                t = self.class_text(inner, line)
                self.release(inner)
                self.store_owned(res, t)
            else:
                self.store_owned(res, self.show_text(inner, line))
            self.br(end)
            self.place(no)
        self.drop_held(held_before)
        fn = 'tomato_box_str'
        if quoted:
            fn = 'tomato_box_repr'
        self.emit(f'{r} = call ptr @{fn}(ptr {v.reg})')
        self.store_owned(res, ex(r, 'str'))
        self.br(end)
        self.place(end)
        self.release(v)
        out = self.tmp('utext')
        self.emit(f'{out} = load ptr, ptr {res}')
        o = ex(out, 'str')
        self.retain(o)
        return o

    def str_call(self, args: list[Node], line: int) -> Ex:
        if len(args) != 1:
            raise CompileError('str() takes exactly one argument', line)
        return self.str_of(self.expr(args[0]), line)

    def is_text_part(self, n: Node) -> bool:
        # a text literal or a str(...) call: the parts an f-string is made of
        if n.kind == 'StrLit':
            return True
        if n.kind == 'Call' and len(val_nodes(n.fields[1])) == 1 and len(n.fields[2].items) == 0:
            f = val_node(n.fields[0])
            return f.kind == 'Name' and f.fields[0].text == 'str' and 'str' not in self.slots and self.mod.resolve('str') == ''
        return False

    def concat_parts(self, n: Node, out: list[Node]):
        # the operands of a left-leaning chain a + b + c ...
        if n.kind == 'BinOp' and n.fields[0].text == '+':
            self.concat_parts(val_node(n.fields[1]), out)
            out.append(val_node(n.fields[2]))
        else:
            out.append(n)

    def fused_concat(self, parts: list[Node], line: int) -> Ex:
        # 'w' + str(i) + '-' ...: every part is evaluated in order, then one runtime call builds the result in one allocation
        # (an int inside str() is written as digits straight into it)
        values: list[Ex] = []
        kinds: list[str] = []
        held_before = len(self.held)
        for p in parts:
            kind = '0'
            if p.kind == 'Call' and self.is_text_part(p):
                v = self.expr(val_nodes(p.fields[1])[0])
                if v.ty == 'int':
                    kind = '1'
                elif is_numeric(v.ty) and is_signed(v.ty):
                    kind = '2'
                else:
                    v = self.str_of(v, line)
            else:
                v = self.expr(p)
            seen = v.ty
            if kind != '0':
                seen = 'str'
            if len(values) == 1:
                left = 'str'
                if kinds[0] == '0':
                    left = values[0].ty
                if left != seen:
                    raise CompileError(f"cannot use '+' with {shown(left)} and {shown(seen)}", line)
            if len(values) >= 2 and seen != 'str':
                raise CompileError(f"cannot use '+' with {shown('str')} and {shown(seen)}", line)
            values.append(v)
            kinds.append(kind)
            self.hold(v)                        # freed by the error path if a later part raises
        self.drop_held(held_before)
        arr = self.tmp('parts')
        self.allocas.append(f'  {arr} = alloca [{2 * len(values)} x i64]')
        for i, v in enumerate(values):
            slot = self.tmp('pslot')
            self.emit(f'{slot} = getelementptr i64, ptr {arr}, i64 {2 * i}')
            self.emit(f'store i64 {kinds[i]}, ptr {slot}')
            word = v.reg
            if kinds[i] == '0':
                word = self.tmp('pword')
                self.emit(f'{word} = ptrtoint ptr {v.reg} to i64')
            elif kinds[i] == '2':
                word = self.widen(v, 64)
            slot2 = self.tmp('pslot')
            self.emit(f'{slot2} = getelementptr i64, ptr {arr}, i64 {2 * i + 1}')
            self.emit(f'store i64 {word}, ptr {slot2}')
        r = self.tmp('cat')
        self.emit(f'{r} = call ptr @tomato_str_cat(i64 {len(values)}, ptr {arr})')
        for v in values:
            self.release(v)
        return ex(r, 'str')

    def str_of(self, v: Ex, line: int) -> Ex:
        if v.ty == 'str':
            return v
        if is_fn(v.ty):
            raise CompileError(f'a function value ({shown(v.ty)}) cannot be converted to text\ncall it and use the result', line)
        if is_dyn(v.ty):
            raise CompileError(f'a value of type {shown(v.ty)} cannot be converted to text\nloop over it and print the items instead', line)
        return self.text_of(v, line)

    def optional_text(self, v: Ex, line: int) -> Ex:
        # an optional as text: 'None' when it is None, otherwise the text of the value inside (the argument is released)
        isnone = self.tmp('isnone')
        self.emit(f'{isnone} = icmp eq ptr {v.reg}, null')
        none = self.label('shownone')
        some = self.label('showsome')
        end = self.label('showend')
        res = self.hidden_rc_slot('shown')
        self.cond_br(isnone, none, some)
        self.place(none)
        self.store_owned(res, ex(self.mod.intern('None'), 'str'))
        self.br(end)
        self.place(some)
        inner = self.text_of(ex(v.reg, strip_optional(v.ty)), line)
        self.store_owned(res, inner)
        self.br(end)
        self.place(end)
        r = self.tmp('text')
        self.emit(f'{r} = load ptr, ptr {res}')
        out = ex(r, 'str')
        self.retain(out)
        return out

    def text_of(self, v: Ex, line: int) -> Ex:
        # a value as text, the way print and str() show it (the argument is released)
        if v.ty == 'str':
            return v
        if v.ty == 'None':
            return ex(self.mod.intern('None'), 'str')
        if is_optional(v.ty):
            return self.optional_text(v, line)
        if is_class(v.ty):
            shown_text = self.class_text(v, line)
            self.release(v)
            return shown_text
        if is_list(v.ty) or is_dict(v.ty) or is_set(v.ty) or is_mtuple(v.ty):
            return self.show_text(v, line)
        r = self.tmp('text')
        if v.ty == 'int':
            self.emit(f'{r} = call ptr @tomato_int_str(i64 {v.reg})')
            self.release(v)
        elif is_numeric(v.ty):
            if is_signed(v.ty):
                self.emit(f'{r} = call ptr @tomato_str_from_i64(i64 {self.widen(v, 64)})')
            else:
                self.emit(f'{r} = call ptr @tomato_str_from_u64(i64 {self.widen(v, 64)})')
        elif is_union(v.ty):
            return self.union_text(v, False, line)
        elif v.ty == 'float':
            self.emit(f'{r} = call ptr @tomato_str_from_f64(double {v.reg})')
        else:
            w = self.tmp('w')
            self.emit(f'{w} = trunc i64 {v.reg} to i32')
            self.emit(f'{r} = call ptr @tomato_str_from_bool(i32 {w})')
        return ex(r, 'str')

    def print_call(self, args: list[Node]):
        values: list[Ex] = []
        held_before = len(self.held)
        for a in args:
            v = self.expr(a)                   # every argument is evaluated before anything is printed
            if is_fn(v.ty):
                raise CompileError(f'a function value ({shown(v.ty)}) cannot be printed\ncall it and print the result', self.line)
            if is_dyn(v.ty):
                raise CompileError(f'a value of type {shown(v.ty)} cannot be printed\nloop over it and print the items instead', self.line)
            values.append(v)
            self.hold(v)                       # freed by the error path if a later argument raises
        for k, v in enumerate(values):
            # turning a value into text can raise (an @str method): the values not printed yet are freed then
            self.drop_held(held_before)
            for later in values[k + 1:]:
                self.hold(later)
            if v.ty == 'None' or is_optional(v.ty):
                shown_opt = self.text_of(v, self.line)
                self.emit(f'call void @tomato_print_strobj(ptr {shown_opt.reg})')
                self.emit(f'call void @tomato_release(ptr {shown_opt.reg})')
            elif v.ty == 'int':
                t = self.tmp('text')
                self.emit(f'{t} = call ptr @tomato_int_str(i64 {v.reg})')
                self.release(v)
                self.emit(f'call void @tomato_print_strobj(ptr {t})')
                self.emit(f'call void @tomato_release(ptr {t})')
            elif is_numeric(v.ty):
                wide = self.widen(v, 64)
                fmt = '@.fmt.uint' if not is_signed(v.ty) else '@.fmt.int'
                self.emit(f'call i32 (ptr, ...) @printf(ptr {fmt}, i64 {wide})')
            elif v.ty == 'bool':
                w = self.tmp('w')
                self.emit(f'{w} = trunc i64 {v.reg} to i32')
                t = self.tmp('text')
                self.emit(f'{t} = call ptr @tomato_str_from_bool(i32 {w})')
                self.emit(f'call void @tomato_print_strobj(ptr {t})')
                self.emit(f'call void @tomato_release(ptr {t})')
            elif v.ty == 'float':
                t = self.tmp('text')
                self.emit(f'{t} = call ptr @tomato_str_from_f64(double {v.reg})')
                self.emit(f'call void @tomato_print_strobj(ptr {t})')
                self.emit(f'call void @tomato_release(ptr {t})')
            elif is_list(v.ty) or is_dict(v.ty) or is_set(v.ty) or is_mtuple(v.ty):
                shown_list = self.show_text(v, self.line)
                self.emit(f'call void @tomato_print_strobj(ptr {shown_list.reg})')
                self.emit(f'call void @tomato_release(ptr {shown_list.reg})')
            elif is_class(v.ty):
                t = self.tmp('text')
                shown_text = self.class_text(v, self.line)
                self.emit(f'call void @tomato_print_strobj(ptr {shown_text.reg})')
                self.emit(f'call void @tomato_release(ptr {shown_text.reg})')
                self.release(v)
            elif is_union(v.ty):
                shown_union = self.union_text(v, False, self.line)
                self.emit(f'call void @tomato_print_strobj(ptr {shown_union.reg})')
                self.emit(f'call void @tomato_release(ptr {shown_union.reg})')
            else:
                self.emit(f'call void @tomato_print_strobj(ptr {v.reg})')
                self.release(v)
            if k < len(values) - 1:
                self.emit('call i32 @putchar(i32 32)')
        self.drop_held(held_before)
        self.emit('call i32 @putchar(i32 10)')

    # ---- statements
    def block(self, body: list[Node]):
        depth = len(self.after)
        k = 0
        while k < len(body):
            run = 1
            if self.nest_fast and self.nest != '':
                run = self.float_run(body, k)
            if run == 1 or not self.float_group(body[k:k + run]):
                for i in range(k, k + run):
                    self.stmt(body[i])
            k += run
        self.end_block_narrowing(depth)

    def push_loop(self, brk: str, cont: str):
        if self.loop_depth < len(self.breaks):
            self.breaks[self.loop_depth] = brk
            self.conts[self.loop_depth] = cont
        else:
            self.breaks.append(brk)
            self.conts.append(cont)
        self.loop_depth += 1

    def visible_names(self) -> list[str]:
        # the names a program could have meant: variables, functions, classes and the built-ins
        out: list[str] = [name for name in self.slots]
        for seen in self.mod.scope:
            if seen.module == self.mod.cur or seen.module == 'builtin':
                out.append(seen.name)
        out.extend(['print', 'len', 'str', 'int', 'float', 'open', 'input', 'sleep', 'clock', 'range'])
        return out

    def name_hint(self, name: str) -> str:
        if self.mod.resolve(name) != '':
            return f"\n'{name}' is a function or class, not a variable; call it, such as {name}()"
        near = closest(name, self.visible_names())
        if near != '':
            return f"\ndid you mean '{near}'?"
        return ''

    def unknown_function(self, name: str) -> str:
        if name in self.slots:
            return f"'{name}' is a variable, not a function, so it cannot be called"
        if name in ['reduce']:
            return f"'{name}' is not available\nuse a for loop instead"
        if name in ['pow', 'input', 'list', 'dict', 'set', 'tuple', 'bool', 'type', 'isinstance', 'hash', 'format']:
            return f"'{name}' is not built in"
        near = closest(name, self.visible_names())
        if near != '':
            return f"the function '{name}' is not defined\ndid you mean '{near}'?"
        return f"the function '{name}' is not defined\ncheck its spelling, or import it with 'from module import {name}'"

    def no_method(self, name: str, ty: str) -> str:
        known: list[str] = []
        word = shown(ty)
        if ty == 'str':
            known = ['find', 'rfind', 'count', 'startswith', 'endswith', 'replace', 'split', 'join', 'upper', 'lower', 'strip', 'lstrip', 'rstrip', 'isdigit', 'isalpha', 'isspace'] + text_helper_methods()
            word = 'text'
        elif is_dict(ty):
            known = ['get', 'remove', 'keys', 'values', 'items']
            word = 'a dict'
        elif is_set(ty) or ty == 'set':
            known = ['add', 'remove', 'discard']
        elif ty == 'File':
            known = ['read', 'write', 'close']
            word = 'a file'
        elif is_list(ty):
            known = ['append', 'pop', 'insert', 'extend', 'sort', 'reverse']
        near = closest(name, known)
        text = f"{word} has no method '{name}'"
        if near != '':
            return f"{text}\ndid you mean '{near}'?"
        if len(known) > 0:
            return text + '\nthe methods it has are: ' + ', '.join(known)
        return text

    def stmt(self, s: Node):
        if self.is_async:
            for p in self.hoist(s):
                self.stmt_now(p)
            return
        self.stmt_now(s)

    def stmt_now(self, s: Node):
        self.line = s.line
        if s.spot > 0 and self.nest != '':
            if self.nest_fast:
                self.nest_stmt(s)
                return
            spot = f'{self.nest}_{s.spot}'            # the fast copy can come here (and to the end of the statement)
            self.br(spot)
            self.place(spot)
            self.stmt_plain(s)
            if not self.terminated:
                self.br(f'{spot}e')
                self.place(f'{spot}e')
            return
        if (s.kind == 'For' or s.kind == 'While') and self.nest_start_ok(s):
            self.nest_loop(s)
            return
        self.stmt_plain(s)

    # ---- loop nests (release mode). A loop over a range or a `while` that works on ints, floats, lists of them, text and fields,
    # with the loops inside it, is compiled twice. The general copy is the ordinary code. The fast copy assumes that every int
    # variable of the nest holds a small number, which is tested at each loop head of the general copy, where it is entered;
    # it has no big-number code at all. When a number it loads or makes is not small, an index is out of range or a float is not
    # finite, it goes to the start of the same statement in the general copy, which does it again, exactly, and raises the
    # error if there is one: a statement compiled this way has no effect before its one store at the end. The other statements
    # (calls, appends, prints, ...) are the ordinary code in both copies; after one, the variables it assigned are tested and a
    # big number goes on in the general copy. Both copies use the same slots, so no state is copied.
    def nest_start_ok(self, s: Node) -> bool:
        if self.mod.mode != 2 or self.nest != '' or self.nest_off or self.is_async or self.gen_n > 0 or self.facts_off > 0 or self.try_depth > 0:
            return False
        if node_count(s, NEST_NODES) > NEST_NODES or not nest_shape(s):
            return False
        lists: list[str] = []
        nest_lists(s, lists)
        for name in lists:                  # the lists that `for` loops walk
            if name not in self.slots:
                return False
            t = self.types[name]
            if not (t == 'list[int]' or t == 'list[float]' or t == 'list[bool]') or name in self.narrowed or name in self.settled:
                return False
        return True

    def nest_loop(self, s: Node):
        prefix = self.label('nest')
        counter = [0]
        nest_number(s, counter, True)
        self.nest = prefix
        self.nest_fast = False
        self.nest_slots = {}
        self.nest_keeps = {}
        self.nest_plain = []
        self.nest_heads = []
        self.nest_entries = []
        before = self.facts
        self.br(f'{prefix}_{s.spot}')
        self.place(f'{prefix}_{s.spot}')
        self.stmt_plain(s)
        after = self.facts
        names: list[str] = []
        names_read(s, names)
        bound_names(s, names)
        self.nest_names = []
        for name in names:
            if name in self.slots and self.types[name] == 'int' and name not in self.narrowed and name not in self.settled and name not in self.nest_names:
                self.nest_names.append(name)
        done = self.label('nestdone')
        self.br(done)
        mark = len(self.lines)
        # (a small-int loop inside has a fast copy of its own, which is better than this one for what it does)
        use = len(self.nest_names) > 0 and len(self.nest_heads) > 0 and len(self.nest_plain) == 0
        if use:
            # the code in front of the outer loop is not reached: the fast copy is entered at the loop heads
            self.place(self.label('nestfront'))
            self.nest_fast = True
            self.nest_count = 0
            self.facts = self.small_facts(before)
            self.nest_stmt(s)
            if not self.terminated:
                self.br(done)
            self.nest_fast = False
            if self.nest_count == 0:
                self.lines = self.lines[:mark]
                use = False
        self.place(done)
        for head in self.nest_heads:
            if not use or head[2] not in self.nest_entries:
                self.lines[int(head[0])] = f'  br label %{head[1]}'
                continue
            text: list[str] = []
            acc = ''
            for name in self.nest_names:
                w = self.tmp('sm')
                text.append(f'  {w} = load i64, ptr {self.slots[name]}')
                if acc == '':
                    acc = w
                else:
                    both = self.tmp('sm')
                    text.append(f'  {both} = and i64 {acc}, {w}')
                    acc = both
            bit = self.tmp('sm')
            small = self.tmp('sm')
            text.append(f'  {bit} = and i64 {acc}, 1')
            text.append(f'  {small} = icmp ne i64 {bit}, 0')
            text.append(f'  br i1 {small}, label %{prefix}_h{head[2]}, label %{head[1]}')
            self.lines[int(head[0])] = '\n'.join(text)
        self.nest = ''
        nest_number(s, counter, False)
        self.facts = after

    def small_facts(self, f: Facts) -> Facts:
        # the facts f in the fast copy of a loop nest: every int variable of the nest is small
        if not self.nest_fast:
            return f
        return self.fast_facts(f, self.nest_names)

    def nest_head(self, s: Node):
        # at a loop head of the general copy: the test that enters the fast copy, written by nest_loop when the nest is done
        if self.nest == '' or self.nest_fast or s.spot == 0:
            return
        go_on = self.label('nestgo')
        self.nest_heads.append([str(len(self.lines)), go_on, str(s.spot)])
        self.lines.append('  ; nest')
        self.terminated = True
        self.place(go_on)

    def nest_label(self, s: Node, hint: str) -> str:
        if self.nest != '' and self.nest_fast and s.spot > 0:
            self.nest_entries.append(str(s.spot))
            return f'{self.nest}_h{s.spot}'
        return self.label(hint)

    def loop_slot(self, s: Node, hint: str) -> str:
        # a hidden slot of a loop; the two copies of a nest share it
        if self.nest == '' or s.spot == 0:
            return self.hidden_slot(hint)
        key = f'{s.spot}{hint}'
        if key not in self.nest_slots:
            self.nest_slots[key] = self.hidden_slot(hint)
        return self.nest_slots[key]

    def nest_fastable(self, s: Node) -> bool:
        k = s.kind
        if k == 'Assign':
            t = val_node(s.fields[0])
            if not self.calm(val_node(s.fields[1])):
                return False
            if t.kind == 'Name':
                name = t.fields[0].text
                return name in self.slots and self.types[name] == self.peek_type(val_node(s.fields[1])) and name not in self.narrowed and name not in self.settled
            if t.kind == 'Index':
                return self.peek_type(val_node(t.fields[0])).startswith('list[') and self.calm(t) and not is_rc(self.peek_type(t)) and self.peek_type(t) == self.peek_type(val_node(s.fields[1]))
            return t.kind == 'Attr' and self.calm(t) and not is_rc(self.peek_type(t)) and self.peek_type(t) == self.peek_type(val_node(s.fields[1]))
        if k == 'Declare':
            name = s.fields[0].text
            return name in self.slots and self.calm(val_node(s.fields[2])) and self.types[name] == self.peek_type(val_node(s.fields[2]))
        if k == 'If':
            for branch in s.fields[0].items:
                if not self.calm(val_node(branch.items[0])):
                    return False
            return True
        if k == 'While':
            return s.spot not in self.nest_plain and self.calm(val_node(s.fields[0]))
        if k == 'For' and val_node(s.fields[1]).kind == 'Name':
            return s.fields[0].text in self.slots and self.types[s.fields[0].text] == elem_of(self.types[val_node(s.fields[1]).fields[0].text])
        if k == 'For':
            for b in val_nodes(val_node(s.fields[1]).fields[1]):
                if not self.calm(b):
                    return False
            return s.fields[0].text in self.nest_names
        return False

    def nest_stmt(self, s: Node):
        self.facts = self.small_facts(self.facts)
        k = s.kind
        if k == 'Multi' or k == 'Pass' or k == 'Break' or k == 'Continue':
            self.stmt_kind(s)
        elif self.nest_fastable(s):
            saved = self.bail
            self.bail = f'{self.nest}_{s.spot}'
            if k == 'While':
                # its condition is tested behind the test that enters the fast copy, or the two copies would take turns for ever
                for h in self.nest_heads:
                    if h[2] == str(s.spot):
                        self.bail = h[1]
            if k == 'Assign' or k == 'Declare':
                self.nest_count += 1
            if k == 'For':
                self.for_facts(s)
            else:
                self.stmt_kind(s)
            self.bail = saved
        else:
            nest = self.nest
            saved2 = self.bail
            self.nest = ''
            self.nest_fast = False
            self.nest_off = True
            self.bail = ''
            self.stmt_plain(s)
            self.nest = nest
            self.nest_fast = True
            self.nest_off = False
            self.bail = saved2
            if not self.terminated:
                names: list[str] = []
                bound_names(s, names)
                acc = ''
                for name in self.nest_names:
                    if name in names:
                        w = self.tmp('sm')
                        self.emit(f'{w} = load i64, ptr {self.slots[name]}')
                        acc = w if acc == '' else self.arith('and', acc, w)
                if acc != '':
                    bit = self.arith('and', acc, '1')
                    c = self.tmp('notsmall')
                    self.emit(f'{c} = icmp eq i64 {bit}, 0')
                    ok = self.label('inside')
                    self.cold_br(c, f'{self.nest}_{s.spot}e', ok)
                    self.place(ok)
        if not self.terminated:
            self.facts = self.small_facts(self.facts)

    # A run of float assignments in the fast copy of a nest (to variables and fields) is checked once, at its end: their values are
    # worked out first, then one test finds whether any of them is infinite or not a number, and only then are they stored. Until
    # the stores nothing has happened, so anything that goes wrong in the run goes to the first of its statements in the
    # general copy.
    def float_run(self, body: list[Node], k: int) -> int:
        fields: list[str] = []      # the names of the fields the run assigns
        n = 0
        while k + n < len(body) and n < 16:
            s = body[k + n]
            if s.kind != 'Assign' or s.spot == 0:
                break
            t = val_node(s.fields[0])
            if not (t.kind == 'Name' or (t.kind == 'Attr' and val_node(t.fields[0]).kind == 'Name')):
                break
            v = val_node(s.fields[1])
            if self.peek_type(v) != 'float' or not self.float_flat(v, fields, n == 0) or not self.nest_fastable(s):
                break
            if t.kind == 'Attr':
                fields.append(t.fields[1].text)
            n += 1
        return n if n > 1 else 1

    def float_flat(self, n: Node, fields: list[str], calls: bool) -> bool:
        # n is + - * / of variables, constants, fields and list items (and calls that only compute), and reads none of the fields
        k = n.kind
        if k == 'FloatLit' or k == 'IntLit':
            return True
        if k == 'Name':
            return n.fields[0].text in self.slots and (self.types[n.fields[0].text] == 'float' or self.types[n.fields[0].text] == 'int')
        if k == 'Attr':
            return n.fields[1].text not in fields and val_node(n.fields[0]).kind == 'Name' and self.peek_type(n) == 'float'
        if k == 'Index':
            return self.peek_type(n) == 'float' and val_node(n.fields[0]).kind == 'Name' and (val_node(n.fields[1]).kind == 'Name' or val_node(n.fields[1]).kind == 'IntLit')
        if k == 'UnOp':
            return n.fields[0].text == '-' and self.peek_type(n) == 'float' and self.float_flat(val_node(n.fields[1]), fields, calls)
        if k == 'BinOp':
            op = n.fields[0].text
            if not (op == '+' or op == '-' or op == '*' or op == '/') or self.peek_type(n) != 'float':
                return False
            return self.float_flat(val_node(n.fields[1]), fields, calls) and self.float_flat(val_node(n.fields[2]), fields, calls)
        if k == 'Call' and calls and self.peek_type(n) == 'float':
            for a in val_nodes(n.fields[1]):        # (an argument that is worked out would have to be checked before the call)
                if a.kind != 'Name' and a.kind != 'FloatLit' and a.kind != 'IntLit':
                    return False
            return True
        return False

    def float_group(self, run: list[Node]) -> bool:
        # compile the run; False (and nothing is compiled) when it did not come out as expected
        before = self.facts
        line = self.line
        start = len(self.lines)
        saved = self.bail
        self.bail = f'{self.nest}_{run[0].spot}'
        self.grouping = True
        self.group_checks = []
        addrs: list[str] = []           # the stores that wait, in order
        regs: list[str] = []
        ok = not self.terminated
        for s in run:
            self.line = s.line
            self.facts = self.small_facts(self.facts)
            mark = len(self.lines)
            self.stmt_kind(s)
            fresh = self.lines[mark:]
            self.lines = self.lines[:mark]
            for text in fresh:
                if text.startswith('  store double '):
                    cut = text.find(', ptr ')
                    regs.append(text[15:cut])
                    addrs.append(text[cut + 6:])
                    continue
                if text.startswith('  store '):
                    ok = False
                cut2 = text.find(' = load double, ptr ')
                if cut2 >= 0:
                    addr = text[cut2 + 20:]
                    for i in range(len(addrs) - 1, -1, -1):
                        if addrs[i] == addr:
                            text = f'{text[:cut2]} = bitcast double {regs[i]} to double'
                            break
                self.lines.append(text)
        self.grouping = False
        if ok and not self.terminated:
            acc = ''
            for c in self.group_checks:
                if not self.shown_later(c[0], start):
                    acc = c[1] if acc == '' else self.arith_f('fadd', acc, c[1])
            if acc != '':
                wrong = self.tmp('notfinite')
                self.emit(f'{wrong} = fcmp uno double {acc}, 0.0')
                self.bail_if(wrong)
            for i in range(len(addrs)):
                self.emit(f'store double {regs[i]}, ptr {addrs[i]}')
            self.nest_count += len(run)
            self.facts = self.small_facts(self.facts)
        else:
            self.lines = self.lines[:start]
            self.terminated = False
            self.facts = before
            self.line = line
            ok = False
        self.bail = saved
        return ok

    def arith_f(self, op: str, a: str, b: str) -> str:
        r = self.tmp('f')
        self.emit(f'{r} = {op} double {a}, {b}')
        return r

    def shown_later(self, r: str, start: int) -> bool:
        # true if a float r that is infinite or not a number makes another float of the run so, which is checked: r is an operand
        # of a + - * (or the left one of a division) whose result is checked or shows in turn
        for i in range(start, len(self.lines)):
            text = self.lines[i]
            cut = text.find(' = ')
            if cut < 0:
                continue
            q = text[2:cut]
            op = text[cut + 3:]
            if q.startswith('%diff.') or not (op.startswith('fadd ') or op.startswith('fsub ') or op.startswith('fmul ') or op.startswith('fneg ') or op.startswith('fdiv ') or op.startswith('bitcast ')):
                continue
            if op.startswith('bitcast '):
                if not op.startswith(f'bitcast double {r} '):
                    continue
            else:
                comma = op.find(', ')
                first = op[12:] if comma < 0 else op[12:comma]
                second = '' if comma < 0 or op.startswith('fdiv ') else op[comma + 2:]
                if r != first and r != second:
                    continue
            for c in self.group_checks:
                if c[0] == q:
                    return True
            if self.shown_later(q, start):
                return True
        return False

    def stmt_plain(self, s: Node):
        if s.mark > 0 and self.mark_prefix != '':
            lbl = f'{self.mark_prefix}_{s.mark}'
            self.br(lbl)
            self.place(lbl)
        if not self.tracking():
            self.stmt_kind(s)
            return
        comps: list[str] = []
        comp_names(s, comps)
        if len(comps) > 0:
            self.facts = facts_kill(self.facts, comps)
        k = s.kind
        if k == 'For':
            self.for_facts(s)
            return
        if not (k == 'ExprStmt' or k == 'Assign' or k == 'Multi' or k == 'Declare' or k == 'Return' or k == 'Raise' or k == 'If' or k == 'While' or k == 'Break' or k == 'Continue' or k == 'CompAppend' or k == 'Pass'):
            # a try (its handlers can be entered from any point of its body) and the rest: no facts inside, and afterwards
            # every local it can assign is forgotten
            names: list[str] = []
            bound_names(s, names)
            outside = facts_kill(self.facts, names)
            self.facts_off += 1
            self.stmt_kind(s)
            self.facts_off -= 1
            self.facts = outside
            return
        self.stmt_kind(s)

    def for_facts(self, s: Node):
        # a for loop (or a comprehension's loop): its head is reached again after each pass, so the locals the loop assigns are
        # unknown at the start of every pass and after it; the rest keep their facts
        names: list[str] = []
        bound_names(s, names)
        inner = facts_kill(self.facts, names)
        saved_body = self.for_body
        saved_entry = self.for_entry
        self.for_entry = self.facts
        self.for_body = inner
        self.facts = facts_copy(inner)
        self.for_stmt(s)
        self.for_body = saved_body
        self.for_entry = saved_entry
        self.facts = facts_copy(inner)

    def stmt_kind(self, s: Node):
        k = s.kind
        if k == 'ExprStmt':
            e = val_node(s.fields[0])
            if e.kind != 'Call':
                shown_value = self.expr(e)
                self.release(shown_value)
                return
            result = self.call(e, True)
            self.release(result)               # a value nobody keeps is released at once
        elif k == 'Assign':
            target = val_node(s.fields[0])
            if target.kind == 'Index':
                self.assign_item(s, target)
                return
            if target.kind == 'Attr':
                self.assign_field(s, target)
                return
            if target.kind != 'Name':
                raise CompileError('cannot assign to this expression\nthe left side of = must be a variable, a field or an item', s.line)
            name = target.fields[0].text
            if name in self.settled:
                raise CompileError(f"'{name}' is known to be {shown(self.types[name])} after the check above, so it cannot be assigned here\nassign to it before the check", s.line)
            if name in self.narrowed:
                raise CompileError(f"'{name}' is known to be {shown(self.types[name])} inside this check, so it cannot be assigned here\nassign to it outside the check", s.line)
            expected = self.types[name] if name in self.slots else ''
            track = self.tracking()
            old_small = self.fact_small(name)        # the number the slot holds now owns nothing, so it needs no free
            after = self.facts
            if track:
                after = self.assign_facts(self.facts, name, val_node(s.fields[1]))
            if self.bail == '' and name in self.slots and self.types[name] == 'int' and (self_update(name, val_node(s.fields[1])) or self.fuse_update(name, val_node(s.fields[1]))):
                self.take_name = name
                self.taken = ex('', '')
            v = self.expr(val_node(s.fields[1]), expected)
            self.take_name = ''
            if self.taken.reg != '' and not self.taken.fresh and v.ty == 'int' and (v.fresh or v.small):
                # the operation used the old number up (freeing it if it was big), so the slot takes the result and frees nothing
                self.taken = ex('', '')
                var = self.slot(name, 'int', s.line)
                self.emit(f'store i64 {v.reg}, ptr {var}')
                if track:
                    self.facts = after
                return
            self.taken = ex('', '')
            slot_type = v.ty
            if name in self.slots:
                v = self.want(v, self.types[name], s.line, 'the assigned value')
                slot_type = self.types[name]
            if slot_type == 'None' or slot_type == '':
                raise CompileError(f"the type of '{name}' cannot be guessed from None\ndeclare it, such as: {name}: Item | None = None", s.line)
            self.store_owned(self.slot(name, slot_type, s.line), v, old_small)
            if track:
                self.facts = after
        elif k == 'Multi':
            self.block(val_nodes(s.fields[0]))
        elif k == 'Declare':
            ty = self.mod.type_name(s.fields[1])
            if ty == '':
                raise CompileError('this variable cannot be given a type automatically\nwrite its type, such as: name: Type = value', s.line)
            after = self.facts
            if self.tracking():
                after = facts_kill(self.facts, [s.fields[0].text])
                name = s.fields[0].text
                if ty == 'int' or ty == 'float':
                    after = self.assign_facts(self.facts, name, val_node(s.fields[2]))
                    if name in after.m and after.m[name].fl != (ty == 'float'):
                        after = facts_kill(after, [name])          # an int literal in a float variable
            v = self.expr(val_node(s.fields[2]), ty)
            v = self.want(v, ty, s.line, 'the value')
            self.store_owned(self.slot(s.fields[0].text, ty, s.line), v, self.bail != '' and ty == 'int' and s.fields[0].text in self.nest_names)
            if self.tracking():
                self.facts = after
        elif k == 'AsyncFor':
            self.async_for(s)
        elif k == 'Yield' and self.is_async:
            self.async_yield(s)
        elif k == 'Yield':
            self.yield_stmt(s)
        elif k == 'Return' and self.gen_n > 0:
            if s.fields[0].tag != 'z':
                raise CompileError("a generator cannot return a value\nuse yield to give out values", s.line)
            self.br(self.gens[self.gen_n - 1].end)
        elif k == 'Return':
            if s.fields[0].tag == 'z':
                if self.ret != '':
                    raise CompileError(f'this function must return a value of type {shown(self.ret)}\nwrite: return <value>', s.line)
            else:
                if self.ret == '':
                    raise CompileError('this function is declared to return nothing, so it cannot return a value\nremove the value, or add -> Type to the def', s.line)
                v = self.expr(val_node(s.fields[0]), self.ret)
                if v.ty == '' and self.ret == 'None':
                    v = ex('null', 'None')        # a generic function whose T is None returns what gives nothing: return await t
                v = self.want(v, self.ret, s.line, 'the returned value')
                v = self.owned(v)
                if self.is_async:
                    self.store_owned('%retval', v)        # a finally can wait, and can return again
                else:
                    self.emit(f'store {llvm_type(v.ty)} {v.reg}, ptr %retval')
            self.run_finallies(self.try_depth)
            self.br('epilogue')
        elif k == 'Raise':
            v = self.expr(val_node(s.fields[0]))
            if not self.mod.subclass(v.ty, '@Error'):
                raise CompileError(f'raise needs an error object, but this is {shown(v.ty)}\nwrite raise Error("message") or raise one of your Error subclasses', s.line)
            self.emit('store ptr ' + v.reg + ', ptr @tomato_exc')            # the pending error owns the reference
            self.emit(f'store i32 {s.line}, ptr @tomato_exc_line')
            self.trace(True)
            self.emit('store i32 0, ptr @tomato_exc_rt')
            self.emit('store i32 1, ptr @tomato_exc_seen')
            self.br(self.unwind_target())
        elif k == 'Try':
            self.try_stmt(s)
        elif k == 'If':
            self.if_stmt(s)
        elif k == 'While':
            self.while_stmt(s)
        elif k == 'For':
            self.for_stmt(s)
        elif k == 'Break':
            if self.loop_depth == 0:
                raise CompileError("'break' can only be used inside a loop", s.line)
            self.run_finallies(self.tries_in_loop())
            self.br(self.breaks[self.loop_depth - 1])
        elif k == 'Continue':
            if self.loop_depth == 0:
                raise CompileError("'continue' can only be used inside a loop", s.line)
            self.run_finallies(self.tries_in_loop())
            self.br(self.conts[self.loop_depth - 1])
        elif k == 'CompAppend':
            self.comp_append(s)
        elif k == 'Pass':
            pass
        else:
            raise CompileError(f'this kind of statement ({k}) is not supported here', s.line)

    def tries_in_loop(self) -> int:
        # how many of the innermost try statements sit inside the current loop
        n = 0
        k = self.try_depth
        while k > 0 and self.tries[k - 1].loop_depth == self.loop_depth:
            n += 1
            k -= 1
        return n

    def run_finallies(self, n: int):
        # run the finally blocks of the n innermost try statements, innermost first: a return, break or continue is
        # leaving them. A raise inside one of these blocks goes to the handlers outside its try (D22a).
        saved = self.try_depth
        for k in range(saved - 1, saved - n - 1, -1):
            if self.tries[k].has_final:
                self.try_depth = k
                self.block(self.tries[k].final)
        self.try_depth = saved

    def push_try(self, info: TryInfo):
        if self.try_depth < len(self.tries):
            self.tries[self.try_depth] = info
        else:
            self.tries.append(info)
        self.try_depth += 1

    def try_stmt(self, s: Node):
        handlers = s.fields[1].items
        for h in handlers:
            written = h.items[0].text
            ckey = self.mod.resolve(written)
            if ckey == '' or not self.mod.has_class(ckey) or not self.mod.subclass('@' + ckey, '@Error'):
                raise CompileError(f"'catch' needs an error class, but '{written}' is not one\nuse Error, RuntimeError, IOError or a class that extends Error", s.line)
        info = TryInfo()
        info.catch_l = self.label('catch')
        info.prop_l = self.label('prop')
        info.has_final = s.fields[3].tag == 'l'
        if info.has_final:
            info.final = val_nodes(s.fields[3])
        info.loop_depth = self.loop_depth
        else_l = self.label('tryelse')
        handled_l = self.label('tryhandled')
        end_l = self.label('tryend')
        self.push_try(info)
        self.block(val_nodes(s.fields[0]))
        if not self.terminated:
            self.br(else_l)
        # an error raised in the body arrives here with the pending error set
        self.place(info.catch_l)
        info.state = 'post'
        pending = self.tmp('ex')
        self.emit(f'{pending} = load ptr, ptr @tomato_exc')
        tp = self.tmp('tp')
        self.emit(f'{tp} = getelementptr {{ i64, i64 }}, ptr {pending}, i32 0, i32 1')
        raw = self.tmp('rawcode')
        self.emit(f'{raw} = load i64, ptr {tp}')
        code = self.tmp('code')
        self.emit(f'{code} = and i64 {raw}, 4294967295')
        for h in handlers:
            cname = self.mod.resolve(h.items[0].text)
            isa = self.tmp('isa')
            self.emit(isa + ' = call i32 @tomato_is_subclass(i64 ' + code + ', i64 ' + str(self.mod.code_of('@' + cname)) + ')')
            hit = self.tmp('hit')
            self.emit(f'{hit} = icmp ne i32 {isa}, 0')
            match = self.label('match')
            nxt = self.label('nomatch')
            self.cond_br(hit, match, nxt)
            self.place(match)
            self.emit('store ptr null, ptr @tomato_exc')             # handled: the catch variable takes the reference
            if self.mod.mode == 1:
                self.emit('call void @tomato_trace_clear()')
            if h.items[1].tag == 's':
                var = h.items[1].text
                reg = ''
                if var in self.slots and self.types[var] != '@' + cname:
                    reg = self.new_slot(var, '@' + cname)     # the name is bound again, to a new slot of the new type
                else:
                    reg = self.slot(var, '@' + cname, s.line)
                self.store_owned(reg, ex(pending, '@' + cname))
            else:
                self.emit(f'call void @tomato_release(ptr {pending})')
            self.block(val_nodes(h.items[2]))
            if not self.terminated:
                self.br(handled_l)
            self.place(nxt)
        self.br(info.prop_l)                                          # no clause matched: keep propagating
        self.place(else_l)
        if s.fields[2].tag == 'l':
            self.block(val_nodes(s.fields[2]))
        if not self.terminated:
            self.br(handled_l)
        # every normal way out of the statement runs the finally block once
        self.place(handled_l)
        self.try_depth -= 1
        if info.has_final:
            self.block(info.final)
        if not self.terminated:
            self.br(end_l)
        # an error is leaving the statement: park it while the finally block runs, then keep propagating
        self.place(info.prop_l)
        if info.has_final:
            hold = self.tmp('hold')
            self.make_slot(hold, 'File')
            held = self.tmp('pending')
            self.emit(f'{held} = load ptr, ptr @tomato_exc')
            self.emit(f'store ptr {held}, ptr {hold}')
            self.emit('store ptr null, ptr @tomato_exc')
            self.block(info.final)
            back = self.tmp('back')
            self.emit(f'{back} = load ptr, ptr {hold}')
            self.emit(f'store ptr {back}, ptr @tomato_exc')
        self.br(self.unwind_target())
        self.place(end_l)

    def assign_item(self, s: Node, target: Node):
        lst = self.unwrap(self.expr_b(val_node(target.fields[0]), [val_node(target.fields[1]), val_node(s.fields[1])]), s.line)
        if lst.ty.startswith('tuple['):
            raise CompileError('a tuple cannot be changed, so its items cannot be assigned\nuse a list if the items must change', s.line)
        # the object (unless it is a lent local) and the key or index are freed by the error path if a later part raises
        if is_dict(lst.ty):
            held_dict = len(self.held)
            self.hold(lst)
            k = self.expr(val_node(target.fields[1]))
            k = self.want(k, 'str', s.line, 'a dict key')
            self.hold(k)
            dv = self.expr(val_node(s.fields[1]), dict_value(lst.ty))
            dv = self.want(dv, dict_value(lst.ty), s.line, 'the assigned value')
            self.drop_held(held_dict)
            slot = self.tmp('slot')
            self.emit(f'{slot} = call ptr @tomato_dict_insert(ptr {lst.reg}, i64 {self.key_word(k)}, i32 0)')
            self.store_owned(slot, dv)
            self.release(k)
            self.release(lst)
            return
        if is_class(lst.ty):
            f = self.mod.find_op(lst.ty[1:], 'set')
            if f is None or len(f.ptypes) != 2 or f.ret != '':
                raise CompileError("'" + lst.ty[1:] + "' objects cannot be assigned by index\nadd a method marked @set that takes the index and the new item", s.line)
            held_before = len(self.held)
            self.hold(lst)
            si = self.want(self.expr(val_node(target.fields[1])), f.ptypes[0], s.line, 'an index')
            self.hold(si)
            sv = self.expr(val_node(s.fields[1]), f.ptypes[1])
            sv = self.want(sv, f.ptypes[1], s.line, 'the assigned item')
            self.drop_held(held_before)
            self.marker_call(lst, f, [si, sv], s.line)
            return
        if not is_list(lst.ty):
            raise CompileError('only list and dict items can be assigned by index', s.line)
        held_before = len(self.held)
        self.hold(lst)
        i = self.expr(val_node(target.fields[1]))
        i = self.want(i, 'int', s.line, 'an index')
        self.drop_held(held_before)
        i = ex(self.norm_index(lst, self.int_raw(i, [lst]), val_node(target.fields[1])), 'int')
        self.hold(lst)
        v = self.expr(val_node(s.fields[1]), elem_of(lst.ty))
        v = self.want(v, elem_of(lst.ty), s.line, 'the assigned item')
        self.drop_held(held_before)
        addr = self.list_slot(lst, i, [v, lst])
        if is_rc(v.ty):
            old = self.tmp('old')
            self.emit(f'{old} = load ptr, ptr {addr}')
            self.emit(f'store ptr {v.reg}, ptr {addr}')
            self.emit(f'call void @tomato_release(ptr {old})')
        elif v.ty == 'int':
            self.store_owned(addr, v, self.old_is_small(addr, [v, lst]))
        else:
            self.store_item(lst.ty, v, addr)
        self.release(lst)

    def narrow_target(self, cond: Node) -> list[str]:
        # `x in Type` where x is a union variable and Type is one of its members: [x, Type]; else []
        if cond.kind != 'BinOp' or cond.fields[0].text != 'in':
            return []
        l = val_node(cond.fields[1])
        if l.kind != 'Name':
            return []
        name = l.fields[0].text
        tt = self.type_operand(val_node(cond.fields[2]))
        if tt == '' or name not in self.slots:
            return []
        if not is_union(self.types[name]) or tt not in union_members(self.types[name]):
            return []
        return [name, tt]

    def enter_narrow(self, name: str, member: str) -> list[str]:
        # inside the branch the variable is the member's own type: a copy of the value taken out of the box.
        # When several members are left (member is a union) the variable keeps its box and only its type gets smaller.
        saved = [self.slots[name], self.types[name]]
        if is_union(member):
            self.types[name] = member
            self.narrowed.append(name)
            return saved
        holder = self.tmp('whole')
        self.emit(f'{holder} = load ptr, ptr {saved[0]}')
        inner = self.unbox_value(ex(holder, saved[1]), member)
        shadow = self.new_slot(name, member)
        self.store_owned(shadow, inner)
        self.narrowed.append(name)
        return saved

    def leave_narrow(self, name: str, saved: list[str]):
        self.slots[name] = saved[0]
        self.types[name] = saved[1]
        self.narrowed.pop()

    def narrow_to(self, name: str, keep: list[str]) -> list[str]:
        # the members `keep` of a union variable (one member gives that type, several a smaller union)
        if len(keep) == 1:
            return self.enter_narrow(name, keep[0])
        return self.enter_narrow(name, union_type(keep))

    def settle_narrow(self, name: str, keep: list[str]):
        # after an if whose other branches all left the block: the variable stays narrowed to the end of the block
        saved = self.narrow_to(name, keep)
        self.settled.append(name)
        self.after.append([name, saved[0], saved[1]])

    def end_block_narrowing(self, depth: int):
        while len(self.after) > depth:
            entry = self.after.pop()
            self.settled.pop()
            self.leave_narrow(entry[0], [entry[1], entry[2]])

    def if_stmt(self, s: Node):
        end = self.label('endif')
        var = ''                       # the union variable the first condition tests, if it does
        members: list[str] = []
        left: list[str] = []           # the members it can still be when the next condition is tested
        kept: list[str] = []           # the members it can be after the whole if, over the branches that do not leave
        branches = s.fields[0].items
        track = self.tracking()
        cur = self.facts              # the facts where the next condition is tested (all the conditions before it were false)
        outs = facts_dead()           # the facts after the if, over the branches that do not leave
        for k, branch in enumerate(branches):
            target = self.narrow_target(val_node(branch.items[0]))
            if k == 0 and len(target) > 0:
                var = target[0]
                members = union_members(self.types[var])
                left = members
            if track:
                self.facts = self.small_facts(self.live_facts(cur))
            cond = self.truth(self.expr(val_node(branch.items[0])), s.line)
            then = self.label('then')
            nxt = self.label('next')
            self.cond_br(cond, then, nxt)
            self.place(then)
            if track:
                self.facts = self.live_facts(self.refine(cur, val_node(branch.items[0]), True))
                cur = self.refine(cur, val_node(branch.items[0]), False)
            saved: list[str] = []
            # a later branch that does not test the variable still knows which members are left, so it cannot assign it
            rest_known = var != '' and k > 0 and not (len(target) > 0 and target[0] == var) and len(left) > 0 and len(left) < len(members)
            saved_rest: list[str] = []
            if rest_known:
                saved_rest = self.narrow_to(var, left)
            if len(target) > 0:
                saved = self.enter_narrow(target[0], target[1])
            self.block(val_nodes(branch.items[1]))
            if len(target) > 0:
                self.leave_narrow(target[0], saved)
            if rest_known:
                self.leave_narrow(var, saved_rest)
            if not self.terminated:
                if track:
                    outs = facts_join(outs, self.facts)
                self.br(end)
                if var != '' and len(target) > 0 and target[0] == var:
                    kept.append(target[1])
                elif var != '':
                    kept = kept + left
            if var != '' and len(target) > 0 and target[0] == var:
                left = [m for m in left if m != target[1]]
            self.place(nxt)
        if s.fields[1].tag == 'l':
            # `else:` knows the variable is one of the members no condition above matched
            narrowed_else = var != '' and len(left) > 0 and len(left) < len(members)
            saved = []
            if narrowed_else:
                saved = self.narrow_to(var, left)
            if track:
                self.facts = self.live_facts(cur)
            self.block(val_nodes(s.fields[1]))
            if narrowed_else:
                self.leave_narrow(var, saved)
            if not self.terminated:
                kept = kept + left
                if track:
                    outs = facts_join(outs, self.facts)
        else:
            kept = kept + left
            if track:
                outs = facts_join(outs, cur)
        if not self.terminated:
            self.br(end)
        self.place(end)
        if track:
            self.facts = self.live_facts(outs)
        if var != '' and len(kept) > 0 and self.types[var] == union_type(members):
            keep: list[str] = [m for m in members if m in kept]
            if len(keep) < len(members):
                self.settle_narrow(var, keep)

    # ---- integer ranges. While a function is compiled, self.facts says, for some int locals, an interval that certainly holds
    # the local's number at the point being compiled. Facts come from assignments (a literal, + - * and // % by a constant of
    # known numbers, a range loop's variable) and from the conditions of if and while; at the head of a `while` they are the
    # result of a fixpoint over the loop body (loop_facts). A local whose interval is inside the small range holds a tagged
    # small int, so its reads need no tag test, and a + - * whose result interval is inside the small range needs no overflow
    # check. The facts are a sound approximation by construction: each statement's effect is either modelled exactly (an
    # assignment to a local, if, while, break, continue) or every local it can assign is forgotten (bound_names).
    def tracking(self) -> bool:
        return self.facts_off == 0 and not self.is_async and self.gen_n == 0

    def range_of(self, n: Node, f: Facts) -> Rng | None:
        # the interval of an int expression's value under the facts f, or None when it is unknown (or not an int)
        k = n.kind
        if k == 'IntLit':
            return rng(n.fields[0].num, n.fields[0].num)
        if k == 'FloatLit':
            return float_literal_range(n.fields[0].num, n.fields[1].num)
        if k == 'Name':
            name = n.fields[0].text
            if name in f.m:
                return f.m[name]
            if name in self.slots:
                return None
            ck = self.mod.resolve(name)
            if ck != '' and ck in self.mod.consts:
                return self.range_of(self.mod.consts[ck], f)
            return None
        if k == 'UnOp':
            if n.fields[0].text != '-':
                return None
            inner = self.range_of(val_node(n.fields[1]), f)
            if inner is None:
                return None
            if inner.fl:
                return frng(-inner.hi, -inner.lo)
            return rng_neg(inner)
        if k == 'Call':
            return self.len_range(n)
        if k != 'BinOp':
            return None
        op = n.fields[0].text
        if not (op == '+' or op == '-' or op == '*' or op == '//' or op == '%' or op == '/'):
            return None
        a = self.range_of(val_node(n.fields[1]), f)
        if a is None:
            return None
        if op == '/':
            return self.quotient_range(a, val_node(n.fields[2]), f)
        b = self.range_of(val_node(n.fields[2]), f)
        if b is None:
            return None
        if a.fl or b.fl:
            if op == '//' or op == '%':
                return None
            x = frng_of(a)
            y = frng_of(b)
            if x is None or y is None:
                return None
            return frng_op(op, x, y)
        if op == '+':
            return rng_add(a, b)
        if op == '-':
            return rng_add(a, rng_neg(b))
        if op == '*':
            return rng_mul(a, b)
        if b.lo != b.hi or b.lo == 0 or b.lo >= RANGE_INF or b.lo <= -RANGE_INF:
            return None                       # only a constant divisor
        d = b.lo
        if op == '//':
            return rng_floordiv(a, d)
        # floor modulo: the sign of the divisor
        if d > 0:
            if a.lo >= 0 and a.hi < d:
                return a
            return rng(0, d - 1)
        if a.hi <= 0 and a.lo > d:
            return a
        return rng(d + 1, 0)

    def quotient_range(self, a: Rng, divisor: Node, f: Facts) -> Rng | None:
        # the interval of a / divisor (a float) when the division did not fail, so the divisor is not 0
        x = frng_of(a)
        if x is None or not frng_bounded(x):
            return None
        if self.int_typed(divisor):
            # a whole number that is not 0 has a magnitude of 1 or more (as a float too, where a huge one is infinity: 0 then)
            return frng_hull(frng_reach(x))
        if divisor.kind == 'FloatLit':
            m = divisor.fields[0].num
            s = divisor.fields[1].num
            if m > 0 and s >= 0 and s <= 80 and m < 10 ** 80:
                # x * 10^s / m, doubled to cover the rounding of the divisor and of the quotient (off by one part in 2^52)
                return frng_hull(frng_reach(x) * 10 ** s // m * 2 + 2)
        return None

    def int_typed(self, n: Node) -> bool:
        # an expression whose value is certainly a whole number (int or fixed-width)
        k = n.kind
        if k == 'IntLit':
            return True
        if k == 'Name':
            name = n.fields[0].text
            if name in self.slots:
                return is_numeric(self.types[name])
            ck = self.mod.resolve(name)
            return ck != '' and ck in self.mod.consts and self.mod.consts[ck].kind == 'IntLit'
        if k == 'BinOp':
            op = n.fields[0].text
            if op == '+' or op == '-' or op == '*' or op == '//' or op == '%':
                return self.int_typed(val_node(n.fields[1])) and self.int_typed(val_node(n.fields[2]))
        return False

    def len_range(self, n: Node) -> Rng | None:
        # len(xs) of a local list, tuple, dict, set or text: a count the runtime keeps, given back as a small number (len_of)
        f = val_node(n.fields[0])
        args = val_nodes(n.fields[1])
        if f.kind != 'Name' or f.fields[0].text != 'len' or 'len' in self.slots or len(args) != 1 or len(n.fields[2].items) > 0:
            return None
        a = args[0]
        if a.kind != 'Name' or a.fields[0].text not in self.slots:
            return None
        t = self.types[a.fields[0].text]
        if is_optional(t) or '|' in t or not (is_list(t) or is_dict(t) or is_set(t) or t == 'str'):
            return None
        return rng(0, SMALL_HI)

    def fact_small(self, name: str) -> bool:
        return self.tracking() and name in self.facts.m and rng_small(self.facts.m[name])

    def refine(self, f: Facts, c: Node, truth: bool, depth: int = 0) -> Facts:
        # the facts that hold where the condition c has just been found truth. Below `and` and `or` the left side is refined
        # for both outcomes, so nested conditions are only followed REFINE_DEPTH levels deep (keeping f is always sound).
        if f.dead:
            return f
        if c.kind == 'BoolLit':
            if c.fields[0].flag != truth:
                return facts_dead()
            return f
        if depth >= REFINE_DEPTH:
            return f
        if c.kind == 'UnOp' and c.fields[0].text == 'not':
            return self.refine(f, val_node(c.fields[1]), not truth, depth + 1)
        if c.kind != 'BinOp':
            return f
        op = c.fields[0].text
        left = val_node(c.fields[1])
        right = val_node(c.fields[2])
        d = depth + 1
        if op == 'and':
            if truth:
                return self.refine(self.refine(f, left, True, d), right, True, d)
            return facts_join(self.refine(f, left, False, d), self.refine(self.refine(f, left, True, d), right, False, d))
        if op == 'or':
            if truth:
                return facts_join(self.refine(f, left, True, d), self.refine(self.refine(f, left, False, d), right, True, d))
            return self.refine(self.refine(f, left, False, d), right, False, d)
        if not is_compare_op(op):
            return f
        if not truth:
            op = negate_compare(op)
        a = self.range_of(left, f)
        b = self.range_of(right, f)
        if a is None or b is None:
            return f                          # not two numbers with known intervals (a text, an object, ...)
        if a.fl or b.fl:
            return self.refine_float(f, op, left, a, right, b)
        g = f
        if left.kind == 'Name' and left.fields[0].text in f.m:
            g = self.narrow_fact(g, left.fields[0].text, op, b)
        if right.kind == 'Name' and right.fields[0].text in g.m:
            g = self.narrow_fact(g, right.fields[0].text, flip_compare(op), a)
        return g

    def refine_float(self, f: Facts, op: str, left: Node, a: Rng, right: Node, b: Rng) -> Facts:
        # the facts after `left OP right` was found true, when one side is a float. Both sides have known intervals, so they are
        # finite numbers (never NaN) and an untrue comparison means the opposite one. Only float locals are narrowed.
        x = frng_of(a)
        y = frng_of(b)
        if x is None or y is None:
            return f
        g = f
        if left.kind == 'Name':
            g = self.narrow_float(g, left.fields[0].text, op, y)
        if right.kind == 'Name':
            g = self.narrow_float(g, right.fields[0].text, flip_compare(op), x)
        if (op == '<' or op == '<=' or op == '==') and y.hi < FLOAT_INF and y.hi >= 0:
            g = self.narrow_squares(g, left, y.hi, f)
        if (op == '>' or op == '>=' or op == '==') and x.hi < FLOAT_INF and x.hi >= 0:
            g = self.narrow_squares(g, right, x.hi, f)
        return g

    def narrow_float(self, f: Facts, name: str, op: str, other: Rng) -> Facts:
        # the facts after `name OP other` was found true, for a float local with an interval
        if f.dead or name not in f.m or not f.m[name].fl:
            return f
        lo = f.m[name].lo
        hi = f.m[name].hi
        if op == '<' or op == '<=' or op == '==':
            hi = b_min(hi, other.hi)
        if op == '>' or op == '>=' or op == '==':
            lo = b_max(lo, other.lo)
        if lo > hi:
            return facts_dead()
        return facts_set(f, name, frng(lo, hi))

    def square_of(self, n: Node, f: Facts) -> str:
        # the name of a float local with an interval when n is name * name, else ''
        if n.kind != 'BinOp' or n.fields[0].text != '*':
            return ''
        x = val_node(n.fields[1])
        y = val_node(n.fields[2])
        if x.kind != 'Name' or y.kind != 'Name' or x.fields[0].text != y.fields[0].text:
            return ''
        name = x.fields[0].text
        if name in f.m and f.m[name].fl:
            return name
        return ''

    def narrow_squares(self, g: Facts, n: Node, h: int, f: Facts) -> Facts:
        # the facts g after the finite float n was found to be at most h: in a sum of numbers that are not negative, each part is
        # at most the sum (rounding keeps order), so each x * x in it bounds x
        name = self.square_of(n, f)
        if name != '':
            if g.dead or name not in g.m:
                return g
            r = root_bound(h)
            lo = b_max(g.m[name].lo, -r)
            hi = b_min(g.m[name].hi, r)
            if lo > hi:
                return facts_dead()
            return facts_set(g, name, frng(lo, hi))
        if n.kind != 'BinOp' or n.fields[0].text != '+':
            return g
        x = val_node(n.fields[1])
        y = val_node(n.fields[2])
        if self.not_negative(x, f) and self.not_negative(y, f):
            return self.narrow_squares(self.narrow_squares(g, x, h, f), y, h, f)
        return g

    def not_negative(self, n: Node, f: Facts) -> bool:
        if self.square_of(n, f) != '':
            return True
        if n.kind == 'BinOp' and n.fields[0].text == '+':
            return self.not_negative(val_node(n.fields[1]), f) and self.not_negative(val_node(n.fields[2]), f)
        r = self.range_of(n, f)
        return r is not None and r.lo >= 0

    def narrow_fact(self, f: Facts, name: str, op: str, other: Rng) -> Facts:
        # the facts after `name OP other` was found true
        if f.dead:
            return f
        cur = f.m[name]
        lo = cur.lo
        hi = cur.hi
        if op == '<':
            hi = b_min(hi, b_add(other.hi, -1, True))
        elif op == '<=':
            hi = b_min(hi, other.hi)
        elif op == '>':
            lo = b_max(lo, b_add(other.lo, 1, False))
        elif op == '>=':
            lo = b_max(lo, other.lo)
        elif op == '==':
            lo = b_max(lo, other.lo)
            hi = b_min(hi, other.hi)
        elif op == '!=' and other.lo == other.hi and other.lo > -RANGE_INF and other.lo < RANGE_INF:
            if lo == other.lo:
                lo = b_add(lo, 1, False)
            if hi == other.lo:
                hi = b_add(hi, -1, True)
        if rng_empty(lo, hi):
            return facts_dead()
        return facts_set(f, name, rng(lo, hi))

    def assign_facts(self, f: Facts, name: str, value: Node) -> Facts:
        # the facts after `name = value` (computed with the facts from before the assignment)
        g = facts_kill(f, [name])
        if name in self.slots and self.types[name] != 'int' and self.types[name] != 'float':
            return g
        r = self.range_of(value, f)
        if r is None or (name in self.slots and r.fl != (self.types[name] == 'float')):
            return g
        g.m[name] = r
        return g

    def ai_block(self, body: list[Node], f: Facts, ctx: LoopAI) -> Facts:
        # the facts after running body from f (dead when it always leaves by break, continue, return or raise). Breaks and
        # continues of the loop being analysed record their facts in ctx.
        for s in body:
            if f.dead:
                return f
            f = self.ai_stmt(s, f, ctx)
        return f

    def ai_stmt(self, s: Node, f: Facts, ctx: LoopAI) -> Facts:
        comps: list[str] = []
        comp_names(s, comps)
        if len(comps) > 0:
            f = facts_kill(f, comps)
        k = s.kind
        if k == 'Pass' or k == 'ExprStmt' or k == 'CompAppend':
            return f
        if k == 'Assign':
            t = val_node(s.fields[0])
            if t.kind != 'Name':
                return f
            return self.assign_facts(f, t.fields[0].text, val_node(s.fields[1]))
        if k == 'Multi':
            return self.ai_block(val_nodes(s.fields[0]), f, ctx)
        if k == 'If':
            outs = facts_dead()
            cur = f
            for branch in s.fields[0].items:
                cond = val_node(branch.items[0])
                outs = facts_join(outs, self.ai_block(val_nodes(branch.items[1]), self.refine(cur, cond, True), ctx))
                cur = self.refine(cur, cond, False)
            if s.fields[1].tag == 'l':
                cur = self.ai_block(val_nodes(s.fields[1]), cur, ctx)
            return facts_join(outs, cur)
        if k == 'Break':
            ctx.brks.append(f)
            return facts_dead()
        if k == 'Continue':
            ctx.conts.append(f)
            return facts_dead()
        if k == 'Return' or k == 'Raise':
            return facts_dead()
        # anything else (a nested loop, try, a declaration): forget every local it can assign. A break or continue inside it
        # that leaves this loop (from a try) leaves with those facts too.
        names: list[str] = []
        bound_names(s, names)
        g = facts_kill(f, names)
        if k != 'For' and k != 'While' and k != 'AsyncFor' and loop_jump(s):
            ctx.brks.append(g)
            ctx.conts.append(g)
        return g

    def loop_back(self, h: Facts, cond: Node, body: list[Node], ctx: LoopAI) -> Facts:
        # the facts that come back to the head of `while cond: body` after one pass that started at the head with h
        out = self.ai_block(body, self.refine(h, cond, True), ctx)
        for c in ctx.conts:
            out = facts_join(out, c)
        return out

    def loop_facts(self, s: Node, entry: Facts) -> LoopFacts:
        # the facts at the head of a while loop and after it. The head facts are a post-fixpoint: entry joined with what one
        # pass of the body gives back from them is inside them, so they hold on every pass. Found by joining passes (widening
        # a bound that keeps moving), then narrowed with two more passes (each again a post-fixpoint).
        cond = val_node(s.fields[0])
        body = val_nodes(s.fields[1])
        out = LoopFacts()
        names: list[str] = []
        bound_names(s, names)
        out.head = facts_kill(entry, names)
        out.post = out.head
        if not self.tracking() or has_comp(cond):
            return out
        h = entry
        rounds = 0
        while True:
            nxt = facts_join(entry, self.loop_back(h, cond, body, LoopAI()))
            if rounds >= 2:
                nxt = facts_widen(h, nxt)
            if facts_same(nxt, h):
                break
            h = nxt
            rounds += 1
            if rounds > 100:
                return out
        for _ in range(2):
            h = facts_join(entry, self.loop_back(h, cond, body, LoopAI()))
        ctx = LoopAI()
        self.loop_back(h, cond, body, ctx)
        post = self.refine(h, cond, False)
        for b in ctx.brks:
            post = facts_join(post, b)
        out.head = h
        out.post = post
        return out

    def live_facts(self, f: Facts) -> Facts:
        # facts for compiling code: a point no run reaches may assume nothing (its code never runs)
        if f.dead:
            return facts_new()
        return facts_copy(f)

    # ---- small-integer loops. A `while` whose body is only int arithmetic on local variables (assignments built from + - * and
    # // % by a power of two, if/elif/else on comparisons) is compiled twice. The fast copy assumes every int variable it uses holds a
    # small number (checked once when the loop is entered, and again each time the general copy comes back to the loop head): it has no
    # tag tests, no big-number calls and no frees, and an operation that would leave the small range jumps to the start of the same
    # statement in the general copy (nothing of that statement has been stored yet), which carries on with big numbers as before.
    # Inside the fast copy every variable is a small number at every point, whatever else is known about it (fast_facts); an
    # operation whose result interval is then inside the small range needs no overflow check.
    def fast_facts(self, f: Facts, names: list[str]) -> Facts:
        # the facts f at a point of the fast copy, with the interval of every variable cut to the small range
        g = facts_new()
        for k in f.m:
            g.m[k] = f.m[k]
        for name in names:
            lo = SMALL_LO
            hi = SMALL_HI
            if name in f.m and not f.dead:
                lo = b_max(lo, f.m[name].lo)
                hi = b_min(hi, f.m[name].hi)
            if lo > hi:                      # no run reaches this point
                lo = SMALL_LO
                hi = SMALL_HI
            g.m[name] = rng(lo, hi)
        return g

    def fast_known(self, n: Node, f: Facts) -> bool:
        r = self.range_of(n, f)
        return r is not None and rng_small(r)

    def fast_expr_ok(self, n: Node, names: list[str]) -> bool:
        if n.kind == 'IntLit':
            return n.fields[0].num < 2 ** 60
        if n.kind == 'UnOp':
            inner = val_node(n.fields[1])
            return n.fields[0].text == '-' and inner.kind == 'IntLit' and inner.fields[0].num < 2 ** 60
        if n.kind == 'Name':
            name = n.fields[0].text
            if name not in self.slots or self.types[name] != 'int' or name in self.narrowed or name in self.settled:
                return False
            if name not in names:
                names.append(name)
            return True
        if n.kind != 'BinOp':
            return False
        op = n.fields[0].text
        left = val_node(n.fields[1])
        right = val_node(n.fields[2])
        if op == '//' or op == '%':
            if right.kind != 'IntLit' or not self.is_pow2_literal(right.fields[0].num):
                return False
        elif op != '+' and op != '-' and op != '*':
            return False
        return self.fast_expr_ok(left, names) and self.fast_expr_ok(right, names)

    def is_pow2_literal(self, v: int) -> bool:
        # 2, 4, 8, ... up to 2**60
        if v < 2 or v > 2 ** 60:
            return False
        while v > 1:
            if v % 2 != 0:
                return False
            v //= 2
        return True

    def fast_cond_ok(self, n: Node, names: list[str]) -> bool:
        if n.kind != 'BinOp':
            return False
        op = n.fields[0].text
        if not (op == '==' or op == '!=' or op == '<' or op == '<=' or op == '>' or op == '>='):
            return False
        return self.fast_expr_ok(val_node(n.fields[1]), names) and self.fast_expr_ok(val_node(n.fields[2]), names)

    def fast_stmts_ok(self, body: list[Node], names: list[str], counter: list[int]) -> bool:
        # also numbers the statements (Node.mark) that the fast copy may jump back to
        for s in body:
            if s.kind == 'Pass':
                continue
            if s.kind == 'Assign':
                t = val_node(s.fields[0])
                if t.kind != 'Name' or t.fields[0].text not in self.slots or self.types[t.fields[0].text] != 'int' or t.fields[0].text in self.narrowed or t.fields[0].text in self.settled:
                    return False
                if t.fields[0].text not in names:
                    names.append(t.fields[0].text)
                if not self.fast_expr_ok(val_node(s.fields[1]), names):
                    return False
                counter[0] += 1
                s.mark = counter[0]
            elif s.kind == 'If':
                counter[0] += 1
                s.mark = counter[0]
                for branch in s.fields[0].items:
                    if not self.fast_cond_ok(val_node(branch.items[0]), names):
                        return False
                    if not self.fast_stmts_ok(val_nodes(branch.items[1]), names, counter):
                        return False
                if s.fields[1].tag == 'l' and not self.fast_stmts_ok(val_nodes(s.fields[1]), names, counter):
                    return False
            else:
                return False
        return True

    def clear_marks(self, body: list[Node]):
        for s in body:
            s.mark = 0
            if s.kind == 'If':
                for branch in s.fields[0].items:
                    self.clear_marks(val_nodes(branch.items[1]))
                if s.fields[1].tag == 'l':
                    self.clear_marks(val_nodes(s.fields[1]))

    def fast_checked(self, intr: str, a: str, b: str, bail: str) -> str:
        # a 64-bit operation on tagged words whose overflow means "the result is outside the small range" (see tomato_int_add_c)
        name = f'llvm.{intr}.with.overflow.i64'
        self.mod.declare(f'declare {{i64, i1}} @{name}(i64, i64)')
        pair = self.tmp('pair')
        self.emit(f'{pair} = call {{i64, i1}} @{name}(i64 {a}, i64 {b})')
        r = self.tmp('r')
        self.emit(f'{r} = extractvalue {{i64, i1}} {pair}, 0')
        ov = self.tmp('ov')
        self.emit(f'{ov} = extractvalue {{i64, i1}} {pair}, 1')
        self.fast_bail(ov, bail)
        return r

    def fast_bail(self, over: str, bail: str):
        # leave the fast copy when over is true; without a label, only remember it (see fast_choice)
        if bail == '':
            if self.fast_over == '':
                self.fast_over = over
            else:
                both = self.tmp('ov')
                self.emit(f'{both} = or i1 {self.fast_over}, {over}')
                self.fast_over = both
            return
        if bail == self.bail:
            self.bail_if(over)
            return
        ok = self.label('fastok')
        self.cond_br(over, bail, ok)
        self.place(ok)

    def fast_line(self, n: Node, var: str, a: int, b: int, bail: str, f: Facts) -> str:
        # a * x + b for constants a and b: instead of an overflow test per operation, one test that x lies where the result is small.
        # On tagged words, 2(av + b) + 1 is a * (2v + 1) + (2b + 1 - a).
        x = self.tmp('fl')
        self.emit(f'{x} = load i64, ptr {self.slots[var]}')
        if not self.fast_known(n, f):
            lo = 0
            hi = 0
            if a > 0:
                lo = -((SMALL_HI + 1 + b) // a)        # the least v with a*v + b >= -2^62
                hi = (SMALL_HI - b) // a
            else:
                lo = -((SMALL_HI - b) // (-a))
                hi = (SMALL_HI + 1 + b) // (-a)
            off = self.arith('sub', x, str(2 * lo + 1))
            over = self.tmp('ov')
            self.emit(f'{over} = icmp ugt i64 {off}, {2 * (hi - lo)}')
            self.fast_bail(over, bail)
        p = self.arith('mul', x, str(a))
        return self.arith('add', p, str(2 * b + 1 - a))

    def fast_expr(self, n: Node, bail: str, f: Facts) -> str:
        if n.kind == 'IntLit':
            return str(n.fields[0].num * 2 + 1)
        if n.kind == 'UnOp':
            return str(1 - val_node(n.fields[1]).fields[0].num * 2)
        if n.kind == 'Name':
            r = self.tmp('fl')
            self.emit(f'{r} = load i64, ptr {self.slots[n.fields[0].text]}')
            return r
        op = n.fields[0].text
        lin: list[int] = []
        var = fast_linear(n, lin)
        if var != '' and (lin[0] > 1 or lin[0] < -1):
            return self.fast_line(n, var, lin[0], lin[1], bail, f)
        a = self.fast_expr(val_node(n.fields[1]), bail, f)
        if op == '//' or op == '%':
            v = val_node(n.fields[2]).fields[0].num
            k = 0
            while v > 1:
                v //= 2
                k += 1
            if op == '//':
                s = self.arith('ashr', a, str(k))
                return self.arith('or', s, '1')
            m = self.arith('and', a, str(2 ** (k + 1) - 2))
            return self.arith('or', m, '1')
        b = self.fast_expr(val_node(n.fields[2]), bail, f)
        if self.fast_known(n, f):
            # the result is small: plain arithmetic on the tagged words (see small_arith)
            if op == '+':
                return self.arith('add nsw', a, self.arith('sub', b, '1'))
            if op == '-':
                return self.arith('sub nsw', a, self.arith('sub', b, '1'))
            return self.arith('or', self.arith('mul nsw', self.arith('sub', a, '1'), self.arith('ashr', b, '1')), '1')
        if op == '+':
            return self.fast_checked('sadd', a, self.arith('sub', b, '1'), bail)
        if op == '-':
            return self.fast_checked('ssub', a, self.arith('sub', b, '1'), bail)
        am = self.arith('sub', a, '1')
        bm = self.arith('ashr', b, '1')
        p = self.fast_checked('smul', am, bm, bail)
        return self.arith('or', p, '1')

    def fast_cond(self, n: Node, bail: str, f: Facts) -> str:
        op = n.fields[0].text
        a = self.fast_expr(val_node(n.fields[1]), bail, f)
        b = self.fast_expr(val_node(n.fields[2]), bail, f)
        c = self.tmp('fc')
        self.emit(f'{c} = icmp {signed_cc(op)} i64 {a}, {b}')
        return c

    def fast_choice(self, s: Node) -> bool:
        # if c: x = a / else: x = b, where a and b are short sums and products: both are worked out and one is selected, so a
        # condition that cannot be predicted (is this number even?) costs no branch
        if len(s.fields[0].items) != 1 or s.fields[1].tag != 'l':
            return False
        yes = val_nodes(s.fields[0].items[0].items[1])
        no = val_nodes(s.fields[1])
        if len(yes) != 1 or len(no) != 1 or yes[0].kind != 'Assign' or no[0].kind != 'Assign':
            return False
        if val_node(yes[0].fields[0]).fields[0].text != val_node(no[0].fields[0]).fields[0].text:
            return False
        return node_count(val_node(yes[0].fields[1]), 8) <= 5 and node_count(val_node(no[0].fields[1]), 8) <= 5

    def fast_block(self, body: list[Node], prefix: str, f: Facts, names: list[str]) -> Facts:
        # compiles body from the facts f and gives the facts after it
        for s in body:
            if s.kind == 'Pass':
                continue
            bail = f'{prefix}_{s.mark}'
            if s.kind == 'If' and self.fast_choice(s):
                pick = val_node(s.fields[0].items[0].items[0])
                picked = val_node(val_nodes(s.fields[1])[0].fields[0]).fields[0].text
                c0 = self.fast_cond(pick, bail, f)
                joined = facts_dead()
                over: list[str] = []
                values: list[str] = []
                for yes in [True, False]:
                    side = val_nodes(s.fields[0].items[0].items[1])[0] if yes else val_nodes(s.fields[1])[0]
                    self.fast_over = ''
                    values.append(self.fast_expr(val_node(side.fields[1]), '', f))     # worked out whatever the condition says, so it may not count on it
                    there = self.fast_facts(self.refine(f, pick, yes), names)
                    joined = facts_join(joined, self.fast_facts(self.assign_facts(there, picked, val_node(side.fields[1])), names))
                    if self.fast_over != '':
                        over.append(self.fast_over)
                # leaving the fast copy because of the side that is not chosen is harmless: the general copy does the same work
                for bad in over:
                    self.fast_bail(bad, bail)
                chosen = self.tmp('pick')
                self.emit(f'{chosen} = select i1 {c0}, i64 {values[0]}, i64 {values[1]}')
                self.emit(f'store i64 {chosen}, ptr {self.slots[picked]}')
                f = joined
                continue
            if s.kind == 'Assign':
                v = self.fast_expr(val_node(s.fields[1]), bail, f)
                name = val_node(s.fields[0]).fields[0].text
                self.emit(f'store i64 {v}, ptr {self.slots[name]}')
                f = self.fast_facts(self.assign_facts(f, name, val_node(s.fields[1])), names)
                continue
            end = self.label('fendif')
            outs = facts_dead()
            for branch in s.fields[0].items:
                cond = val_node(branch.items[0])
                c = self.fast_cond(cond, bail, f)
                then = self.label('fthen')
                nxt = self.label('fnext')
                self.cond_br(c, then, nxt)
                self.place(then)
                after = self.fast_block(val_nodes(branch.items[1]), prefix, self.fast_facts(self.refine(f, cond, True), names), names)
                outs = facts_join(outs, after)
                self.br(end)
                self.place(nxt)
                f = self.fast_facts(self.refine(f, cond, False), names)
            if s.fields[1].tag == 'l':
                f = self.fast_block(val_nodes(s.fields[1]), prefix, f, names)
            self.br(end)
            self.place(end)
            f = facts_join(outs, f)
        return f

    def small_loop(self, s: Node, lf: LoopFacts) -> bool:
        # compile `while` as the fast copy plus the general copy when its body qualifies; False means nothing was emitted
        if self.is_async or self.gen_n > 0:
            return False
        names: list[str] = []
        counter = [0]
        cond = val_node(s.fields[0])
        body = val_nodes(s.fields[1])
        ok = len(body) > 0 and self.fast_cond_ok(cond, names) and self.fast_stmts_ok(body, names, counter)
        if not ok:
            self.clear_marks(body)
            return False
        prefix = self.label('rb')
        saved_prefix = self.mark_prefix
        self.mark_prefix = prefix
        fhead = self.label('fwhile')
        fbody = self.label('fbody')
        ghead = self.label('while')
        gcond = self.label('gcond')
        gbody = self.label('body')
        end = self.label('endwhile')
        self.br(ghead)
        # the general loop head: every variable small (bit 0 of the AND of the words is set) -> the fast copy
        self.place(ghead)
        acc = ''
        for name in names:
            w = self.tmp('sm')
            self.emit(f'{w} = load i64, ptr {self.slots[name]}')
            if acc == '':
                acc = w
            else:
                acc = self.arith('and', acc, w)
        bit = self.arith('and', acc, '1')
        small = self.tmp('small')
        self.emit(f'{small} = icmp ne i64 {bit}, 0')
        self.cond_br(small, fhead, gcond)
        self.place(fhead)
        known = facts_new()
        if self.tracking():
            known = lf.head
        known = self.fast_facts(known, names)
        fc = self.fast_cond(cond, gcond, known)
        self.cond_br(fc, fbody, end)
        self.place(fbody)
        self.fast_block(body, prefix, self.fast_facts(self.refine(known, cond, True), names), names)
        self.br(fhead)
        self.place(gcond)
        track = self.tracking()
        if track:
            self.facts = self.live_facts(lf.head)
        c = self.truth(self.expr(cond), s.line)
        self.cond_br(c, gbody, end)
        self.place(gbody)
        if track:
            self.facts = self.live_facts(self.refine(lf.head, cond, True))
        self.push_loop(end, ghead)
        self.block(body)
        self.loop_depth -= 1
        if not self.terminated:
            self.br(ghead)
        self.place(end)
        self.mark_prefix = saved_prefix
        self.clear_marks(body)
        return True

    def while_stmt(self, s: Node):
        track = self.tracking()
        lf = self.loop_facts(s, self.facts)
        if not (self.nest_fast and s.spot > 0) and self.small_loop(s, lf):
            self.nest_plain.append(s.spot)
            if track:
                self.facts = self.live_facts(lf.post)
            return
        head = self.nest_label(s, 'while')
        body = self.label('body')
        end = self.label('endwhile')
        kept = self.keep_lists(s, val_nodes(s.fields[1]), val_node(s.fields[0]))
        self.br(head)
        self.place(head)
        self.nest_head(s)
        if track:
            self.facts = self.small_facts(self.live_facts(lf.head))
        cond = self.truth(self.expr(val_node(s.fields[0])), s.line)
        self.cond_br(cond, body, end)
        self.place(body)
        if track:
            self.facts = self.live_facts(self.refine(lf.head, val_node(s.fields[0]), True))
        self.push_loop(end, head)
        self.block(val_nodes(s.fields[1]))
        self.loop_depth -= 1
        if not self.terminated:
            self.br(head)
        self.place(end)
        self.drop_lists(kept)
        if track:
            self.facts = self.live_facts(lf.post)

    def gen_push(self, c: GenCtx):
        if len(self.gens) > self.gen_n:
            self.gens[self.gen_n] = c
        else:
            self.gens.append(c)
        self.gen_n += 1

    def swap_scope(self, c: GenCtx):
        # exchange the names in scope with those the context keeps: the caller's loop body and the generator's body each see their own variables
        self.slots, c.slots = c.slots, self.slots
        self.types, c.types = c.types, self.types
        self.narrowed, c.narrowed = c.narrowed, self.narrowed
        self.settled, c.settled = c.settled, self.settled
        self.ret, c.ret = c.ret, self.ret
        self.owner, c.owner = c.owner, self.owner
        self.in_init, c.in_init = c.in_init, self.in_init
        self.mod.cur, c.module = c.module, self.mod.cur
        self.mod.tvars, c.targs = c.targs, self.mod.tvars

    def gen_args(self, info: FuncInfo, args: list[Node], line: int) -> list[Ex]:
        if info.stars > 0:
            raise CompileError(f"the generator '{info.name}' cannot take *args or **kwargs", line)
        required = len(info.ptypes) - len(info.defaults)
        if len(args) < required or len(args) > len(info.ptypes):
            raise CompileError("'" + info.name + "' takes " + plural(len(info.ptypes), 'argument') + ', but ' + str(len(args)) + ' given', line)
        return self.args_with_defaults(args, info.ptypes, info.defaults, line, "'" + info.name + "'")

    # the arguments of a call, then the defaults of the parameters it leaves out, each checked against its parameter's type
    def args_with_defaults(self, args: list[Node], ptypes: list[str], defaults: list[Node], line: int, callee: str) -> list[Ex]:
        required = len(ptypes) - len(defaults)
        vals: list[Ex] = []
        held_before = len(self.held)
        for k, a in enumerate(args):
            v = self.expr(a, ptypes[k])
            vals.append(self.want(v, ptypes[k], line, 'argument ' + str(k + 1) + ' of ' + callee))
            self.hold(vals[-1])
        for k in range(len(args), len(ptypes)):
            v = self.expr(defaults[k - required], ptypes[k])
            vals.append(self.want(v, ptypes[k], line, 'the default of argument ' + str(k + 1) + ' of ' + callee))
            self.hold(vals[-1])
        self.drop_held(held_before)
        return vals

    def inline_gen(self, s: Node, info: FuncInfo, recv: Ex, vals: list[Ex], line: int):
        # for x in <generator>: the generator's body is compiled right here, as part of the loop. Each `yield v` sets x to v and
        # runs the loop body; `break` leaves the whole thing and `continue` goes on after the yield. Nothing is built up in memory.
        if info.ret == '':
            raise CompileError(f"the generator '{info.name}' must say what it yields\nadd -> Type to its def, such as -> int", line)
        if self.gen_n >= 6:
            raise CompileError("generators are nested too deeply here\na generator cannot loop over itself", line)
        node = self.mod.node_of(info)
        var = self.slot(s.fields[0].text, info.ret, s.line)
        c = GenCtx()
        c.var = var
        c.ty = info.ret
        c.body = val_nodes(s.fields[2])
        c.end = self.label('endgen')
        c.try_depth = self.try_depth
        c.owner = info.owner
        c.module = info.module
        c.targs = info.targs
        self.facts_off += 1
        self.swap_scope(c)
        self.gen_push(c)
        k = 0
        for p in val_nodes(node.fields[1]):
            pname = p.fields[0].text
            if pname == 'self' and info.owner != '':
                self.store_owned(self.slot('self', '@' + info.owner, line), recv)
            else:
                self.store_owned(self.slot(pname, info.ptypes[k], line), vals[k])
                k += 1
        self.block(val_nodes(node.fields[3]))
        if not self.terminated:
            self.br(c.end)
        self.place(c.end)
        self.gen_n -= 1
        self.swap_scope(c)
        self.facts_off -= 1

    def yield_stmt(self, s: Node):
        if self.gen_n == 0:
            raise CompileError("'yield' can only be used in a generator, that is a function or method that a for loop loops over", s.line)
        c = self.gens[self.gen_n - 1]
        if self.try_depth != c.try_depth:
            raise CompileError("'yield' cannot be used inside a try block", s.line)
        v = self.expr(val_node(s.fields[0]), c.ty)
        v = self.want(v, c.ty, s.line, 'the yielded value')
        self.store_owned(c.var, v)
        self.gen_n -= 1
        self.swap_scope(c)
        cont = self.label('afteryield')
        self.push_loop(c.end, cont)
        self.block(c.body)
        self.loop_depth -= 1
        if not self.terminated:
            self.br(cont)
        self.place(cont)
        self.swap_scope(c)
        self.gen_push(c)

    def gen_call(self, s: Node, it: Node) -> bool:
        # for x in gen(args) and for x in obj.gen(args), where the function or method is a generator
        if it.kind != 'Call' or len(it.fields[2].items) > 0:
            return False
        f = val_node(it.fields[0])
        args = val_nodes(it.fields[1])
        if f.kind == 'Name':
            name = f.fields[0].text
            if name in self.slots or name == 'range':
                return False
            key = self.mod.resolve(name)
            if key == '' or self.mod.has_class(key):
                return False
            if key in self.mod.generics:
                g = self.mod.generics[key]
                if g.kind != 'FuncDef' or not g.fields[7].flag:
                    return False
                info = self.mod.instance_func(key, self.infer_targs(key, val_nodes(g.fields[1]), args, s.line), s.line)
            else:
                info = self.mod.find(key, s.line)
            if not info.is_gen:
                return False
            self.inline_gen(s, info, ex('', ''), self.gen_args(info, args, s.line), s.line)
            return True
        if f.kind != 'Attr':
            return False
        name = f.fields[1].text
        known = False
        for fi in self.mod.infos:
            if fi.name == name and fi.owner != '' and fi.is_gen:
                known = True
        target = val_node(f.fields[0])
        if not known or (target.kind == 'Name' and target.fields[0].text not in self.slots):
            return False
        obj = self.unwrap(self.expr(target), s.line)
        found: FuncInfo | None = None
        if is_class(obj.ty):
            found = self.mod.lookup_method(obj.ty[1:], name)
        if found is None or not found.is_gen:
            self.release(obj)
            return False
        info: FuncInfo = found
        self.inline_gen(s, info, obj, self.gen_args(info, args, s.line), s.line)
        return True

    def for_text(self, s: Node, text: Ex):
        # for ch in text: each character as a one-character text
        holder = self.hidden_rc_slot('for.text')
        self.store_owned(holder, text)
        counter = self.hidden_slot('for.i')
        self.emit(f'store i64 0, ptr {counter}')
        var = self.slot(s.fields[0].text, 'str', s.line)
        head = self.label('eachchar')
        body = self.label('eachcharbody')
        step = self.label('eachcharstep')
        end = self.label('endeachchar')
        self.br(head)
        self.place(head)
        t = self.tmp('txt')
        self.emit(f'{t} = load ptr, ptr {holder}')
        i = self.tmp('i')
        self.emit(f'{i} = load i64, ptr {counter}')
        n = self.tmp('n')
        self.emit(f'{n} = call i64 @tomato_str_len(ptr {t})')
        go = self.tmp('go')
        self.emit(f'{go} = icmp slt i64 {i}, {n}')
        self.cond_br(go, body, end)
        self.place(body)
        ch = self.tmp('ch')
        self.emit(f'{ch} = call ptr @tomato_str_index(ptr {t}, i64 {i})')
        self.store_owned(var, ex(ch, 'str'))
        if self.tracking():
            self.facts = facts_copy(self.for_body)
        self.push_loop(end, step)
        self.block(val_nodes(s.fields[2]))
        self.loop_depth -= 1
        if not self.terminated:
            self.br(step)
        self.place(step)
        cur = self.tmp('cur')
        self.emit(f'{cur} = load i64, ptr {counter}')
        nxt = self.tmp('next')
        self.emit(f'{nxt} = add i64 {cur}, 1')
        self.emit(f'store i64 {nxt}, ptr {counter}')
        self.br(head)
        self.place(end)

    def item_type(self, t: str) -> str:
        # the type of the items a for loop gives over a value of type t, or '' when it is not known here
        if is_list(t):
            return elem_of(t)
        if t == 'str':
            return 'str'
        if is_class(t) and self.mod.has_op(t[1:], 'iter'):
            return self.mod.find_op(t[1:], 'iter').ret
        return ''

    def for_union(self, s: Node, name: str):
        # a loop over a union variable: the loop is compiled once for each member, in the branch where the variable is that member
        members = union_members(self.types[name])
        first = ''
        for m in members:
            item = self.item_type(m)
            if first == '':
                first = item
            elif item != '' and item != first:
                raise CompileError(f"a for loop over '{name}' needs the same item type in every member of {shown(self.types[name])}, but the items are {shown(first)} and {shown(item)}", s.line)
        whole = self.tmp('whole')
        self.emit(f'{whole} = load ptr, ptr {self.slots[name]}')
        end = self.label('endunion')
        then = ''
        nxt = ''
        for k, m in enumerate(members):
            if k < len(members) - 1:
                then = self.label('eachof')
                nxt = self.label('nextof')
                self.cond_br(self.box_is(ex(whole, self.types[name]), m), then, nxt)
                self.place(then)
            saved = self.enter_narrow(name, m)
            self.for_stmt(s)
            self.leave_narrow(name, saved)
            self.br(end)
            if k < len(members) - 1:
                self.place(nxt)
        self.place(end)

    def for_each(self, s: Node, it: Node):
        if it.kind == 'Call' and val_node(it.fields[0]).kind == 'Attr' and len(it.fields[2].items) == 0:
            f = val_node(it.fields[0])
            if f.fields[1].text == 'split' and len(val_nodes(it.fields[1])) == 1 and self.peek_type(val_node(f.fields[0])) == 'str':
                self.for_split(s, self.expr(val_node(f.fields[0])), val_nodes(it.fields[1]), it.line)
                return
        self.for_value(s, self.expr(it))

    def for_split(self, s: Node, text: Ex, args: list[Node], line: int):
        # for piece in text.split(sep): the pieces are made one at a time, so there is no list of them
        a = self.text_args(text, 'split', args, 1, line)
        self.not_empty(a[0], 'split', [text, a[0]])
        holder = self.hidden_rc_slot('for.text')
        self.store_owned(holder, text)
        holder2 = self.hidden_rc_slot('for.sep')
        self.store_owned(holder2, a[0])
        at = self.hidden_slot('for.i')
        self.emit(f'store i64 0, ptr {at}')
        var = self.slot(s.fields[0].text, 'str', s.line)
        head = self.label('piece')
        body = self.label('piecebody')
        end = self.label('endpiece')
        self.br(head)
        self.place(head)
        t = self.tmp('txt')
        self.emit(f'{t} = load ptr, ptr {holder}')
        sep = self.tmp('sep')
        self.emit(f'{sep} = load ptr, ptr {holder2}')
        piece = self.tmp('piece')
        self.emit(f'{piece} = call ptr @tomato_str_split_next(ptr {t}, ptr {sep}, ptr {at})')
        go = self.tmp('go')
        self.emit(f'{go} = icmp ne ptr {piece}, null')
        self.cond_br(go, body, end)
        self.place(body)
        self.store_owned(var, ex(piece, 'str'))
        if self.tracking():
            self.facts = facts_copy(self.for_body)
        self.push_loop(end, head)
        self.block(val_nodes(s.fields[2]))
        self.loop_depth -= 1
        if not self.terminated:
            self.br(head)
        self.place(end)

    # a loop over a value of an Iterable type: the loop is compiled once for each kind of value the box can hold, and the
    # one matching the box's contents runs (the same way a union is narrowed)
    def for_dyn(self, s: Node, box: Ex):
        if not dyn_iterable(box.ty):
            raise CompileError('a for loop cannot loop over a value of type Sized\nuse Iterable[T] to say what the loop gives', s.line)
        holder = self.hidden_rc_slot('for.dyn')
        self.store_owned(holder, box)
        join = self.label('enddyn')
        for member in self.mod.dyn_members(box.ty):
            held = self.tmp('held')
            self.emit(f'{held} = load ptr, ptr {holder}')
            yes = self.label('dynis')
            no = self.label('dynnot')
            self.cond_br(self.box_is(ex(held, box.ty), member), yes, no)
            self.place(yes)
            inner = self.unbox_value(ex(held, box.ty), member)
            if member == dyn_seq():
                inner = ex(inner.reg, 'list[' + dyn_item(box.ty) + ']')
            self.for_value(s, inner)
            if not self.terminated:
                self.br(join)
            self.place(no)
        self.br(join)
        self.place(join)

    # a loop over d.items() of a dict: keys and values are two snapshots walked together, so each variable has its own type
    def for_items(self, s: Node, it: Node):
        f = val_node(it.fields[0])
        obj = self.unwrap(self.expr(val_node(f.fields[0])), s.line)
        if not is_dict(obj.ty):
            self.for_value(s, self.method_on(obj, it, 'items', []))        # the unpack is the first statement of the body
            return
        vt = dict_value(obj.ty)
        ks = self.tmp('keys')
        self.emit(f'{ks} = call ptr @tomato_dict_keys(ptr {obj.reg}, i64 {self.mod.code_of("list[str]")}, i64 {item_width("list[str]")})')
        vl = f'list[{vt}]'
        vs_ = self.tmp('values')
        self.emit(f'{vs_} = call ptr @tomato_dict_values(ptr {obj.reg}, i64 {self.mod.code_of(vl)}, i64 {item_width(vl)}, i32 {elem_rc(vt)})')
        self.release(obj)
        self.for_value(s, ex(ks, 'list[str]'), ex(vs_, vl))

    def for_value(self, s: Node, lst: Ex, vals: Ex | None = None):
        if is_dyn(lst.ty):
            self.for_dyn(s, lst)
            return
        if is_class(lst.ty):
            ai = self.mod.find_op(lst.ty[1:], 'iter')
            if ai is not None and ai.is_async:
                raise CompileError("'" + lst.ty[1:] + "' loops over async statuses, so it needs async for\nwrite: async for " + s.fields[0].text + " in ...:", s.line)
        if is_class(lst.ty) and self.mod.has_op(lst.ty[1:], 'iter'):
            self.inline_gen(s, self.mod.find_op(lst.ty[1:], 'iter'), lst, [], s.line)
            return
        if is_set(lst.ty) or is_dict(lst.ty):
            # a loop over a set or dict walks a snapshot of its keys (P28)
            keys = f'list[{set_elem(lst.ty)}]'
            if is_dict(lst.ty):
                keys = 'list[str]'
            snap = self.tmp('keys')
            self.emit(f'{snap} = call ptr @tomato_dict_keys(ptr {lst.reg}, i64 {self.mod.code_of(keys)}, i64 {item_width(keys)})')
            self.release(lst)
            lst = ex(snap, keys)
        if lst.ty == 'str':
            self.for_text(s, lst)
            return
        if not is_list(lst.ty):
            if is_class(lst.ty):
                raise CompileError("a for loop cannot loop over a '" + lst.ty[1:] + "' object\ngive the class a method marked @iter that yields the items, or loop over a list field of it such as obj.items", s.line)
            raise CompileError(f'a for loop can loop over a range(), a list, a tuple, a set, a dict, text or an object with an @iter method, but this is {shown(lst.ty)}', s.line)
        elem = elem_of(lst.ty)
        in_nest = self.nest != '' and s.spot > 0
        holder = ''
        if in_nest and f'{s.spot}list' in self.nest_slots:
            holder = self.nest_slots[f'{s.spot}list']
        else:
            holder = self.hidden_rc_slot('for.list')
            if in_nest:
                self.nest_slots[f'{s.spot}list'] = holder
        self.store_owned(holder, lst)
        counter = self.loop_slot(s, 'for.i')
        self.emit(f'store i64 0, ptr {counter}')
        var = self.slot(s.fields[0].text, elem, s.line)
        holder2 = ''
        var2 = ''
        stmts = val_nodes(s.fields[2])
        if vals is not None:                     # for k, v in d.items(): the names are the fourth field, and the unpack is not needed
            holder2 = self.hidden_rc_slot('for.vals')
            self.store_owned(holder2, vals)
            var = self.slot(s.fields[3].items[0].text, elem, s.line)
            var2 = self.slot(s.fields[3].items[1].text, elem_of(vals.ty), s.line)
            stmts = stmts[1:]
        head = self.nest_label(s, 'each')
        body = self.label('eachbody')
        step = self.label('eachstep')
        end = self.label('endeach')
        self.bail = ''
        self.br(head)
        self.place(head)
        self.nest_head(s)
        l = self.tmp('lst')
        self.emit(f'{l} = load ptr, ptr {holder}')
        i = self.tmp('i')
        self.emit(f'{i} = load i64, ptr {counter}')
        lenp = self.tmp('lenp')
        self.emit(f'{lenp} = getelementptr {{ i64, i64, i64, i64, ptr }}, ptr {l}, i32 0, i32 2')
        ln = self.tmp('n')
        self.emit(f'{ln} = load i64, ptr {lenp}')
        go = self.tmp('go')
        self.emit(f'{go} = icmp slt i64 {i}, {ln}')
        self.cond_br(go, body, end)
        self.place(body)
        addr = self.list_slot(ex(l, lst.ty), ex(i, 'int'))
        item = self.load_item(lst.ty, addr, 'item')
        e = ex(item, elem)
        if in_nest and self.nest_fast:
            if elem == 'int':
                for h in self.nest_heads:            # a big number: the general copy takes this pass over, from behind its entry test
                    if h[2] == str(s.spot):
                        self.bail = h[1]
                e = self.need_small(e)
                self.bail = ''
            self.store_owned(var, e, True)
        else:
            self.retain(e)
            self.store_owned(var, e)
        if vals is not None:
            l2 = self.tmp('lst')
            self.emit(f'{l2} = load ptr, ptr {holder2}')
            addr2 = self.list_slot(ex(l2, vals.ty), ex(i, 'int'))
            item2 = self.load_item(vals.ty, addr2, 'item')
            e2 = ex(item2, elem_of(vals.ty))
            self.retain(e2)
            self.store_owned(var2, e2)
        if self.tracking():
            self.facts = facts_copy(self.for_body)
        self.push_loop(end, step)
        self.block(stmts)
        self.loop_depth -= 1
        if not self.terminated:
            self.br(step)
        self.place(step)
        cur = self.tmp('cur')
        self.emit(f'{cur} = load i64, ptr {counter}')
        nxt = self.tmp('next')
        self.emit(f'{nxt} = add i64 {cur}, 1')
        self.emit(f'store i64 {nxt}, ptr {counter}')
        self.br(head)
        self.place(end)

    def range_var_range(self, bounds: list[Node]) -> Rng:
        # the interval of a range loop's variable inside the body, from the bounds' intervals where the loop starts. The
        # loop's variable is always a small number (a loop that would leave the small range is cut, see range_cut); when every
        # bound is known to be inside the small range, its number lies between them too.
        whole = rng(SMALL_LO, SMALL_HI)
        if not self.tracking():
            return whole
        rs: list[Rng] = []
        for b in bounds[:2]:
            r = self.range_of(b, self.for_entry)
            if r is None or not rng_small(r):
                return whole
            rs.append(r)
        if len(bounds) == 1:
            return rng(0, b_max(rs[0].hi - 1, 0))
        if len(bounds) == 2:
            return rng(rs[0].lo, b_max(rs[1].hi - 1, rs[0].lo))
        # start + k * step for either sign of step lies between start and stop
        return rng(b_min(rs[0].lo, rs[1].lo), b_max(rs[0].hi, rs[1].hi))

    def range_unsure(self, bound: Node, e: Ex, out: list[str]):
        # collects the word of a range bound that is not known to be a small number
        if e.small or small_text(e.reg):
            return
        if self.tracking():
            r = self.range_of(bound, self.for_entry)
            if r is not None and rng_small(r):
                return
        out.append(e.reg)

    def range_cut(self, start: str, stop: str, stepv: str, unsure: list[str], late: str) -> str:
        # The variable of a range loop is always a small number. A start or stop past the small range (the machine word holds
        # one more bit) therefore cuts the loop: it runs over the numbers that are small, and then, when there are more, stops
        # with an error (the late slot is not 0; see for_stmt). With both small (one tag test each) there is nothing to cut.
        small = ''
        for w in unsure:
            bit = self.arith('and', w, '1')
            one = self.tmp('tagged')
            self.emit(f'{one} = icmp ne i64 {bit}, 0')
            if small == '':
                small = one
            else:
                both = self.tmp('tagged')
                self.emit(f'{both} = and i1 {small}, {one}')
                small = both
        cut = self.hidden_slot('for.c')
        self.emit(f'store i64 {stop}, ptr {cut}')
        self.emit(f'store i64 0, ptr {late}')
        wide = self.label('widerange')
        ready = self.label('ranged')
        self.cond_br(small, ready, wide)
        self.place(wide)
        flag = self.tmp('late')
        self.emit(f'{flag} = call i64 @tomato_range_late(i64 {start}, i64 {stop}, i64 {stepv})')
        first = self.tmp('first')
        self.emit(f'{first} = icmp eq i64 {flag}, 2')
        self.fail_if(first, 'the number is too big here')
        self.emit(f'store i64 {flag}, ptr {late}')
        last = self.tmp('cut')
        self.emit(f'{last} = call i64 @tomato_range_cut(i64 {start}, i64 {stop}, i64 {stepv})')
        self.emit(f'store i64 {last}, ptr {cut}')
        self.br(ready)
        self.place(ready)
        r = self.tmp('stop')
        self.emit(f'{r} = load i64, ptr {cut}')
        return r

    def for_stmt(self, s: Node):
        it = val_node(s.fields[1])
        if len(s.fields) > 3:
            self.for_items(s, it)
            return
        if it.kind == 'Name' and it.fields[0].text in self.slots and is_union(self.types[it.fields[0].text]):
            self.for_union(s, it.fields[0].text)
            return
        if self.gen_call(s, it):
            return
        if not (it.kind == 'Call' and val_node(it.fields[0]).kind == 'Name' and val_node(it.fields[0]).fields[0].text == 'range'):
            self.for_each(s, it)
            return
        bounds = val_nodes(it.fields[1])
        if len(bounds) < 1 or len(bounds) > 3:
            raise CompileError('range() takes 1 to 3 whole-number arguments: range(stop), range(start, stop) or range(start, stop, step)', s.line)
        var_range = self.range_var_range(bounds)
        start = '0'
        stop = ''
        stepv = '1'
        basev = '0'
        unsure: list[str] = []         # the words of the start and stop that may be outside the small range
        if len(bounds) == 1:
            e = self.expr(bounds[0])
            e = self.want(e, 'int', s.line, 'a range bound')
            self.range_unsure(bounds[0], e, unsure)
            stop = self.int_raw(e)
        else:
            held_before = len(self.held)
            a = self.expr(bounds[0])
            self.hold(a)                        # a big start is freed by the error path if the stop raises
            b = self.expr(bounds[1])
            self.drop_held(held_before)
            a = self.want(a, 'int', s.line, 'a range bound')
            b = self.want(b, 'int', s.line, 'a range bound')
            self.range_unsure(bounds[0], a, unsure)
            self.range_unsure(bounds[1], b, unsure)
            start = self.int_raw(a, [b])
            stop = self.int_raw(b)
        if len(bounds) == 3:
            c3 = self.expr(bounds[2])
            c3 = self.want(c3, 'int', s.line, 'a range bound')
            stepv = self.int_raw(c3)
            zero = self.tmp('zerostep')
            self.emit(f'{zero} = icmp eq i64 {stepv}, 0')
            self.fail_if(zero, 'range step cannot be zero')
        empty = ''
        late = ''
        if len(unsure) > 0:
            late = self.loop_slot(s, 'for.w')
            stop = self.range_cut(start, stop, stepv, unsure, late)
        if len(bounds) == 3:
            # the number of times round: a division once, so the loop itself is one compare and one add
            up = self.tmp('up')
            self.emit(f'{up} = icmp sgt i64 {stepv}, 0')
            fwd = self.tmp('fwd')
            self.emit(f'{fwd} = sub i64 {stop}, {start}')
            back = self.tmp('back')
            self.emit(f'{back} = sub i64 {start}, {stop}')
            dist = self.tmp('dist')
            self.emit(f'{dist} = select i1 {up}, i64 {fwd}, i64 {back}')
            neg = self.tmp('neg')
            self.emit(f'{neg} = sub i64 0, {stepv}')
            width = self.tmp('width')
            self.emit(f'{width} = select i1 {up}, i64 {stepv}, i64 {neg}')
            less = self.tmp('less')
            self.emit(f'{less} = sub i64 {dist}, 1')
            quo = self.tmp('quo')
            self.emit(f'{quo} = udiv i64 {less}, {width}')          # (wrapping and unsigned: stop - start can be 2^63)
            plus = self.tmp('plus')
            self.emit(f'{plus} = add i64 {quo}, 1')
            above = self.tmp('above')
            self.emit(f'{above} = icmp sge i64 {start}, {stop}')
            below = self.tmp('below')
            self.emit(f'{below} = icmp sle i64 {start}, {stop}')
            empty = self.tmp('empty')
            self.emit(f'{empty} = select i1 {up}, i1 {above}, i1 {below}')
            cnt = self.tmp('cnt')
            self.emit(f'{cnt} = select i1 {empty}, i64 0, i64 {plus}')
            basev = start
            start = '0'
            stop = cnt
        var = self.slot(s.fields[0].text, 'int', s.line)
        old = self.tmp('old')
        self.emit(f'{old} = load i64, ptr {var}')
        if len(bounds) < 3:
            self.emit(f'call void @tomato_int_free(i64 {old})')           # a number the variable held before the loop; the loop stores small ones
            self.emit(f'store i64 1, ptr {var}')
        else:                            # (an empty loop leaves the variable alone)
            gone = self.tmp('gone')
            self.emit(f'{gone} = select i1 {empty}, i64 1, i64 {old}')
            self.emit(f'call void @tomato_int_free(i64 {gone})')
            kept = self.tmp('kept')
            self.emit(f'{kept} = select i1 {empty}, i64 {old}, i64 1')
            self.emit(f'store i64 {kept}, ptr {var}')
        counter = self.loop_slot(s, 'for.i')
        limit = self.loop_slot(s, 'for.n')
        stepslot = self.loop_slot(s, 'for.s')
        baseslot = self.loop_slot(s, 'for.b')
        self.emit(f'store i64 {start}, ptr {counter}')
        self.emit(f'store i64 {stop}, ptr {limit}')
        self.emit(f'store i64 {stepv}, ptr {stepslot}')
        self.emit(f'store i64 {basev}, ptr {baseslot}')
        in_registers = self.keep_lists(s, val_nodes(s.fields[2]))
        head = self.nest_label(s, 'for')
        self.bail = ''                 # (in the fast copy of a nest: what follows is not part of the statement's start)
        body = self.label('forbody')
        step = self.label('forstep')
        end = self.label('endfor')
        done = end if late == '' else self.label('fordone')        # where a loop that ran to its end goes (a break goes to end)
        less_cc = 'ult' if len(bounds) == 3 else 'slt'
        wraps = 'nuw' if len(bounds) == 3 else 'nsw'
        self.br(head)
        self.place(head)
        self.nest_head(s)
        i = self.tmp('i')
        self.emit(f'{i} = load i64, ptr {counter}')
        lim = self.tmp('lim')
        self.emit(f'{lim} = load i64, ptr {limit}')
        c = self.tmp('go')
        self.emit(f'{c} = icmp {less_cc} i64 {i}, {lim}')
        self.cond_br(c, body, done)
        self.place(body)
        if len(bounds) == 1 or len(bounds) == 3:         # the count starts at 0, so an index made from it is never negative
            nonneg = self.tmp('nonneg')
            self.emit(f'{nonneg} = icmp sge i64 {i}, 0')
            self.emit(f'call void @llvm.assume(i1 {nonneg})')
        names: list[str] = []
        for stmt in val_nodes(s.fields[2]):
            bound_names(stmt, names)
        if s.fields[0].text in names:        # a big number the body gave the variable is freed
            old = self.tmp('old')
            self.emit(f'{old} = load i64, ptr {var}')
            self.emit(f'call void @tomato_int_free(i64 {old})')
        if len(bounds) == 3:
            bv = self.tmp('bv')
            self.emit(f'{bv} = load i64, ptr {baseslot}')
            sv = self.tmp('sv')
            self.emit(f'{sv} = load i64, ptr {stepslot}')
            off = self.tmp('off')
            self.emit(f'{off} = mul nsw i64 {i}, {sv}')
            i = self.tmp('val')
            self.emit(f'{i} = add nsw i64 {bv}, {off}')
        self.emit(f'store i64 {self.tag_small(i).reg}, ptr {var}')
        if self.tracking():
            self.facts = facts_set(self.for_body, s.fields[0].text, var_range)
        self.push_loop(end, step)
        self.block(val_nodes(s.fields[2]))
        self.loop_depth -= 1
        if not self.terminated:
            self.br(step)
        self.place(step)
        cur = self.tmp('cur')
        self.emit(f'{cur} = load i64, ptr {counter}')
        nxt = self.tmp('next')
        self.emit(f'{nxt} = add {wraps} i64 {cur}, 1')
        self.emit(f'store i64 {nxt}, ptr {counter}')
        self.br(head)
        if late != '':
            self.place(done)
            flag = self.tmp('late')
            self.emit(f'{flag} = load i64, ptr {late}')
            more = self.tmp('more')
            self.emit(f'{more} = icmp ne i64 {flag}, 0')
            self.fail_if(more, 'the number is too big here')
            self.br(end)
        self.place(end)
        self.drop_lists(in_registers)

def async_symbol(mod: Mod, info: FuncInfo) -> str:
    # the constructor of an async function's task; the resume function is this name followed by .resume
    if info.owner == '':
        return f'@tomato.async.{info.key}'
    return '@tomato.async.m.' + str(mod.code_of('@' + info.owner)) + '.' + info.name

# the text methods that are written in Tomato, in std/builtin/text.tom as _str_NAME (the others are in the runtime or built in
# to text_method)
def text_helper_methods() -> list[str]:
    return ['splitlines', 'partition', 'rpartition', 'rsplit', 'zfill', 'ljust', 'rjust', 'center', 'title', 'capitalize', 'isalnum', 'removeprefix', 'removesuffix']

def function_symbol(mod: Mod, info: FuncInfo) -> str:
    if info.is_async:
        return async_symbol(mod, info)
    if info.owner == '':
        return f'@tomato.{info.key}'
    return '@tomato.m.' + str(mod.code_of('@' + info.owner)) + '.' + info.name

# the program functions a line of IR mentions: @tomato.NAME (the runtime's are @tomato_NAME)
def mentions(line: str, out: list[str]):
    at = line.find('@tomato.')
    while at >= 0:
        end = at + 8
        while end < len(line) and (line[end].isalpha() or line[end].isdigit() or line[end] == '.' or line[end] == '_'):
            end += 1
        name = line[at:end]
        if name not in out:
            out.append(name)
        at = line.find('@tomato.', end)

def finish_function(g: Gen, symbol: str, sig: list[str], ret: str):
    # the epilogue releases every slot that owns a heap value, then returns the stored result
    b = Body()
    b.symbol = symbol
    b.epilogue = len(g.lines)
    g.lines.append('epilogue:')
    for reg in g.rc_slots:
        o = g.tmp('rel')
        g.lines.append(f'  {o} = load ptr, ptr {reg}')
        g.lines.append(f'  call void @{g.slot_release(reg)}(ptr {o})')
    for reg in g.int_slots:
        o = g.tmp('free')
        g.lines.append(f'  {o} = load i64, ptr {reg}')
        g.lines.append(f'  call void @tomato_int_free(i64 {o})')
    llvm_ret = 'void'
    if ret != '':
        llvm_ret = llvm_type(ret)
        r = g.tmp('ret')
        g.lines.append(f'  {r} = load {llvm_ret}, ptr %retval')
        g.lines.append(f'  ret {llvm_ret} {r}')
    else:
        g.lines.append('  ret void')
    text = 'define ' + llvm_ret + ' ' + symbol + '(' + ', '.join(sig) + ')' + (' inlinehint' if g.short and g.mod.mode == 2 else '') + ' {\nentry:\n'
    if ret != '':
        text += f'  %retval = alloca {llvm_ret}\n  store {llvm_ret} {zero_of(ret)}, ptr %retval\n'
    if len(g.allocas) > 0:
        text += '\n'.join(g.allocas) + '\n'
    b.head = text
    b.lines = g.lines
    for k, line in enumerate(g.lines):
        if '@tomato.' in line:
            if ' = icmp ne ptr ' in line and '; @tomato.' in line:
                b.checks.append(k)
            else:
                mentions(line, b.uses)
        if '@tomato_exc' in line:
            # reading the pending error, or clearing it, raises nothing; anything else that touches it may
            if 'ptr @tomato_exc' in line.replace('@tomato_exc_', '') and not ' = load ptr, ptr @tomato_exc' in line and not 'store ptr null, ptr @tomato_exc' in line:
                b.raises = True
        elif ' call ' in line and '@printf' not in line:
            at = line.find(' call ')
            if '@' not in line[at:line.find('(', at)]:
                b.raises = True            # a call through a pointer could call anything
    g.mod.bodies.append(b)

def finish_bodies(mod: Mod, entry: str) -> str:
    # the text of the compiled functions, once all of them are known: which functions can raise an error is worked out over the
    # whole program, and a test for an error after a direct call of a function that cannot raise becomes a constant. In release mode
    # the entry function, when nothing else refers to it, ends the program: it gives nothing back that the end of the
    # process would not.
    index: dict[str, int] = {}
    callers: list[list[int]] = []
    for k, b in enumerate(mod.bodies):
        index[b.symbol] = k
        callers.append([])
    work: list[int] = []
    for k, b in enumerate(mod.bodies):
        for name in b.uses:
            if name in index:
                callers[index[name]].append(k)
            else:
                b.raises = True            # a task, a user function in LLVM, ...: not compiled here
        if b.raises:
            work.append(k)
    while len(work) > 0:
        for c in callers[work.pop()]:
            if not mod.bodies[c].raises:
                mod.bodies[c].raises = True
                work.append(c)
    parts: list[str] = []
    for b in mod.bodies:
        for k in b.checks:
            line = b.lines[k]
            at = line.find(' ; @')
            callee = line[at + 3:]
            if callee in index and not mod.bodies[index[callee]].raises:
                b.lines[k] = line[:line.find('icmp ne ptr ')] + 'icmp ne ptr null, null'
            else:
                b.lines[k] = line[:at]
        if b.symbol == entry and mod.mode == 2 and len(mod.frames) == 0 and len(callers[index[entry]]) == 0:
            b.lines = b.lines[:b.epilogue + 1] + ['  ret void']
        parts.append(b.head + '\n'.join(b.lines) + '\n}\n')
    return '\n'.join(parts) + '\n'

def trace_name(info: FuncInfo) -> str:
    # the function as a call trace shows it: Class.method, or just the name
    if info.owner == '':
        return info.name
    return info.owner.split('.')[-1] + '.' + info.name

def pure_number(t: str) -> bool:
    return t == 'int' or t == 'float' or t == 'bool' or t == 'U:float;int'

def asks_type(n: Node) -> bool:
    # is there a test such as `x in int` (or any other `in`) in the tree?
    if n.kind == 'BinOp' and n.fields[0].text == 'in':
        return True
    for f in n.fields:
        if asks_type_val(f):
            return True
    return False

def asks_type_val(v: Val) -> bool:
    if v.tag == 'n':
        return asks_type(val_node(v))
    if v.tag == 'l' or v.tag == 't':
        for it in v.items:
            if asks_type_val(it):
                return True
    return False

# the number of nodes in a tree, counted up to a limit
def node_count(n: Node, limit: int) -> int:
    total = 1
    for f in n.fields:
        if total > limit:
            return total
        total += val_count(f, limit - total)
    return total

def val_count(v: Val, limit: int) -> int:
    if v.tag == 'n':
        return node_count(val_node(v), limit)
    total = 0
    if v.tag == 'l' or v.tag == 't':
        for it in v.items:
            if total > limit:
                return total
            total += val_count(it, limit - total)
    return total

# In release mode a short function with int parameters that it never assigns is compiled twice. The copy SYMBOL.small is called
# when every int argument is a small number: it knows that about its parameters (see range_of), so their uses need no tag tests and
# often no overflow tests. The general copy SYMBOL starts by testing its arguments and hands over to the other when it can.
const SMALL_COPY_NODES = 160
const SHORT_NODES = 60          # functions up to this size ask to be inlined (release mode)

def has_small(mod: Mod, info: FuncInfo) -> bool:
    if mod.mode != 2 or info.is_async or info.is_gen or 'int' not in info.ptypes:
        return False
    symbol = function_symbol(mod, info)
    if symbol in mod.small_cache:
        return mod.small_cache[symbol]
    f = mod.node_of(info)
    ok = f.kind == 'FuncDef' and not (f.fields[6].tag == 's' and f.fields[6].text.startswith('entry:'))
    if ok:
        size = 0
        assigned: list[str] = []
        names: list[str] = []
        for st in val_nodes(f.fields[3]):
            size += node_count(st, SMALL_COPY_NODES)
            bound_names(st, assigned)
            names_read(st, names)
        ok = size <= SMALL_COPY_NODES
        used = False
        params = param_names(f)
        ptypes = param_types(f, info)
        for k, t in enumerate(ptypes):
            if t == 'int':
                if params[k] in assigned:
                    ok = False
                if params[k] in names:
                    used = True
        ok = ok and used
    mod.small_cache[symbol] = ok
    return ok

# A pure function (see Mod.pure) of numbers: its copy for small arguments has no big-number code at all. When a number it makes is
# not small, or an error must be raised, it starts again in SYMBOL.big, the general copy, which does the same work from the
# beginning. SYMBOL itself only chooses between the two.
def small_thunk(f: Node, mod: Mod, info: FuncInfo):
    g = Gen()
    g.mod = mod
    g.ret = info.ret
    names = param_names(f)
    types = param_types(f, info)
    sig: list[str] = []
    test = ''
    for k, name in enumerate(names):
        sig.append(f'{llvm_type(types[k])} %arg.{name}')
        if types[k] == 'int':
            test = f'%arg.{name}' if test == '' else g.arith('and', test, f'%arg.{name}')
    bit = g.arith('and', test, '1')
    g.emit(f'%small.args = icmp ne i64 {bit}, 0')
    g.cond_br('%small.args', 'smallcall', 'general')
    for label in ['smallcall', 'general']:
        g.place(label)
        which = '.small' if label == 'smallcall' else '.big'
        g.emit(f'%{label}.ret = call {g.ret_llvm(info)} {function_symbol(mod, info)}{which}(' + ', '.join(sig) + ')')
        g.emit(f'ret {g.ret_llvm(info)} %{label}.ret')
    g.terminated = True
    finish_function(g, function_symbol(mod, info), sig, info.ret)

def compile_function(f: Node, mod: Mod, info: FuncInfo, small: bool = False):
    if not small and has_small(mod, info):
        compile_function(f, mod, info, True)
    mod.cur = info.module
    mod.tvars = info.targs
    g = Gen()
    g.mod = mod
    g.owner = info.owner
    g.fname = trace_name(info)
    g.in_init = info.is_init
    g.ret = info.ret
    big = ''
    names = param_names(f)
    types = param_types(f, info)
    restart = small and info.owner == '' and mod.pure(info.key)      # see small_thunk
    if not small and has_small(mod, info) and info.owner == '' and mod.pure(info.key):
        small_thunk(f, mod, info)
        big = '.big'
    elif not small and has_small(mod, info):
        # every int argument small: the other copy does the work
        test = ''
        parts: list[str] = []
        for k, name in enumerate(names):
            parts.append(f'{llvm_type(types[k])} %arg.{name}')
            if types[k] == 'int':
                test = f'%arg.{name}' if test == '' else g.arith('and', test, f'%arg.{name}')
        bit = g.arith('and', test, '1')
        g.emit(f'%small.args = icmp ne i64 {bit}, 0')
        g.cond_br('%small.args', 'smallcall', 'general')
        g.place('smallcall')
        call = f'call {g.ret_llvm(info)} {function_symbol(mod, info)}.small(' + ', '.join(parts) + ')'
        if info.ret == '':
            g.emit(call)
            g.emit('ret void')
        else:
            g.emit(f'%small.ret = {call}')
            g.emit(f'ret {g.ret_llvm(info)} %small.ret')
        g.place('general')
    sig: list[str] = []
    lent: list[list[str]] = []          # per rc or int parameter: its name, its slot, and the line index of its retain (of its copy, for an int)
    for k, name in enumerate(names):
        reg = g.slot(name, types[k], f.line)
        sig.append(f'{llvm_type(types[k])} %arg.{name}')
        if types[k] == 'int':
            lent.append([name, reg, str(len(g.lines))])
            g.emit(f'%arg.{name}.own = call i64 @tomato_int_dup(i64 %arg.{name})')    # the caller only lent it
            g.emit(f'store i64 %arg.{name}.own, ptr {reg}')
            continue
        g.emit(f'store {llvm_type(types[k])} %arg.{name}, ptr {reg}')
        if is_rc(types[k]):
            lent.append([name, reg, str(len(g.lines))])
            g.emit('call void @tomato_retain(ptr %arg.' + name + ')')    # the caller only lent it
    g.assigned = []
    if small:
        for k, name in enumerate(names):
            if types[k] == 'int':
                g.facts = facts_set(g.facts, name, rng(SMALL_LO, SMALL_HI))
    if restart:
        g.bail = 'restart'
    g.block(val_nodes(f.fields[3]))
    g.bail = ''
    # a parameter that the body never assigns keeps the caller's reference for as long as the call lasts (the caller holds one
    # during the call), so it needs no reference of its own: no retain now and no release in the epilogue
    for pl in lent:
        if pl[0] not in g.assigned:
            g.lines[int(pl[2])] = '  ; the parameter ' + pl[0] + ' is only lent'
            g.rc_slots = [r for r in g.rc_slots if r != pl[1]]
            if g.types[pl[0]] == 'int':
                # the slot holds the caller's number: no copy, and nothing to free
                g.lines[int(pl[2]) + 1] = '  store i64 %arg.' + pl[0] + ', ptr ' + pl[1]
                g.int_slots = [r for r in g.int_slots if r != pl[1]]
    end_body(g, f, info)
    if restart:
        g.place('restart')
        args: list[str] = []
        for k, name in enumerate(names):
            args.append(f'{llvm_type(types[k])} %arg.{name}')
        g.emit(f'%big.ret = call {g.ret_llvm(info)} {function_symbol(mod, info)}.big(' + ', '.join(args) + ')')
        g.emit(f'store {g.ret_llvm(info)} %big.ret, ptr %retval')
        g.br('epilogue')
    g.short = node_count(f, SHORT_NODES) <= SHORT_NODES
    finish_function(g, function_symbol(mod, info) + ('.small' if small else big), sig, info.ret)

# the name of each parameter of the definition f, in order (self included)
def param_names(f: Node) -> list[str]:
    return [p.fields[0].text for p in val_nodes(f.fields[1])]

# the type of each parameter of the definition f, in order: self is an object of the method's class
def param_types(f: Node, info: FuncInfo) -> list[str]:
    types: list[str] = []
    k = 0
    for p in val_nodes(f.fields[1]):
        if p.fields[0].text == 'self':
            if info.owner == '':
                raise CompileError("'self' can only be used in methods inside a class", p.line)
            types.append(f'@{info.owner}')
        else:
            types.append(info.ptypes[k])
            k += 1
    return types

# after the body: a function that gives a value must not reach its end (if the check cannot tell, reaching it stops the
# program); one that gives nothing returns from there
def end_body(g: Gen, f: Node, info: FuncInfo):
    if info.ret != '' and falls_through(val_nodes(f.fields[3])):
        raise CompileError(f"the function '{info.name}' can reach its end without returning a value\nend every path with a return, for example give the last if an else that returns", f.line)
    if g.terminated:
        return
    if info.ret == '':
        g.br('epilogue')
        return
    text = g.mod.intern('the function ended without returning a value')
    g.emit(f'call void @tomato_fail_id(i32 354, ptr {text}.c)')
    g.emit('unreachable')
    g.terminated = True

def compile_async_function(f: Node, mod: Mod, info: FuncInfo) -> str:
    # an async function becomes a frame (its variables on the heap), a constructor that makes the frame from the arguments,
    # and a resume function that runs the body from where it last stopped
    mod.cur = info.module
    mod.tvars = info.targs
    g = Gen()
    g.mod = mod
    g.owner = info.owner
    g.fname = trace_name(info)
    g.is_async = True
    g.ret = info.ret
    g.ret_yields = info.yields
    cname = f'async.{info.key}'
    if info.owner != '':
        cname = f'async.m.{info.owner}.{info.name}'
    code = mod.code_of(f'@{cname}')
    g.frame_code = code
    g.allocas.append(f'  %state.p = getelementptr %class.{code}, ptr %frame, i32 0, i32 3')
    names = param_names(f)
    types = param_types(f, info)
    sig: list[str] = []
    for k, name in enumerate(names):
        g.slot(name, types[k], f.line)
        sig.append(f'{llvm_type(types[k])} %arg.{name}')
    g.line = f.line
    g.check_cancel()                  # cancelled before it ever ran
    g.block(val_nodes(f.fields[3]))
    end_body(g, f, info)
    # the frame's type: the fixed fields, then one per variable
    result_ty = info.ret if info.ret != '' else 'u64'
    queue_ty = f'list[{info.yields}]' if info.yields != '' else 'File'
    fr = ClassInfo()
    fr.name = cname
    fr.display = 'task'
    fr.module = info.module
    fr.is_frame = True
    fr.done = True
    frame_types = ['u64'] * 9 + ['str', '@Error', queue_ty, result_ty] + g.frame_types
    for ft in frame_types:
        slot = FieldInfo()
        slot.name = 'f'
        slot.ty = ft
        fr.fields.append(slot)
    mod.frames.append(fr)
    cls = f'%class.{code}'
    sym = async_symbol(mod, info)
    for k, line in enumerate(g.lines):
        if ' ; @tomato.' in line:               # a check_error: it stays a test (see finish_bodies)
            g.lines[k] = line[:line.find(' ; @tomato.')]
    # the resume function
    text = f'define void {sym}.resume(ptr %frame) {{\nentry:\n'
    if info.ret != '':
        # in the frame, not on the stack: a finally that runs after the return can wait, and the value must still be there
        text += f'  %retval = getelementptr {cls}, ptr %frame, i32 0, i32 14\n'
    text += '\n'.join(g.allocas) + '\n'
    text += '  %st.v = load i64, ptr %state.p\n  switch i64 %st.v, label %start ['
    for i in range(g.awaits):
        text += f' i64 {str(i + 1)}, label %rs.{str(i + 1)}'
    text += ' ]\nstart:\n'
    text += '\n'.join(g.lines) + '\n'
    text += 'epilogue:\n'
    for reg in g.rc_slots:
        o = g.tmp('rel')
        text += f'  {o} = load ptr, ptr {reg}\n  store ptr null, ptr {reg}\n  call void @{g.slot_release(reg)}(ptr {o})\n'
    for reg in g.int_slots:
        o = g.tmp('free')
        text += f'  {o} = load i64, ptr {reg}\n  call void @tomato_int_free(i64 {o})\n  store i64 0, ptr {reg}\n'
    text += '  %ex.p = load ptr, ptr @tomato_exc\n  %ex.has = icmp ne ptr %ex.p, null\n  br i1 %ex.has, label %failed, label %succeeded\n'
    text += f'failed:\n  %e.p = getelementptr {cls}, ptr %frame, i32 0, i32 12\n  store ptr %ex.p, ptr %e.p\n'
    text += f'  %el = load i32, ptr @tomato_exc_line\n  %el64 = zext i32 %el to i64\n  %el.p = getelementptr {cls}, ptr %frame, i32 0, i32 6\n  store i64 %el64, ptr %el.p\n'
    text += f'  %er = load i32, ptr @tomato_exc_rt\n  %er64 = zext i32 %er to i64\n  %er.p = getelementptr {cls}, ptr %frame, i32 0, i32 7\n  store i64 %er64, ptr %er.p\n'
    text += f'  store ptr null, ptr @tomato_exc\n  %s2.p = getelementptr {cls}, ptr %frame, i32 0, i32 4\n  store i64 2, ptr %s2.p\n  br label %wake\n'
    text += 'succeeded:\n'
    text += '  call void @tomato_task_drop_starter(ptr %frame)\n'
    text += f'  %s1.p = getelementptr {cls}, ptr %frame, i32 0, i32 4\n  store i64 1, ptr %s1.p\n  br label %wake\n'
    text += 'wake:\n  call void @tomato_wake_waiters(ptr %frame)\n  ret void\nsuspend:\n  ret void\n}\n'
    # the constructor
    text += 'define ptr ' + sym + '(' + ', '.join(sig) + ') {\nentry:\n'
    text += f'  %size = ptrtoint ptr getelementptr ({cls}, ptr null, i32 1) to i64\n'
    text += f'  %f = call ptr @tomato_alloc(i64 %size, i64 {code})\n'
    text += f'  %rf = getelementptr {cls}, ptr %f, i32 0, i32 2\n  store ptr {sym}.resume, ptr %rf\n'
    for k, name in enumerate(names):
        text += f'  %pf{k} = getelementptr {cls}, ptr %f, i32 0, i32 {str(FRAME_FIXED + k + 2)}\n'
        if types[k] == 'int':
            text += f'  %arg.{name}.own = call i64 @tomato_int_dup(i64 %arg.{name})\n  store i64 %arg.{name}.own, ptr %pf{k}\n'
        else:
            text += f'  store {llvm_type(types[k])} %arg.{name}, ptr %pf{k}\n'
        if is_rc(types[k]):
            text += f'  call void @tomato_retain(ptr %arg.{name})\n'
    if info.yields != '':
        text += f'  %q = call ptr @tomato_list_new(i64 {mod.code_of(queue_ty)})\n'
        text += f'  %qf = getelementptr {cls}, ptr %f, i32 0, i32 13\n  store ptr %q, ptr %qf\n'
    text += '  ret ptr %f\n}\n'
    return text

def scheduler_ir(mod: Mod) -> str:
    # the code that runs tasks: step runs one frame until it stops, run keeps stepping whatever is ready until nothing is left
    t = 'define void @tomato.sched.step(ptr %f) {\n  %p = getelementptr i8, ptr %f, i64 16\n  %fn = load ptr, ptr %p\n  call void %fn(ptr %f)\n  ret void\n}\n'
    hdr = '{ i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, ptr, ptr, ptr, i64 }'
    t += f'define void @tomato.task.raise(ptr %h) {{\n  call void @tomato_task_retrieved(ptr %h)\n  %ep = getelementptr {hdr}, ptr %h, i32 0, i32 12\n  %e = load ptr, ptr %ep\n  call void @tomato_retain(ptr %e)\n  store ptr %e, ptr @tomato_exc\n'
    t += f'  %lp = getelementptr {hdr}, ptr %h, i32 0, i32 6\n  %l = load i64, ptr %lp\n  %l32 = trunc i64 %l to i32\n  store i32 %l32, ptr @tomato_exc_line\n'
    t += f'  %rp = getelementptr {hdr}, ptr %h, i32 0, i32 7\n  %r = load i64, ptr %rp\n  %r32 = trunc i64 %r to i32\n  store i32 %r32, ptr @tomato_exc_rt\n  store i32 1, ptr @tomato_exc_seen\n  ret void\n}}\n'
    t += f'define void @tomato.sched.run(ptr %main) {{\nentry:\n  call void @tomato_set_mode(i32 {mod.mode})\n  call void @tomato_q_push(ptr %main)\n  br label %loop\n'
    t += 'loop:\n  %f = call ptr @tomato_q_pop()\n  %none = icmp eq ptr %f, null\n  br i1 %none, label %idle, label %go\n'
    t += 'go:\n  call void @tomato.sched.step(ptr %f)\n  call void @tomato_release(ptr %f)\n  br label %loop\n'
    t += 'idle:\n  %did = call i32 @tomato_sched_idle()\n  %more = icmp ne i32 %did, 0\n  br i1 %more, label %loop, label %done\n'
    t += 'done:\n  call void @tomato_pending_flush()\n  %sp = getelementptr i8, ptr %main, i64 32\n  %st = load i64, ptr %sp\n  %fin = icmp ne i64 %st, 0\n  br i1 %fin, label %finished, label %stuck\n'
    t += 'stuck:\n  call void @tomato_fail_id(i32 355, ptr ' + mod.intern('every task is waiting for something that can no longer happen') + '.c)\n  unreachable\n'
    t += 'finished:\n  %bad = icmp eq i64 %st, 2\n  br i1 %bad, label %raise, label %out\n'
    t += 'raise:\n  call void @tomato.task.raise(ptr %main)\n  br label %out\nout:\n  call void @tomato_release(ptr %main)\n  ret void\n}\n'
    return t

def compile_constructor(c: ClassInfo, mod: Mod):
    # allocate, store the declared field defaults, then run @init
    mod.cur = c.module
    mod.tvars = c.targs
    g = Gen()
    g.mod = mod
    code = str(mod.code_of('@' + c.name))
    ptypes: list[str] = []
    if c.init != '':
        ptypes = mod.find_method(c.name, c.init, c.line).ptypes
    sig: list[str] = []
    for k, t in enumerate(ptypes):
        sig.append(f'{llvm_type(t)} %arg.{k}')
    size = g.tmp('size')
    g.emit(f'{size} = ptrtoint ptr getelementptr (%class.{code}, ptr null, i32 1) to i64')
    obj = g.tmp('obj')
    g.emit(f'{obj} = call ptr @tomato_alloc(i64 {size}, i64 {code})')
    for k, fld in enumerate(c.fields):
        if fld.default is not None:
            v = g.expr(fld.default, fld.ty)
            v = g.want(v, fld.ty, c.line, 'the default of field ' + fld.name)
            v = g.owned(v)
            addr = g.tmp('fld')
            g.emit(f'{addr} = getelementptr %class.{code}, ptr {obj}, i32 0, i32 {str(k + 2)}')
            g.emit(f'store {llvm_type(v.ty)} {v.reg}, ptr {addr}')
    if c.init != '':
        parts: list[str] = ['ptr ' + obj]
        for k, t in enumerate(ptypes):
            parts.append(f'{llvm_type(t)} %arg.{k}')
        init = '@tomato.m.' + str(mod.code_of('@' + mod.find_method(c.name, c.init, c.line).owner)) + '.' + c.init
        g.emit(f'call void {init}(' + ', '.join(parts) + ')')
        pending = g.tmp('ex')
        g.emit(f'{pending} = load ptr, ptr @tomato_exc')
        has = g.tmp('has')
        g.emit(f'{has} = icmp ne ptr {pending}, null ; {init}')
        bad = g.label('initfailed')
        ok = g.label('initok')
        g.cond_br(has, bad, ok)
        g.place(bad)
        g.emit('call void @tomato_release(ptr ' + obj + ')')          # an @init that raised leaves no object behind
        g.br('epilogue')
        g.place(ok)
    g.emit(f'store ptr {obj}, ptr %retval')
    g.br('epilogue')
    finish_function(g, '@tomato.new.' + code, sig, '@' + c.name)

def class_types(mod: Mod) -> str:
    # one struct type per class: the reference count and type code, then the fields
    t = ''
    for c in mod.classes:
        parts = ['i64', 'i64'] + [llvm_type(fld.ty) for fld in c.fields]
        t +='%class.' + str(mod.code_of('@' + c.name)) + ' = type { ' + ', '.join(parts) + ' }\n'
    return t

def vtables(mod: Mod) -> str:
    # one method table per class (a slot per method name), and the table of tables indexed by type code
    n = len(mod.codes) + 2
    heads = ['ptr null'] * n
    text = ''
    k = 0
    for code in mod.codes:
        slot = k + 2
        if is_class(code) and len(mod.slots) > 0:
            entries: list[str] = []
            for name in mod.slots:
                found = mod.lookup_method(code[1:], name)
                if found is not None and not found.is_gen:
                    entries.append(f'ptr {function_symbol(mod, found)}')
                else:
                    entries.append('ptr null')
            text += '@tomato.vt.' + str(slot) + ' = constant [' + str(len(entries)) + ' x ptr] [' + ', '.join(entries) + ']\n'
            heads[slot] = f'ptr @tomato.vt.{slot}'
        k += 1
    text += '@tomato_vtables = constant [' + str(n) + ' x ptr] [' + ', '.join(heads) + ']\n'
    return text

def int_of_bool(b: bool) -> int:
    if b:
        return 1
    return 0

def runtime_tables(mod: Mod) -> str:
    n = len(mod.codes) + 2
    names = ['ptr null'] * n
    zeros = ['i64 0'] * n
    kinds = ['i32 0'] * n
    offsets = ['ptr null'] * n
    extra = ''
    k = 0
    for code in mod.codes:
        slot = k + 2
        if code.startswith('box:'):
            # a union's box: a class-like object with one field, at byte 16, that the runtime releases when it is a heap value
            kinds[slot] = 'i32 1'
            offs: list[str] = []
            if is_rc(code[4:]):
                offs.append('i32 16')
            offs.append('i32 -1')
            if code[4:] == 'int':
                offs.append('i32 16')           # the number it holds belongs to the box
            offs.append('i32 -1')
            extra += '@tomato.offs.' + str(slot) + ' = constant [' + str(len(offs)) + ' x i32] [' + ', '.join(offs) + ']\n'
            offsets[slot] = f'ptr @tomato.offs.{slot}'
        elif is_class(code):
            c = mod.find_class(code[1:], 0)
            kinds[slot] = 'i32 1'
            if c.is_frame:
                kinds[slot] = 'i32 1025'          # bit 10: a task frame, whose dropping may report an unread error
            if c.parent != '':
                zeros[slot] = 'i64 ' + str(mod.code_of('@' + c.parent))
            offs: list[str] = []
            for j, fld in enumerate(c.fields):
                if is_rc(fld.ty):
                    offs.append(f'i32 trunc (i64 ptrtoint (ptr getelementptr (%class.{slot}, ptr null, i32 0, i32 {str(j + 2)}) to i64) to i32)')
            offs.append('i32 -1')
            for j, fld in enumerate(c.fields):
                if fld.ty == 'int':
                    offs.append(f'i32 trunc (i64 ptrtoint (ptr getelementptr (%class.{slot}, ptr null, i32 0, i32 {str(j + 2)}) to i64) to i32)')
            offs.append('i32 -1')
            extra += '@tomato.offs.' + str(slot) + ' = constant [' + str(len(offs)) + ' x i32] [' + ', '.join(offs) + ']\n'
            offsets[slot] = f'ptr @tomato.offs.{slot}'
            if mod.mode == 1:
                extra += f'@tomato.name.{slot} = private constant [{str(len(c.display) + 1)} x i8] c"{c.display}\\00"\n'
                names[slot] = f'ptr @tomato.name.{slot}'
        elif is_mtuple(code):
            # a tuple of mixed item types is laid out like an object: its reference-counted items, then its ints, at 16 + 8 * position
            kinds[slot] = 'i32 1'
            offs: list[str] = []
            parts = mtuple_items(code)
            for pos, it in enumerate(parts):
                if is_rc(it):
                    offs.append(f'i32 {16 + 8 * pos}')
            offs.append('i32 -1')
            for pos, it in enumerate(parts):
                if it == 'int':
                    offs.append(f'i32 {16 + 8 * pos}')
            offs.append('i32 -1')
            extra += '@tomato.offs.' + str(slot) + ' = constant [' + str(len(offs)) + ' x i32] [' + ', '.join(offs) + ']\n'
            offsets[slot] = f'ptr @tomato.offs.{slot}'
        elif is_set(code):
            kinds[slot] = 'i32 ' + str(3 + 256 * int_of_bool(set_elem(code) == 'str'))      # a set of ints says so in its key kind
        elif is_dict(code):
            kinds[slot] = 'i32 ' + str(3 + 256 + 512 * int_of_bool(is_rc(dict_value(code))) + 2048 * int_of_bool(dict_value(code) == 'int'))    # a table with text keys
        elif elem_of(code) == 'str' or is_rc(elem_of(code)):
            kinds[slot] = 'i32 258'          # a list: 2, plus 256 when its items are reference counted
        elif elem_of(code) == 'int':
            kinds[slot] = 'i32 2050'         # plus 2048 when its items are ints, whose big numbers it frees
        else:
            kinds[slot] = 'i32 2'
        k += 1
    count = str(n)
    t = '@tomato_exc = global ptr null\n'
    t += '@tomato_exc_line = global i32 0\n'
    t += '@tomato_exc_rt = global i32 0\n'
    t += '@tomato_exc_seen = global i32 0\n'
    t += extra
    t += '@tomato_class_names = constant [' + count + ' x ptr] [' + ', '.join(names) + ']\n'
    t += '@tomato_parents = global [' + count + ' x i64] [' + ', '.join(zeros) + ']\n'
    t += '@tomato_kinds = constant [' + count + ' x i32] [' + ', '.join(kinds) + ']\n'
    t += '@tomato_offsets = constant [' + count + ' x ptr] [' + ', '.join(offsets) + ']\n'
    return t

def declarations(mod: Mod) -> str:
    d = 'declare i32 @printf(ptr, ...)\n'
    d += 'declare i32 @putchar(i32)\n'
    d += 'declare void @tomato_fail_id(i32, ptr)\n'
    d += 'declare void @tomato_trace(ptr, i32)\n'
    d += 'declare void @tomato_trace_clear()\n'
    d += 'declare void @tomato_leak_check()\n'
    d += 'declare void @tomato_retain(ptr)\n'
    d += 'declare void @tomato_release(ptr)\n'
    d += 'declare void @tomato_release_flat(ptr)\n'
    d += 'declare ptr @tomato_str_concat(ptr, ptr)\n'
    d += 'declare ptr @tomato_str_cat(i64, ptr)\n'
    d += 'declare ptr @tomato_str_from_cstr(ptr)\n'
    d += 'declare i64 @tomato_str_len(ptr)\n'
    d += 'declare i32 @tomato_str_cmp(ptr, ptr)\n'
    d += 'declare i32 @tomato_str_char_eq(ptr, i64, ptr)\n'
    d += 'declare ptr @tomato_str_index(ptr, i64)\n'
    d += 'declare ptr @tomato_str_slice(ptr, i64, i64)\n'
    d += 'declare ptr @tomato_list_concat(ptr, ptr, i32)\n'
    d += 'declare ptr @tomato_list_repeat(ptr, i64, i32)\n'
    d += 'declare ptr @tomato_str_repeat(ptr, i64)\n'
    d += 'declare ptr @tomato_str_slice3(ptr, i64, i64, i64, i32)\n'
    d += 'declare ptr @tomato_list_slice(ptr, i64, i64, i64, i32, i32)\n'
    d += 'declare ptr @tomato_list_sorted(ptr, i32)\n'
    d += 'declare ptr @tomato_list_insert_slot(ptr, i64, i64)\n'
    d += 'declare void @tomato_list_remove_at(ptr, i64, i64)\n'
    d += 'declare void @tomato_list_extend(ptr, ptr, i32)\n'
    d += 'declare void @tomato_list_reverse(ptr, i64)\n'
    d += 'declare void @tomato_list_swap(ptr, ptr)\n'
    d += 'declare i32 @tomato_list_eq_bytes(ptr, ptr, i64)\n'
    d += 'declare ptr @tomato_list_sorted_by(ptr, ptr, i32, i32)\n'
    d += 'declare i32 @tomato_callbacks()\n'
    d += 'declare ptr @tomato_list_sorted_cmp(ptr, ptr, ptr, i32)\n'
    d += 'declare ptr @tomato_str_from_i64(i64)\n'
    d += 'declare ptr @tomato_str_from_bool(i32)\n'
    d += 'declare ptr @tomato_str_from_f64(double)\n'
