    d += 'declare ptr @tomato_box_repr(ptr)\n'
    d += 'declare i64 @tomato_int_dup(i64)\n'

    for op in ['add', 'sub', 'mul', 'floordiv', 'mod', 'shl', 'shr']:
        d += f'declare i64 @tomato_int_{op}_c(i64, i64, i32)\n'
    for op2 in ['add', 'sub', 'mul', 'floordiv', 'mod']:
        d += f'declare i64 @tomato_int_{op2}_slow(i64, i64, i32)\n'
    d += 'declare i64 @tomato_int_floordivp2_c(i64, i32, i32)\n'
    d += 'declare i64 @tomato_int_modp2_c(i64, i32, i32)\n'
    d += 'declare i32 @tomato_int_cmp_c(i64, i64, i32)\n'
    d += 'declare i64 @tomato_int_raw_c(i64, i32)\n'
    d += 'declare void @tomato_int_free(i64)\n'
    d += 'declare void @llvm.assume(i1)\n'
    d += 'declare i64 @tomato_int_add(i64, i64)\n'
    d += 'declare i64 @tomato_int_sub(i64, i64)\n'
    d += 'declare i64 @tomato_int_mul(i64, i64)\n'
    d += 'declare i64 @tomato_int_floordiv(i64, i64)\n'
    d += 'declare i64 @tomato_int_mod(i64, i64)\n'
    d += 'declare i64 @tomato_int_shl(i64, i64)\n'
    d += 'declare i64 @tomato_int_shr(i64, i64)\n'
    d += 'declare i64 @tomato_int_pow(i64, i64)\n'
    d += 'declare i32 @tomato_int_cmp(i64, i64)\n'
    d += 'declare i32 @tomato_int_sign(i64)\n'
    d += 'declare i64 @tomato_int_from_i64(i64)\n'
    d += 'declare i64 @tomato_int_from_u64(i64)\n'
