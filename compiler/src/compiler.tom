# The Tomato compiler, written in Tomato (D38a). It compiles itself, and it is the only implementation.
#
# It takes the syntax tree from compiler/src/parser.tom and writes LLVM IR text that links with the C runtime
# (runtime/tomato_rt.c). compile_module at the end is the entry point: it loads std/builtin.tom and every imported module,
# collects the classes, interfaces and functions (Mod), then compiles each function (Gen) and adds the type tables.
# Types are written as short texts: int, str, list[int], @Class, %Interface, U:a;b for a union, str? for str | None, and
# iN / uN for fixed-width integers. Heap values are reference counted: whoever an expression's value is handed to owns it.
# A problem with the program is raised as a CompileError and reported by diag.tom.
from parser import Node, Val, parse, is_operator_marker, ParseError, val_node, val_nodes, vn, mk, vs, vz, vlist, vtuple, vnodes, vb
from lexer import LexError
from diag import Diagnostic, format_error, closest
from lint import Finding, lint_items, falls_through

class NeedsEarlyCopy(Error):
    # a copy of a generic class is first made after code that loops over every class that fits an Iterable or Sized type was
    # compiled, so that code missed it: the compile starts again with the copy made first (D60a). The message is the class and its type arguments
    @init
    def make(self, message: str):
        Error.start(self, message)

export class CompileError(Error):
    line: int = 0
    col: int = 0

    @init
    def make(self, message: str, line: int, col: int = 0):
        Error.start(self, message)
        self.line = line
        self.col = col

def basic_type(name: str) -> bool:
    return name == 'int' or name == 'bool' or name == 'str' or name == 'File' or name == 'float'

def is_list(t: str) -> bool:
    return t.startswith('list[') or t.startswith('tuple[')

def is_dict(t: str) -> bool:
    return t.startswith('dict[')

def is_set(t: str) -> bool:
    return t.startswith('set[')

# the type inside the brackets: the item type of list[T], tuple[T] and set[T], the value type of dict[V] (whose keys are text)
def elem_of(t: str) -> str:
    return t[t.find('[') + 1:-1]

def set_elem(t: str) -> str:
    return elem_of(t)

def dict_value(t: str) -> str:
    return elem_of(t)

def is_class(t: str) -> bool:
    return t.startswith('@')

def is_iface(t: str) -> bool:
    return t.startswith('%')

def is_union(t: str) -> bool:
    # a union of several types is written 'U:' and its members (sorted, so the same members always give the same type) joined by ';'
    return t.startswith('U:')

def union_members(t: str) -> list[str]:
    return t[2:].split(';')

def union_type(members: list[str]) -> str:
    return 'U:' + ';'.join(sorted(members))

# a function value, fn(A, B) -> R, is written 'fn[A,B>R]' (R is None when it returns nothing)
def is_fn(t: str) -> bool:
    return t.startswith('fn[')

# the position of the > that ends the parameter types of a function type
def fn_arrow(t: str) -> int:
    depth = 0
    for k in range(3, len(t) - 1):
        ch = t[k]
        if ch == '[':
            depth += 1
        elif ch == ']':
            depth -= 1
        elif ch == '>' and depth == 0:
            return k
    return -1

def fn_result(t: str) -> str:
    return t[fn_arrow(t) + 1:-1]

# the parameter types of a function type
def fn_params(t: str) -> list[str]:
    inner = t[3:fn_arrow(t)]
    parts: list[str] = []
    if inner == '':
        return parts
    depth = 0
    start = 0
    for k in range(len(inner)):
        ch = inner[k]
        if ch == '[':
            depth += 1
        elif ch == ']':
            depth -= 1
        elif ch == ',' and depth == 0:
            parts.append(inner[start:k])
            start = k + 1
    parts.append(inner[start:])
    return parts

# The built-in interfaces (D50a): 'I:T' is Iterable[T], 'Z' is Sized and 'IZ:T' is Iterable[T] & Sized. A value of one of these types
# is a box like a union's, holding whatever concrete value was passed (a list, text, a range, an object with @iter or @len).
def is_dyn(t: str) -> bool:
    return t == 'Z' or t.startswith('I:') or t.startswith('IZ:')

def dyn_iterable(t: str) -> bool:
    return t != 'Z'

def dyn_sized(t: str) -> bool:
    return t == 'Z' or t.startswith('IZ:')

# the item type of an Iterable type
def dyn_item(t: str) -> str:
    if t.startswith('IZ:'):
        return t[3:]
    return t[2:]

# lists, tuples, sets and dicts share one layout, so one box member stands for all of them
def dyn_seq() -> str:
    return 'list[int]'

def box_kind(member: str) -> int:
    # how the runtime prints a boxed value: 1 whole number, 3 float, 4 text, 5 bool, 6 anything else
    if member == 'int':
        return 1
    if member == 'float':
        return 3
    if member == 'str':
        return 4
    if member == 'bool':
        return 5
    return 6

def digits_value(s: str) -> int:
    # the number a text of digits writes, or -1 when it is not all digits
    if not s.isdigit():
        return -1
    v = 0
    for c in s:
        v = v * 10 + ord(c) - ord('0')
    return v

def is_fixed(t: str) -> bool:
    # int[length=N] is written iN and uint[length=N] uN
    if len(t) < 2:
        return False
    if not (t.startswith('i') or t.startswith('u')):
        return False
    return digits_value(t[1:]) > 0

def is_numeric(t: str) -> bool:
    return t == 'int' or is_fixed(t)

def bits_of(t: str) -> int:
    if t == 'int':
        return 64
    return digits_value(t[1:])

def is_signed(t: str) -> bool:
    return t == 'int' or t.startswith('i')

def contains(outer: str, inner: str) -> bool:
    # every value of integer type inner is a value of outer
    if is_signed(outer):
        if is_signed(inner):
            return bits_of(outer) >= bits_of(inner)
        return bits_of(outer) > bits_of(inner)
    if is_signed(inner):
        return False
    return bits_of(outer) >= bits_of(inner)

def fits_literal(n: int, t: str, negative: bool) -> bool:
    # does the literal n (written with a minus sign when negative) fit the integer type t?
    bits = bits_of(t)
    if is_signed(t):
        if bits >= 64:
            return True
        if negative:
            return n <= 2 ** (bits - 1)
        return n <= 2 ** (bits - 1) - 1
    if negative:
        return n == 0
    if bits >= 63:
        return True
    return n <= 2 ** bits - 1

def operator_marker_of(op: str) -> str:
    # the marker of the method that implements an operator ('' when the operator cannot be customised)
    if op == '+':
        return 'add'
    if op == '-':
        return 'sub'
    if op == '*':
        return 'mul'
    if op == '/':
        return 'div'
    if op == '//':
        return 'floordiv'
    if op == '%':
        return 'mod'
    if op == '**':
        return 'pow'
    if op == '==' or op == '!=':
        return 'eq'
    if op == '<':
        return 'lt'
    if op == '<=':
        return 'le'
    if op == '>':
        return 'gt'
    if op == '>=':
        return 'ge'
    if op == '&':
        return 'bitand'
    if op == '|':
        return 'bitor'
    if op == '^':
        return 'bitxor'
    return ''

# An async function runs as a frame: a heap object holding its variables and where it stopped. These fields come first, then the variables.
# 0 resume function, 1 where it stopped, 2 status (0 running, 1 done, 2 failed), 3 the tasks waiting for it, 4 its error, 5 and 6 the error line and kind,
# 7 text handed in by input, 8 the result, 9 the statuses it yielded, 10 how many of them were read
const FRAME_FIXED = 13

def is_task(t: str) -> bool:
    return t.startswith('task[')

def task_result(t: str) -> str:
    # task[T] and task[T, S] hold T, with 'None' for a function that returns nothing
    inner = elem_of(t)
    cut = inner.find(';')
    if cut >= 0:
        return inner[0:cut]
    return inner

def task_status(t: str) -> str:
    inner = elem_of(t)
    cut = inner.find(';')
    if cut >= 0:
        return inner[cut + 1:len(inner)]
    return ''

def text_val(s: str) -> Val:
    v = Val()
    v.tag = 's'
    v.text = s
    return v

def contains_await(n: Node) -> bool:
    if n.kind == 'Await':
        return True
    for f in n.fields:
        if val_has_await(f):
            return True
    return False

def val_has_await(v: Val) -> bool:
    if v.tag == 'n':
        return contains_await(val_node(v))
    if v.tag == 'l' or v.tag == 't':
        for item in v.items:
            if val_has_await(item):
                return True
    return False

def task_type_of(info: FuncInfo) -> str:
    res = info.ret
    if res == '':
        res = 'None'
    if info.yields != '':
        return f'task[{res};{info.yields}]'
    return f'task[{res}]'

def is_optional(t: str) -> bool:
    return t.endswith('?')

def strip_optional(t: str) -> str:
    if is_optional(t):
        return t[:-1]
    return t

def is_rc(t: str) -> bool:
    # heap values are reference counted; None is the null pointer, which counting ignores (D23b)
    return t == 'str' or is_task(t) or is_list(t) or is_dict(t) or is_set(t) or is_class(t) or is_iface(t) or t == 'None' or is_optional(t) or is_union(t) or is_dyn(t)

def shown_generic(name: str) -> str:
    # a copy of a generic class, as Box[int]: its type arguments are kept in the internal form inside the name
    at = name.find('[')
    inner = name[at + 1:-1]
    parts: list[str] = []
    depth = 0
    start = 0
    for k in range(len(inner)):
        ch = inner[k]
        if ch == '[':
            depth += 1
        elif ch == ']':
            depth -= 1
        elif ch == ',' and depth == 0:
            parts.append(shown(inner[start:k]))
            start = k + 1
    parts.append(shown(inner[start:]))
    return name[:at] + '[' + ', '.join(parts) + ']'

def shown(t: str) -> str:
    # a type as the user writes it
    if is_fn(t):
        shown_params: list[str] = [shown(p) for p in fn_params(t)]
        res = fn_result(t)
        if res == 'None':
            return 'fn(' + ', '.join(shown_params) + ')'
        return 'fn(' + ', '.join(shown_params) + ') -> ' + shown(res)
    if is_task(t):
        if task_status(t) != '':
            return f'task[{shown(task_result(t))}, {shown(task_status(t))}]'
        return f'task[{shown(task_result(t))}]'
    if t == 'Z':
        return 'Sized'
    if t.startswith('I:'):
        return f'Iterable[{shown(dyn_item(t))}]'
    if t.startswith('IZ:'):
        return f'Iterable[{shown(dyn_item(t))}] & Sized'
    if is_optional(t):
        return f'{shown(strip_optional(t))} | None'
    if is_class(t) and t.find('[') > 0:
        return shown_generic(t[1:])
    if is_class(t) or is_iface(t):
        return t[1:]
    if is_union(t):
        parts: list[str] = [shown(m) for m in union_members(t)]
        return ' | '.join(parts)
    if t.startswith('tuple['):
        return f'tuple[{shown(elem_of(t))}]'
    if is_list(t):
        return f'list[{shown(elem_of(t))}]'
    if is_dict(t):
        return f'dict[str, {shown(dict_value(t))}]'
    if is_set(t):
        return f'set[{shown(set_elem(t))}]'
    if is_fixed(t):
        if t.startswith('i'):
            return 'int[length=' + t[1:] + ']'
        return 'uint[length=' + t[1:] + ']'
    return t

def llvm_type(t: str) -> str:
    if is_rc(t) or t == 'File' or is_fn(t):
        return 'ptr'
    if t == 'float':
        return 'double'
    if is_fixed(t):
        return 'i' + t[1:]
    return 'i64'

def zero_of(t: str) -> str:
    # the value a function returns when it never stored one
    if t == 'int':
        return '1'
    if is_rc(t) or is_fn(t):
        return 'null'
    if t == 'float':
        return '0.0'
    return '0'

# a class or interface name that nothing declares or imports
def not_found(what: str, name: str, line: int) -> CompileError:
    return CompileError(f"the {what} '{name}' does not exist\ncheck its spelling, or import it with 'from module import {name}'", line)

class Ex:
    # a compiled expression: the register or constant that holds it, and its Tomato type
    reg: str = ''
    ty: str = ''
    fresh: bool = False       # an int that the code holding it owns (it frees it or moves it into a place that keeps it), not one borrowed from a variable
    small: bool = False       # an int known to be in the small form, which owns nothing

def ex(reg: str, ty: str) -> Ex:
    e = Ex()
    e.reg = reg
    e.ty = ty
    return e

def exf(reg: str, ty: str) -> Ex:
    # an owned value: a number that nobody else holds (the result of arithmetic or of a call)
    e = ex(reg, ty)
    e.fresh = True
    return e

def exs(reg: str, ty: str) -> Ex:
    # a number known to be small (a length, a position, a loop counter)
    e = ex(reg, ty)
    e.small = True
    return e

def ret_ex(reg: str, ty: str) -> Ex:
    # what a call gave back: the callee hands over a value of its own, so an int is owned
    if ty == 'int':
        return exf(reg, ty)
    return ex(reg, ty)

def small_text(reg: str) -> bool:
    # a constant tagged whole number (written in the IR as digits), which owns nothing
    return reg != '' and (reg[0].isdigit() or reg[0] == '-')

def elem_rc(t: str) -> str:
    # the runtime's flag for list items and table values of type t: 1 reference counted, 2 an int (a big number is copied), 0 plain
    if is_rc(t):
        return '1'
    if t == 'int':
        return '2'
    return '0'

def item_width(t: str) -> int:
    # the bytes one item takes in the storage of a list of type t. A list whose item type is fixed (bool, i8..i32, u8..u32)
    # keeps its items at that width, without the 8-byte slot; every other list, and every tuple, keeps 8-byte slots.
    # A float is already a plain 8-byte double and an int is one tagged 8-byte word (a big number is a pointer in it).
    if not t.startswith('list['):
        return 8
    e = elem_of(t)
    if e == 'bool':
        return 1
    if is_fixed(e):
        b = bits_of(e)
        if b == 8 or b == 16 or b == 32:
            return b // 8
    return 8

def list_flags(t: str) -> str:
    # the runtime's copy flag for the items of a list of type t (elem_rc) plus, for compact items, their width in bytes times 4
    w = item_width(t)
    if w != 8:
        return str(w * 4)
    return elem_rc(elem_of(t))

def item_llvm(w: int) -> str:
    # the LLVM type of one stored item of width w
    return 'i' + str(w * 8)

def pure_read(n: Node) -> bool:
    # an expression that only reads variables and fields, so no user code runs while it is evaluated
    if n.kind == 'Name' or n.kind == 'IntLit' or n.kind == 'FloatLit' or n.kind == 'BoolLit' or n.kind == 'StrLit':
        return True
    if n.kind == 'Attr':
        return pure_read(val_node(n.fields[0]))
    if n.kind == 'UnOp':
        return pure_read(val_node(n.fields[1]))
    return False

def self_update_leaves(name: str, n: Node) -> int:
    # for `name = <n>`: how many times the variable is read in n, or -1 when n is not an arithmetic tree that can hand the old
    # number to an operation. Only + - * and a division or modulo by a non-zero constant (they cannot stop the program after
    # the old number is used up); every other leaf is a literal or a variable.
    if n.kind == 'IntLit':
        return 0
    if n.kind == 'Name':
        if n.fields[0].text == name:
            return 1
        return 0
    if n.kind != 'BinOp':
        return -1
    op = n.fields[0].text
    left = val_node(n.fields[1])
    right = val_node(n.fields[2])
    if op == '//' or op == '%':
        if right.kind != 'IntLit' or right.fields[0].num == 0:
            return -1
    elif op != '+' and op != '-' and op != '*':
        return -1
    a = self_update_leaves(name, left)
    b = self_update_leaves(name, right)
    if a < 0 or b < 0:
        return -1
    return a + b

def self_update(name: str, n: Node) -> bool:
    # `x = 3 * x + 1`, `x = x // 2`, `x = x + 1`: x is read once and the right side is built from + - * and constant divisors
    return n.kind == 'BinOp' and self_update_leaves(name, n) == 1

# the names a lambda body reads
def names_read(n: Node, out: list[str]):
    if n.kind == 'Name':
        out.append(n.fields[0].text)
    for f in n.fields:
        names_read_val(f, out)

def names_read_val(v: Val, out: list[str]):
    if v.tag == 'n':
        names_read(val_node(v), out)
    elif v.tag == 'l' or v.tag == 't':
        for it in v.items:
            names_read_val(it, out)

def has_comp(n: Node) -> bool:
    # does this expression contain a list comprehension (the one expression that assigns to variables)?
    if n.kind == 'ListComp':
        return True
    for f in n.fields:
        if val_has_comp(f):
            return True
    return False

def val_has_comp(v: Val) -> bool:
    if v.tag == 'n':
        return has_comp(val_node(v))
    if v.tag == 'l' or v.tag == 't':
        for it in v.items:
            if val_has_comp(it):
                return True
    return False

class FuncInfo:
    name: str = ''
    line: int = 0            # the line of the def
    owner: str = ''          # the class a method belongs to, or ''
    ret: str = ''
    ptypes: list[str] = []   # without self
    pnames: list[str] = []   # the names of the parameters, in order
    stars: int = 0           # how many trailing parameters are *args or **kwargs
    has_varargs: bool = False
    has_kwargs: bool = False
    defaults: list[Node] = []     # the default values of the last parameters, in order
    is_init: bool = False
    op: str = ''           # the operator a method implements (@add and the other operator markers), or ''
    is_override: bool = False
    is_private: bool = False
    is_gen: bool = False     # the body has a yield: a generator, only usable as what a for loop loops over
    is_async: bool = False   # async def: calling it makes a task, which await or start runs
    yields: str = ''        # what an async function yields as status, or ''
    key: str = ''            # the program-wide name of a function (module.name outside the main program)
    module: str = 'main'
    targs: dict[str, str] = {}   # what the type parameters of a generic class or function stand for in this copy (D60a)

class ImportInfo:
    importer: str = ''
    module: str = ''
    names: list[str] = []
    line: int = 0

class IfaceInfo:
    name: str = ''
    module: str = 'main'
    parents: list[str] = []
    reqs: list[FuncInfo] = []     # the methods the interface itself requires (without self)
    line: int = 0

class FieldInfo:
    name: str = ''
    ty: str = ''
    is_private: bool = False
    is_const: bool = False
    owner: str = ''                # the class that declares the field
    default: Node | None = None   # the starting value, when the field has one

class ClassInfo:
    name: str = ''                # the program-wide key (module.Name outside the main program)
    display: str = ''             # the name as written
    module: str = 'main'
    node: Node | None = None
    fields: list[FieldInfo] = []  # parent fields first
    init: str = ''                # the name of the @init method, or ''
    parent: str = ''              # the parent class, or ''
    ifaces: list[str] = []        # the interfaces the class declares it implements
    done: bool = False            # fields and defaults are complete (inherited ones come first)
    is_frame: bool = False        # the frame of an async function, made by the compiler: no constructor or methods
    line: int = 0
    targs: dict[str, str] = {}    # the type arguments of a copy of a generic class (D60a)
    generic: str = ''             # the generic class this is a copy of, or ''
    populated: bool = True        # the methods of a copy of a generic class are in mod.infos

class Binding:
    # a name a module can see, and the program-wide key it stands for
    module: str = ''
    name: str = ''
    key: str = ''
    exported: bool = False

class Mod:
    # what every function of the program shares
    mode: int = 1                 # error output: 1 debug (full text), 2 release (short codes) (D34b)
    errors: list[str] = []        # the messages of std/errors.txt: the code of a message is its line number (release mode)
    strings: list[str] = []       # the text constants, in the order they are numbered
    string_index: dict[str, int] = {}
    infos: list[FuncInfo] = []
    llvm_decls: list[FuncInfo] = []    # the `!name(...)` functions the program declares (D27a)
    consts: dict[str, Node] = {}  # module constants (export const pi = 3.14): the literal each program-wide name stands for
    decls: list[str] = []         # extra declarations (the overflow intrinsics the program uses)
    codes: list[str] = []         # the heap types the program uses; a type's code is 2 plus its place here
    code_index: dict[str, int] = {}
    classes: list[ClassInfo] = []
    frames: list[ClassInfo] = []  # the frames of the async functions
    ifaces: list[IfaceInfo] = []
    slots: list[str] = []         # method names, one vtable slot each
    cur: str = 'main'             # the module whose names are being resolved
    loading: str = ''             # the module being parsed, for a syntax error
    scope: list[Binding] = []     # the names each module can see, in the order they were declared
    helpers: dict[str, FuncInfo] = {}  # functions the compiler writes for itself (printing a list, sorted, ...), by kind and type
    extra_funcs: list[Node] = []
    lambda_count: int = 0
    func_nodes: list[Node] = []   # the FuncDef of each entry of infos, in the same order
    sources: dict[str, str] = {}  # the source text of each module loaded (for showing an error's line)
    helper_count: int = 0
    main_path: str = ''           # the file name shown for the main program
    warnings: list[str] = []      # the finished text of each warning (compiler/src/lint.tom), shown after a program compiles
    tvars: dict[str, str] = {}    # the type parameters in scope and the types they stand for (D60a)
    generics: dict[str, Node] = {}      # the generic classes and functions, by program-wide name
    generic_mods: dict[str, str] = {}   # the module that declared each
    instance_funcs: dict[str, str] = {} # the copies of generic functions made so far: name and type arguments to key
    pending: list[ClassInfo] = []       # copies of generic classes whose methods are not in infos yet
    late: bool = False                  # the bodies are being compiled: a new copy is complete at once
    instance_count: int = 0
    preload: list[str] = []             # copies of generic classes to make before any body is compiled (see NeedsEarlyCopy)
    dyn_seen: list[str] = []            # the Iterable and Sized types whose loops and lengths are compiled over the classes there are so far
    flat_cache: dict[str, bool] = {}       # flat_type answers, by type

    def code_of(self, t: str) -> int:
        if t in self.code_index:
            return self.code_index[t]
        self.codes.append(t)
        code = len(self.codes) + 1
        self.code_index[t] = code
        return code

    def failure_text(self, message: str, line: int) -> str:
        # what a failure the language raises says in this build mode (D34b): the message, or a short code
        if self.mode == 1:
            return message
        kind = 99
        for k, known in enumerate(self.errors):
            if known != '' and message.startswith(known):
                kind = k + 1
                break
        text = str(kind)
        if kind < 10:
            text = f'0{text}'
        return f'E{text}:{line}'

    def declare(self, text: str):
        if text not in self.decls:
            self.decls.append(text)

    def intern(self, s: str) -> str:
        if s not in self.string_index:
            self.string_index[s] = len(self.strings)
            self.strings.append(s)
        return f'@.str.{self.string_index[s]}'

    def helper(self, kind: str, ty: str, line: int) -> FuncInfo:
        # a function the compiler writes in Tomato for one kind of value (showing a list, sorting one, ...), made the first time it
        # is needed and compiled with the program
        key = f'{kind}:{ty}'
        if key in self.helpers:
            return self.helpers[key]
        self.helper_count += 1
        name = f'_{kind}{self.helper_count}'
        fkey = key_of('builtin', name)
        saved = self.cur
        self.cur = 'builtin'
        saved_vars = self.tvars
        self.tvars = {}
        self.declare_name('builtin', name, fkey, False, 0)
        text = helper_source(self, name, kind, ty, line)
        item = val_nodes(parse(text).fields[0])[0]
        info = function_info(item, self, '')
        helper_types(self, info, kind, ty)
        self.cur = saved
        self.tvars = saved_vars
        self.helpers[key] = info
        self.infos.append(info)
        self.func_nodes.append(item)
        self.extra_funcs.append(item)
        return info

    def node_of(self, info: FuncInfo) -> Node:
        for k, f in enumerate(self.infos):
            if f.key == info.key and f.owner == info.owner and f.name == info.name:
                return self.func_nodes[k]
        raise CompileError(f"internal compiler error: no definition for '{info.name}'", 0)

    def find(self, key: str, line: int) -> FuncInfo:
        for f in self.infos:
            if f.key == key and f.owner == '':
                return f
        raise CompileError(f"the function '{key}' does not exist", line)

    def has_func(self, key: str) -> bool:
        for f in self.infos:
            if f.key == key and f.owner == '':
                return True
        return False

    def lookup_method(self, cls: str, name: str) -> FuncInfo | None:
        # the method as the class or its nearest parent defines it
        for f in self.infos:
            if f.name == name and f.owner == cls:
                return f
        c = self.find_class(cls, 0)
        if c.parent != '':
            return self.lookup_method(c.parent, name)
        return None

    def find_op(self, cls: str, marker: str) -> FuncInfo | None:
        # the method of the class (or its nearest parent) marked as implementing this operator
        for fi in self.infos:
            if fi.owner == cls and fi.op == marker:
                return fi
        c = self.find_class(cls, 0)
        if c.parent != '':
            return self.find_op(c.parent, marker)
        return None

    def has_op(self, cls: str, marker: str) -> bool:
        found = self.find_op(cls, marker)
        return found is not None and not found.is_async

    def find_method(self, cls: str, name: str, line: int) -> FuncInfo:
        found = self.lookup_method(cls, name)
        if found is None:
            raise CompileError(f"'{cls}' has no method '{name}'", line)
        return found

    def resolve(self, name: str) -> str:
        # the program-wide key a name written in the current module stands for, or '' (D24c)
        found = self.binding(self.cur, name)
        if found is None:
            found = self.binding('builtin', name)
        if found is None:
            return ''
        return found.key

    def binding(self, module: str, name: str) -> Binding | None:
        for b in self.scope:
            if b.module == module and b.name == name:
                return b
        return None

    def class_key(self, name: str, line: int) -> str:
        key = self.resolve(name)
        if key == '' or not self.has_class(key):
            raise not_found('class', name, line)
        return key

    def iface_key(self, name: str, line: int) -> str:
        key = self.resolve(name)
        if key == '' or not self.has_iface(key):
            raise not_found('interface', name, line)
        return key

    def declare_name(self, module: str, name: str, key: str, exported: bool, line: int):
        if self.binding(module, name) is not None:
            raise CompileError(f"'{name}' is defined twice in module '{module}'\nrename one of them", line)
        b = Binding()
        b.module = module
        b.name = name
        b.key = key
        b.exported = exported
        self.scope.append(b)

    def exported_key(self, module: str, name: str, line: int) -> str:
        b = self.binding(module, name)
        if b is not None:
            if not b.exported:
                raise CompileError(f"module '{module}' does not export '{name}'\nput 'export' before its definition in {module}.tom", line)
            return b.key
        raise CompileError(f"module '{module}' has no '{name}'\ncheck the spelling in {module}.tom", line)

    def has_iface(self, name: str) -> bool:
        for i in self.ifaces:
            if i.name == name:
                return True
        return False

    def find_iface(self, name: str, line: int) -> IfaceInfo:
        for i in self.ifaces:
            if i.name == name:
                return i
        raise not_found('interface', name, line)

    def iface_closure(self, name: str, out: list[str]):
        # the interface and every interface it extends
        if name in out:
            return
        out.append(name)
        for p in self.find_iface(name, 0).parents:
            self.iface_closure(p, out)

    def class_ifaces(self, cls: str) -> list[str]:
        # every interface a class satisfies: its own, its parents', and what those extend
        out: list[str] = []
        c = self.find_class(cls, 0)
        for i in c.ifaces:
            self.iface_closure(i, out)
        if c.parent != '':
            for i in self.class_ifaces(c.parent):
                self.iface_closure(i, out)
        return out

    def requirement(self, iface: str, name: str) -> FuncInfo | None:
        # the method an interface (or one it extends) requires
        closure: list[str] = []
        self.iface_closure(iface, closure)
        for i in closure:
            for r in self.find_iface(i, 0).reqs:
                if r.name == name:
                    return r
        return None

    def slot_of(self, name: str) -> int:
        for k, n in enumerate(self.slots):
            if n == name:
                return k
        raise CompileError(f'internal compiler error: no method table slot for {name}', 0)

    def assignable(self, a: str, b: str) -> bool:
        # may a value of type a be used where b is wanted (no conversion needed)?
        if a == b or self.subclass(a, b):
            return True
        if is_dyn(a) and is_dyn(b):
            return self.dyn_covers(a, b)
        if is_iface(b):
            if is_class(a) and self.has_class(a[1:]):
                return b[1:] in self.class_ifaces(a[1:])
            if is_iface(a):
                closure: list[str] = []
                self.iface_closure(a[1:], closure)
                return b[1:] in closure
            return False
        if is_union(a) and is_union(b):
            # a narrowed union (some members ruled out) shares the box of the whole one
            for m in union_members(a):
                if m not in union_members(b):
                    return False
            return True
        if is_optional(b):
            return a == 'None' or self.assignable(a, strip_optional(b))
        return False

    # what a for loop yields from a value of type vt, or '' when it cannot loop over one
    def iter_item(self, vt: str) -> str:
        if vt == 'str' or is_dict(vt):
            return 'str'
        if is_list(vt) or is_set(vt):
            return elem_of(vt)
        if is_class(vt) and self.has_class(vt[1:]):
            f = self.find_op(vt[1:], 'iter')
            if f is not None:
                return f.ret
        return ''

    # does len() work on a value of type vt?
    def has_length(self, vt: str) -> bool:
        if vt == 'str' or is_list(vt) or is_dict(vt) or is_set(vt):
            return True
        if is_class(vt) and self.has_class(vt[1:]):
            f = self.find_op(vt[1:], 'len')
            return f is not None and len(f.ptypes) == 0 and f.ret == 'int'
        return False

    # may a value of the concrete type vt be used as the interface type dyn? (no `implements` needed: having the method is enough)
    def dyn_accepts(self, vt: str, dyn: str) -> bool:
        if dyn_iterable(dyn) and self.iter_item(vt) != dyn_item(dyn):
            return False
        return not dyn_sized(dyn) or self.has_length(vt)

    # does the interface type a give everything the interface type b does?
    def dyn_covers(self, a: str, b: str) -> bool:
        if dyn_iterable(b) and not (dyn_iterable(a) and dyn_item(a) == dyn_item(b)):
            return False
        return not dyn_sized(b) or dyn_sized(a)

    # the concrete types a value of an interface type can be holding: the shared container layout, text and every class that fits
    def dyn_members(self, dyn: str) -> list[str]:
        self.dyn_seen.append(dyn)
        out = [dyn_seq()]
        if self.dyn_accepts('str', dyn):
            out.append('str')
        for c in self.classes:
            if self.dyn_accepts('@' + c.name, dyn):
                out.append(f'@{c.name}')
        return out

    def subclass(self, a: str, b: str) -> bool:
        # is class a (written '@A') the same as b or a descendant of it?
        if a == b:
            return True
        if not (is_class(a) and is_class(b)) or not self.has_class(a[1:]):
            return False
        c = self.find_class(a[1:], 0)
        if c.parent == '':
            return False
        return self.subclass(f'@{c.parent}', b)

    def has_class(self, name: str) -> bool:
        for c in self.classes:
            if c.name == name:
                return True
        return False

    def find_class(self, name: str, line: int) -> ClassInfo:
        for c in self.classes:
            if c.name == name:
                return c
        raise not_found('class', name, line)

    def flat_type(self, t: str) -> bool:
        # a value of this static type can never be part of a reference cycle: text, or an object whose class has no
        # reference-counted fields and no subclass (a subclass could add some). Its release skips the cycle-collector test.
        if t == 'str':
            return True
        if not is_class(t):
            return False
        if t in self.flat_cache:
            return self.flat_cache[t]
        found = False
        ans = True
        for c in self.classes:
            if c.name == t[1:]:
                found = True
                if c.is_frame or not c.done or not c.populated:
                    return False
                for f in c.fields:
                    if is_rc(f.ty):
                        ans = False
            if c.parent == t[1:]:
                ans = False
        if not found:
            return False
        self.flat_cache[t] = ans
        return ans

    def field_index(self, c: ClassInfo, name: str, line: int) -> int:
        k = field_position(c, name)
        if k >= 0:
            return k
        raise CompileError(f"'{c.name}' has no field '{name}'", line)

    def has_none_member(self, members: list[Node]) -> bool:
        found = False
        for m in members:
            if m.fields[0].text == 'None':
                found = True
        return found

    def union_of(self, members: list[Node]) -> str:
        # a union of several types (D23g): each member is a type the compiler knows, none repeated
        names: list[str] = []
        inner = ''
        parts: list[str] = []
        for m in members:
            inner = self.type_name(vn(m))
            if inner == '' or is_fixed(inner) or is_optional(inner):
                return ''
            parts = [inner]
            if is_union(inner):
                parts = union_members(inner)
            for x in parts:
                if x in names:
                    return ''
                names.append(x)
        return union_type(names)

    # ---- generic classes and functions (D60a): `class Box[T]` and `def first[T](items: list[T]) -> T`. Nothing is compiled for the
    # declaration itself; each use with other types makes a copy in which every T stands for a type (the type arguments).
    def is_generic(self, key: str, kind: str) -> bool:
        return key in self.generics and self.generics[key].kind == kind

    def type_params_of(self, key: str) -> list[str]:
        node = self.generics[key]
        out: list[str] = []
        for tp in node.fields[len(node.fields) - 1].items:
            out.append(tp.text)
        return out

    def class_args(self, c: ClassInfo) -> list[str]:
        out: list[str] = []
        for tp in self.type_params_of(c.generic):
            out.append(c.targs[tp])
        return out

    def arg_key(self, args: list[str]) -> str:
        return ','.join(args)

    # the copy of a generic class for these type arguments (made the first time it is asked for); returns its program-wide name
    def instance_class(self, gkey: str, args: list[str], line: int) -> str:
        tparams = self.type_params_of(gkey)
        node = self.generics[gkey]
        if len(args) != len(tparams):
            raise CompileError(f"'{node.fields[0].text}' takes {plural(len(tparams), 'type argument')}, but {len(args)} given", line)
        key = f'{gkey}[{self.arg_key(args)}]'
        if self.has_class(key):
            return key
        c = ClassInfo()
        c.name = key
        c.display = shown('@' + key)
        c.module = self.generic_mods[gkey]
        c.node = node
        c.line = node.line
        c.generic = gkey
        c.populated = False
        for k, tp in enumerate(tparams):
            c.targs[tp] = args[k]
        saved = self.cur
        self.cur = c.module
        if node.fields[1].tag == 's':
            c.parent = self.class_key(node.fields[1].text, node.line)
        for iv in node.fields[2].items:
            c.ifaces.append(self.iface_key(iv.text, node.line))
        self.cur = saved
        self.classes.append(c)
        self.pending.append(c)
        if self.late:
            self.populate_pending()
        return key

    # give the copies made so far their methods (they are compiled with the program like any other function)
    def populate_pending(self):
        while len(self.pending) > 0:
            c = self.pending[0]
            self.pending = self.pending[1:]
            saved = self.cur
            saved_vars = self.tvars
            resolve_class(self, c)
            self.cur = c.module
            self.tvars = c.targs
            for m in val_nodes(class_def(c).fields[4]):
                info = function_info(m, self, c.name)
                info.targs = c.targs
                self.infos.append(info)
                self.func_nodes.append(m)
                self.extra_funcs.append(m)
                if m.fields[6].tag == 's' and m.fields[6].text == 'init':
                    c.init = info.name
            self.tvars = saved_vars
            c.populated = True
            self.cur = saved
            if self.late:
                check_classes(self)
                check_class_shapes(self)
                for d in self.dyn_seen:
                    if self.dyn_accepts('@' + c.name, d):
                        raise NeedsEarlyCopy(c.generic + '\n' + '\n'.join(self.class_args(c)))

    # the copy of a generic function for these type arguments
    def instance_func(self, gkey: str, args: list[str], line: int) -> FuncInfo:
        tparams = self.type_params_of(gkey)
        node = self.generics[gkey]
        if len(args) != len(tparams):
            raise CompileError(f"'{node.fields[0].text}' takes {plural(len(tparams), 'type argument')}, but {len(args)} given", line)
        name = f'{gkey}[{self.arg_key(args)}]'
        if name in self.instance_funcs:
            return self.find(self.instance_funcs[name], line)
        binds: dict[str, str] = {}
        for k, tp in enumerate(tparams):
            binds[tp] = args[k]
        saved = self.cur
        saved_vars = self.tvars
        self.cur = self.generic_mods[gkey]
        self.tvars = binds
        info = function_info(node, self, '')
        self.cur = saved
        self.tvars = saved_vars
        self.instance_count += 1
        info.targs = binds
        info.key = f'{gkey}.g{self.instance_count}'
        self.instance_funcs[name] = info.key
        self.infos.append(info)
        self.func_nodes.append(node)
        self.extra_funcs.append(node)
        return info

    # are these types patterns, with a $T standing for a type still to be found?
    def pattern_mode(self, targs: list[str]) -> bool:
        for ta in targs:
            if ta.find('$') >= 0:
                return True
        return False

    def type_delim(self, c: str) -> bool:
        return c == ']' or c == '[' or c == ',' or c == '>' or c == ';' or c == '?' or c == '|' or c == ':'

    # does the real type act fit the pattern pat, whose $T parts stand for types still to be found? Records them in binds.
    def unify(self, pat: str, act: str, binds: dict[str, str]) -> bool:
        if (pat.startswith('I:') or pat.startswith('IZ:')) and pat.find('$') >= 0:
            item = ''
            if is_dyn(act):
                if dyn_iterable(act):
                    item = dyn_item(act)
            else:
                item = self.iter_item(act)
            if item == '':
                return False
            return self.unify(dyn_item(pat), item, binds)
        i = 0
        j = 0
        while i < len(pat):
            c = pat[i]
            if c == '$':
                end = i + 1
                while end < len(pat) and not self.type_delim(pat[end]):
                    end += 1
                name = pat[i + 1:end]
                stop = ''
                if end < len(pat):
                    stop = pat[end]
                k = j
                depth = 0
                while k < len(act):
                    d = act[k]
                    if depth == 0 and stop != '' and d == stop:
                        break
                    if d == '[':
                        depth += 1
                    elif d == ']':
                        if depth == 0:
                            break
                        depth -= 1
                    k += 1
                found = act[j:k]
                if found == '':
                    return False
                if name in binds:
                    if binds[name] != found:
                        return False
                else:
                    binds[name] = found
                i = end
                j = k
            else:
                if j >= len(act) or act[j] != c:
                    return False
                i += 1
                j += 1
        return j == len(act)

    # `Iterable[T] & Sized`: the built-in interfaces joined (D50a); the other uses of & are not built yet
    def dyn_intersection(self, members: list[Node]) -> str:
        item = ''
        sized = False
        for m in members:
            part = self.type_name(vn(m))
            if part == 'Z':
                sized = True
            elif part.startswith('I:') and (item == '' or item == dyn_item(part)):
                item = dyn_item(part)
            else:
                return ''
        if item == '':
            return 'Z'
        if sized:
            return f'IZ:{item}'
        return f'I:{item}'

    # fn(A, B) -> R is written fn[A,B>R] inside the compiler, with None for no result (a function value is a plain pointer)
    def fn_type(self, t: Node) -> str:
        parts: list[str] = []
        for p in val_nodes(t.fields[2]):
            pt = self.type_name(vn(p))
            if pt == '' or pt == 'None':
                return ''
            parts.append(pt)
        res = 'None'
        if t.fields[3].tag == 'n':
            res = self.type_name(t.fields[3])
            if res == '':
                if val_node(t.fields[3]).fields[0].text != 'None':
                    return ''
                res = 'None'
        return 'fn[' + ','.join(parts) + '>' + res + ']'

    def type_name(self, v: Val) -> str:
        # the name of a type the compiler knows: int, bool, str, a declared class ('@Name') or a list of those; '' otherwise
        if v.tag != 'n':
            return ''
        t = val_node(v)
        name = t.fields[0].text
        if t.fields[1].tag == 'z' and t.fields[2].tag == 'z' and name in self.tvars:
            return self.tvars[name]
        if (name == 'int' or name == 'uint') and t.fields[1].tag == 'n':
            length = val_node(t.fields[1])
            if length.kind != 'IntLit' or length.fields[0].num < 1 or length.fields[0].num > 64:
                return ''
            if name == 'int':
                return f'i{length.fields[0].num}'
            return f'u{length.fields[0].num}'
        if name == 'fn' and t.fields[1].tag == 'z' and t.fields[2].tag != 'n' and t.fields[2].tag != 'z':
            return self.fn_type(t)
        if name == 'union':
            members = val_nodes(t.fields[2])
            if len(members) != 2 or not self.has_none_member(members):
                if self.has_none_member(members):
                    return ''
                return self.union_of(members)
            other = members[0]
            if other.fields[0].text == 'None':
                other = members[1]
            elif members[1].fields[0].text != 'None':
                return ''
            wrapped = self.type_name(vn(other))
            if not (wrapped == 'str' or is_list(wrapped) or is_dict(wrapped) or is_set(wrapped) or is_class(wrapped) or is_iface(wrapped)):
                return ''
            return f'{wrapped}?'
        if name == 'task' and t.fields[2].tag == 'n' and t.fields[1].tag == 'z':
            res = self.type_name(t.fields[2])
            if res == '' and val_node(t.fields[2]).fields[0].text == 'None':
                res = 'None'
            if res == '' or is_fixed(res):
                return ''
            if t.fields[3].tag == 'n':
                st = self.type_name(t.fields[3])
                if st == '' or is_fixed(st):
                    return ''
                return f'task[{res};{st}]'
            return f'task[{res}]'
        if name == 'intersection':
            return self.dyn_intersection(val_nodes(t.fields[2]))
        if name == 'Iterable' and t.fields[2].tag == 'n' and self.resolve(name) == '':
            item = self.type_name(t.fields[2])
            if item == '' or is_optional(item):
                return ''
            return f'I:{item}'
        if name == 'Sized' and t.fields[2].tag == 'z' and t.fields[1].tag == 'z' and self.resolve(name) == '':
            return 'Z'
        if name == 'set' and t.fields[2].tag == 'n':
            member = self.type_name(t.fields[2])
            if member == 'str' or member == 'int' or member == 'bool':
                return f'set[{member}]'
            return ''
        if name == 'dict' and t.fields[2].tag == 'n' and t.fields[3].tag == 'n':
            if self.type_name(t.fields[2]) != 'str':
                return ''
            inner = self.type_name(t.fields[3])
            if inner == '' or is_fixed(inner):
                return ''
            return f'dict[{inner}]'
        if (name == 'list' or name == 'tuple') and t.fields[2].tag == 'n' and t.fields[1].tag == 'z':
            inner = self.type_name(t.fields[2])
            if inner == '' or is_fixed(inner):
                return ''
            return f'{name}[{inner}]'
        gkey = self.resolve(name)
        if gkey != '' and self.is_generic(gkey, 'ClassDef'):
            if t.fields[2].tag != 'n' or t.fields[1].tag != 'z':
                raise CompileError(f"'{name}' is generic, so it needs its type arguments: {name}[{', '.join(self.type_params_of(gkey))}]", t.line)
            targs: list[str] = [self.type_name(t.fields[2])]
            if t.fields[3].tag == 'n':
                targs.append(self.type_name(t.fields[3]))
            for ta in targs:
                if ta == '':
                    return ''
            if self.pattern_mode(targs):
                return f'@{gkey}[{self.arg_key(targs)}]'
            return '@' + self.instance_class(gkey, targs, t.line)
        if t.fields[2].tag != 'z' or t.fields[1].tag != 'z':
            return ''
        if basic_type(name):
            return name
        key = self.resolve(name)
        if key != '' and self.has_class(key):
            return f'@{key}'
        if key != '' and self.has_iface(key):
            return f'%{key}'
        return ''

!tomato_str_nbytes(s: str) -> int
!tomato_str_byte(s: str, i: int) -> int

def escape_byte(b: int) -> str:
    # one byte of a text constant as LLVM writes it: printable ASCII as itself, anything else as \XX (D17a-b: text is UTF-8)
    ascii = ' !"#$%&\'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~'
    if b >= 32 and b < 127 and b != 34 and b != 92:
        return ascii[b - 32]
    digits = '0123456789ABCDEF'
    return f'\\{digits[b // 16]}{digits[b % 16]}'

def escape_text(s: str) -> str:
    body = ''
    for i in range(!tomato_str_nbytes(s)):
        body += escape_byte(!tomato_str_byte(s, i))
    return body

def string_global(index: int, s: str) -> str:
    size = str(!tomato_str_nbytes(s) + 1)
    body = escape_text(s)
    return '@.str.' + str(index) + ' = private constant { i64, i64, i64, i64, [' + size + ' x i8] } { i64 -1, i64 1, i64 ' + str(!tomato_str_nbytes(s)) + ', i64 ' + str(len(s)) + ', [' + size + ' x i8] c"' + body + '\\00" }'

def string_c(index: int, s: str) -> str:
    # a plain C copy, which is what tomato_fail prints
    return '@.str.' + str(index) + '.c = private constant [' + str(!tomato_str_nbytes(s) + 1) + ' x i8] c"' + escape_text(s) + '\\00"'

class TryInfo:
    # a try statement being compiled (D22a)
    catch_l: str = ''         # where an error raised in the body goes
    prop_l: str = ''          # where an error leaving the statement goes (after the finally block runs)
    final: list[Node] = []
    has_final: bool = False
    loop_depth: int = 0
    state: str = 'body'       # 'body' while compiling the try body, then 'post'

class GenCtx:
    # one generator being compiled into a for loop: where the loop variable lives, the loop body, and the scope not currently in use
    var: str = ''
    ty: str = ''
    body: list[Node] = []
    end: str = ''
    try_depth: int = 0
    slots: dict[str, str] = {}
    types: dict[str, str] = {}
    narrowed: list[str] = []
    settled: list[str] = []
    ret: str = ''
    owner: str = ''
    in_init: bool = False
    module: str = ''
    targs: dict[str, str] = {}

class CompCtx:
    # a list comprehension being compiled: the slot holding the new list and its type (known once the first item is compiled)
    holder: str = ''
    ty: str = ''

class Gen:
    # one function being compiled
    comps: list[CompCtx] = []     # the list comprehensions being compiled, innermost last
    mod: Mod = Mod()
    lines: list[str] = []
    allocas: list[str] = []
    rc_slots: list[str] = []
    held: list[Ex] = []           # owned temporaries waiting while the rest of an expression is evaluated: a failing check releases them
    flat_slots: list[str] = []    # the rc_slots whose type can never be in a cycle (released with tomato_release_flat)
    int_slots: list[str] = []     # the places that own an int (a big number in one is freed with the function)
    assigned: list[str] = []      # the names of variables that are written (a name given to slot()) after the parameters were set up
    kw: list[Val] = []            # the keyword arguments of the call being compiled, picked up by call_function
    narrowed: list[str] = []      # variables that are narrowed from a union inside the branch being compiled
    take_name: str = ''           # `x = x + 1`: the int local whose one read in the right side hands its number over to the operation
    mark_prefix: str = ''        # inside a small-int loop: the prefix of the labels its fast copy jumps back to (see small_loop)
    taken: Ex = ex('', '')        # that read (fresh while an operation has not used it up)
    settled: list[str] = []       # the narrowed variables whose narrowing lasts to the end of the block (after an if that left)
    after: list[list[str]] = []   # for each of those: its name, slot and type before, put back when the block ends
    slots: dict[str, str] = {}
    types: dict[str, str] = {}
    n: int = 0
    terminated: bool = False
    breaks: list[str] = []
    conts: list[str] = []
    loop_depth: int = 0
    tries: list[TryInfo] = []
    try_depth: int = 0
    slot_count: int = 0
    line: int = 0
    fname: str = ''           # the function's name as a call trace shows it (Class.method for a method)
    owner: str = ''           # the class whose method is being compiled, or ''
    in_init: bool = False
    ret: str = ''
    gens: list[GenCtx] = []   # the generators being compiled into for loops, innermost last (only the first gen_n count)
    gen_n: int = 0
    is_async: bool = False     # compiling an async function: its variables live in a heap frame so it can stop and go on later
    frame_code: int = 0        # the type code of that frame
    frame_types: list[str] = []   # the type of each frame field after the fixed ones
    awaits: int = 0            # the number of places this function can stop at
    ret_yields: str = ''        # what a yield gives out, for an async function with a status
    async_ok: bool = False     # the call being compiled is directly under await or start, so it may be an async call
    fresh_frame: bool = False  # the last call made a new task frame
    lifted: int = 0            # how many awaits were moved into statements of their own

    def tmp(self, hint: str) -> str:
        self.n += 1
        return f'%{hint}.{self.n}'

    def label(self, hint: str) -> str:
        self.n += 1
        return f'{hint}.{self.n}'

    def emit(self, text: str):
        if self.terminated:
            self.lines.append(self.label('dead') + ':')
            self.terminated = False
        self.lines.append(f'  {text}')

    def place(self, label: str):
        self.lines.append(f'{label}:')
        self.terminated = False

    def br(self, label: str):
        self.emit(f'br label %{label}')
        self.terminated = True

    def cond_br(self, c: str, yes: str, no: str):
        self.emit(f'br i1 {c}, label %{yes}, label %{no}')
        self.terminated = True

    def unwind_target(self) -> str:
        # where an error raised here goes: the innermost try's catch (or its finally once past the body), else out of
        # the function, which returns early so that its caller can check (D22a)
        if self.try_depth > 0:
            t = self.tries[self.try_depth - 1]
            if t.state == 'body':
                return t.catch_l
            return t.prop_l
        return 'epilogue'

    def slot(self, name: str, ty: str, line: int) -> str:
        self.assigned.append(name)
        if name in self.slots:
            if self.types[name] != ty:
                raise CompileError(f"the variable '{name}' already has type {shown(self.types[name])}, so it cannot be redeclared as {shown(ty)}", line)
            return self.slots[name]
        return self.new_slot(name, ty)

    def make_slot(self, reg: str, ty: str):
        # a place for a value: a stack slot, or a field of the frame in an async function. A value that needs releasing starts out null.
        if self.is_async:
            self.frame_types.append(ty)
            self.allocas.append(f'  {reg} = getelementptr %class.{self.frame_code}, ptr %frame, i32 0, i32 {str(len(self.frame_types) - 1 + FRAME_FIXED + 2)}')
            if is_rc(ty):
                self.rc_slots.append(reg)
                if self.mod.flat_type(ty):
                    self.flat_slots.append(reg)
            elif ty == 'int':
                self.int_slots.append(reg)
            return
        self.allocas.append(f'  {reg} = alloca {llvm_type(ty)}')
        if is_rc(ty):
            self.allocas.append(f'  store ptr null, ptr {reg}')
            self.rc_slots.append(reg)
            if self.mod.flat_type(ty):
                self.flat_slots.append(reg)
        elif ty == 'int':
            self.allocas.append(f'  store i64 0, ptr {reg}')
            self.int_slots.append(reg)

    def new_slot(self, name: str, ty: str) -> str:
        self.slot_count += 1
        reg = f'%v.{name}.{self.slot_count}'
        self.make_slot(reg, ty)
        self.slots[name] = reg
        self.types[name] = ty
        return reg

    def hidden_slot(self, hint: str) -> str:
        reg = self.tmp(hint)
        self.make_slot(reg, 'u64')
        return reg

    def hidden_int_slot(self, hint: str) -> str:
        reg = self.tmp(hint)
        self.make_slot(reg, 'int')
        return reg

    def hidden_rc_slot(self, hint: str) -> str:
        reg = self.tmp(hint)
        self.make_slot(reg, 'str')
        return reg

    # ---- reference counting
    def retain(self, e: Ex):
        # e was just read from a place that keeps its value (a field, a list item): take a reference of our own. A big int cannot
        # be shared, so e becomes a copy that we own.
        if is_rc(e.ty):
            self.emit(f'call void @tomato_retain(ptr {e.reg})')
        elif e.ty == 'int':
            d = self.tmp('dup')
            self.emit(f'{d} = call i64 @tomato_int_dup(i64 {e.reg})')
            e.reg = d
            e.fresh = True

    def slot_release(self, reg: str) -> str:
        if reg in self.flat_slots:
            return 'tomato_release_flat'
        return 'tomato_release'

    def release_fn(self, ty: str) -> str:
        if self.mod.flat_type(ty):
            return 'tomato_release_flat'
        return 'tomato_release'

    def release(self, e: Ex):
        # a borrowed read of a local (see expr_b) holds no reference of its own, so there is nothing to release
        if is_rc(e.ty) and not e.reg.startswith('%bl.'):
            self.emit(f'call void @{self.release_fn(e.ty)}(ptr {e.reg})')
        elif e.ty == 'int' and e.fresh and not e.small and not small_text(e.reg):
            self.emit(f'call void @tomato_int_free(i64 {e.reg})')


    def owned(self, e: Ex) -> Ex:
        # e as a value the caller may keep: an int borrowed from a variable is copied, everything else is already owned
        if e.ty == 'int' and not e.fresh and not e.small and not small_text(e.reg):
            d = self.tmp('dup')
            self.emit(f'{d} = call i64 @tomato_int_dup(i64 {e.reg})')
            return exf(d, 'int')
        return e

    def can_borrow(self, n: Node, others: list[Node]) -> bool:
        # a plain local that holds a heap value can be read without retain/release when it is only looked at while the current
        # operation runs: the local itself keeps the value alive, and nothing in an expression can assign to a local of this
        # function except a list comprehension that reuses its name (calls run in their own frames, there are no closures)
        if n.kind != 'Name':
            return False
        name = n.fields[0].text
        if name not in self.slots or not is_rc(self.types[name]):
            return False
        for o in others:
            if has_comp(o):
                return False
        return True

    def expr_b(self, n: Node, others: list[Node]) -> Ex:
        # like expr, but a local variable is lent without a retain; release() ignores the result. others are the expressions
        # evaluated while the lent value is in use.
        if self.can_borrow(n, others):
            name = n.fields[0].text
            r = self.tmp('bl')
            self.emit(f'{r} = load ptr, ptr {self.slots[name]}')
            return ex(r, self.types[name])
        return self.expr(n)

    def store_owned(self, slot: str, e: Ex):
        # the slot takes over the reference and releases what it held
        if is_rc(e.ty):
            old = self.tmp('old')
            self.emit(f'{old} = load ptr, ptr {slot}')
            self.emit(f'store ptr {e.reg}, ptr {slot}')
            self.emit(f'call void @{self.slot_release(slot)}(ptr {old})')
        elif e.ty == 'int':
            v = self.owned(e)                 # copied first: it may be the very number the slot is about to drop
            old = self.tmp('old')
            self.emit(f'{old} = load i64, ptr {slot}')
            self.emit(f'store i64 {v.reg}, ptr {slot}')
            self.emit(f'call void @tomato_int_free(i64 {old})')
        else:
            self.emit(f'store {llvm_type(e.ty)} {e.reg}, ptr {slot}')

    def unwrap(self, e: Ex, line: int, live: list[Ex] = []) -> Ex:
        # an optional used where a value is needed: stop when it is None (D23b)
        if not is_optional(e.ty):
            return e
        bad = self.tmp('isnone')
        self.emit(f'{bad} = icmp eq ptr {e.reg}, null')
        self.fail_if(bad, 'None where a value is needed', live)
        return ex(e.reg, strip_optional(e.ty))

    def resize(self, e: Ex, to: str) -> Ex:
        # the same number in another integer type that holds all of its values
        if e.ty == to:
            return e
        if to == 'int' and e.ty != 'int':
            if bits_of(e.ty) < 62:
                return self.tag_small(self.widen(e, 64))
            return self.int_from_machine(self.widen(e, 64), is_signed(e.ty))
        fb = bits_of(e.ty)
        tb = bits_of(to)
        if fb == tb:
            return ex(e.reg, to)
        r = self.tmp('ext')
        op = 'sext' if is_signed(e.ty) else 'zext'
        self.emit(f'{r} = {op} {llvm_type(e.ty)} {e.reg} to {llvm_type(to)}')
        return ex(r, to)

    def want(self, e: Ex, ty: str, line: int, what: str) -> Ex:
        # check that e fits the type ty and return it as that type (a number is widened, an optional unwrapped)
        if is_class(e.ty) and e.ty != '@bitarray.bitarray' and (ty == '@bitarray.bitarray' or (is_union(ty) and '@bitarray.bitarray' in union_members(ty))) and self.mod.has_op(e.ty[1:], 'bitarray'):
            # an object whose class has a method marked @bitarray is used as the bitarray that method returns
            conv = self.mod.find_op(e.ty[1:], 'bitarray')
            if len(conv.ptypes) != 0 or conv.ret != '@bitarray.bitarray':
                raise CompileError(f"the @bitarray method '{conv.name}' must take nothing besides self and return a bitarray", line)
            e = self.marker_call(e, conv, [], line)
        if is_optional(e.ty) and not is_optional(ty) and ty != 'None' and self.mod.assignable(strip_optional(e.ty), ty):
            self.unwrap(e, line)
            return ex(e.reg, strip_optional(e.ty))
        if e.ty == ty:
            return e
        if is_numeric(e.ty) and is_numeric(ty):
            if not contains(ty, e.ty):
                raise CompileError(f'{what} has type {shown(e.ty)}, but {shown(ty)} is expected\nconvert it explicitly first', line)
            return self.resize(e, ty)
        if is_union(ty) and not is_union(e.ty):
            return self.box_value(e, ty, line, what)
        if is_dyn(ty) and not is_dyn(e.ty):
            return self.box_dyn(e, ty, line, what)
        if not self.mod.assignable(e.ty, ty):
            raise CompileError(f'{what} has type {shown(e.ty)}, but {shown(ty)} is expected', line)
        return e

    def union_member_for(self, vt: str, ty: str) -> str:
        # the member of union ty that a value of type vt belongs to: the same type first, else one it can be used as; '' when none
        members = union_members(ty)
        if vt in members:
            return vt
        for m in members:
            if self.mod.assignable(vt, m):
                return m
        return ''

    def box_value(self, e: Ex, ty: str, line: int, what: str) -> Ex:
        # a value stored where a union is wanted: a small heap object holding the value and which member it is
        member = self.union_member_for(e.ty, ty)
        if member == '':
            raise CompileError(f'{what} has type {shown(e.ty)}, but {shown(ty)} is expected', line)
        if is_numeric(e.ty) and e.ty != member:
            raise CompileError(f'{what} has type {shown(e.ty)}, but {shown(ty)} is expected', line)
        return self.box_as(e, member, ty)

    def box_as(self, e: Ex, member: str, ty: str) -> Ex:
        e = self.owned(e)
        b = self.tmp('box')
        self.emit(b + ' = call ptr @tomato_alloc(i64 32, i64 ' + str(self.mod.code_of('box:' + member)) + ')')
        p = self.tmp('payload')
        self.emit(f'{p} = getelementptr i8, ptr {b}, i64 16')
        self.emit(f'store {llvm_type(member)} {e.reg}, ptr {p}')
        k = self.tmp('kind')
        self.emit(f'{k} = getelementptr i8, ptr {b}, i64 24')
        self.emit(f'store i64 {box_kind(member)}, ptr {k}')
        return ex(b, ty)

    def box_dyn(self, e: Ex, ty: str, line: int, what: str) -> Ex:
        # a value stored where Iterable[T] or Sized is wanted (D50a). A set or dict that will be looped over is boxed as a
        # snapshot of its keys, which is what a for loop over it walks anyway.
        if not self.mod.dyn_accepts(e.ty, ty):
            raise CompileError(f'{what} has type {shown(e.ty)}, but {shown(ty)} is expected', line)
        if not (is_list(e.ty) or is_dict(e.ty) or is_set(e.ty)):
            return self.box_as(e, e.ty, ty)
        if dyn_iterable(ty) and not is_list(e.ty):
            keys = f'list[{elem_of(e.ty)}]'
            if is_dict(e.ty):
                keys = 'list[str]'
            snap = self.tmp('keys')
            self.emit(f'{snap} = call ptr @tomato_dict_keys(ptr {e.reg}, i64 {self.mod.code_of(keys)}, i64 {item_width(keys)})')
            self.release(e)
            e = ex(snap, keys)
        return self.box_as(e, dyn_seq(), ty)

    def unbox_value(self, box: Ex, member: str) -> Ex:
        # the value inside a union, as a new reference when it is a heap value
        p = self.tmp('payload')
        self.emit(f'{p} = getelementptr i8, ptr {box.reg}, i64 16')
        v = self.tmp('inner')
        self.emit(f'{v} = load {llvm_type(member)}, ptr {p}')
        e = ex(v, member)
        self.retain(e)
        return e

    def box_is(self, box: Ex, member: str) -> str:
        # an i1: is this union holding that member?
        tp = self.tmp('tp')
        self.emit(f'{tp} = getelementptr {{ i64, i64 }}, ptr {box.reg}, i32 0, i32 1')
        raw = self.tmp('rawcode')
        self.emit(f'{raw} = load i64, ptr {tp}')
        code = self.tmp('code')
        self.emit(f'{code} = and i64 {raw}, 4294967295')
        c = self.tmp('isbox')
        self.emit(c + ' = icmp eq i64 ' + code + ', ' + str(self.mod.code_of('box:' + member)))
        return c

    # ---- small instructions
    def truth(self, e: Ex, line: int) -> str:
        e = self.want(e, 'bool', line, 'a condition')
        r = self.tmp('cond')
        self.emit(f'{r} = icmp ne i64 {e.reg}, 0')
        return r

    def bool_of(self, i1: str) -> Ex:
        r = self.tmp('b')
        self.emit(f'{r} = zext i1 {i1} to i64')
        return ex(r, 'bool')

    def arith(self, op: str, a: str, b: str) -> str:
        r = self.tmp('t')
        self.emit(f'{r} = {op} i64 {a}, {b}')
        return r

    def icmp(self, cc: str, a: str, b: str) -> Ex:
        c = self.tmp('cmp')
        self.emit(f'{c} = icmp {cc} i64 {a}, {b}')
        return self.bool_of(c)

    def common_type(self, a: str, b: str, line: int) -> str:
        if contains(a, b):
            return a
        if contains(b, a):
            return b
        raise CompileError(f'these integer types have no common type: {shown(a)} and {shown(b)}\nconvert one of them explicitly first', line)

    # ---- unlimited-size integers (D05c): an int is a tagged word, and the runtime does the arithmetic
    def int_call(self, name: str, a: str, b: str) -> Ex:
        r = self.tmp('int')
        self.emit(f'{r} = call i64 @tomato_int_{name}(i64 {a}, i64 {b})')
        return exf(r, 'int')

    def consumable(self, e: Ex) -> bool:
        return e.ty == 'int' and e.fresh and not e.small and not small_text(e.reg)

    def consume_mask(self, x: Ex, y: Ex) -> int:
        # which operands an operation frees itself (those we own): bit 0 for x, bit 1 for y. Their Ex values are used up.
        m = 0
        if self.consumable(x):
            m += 1
        if self.consumable(y) and y.reg != x.reg:
            m += 2
        if m % 2 == 1:
            x.fresh = False
        if m >= 2:
            y.fresh = False
        return m

    def int_call_c(self, name: str, x: Ex, y: Ex) -> Ex:
        # like int_call, and the operation frees the operands that are ours when they turn out to be big numbers
        m = self.consume_mask(x, y)
        if m == 0:
            return self.int_call(name, x.reg, y.reg)
        r = self.tmp('int')
        self.emit(f'{r} = call i64 @tomato_int_{name}_c(i64 {x.reg}, i64 {y.reg}, i32 {m})')
        return exf(r, 'int')

    def tag_small(self, raw: str) -> Ex:
        # a machine number known to be small (a length, a loop counter, a position) as an int
        s = self.tmp('shl')
        self.emit(f'{s} = shl nsw i64 {raw}, 1')
        t = self.tmp('tag')
        self.emit(f'{t} = or i64 {s}, 1')
        return exs(t, 'int')

    def int_from_machine(self, raw: str, signed: bool) -> Ex:
        # any 64-bit machine number (or an unsigned one) as an int
        r = self.tmp('int')
        if signed:
            self.emit(f'{r} = call i64 @tomato_int_from_i64(i64 {raw})')
        else:
            self.emit(f'{r} = call i64 @tomato_int_from_u64(i64 {raw})')
        return exf(r, 'int')

    def int_raw(self, e: Ex) -> str:
        # the machine number for places that need one (an index, a range bound); stops when the int is too big. The int is used up.
        r = self.tmp('raw')
        if self.consumable(e):
            self.emit(f'{r} = call i64 @tomato_int_raw_c(i64 {e.reg}, i32 1)')
            e.fresh = False              # used up: a second release must not free it again
            return r
        self.emit(f'{r} = call i64 @tomato_int_raw(i64 {e.reg})')
        return r

    def pow2_shift(self, y: Ex) -> int:
        # a constant divisor that is a power of two (2, 4, 8, ...): the shift count, else -1
        if not small_text(y.reg):
            return -1
        v = (int(y.reg) - 1) // 2
        if v < 2:
            return -1
        k = 0
        while v > 1:
            if v % 2 != 0:
                return -1
            v = v // 2
            k += 1
        return k

    def nonzero_const(self, y: Ex) -> bool:
        # a constant divisor that is certainly not zero (no check is needed)
        return small_text(y.reg) and int(y.reg) != 1 and int(y.reg) != 0

    def int_pow2_call(self, name: str, x: Ex, k: int) -> Ex:
        # x // 2**k and x % 2**k on a small number are a shift and a mask; a big number takes the general path
        m = self.consume_mask(x, ex('0', 'int'))
        r = self.tmp('int')
        self.emit(f'{r} = call i64 @tomato_int_{name}_c(i64 {x.reg}, i32 {k}, i32 {m})')
        return exf(r, 'int')

    def int_zero_check(self, b: Ex, message: str, live: list[Ex] = []):
        sign = self.tmp('sign')
        self.emit(f'{sign} = call i32 @tomato_int_sign(i64 {b.reg})')
        zero = self.tmp('zero')
        self.emit(f'{zero} = icmp eq i32 {sign}, 0')
        self.fail_if(zero, message, live)

    def num_arith(self, op: str, a: Ex, b: Ex, line: int) -> Ex:
        # + - * with an overflow stop, in the type both operands fit
        t = self.common_type(a.ty, b.ty, line)
        x = self.resize(a, t)
        y = self.resize(b, t)
        if t == 'int':
            return self.int_call_c(op, x, y)
        llt = llvm_type(t)
        sg = 's' if is_signed(t) else 'u'
        intr = f'llvm.{sg}{op}.with.overflow.{llt}'
        self.mod.declare(f'declare {{{llt}, i1}} @{intr}({llt}, {llt})')
        pair = self.tmp('pair')
        self.emit(f'{pair} = call {{{llt}, i1}} @{intr}({llt} {x.reg}, {llt} {y.reg})')
        r = self.tmp('r')
        self.emit(f'{r} = extractvalue {{{llt}, i1}} {pair}, 0')
        ov = self.tmp('ov')
        self.emit(f'{ov} = extractvalue {{{llt}, i1}} {pair}, 1')
        self.fail_if(ov, 'integer overflow')
        return ex(r, t)

    def int_equal_const(self, op: str, x: Ex, k: Ex) -> Ex:
        # x == 3 and x != 0: a big number is never equal to a small constant (a big number is always outside the small range), so
        # comparing the words is enough: no tag test, no call. The word 0 (a slot nobody has written) is the number 0 too.
        c = self.tmp('cmp')
        cc = 'eq'
        if op == '!=':
            cc = 'ne'
        if k.reg == '1':
            if op == '==':
                self.emit(f'{c} = icmp ult i64 {x.reg}, 2')
            else:
                self.emit(f'{c} = icmp ugt i64 {x.reg}, 1')
        else:
            self.emit(f'{c} = icmp {cc} i64 {x.reg}, {k.reg}')
        if self.consumable(x):
            self.emit(f'call void @tomato_int_free(i64 {x.reg})')
            x.fresh = False
        return self.bool_of(c)

    def int_compare(self, op: str, x: Ex, y: Ex) -> Ex:
        if op == '==' or op == '!=':
            if small_text(y.reg) and y.reg[0].isdigit() and not small_text(x.reg):
                return self.int_equal_const(op, x, y)
            if small_text(x.reg) and x.reg[0].isdigit() and not small_text(y.reg):
                return self.int_equal_const(op, y, x)
        c = self.tmp('icmp')
        m = self.consume_mask(x, y)
        if m == 0:
            self.emit(f'{c} = call i32 @tomato_int_cmp(i64 {x.reg}, i64 {y.reg})')
        else:
            self.emit(f'{c} = call i32 @tomato_int_cmp_c(i64 {x.reg}, i64 {y.reg}, i32 {m})')
        cc = 'eq'
        if op == '!=':
            cc = 'ne'
        elif op == '<':
            cc = 'slt'
        elif op == '<=':
            cc = 'sle'
        elif op == '>':
            cc = 'sgt'
        elif op == '>=':
            cc = 'sge'
        r = self.tmp('cmp')
        self.emit(f'{r} = icmp {cc} i32 {c}, 0')
        return self.bool_of(r)

    def num_compare(self, op: str, a: Ex, b: Ex, line: int) -> Ex:
        t = self.common_type(a.ty, b.ty, line)
        x = self.resize(a, t)
        y = self.resize(b, t)
        if t == 'int':
            return self.int_compare(op, x, y)
        cc = 'eq'
        if op == '!=':
            cc = 'ne'
        elif op != '==':
            sg = 's' if is_signed(t) else 'u'
            if op == '<':
                cc = f'{sg}lt'
            elif op == '<=':
                cc = f'{sg}le'
            elif op == '>':
                cc = f'{sg}gt'
            else:
                cc = f'{sg}ge'
        c = self.tmp('cmp')
        self.emit(f'{c} = icmp {cc} {llvm_type(t)} {x.reg}, {y.reg}')
        return self.bool_of(c)

    def num_modulo(self, a: Ex, b: Ex, line: int) -> Ex:
        # Python-style: the result has the sign of the divisor (D05au); a zero divisor stops the program
        t = self.common_type(a.ty, b.ty, line)
        x = self.resize(a, t)
        y = self.resize(b, t)
        if t == 'int':
            k = self.pow2_shift(y)
            if k > 0:
                return self.int_pow2_call('modp2', x, k)
            if not self.nonzero_const(y):
                self.int_zero_check(y, 'modulo by zero', [x, y])
            return self.int_call_c('mod', x, y)
        llt = llvm_type(t)
        zero = self.tmp('zero')
        self.emit(f'{zero} = icmp eq {llt} {y.reg}, 0')
        self.fail_if(zero, 'modulo by zero')
        if not is_signed(t):
            r = self.tmp('urem')
            self.emit(f'{r} = urem {llt} {x.reg}, {y.reg}')
            return ex(r, t)
        r = self.tmp('srem')
        self.emit(f'{r} = srem {llt} {x.reg}, {y.reg}')
        mix = self.tmp('mix')
        self.emit(f'{mix} = xor {llt} {r}, {y.reg}')
        differ = self.tmp('differ')
        self.emit(f'{differ} = icmp slt {llt} {mix}, 0')
        nonzero = self.tmp('nonzero')
        self.emit(f'{nonzero} = icmp ne {llt} {r}, 0')
        fix = self.tmp('fix')
        self.emit(f'{fix} = and i1 {differ}, {nonzero}')
        amount = self.tmp('amount')
        self.emit(f'{amount} = select i1 {fix}, {llt} {y.reg}, {llt} 0')
        out = self.tmp('mod')
        self.emit(f'{out} = add {llt} {r}, {amount}')
        return ex(out, t)

    def num_floor_divide(self, a: Ex, b: Ex, line: int) -> Ex:
        # //: the quotient rounded toward minus infinity, like Python; a zero divisor stops the program
        t = self.common_type(a.ty, b.ty, line)
        x = self.resize(a, t)
        y = self.resize(b, t)
        if t == 'int':
            k = self.pow2_shift(y)
            if k > 0:
                return self.int_pow2_call('floordivp2', x, k)
            if not self.nonzero_const(y):
                self.int_zero_check(y, 'division by zero', [x, y])
            return self.int_call_c('floordiv', x, y)
        llt = llvm_type(t)
        zero = self.tmp('zero')
        self.emit(f'{zero} = icmp eq {llt} {y.reg}, 0')
        self.fail_if(zero, 'division by zero')
        if not is_signed(t):
            r = self.tmp('udiv')
            self.emit(f'{r} = udiv {llt} {x.reg}, {y.reg}')
            return ex(r, t)
        least = self.tmp('least')
        self.emit(f'{least} = shl {llt} 1, {bits_of(t) - 1}')
        is_least = self.tmp('isleast')
        self.emit(f'{is_least} = icmp eq {llt} {x.reg}, {least}')
        is_minus = self.tmp('isminus')
        self.emit(f'{is_minus} = icmp eq {llt} {y.reg}, -1')
        both = self.tmp('both')
        self.emit(f'{both} = and i1 {is_least}, {is_minus}')
        self.fail_if(both, 'integer overflow')
        q = self.tmp('sdiv')
        self.emit(f'{q} = sdiv {llt} {x.reg}, {y.reg}')
        r = self.tmp('srem')
        self.emit(f'{r} = srem {llt} {x.reg}, {y.reg}')
        mix = self.tmp('mix')
        self.emit(f'{mix} = xor {llt} {r}, {y.reg}')
        differ = self.tmp('differ')
        self.emit(f'{differ} = icmp slt {llt} {mix}, 0')
        nonzero = self.tmp('nonzero')
        self.emit(f'{nonzero} = icmp ne {llt} {r}, 0')
        fix = self.tmp('fix')
        self.emit(f'{fix} = and i1 {differ}, {nonzero}')
        amount = self.tmp('amount')
        self.emit(f'{amount} = select i1 {fix}, {llt} 1, {llt} 0')
        out = self.tmp('floor')
        self.emit(f'{out} = sub {llt} {q}, {amount}')
        return ex(out, t)

    def num_bitwise(self, op: str, a: Ex, b: Ex, line: int) -> Ex:
        # & | ^ on two's-complement integers of the common type
        t = self.common_type(a.ty, b.ty, line)
        x = self.resize(a, t)
        y = self.resize(b, t)
        if t == 'int':
            code = '0'
            if op == '|':
                code = '1'
            elif op == '^':
                code = '2'
            r = self.tmp('bit')
            self.emit(f'{r} = call i64 @tomato_int_bitop(i64 {x.reg}, i64 {y.reg}, i32 {code})')
            self.release(x)
            self.release(y)
            return exs(r, 'int')
        ins = 'and'
        if op == '|':
            ins = 'or'
        elif op == '^':
            ins = 'xor'
        r = self.tmp('bit')
        self.emit(f'{r} = {ins} {llvm_type(t)} {x.reg}, {y.reg}')
        return ex(r, t)

    def num_shift(self, op: str, a: Ex, b: Ex, line: int) -> Ex:
        # << and >> on whole numbers: the result has the type of the left operand; the count is any whole number that is not
        # negative. A fixed-width result is range-checked like the other arithmetic.
        x = self.resize(a, 'int')
        y = self.resize(b, 'int')
        name = 'shl' if op == '<<' else 'shr'
        r = self.int_call_c(name, x, y)
        if a.ty != 'int':
            return self.convert_explicit(r, a.ty, line)
        return r

    def num_power(self, a: Ex, b: Ex, line: int) -> Ex:
        # ** on integers: whole-number powers that stop on overflow or a negative exponent; the result type is the
        # common type, converted back with a range check when it is a fixed width
        t = self.common_type(a.ty, b.ty, line) if a.ty != 'int' and b.ty != 'int' else 'int'
        x = self.resize(a, 'int')
        y = self.resize(b, 'int')
        sign = self.tmp('expsign')
        self.emit(f'{sign} = call i32 @tomato_int_sign(i64 {y.reg})')
        negative = self.tmp('negexp')
        self.emit(f'{negative} = icmp slt i32 {sign}, 0')
        self.fail_if(negative, 'a negative exponent needs a float', [x, y])
        r = self.tmp('pow')
        self.emit(f'{r} = call i64 @tomato_int_pow(i64 {x.reg}, i64 {y.reg})')
        self.release(x)
        self.release(y)
        if t != 'int':
            return self.convert_explicit(exf(r, 'int'), t, line)
        return exf(r, 'int')

    def as_double(self, e: Ex) -> str:
        if e.ty == 'float':
            return e.reg
        return self.to_double(e)

    def float_op(self, op: str, a: Ex, b: Ex, line: int) -> Ex:
        # arithmetic and comparison when either side is a float: the other side is converted to a float
        if not (a.ty == 'float' or is_numeric(a.ty)) or not (b.ty == 'float' or is_numeric(b.ty)):
            raise CompileError(f"cannot use '{op}' with {shown(a.ty)} and {shown(b.ty)}", line)
        x = self.as_double(a)
        y = self.as_double(b)
        if op == '+' or op == '-' or op == '*':
            ins = 'fadd'
            if op == '-':
                ins = 'fsub'
            elif op == '*':
                ins = 'fmul'
            r = self.tmp('f')
            self.emit(f'{r} = {ins} double {x}, {y}')
            self.check_finite(r)
            return ex(r, 'float')
        if op == '/' or op == '//' or op == '%':
            zero = self.tmp('fzero')
            self.emit(f'{zero} = fcmp oeq double {y}, 0.0')
            if op == '%':
                self.fail_if(zero, 'modulo by zero')
            else:
                self.fail_if(zero, 'division by zero')
            r = self.tmp('f')
            if op == '/':
                self.emit(f'{r} = fdiv double {x}, {y}')
            elif op == '//':
                self.emit(f'{r} = call double @tomato_floor_div_f64(double {x}, double {y})')
            else:
                self.emit(f'{r} = call double @tomato_mod_f64(double {x}, double {y})')
            self.check_finite(r)
            return ex(r, 'float')
        if op == '**':
            r = self.tmp('f')
            self.emit(f'{r} = call double @tomato_pow_f64(double {x}, double {y})')
            self.check_finite(r)
            return ex(r, 'float')
        cc = ''
        if op == '==':
            cc = 'oeq'
        elif op == '!=':
            cc = 'une'
        elif op == '<':
            cc = 'olt'
        elif op == '<=':
            cc = 'ole'
        elif op == '>':
            cc = 'ogt'
        elif op == '>=':
            cc = 'oge'
        else:
            raise CompileError(f"'{op}' does not work on floats\nuse it on integers, or use / // or ** on floats", line)
        c = self.tmp('fcmp')
        self.emit(f'{c} = fcmp {cc} double {x}, {y}')
        return self.bool_of(c)

    def check_finite(self, r: str):
        # a float result that is infinite or not a number stops the program (P58)
        d = self.tmp('diff')
        self.emit(f'{d} = fsub double {r}, {r}')
        ok = self.tmp('finite')
        self.emit(f'{ok} = fcmp oeq double {d}, 0.0')
        bad = self.tmp('notfinite')
        self.emit(f'{bad} = xor i1 {ok}, true')
        self.fail_if(bad, 'the float result is infinite or not a number')

    def float_call(self, v: Ex, line: int) -> Ex:
        # float(x): a whole number or a float as a float, or text written as a number
        if v.ty == 'str':
            return self.text_to_float(v)
        if v.ty == 'float':
            return v
        if is_numeric(v.ty):
            return ex(self.to_double(v), 'float')
        raise CompileError(f'float() takes a number, but this is {shown(v.ty)}', line)

    def text_to_int(self, v: Ex) -> Ex:
        # int(text): a whole number written in decimal, spaces around it allowed; anything else raises a RuntimeError
        ok = self.tmp('isint')
        self.emit(f'{ok} = call i32 @tomato_text_int_ok(ptr {v.reg})')
        bad = self.tmp('notint')
        self.emit(f'{bad} = icmp eq i32 {ok}, 0')
        r = self.tmp('parsed')
        self.emit(f'{r} = call i64 @tomato_text_int(ptr {v.reg})')
        self.release(v)
        self.fail_if(bad, 'the text is not a whole number')
        return exf(r, 'int')

    def text_to_float(self, v: Ex) -> Ex:
        ok = self.tmp('isfloat')
        self.emit(f'{ok} = call i32 @tomato_text_float_ok(ptr {v.reg})')
        bad = self.tmp('notfloat')
        self.emit(f'{bad} = icmp eq i32 {ok}, 0')
        r = self.tmp('parsed')
        self.emit(f'{r} = call double @tomato_text_float(ptr {v.reg})')
        self.release(v)
        self.fail_if(bad, 'the text is not a number')
        return ex(r, 'float')

    def float_to_int(self, v: Ex, line: int) -> Ex:
        # int(x) on a float: the whole part, towards zero (P58); infinity and NaN stop
        d = self.tmp('diff')
        self.emit(f'{d} = fsub double {v.reg}, {v.reg}')
        ok = self.tmp('finite')
        self.emit(f'{ok} = fcmp oeq double {d}, 0.0')
        bad = self.tmp('notfinite')
        self.emit(f'{bad} = xor i1 {ok}, true')
        self.fail_if(bad, 'a float that is infinite or not a number cannot become an int')
        r = self.tmp('whole')
        self.emit(f'{r} = call i64 @tomato_f64_to_int(double {v.reg})')
        return exf(r, 'int')

    def float_literal(self, mantissa: int, scale: int) -> Ex:
        # the digits as a decimal constant, which LLVM rounds to the nearest float
        text = f'{mantissa}.0e'
        if scale > 0:
            text += f'-{scale}'
        else:
            text += f'+{-scale}'
        return ex(text, 'float')

    def to_double(self, e: Ex) -> str:
        if e.ty == 'int':
            d = self.tmp('fp')
            self.emit(f'{d} = call double @tomato_int_to_f64(i64 {e.reg})')
            self.release(e)
            return d
        r = self.tmp('fp')
        op = 'sitofp' if is_signed(e.ty) else 'uitofp'
        self.emit(f'{r} = {op} {llvm_type(e.ty)} {e.reg} to double')
        return r

    def num_divide(self, a: Ex, b: Ex, line: int) -> Ex:
        if b.ty == 'int':
            self.int_zero_check(b, 'division by zero', [a, b])
        else:
            zero = self.tmp('zero')
            self.emit(f'{zero} = icmp eq {llvm_type(b.ty)} {b.reg}, 0')
            self.fail_if(zero, 'division by zero', [a, b])
        q = self.tmp('div')
        self.emit(f'{q} = fdiv double {self.to_double(a)}, {self.to_double(b)}')
        self.check_finite(q)
        return ex(q, 'float')

    def convert_explicit(self, v: Ex, target: str, line: int) -> Ex:
        # int[length=N](x): the same number in another integer type, or a stop when it does not fit (D05p)
        if v.ty == 'str' and target == 'int':
            return self.text_to_int(v)
        if not is_numeric(v.ty):
            raise CompileError(f'this conversion needs an integer, but the value is {shown(v.ty)}', line)
        if target == 'int' or contains(target, v.ty):
            return self.resize(v, target)
        if v.ty == 'int':
            ok = self.tmp('inrange')
            sg = '1' if is_signed(target) else '0'
            self.emit(f'{ok} = call i32 @tomato_int_in_range(i64 {v.reg}, i32 {bits_of(target)}, i32 {sg})')
            bad = self.tmp('bad')
            self.emit(f'{bad} = icmp eq i32 {ok}, 0')
            self.fail_if(bad, 'the number does not fit the integer type', [v])
            low = self.tmp('low')
            self.emit(f'{low} = call i64 @tomato_int_low64(i64 {v.reg})')
            self.release(v)
            if bits_of(target) == 64:
                return ex(low, target)
            cut = self.tmp('cut')
            self.emit(f'{cut} = trunc i64 {low} to {llvm_type(target)}')
            return ex(cut, target)
        width = bits_of(v.ty)
        if bits_of(target) > width:
            width = bits_of(target)
        width += 1
        wide = ex(self.widen(v, width), 'int')
        cut = self.tmp('cut')
        self.emit(f'{cut} = trunc i{width} {wide.reg} to {llvm_type(target)}')
        back = self.tmp('back')
        op = 'sext' if is_signed(target) else 'zext'
        self.emit(f'{back} = {op} {llvm_type(target)} {cut} to i{width}')
        bad = self.tmp('bad')
        self.emit(f'{bad} = icmp ne i{width} {wide.reg}, {back}')
        self.fail_if(bad, 'the number does not fit the integer type')
        return ex(cut, target)

    def widen(self, v: Ex, width: int) -> str:
        if bits_of(v.ty) == width:
            return v.reg
        r = self.tmp('wide')
        op = 'sext' if is_signed(v.ty) else 'zext'
        self.emit(f'{r} = {op} {llvm_type(v.ty)} {v.reg} to i{width}')
        return r

    def modulo(self, a: str, b: str) -> str:
        # Python-style: the result has the sign of the divisor (D05au); a zero divisor is not checked yet (P53)
        r = self.arith('srem', a, b)
        x = self.arith('xor', r, b)
        differ = self.icmp('slt', x, '0')
        nonzero = self.icmp('ne', r, '0')
        fix = self.arith('and', differ.reg, nonzero.reg)
        amount = self.arith('mul', fix, b)
        return self.arith('add', r, amount)

    def trace(self, first: bool):
        # debug mode: add this function and the current line to the call trace of the error leaving it (the first frame starts a new trace)
        if self.mod.mode != 1 or self.fname == '':
            return
        if first:
            self.emit('call void @tomato_trace_clear()')
        self.emit('call void @tomato_trace(ptr ' + self.mod.intern(self.fname) + f'.c, i32 {self.line})')

    def hold(self, e: Ex):
        # e is an owned temporary that stays alive while another operand is evaluated: if that raises, the error path frees it
        self.held.append(e)

    def drop_held(self, n: int):
        self.held = self.held[:n]

    def release_held(self):
        # on an error path: free every temporary still waiting in an enclosing expression (newest first)
        k = len(self.held)
        while k > 0:
            k -= 1
            self.release(self.held[k])

    def fail_if(self, bad: str, message: str, live: list[Ex] = []):
        # bad is an i1; when true, a RuntimeError is raised, which a catch can handle (D22a). live are the owned operands of the
        # failing operation itself, which the error path frees together with the temporaries held by the enclosing expressions.
        self.fail_with(bad, 'RuntimeError', message, live)

    def fail_with(self, bad: str, cls: str, message: str, live: list[Ex] = []):
        stop = self.label('stop')
        ok = self.label('ok')
        self.cond_br(bad, stop, ok)
        self.place(stop)
        for v in live:
            self.release(v)
        self.release_held()
        err = self.tmp('err')
        self.emit(err + ' = call ptr @tomato.new.' + str(self.mod.code_of('@' + cls)) + '(ptr ' + self.mod.intern(self.mod.failure_text(message, self.line)) + ')')
        self.emit(f'store ptr {err}, ptr @tomato_exc')
        self.emit(f'store i32 {self.line}, ptr @tomato_exc_line')
        self.emit('store i32 1, ptr @tomato_exc_rt')
        self.trace(True)
        self.emit('store i32 1, ptr @tomato_exc_seen')
        self.br(self.unwind_target())
        self.place(ok)

    # ---- expressions
    def expr(self, n: Node, expected: str = '') -> Ex:
        k = n.kind
        if k == 'Await':
            return self.await_expr(n)
        if k == 'Start':
            return self.start_expr(n)
        if k == 'IntLit':
            return self.int_literal(n.fields[0].num, expected, False, n.line)
        if k == 'FloatLit':
            return self.float_literal(n.fields[0].num, n.fields[1].num)
        if k == 'BoolLit':
            if n.fields[0].flag:
                return ex('1', 'bool')
            return ex('0', 'bool')
        if k == 'StrLit':
            return ex(self.mod.intern(n.fields[0].text), 'str')
        if k == 'Name':
            name = n.fields[0].text
            if name == 'None' and name not in self.slots:
                return ex('null', 'None')
            if name not in self.slots:
                ck = self.mod.resolve(name)
                if ck in self.mod.consts:
                    return self.expr(self.mod.consts[ck], expected)
                if ck != '' and self.mod.has_func(ck):
                    return self.func_value(name, ck, n.line)
                raise CompileError(f"name '{name}' is not defined{self.name_hint(name)}", n.line)
            ty = self.types[name]
            r = self.tmp('l')
            self.emit(f'{r} = load {llvm_type(ty)}, ptr {self.slots[name]}')
            e = ex(r, ty)
            if ty != 'int':
                self.retain(e)         # an int is lent: whoever keeps it copies it (see owned)
            elif self.take_name == name:
                e.fresh = True         # `x = x + 1`: the operation frees this number itself if it is big, so the store need not
                self.taken = e
                self.take_name = ''
            return e
        if k == 'UnOp':
            op = n.fields[0].text
            if op == '-' and val_node(n.fields[1]).kind == 'IntLit':
                return self.int_literal(val_node(n.fields[1]).fields[0].num, expected, True, n.line)
            if op == '~':
                return self.invert_op(n)
            v = self.expr(val_node(n.fields[1]), expected)
            if op == '-' and v.ty == 'float':
                negated = self.tmp('fneg')
                self.emit(f'{negated} = fneg double {v.reg}')
                return ex(negated, 'float')
            if op == '-':
                if not is_numeric(v.ty):
                    raise CompileError(f"cannot use '-' on {shown(v.ty)}\nonly numbers can be negated", n.line)
                if not is_signed(v.ty):
                    raise CompileError("cannot use '-' on an unsigned number\nconvert it to a signed int first", n.line)
                return self.num_arith('sub', ex('0', v.ty), v, n.line)
            v = self.want(v, 'bool', n.line, 'the operand of not')
            return ex(self.arith('xor', v.reg, '1'), 'bool')
        if k == 'BinOp':
            return self.binop(n, expected)
        if k == 'TypeCall':
            return self.type_call(n)
        if k == 'Call':
            return self.call(n, False)
        if k == 'ListLit' or k == 'TupleLit':
            return self.list_lit(n, expected)
        if k == 'MapLit':
            return self.map_lit(n, expected)
        if k == 'SetLit':
            return self.set_lit(n, expected)
        if k == 'Attr':
            return self.field_get(n)
        if k == 'Index':
            return self.index(n)
        if k == 'Slice':
            return self.slice(n)
        if k == 'Cond':
            return self.conditional(n, expected)
        if k == 'ListComp':
            return self.list_comp(n)
        if k == 'Lambda':
            return self.lambda_value(n, expected)
        raise CompileError(f'this kind of expression ({k}) is not supported', n.line)

    def conditional(self, n: Node, expected: str) -> Ex:
        # a if condition else b: only the chosen side runs. Both sides have one type; None with a class, text or list gives an
        # optional of it. The value goes through a slot, so the sides need no phi.
        c = self.truth(self.expr(val_node(n.fields[0])), n.line)
        yes = self.label('then')
        no = self.label('else')
        end = self.label('endcond')
        self.cond_br(c, yes, no)
        self.place(yes)
        a = self.expr(val_node(n.fields[1]), expected)
        wide = is_union(expected) or is_optional(expected)
        if wide:
            a = self.want(a, expected, n.line, 'the value of a conditional expression')
        ty = a.ty
        if wide:
            ty = expected
        res = self.hidden_slot('cond')
        if is_rc(a.ty):
            res = self.hidden_rc_slot('cond')
        elif a.ty == 'int':
            res = self.hidden_int_slot('cond')
        self.store_owned(res, a)
        self.br(end)
        self.place(no)
        hint = ty
        if ty == 'None':
            hint = expected
        b = self.expr(val_node(n.fields[2]), hint)
        if b.ty != ty:
            if ty == 'None' and (b.ty == 'str' or is_list(b.ty) or is_class(b.ty)):
                ty = f'{b.ty}?'
            elif b.ty == 'None' and (ty == 'str' or is_list(ty) or is_class(ty)):
                ty = f'{ty}?'
            elif self.mod.assignable(b.ty, ty) or is_union(ty) or (is_numeric(b.ty) and is_numeric(ty) and contains(ty, b.ty)):
                b = self.want(b, ty, n.line, 'the else value of a conditional expression')
            elif is_class(a.ty) and is_class(b.ty) and self.mod.assignable(a.ty, b.ty):
                ty = b.ty
            else:
                raise CompileError(f'the two values of this conditional expression have different types: {shown(a.ty)} and {shown(b.ty)}\nconvert one so that both have the same type', n.line)
        self.store_owned(res, b)
        self.br(end)
        self.place(end)
        r = self.tmp('cond')
        self.emit(f'{r} = load {llvm_type(ty)}, ptr {res}')
        v = ex(r, ty)
        self.retain(v)
        return v

    def list_comp(self, n: Node) -> Ex:
        # [item for x in items if cond]: the list is built by an ordinary for loop whose body is a CompAppend statement. The
        # list's type is the type of the first item compiled, so the line that creates the list is filled in afterwards.
        holder = self.hidden_rc_slot('comp')
        ctx = CompCtx()
        ctx.holder = holder
        self.emit('; the new list goes here')
        at = len(self.lines) - 1
        self.comps.append(ctx)
        self.for_stmt(val_node(n.fields[0]))
        self.comps = self.comps[:-1]
        if ctx.ty == '':
            raise CompileError('the items of this list comprehension have no type', n.line)
        old = self.tmp('old')
        fresh = self.tmp('list')
        self.lines[at] = f'  {fresh} = call ptr @tomato_list_new(i64 {self.mod.code_of(ctx.ty)})\n  {old} = load ptr, ptr {holder}\n  store ptr {fresh}, ptr {holder}\n  call void @tomato_release(ptr {old})'
        lst = self.tmp('comp')
        self.emit(f'{lst} = load ptr, ptr {holder}')
        v = ex(lst, ctx.ty)
        self.retain(v)
        return v

    def comp_append(self, s: Node):
        ctx = self.comps[len(self.comps) - 1]
        item = val_node(s.fields[0])
        if ctx.ty == '':
            v = self.expr(item)
            if v.ty == '' or v.ty == 'None':
                raise CompileError('the type of the items of this list comprehension cannot be guessed\nmake the item a value with a type', s.line)
            ctx.ty = f'list[{v.ty}]'
        else:
            v = self.want(self.expr(item, elem_of(ctx.ty)), elem_of(ctx.ty), s.line, 'a list item')
        lst = self.tmp('lst')
        self.emit(f'{lst} = load ptr, ptr {ctx.holder}')
        v = self.owned(v)
        self.push_item(lst, ctx.ty, v)     # the list takes the reference

    def sequence_op(self, op: str, a: Ex, b: Ex, line: int) -> Ex:
        # list + list, tuple + tuple, list * n, n * list, text * n and n * text; an empty type when the operands are something else
        if op == '+' and is_list(a.ty) and a.ty == b.ty:
            rc = list_flags(a.ty)
            r = self.tmp('joined')
            self.emit(f'{r} = call ptr @tomato_list_concat(ptr {a.reg}, ptr {b.reg}, i32 {rc})')
            self.release(a)
            self.release(b)
            return ex(r, a.ty)
        if op == '*' and (is_list(a.ty) or a.ty == 'str') and is_numeric(b.ty):
            return self.repeat_value(a, b, line)
        if op == '*' and (is_list(b.ty) or b.ty == 'str') and is_numeric(a.ty):
            return self.repeat_value(b, a, line)
        return ex('', '')

    def repeat_value(self, seq: Ex, count: Ex, line: int) -> Ex:
        n = self.want(count, 'int', line, 'the repeat count')
        r = self.tmp('repeated')
        if seq.ty == 'str':
            self.emit(f'{r} = call ptr @tomato_str_repeat(ptr {seq.reg}, i64 {self.int_raw(n)})')
        else:
            rc = list_flags(seq.ty)
            self.emit(f'{r} = call ptr @tomato_list_repeat(ptr {seq.reg}, i64 {self.int_raw(n)}, i32 {rc})')
        self.release(seq)
        return ex(r, seq.ty)

    def call_helper(self, info: FuncInfo, values: list[Ex]) -> Ex:
        # call a helper function the compiler wrote; it only borrows its arguments
        parts: list[str] = [f'{llvm_type(v.ty)} {v.reg}' for v in values]
        r = self.tmp('help')
        self.emit(r + ' = call ' + self.ret_llvm(info) + ' ' + function_symbol(self.mod, info) + '(' + ', '.join(parts) + ')')
        self.check_error(values)
        for v2 in values:
            self.release(v2)
        return ret_ex(r, info.ret)

    def marker_call(self, a: Ex, info: FuncInfo, args: list[Ex], line: int) -> Ex:
        # run the method that a protocol marker (@len, @get, @slice, @contains, @reversed) names on the object a; a and the arguments are released
        parts: list[str] = ['ptr ' + a.reg]
        for b in args:
            parts.append(f'{llvm_type(b.ty)} {b.reg}')
        text = 'call ' + self.ret_llvm(info) + ' ' + self.dispatch(a, info.name) + '(' + ', '.join(parts) + ')'
        result = ex('', '')
        if info.ret == '':
            self.emit(text)
        else:
            r = self.tmp('mark')
            self.emit(f'{r} = {text}')
            result = ret_ex(r, info.ret)
        values: list[Ex] = [a]
        for b2 in args:
            values.append(b2)
        self.check_error(values)
        for v in values:
            self.release(v)
        return result

    def object_slice(self, s: Ex, n: Node) -> Ex:
        # obj[a:b:c] on an object whose class has a method marked @slice(start, stop, step, flags): the flags say which of the three
        # were written (1 start, 2 stop, 4 step), the numbers that were not written are 0
        f = self.mod.find_op(s.ty[1:], 'slice')
        if f is None or len(f.ptypes) != 4 or f.ret == '':
            raise CompileError("'" + s.ty[1:] + "' objects cannot be sliced\nadd a method marked @slice that takes start, stop, step and flags (four ints)", n.line)
        flags = 0
        lo = ex('1', 'int')
        hi = ex('1', 'int')
        step = ex('1', 'int')
        if n.fields[1].tag == 'n':
            lo = self.want(self.expr(val_node(n.fields[1])), 'int', n.line, 'a slice start')
            flags += 1
        if n.fields[2].tag == 'n':
            hi = self.want(self.expr(val_node(n.fields[2])), 'int', n.line, 'a slice end')
            flags += 2
        if len(n.fields) > 3 and n.fields[3].tag == 'n':
            step = self.want(self.expr(val_node(n.fields[3])), 'int', n.line, 'a slice step')
            flags += 4
        return self.marker_call(s, f, [lo, hi, step, self.tag_small(str(flags))], n.line)

    def list_call(self, args: list[Node], line: int) -> Ex:
        # list(x): a new list of the items of a list, or of anything with a method marked @iter (a range, a progress bar, your own class)
        if len(args) != 1:
            raise CompileError('list() takes exactly one argument: a list or a range', line)
        v = self.unwrap(self.expr(args[0]), line)
        if is_class(v.ty) and self.mod.has_op(v.ty[1:], 'iter'):
            return self.call_helper(self.mod.helper('tolist', v.ty, line), [v])
        if is_list(v.ty) and not v.ty.startswith('tuple['):
            rc = list_flags(v.ty)
            r = self.tmp('copy')
            self.emit(f'{r} = call ptr @tomato_list_slice(ptr {v.reg}, i64 0, i64 0, i64 1, i32 0, i32 {rc})')
            self.release(v)
            return ex(r, v.ty)
        raise CompileError(f'list() takes a list or something that can be looped over (a range, or an object with an @iter method), but this is {shown(v.ty)}', line)

    def list_builtin(self, name: str, args: list[Node], line: int) -> Ex:
        # sorted, reversed, sum, min and max of a list
        lst = ex('', '')
        if (name == 'min' or name == 'max') and len(args) >= 2:
            items: list[Ex] = []
            first = self.expr(args[0])
            items.append(first)
            for a in args[1:]:
                items.append(self.want(self.expr(a), first.ty, line, 'every value given to ' + name + '()'))
            lst = self.build_tuple(f'list[{first.ty}]', items)
        else:
            if len(args) != 1:
                raise CompileError(f'{name}() takes one list', line)
            lst = self.unwrap(self.expr(args[0]), line)
        if is_class(lst.ty):
            if name == 'reversed':
                rf = self.mod.find_op(lst.ty[1:], 'reversed')
                if rf is not None:
                    return self.marker_call(lst, rf, [], line)
            if not self.mod.has_op(lst.ty[1:], 'iter'):
                raise CompileError(f'{name}() takes a list or an object with a method marked @iter, but this is {shown(lst.ty)}', line)
            if name == 'sorted' or name == 'reversed':
                lst = self.call_helper(self.mod.helper('tolist', lst.ty, line), [lst])
            else:
                return self.call_helper(self.mod.helper(name, lst.ty, line), [lst])
        if not is_list(lst.ty):
            raise CompileError(f'{name}() takes a list or a range, but this is {shown(lst.ty)}', line)
        elem = elem_of(lst.ty)
        if name == 'reversed':
            rc = list_flags(lst.ty)
            r = self.tmp('reversed')
            self.emit(f'{r} = call ptr @tomato_list_slice(ptr {lst.reg}, i64 0, i64 0, i64 -1, i32 4, i32 {rc})')
            self.release(lst)
            return ex(r, lst.ty)
        if not (elem == 'int' or elem == 'float' or (elem == 'str' and name != 'sum')):
            wanted = 'numbers or text' if name != 'sum' else 'numbers'
            raise CompileError(f'{name}() needs a list of {wanted}, but this is {shown(lst.ty)}', line)
        if name == 'sorted':
            # the runtime sorts a copy: 0 = int, 1 = float, 2 = str
            kind = '0' if elem == 'int' else ('1' if elem == 'float' else '2')
            r = self.tmp('sorted')
            self.emit(f'{r} = call ptr @tomato_list_sorted(ptr {lst.reg}, i32 {kind})')
            self.release(lst)
            return ex(r, lst.ty)
        info = self.mod.helper(name, lst.ty, line)
        return self.call_helper(info, [lst])

    # the list a function like sorted, map and filter works on: a list, or an object with a method marked @iter (copied into a list)
    def list_arg(self, a: Node, name: str, line: int) -> Ex:
        lst = self.unwrap(self.expr(a), line)
        if is_class(lst.ty) and self.mod.has_op(lst.ty[1:], 'iter'):
            lst = self.call_helper(self.mod.helper('tolist', lst.ty, line), [lst])
        if not is_list(lst.ty):
            raise CompileError(f'{name}() takes a list or a range, but this is {shown(lst.ty)}', line)
        return lst

    # sorted(xs, key=f) and sorted(xs, cmp=f): a new list, stable (D-fn); the work is done by _sorted_key and _sorted_cmp in std/builtin.tom
    def sorted_by(self, args: list[Node], keywords: list[Val], line: int) -> Ex:
        if len(args) != 1:
            raise CompileError('sorted() takes one list, and then key= or cmp=', line)
        if len(keywords) != 1:
            raise CompileError('sorted() takes key= or cmp=, not both', line)
        kname = keywords[0].items[0].text
        if kname != 'key' and kname != 'cmp':
            raise CompileError(f"sorted() has no parameter named '{kname}'\nit takes key= (a function giving what to sort by) or cmp= (a function comparing two items)", line)
        lst = self.list_arg(args[0], 'sorted', line)
        return self.sorted_keyed(lst, keywords, line)

    # the same on a list that is already evaluated (it is used up): the keyword is key= or cmp=
    def sorted_keyed(self, lst: Ex, keywords: list[Val], line: int) -> Ex:
        kname = keywords[0].items[0].text
        elem = elem_of(lst.ty)
        want_fn = 'fn[' + elem + '>?]'
        if kname == 'cmp':
            want_fn = 'fn[' + elem + ',' + elem + '>int]'
        fv = self.expr(val_node(keywords[0].items[1]), want_fn)
        if not is_fn(fv.ty):
            raise CompileError(f'{kname}= needs a function, but this is {shown(fv.ty)}', line)
        if kname == 'cmp':
            want_ty = 'fn[' + elem + ',' + elem + '>int]'
            if fv.ty != want_ty:
                raise CompileError(f'cmp= needs a function of two {shown(elem)} items that returns an int, but this is {shown(fv.ty)}\nit returns a negative number, zero or a positive number', line)
            info = self.mod.instance_func(self.mod.resolve('_sorted_cmp'), [elem], line)
            et = llvm_type(elem)
            if item_width(lst.ty) != 8 or (et != 'i64' and et != 'ptr'):
                return self.call_helper(info, [lst, fv])
            # native builds: the runtime merge sort calls the function directly; where it cannot (the browser's interpreter), the sort
            # written in Tomato (_sorted_cmp) runs instead. Both are the same stable merge sort.
            res = self.hidden_slot('cmpsorted')
            can = self.tmp('callbacks')
            self.emit(f'{can} = call i32 @tomato_callbacks()')
            use = self.tmp('native')
            self.emit(f'{use} = icmp ne i32 {can}, 0')
            nat = self.label('natsort')
            slow = self.label('tomsort')
            done = self.label('sortdone')
            self.cond_br(use, nat, slow)
            self.place(nat)
            rn = self.tmp('natsorted')
            self.emit(f'{rn} = call ptr @tomato_list_sorted_cmp(ptr {lst.reg}, ptr {fv.reg}, ptr @tomato_exc, i32 {list_flags(lst.ty)})')
            self.check_error([lst])
            self.release(lst)
            self.emit(f'store ptr {rn}, ptr {res}')
            self.br(done)
            self.place(slow)
            rs = self.call_helper(info, [lst, fv])
            self.emit(f'store ptr {rs.reg}, ptr {res}')
            self.br(done)
            self.place(done)
            r2 = self.tmp('sorted')
            self.emit(f'{r2} = load ptr, ptr {res}')
            return ex(r2, lst.ty)
        params = fn_params(fv.ty)
        if len(params) != 1 or params[0] != elem:
            raise CompileError(f'key= needs a function of one {shown(elem)} item, but this is {shown(fv.ty)}', line)
        kt = fn_result(fv.ty)
        if kt != 'int' and kt != 'float' and kt != 'str':
            raise CompileError(f'the key function must return an int, a float or text, but this one returns {shown(kt)}', line)
        # the keys are worked out here, once per item; the runtime sorts them (stable) and builds the result
        info = self.mod.instance_func(self.mod.resolve('_keys'), [elem, kt], line)
        keys = self.tmp('keys')
        self.emit(f'{keys} = call ptr {function_symbol(self.mod, info)}(ptr {lst.reg}, ptr {fv.reg})')
        self.check_error([lst])
        kind = '0' if kt == 'int' else ('1' if kt == 'float' else '2')
        r = self.tmp('sortedby')
        self.emit(f'{r} = call ptr @tomato_list_sorted_by(ptr {lst.reg}, ptr {keys}, i32 {kind}, i32 {list_flags(lst.ty)})')
        self.release(ex(keys, f'list[{kt}]'))
        self.release(lst)
        return ex(r, lst.ty)

    # map(f, xs) and filter(f, xs): a new list (D-fn)
    def map_filter(self, name: str, args: list[Node], keywords: list[Val], line: int) -> Ex:
        if len(keywords) > 0 or len(args) != 2:
            raise CompileError(f'{name}() takes a function and a list: {name}(f, xs)', line)
        lst = self.list_arg(args[1], name, line)
        elem = elem_of(lst.ty)
        want_fn = 'fn[' + elem + '>?]'
        if name == 'filter':
            want_fn = 'fn[' + elem + '>bool]'
        fv = self.expr(args[0], want_fn)
        if not is_fn(fv.ty):
            raise CompileError(f'the first argument of {name}() must be a function, but this is {shown(fv.ty)}', line)
        params = fn_params(fv.ty)
        if len(params) != 1 or params[0] != elem:
            raise CompileError(f'{name}() needs a function of one {shown(elem)} item, but this is {shown(fv.ty)}', line)
        res = fn_result(fv.ty)
        if name == 'filter':
            if res != 'bool':
                raise CompileError(f'the function given to filter() must return a bool, but this one returns {shown(res)}', line)
            return self.call_helper(self.mod.instance_func(self.mod.resolve('_filter'), [elem], line), [fv, lst])
        if res == 'None' or is_fixed(res):
            raise CompileError(f'the function given to map() must return a value, but this one returns {shown(res)}', line)
        return self.call_helper(self.mod.instance_func(self.mod.resolve('_map'), [elem, res], line), [fv, lst])

    def list_slot(self, lst: Ex, i: Ex, live: list[Ex] = []) -> str:
        # the address of item i, after a bounds check
        lenp = self.tmp('lenp')
        self.emit(f'{lenp} = getelementptr {{ i64, i64, i64, i64, ptr }}, ptr {lst.reg}, i32 0, i32 2')
        ln = self.tmp('len')
        self.emit(f'{ln} = load i64, ptr {lenp}')
        bad = self.tmp('oob')
        self.emit(f'{bad} = icmp uge i64 {i.reg}, {ln}')
        self.fail_if(bad, 'index out of range', live)
        datap = self.tmp('datap')
        self.emit(f'{datap} = getelementptr {{ i64, i64, i64, i64, ptr }}, ptr {lst.reg}, i32 0, i32 4')
        data = self.tmp('data')
        self.emit(f'{data} = load ptr, ptr {datap}')
        addr = self.tmp('addr')
        w = item_width(lst.ty)
        unit = item_llvm(w)
        self.emit(f'{addr} = getelementptr {unit}, ptr {data}, i64 {i.reg}')
        return addr

    def load_item(self, lt: str, addr: str, hint: str) -> str:
        # the item at addr in a list of type lt, as the register of its Tomato value (a compact item is widened)
        elem = elem_of(lt)
        item = self.tmp(hint)
        w = item_width(lt)
        if w == 8:
            self.emit(f'{item} = load {llvm_type(elem)}, ptr {addr}')
        elif elem == 'bool':
            raw = self.tmp('raw')
            self.emit(f'{raw} = load i8, ptr {addr}')
            self.emit(f'{item} = zext i8 {raw} to i64')
        else:
            self.emit(f'{item} = load {llvm_type(elem)}, ptr {addr}')
        return item

    def store_item(self, lt: str, v: Ex, addr: str):
        # v (not a heap value) into the slot at addr of a list of type lt
        if item_width(lt) == 1 and elem_of(lt) == 'bool':
            raw = self.tmp('raw')
            self.emit(f'{raw} = trunc i64 {v.reg} to i8')
            self.emit(f'store i8 {raw}, ptr {addr}')
        else:
            self.emit(f'store {llvm_type(v.ty)} {v.reg}, ptr {addr}')

    def push_item(self, lst: str, lt: str, v: Ex):
        # append v (already owned) to the list in register lst, whose type is lt
        slot = self.tmp('slot')
        self.emit(f'{slot} = call ptr @tomato_list_push(ptr {lst}, i64 {item_width(lt)})')
        self.store_item(lt, v, slot)

    def field_addr(self, obj: Ex, name: str, line: int) -> str:
        if not is_class(obj.ty):
            raise CompileError(f'a value of type {shown(obj.ty)} has no fields', line)
        c = self.mod.find_class(obj.ty[1:], line)
        idx = self.mod.field_index(c, name, line)
        addr = self.tmp('fld')
        self.emit(f'{addr} = getelementptr %class.{self.mod.code_of(obj.ty)}, ptr {obj.reg}, i32 0, i32 {str(idx + 2)}')
        return addr

    def field_type(self, obj: Ex, name: str, line: int) -> str:
        c = self.mod.find_class(obj.ty[1:], line)
        return c.fields[self.mod.field_index(c, name, line)].ty

    def check_field_access(self, obj: Ex, name: str, writing: bool, line: int):
        # private fields belong to their class (D12ac, D12r); a const field is set only by its own class's @init (D12o)
        c = self.mod.find_class(obj.ty[1:], line)
        fld = c.fields[self.mod.field_index(c, name, line)]
        if fld.is_private and self.owner != fld.owner:
            raise CompileError(f"the field '{name}' is private to class '{fld.owner}'\nonly its own methods can use it", line)
        if writing and fld.is_const and not (self.in_init and self.owner == fld.owner):
            raise CompileError(f"the const field '{name}' cannot be changed after the object is created", line)

    def lent_base(self, base: Node) -> Ex:
        # the object or list that a field or item is read from, when it is itself a field or item of a local: lent, not retained
        if base.kind == 'Index':
            return self.index(base, False, True)
        return self.field_get(base, False, True)

    def field_get(self, n: Node, lend: bool = False, as_base: bool = False) -> Ex:
        # lend: the result is a number that the caller uses up at once; as_base: the caller only reads from the result and lets it go.
        # In both cases a value read from a local (or from something lent) is not copied: the local stays alive and nothing runs
        # in between, so nothing can change what it points at.
        base = val_node(n.fields[0])
        if (lend or as_base) and (base.kind == 'Attr' or base.kind == 'Index'):
            obj = self.unwrap(self.lent_base(base), n.line)
        else:
            obj = self.unwrap(self.expr_b(base, []), n.line)
        name = n.fields[1].text
        if is_class(obj.ty):
            self.check_field_access(obj, name, False, n.line)
        addr = self.field_addr(obj, name, n.line)
        ft = self.field_type(obj, name, n.line)
        lent = obj.reg.startswith('%bl.') and ((lend and ft == 'int') or (as_base and is_rc(ft)))
        v = self.tmp('bl' if lent else 'f')
        self.emit(f'{v} = load {llvm_type(ft)}, ptr {addr}')
        e = ex(v, ft)
        if lent:
            return e
        self.retain(e)
        self.release(obj)
        return e

    def assign_field(self, s: Node, target: Node):
        obj = self.unwrap(self.expr_b(val_node(target.fields[0]), [val_node(s.fields[1])]), s.line)
        name = target.fields[1].text
        if is_class(obj.ty):
            self.check_field_access(obj, name, True, s.line)
        ft = self.field_type(obj, name, s.line)
        v = self.expr(val_node(s.fields[1]), ft)
        v = self.want(v, ft, s.line, 'the assigned value')
        addr = self.field_addr(obj, name, s.line)
        self.store_owned(addr, v)
        self.release(obj)

    def list_lit(self, n: Node, expected: str) -> Ex:
        items = val_nodes(n.fields[0])
        t = ''
        first = ex('', '')
        kind = 'tuple' if n.kind == 'TupleLit' else 'list'
        if is_list(expected) and expected.startswith(kind + '['):
            t = expected
        else:
            if len(items) == 0:
                raise CompileError(f'the type of an empty {kind} cannot be guessed\ndeclare it, such as: xs: {kind}[int] = []', n.line)
            first = self.expr(items[0])
            if first.ty == '':
                raise CompileError(f'a {kind} item needs a value', n.line)
            t = f'{kind}[{first.ty}]'
        lst = self.tmp('list')
        self.emit(f'{lst} = call ptr @tomato_list_new(i64 {self.mod.code_of(t)})')
        held_before = len(self.held)
        self.hold(ex(lst, t))                 # the items pushed so far are freed with it if a later item raises
        for k, item in enumerate(items):
            v = ex('', '')
            if k == 0 and first.ty != '':
                v = first
            else:
                v = self.expr(item, elem_of(t))
            v = self.want(v, elem_of(t), n.line, 'a list item')
            v = self.owned(v)
            self.push_item(lst, t, v)     # the list takes the reference
        self.drop_held(held_before)
        return ex(lst, t)

    def key_word(self, k: Ex) -> str:
        # a key as the 64-bit word the runtime hashes: the number itself, or the text's address
        if k.ty != 'str':
            return k.reg
        r = self.tmp('kw')
        self.emit(f'{r} = ptrtoint ptr {k.reg} to i64')
        return r

    def new_set(self, t: str) -> Ex:
        kind = '1' if set_elem(t) == 'str' else '0'
        if set_elem(t) == 'int':
            kind = '2'                  # a table that copies big numbers
        r = self.tmp('set')
        self.emit(f'{r} = call ptr @tomato_dict_new(i64 {self.mod.code_of(t)}, i64 0, i32 {kind})')
        return ex(r, t)

    def set_lit(self, n: Node, expected: str) -> Ex:
        items = val_nodes(n.fields[0])
        t = expected
        first = ex('', '')
        if not is_set(expected):
            first = self.expr(items[0])
            t = f'set[{first.ty}]'
            if not is_set(t) or not (first.ty == 'str' or first.ty == 'int' or first.ty == 'bool'):
                raise CompileError('a set can hold only int, bool or str values', n.line)
        st = self.new_set(t)
        held_before = len(self.held)
        self.hold(st)
        for k, item in enumerate(items):
            v = ex('', '')
            if k == 0 and first.ty != '':
                v = first
            else:
                v = self.expr(item, set_elem(t))
            v = self.want(v, set_elem(t), n.line, 'a set element')
            slot = self.tmp('slot')
            self.emit(f'{slot} = call ptr @tomato_dict_insert(ptr {st.reg}, i64 {self.key_word(v)}, i32 0)')
            self.release(v)
        self.drop_held(held_before)
        return st

    def map_lit(self, n: Node, expected: str) -> Ex:
        pairs = n.fields[0].items
        if is_set(expected) and len(pairs) == 0:
            return self.new_set(expected)
        if not is_dict(expected):
            raise CompileError('the type of an empty {} cannot be guessed\ndeclare it, such as: m: dict[str, int] = {}', n.line)
        value_t = dict_value(expected)
        d = self.tmp('dict')
        self.emit(f'{d} = call ptr @tomato_dict_new(i64 {self.mod.code_of(expected)}, i64 8, i32 1)')
        held_before = len(self.held)
        self.hold(ex(d, expected))
        for pair in pairs:
            k = self.expr(val_node(pair.items[0]))
            k = self.want(k, 'str', n.line, 'a dict key')
            self.hold(k)
            v = self.expr(val_node(pair.items[1]), value_t)
            self.drop_held(held_before + 1)
            v = self.want(v, value_t, n.line, 'a dict value')
            slot = self.tmp('slot')
            self.emit(f'{slot} = call ptr @tomato_dict_insert(ptr {d}, i64 {self.key_word(k)}, i32 1)')
            dup = self.tmp('dup')
            self.emit(f'{dup} = icmp eq ptr {slot}, null')
            self.fail_if(dup, 'duplicate key in a dict literal', [k, v])
            v = self.owned(v)
            self.emit(f'store {llvm_type(v.ty)} {v.reg}, ptr {slot}')
            self.release(k)
        self.drop_held(held_before)
        return ex(d, expected)

    def int_literal(self, v: int, expected: str, negative: bool, line: int) -> Ex:
        # a whole-number literal takes the integer type its context wants (D05s-w), else int
        t = expected if is_fixed(expected) else 'int'
        if not fits_literal(v, t, negative):
            raise CompileError(f'{v} does not fit in {shown(t)}\nuse a wider type, or a value in its range', line)
        if t == 'int':
            if v >= 2 ** 61:
                text = str(v)
                if negative:
                    text = f'-{text}'
                r = self.tmp('big')
                self.emit(f'{r} = call i64 @tomato_int_parse(ptr {self.mod.intern(text)})')
                return exf(r, 'int')
            if negative:
                return ex(str(1 - v * 2), t)
            return ex(str(v * 2 + 1), t)
        if negative:
            return ex(str(-v), t)
        return ex(str(v), t)

    def const_eval(self, n: Node) -> int:
        # the value of a tree of whole-number literals joined by + - * (and a minus sign)
        if n.kind == 'IntLit':
            return n.fields[0].num
        if n.kind == 'UnOp':
            return -self.const_eval(val_node(n.fields[1]))
        a = self.const_eval(val_node(n.fields[1]))
        b = self.const_eval(val_node(n.fields[2]))
        op = n.fields[0].text
        if op == '+':
            return a + b
        if op == '-':
            return a - b
        return a * b

    def is_zero_literal(self, n: Node) -> bool:
        if n.kind == 'IntLit':
            return n.fields[0].num == 0
        if n.kind == 'FloatLit':
            return n.fields[0].num == 0
        if n.kind == 'UnOp' and n.fields[0].text == '-':
            return self.is_zero_literal(val_node(n.fields[1]))
        return False

    def literal_only(self, n: Node) -> bool:
        if n.kind == 'IntLit':
            return True
        if n.kind == 'UnOp' and n.fields[0].text == '-':
            return self.literal_only(val_node(n.fields[1]))
        if n.kind == 'BinOp':
            op = n.fields[0].text
            return (op == '+' or op == '-' or op == '*') and self.literal_only(val_node(n.fields[1])) and self.literal_only(val_node(n.fields[2]))
        return False

    def type_call(self, n: Node) -> Ex:
        # int[length=8](x) and uint[length=8](x): an explicit conversion that stops when the number does not fit
        t = val_node(n.fields[0])
        target = self.mod.type_name(vn(t))
        if not is_fixed(target):
            raise CompileError('this conversion is not supported\nonly int(), float(), str() and int[length=N] / uint[length=N] conversions exist', n.line)
        args = val_nodes(n.fields[1])
        v = self.expr(args[0])
        return self.convert_explicit(v, target, n.line)

    def plain_num(self, n: Node) -> bool:
        # an expression made only of numbers read from local variables and their fields, literals and arithmetic: no user code can run
        # while it is evaluated (an operator on an object, or an item of an object, could), so a number lent before it stays valid
        k = n.kind
        if k == 'IntLit' or k == 'FloatLit' or k == 'BoolLit':
            return True
        if k == 'Name':
            name = n.fields[0].text
            if name not in self.slots:
                return False
            t = self.types[name]
            return t == 'float' or t == 'bool' or is_numeric(t)
        if k == 'Attr':
            b = val_node(n.fields[0])
            if b.kind != 'Name' or b.fields[0].text not in self.slots or not is_class(self.types[b.fields[0].text]):
                return False
            c = self.mod.find_class(self.types[b.fields[0].text][1:], n.line)
            at = field_position(c, n.fields[1].text)
            if at < 0:
                return False
            t2 = c.fields[at].ty
            return t2 == 'float' or t2 == 'bool' or is_numeric(t2)
        if k == 'UnOp':
            return self.plain_num(val_node(n.fields[1]))
        if k == 'BinOp':
            op = n.fields[0].text
            if op == 'and' or op == 'or' or op == 'in' or op == 'is' or op == 'is not':
                return False
            return self.plain_num(val_node(n.fields[1])) and self.plain_num(val_node(n.fields[2]))
        return False

    def operand(self, n: Node, lend: bool) -> Ex:
        # an operand of an arithmetic or comparison operator. With lend, a number read from a field or a list item of a local is
        # not copied: nothing runs between the read and the operator that uses it up, so nothing can change what it points at.
        if lend and n.kind == 'Attr':
            return self.field_get(n, True)
        if lend and n.kind == 'Index':
            return self.index(n, True)
        return self.expr(n)

    def index(self, n: Node, lend: bool = False, as_base: bool = False) -> Ex:
        base = val_node(n.fields[0])
        if (lend or as_base) and (base.kind == 'Attr' or base.kind == 'Index') and (pure_read(val_node(n.fields[1])) or self.plain_num(val_node(n.fields[1]))):
            s = self.unwrap(self.lent_base(base), n.line)
        else:
            s = self.unwrap(self.expr_b(base, [val_node(n.fields[1])]), n.line)
        held_before = len(self.held)
        self.hold(s)                              # a fresh base is freed by the error path if the index expression raises
        if is_dict(s.ty):
            k = self.expr(val_node(n.fields[1]))
            k = self.want(k, 'str', n.line, 'a dict key')
            self.drop_held(held_before)
            slot = self.tmp('slot')
            self.emit(f'{slot} = call ptr @tomato_dict_find(ptr {s.reg}, i64 {self.key_word(k)})')
            missing = self.tmp('missing')
            self.emit(f'{missing} = icmp eq ptr {slot}, null')
            self.fail_if(missing, 'the key is not there', [k, s])
            vt = dict_value(s.ty)
            r = self.tmp('val')
            self.emit(f'{r} = load {llvm_type(vt)}, ptr {slot}')
            e = ex(r, vt)
            self.retain(e)
            self.release(k)
            self.release(s)
            return e
        if is_class(s.ty):
            g = self.mod.find_op(s.ty[1:], 'get')
            if g is None or len(g.ptypes) != 1 or g.ret == '':
                raise CompileError("'" + s.ty[1:] + "' objects cannot be indexed\nadd a method marked @get that takes the index and returns the item", n.line)
            gi = self.want(self.expr(val_node(n.fields[1])), g.ptypes[0], n.line, 'an index')
            self.drop_held(held_before)
            return self.marker_call(s, g, [gi], n.line)
        if is_list(s.ty):
            li = self.expr(val_node(n.fields[1]))
            li = self.want(li, 'int', n.line, 'an index')
            self.drop_held(held_before)
            addr = self.list_slot(s, ex(self.norm_index(s, self.int_raw(li)), 'int'), [s])
            lent = s.reg.startswith('%bl.') and ((lend and elem_of(s.ty) == 'int') or (as_base and is_rc(elem_of(s.ty))))
            item = self.load_item(s.ty, addr, 'bl' if lent else 'item')
            e = ex(item, elem_of(s.ty))
            if lent:
                return e
            self.retain(e)
            self.release(s)
            return e
        s = self.want(s, 'str', n.line, 'the value being indexed')
        i = self.expr(val_node(n.fields[1]))
        i = self.want(i, 'int', n.line, 'an index')
        self.drop_held(held_before)
        r = self.tmp('ch')
        self.emit(f'{r} = call ptr @tomato_str_index(ptr {s.reg}, i64 {self.int_raw(i)})')
        bad = self.tmp('oob')
        self.emit(f'{bad} = icmp eq ptr {r}, null')
        self.fail_if(bad, 'index out of range', [s])
        self.release(s)
        return ex(r, 'str')

    def norm_index(self, s: Ex, i: str) -> str:
        # a negative position counts from the end, as in Python: i + len when i < 0
        lenp = self.tmp('lenp')
        self.emit(f'{lenp} = getelementptr {{ i64, i64, i64, i64, ptr }}, ptr {s.reg}, i32 0, i32 2')
        ln = self.tmp('len')
        self.emit(f'{ln} = load i64, ptr {lenp}')
        neg = self.tmp('neg')
        self.emit(f'{neg} = icmp slt i64 {i}, 0')
        shifted = self.tmp('shifted')
        self.emit(f'{shifted} = add i64 {i}, {ln}')
        r = self.tmp('pos')
        self.emit(f'{r} = select i1 {neg}, i64 {shifted}, i64 {i}')
        return r

    def slice(self, n: Node) -> Ex:
        s = self.unwrap(self.expr(val_node(n.fields[0])), n.line)
        if is_class(s.ty):
            return self.object_slice(s, n)
        if not (s.ty == 'str' or is_list(s.ty)):
            raise CompileError(f'only text, lists, tuples and ranges can be sliced, but this is {shown(s.ty)}', n.line)
        flags = 0
        lo = '0'
        hi = '0'
        step = '1'
        held_before = len(self.held)
        self.hold(s)
        if n.fields[1].tag == 'n':
            e = self.want(self.expr(val_node(n.fields[1])), 'int', n.line, 'a slice start')
            lo = self.int_raw(e)
            flags += 1
        if n.fields[2].tag == 'n':
            e2 = self.want(self.expr(val_node(n.fields[2])), 'int', n.line, 'a slice end')
            hi = self.int_raw(e2)
            flags += 2
        if len(n.fields) > 3 and n.fields[3].tag == 'n':
            e3 = self.want(self.expr(val_node(n.fields[3])), 'int', n.line, 'a slice step')
            step = self.int_raw(e3)
            flags += 4
        self.drop_held(held_before)
        r = self.tmp('part')
        if s.ty == 'str':
            self.emit(f'{r} = call ptr @tomato_str_slice3(ptr {s.reg}, i64 {lo}, i64 {hi}, i64 {step}, i32 {flags})')
        else:
            rc = list_flags(s.ty)
            self.emit(f'{r} = call ptr @tomato_list_slice(ptr {s.reg}, i64 {lo}, i64 {hi}, i64 {step}, i32 {flags}, i32 {rc})')
        bad = self.tmp('zero')
        self.emit(f'{bad} = icmp eq ptr {r}, null')
        self.fail_if(bad, 'slice step cannot be zero', [s])
        self.release(s)
        return ex(r, s.ty)

    def membership(self, a: Ex, b: Ex, line: int) -> Ex:
        if is_class(b.ty):
            cf = self.mod.find_op(b.ty[1:], 'contains')
            if cf is None or len(cf.ptypes) != 1 or cf.ret != 'bool':
                raise CompileError("'in' does not work with '" + b.ty[1:] + "' objects\nadd a method marked @contains that takes the value and returns bool", line)
            a = self.want(a, cf.ptypes[0], line, 'the left side of in')
            return self.marker_call(b, cf, [a], line)
        if b.ty == 'str':
            a = self.want(a, 'str', line, 'the left side of in')
            c = self.tmp('c')
            self.emit(f'{c} = call i32 @tomato_str_contains(ptr {b.reg}, ptr {a.reg})')
            i1 = self.tmp('flag')
            self.emit(f'{i1} = icmp ne i32 {c}, 0')
            self.release(a)
            self.release(b)
            return self.bool_of(i1)
        if is_set(b.ty):
            a = self.want(a, set_elem(b.ty), line, 'the left side of in')
            slot = self.tmp('slot')
            self.emit(f'{slot} = call ptr @tomato_dict_find(ptr {b.reg}, i64 {self.key_word(a)})')
            i1 = self.tmp('flag')
            self.emit(f'{i1} = icmp ne ptr {slot}, null')
            self.release(a)
            self.release(b)
            return self.bool_of(i1)
        if is_dict(b.ty):
            a = self.want(a, 'str', line, 'the left side of in')
            slot = self.tmp('slot')
            self.emit(f'{slot} = call ptr @tomato_dict_find(ptr {b.reg}, i64 {self.key_word(a)})')
            i1 = self.tmp('flag')
            self.emit(f'{i1} = icmp ne ptr {slot}, null')
            self.release(a)
            self.release(b)
            return self.bool_of(i1)
        if is_list(b.ty):
            return self.list_contains(a, b, line)
        raise CompileError(f"'in' does not work with {shown(b.ty)}\nit works on lists, sets, dicts and text", line)

    def list_contains(self, a: Ex, lst: Ex, line: int) -> Ex:
        # walk the items and compare each with ==, stopping at the first match (basic item types only)
        elem = elem_of(lst.ty)
        if not (elem == 'int' or elem == 'bool' or elem == 'str'):
            raise CompileError("'in' can search only lists of int, bool or str", line)
        a = self.want(a, elem, line, 'the left side of in')
        found = self.hidden_slot('in.found')
        counter = self.hidden_slot('in.i')
        self.emit(f'store i64 0, ptr {found}')
        self.emit(f'store i64 0, ptr {counter}')
        head = self.label('inhead')
        body = self.label('inbody')
        step = self.label('instep')
        end = self.label('inend')
        self.br(head)
        self.place(head)
        i = self.tmp('i')
        self.emit(f'{i} = load i64, ptr {counter}')
        lenp = self.tmp('lenp')
        self.emit(f'{lenp} = getelementptr {{ i64, i64, i64, i64, ptr }}, ptr {lst.reg}, i32 0, i32 2')
        ln = self.tmp('n')
        self.emit(f'{ln} = load i64, ptr {lenp}')
        go = self.tmp('go')
        self.emit(f'{go} = icmp slt i64 {i}, {ln}')
        self.cond_br(go, body, end)
        self.place(body)
        addr = self.list_slot(lst, ex(i, 'int'))
        item = self.load_item(lst.ty, addr, 'item')
        hit = self.tmp('hit')
        if elem == 'str':
            c = self.tmp('c')
            self.emit(f'{c} = call i32 @tomato_str_cmp(ptr {item}, ptr {a.reg})')
            self.emit(f'{hit} = icmp eq i32 {c}, 0')
        elif elem == 'int':
            c = self.tmp('c')
            self.emit(f'{c} = call i32 @tomato_int_cmp(i64 {item}, i64 {a.reg})')
            self.emit(f'{hit} = icmp eq i32 {c}, 0')
        else:
            self.emit(f'{hit} = icmp eq i64 {item}, {a.reg}')
        yes = self.label('inhit')
        self.cond_br(hit, yes, step)
        self.place(yes)
        self.emit(f'store i64 1, ptr {found}')
        self.br(end)
        self.place(step)
        cur = self.tmp('cur')
        self.emit(f'{cur} = load i64, ptr {counter}')
        nxt = self.tmp('next')
        self.emit(f'{nxt} = add i64 {cur}, 1')
        self.emit(f'store i64 {nxt}, ptr {counter}')
        self.br(head)
        self.place(end)
        f = self.tmp('found')
        self.emit(f'{f} = load i64, ptr {found}')
        i1 = self.tmp('flag')
        self.emit(f'{i1} = icmp ne i64 {f}, 0')
        self.release(a)
        self.release(lst)
        return self.bool_of(i1)

    def compare_text(self, op: str, a: Ex, b: Ex) -> Ex:
        c = self.tmp('cmp32')
        self.emit(f'{c} = call i32 @tomato_str_cmp(ptr {a.reg}, ptr {b.reg})')
        cc = 'eq'
        if op == '!=':
            cc = 'ne'
        elif op == '<':
            cc = 'slt'
        elif op == '<=':
            cc = 'sle'
        elif op == '>':
            cc = 'sgt'
        elif op == '>=':
            cc = 'sge'
        r = self.tmp('c')
        self.emit(f'{r} = icmp {cc} i32 {c}, 0')
        self.release(a)
        self.release(b)
        return self.bool_of(r)

    def logic(self, n: Node, op: str) -> Ex:
        # and / or: the right side only runs when the left side does not decide the answer
        a = self.expr(val_node(n.fields[1]))
        a = self.want(a, 'bool', n.line, 'the left side of ' + op)
        res = self.hidden_slot('logic')
        self.emit(f'store i64 {a.reg}, ptr {res}')
        c = self.truth(a, n.line)
        rhs = self.label('rhs')
        end = self.label('endlogic')
        if op == 'and':
            self.cond_br(c, rhs, end)
        else:
            self.cond_br(c, end, rhs)
        self.place(rhs)
        b = self.expr(val_node(n.fields[2]))
        b = self.want(b, 'bool', n.line, 'the right side of ' + op)
        self.emit(f'store i64 {b.reg}, ptr {res}')
        self.br(end)
        self.place(end)
        r = self.tmp('logic')
        self.emit(f'{r} = load i64, ptr {res}')
        return ex(r, 'bool')

    def type_operand(self, n: Node) -> str:
        # the right side of `x in Type` (D23f): a type name that is not a variable; '' when it is something else
        if n.kind != 'Name':
            return ''
        name = n.fields[0].text
        if name in self.slots:
            return ''
        if name == 'None':
            return 'None'
        if basic_type(name) and name != 'File':
            return name
        key = self.mod.resolve(name)
        if key != '' and self.mod.has_class(key):
            return f'@{key}'
        if key != '' and self.mod.has_iface(key):
            return f'%{key}'
        return ''

    def type_test(self, left: Node, tt: str, line: int) -> Ex:
        # x in Type: true when the value's type is Type (a class name also matches its subclasses)
        a = self.expr(left)
        acc = ''
        c = ''
        if is_union(a.ty):
            for m in union_members(a.ty):
                if self.mod.assignable(m, tt):
                    c = self.box_is(a, m)
                    if acc == '':
                        acc = c
                    else:
                        merged = self.tmp('either')
                        self.emit(f'{merged} = or i1 {acc}, {c}')
                        acc = merged
            if acc == '':
                acc = self.tmp('no')
                self.emit(f'{acc} = icmp ne i64 0, 0')
        elif is_optional(a.ty):
            acc = self.tmp('opt')
            if tt == 'None':
                self.emit(f'{acc} = icmp eq ptr {a.reg}, null')
            elif self.mod.assignable(strip_optional(a.ty), tt):
                self.emit(f'{acc} = icmp ne ptr {a.reg}, null')
            else:
                self.emit(f'{acc} = icmp ne i64 0, 0')
        else:
            acc = self.tmp('static')
            if self.mod.assignable(a.ty, tt):
                self.emit(f'{acc} = icmp eq i64 0, 0')
            else:
                self.emit(f'{acc} = icmp ne i64 0, 0')
        self.release(a)
        return self.bool_of(acc)

    def binop(self, n: Node, expected: str) -> Ex:
        op = n.fields[0].text
        if op == 'and' or op == 'or':
            return self.logic(n, op)
        left = val_node(n.fields[1])
        right = val_node(n.fields[2])
        if (op == '/' or op == '//' or op == '%') and self.is_zero_literal(right):
            raise CompileError('division by zero: the divisor is the constant 0', n.line)
        if (op == '+' or op == '-' or op == '*') and is_fixed(expected) and self.literal_only(n):
            total = self.const_eval(n)
            negative_total = total < 0
            if negative_total:
                total = -total
            if not fits_literal(total, expected, negative_total):
                raise CompileError(f'the constant {self.const_eval(n)} does not fit in {shown(expected)}', n.line)
        if op == 'in' and self.type_operand(right) != '':
            return self.type_test(left, self.type_operand(right), n.line)
        a = ex('', '')
        b = ex('', '')
        held_before = len(self.held)
        if (op == '+' or op == '-' or op == '*') and self.literal_only(n) and is_fixed(expected):
            a = self.expr(left, expected)
            b = self.expr(right, expected)
        elif (op == '+' or op == '-' or op == '*') and self.literal_only(left) and not self.literal_only(right):
            b = self.expr(right)
            hint = b.ty if is_fixed(b.ty) else ''
            a = self.expr(left, hint)
        elif (op == '+' or op == '-' or op == '*') and self.literal_only(right) and not self.literal_only(left):
            a = self.expr(left)
            hint = a.ty if is_fixed(a.ty) else ''
            b = self.expr(right, hint)
        else:
            a = self.operand(left, pure_read(right) or self.plain_num(right))
            self.hold(a)                       # freed by the error path if the right side raises
            b = self.operand(right, True)
            self.drop_held(held_before)
        is_compare = op == '==' or op == '!=' or op == '<' or op == '<=' or op == '>' or op == '>='
        if op == 'in':
            return self.membership(a, b, n.line)
        if not ((op == 'is' or op == 'is not' or op == '==' or op == '!=') and (a.ty == 'None' or b.ty == 'None')):
            a = self.unwrap(a, n.line, [b])
            b = self.unwrap(b, n.line, [a])
        if (op == 'is' or op == 'is not' or op == '==' or op == '!=') and (a.ty == 'None' or b.ty == 'None'):
            if not is_rc(a.ty) or not is_rc(b.ty):
                other = a.ty
                if a.ty == 'None':
                    other = b.ty
                raise CompileError(f'a value of type {shown(other)} is never None, so it cannot be compared with None\nonly a value that can be None (such as T | None) may be compared with None', n.line)
            cc = 'ne' if op == 'is not' or op == '!=' else 'eq'
            c = self.tmp('isnone')
            self.emit(f'{c} = icmp {cc} ptr {a.reg}, {b.reg}')
            self.release(a)
            self.release(b)
            return self.bool_of(c)
        if is_class(a.ty) and operator_marker_of(op) != '' and (self.mod.has_op(a.ty[1:], operator_marker_of(op)) or not (op == '==' or op == '!=')):
            return self.operator_call(a, b, op, n.line)
        if (op == '==' or op == '!=') and (a.ty.startswith('list[') or b.ty.startswith('list[')):
            return self.list_equal(op, a, b, n.line)
        if (op == '+' or op == '*') and (is_list(a.ty) or is_list(b.ty) or a.ty == 'str' or b.ty == 'str'):
            joined = self.sequence_op(op, a, b, n.line)
            if joined.ty != '':
                return joined
        if a.ty == 'str' or b.ty == 'str':
            if a.ty != b.ty:
                raise CompileError(f"cannot use '{op}' with {shown(a.ty)} and {shown(b.ty)}", n.line)
            if op == '+':
                r = self.tmp('cat')
                self.emit(f'{r} = call ptr @tomato_str_concat(ptr {a.reg}, ptr {b.reg})')
                self.release(a)
                self.release(b)
                return ex(r, 'str')
            if is_compare:
                return self.compare_text(op, a, b)
            raise CompileError(f"'{op}' does not work on text\nit works with numbers; use + to join text", n.line)
        if op == 'in':
            return self.membership(a, b, n.line)
        if op == 'xor':
            a = self.want(a, 'bool', n.line, 'the left side of ' + op)
            b = self.want(b, 'bool', n.line, 'the right side of ' + op)
            return ex(self.arith(op, a.reg, b.reg), 'bool')
        if a.ty == 'float' or b.ty == 'float':
            return self.float_op(op, a, b, n.line)
        if is_compare and a.ty == 'bool' and b.ty == 'bool':
            if op != '==' and op != '!=':
                raise CompileError('bool values cannot be ordered with < or >\nuse == or != to compare them', n.line)
        elif not (is_numeric(a.ty) and is_numeric(b.ty)):
            raise CompileError(f"cannot use '{op}' with {shown(a.ty)} and {shown(b.ty)}", n.line)
        if is_numeric(a.ty):
            if op == '+':
                return self.num_arith('add', a, b, n.line)
            if op == '-':
                return self.num_arith('sub', a, b, n.line)
            if op == '*':
                return self.num_arith('mul', a, b, n.line)
            if op == '%':
                return self.num_modulo(a, b, n.line)
            if op == '/':
                return self.num_divide(a, b, n.line)
            if op == '//':
                return self.num_floor_divide(a, b, n.line)
            if op == '**':
                return self.num_power(a, b, n.line)
            if op == '&' or op == '|' or op == '^':
                return self.num_bitwise(op, a, b, n.line)
            if op == '<<' or op == '>>':
                return self.num_shift(op, a, b, n.line)
            if is_compare:
                return self.num_compare(op, a, b, n.line)
        elif is_compare:
            if op == '==':
                return self.icmp('eq', a.reg, b.reg)
            return self.icmp('ne', a.reg, b.reg)
        raise CompileError(f"the operator '{op}' is not supported here", n.line)

    def list_equal(self, op: str, a: Ex, b: Ex, line: int) -> Ex:
        # xs == ys: the same length and every pair of items equal (items compare by their own ==); both lists must have the same type
        if a.ty != b.ty:
            raise CompileError(f"cannot use '{op}' with {shown(a.ty)} and {shown(b.ty)}\nlists are equal only when they have the same type", line)
        if not self.list_comparable(elem_of(a.ty)):
            raise CompileError(f"cannot use '{op}' on {shown(a.ty)}\nits items cannot be compared with ==", line)
        r = ex('', 'bool')
        if item_width(a.ty) != 8:
            # compact items (bool, fixed-width integers) are equal exactly when their bytes are
            c = self.tmp('same')
            self.emit(f'{c} = call i32 @tomato_list_eq_bytes(ptr {a.reg}, ptr {b.reg}, i64 {item_width(a.ty)})')
            i1 = self.tmp('flag')
            self.emit(f'{i1} = icmp ne i32 {c}, 0')
            self.release(a)
            self.release(b)
            r = self.bool_of(i1)
        else:
            info = self.mod.instance_func(self.mod.resolve('_list_eq'), [elem_of(a.ty)], line)
            r = self.call_helper(info, [a, b])
        if op == '!=':
            return ex(self.arith('xor', r.reg, '1'), 'bool')
        return r

    def list_comparable(self, t: str) -> bool:
        if t.startswith('list['):
            return self.list_comparable(elem_of(t))
        return t == 'str' or t == 'bool' or t == 'float' or is_numeric(t) or (is_class(t) and self.mod.has_op(t[1:], 'eq'))

    def invert_op(self, n: Node) -> Ex:
        # ~x on an object whose class has a method marked @invert (taking nothing besides self)
        v = self.unwrap(self.expr(val_node(n.fields[1])), n.line)
        if v.ty == 'int':
            r = self.tmp('not')
            self.emit(f'{r} = call i64 @tomato_int_not(i64 {v.reg})')
            self.release(v)
            return exf(r, 'int')
        if is_fixed(v.ty):
            r = self.tmp('not')
            self.emit(f'{r} = xor {llvm_type(v.ty)} {v.reg}, -1')
            return ex(r, v.ty)
        if not is_class(v.ty):
            raise CompileError(f"cannot use '~' on {shown(v.ty)}\nit works on whole numbers and on objects whose class has a method marked @invert", n.line)
        f = self.mod.find_op(v.ty[1:], 'invert')
        if f is None or len(f.ptypes) != 0 or f.ret == '':
            raise CompileError("cannot use '~' on '" + v.ty[1:] + "' objects\nadd a method marked @invert that takes nothing and returns the result", n.line)
        return self.marker_call(v, f, [], n.line)

    def operator_call(self, a: Ex, b: Ex, op: str, line: int) -> Ex:
        # a + b on a class whose method is marked @add (and the same for the other operators): the method of the left
        # operand runs with the right operand as its one argument (D12l)
        marker = operator_marker_of(op)
        found = self.mod.find_op(a.ty[1:], marker)
        if found is None:
            raise CompileError("cannot use '" + op + "' on '" + a.ty[1:] + "' objects\nadd a method marked @" + marker + ' to the class', line)
        info = found
        if len(info.ptypes) != 1:
            raise CompileError(f"the @{marker} method '{info.name}' must take exactly one argument besides self", line)
        b = self.want(b, info.ptypes[0], line, 'the right operand of ' + op)
        values: list[Ex] = [a, b]
        text = f'call {self.ret_llvm(info)} {self.dispatch(a, info.name)}(ptr {a.reg}, {llvm_type(b.ty)} {b.reg})'
        result = ex('', '')
        if info.ret == '':
            self.emit(text)
        else:
            r = self.tmp('op')
            self.emit(f'{r} = {text}')
            result = ret_ex(r, info.ret)
        self.check_error(values)
        self.release(a)
        self.release(b)
        if marker == 'eq' or marker == 'lt' or marker == 'le' or marker == 'gt' or marker == 'ge':
            if result.ty != 'bool':
                raise CompileError(f"the @{marker} method '{info.name}' must return bool", line)
        if op == '!=':
            return ex(self.arith('xor', result.reg, '1'), 'bool')
        return result

    def call(self, n: Node, statement: bool) -> Ex:
        f = val_node(n.fields[0])
        if f.kind == 'LlvmRef':
            if len(n.fields[2].items) > 0:
                raise CompileError('an LLVM function cannot take keyword arguments', n.line)
            return self.llvm_call(n, f.fields[0].text)
        if f.kind == 'Attr':
            self.kw = n.fields[2].items
            target = val_node(f.fields[0])
            if target.kind == 'Name' and target.fields[0].text not in self.slots and self.mod.resolve(target.fields[0].text) != '' and self.mod.has_class(self.mod.resolve(target.fields[0].text)):
                return self.qualified_call(n, f, self.mod.resolve(target.fields[0].text))
            return self.method_call(n, f)
        if f.kind == 'Index' and val_node(f.fields[0]).kind == 'Name' and val_node(f.fields[0]).fields[0].text not in self.slots and self.mod.resolve(val_node(f.fields[0]).fields[0].text) in self.mod.generics:
            return self.explicit_call(self.mod.resolve(val_node(f.fields[0]).fields[0].text), n, f, val_nodes(n.fields[1]))
        if f.kind == 'Index' or f.kind == 'Call':
            self.kw = n.fields[2].items
            callee = self.expr(f)
            if is_fn(callee.ty):
                return self.call_value(callee, val_nodes(n.fields[1]), n.line, 'this function value')
            self.kw = []
            raise CompileError(f'this is {shown(callee.ty)}, not a function, so it cannot be called', n.line)
        if f.kind != 'Name':
            raise CompileError('only a function name can be called here\ncalling the result of another expression is not supported', n.line)
        name = f.fields[0].text
        if len(n.fields[2].items) > 0 and name in ['print', 'open', 'len', 'str', 'int', 'input', 'sleep']:
            raise CompileError(f"'{name}' does not take keyword arguments", n.line)
        args = val_nodes(n.fields[1])
        if name in self.slots and is_fn(self.types[name]):
            self.kw = n.fields[2].items
            return self.call_value(self.expr(f), args, n.line, "the function value '" + name + "'")
        if name == 'print':
            if not statement:
                raise CompileError("print() gives no value, so it cannot be used inside an expression", n.line)
            self.print_call(args)
            return ex('', '')
        if name == 'open':
            return self.open_call(args, n.line)
        if name == 'input' and name not in self.slots and self.mod.resolve(name) == '':
            return self.input_call(args, n.line)
        if name == 'clock' and name not in self.slots and self.mod.resolve(name) == '':
            if len(args) > 0:
                raise CompileError('clock() takes no arguments', n.line)
            c = self.tmp('clock')
            self.emit(f'{c} = call double @tomato_clock()')
            return ex(c, 'float')
        if name == 'sleep' and name not in self.slots and self.mod.resolve(name) == '':
            raise CompileError("sleep() is async, so it must be awaited\nwrite: await sleep(seconds)  inside an async def", n.line)
        if name == '_http_wait' and name not in self.slots and self.mod.resolve(name) == '':
            raise CompileError("_http_wait() is async, so it must be awaited\nwrite: await _http_wait(handle)  inside an async def", n.line)
        if name == 'len':
            return self.len_call(args, n.line)
        if name == 'str':
            return self.str_call(args, n.line)
        if name == '_repr_box' and len(args) == 1 and name not in self.slots and self.mod.resolve(name) == '':
            # the text of a union value inside a printed container: text is quoted, as Python does
            bv = self.expr(args[0])
            br = self.tmp('repr')
            self.emit(f'{br} = call ptr @tomato_box_repr(ptr {bv.reg})')
            self.release(bv)
            return ex(br, 'str')
        if name == 'float' and len(args) == 1:
            return self.float_call(self.expr(args[0]), n.line)
        if name == 'int' and len(args) == 1:
            conv = self.expr(args[0])
            if conv.ty == 'float':
                return self.float_to_int(conv, n.line)
            return self.convert_explicit(conv, 'int', n.line)
        key = self.mod.resolve(name)
        if key == '' and name in ['abs', 'chr', 'ord'] and name not in self.slots:
            return self.number_text_builtin(name, args, n.line)
        if key == '' and name == 'sorted' and len(n.fields[2].items) > 0:
            return self.sorted_by(args, n.fields[2].items, n.line)
        if key == '' and (name == 'map' or name == 'filter') and name not in self.slots:
            return self.map_filter(name, args, n.fields[2].items, n.line)
        if key == '' and name in ['sorted', 'reversed', 'sum', 'min', 'max']:
            self.kw = []
            return self.list_builtin(name, args, n.line)
        if name == 'range' and name not in self.slots:
            # range(...) is a value of the builtin class `range` (std/builtin.tom); range(a, b, c) is its constructor
            if len(args) < 1 or len(args) > 3 or len(n.fields[2].items) > 0:
                raise CompileError('range() takes 1 to 3 whole-number arguments: range(stop), range(start, stop) or range(start, stop, step)', n.line)
            if len(args) < 3:
                helper = self.mod.resolve(f'_range{len(args)}')
                self.kw = []
                return self.call_function(self.mod.find(helper, n.line), '@tomato.' + helper, ex('', ''), args, n.line)
        if key == '' and name == 'list':
            return self.list_call(args, n.line)
        if key == '':
            raise CompileError(self.unknown_function(name), n.line)
        if key in self.mod.generics:
            return self.generic_call(key, n, args)
        if self.mod.has_class(key):
            if len(n.fields[2].items) > 0:
                raise CompileError('keyword arguments are not supported when creating an object\npass the arguments by position', n.line)
            return self.construct(self.mod.find_class(key, n.line), args, n.line)
        self.kw = n.fields[2].items
        return self.call_function(self.mod.find(key, n.line), '@tomato.' + key, ex('', ''), args, n.line)

    # ---- generic classes and functions (D60a)
    # the type of an argument, found by compiling it and throwing the code away (it is compiled again for real afterwards)
    def arg_type(self, a: Node) -> str:
        mark = len(self.lines)
        ty = ''
        try:
            ty = self.expr(a).ty
        catch CompileError:
            ty = ''          # such as an empty list, whose type only the other arguments settle
        self.lines = self.lines[:mark]
        self.terminated = False
        return ty

    # what each type parameter of a generic class or function stands for, found from the types of the arguments
    def infer_targs(self, gkey: str, params: list[Node], args: list[Node], line: int) -> list[str]:
        saved = self.mod.cur
        saved_vars = self.mod.tvars
        self.mod.cur = self.mod.generic_mods[gkey]
        tparams = self.mod.type_params_of(gkey)
        pattern: dict[str, str] = {}
        for tp in tparams:
            pattern[tp] = '$' + tp
        self.mod.tvars = pattern
        patterns: list[str] = []
        for p in params:
            patterns.append(self.mod.type_name(p.fields[1]))
        self.mod.cur = saved
        self.mod.tvars = saved_vars
        binds: dict[str, str] = {}
        for k, a in enumerate(args):
            if k < len(patterns) and patterns[k].find('$') >= 0:
                self.mod.unify(patterns[k], self.arg_type(a), binds)
        out: list[str] = []
        for tp in tparams:
            if tp not in binds:
                raise CompileError(f"cannot tell what {tp} is in this call of '{self.mod.generics[gkey].fields[0].text}'\n{tp} comes from the types of the arguments: pass a value that has it, or write the type out, as in {self.mod.generics[gkey].fields[0].text}[int](...)", line)
            out.append(binds[tp])
        return out

    def generic_class_init(self, gkey: str) -> list[Node]:
        for m in val_nodes(self.mod.generics[gkey].fields[4]):
            if m.fields[6].tag == 's' and m.fields[6].text == 'init':
                out: list[Node] = []
                for p in val_nodes(m.fields[1]):
                    if p.fields[0].text != 'self':
                        out.append(p)
                return out
        return []

    # a type written as an expression, such as the `str` in Stack[str]() or the `list[int]` in Box[list[int]](...), as a type node
    def type_node_of(self, n: Node) -> Node:
        if n.kind == 'Name':
            return mk('TypeRef', n.line, [vs(n.fields[0].text), vz(), vz(), vz()])
        if n.kind == 'Index':
            base = val_node(n.fields[0])
            if base.kind == 'Name' and n.fields[1].tag == 'n':
                return mk('TypeRef', n.line, [vs(base.fields[0].text), vz(), vn(self.type_node_of(val_node(n.fields[1]))), vz()])
        raise CompileError('this is not a type\nwrite the type of the items, such as Stack[str]()', n.line)

    # Name[Type](args): a generic class or function used with its type argument written out
    def explicit_call(self, gkey: str, n: Node, f: Node, args: list[Node]) -> Ex:
        g = self.mod.generics[gkey]
        if f.fields[1].tag != 'n':
            raise CompileError('this is not a type\nwrite the type of the items, such as Stack[str]()', n.line)
        saved = self.mod.cur
        targ = self.mod.type_name(vn(self.type_node_of(val_node(f.fields[1]))))
        self.mod.cur = saved
        if targ == '':
            raise CompileError('this type is not supported here', n.line)
        if g.kind == 'ClassDef':
            if len(n.fields[2].items) > 0:
                raise CompileError('keyword arguments are not supported when creating an object\npass the arguments by position', n.line)
            ckey = self.mod.instance_class(gkey, [targ], n.line)
            return self.construct(self.mod.find_class(ckey, n.line), args, n.line)
        info = self.mod.instance_func(gkey, [targ], n.line)
        self.kw = n.fields[2].items
        return self.call_function(info, '@tomato.' + info.key, ex('', ''), args, n.line)

    def generic_call(self, gkey: str, n: Node, args: list[Node]) -> Ex:
        g = self.mod.generics[gkey]
        if g.kind == 'ClassDef':
            if len(n.fields[2].items) > 0:
                raise CompileError('keyword arguments are not supported when creating an object\npass the arguments by position', n.line)
            targs = self.infer_targs(gkey, self.generic_class_init(gkey), args, n.line)
            ckey = self.mod.instance_class(gkey, targs, n.line)
            return self.construct(self.mod.find_class(ckey, n.line), args, n.line)
        targs = self.infer_targs(gkey, val_nodes(g.fields[1]), args, n.line)
        info = self.mod.instance_func(gkey, targs, n.line)
        self.kw = n.fields[2].items
        return self.call_function(info, '@tomato.' + info.key, ex('', ''), args, n.line)

    def number_text_builtin(self, name: str, args: list[Node], line: int) -> Ex:
        # abs(x) for an int or a float (std/builtin.tom), chr(n) and ord(c)
        if len(args) != 1 or len(self.kw) > 0:
            raise CompileError(f"'{name}' takes exactly one argument", line)
        v = self.expr(args[0])
        if name == 'abs':
            if v.ty == 'int':
                return self.builtin_call('_abs_int', [v], line)
            if v.ty == 'float':
                return self.builtin_call('_abs_float', [v], line)
            if is_fixed(v.ty):
                if not is_signed(v.ty):
                    return v
                # a fixed-width int: -x with an overflow stop (only the smallest value overflows), kept when x is not negative
                llt = llvm_type(v.ty)
                intr = f'llvm.ssub.with.overflow.{llt}'
                self.mod.declare(f'declare {{{llt}, i1}} @{intr}({llt}, {llt})')
                pair = self.tmp('pair')
                self.emit(f'{pair} = call {{{llt}, i1}} @{intr}({llt} 0, {llt} {v.reg})')
                negated = self.tmp('neg')
                self.emit(f'{negated} = extractvalue {{{llt}, i1}} {pair}, 0')
                ov = self.tmp('ov')
                self.emit(f'{ov} = extractvalue {{{llt}, i1}} {pair}, 1')
                self.fail_if(ov, 'integer overflow')
                below = self.tmp('below')
                self.emit(f'{below} = icmp slt {llt} {v.reg}, 0')
                r = self.tmp('abs')
                self.emit(f'{r} = select i1 {below}, {llt} {negated}, {llt} {v.reg}')
                return ex(r, v.ty)
            raise CompileError(f'abs() takes an int or a float, but this is {shown(v.ty)}', line)
        if name == 'chr':
            v = self.want(v, 'int', line, 'the argument of chr')
            # a number too big for a machine word is a heap number (low bit clear): out of range as well
            tagbit = self.tmp('tagbit')
            self.emit(f'{tagbit} = and i64 {v.reg}, 1')
            huge = self.tmp('huge')
            self.emit(f'{huge} = icmp eq i64 {tagbit}, 0')
            self.fail_if(huge, 'chr() takes a number from 0 to 1114111, not a surrogate', [v])
            raw = self.int_raw(v)
            high = self.tmp('toobig')
            self.emit(f'{high} = icmp ugt i64 {raw}, 1114111')
            low = self.tmp('surrogate')
            self.emit(f'{low} = sub i64 {raw}, 55296')
            sur = self.tmp('insurrogate')
            self.emit(f'{sur} = icmp ult i64 {low}, 2048')
            bad = self.tmp('badchar')
            self.emit(f'{bad} = or i1 {high}, {sur}')
            self.fail_if(bad, 'chr() takes a number from 0 to 1114111, not a surrogate')
            r = self.tmp('char')
            self.emit(f'{r} = call ptr @tomato_str_chr(i64 {raw})')
            return ex(r, 'str')
        v = self.want(v, 'str', line, 'the argument of ord')
        n = self.tmp('alen')
        self.emit(f'{n} = call i64 @tomato_str_len(ptr {v.reg})')
        bad = self.tmp('notone')
        self.emit(f'{bad} = icmp ne i64 {n}, 1')
        self.fail_if(bad, 'ord() takes a text of exactly one character', [v])
        r = self.tmp('code')
        self.emit(f'{r} = call i64 @tomato_str_ord(ptr {v.reg})')
        self.release(v)
        return self.tag_small(r)

    def llvm_type_of(self, t: str) -> str:
        # how an LLVM function sees a Tomato type: a bool is one bit there
        if t == 'bool':
            return 'i1'
        return llvm_type(t)

    def llvm_call(self, n: Node, name: str) -> Ex:
        # a call to a declared LLVM function (D27b): the declaration gives the types, the linker the body
        found: list[FuncInfo] = [d for d in self.mod.llvm_decls if d.name == name]
        if len(found) == 0:
            raise CompileError(f"the LLVM function '!{name}' is not declared\nadd a line like '!{name}(a: int) -> int' at the top level of the file", n.line)
        info = found[0]
        args = val_nodes(n.fields[1])
        if len(args) != len(info.ptypes):
            raise CompileError("the LLVM function '!" + name + "' takes " + plural(len(info.ptypes), 'argument') + ', but ' + str(len(args)) + ' given', n.line)
        parts: list[str] = []
        types: list[str] = []
        held: list[Ex] = []
        for k, a in enumerate(args):
            v = self.expr(a, info.ptypes[k])
            v = self.want(v, info.ptypes[k], n.line, 'argument ' + str(k + 1) + ' of !' + name)
            held.append(v)
            reg = v.reg
            if v.ty == 'bool':
                reg = self.tmp('bit')
                self.emit(f'{reg} = trunc i64 {v.reg} to i1')
            elif v.ty == 'int':
                reg = self.int_raw(v)
            parts.append(f'{self.llvm_type_of(v.ty)} {reg}')
            types.append(self.llvm_type_of(v.ty))
        ret = self.llvm_type_of(info.ret) if info.ret != '' else 'void'
        self.mod.declare('declare ' + ret + ' @' + name + '(' + ', '.join(types) + ')')
        text = 'call ' + ret + ' @' + name + '(' + ', '.join(parts) + ')'
        r = ''
        if info.ret == '':
            self.emit(text)
        else:
            r = self.tmp('llvm')
            self.emit(f'{r} = {text}')
        for h in held:
            self.release(h)
        if info.ret == '':
            return ex('', '')
        if info.ret == 'bool':
            w = self.tmp('flag')
            self.emit(f'{w} = zext i1 {r} to i64')
            return ex(w, 'bool')
        if info.ret == 'int':
            return self.int_from_machine(r, True)
        return ex(r, info.ret)

    # a named function used as a value (D-fn): its address, with the type fn(parameters) -> result
    def func_value(self, name: str, key: str, line: int) -> Ex:
        if key in self.mod.generics:
            raise CompileError(f"'{name}' is generic, so it cannot be used as a value yet\nwrite a plain function that calls it", line)
        info = self.mod.find(key, line)
        if info.is_async or info.is_gen or info.has_varargs or info.has_kwargs:
            raise CompileError(f"'{name}' cannot be used as a value: an async function, a generator and a function with *args or **kwargs have no function type", line)
        res = info.ret
        if res == '':
            res = 'None'
        return ex('@tomato.' + key, 'fn[' + ','.join(info.ptypes) + '>' + res + ']')

    # a lambda (x -> expression): it becomes a function of its own, so it can use only its parameters and global names. The expected type
    # gives the parameter types; its result may be written ? (to find out from the body).
    def lambda_value(self, n: Node, expected: str) -> Ex:
        names: list[str] = [v.text for v in n.fields[0].items]
        body = val_node(n.fields[1])
        if not is_fn(expected):
            raise CompileError('a lambda needs to know its parameter types\nuse it where a function is expected, such as sorted(xs, key=x -> x.age), or give the variable a type: f: fn(int) -> int = x -> x + 1', n.line)
        ptypes = fn_params(expected)
        if len(ptypes) != len(names):
            raise CompileError('this lambda takes ' + plural(len(names), 'parameter') + ', but ' + shown(expected) + ' takes ' + str(len(ptypes)), n.line)
        used: list[str] = []
        names_read(body, used)
        for u in used:
            if u in self.slots and u not in names:
                raise CompileError(f"a lambda cannot use the variable '{u}' from the function around it\nit can use its own parameters and global names; pass the value as a parameter", n.line)
        res = fn_result(expected)
        if res == '?':
            mark = len(self.lines)
            saved_slots: dict[str, str] = {}
            saved_types: dict[str, str] = {}
            for k, nm in enumerate(names):
                if nm in self.slots:
                    saved_slots[nm] = self.slots[nm]
                    saved_types[nm] = self.types[nm]
                self.new_slot(nm, ptypes[k])
            res = self.expr(body).ty
            self.lines = self.lines[:mark]
            self.terminated = False
            keep_s: dict[str, str] = {}
            keep_t: dict[str, str] = {}
            for key in self.slots:
                if key in saved_slots:
                    keep_s[key] = saved_slots[key]
                    keep_t[key] = saved_types[key]
                elif key not in names:
                    keep_s[key] = self.slots[key]
                    keep_t[key] = self.types[key]
            self.slots = keep_s
            self.types = keep_t
            if res == '' or res == 'None':
                raise CompileError('the body of this lambda gives no value', n.line)
        self.mod.lambda_count += 1
        fname = f'_lambda{self.mod.lambda_count}'
        binds: dict[str, str] = {}
        params: list[Node] = []
        for k, nm in enumerate(names):
            binds[f'__p{k}'] = ptypes[k]
            params.append(mk('Param', n.line, [vs(nm), vn(mk('TypeRef', n.line, [vs(f'__p{k}'), vz(), vz(), vz()])), vz(), vz()]))
        binds['__r'] = res
        ret_stmt = mk('Return', n.line, [vn(body)])
        item = mk('FuncDef', n.line, [vs(fname), vnodes(params), vn(mk('TypeRef', n.line, [vs('__r'), vz(), vz(), vz()])), vnodes([ret_stmt]), vb(False), vb(False), vz(), vb(False), vb(False), vz()])
        saved_vars = self.mod.tvars
        self.mod.tvars = binds
        info = function_info(item, self.mod, '')
        self.mod.tvars = saved_vars
        info.targs = binds
        self.mod.infos.append(info)
        self.mod.func_nodes.append(item)
        self.mod.extra_funcs.append(item)
        return ex('@tomato.' + info.key, 'fn[' + ','.join(ptypes) + '>' + res + ']')

    # call a function value: the callee only borrows its arguments, like any call
    def call_value(self, fv: Ex, args: list[Node], line: int, what: str) -> Ex:
        if len(self.kw) > 0:
            self.kw = []
            raise CompileError('a function value does not take keyword arguments\npass the arguments by position', line)
        ptypes = fn_params(fv.ty)
        res = fn_result(fv.ty)
        if len(args) != len(ptypes):
            raise CompileError(what + ' takes ' + plural(len(ptypes), 'argument') + ', but ' + str(len(args)) + ' given', line)
        values: list[Ex] = []
        for k, a in enumerate(args):
            v = self.expr(a, ptypes[k])
            values.append(self.want(v, ptypes[k], line, 'argument ' + str(k + 1) + ' of ' + what))
        parts: list[str] = [f'{llvm_type(v2.ty)} {v2.reg}' for v2 in values]
        callee = fv.reg
        result = ex('', '')
        if res == 'None':
            self.emit('call void ' + callee + '(' + ', '.join(parts) + ')')
        else:
            r = self.tmp('call')
            self.emit(f'{r} = call {llvm_type(res)} {callee}(' + ', '.join(parts) + ')')
            result = ret_ex(r, res)
        self.check_error(values)
        for v3 in values:
            self.release(v3)
        return result

    def call_function(self, info: FuncInfo, symbol: str, receiver: Ex, args: list[Node], line: int) -> Ex:
        if info.is_async:
            if not self.async_ok:
                raise CompileError(f"'{info.name}' is async, so it must be awaited or started\nwrite: await {info.name}(...)   or   start {info.name}(...)", line)
            self.async_ok = False
            if info.owner == '':
                symbol = f'@tomato.async.{info.key}'
        if info.is_gen:
            raise CompileError(f"'{info.name}' is a generator (it uses yield), so it can only be used as what a for loop loops over\nwrite: for x in {info.name}(...):", line)
        # a function, or a method when `receiver` holds the object; the callee only borrows its arguments
        keywords = self.kw
        self.kw = []
        nfixed = len(info.ptypes) - info.stars
        required = nfixed - len(info.defaults)
        if len(args) > nfixed and not info.has_varargs:
            raise CompileError("'" + info.name + "' takes " + plural(nfixed, 'argument') + ', but ' + str(len(args)) + ' given', line)
        values: list[Ex] = []
        held_before = len(self.held)
        if receiver.ty != '':
            values.append(receiver)
            self.hold(receiver)               # the argument values below are held too, until the call itself (see check_error)
        slots: list[Ex] = []        # one per fixed parameter: its value, or an empty Ex until a keyword or a default fills it
        for pi in range(nfixed):
            slots.append(ex('', ''))
        extra: list[Ex] = []        # the positional values beyond the named parameters (for *args)
        k = 0
        v = ex('', '')
        around: list[Node] = [a0 for a0 in args]
        for kv0 in keywords:
            around.append(val_node(kv0.items[1]))
        for d0 in info.defaults:
            around.append(d0)
        for a in args:
            if k < nfixed:
                if not info.is_async and a.kind == 'Name' and a.fields[0].text in self.slots and self.types[a.fields[0].text] == info.ptypes[k]:
                    v = self.expr_b(a, around)          # the callee only borrows it, and so does the call
                else:
                    v = self.expr(a, info.ptypes[k])
                v = self.want(v, info.ptypes[k], line, 'argument ' + str(k + 1) + " of '" + info.name + "' (the parameter '" + info.pnames[k] + "')")
                slots[k] = v
                self.hold(v)
            else:
                v = self.expr(a, elem_of(info.ptypes[nfixed]))
                v = self.want(v, elem_of(info.ptypes[nfixed]), line, 'an extra argument of ' + info.name)
                extra.append(v)
                self.hold(v)
            k += 1
        extra_names: list[str] = []
        extra_values: list[Ex] = []
        at = 0
        for kv in keywords:
            kname = kv.items[0].text
            at = -1
            for pi in range(nfixed):
                if info.pnames[pi] == kname:
                    at = pi
            if at >= 0:
                if slots[at].ty != '':
                    raise CompileError(f"the argument '{kname}' of '{info.name}' is given twice", line)
                v = self.expr(val_node(kv.items[1]), info.ptypes[at])
                v = self.want(v, info.ptypes[at], line, "argument '" + kname + "' of '" + info.name + "'")
                slots[at] = v
                self.hold(v)
            elif info.has_kwargs:
                if kname in extra_names:
                    raise CompileError(f"the keyword argument '{kname}' is given twice", line)
                kt = dict_value(info.ptypes[-1])
                v = self.expr(val_node(kv.items[1]), kt)
                v = self.want(v, kt, line, 'keyword argument ' + kname + " of '" + info.name + "'")
                extra_names.append(kname)
                extra_values.append(v)
                self.hold(v)
            else:
                raise CompileError(f"'{info.name}' has no parameter named '{kname}'", line)
        for pi in range(nfixed):               # the caller supplies the defaults it left out (D19c)
            if slots[pi].ty == '':
                if pi < required:
                    raise CompileError(f"'{info.name}' needs a value for '{info.pnames[pi]}'", line)
                v = self.expr(info.defaults[pi - required], info.ptypes[pi])
                v = self.want(v, info.ptypes[pi], line, 'the default of argument ' + str(pi + 1) + " of '" + info.name + "'")
                slots[pi] = v
                self.hold(v)
            values.append(slots[pi])
        self.drop_held(held_before)
        if info.has_varargs:
            values.append(self.build_tuple(info.ptypes[nfixed], extra))
        if info.has_kwargs:
            values.append(self.build_kwargs(info.ptypes[-1], extra_names, extra_values))
        parts: list[str] = [f'{llvm_type(v2.ty)} {v2.reg}' for v2 in values]
        text = 'call ' + self.ret_llvm(info) + ' ' + symbol + '(' + ', '.join(parts) + ')'
        result = ex('', '')
        if info.is_async:
            fr = self.tmp('frame')
            self.emit(fr + ' = call ptr ' + symbol + '(' + ', '.join(parts) + ')')
            for v4 in values:
                self.release(v4)
            self.fresh_frame = True
            return ex(fr, task_type_of(info))
        if info.ret == '':
            self.emit(text)
        else:
            r = self.tmp('call')
            self.emit(f'{r} = {text}')
            result = ret_ex(r, info.ret)
        self.check_error(values)
        for v3 in values:
            self.release(v3)
        return result

    def build_tuple(self, t: str, items: list[Ex]) -> Ex:
        lst = self.tmp('varargs')
        self.emit(f'{lst} = call ptr @tomato_list_new(i64 {self.mod.code_of(t)})')
        for it0 in items:
            it = self.owned(it0)
            self.push_item(lst, t, it)
        return ex(lst, t)

    def build_kwargs(self, t: str, names: list[str], items: list[Ex]) -> Ex:
        d = self.tmp('kwargs')
        self.emit(f'{d} = call ptr @tomato_dict_new(i64 {self.mod.code_of(t)}, i64 8, i32 1)')
        for k, it0 in enumerate(items):
            it = self.owned(it0)
            key = ex(self.mod.intern(names[k]), 'str')
            slot = self.tmp('slot')
            self.emit(f'{slot} = call ptr @tomato_dict_insert(ptr {d}, i64 {self.key_word(key)}, i32 1)')
            self.emit(f'store {llvm_type(it.ty)} {it.reg}, ptr {slot}')
        return ex(d, t)

    def check_error(self, values: list[Ex]):
        # an error raised by the callee is pending: drop the borrowed arguments and leave this function (D22a)
        ex1 = self.tmp('ex')
        self.emit(f'{ex1} = load ptr, ptr @tomato_exc')
        has = self.tmp('has')
        self.emit(f'{has} = icmp ne ptr {ex1}, null')
        bad = self.label('raised')
        fine = self.label('fine')
        self.cond_br(has, bad, fine)
        self.place(bad)
        self.trace(False)
        for v in values:
            self.release(v)
        self.release_held()
        self.br(self.unwind_target())
        self.place(fine)

    def construct(self, c: ClassInfo, args: list[Node], line: int) -> Ex:
        # Name(args): allocate, set the declared defaults, run @init (the constructor function does all three)
        ptypes: list[str] = []
        if c.init != '':
            ptypes = self.mod.find_method(c.name, c.init, line).ptypes
        defaults: list[Node] = []
        if c.init != '':
            defaults = self.mod.find_method(c.name, c.init, line).defaults
        required = len(ptypes) - len(defaults)
        if len(args) < required or len(args) > len(ptypes):
            raise CompileError("'" + c.name + "' takes " + plural(len(ptypes), 'argument') + ', but ' + str(len(args)) + ' given', line)
        values = self.args_with_defaults(args, ptypes, defaults, line, c.name)
        parts: list[str] = [f'{llvm_type(v.ty)} {v.reg}' for v in values]
        r = self.tmp('obj')
        self.emit(r + ' = call ptr @tomato.new.' + str(self.mod.code_of('@' + c.name)) + '(' + ', '.join(parts) + ')')
        self.check_error(values)
        for v in values:
            self.release(v)
        return ex(r, '@' + c.name)

    def dispatch(self, obj: Ex, name: str) -> str:
        # a virtual lookup: the object's type code picks a method table, the method name picks the slot
        tp = self.tmp('tp')
        self.emit(f'{tp} = getelementptr {{ i64, i64 }}, ptr {obj.reg}, i32 0, i32 1')
        raw = self.tmp('rawcode')
        self.emit(f'{raw} = load i64, ptr {tp}')
        code = self.tmp('code')
        self.emit(f'{code} = and i64 {raw}, 4294967295')
        vts = self.tmp('vts')
        self.emit(f'{vts} = getelementptr ptr, ptr @tomato_vtables, i64 {code}')
        vt = self.tmp('vt')
        self.emit(f'{vt} = load ptr, ptr {vts}')
        fp = self.tmp('fp')
        self.emit(f'{fp} = getelementptr ptr, ptr {vt}, i64 {self.mod.slot_of(name)}')
        f = self.tmp('f')
        self.emit(f'{f} = load ptr, ptr {fp}')
        return f

    def qualified_call(self, n: Node, f: Node, cls: str) -> Ex:
        # Class.method(self, args): the parent's version of a method, called on an object we already have (D12ao)
        info = self.mod.find_method(cls, f.fields[1].text, n.line)
        if info.is_private and self.owner != info.owner:
            raise CompileError(f"the method '{info.name}' is private to class '{info.owner}'\nonly its own methods can call it", n.line)
        args = val_nodes(n.fields[1])
        if info.op == 'static':
            # a method marked @static is called on the class itself (bitarray.from_hex('A2')): it runs on a fresh object made by the class's @init with no arguments
            made = mk('Call', n.line, [vn(val_node(f.fields[0])), vnodes([]), vlist([])])
            kw = self.kw
            self.kw = []
            fresh = self.expr(made)
            self.kw = kw
            return self.call_function(info, function_symbol(self.mod, info), fresh, args, n.line)
        if len(args) == 0:
            raise CompileError(f"'{cls}.{info.name}' needs an object as its first argument", n.line)
        obj = self.expr(args[0])
        if not self.mod.subclass(obj.ty, '@' + cls):
            raise CompileError(f"the first argument must be a '{cls}' object", n.line)
        return self.call_function(info, function_symbol(self.mod, info), obj, args[1:], n.line)

    def method_call(self, n: Node, f: Node) -> Ex:
        name = f.fields[1].text
        args = val_nodes(n.fields[1])
        recv = val_node(f.fields[0])
        if recv.kind == 'Name' and recv.fields[0].text in self.slots and self.borrowable_receiver(self.types[recv.fields[0].text], name):
            obj = self.unwrap(self.expr_b(recv, args), n.line)
        else:
            obj = self.unwrap(self.expr(recv), n.line)
        return self.method_on(obj, n, name, args)

    def method_on(self, obj: Ex, n: Node, name: str, args: list[Node]) -> Ex:
        if obj.ty.startswith('tuple[') and name in ['append', 'pop', 'insert', 'extend', 'sort', 'reverse']:
            raise CompileError(f"a tuple cannot be changed, so it has no '{name}'\nuse a list if the items must change", n.line)
        if is_list(obj.ty) and name == 'append':
            if len(args) != 1:
                raise CompileError(f'append() takes 1 argument, but {len(args)} given', n.line)
            v = self.expr(args[0], elem_of(obj.ty))
            v = self.want(v, elem_of(obj.ty), n.line, 'the appended item')
            v = self.owned(v)
            self.push_item(obj.reg, obj.ty, v)
            self.release(obj)
            return ex('', '')
        if is_list(obj.ty) and obj.ty.startswith('list[') and name in ['pop', 'insert', 'extend', 'sort', 'reverse']:
            return self.list_method(obj, name, args, n.fields[2].items, n.line)
        if is_task(obj.ty):
            return self.task_method(obj, name, args, n.line)
        if is_set(obj.ty):
            return self.set_method(obj, name, args, n.line)
        if is_dict(obj.ty):
            return self.dict_method(obj, name, args, n.line)
        if obj.ty == 'str':
            return self.text_method(obj, name, args, n.line)
        if obj.ty == 'File':
            return self.file_method(obj, name, args, n.line)
        if is_iface(obj.ty):
            req = self.mod.requirement(obj.ty[1:], name)
            if req is None:
                raise CompileError("the interface '" + obj.ty[1:] + "' has no method '" + name + "'", n.line)
            return self.call_function(req, self.dispatch(obj, name), obj, args, n.line)
        if is_class(obj.ty) and field_position(self.mod.find_class(obj.ty[1:], n.line), name) >= 0 and is_fn(self.field_type(obj, name, n.line)):
            fvt = self.field_type(obj, name, n.line)
            fv = self.tmp('fv')
            self.emit(f'{fv} = load ptr, ptr {self.field_addr(obj, name, n.line)}')
            self.release(obj)
            return self.call_value(ex(fv, fvt), args, n.line, "the function value '" + name + "'")
        if is_class(obj.ty):
            info = self.mod.find_method(obj.ty[1:], name, n.line)
            if info.is_private and self.owner != info.owner:
                raise CompileError(f"the method '{name}' is private to class '{info.owner}'\nonly its own methods can call it", n.line)
            return self.call_function(info, self.dispatch(obj, name), obj, args, n.line)
        raise CompileError(self.no_method(name, obj.ty), n.line)

    def list_len(self, lst: Ex) -> str:
        lenp = self.tmp('lenp')
        self.emit(f'{lenp} = getelementptr {{ i64, i64, i64, i64, ptr }}, ptr {lst.reg}, i32 0, i32 2')
        ln = self.tmp('len')
        self.emit(f'{ln} = load i64, ptr {lenp}')
        return ln

    def list_method(self, obj: Ex, name: str, args: list[Node], keywords: list[Val], line: int) -> Ex:
        # pop, insert, extend, sort and reverse change the list in place; items move without copying (the width is that of the list's storage)
        elem = elem_of(obj.ty)
        w = item_width(obj.ty)
        if len(keywords) > 0 and name != 'sort':
            raise CompileError(f"{name}() does not take keyword arguments", line)
        if name == 'pop':
            if len(args) > 1:
                raise CompileError('pop() takes at most 1 argument: pop() or pop(index)', line)
            idx = ''
            if len(args) == 1:
                li = self.want(self.expr(args[0]), 'int', line, 'the index given to pop()')
                idx = self.int_raw(li)
            empty = self.tmp('empty')
            self.emit(f'{empty} = icmp eq i64 {self.list_len(obj)}, 0')
            self.fail_if(empty, 'pop from an empty list')
            if len(args) == 0:
                idx = self.tmp('last')
                self.emit(f'{idx} = sub i64 {self.list_len(obj)}, 1')
            else:
                idx = self.norm_index(obj, idx)
            addr = self.list_slot(obj, ex(idx, 'int'))
            item = self.load_item(obj.ty, addr, 'popped')
            self.emit(f'call void @tomato_list_remove_at(ptr {obj.reg}, i64 {idx}, i64 {w})')
            self.release(obj)
            return ret_ex(item, elem)
        if name == 'insert':
            if len(args) != 2:
                raise CompileError('insert() takes an index and an item: insert(index, item)', line)
            li = self.want(self.expr(args[0]), 'int', line, 'the index given to insert()')
            raw = self.int_raw(li)
            v = self.expr(args[1], elem)
            v = self.want(v, elem, line, 'the inserted item')
            v = self.owned(v)
            # 0 up to the length is allowed (a negative index counts from the end); anything else is out of range
            idx = self.norm_index(obj, raw)
            bad = self.tmp('oob')
            self.emit(f'{bad} = icmp ugt i64 {idx}, {self.list_len(obj)}')
            self.fail_if(bad, 'index out of range')
            slot = self.tmp('slot')
            self.emit(f'{slot} = call ptr @tomato_list_insert_slot(ptr {obj.reg}, i64 {idx}, i64 {w})')
            self.store_item(obj.ty, v, slot)
            self.release(obj)
            return ex('', '')
        if name == 'extend':
            if len(args) != 1:
                raise CompileError('extend() takes one list: extend(other)', line)
            other = self.unwrap(self.expr(args[0], obj.ty), line)
            if other.ty != obj.ty:
                raise CompileError(f'extend() needs a list of the same type, {shown(obj.ty)}, but this is {shown(other.ty)}', line)
            self.emit(f'call void @tomato_list_extend(ptr {obj.reg}, ptr {other.reg}, i32 {list_flags(obj.ty)})')
            self.release(other)
            self.release(obj)
            return ex('', '')
        if name == 'reverse':
            if len(args) > 0:
                raise CompileError('reverse() takes no arguments', line)
            self.emit(f'call void @tomato_list_reverse(ptr {obj.reg}, i64 {w})')
            self.release(obj)
            return ex('', '')
        # sort: a sorted copy is made (as sorted() does) and its contents are swapped into the list
        if len(args) > 0:
            raise CompileError('sort() takes no positional arguments, only key= or cmp=', line)
        if len(keywords) > 1:
            raise CompileError('sort() takes key= or cmp=, not both', line)
        if not obj.reg.startswith('%bl.') and is_rc(obj.ty):
            self.emit(f'call void @tomato_retain(ptr {obj.reg})')       # the sorting code uses up its list; this one is kept
        copy = ex('', '')
        if len(keywords) == 1:
            kname = keywords[0].items[0].text
            if kname != 'key' and kname != 'cmp':
                raise CompileError(f"sort() has no parameter named '{kname}'\nit takes key= (a function giving what to sort by) or cmp= (a function comparing two items)", line)
            copy = self.sorted_keyed(obj, keywords, line)
        else:
            if not (elem == 'int' or elem == 'float' or elem == 'str'):
                raise CompileError(f'sort() needs a list of numbers or text, but this is {shown(obj.ty)}\nuse sort(key=...) or sort(cmp=...) for other items', line)
            kind = '0' if elem == 'int' else ('1' if elem == 'float' else '2')
            r = self.tmp('sorted')
            self.emit(f'{r} = call ptr @tomato_list_sorted(ptr {obj.reg}, i32 {kind})')
            copy = ex(r, obj.ty)
        self.emit(f'call void @tomato_list_swap(ptr {obj.reg}, ptr {copy.reg})')
        self.release(copy)
        self.release(obj)
        return ex('', '')

    def borrowable_receiver(self, ty: str, name: str) -> bool:
        # receivers whose method code only looks at them and releases them at the end: lists, sets, dicts, objects and interfaces
        t = strip_optional(ty)
        return is_list(t) or is_set(t) or is_dict(t) or is_class(t) or is_iface(t)

    def task_method(self, t: Ex, name: str, args: list[Node], line: int) -> Ex:
        # t.done() says whether the task has finished (in any way) and t.cancel() asks it to stop (D58d); neither waits
        if len(args) > 0:
            raise CompileError(f'a task method takes no arguments: t.{name}()', line)
        if name == 'cancel':
            self.emit(f'call void @tomato_task_cancel(ptr {t.reg})')
            self.release(t)
            return ex('', '')
        if name == 'done':
            st = self.tmp('status')
            self.emit(st + ' = load i64, ptr ' + self.frame_field(t.reg, 2, 'u64'))
            fin = self.tmp('finished')
            self.emit(f'{fin} = icmp ne i64 {st}, 0')
            w = self.tmp('flag')
            self.emit(f'{w} = zext i1 {fin} to i64')
            self.release(t)
            return ex(w, 'bool')
        raise CompileError(f"a task has no method '{name}'\nthe methods are done() and cancel()", line)

    def dict_method(self, d: Ex, name: str, args: list[Node], line: int) -> Ex:
        vt = dict_value(d.ty)
        if name == 'get':
            if len(args) != 1 and len(args) != 2:
                raise CompileError("get() takes a key and optionally a default value: get(key) or get(key, default)", line)
            if len(args) == 1 and not (vt == 'str' or is_list(vt) or is_dict(vt) or is_set(vt) or is_class(vt) or is_iface(vt)):
                raise CompileError(f"get(key) gives None for a missing key, but a value of type {shown(vt)} cannot be None\nwrite get(key, default), or check 'key in d' first", line)
            k = self.want(self.expr(args[0]), 'str', line, 'a dict key')
            if len(args) == 1:
                slot1 = self.tmp('slot')
                self.emit(f'{slot1} = call ptr @tomato_dict_find(ptr {d.reg}, i64 {self.key_word(k)})')
                gone = self.tmp('missing')
                self.emit(f'{gone} = icmp eq ptr {slot1}, null')
                hit1 = self.label('gothit')
                miss1 = self.label('gotmiss')
                join1 = self.label('gotjoin')
                self.cond_br(gone, miss1, hit1)
                self.place(hit1)
                found1 = self.tmp('val')
                self.emit(f'{found1} = load ptr, ptr {slot1}')
                self.retain(ex(found1, vt))
                self.br(join1)
                self.place(miss1)
                self.br(join1)
                self.place(join1)
                r1 = self.tmp('got')
                self.emit(f'{r1} = phi ptr [{found1}, %{hit1}], [null, %{miss1}]')
                self.release(k)
                self.release(d)
                return ret_ex(r1, vt + '?')
            fallback = self.owned(self.want(self.expr(args[1], vt), vt, line, 'the default of get'))
            slot = self.tmp('slot')
            self.emit(f'{slot} = call ptr @tomato_dict_find(ptr {d.reg}, i64 {self.key_word(k)})')
            missing = self.tmp('missing')
            self.emit(f'{missing} = icmp eq ptr {slot}, null')
            hit = self.label('gothit')
            miss = self.label('gotmiss')
            join = self.label('gotjoin')
            self.cond_br(missing, miss, hit)
            self.place(hit)
            found = self.tmp('val')
            self.emit(f'{found} = load {llvm_type(vt)}, ptr {slot}')
            got = ex(found, vt)
            self.retain(got)
            self.release(fallback)
            self.br(join)
            self.place(miss)
            self.br(join)
            self.place(join)
            r = self.tmp('got')
            self.emit(f'{r} = phi {llvm_type(vt)} [{got.reg}, %{hit}], [{fallback.reg}, %{miss}]')
            self.release(k)
            self.release(d)
            return ret_ex(r, vt)
        if name == 'remove':
            # d.remove(key) takes an entry out, releasing its value; the key must be there (check with 'key in d')
            if len(args) != 1:
                raise CompileError('remove() takes a key: remove(key)', line)
            k = self.want(self.expr(args[0]), 'str', line, 'a dict key')
            kw = self.key_word(k)
            slot = self.tmp('slot')
            self.emit(f'{slot} = call ptr @tomato_dict_find(ptr {d.reg}, i64 {kw})')
            missing = self.tmp('missing')
            self.emit(f'{missing} = icmp eq ptr {slot}, null')
            self.fail_if(missing, 'the key is not in the dict', [k, d])
            old = self.tmp('old')
            self.emit(f'{old} = load {llvm_type(vt)}, ptr {slot}')
            self.release(exf(old, vt))
            self.emit(f'call i32 @tomato_dict_delete(ptr {d.reg}, i64 {kw})')
            self.release(k)
            self.release(d)
            return ex('', '')
        if name not in ['keys', 'values', 'items']:
            raise CompileError(self.no_method(name, d.ty), line)
        if len(args) != 0:
            raise CompileError(f"'{name}' takes no arguments", line)
        if name == 'keys':
            r = self.tmp('keys')
            self.emit(r + ' = call ptr @tomato_dict_keys(ptr ' + d.reg + ', i64 ' + str(self.mod.code_of('list[str]')) + ', i64 8)')
            self.release(d)
            return ex(r, 'list[str]')
        if name == 'values':
            t = f'list[{vt}]'
            r = self.tmp('values')
            self.emit(f'{r} = call ptr @tomato_dict_values(ptr {d.reg}, i64 {self.mod.code_of(t)}, i64 {item_width(t)}, i32 {elem_rc(vt)})')
            self.release(d)
            return ex(r, t)
        if name == 'items':
            # each pair is a two-item tuple: a tuple has one item type, so it is str for a dict[str, str] and the union
            # of str and the value type otherwise (the unions are boxed)
            item = 'str'
            key_box = 0
            val_box = 0
            if vt != 'str':
                # a boxed value of kind 6 (a list, class, fixed-width int...) would print as <object>, so refuse it too
                if is_union(vt) or is_optional(vt) or box_kind(vt) == 6:
                    raise CompileError(f'items() is not available for a dict whose values are {shown(vt)}\nloop over the keys and index the dict instead', line)
                item = union_type(['str', vt])
                key_box = self.mod.code_of('box:str')
                val_box = self.mod.code_of(f'box:{vt}')
            t = f'list[tuple[{item}]]'
            r = self.tmp('items')
            self.emit(r + ' = call ptr @tomato_dict_items(ptr ' + d.reg + ', i64 ' + str(self.mod.code_of(t)) + ', i64 ' + str(self.mod.code_of('tuple[' + item + ']')) + ', i64 ' + str(key_box) + ', i64 ' + str(val_box) + ', i64 ' + str(box_kind(vt)) + ', i32 ' + elem_rc(vt) + ')')
            self.release(d)
            return ex(r, t)
        raise CompileError(self.no_method(name, d.ty), line)

    def set_method(self, st: Ex, name: str, args: list[Node], line: int) -> Ex:
        if (name == 'add' or name == 'remove') and len(args) == 1:
            v = self.expr(args[0], set_elem(st.ty))
            v = self.want(v, set_elem(st.ty), line, 'the set element')
            kw = self.key_word(v)
            if name == 'add':
                self.emit(f'call ptr @tomato_dict_insert(ptr {st.reg}, i64 {kw}, i32 0)')
            else:
                slot = self.tmp('slot')
                self.emit(f'{slot} = call ptr @tomato_dict_find(ptr {st.reg}, i64 {kw})')
                missing = self.tmp('missing')
                self.emit(f'{missing} = icmp eq ptr {slot}, null')
                self.fail_if(missing, 'the element is not there', [v, st])
                self.emit(f'call i32 @tomato_dict_delete(ptr {st.reg}, i64 {kw})')
            self.release(v)
            self.release(st)
            return ex('', '')
        raise CompileError(self.no_method(name, 'set'), line)

    def text_args(self, obj: Ex, name: str, args: list[Node], count: int, line: int) -> list[Ex]:
        if len(args) != count:
            raise CompileError("'" + name + "' takes " + plural(count, 'argument') + ', but ' + str(len(args)) + ' given', line)
        out: list[Ex] = []
        for a in args:
            v = self.expr(a)
            v = self.want(v, 'str', line, 'the argument of ' + name)
            out.append(v)
        return out

    def not_empty(self, v: Ex, name: str):
        n = self.tmp('alen')
        self.emit(f'{n} = call i64 @tomato_str_len(ptr {v.reg})')
        bad = self.tmp('empty')
        self.emit(f'{bad} = icmp eq i64 {n}, 0')
        self.fail_if(bad, 'an empty text cannot be used to ' + name)

    def builtin_call(self, name: str, values: list[Ex], line: int) -> Ex:
        # a call to a function written in std/builtin.tom, with arguments that are already computed
        return self.call_helper(self.mod.find(self.mod.resolve(name), line), values)

    def text_method(self, obj: Ex, name: str, args: list[Node], line: int) -> Ex:
        if (name == 'find' or name == 'rfind' or name == 'count') and (len(args) == 2 or len(args) == 3):
            # find(sub, start), find(sub, start, end), and the same for rfind and count
            a = self.text_args(obj, name, args[:1], 1, line)
            start = self.want(self.expr(args[1]), 'int', line, 'the start of ' + name)
            stop = '4611686018427387903'
            if len(args) == 3:
                stop = self.int_raw(self.want(self.expr(args[2]), 'int', line, 'the end of ' + name))
            mode = '0'
            if name == 'rfind':
                mode = '1'
            elif name == 'count':
                mode = '2'
            r = self.tmp('found')
            self.emit(f'{r} = call i64 @tomato_str_search(ptr {obj.reg}, ptr {a[0].reg}, i64 {self.int_raw(start)}, i64 {stop}, i32 {mode})')
            self.release(a[0])
            self.release(obj)
            return self.tag_small(r)
        if name == 'find' or name == 'rfind' or name == 'count' or name == 'startswith' or name == 'endswith':
            a = self.text_args(obj, name, args, 1, line)
            if name == 'find' or name == 'rfind' or name == 'count':
                r = self.tmp('found')
                self.emit(f'{r} = call i64 @tomato_str_{name}(ptr {obj.reg}, ptr {a[0].reg})')
                self.release(a[0])
                self.release(obj)
                return self.tag_small(r)
            c = self.tmp('c')
            self.emit(f'{c} = call i32 @tomato_str_{name}(ptr {obj.reg}, ptr {a[0].reg})')
            i1 = self.tmp('flag')
            self.emit(f'{i1} = icmp ne i32 {c}, 0')
            self.release(a[0])
            self.release(obj)
            return self.bool_of(i1)
        if name == 'replace':
            a = self.text_args(obj, name, args, 2, line)
            self.not_empty(a[0], 'replace')
            r = self.tmp('replaced')
            self.emit(f'{r} = call ptr @tomato_str_replace(ptr {obj.reg}, ptr {a[0].reg}, ptr {a[1].reg})')
            self.release(a[0])
            self.release(a[1])
            self.release(obj)
            return ex(r, 'str')
        if name == 'split':
            a = self.text_args(obj, name, args, 1, line)
            self.not_empty(a[0], 'split')
            r = self.tmp('pieces')
            self.emit(r + ' = call ptr @tomato_str_split(ptr ' + obj.reg + ', ptr ' + a[0].reg + ', i64 ' + str(self.mod.code_of('list[str]')) + ', i64 8)')
            self.release(a[0])
            self.release(obj)
            return ex(r, 'list[str]')
        if name == 'join':
            if len(args) != 1:
                raise CompileError("join() takes exactly one list[str]", line)
            lst = self.expr(args[0])
            lst = self.want(lst, 'list[str]', line, 'the argument of join')
            r = self.tmp('joined')
            self.emit(f'{r} = call ptr @tomato_str_join(ptr {obj.reg}, ptr {lst.reg})')
            self.release(lst)
            self.release(obj)
            return ex(r, 'str')
        if (name == 'upper' or name == 'lower' or name == 'strip') and len(args) == 0:
            r = self.tmp('changed')
            self.emit(f'{r} = call ptr @tomato_str_{name}(ptr {obj.reg})')
            self.release(obj)
            return ex(r, 'str')
        if name in ['strip', 'lstrip', 'rstrip'] and len(args) == 1:
            chars = self.want(self.expr(args[0]), 'str', line, 'the characters to strip')
            return self.builtin_call(f'_str_{name}_chars', [obj, chars], line)
        if name in ['isdigit', 'isalpha', 'isspace', 'lstrip', 'rstrip'] and len(args) == 0:
            # written in Tomato, in std/builtin.tom
            return self.builtin_call(f'_str_{name}', [obj], line)
        raise CompileError(self.no_method(name, 'str'), line)

    def file_method(self, f: Ex, name: str, args: list[Node], line: int) -> Ex:
        if name == 'read' and len(args) == 0:
            r = self.tmp('text')
            self.emit(f'{r} = call ptr @tomato_file_read(ptr {f.reg})')
            return ex(r, 'str')
        if name == 'write' and len(args) == 1:
            v = self.expr(args[0])
            v = self.want(v, 'str', line, 'the argument of write')
            self.emit(f'call void @tomato_file_write(ptr {f.reg}, ptr {v.reg})')
            self.release(v)
            return ex('', '')
        if name == 'close' and len(args) == 0:
            self.emit(f'call void @tomato_file_close(ptr {f.reg})')
            return ex('', '')
        raise CompileError(self.no_method(name, 'File'), line)

    def open_call(self, args: list[Node], line: int) -> Ex:
        if len(args) < 1 or len(args) > 2:
            raise CompileError('open() takes a path, and optionally a mode, both as text: open(path) or open(path, mode)', line)
        path = self.expr(args[0])
        path = self.want(path, 'str', line, 'the path')
        mode = ex(self.mod.intern('r'), 'str')
        if len(args) == 2:
            mode = self.expr(args[1])
            mode = self.want(mode, 'str', line, 'the mode')
        r = self.tmp('file')
        self.emit(f'{r} = call ptr @tomato_file_open(ptr {path.reg}, ptr {mode.reg})')
        bad = self.tmp('nofile')
        self.emit(f'{bad} = icmp eq ptr {r}, null')
        self.release(path)
        self.release(mode)
        self.fail_with(bad, 'IOError', 'a file could not be opened')
        return ex(r, 'File')

    def input_call(self, args: list[Node], line: int) -> Ex:
        raise CompileError("input() is async, so it must be awaited\nwrite: await input(prompt)  inside an async def", line)

    # ---- async: an async function runs as a frame (see FRAME_FIXED); await and yield are the places it can stop and go on later
    def frame_field(self, h: str, k: int, ty: str) -> str:
        # the address of fixed field k of the frame h. Every frame starts with the same fields, so this names them with a type of their own:
        # the object header, seven whole numbers, three pointers, then the result (the sizes of pointers differ between native and browser code).
        res = llvm_type(ty) if k == 12 and ty != '' else 'i64'
        p = self.tmp('ff')
        self.emit(f'{p} = getelementptr {{ i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, ptr, ptr, ptr, {res} }}, ptr {h}, i32 0, i32 {str(k + 2)}')
        return p

    def suspend_here(self):
        # stop this function; it goes on from the next line when something runs the frame again
        self.awaits += 1
        k = self.awaits
        self.emit(f'store i64 {k}, ptr %state.p')
        self.br('suspend')
        self.place(f'rs.{k}')
        self.check_cancel()

    def check_cancel(self):
        # a task cancelled with t.cancel() raises CancelledError here, at its next wait (D58d)
        c = self.tmp('cancel')
        self.emit(f'{c} = call i32 @tomato_task_cancelled(ptr %frame)')
        bad = self.tmp('wascancelled')
        self.emit(f'{bad} = icmp ne i32 {c}, 0')
        self.fail_with(bad, 'CancelledError', 'the task was cancelled')

    def need_async(self, what: str, line: int):
        if not self.is_async:
            raise CompileError(f"'{what}' can only be used inside an async function\nwrite async def instead of def", line)

    def check_unread(self):
        # raise here the error of a task this one started that failed and was dropped without being awaited (D58a)
        e = self.tmp('unread')
        self.emit(f'{e} = call ptr @tomato_pending_pop(ptr %frame, ptr @tomato_exc_line, ptr @tomato_exc_rt)')
        has = self.tmp('hasunread')
        self.emit(f'{has} = icmp ne ptr {e}, null')
        bad = self.label('unreaderror')
        ok = self.label('nounread')
        self.cond_br(has, bad, ok)
        self.place(bad)
        self.emit(f'store ptr {e}, ptr @tomato_exc')
        self.emit('store i32 1, ptr @tomato_exc_seen')
        self.br(self.unwind_target())
        self.place(ok)

    def await_handle(self, holder: str, result: str) -> Ex:
        # the task in the slot `holder` (owned): wait until it is done, then take its result, or raise its error
        chk = self.label('awaiting')
        wait = self.label('mustwait')
        take = self.label('finished')
        bad = self.label('taskfailed')
        good = self.label('taskdone')
        self.br(chk)
        self.place(chk)
        self.check_unread()
        h = self.tmp('task')
        self.emit(f'{h} = load ptr, ptr {holder}')
        st = self.tmp('status')
        self.emit(st + ' = load i64, ptr ' + self.frame_field(h, 2, 'u64'))
        done = self.tmp('isdone')
        self.emit(f'{done} = icmp ne i64 {st}, 0')
        self.cond_br(done, take, wait)
        self.place(wait)
        self.emit(f'call void @tomato_task_wait(ptr {h}, ptr %frame)')
        self.suspend_here()
        self.br(chk)
        self.place(take)
        failed = self.tmp('failed')
        self.emit(f'{failed} = icmp eq i64 {st}, 2')
        self.cond_br(failed, bad, good)
        self.place(bad)
        self.emit(f'call void @tomato.task.raise(ptr {h})')
        self.emit(f'call void @tomato_release(ptr {h})')
        self.emit(f'store ptr null, ptr {holder}')
        self.br(self.unwind_target())
        self.place(good)
        out = ex('', '')
        if result != '' and result != 'None':
            rp = self.frame_field(h, 12, result)
            r = self.tmp('result')
            self.emit(f'{r} = load {llvm_type(result)}, ptr {rp}')
            if is_rc(result):
                self.emit(f'store ptr null, ptr {rp}')
                out = ex(r, result)
            elif result == 'int':
                self.emit(f'store i64 0, ptr {rp}')         # the awaiting code owns the number now
                out = exf(r, result)
            else:
                out = ex(r, result)
        self.emit(f'call void @tomato_release(ptr {h})')
        self.emit(f'store ptr null, ptr {holder}')
        return out

    def await_expr(self, n: Node) -> Ex:
        self.need_async('await', n.line)
        inner = val_node(n.fields[0])
        if inner.kind == 'Call' and val_node(inner.fields[0]).kind == 'Name':
            name = val_node(inner.fields[0]).fields[0].text
            if name == 'input' and name not in self.slots and self.mod.resolve(name) == '':
                return self.await_input(val_nodes(inner.fields[1]), n.line)
            if name == 'sleep' and name not in self.slots and self.mod.resolve(name) == '':
                return self.await_sleep(val_nodes(inner.fields[1]), n.line)
            if name == '_http_wait' and name not in self.slots and self.mod.resolve(name) == '':
                return self.await_http(val_nodes(inner.fields[1]), n.line)
        self.async_ok = True
        self.fresh_frame = False
        t = self.expr(inner)
        self.async_ok = False
        if not is_task(t.ty):
            raise CompileError(f'only a task can be awaited, but this is {shown(t.ty)}\nawait an async function call such as await work(), or a task made with start', n.line)
        fresh = self.fresh_frame
        self.fresh_frame = False
        holder = self.hidden_rc_slot('await.task')
        self.store_owned(holder, t)
        if fresh:
            h0 = self.tmp('child')
            self.emit(f'{h0} = load ptr, ptr {holder}')
            self.emit('call void @tomato.sched.step(ptr ' + h0 + ')')      # a child runs at once, up to its first stop
        return self.await_handle(holder, task_result(t.ty))

    def await_sleep(self, args: list[Node], line: int) -> Ex:
        # await sleep(seconds): wait that long (D58c); other tasks run meanwhile
        if len(args) != 1:
            raise CompileError('sleep() takes the number of seconds to wait: await sleep(1.5)', line)
        v = self.expr(args[0])
        if not (v.ty == 'float' or is_numeric(v.ty)):
            raise CompileError(f'sleep() takes a number of seconds, but this is {shown(v.ty)}', line)
        secs = v.reg
        if v.ty != 'float':
            secs = self.to_double(v)
        self.check_unread()
        self.emit(f'call void @tomato_sleep_wait(ptr %frame, double {secs})')
        self.release(v)
        self.suspend_here()
        return ex('', '')

    def await_http(self, args: list[Node], line: int) -> Ex:
        # await _http_wait(handle): the library std/requests uses this to wait for a request; other tasks run meanwhile
        if len(args) != 1:
            raise CompileError('_http_wait() takes the request handle: await _http_wait(handle)', line)
        v = self.expr(args[0])
        v = self.want(v, 'int', line, 'the request handle')
        raw = self.int_raw(v)
        self.check_unread()
        self.emit(f'call void @tomato_http_wait(ptr %frame, i64 {raw})')
        self.release(v)
        self.suspend_here()
        return ex('', '')

    def await_input(self, args: list[Node], line: int) -> Ex:
        if len(args) > 1:
            raise CompileError('input() takes an optional prompt as text: await input() or await input(prompt)', line)
        prompt = ex(self.mod.intern(''), 'str')
        if len(args) == 1:
            prompt = self.expr(args[0])
            prompt = self.want(prompt, 'str', line, 'the prompt')
        self.check_unread()
        self.emit(f'call void @tomato_input_wait(ptr %frame, ptr {prompt.reg})')
        self.release(prompt)
        self.suspend_here()
        ip = self.frame_field('%frame', 9, 'str')
        r = self.tmp('line')
        self.emit(f'{r} = load ptr, ptr {ip}')
        self.emit(f'store ptr null, ptr {ip}')
        bad = self.tmp('noinput')
        self.emit(f'{bad} = icmp eq ptr {r}, null')
        self.fail_with(bad, 'EOFError', 'there is no more input to read')
        return ex(r, 'str')

    def start_expr(self, n: Node) -> Ex:
        self.need_async('start', n.line)
        inner = val_node(n.fields[0])
        if inner.kind != 'Call':
            raise CompileError("'start' needs a call of an async function, such as start work()", n.line)
        self.async_ok = True
        self.fresh_frame = False
        t = self.expr(inner)
        self.async_ok = False
        if not is_task(t.ty) or not self.fresh_frame:
            raise CompileError("'start' needs a call of an async function, such as start work()", n.line)
        self.fresh_frame = False
        self.launch(t)
        return t

    def launch(self, t: Ex):
        # the task t starts running when this one next waits
        self.emit('call void @tomato_retain(ptr %frame)')          # the starter gets the error if the task fails unread
        who = self.tmp('starter')
        self.emit(f'{who} = ptrtoint ptr %frame to i64')
        self.emit('store i64 ' + who + ', ptr ' + self.frame_field(t.reg, 7, 'u64'))
        self.emit('call void @tomato_q_push(ptr ' + t.reg + ')')      # the scheduler holds it too until it has run

    def async_for(self, s: Node):
        # async for x in task: each status the task yields, as it arrives; ends when the task is done
        self.need_async('async for', s.line)
        t = self.expr(val_node(s.fields[1]))
        if is_class(t.ty):
            it = self.mod.find_op(t.ty[1:], 'iter')
            if it is not None and it.is_async:        # an object whose @iter is async: its task is made and started here
                self.async_ok = True
                self.fresh_frame = False
                t = self.call_function(it, self.dispatch(t, it.name), t, [], s.line)
                self.async_ok = False
                self.fresh_frame = False
                self.launch(t)
        if not is_task(t.ty) or task_status(t.ty) == '':
            raise CompileError(f'async for needs a task that yields statuses, but this is {shown(t.ty)}\nthe async function must say what it yields: async def work() -> int yields str:', s.line)
        elem = task_status(t.ty)
        holder = self.hidden_rc_slot('asyncfor.task')
        self.store_owned(holder, t)
        var = self.slot(s.fields[0].text, elem, s.line)
        head = self.label('statuses')
        have = self.label('havestatus')
        nomore = self.label('nostatus')
        wait = self.label('waitstatus')
        end = self.label('endstatuses')
        self.br(head)
        self.place(head)
        self.check_unread()
        h = self.tmp('task')
        self.emit(f'{h} = load ptr, ptr {holder}')
        q = self.tmp('queue')
        self.emit(q + ' = load ptr, ptr ' + self.frame_field(h, 11, 'str'))
        curp = self.frame_field(h, 6, 'u64')
        cur = self.tmp('read')
        self.emit(f'{cur} = load i64, ptr {curp}')
        lenp = self.tmp('lenp')
        self.emit(f'{lenp} = getelementptr {{ i64, i64, i64, i64, ptr }}, ptr {q}, i32 0, i32 2')
        ln = self.tmp('len')
        self.emit(f'{ln} = load i64, ptr {lenp}')
        more = self.tmp('more')
        self.emit(f'{more} = icmp slt i64 {cur}, {ln}')
        self.cond_br(more, have, nomore)
        self.place(have)
        addr = self.list_slot(ex(q, 'list[' + elem + ']'), ex(cur, 'int'))
        item = self.load_item('list[' + elem + ']', addr, 'status')
        e = ex(item, elem)
        self.retain(e)
        self.store_owned(var, e)
        nxt = self.tmp('next')
        self.emit(f'{nxt} = add i64 {cur}, 1')
        self.emit(f'store i64 {nxt}, ptr {curp}')
        self.push_loop(end, head)
        self.block(val_nodes(s.fields[2]))
        self.loop_depth = self.loop_depth - 1
        if not self.terminated:
            self.br(head)
        self.place(nomore)
        st = self.tmp('status')
        self.emit(st + ' = load i64, ptr ' + self.frame_field(h, 2, 'u64'))
        fin = self.tmp('isdone')
        self.emit(f'{fin} = icmp ne i64 {st}, 0')
        self.cond_br(fin, end, wait)
        self.place(wait)
        self.emit(f'call void @tomato_task_wait(ptr {h}, ptr %frame)')
        self.suspend_here()
        self.br(head)
        self.place(end)
        o = self.tmp('drop')
        self.emit(f'{o} = load ptr, ptr {holder}')
        self.emit(f'call void @tomato_release(ptr {o})')
        self.emit(f'store ptr null, ptr {holder}')

    def async_yield(self, s: Node):
        # yield value in an async function: a status for whoever reads the task; then other tasks get a turn
        if self.ret_yields == '':
            raise CompileError("this async function does not say what it yields\nwrite it after the return type: async def work() -> int yields str:", s.line)
        v = self.expr(val_node(s.fields[0]), self.ret_yields)
        self.check_unread()
        v = self.want(v, self.ret_yields, s.line, 'the yielded status')
        v = self.owned(v)
        q = self.tmp('queue')
        self.emit(q + ' = load ptr, ptr ' + self.frame_field('%frame', 11, 'str'))
        self.push_item(q, 'list[' + v.ty + ']', v)
        self.emit('call void @tomato_wake_waiters(ptr %frame)')
        self.emit('call void @tomato_q_push(ptr %frame)')
        self.suspend_here()

    # An await can stop the function, and everything it was in the middle of computing would be lost, so every await is
    # first moved out of its expression into a statement of its own (x = await f()) whose only unfinished state is in variables.
    def lift(self, e: Node, out: list[Node], top: bool) -> Node:
        if e.kind == 'Await':
            inner = self.lift(val_node(e.fields[0]), out, False)
            copy = Node()
            copy.kind = 'Await'
            copy.line = e.line
            copy.fields = [vn(inner)]
            if top:
                return copy
            self.lifted += 1
            name = f'_await{self.lifted}'
            target = Node()
            target.kind = 'Name'
            target.line = e.line
            target.fields = [text_val(name)]
            asg = Node()
            asg.kind = 'Assign'
            asg.line = e.line
            asg.fields = [vn(target), vn(copy)]
            out.append(asg)
            use = Node()
            use.kind = 'Name'
            use.line = e.line
            use.fields = [text_val(name)]
            return use
        if e.kind == 'Start':
            return e
        if e.kind == 'BinOp' and (e.fields[0].text == 'and' or e.fields[0].text == 'or') and contains_await(val_node(e.fields[2])):
            return self.lift_short_circuit(e, out)
        if e.kind == 'Cond' and (contains_await(val_node(e.fields[1])) or contains_await(val_node(e.fields[2]))):
            raise CompileError("an await cannot be in either value of a conditional expression\nuse an if statement and await inside it", e.line)
        copy2 = Node()
        copy2.kind = e.kind
        copy2.line = e.line
        copy2.exported = e.exported
        nf: list[Val] = []
        k = 0
        for f in e.fields:
            nf.append(self.lift_val(f, out))
            k += 1
        copy2.fields = nf
        return copy2

    def lift_short_circuit(self, e: Node, out: list[Node]) -> Node:
        # a and await b()  becomes  _await = a; if _await: (the await) _await = b; so the right side runs only when it is needed.
        # For or the test is not _await.
        self.lifted += 1
        name = f'_await{self.lifted}'
        left = self.lift(val_node(e.fields[1]), out, False)
        out.append(mk('Assign', e.line, [vn(mk('Name', e.line, [vs(name)])), vn(left)]))
        test = mk('Name', e.line, [vs(name)])
        if e.fields[0].text == 'or':
            test = mk('UnOp', e.line, [vs('not'), vn(test)])
        body: list[Node] = []
        right = self.lift(val_node(e.fields[2]), body, False)
        body.append(mk('Assign', e.line, [vn(mk('Name', e.line, [vs(name)])), vn(right)]))
        out.append(mk('If', e.line, [vlist([vtuple([vn(test), vnodes(body)])]), vz()]))
        return mk('Name', e.line, [vs(name)])

    def lift_val(self, v: Val, out: list[Node]) -> Val:
        if v.tag == 'n':
            return vn(self.lift(val_node(v), out, False))
        if v.tag == 'l' or v.tag == 't':
            copy = Val()
            copy.tag = v.tag
            ni: list[Val] = []
            for item in v.items:
                ni.append(self.lift_val(item, out))
            copy.items = ni
            return copy
        return v

    def hoist(self, s: Node) -> list[Node]:
        # the statements that run in place of s: its awaits as statements of their own, then s without them
        out: list[Node] = []
        k = s.kind
        if k == 'Assign' or k == 'Return' or k == 'ExprStmt' or k == 'Declare' or k == 'Raise' or k == 'Yield':
            copy = Node()
            copy.kind = k
            copy.line = s.line
            cf: list[Val] = []
            j = 0
            for f in s.fields:
                is_top = False
                if f.tag == 'n':
                    child = val_node(f)
                    is_top = child.kind == 'Await' and ((k == 'Assign' and j == 1) or (k == 'Declare' and j == 2) or k == 'Return' or k == 'ExprStmt')
                    cf.append(vn(self.lift(child, out, is_top)))
                else:
                    cf.append(f)
                j += 1
            copy.fields = cf
            out.append(copy)
            return out
        if k == 'If':
            branches = s.fields[0].items
            first = branches[0].items
            later = len(branches)          # the first elif whose condition has an await: it and what follows move into the else branch
            for b in range(1, len(branches)):
                if later == len(branches) and contains_await(val_node(branches[b].items[0])):
                    later = b
            cond = self.lift(val_node(first[0]), out, False)
            copy3 = Node()
            copy3.kind = 'If'
            copy3.line = s.line
            nb = Val()
            nb.tag = 'l'
            head = Val()
            head.tag = 't'
            head.items = [vn(cond), first[1]]
            bl: list[Val] = [head]
            for b in range(1, later):
                bl.append(branches[b])
            nb.items = bl
            orelse = s.fields[1]
            if later < len(branches):
                rest = Node()
                rest.kind = 'If'
                rest.line = s.line
                rest.fields = [vlist(branches[later:]), s.fields[1]]
                orelse = vnodes(self.hoist(rest))
            copy3.fields = [nb, orelse]
            out.append(copy3)
            return out
        if k == 'For' or k == 'AsyncFor':
            it = self.lift(val_node(s.fields[1]), out, False)
            copy4 = Node()
            copy4.kind = k
            copy4.line = s.line
            copy4.fields = [s.fields[0], vn(it), s.fields[2]]
            out.append(copy4)
            return out
        if k == 'While' and contains_await(val_node(s.fields[0])):
            # while await more(): body  becomes  while True: (the await, then: if not condition: break), body
            body: list[Node] = []
            cond2 = self.lift(val_node(s.fields[0]), body, False)
            body.append(mk('If', s.line, [vlist([vtuple([vn(mk('UnOp', s.line, [vs('not'), vn(cond2)])), vnodes([mk('Break', s.line, [])])])]), vz()]))
            for st in s.fields[1].items:
                body.append(val_node(st))
            out.append(mk('While', s.line, [vn(mk('BoolLit', s.line, [vb(True)])), vnodes(body)]))
            return out
        out.append(s)
        return out

    def ret_llvm(self, info: FuncInfo) -> str:
        if info.ret == '':
            return 'void'
        return llvm_type(info.ret)

    def len_call(self, args: list[Node], line: int) -> Ex:
        if len(args) != 1:
            raise CompileError('len() takes exactly one argument', line)
        if args[0].kind == 'Name' and args[0].fields[0].text in self.slots and not is_dyn(self.types[args[0].fields[0].text]):
            v = self.expr_b(args[0], [])
        else:
            v = self.expr(args[0])
        if is_dyn(v.ty):
            return self.len_dyn(v, line)
        if is_union(v.ty):
            return self.union_len(v, line)
        return self.len_of(v, line)

    # len() of a value of a Sized type: ask whichever kind of value the box holds, and keep the answer in a slot
    def len_dyn(self, box: Ex, line: int) -> Ex:
        if not dyn_sized(box.ty):
            raise CompileError(f'len() needs a value with a length, but this is {shown(box.ty)}\nuse Sized, or Iterable[T] & Sized', line)
        holder = self.hidden_rc_slot('len.dyn')
        self.store_owned(holder, box)
        answer = self.hidden_slot('len.answer')
        join = self.label('endlen')
        for member in self.mod.dyn_members(box.ty):
            held = self.tmp('held')
            self.emit(f'{held} = load ptr, ptr {holder}')
            yes = self.label('lenis')
            no = self.label('lennot')
            self.cond_br(self.box_is(ex(held, box.ty), member), yes, no)
            self.place(yes)
            inner = self.unbox_value(ex(held, box.ty), member)
            n = self.len_of(inner, line)
            self.emit(f'store i64 {n.reg}, ptr {answer}')
            self.br(join)
            self.place(no)
        self.br(join)
        self.place(join)
        r = self.tmp('answer')
        self.emit(f'{r} = load i64, ptr {answer}')
        return ex(r, 'int')

    def union_len(self, v: Ex, line: int) -> Ex:
        # len() of a union: the length of whichever member it holds (every member must have one)
        for m in union_members(v.ty):
            if not (is_list(m) or is_dict(m) or is_set(m) or m == 'str' or (is_class(m) and self.mod.has_op(m[1:], 'len'))):
                raise CompileError(f'len() needs every member of {shown(v.ty)} to have a length, but {shown(m)} does not', line)
        result = self.hidden_slot('len.of')
        end = self.label('endlen')
        members = union_members(v.ty)
        then = ''
        nxt = ''
        for k, m in enumerate(members):
            if k < len(members) - 1:
                then = self.label('lenthen')
                nxt = self.label('lennext')
                self.cond_br(self.box_is(v, m), then, nxt)
                self.place(then)
            n = self.len_of(self.unbox_value(v, m), line)
            self.emit(f'store i64 {n.reg}, ptr {result}')
            self.br(end)
            if k < len(members) - 1:
                self.place(nxt)
        self.place(end)
        self.release(v)
        r = self.tmp('len')
        self.emit(f'{r} = load i64, ptr {result}')
        return ex(r, 'int')

    def len_of(self, v: Ex, line: int) -> Ex:
        if is_class(v.ty):
            f = self.mod.find_op(v.ty[1:], 'len')
            if f is None or len(f.ptypes) != 0 or f.ret != 'int':
                raise CompileError("'" + v.ty[1:] + "' objects have no length\nadd a method marked @len that takes no argument and returns int", line)
            return self.marker_call(v, f, [], line)
        r = self.tmp('len')
        if is_list(v.ty) or is_dict(v.ty) or is_set(v.ty):
            lenp = self.tmp('lenp')
            self.emit(f'{lenp} = getelementptr {{ i64, i64, i64, i64, ptr }}, ptr {v.reg}, i32 0, i32 2')
            self.emit(f'{r} = load i64, ptr {lenp}')
        else:
            v = self.want(v, 'str', line, 'the argument of len')
            self.emit(f'{r} = call i64 @tomato_str_len(ptr {v.reg})')
        self.release(v)
        return self.tag_small(r)

    def class_text(self, v: Ex, line: int) -> Ex:
        # print and str() of an object whose class has a method marked @str: that method's text (P65)
        found = self.mod.find_op(v.ty[1:], 'str')
        if found is None:
            raise CompileError("'" + v.ty[1:] + "' objects cannot be printed or converted to text\nadd a method marked @str that returns text", line)
        info = found
        if len(info.ptypes) != 0 or info.ret != 'str':
            raise CompileError(f"the @str method '{info.name}' must take no argument besides self and return str", line)
        r = self.tmp('shown')
        self.emit(f'{r} = call ptr {self.dispatch(v, info.name)}(ptr {v.reg})')
        self.check_error([v])
        return ex(r, 'str')

    def show_text(self, v: Ex, line: int) -> Ex:
        # a list, tuple, set or dict as text, the way Python shows it: [1, 'a'] (the argument is released)
        info = self.mod.helper('show', v.ty, line)
        r = self.tmp('shown')
        self.emit(f'{r} = call ptr {function_symbol(self.mod, info)}(ptr {v.reg})')
        self.check_error([v])
        self.release(v)
        return ex(r, 'str')

    def str_call(self, args: list[Node], line: int) -> Ex:
        if len(args) != 1:
            raise CompileError('str() takes exactly one argument', line)
        v = self.expr(args[0])
        if v.ty == 'str':
            return v
        if is_fn(v.ty):
            raise CompileError(f'a function value ({shown(v.ty)}) cannot be converted to text\ncall it and use the result', line)
        if is_dyn(v.ty):
            raise CompileError(f'a value of type {shown(v.ty)} cannot be converted to text\nloop over it and print the items instead', line)
        if is_class(v.ty):
            shown_text = self.class_text(v, line)
            self.release(v)
            return shown_text
        if is_list(v.ty) or is_dict(v.ty) or is_set(v.ty):
            return self.show_text(v, line)
        r = self.tmp('text')
        if v.ty == 'int':
            self.emit(f'{r} = call ptr @tomato_int_str(i64 {v.reg})')
            self.release(v)
        elif is_numeric(v.ty):
            if is_signed(v.ty):
                self.emit(f'{r} = call ptr @tomato_str_from_i64(i64 {self.widen(v, 64)})')
            else:
                self.emit(f'{r} = call ptr @tomato_str_from_u64(i64 {self.widen(v, 64)})')
        elif is_union(v.ty):
            self.emit(f'{r} = call ptr @tomato_box_str(ptr {v.reg})')
            self.release(v)
        elif v.ty == 'float':
            self.emit(f'{r} = call ptr @tomato_str_from_f64(double {v.reg})')
        else:
            w = self.tmp('w')
            self.emit(f'{w} = trunc i64 {v.reg} to i32')
            self.emit(f'{r} = call ptr @tomato_str_from_bool(i32 {w})')
        return ex(r, 'str')

    def print_call(self, args: list[Node]):
        values: list[Ex] = []
        for a in args:
            v = self.expr(a)                   # every argument is evaluated before anything is printed
            if is_fn(v.ty):
                raise CompileError(f'a function value ({shown(v.ty)}) cannot be printed\ncall it and print the result', self.line)
            if is_dyn(v.ty):
                raise CompileError(f'a value of type {shown(v.ty)} cannot be printed\nloop over it and print the items instead', self.line)
            values.append(v)
        for k, v in enumerate(values):
            if v.ty == 'int':
                t = self.tmp('text')
                self.emit(f'{t} = call ptr @tomato_int_str(i64 {v.reg})')
                self.release(v)
                self.emit(f'call void @tomato_print_strobj(ptr {t})')
                self.emit(f'call void @tomato_release(ptr {t})')
            elif is_numeric(v.ty):
                wide = self.widen(v, 64)
                fmt = '@.fmt.uint' if not is_signed(v.ty) else '@.fmt.int'
                self.emit(f'call i32 (ptr, ...) @printf(ptr {fmt}, i64 {wide})')
            elif v.ty == 'bool':
                w = self.tmp('w')
                self.emit(f'{w} = trunc i64 {v.reg} to i32')
                t = self.tmp('text')
                self.emit(f'{t} = call ptr @tomato_str_from_bool(i32 {w})')
                self.emit(f'call void @tomato_print_strobj(ptr {t})')
                self.emit(f'call void @tomato_release(ptr {t})')
            elif v.ty == 'float':
                t = self.tmp('text')
                self.emit(f'{t} = call ptr @tomato_str_from_f64(double {v.reg})')
                self.emit(f'call void @tomato_print_strobj(ptr {t})')
                self.emit(f'call void @tomato_release(ptr {t})')
            elif is_list(v.ty) or is_dict(v.ty) or is_set(v.ty):
                shown_list = self.show_text(v, self.line)
                self.emit(f'call void @tomato_print_strobj(ptr {shown_list.reg})')
                self.emit(f'call void @tomato_release(ptr {shown_list.reg})')
            elif is_class(v.ty):
                t = self.tmp('text')
                shown_text = self.class_text(v, self.line)
                self.emit(f'call void @tomato_print_strobj(ptr {shown_text.reg})')
                self.emit(f'call void @tomato_release(ptr {shown_text.reg})')
                self.release(v)
            elif is_union(v.ty):
                t = self.tmp('text')
                self.emit(f'{t} = call ptr @tomato_box_str(ptr {v.reg})')
                self.emit(f'call void @tomato_print_strobj(ptr {t})')
                self.emit(f'call void @tomato_release(ptr {t})')
                self.release(v)
            else:
                self.emit(f'call void @tomato_print_strobj(ptr {v.reg})')
                self.release(v)
            if k < len(values) - 1:
                self.emit('call i32 @putchar(i32 32)')
        self.emit('call i32 @putchar(i32 10)')

    # ---- statements
    def block(self, body: list[Node]):
        depth = len(self.after)
        for s in body:
            self.stmt(s)
        self.end_block_narrowing(depth)

    def push_loop(self, brk: str, cont: str):
        if self.loop_depth < len(self.breaks):
            self.breaks[self.loop_depth] = brk
            self.conts[self.loop_depth] = cont
        else:
            self.breaks.append(brk)
            self.conts.append(cont)
        self.loop_depth += 1

    def visible_names(self) -> list[str]:
        # the names a program could have meant: variables, functions, classes and the built-ins
        out: list[str] = [name for name in self.slots]
        for seen in self.mod.scope:
            if seen.module == self.mod.cur or seen.module == 'builtin':
                out.append(seen.name)
        for b in ['print', 'len', 'str', 'int', 'float', 'open', 'input', 'sleep', 'clock', 'range']:
            out.append(b)
        return out

    def name_hint(self, name: str) -> str:
        if self.mod.resolve(name) != '':
            return f"\n'{name}' is a function or class, not a variable; call it, such as {name}()"
        near = closest(name, self.visible_names())
        if near != '':
            return f"\ndid you mean '{near}'?"
        return ''

    def unknown_function(self, name: str) -> str:
        if name in self.slots:
            return f"'{name}' is a variable, not a function, so it cannot be called"
        if name in ['reduce']:
            return f"'{name}' is not available\nuse a for loop instead"
        if name in ['round', 'pow', 'divmod', 'any', 'all', 'input', 'list', 'dict', 'set', 'tuple', 'bool', 'type', 'isinstance', 'hash', 'format']:
            return f"'{name}' is not built in"
        near = closest(name, self.visible_names())
        if near != '':
            return f"the function '{name}' is not defined\ndid you mean '{near}'?"
        return f"the function '{name}' is not defined\ncheck its spelling, or import it with 'from module import {name}'"

    def no_method(self, name: str, ty: str) -> str:
        known: list[str] = []
        word = shown(ty)
        if ty == 'str':
            known = ['find', 'rfind', 'count', 'startswith', 'endswith', 'replace', 'split', 'join', 'upper', 'lower', 'strip', 'lstrip', 'rstrip', 'isdigit', 'isalpha', 'isspace']
            word = 'text'
        elif is_dict(ty):
            known = ['get', 'remove', 'keys', 'values', 'items']
            word = 'a dict'
        elif is_set(ty) or ty == 'set':
            known = ['add', 'remove', 'discard']
        elif ty == 'File':
            known = ['read', 'write', 'close']
            word = 'a file'
        elif is_list(ty):
            known = ['append', 'pop', 'insert', 'extend', 'sort', 'reverse']
        near = closest(name, known)
        text = f"{word} has no method '{name}'"
        if near != '':
            return f"{text}\ndid you mean '{near}'?"
        if len(known) > 0:
            return text + '\nthe methods it has are: ' + ', '.join(known)
        return text

    def stmt(self, s: Node):
        if self.is_async:
            for p in self.hoist(s):
                self.stmt_now(p)
            return
        self.stmt_now(s)

    def stmt_now(self, s: Node):
        self.line = s.line
        if s.mark > 0 and self.mark_prefix != '':
            lbl = f'{self.mark_prefix}_{s.mark}'
            self.br(lbl)
            self.place(lbl)
        k = s.kind
        if k == 'ExprStmt':
            e = val_node(s.fields[0])
            if e.kind != 'Call':
                shown_value = self.expr(e)
                self.release(shown_value)
                return
            result = self.call(e, True)
            self.release(result)               # a value nobody keeps is released at once
        elif k == 'Assign':
            target = val_node(s.fields[0])
            if target.kind == 'Index':
                self.assign_item(s, target)
                return
            if target.kind == 'Attr':
                self.assign_field(s, target)
                return
            if target.kind != 'Name':
                raise CompileError('cannot assign to this expression\nthe left side of = must be a variable, a field or an item', s.line)
            name = target.fields[0].text
            if name in self.settled:
                raise CompileError(f"'{name}' is known to be {shown(self.types[name])} after the check above, so it cannot be assigned here\nassign to it before the check", s.line)
            if name in self.narrowed:
                raise CompileError(f"'{name}' is known to be {shown(self.types[name])} inside this check, so it cannot be assigned here\nassign to it outside the check", s.line)
            expected = self.types[name] if name in self.slots else ''
            if name in self.slots and self.types[name] == 'int' and self_update(name, val_node(s.fields[1])):
                self.take_name = name
                self.taken = ex('', '')
            v = self.expr(val_node(s.fields[1]), expected)
            self.take_name = ''
            if self.taken.reg != '' and not self.taken.fresh and v.ty == 'int' and v.fresh:
                # the operation used the old number up (freeing it if it was big), so the slot takes the result and frees nothing
                self.taken = ex('', '')
                var = self.slot(name, 'int', s.line)
                self.emit(f'store i64 {v.reg}, ptr {var}')
                return
            self.taken = ex('', '')
            slot_type = v.ty
            if name in self.slots:
                v = self.want(v, self.types[name], s.line, 'the assigned value')
                slot_type = self.types[name]
            if slot_type == 'None' or slot_type == '':
                raise CompileError(f"the type of '{name}' cannot be guessed from None\ndeclare it, such as: {name}: Item | None = None", s.line)
            self.store_owned(self.slot(name, slot_type, s.line), v)
        elif k == 'Multi':
            self.block(val_nodes(s.fields[0]))
        elif k == 'Declare':
            ty = self.mod.type_name(s.fields[1])
            if ty == '':
                raise CompileError('this variable cannot be given a type automatically\nwrite its type, such as: name: Type = value', s.line)
            v = self.expr(val_node(s.fields[2]), ty)
            v = self.want(v, ty, s.line, 'the value')
            self.store_owned(self.slot(s.fields[0].text, ty, s.line), v)
        elif k == 'AsyncFor':
            self.async_for(s)
        elif k == 'Yield' and self.is_async:
            self.async_yield(s)
        elif k == 'Yield':
            self.yield_stmt(s)
        elif k == 'Return' and self.gen_n > 0:
            if s.fields[0].tag != 'z':
                raise CompileError("a generator cannot return a value\nuse yield to give out values", s.line)
            self.br(self.gens[self.gen_n - 1].end)
        elif k == 'Return':
            if s.fields[0].tag == 'z':
                if self.ret != '':
                    raise CompileError(f'this function must return a value of type {shown(self.ret)}\nwrite: return <value>', s.line)
            else:
                if self.ret == '':
                    raise CompileError('this function is declared to return nothing, so it cannot return a value\nremove the value, or add -> Type to the def', s.line)
                v = self.expr(val_node(s.fields[0]), self.ret)
                v = self.want(v, self.ret, s.line, 'the returned value')
                v = self.owned(v)
                self.emit(f'store {llvm_type(v.ty)} {v.reg}, ptr %retval')
            self.run_finallies(self.try_depth)
            self.br('epilogue')
        elif k == 'Raise':
            v = self.expr(val_node(s.fields[0]))
            if not self.mod.subclass(v.ty, '@Error'):
                raise CompileError(f'raise needs an error object, but this is {shown(v.ty)}\nwrite raise Error("message") or raise one of your Error subclasses', s.line)
            self.emit('store ptr ' + v.reg + ', ptr @tomato_exc')            # the pending error owns the reference
            self.emit(f'store i32 {s.line}, ptr @tomato_exc_line')
            self.trace(True)
            self.emit('store i32 0, ptr @tomato_exc_rt')
            self.emit('store i32 1, ptr @tomato_exc_seen')
            self.br(self.unwind_target())
        elif k == 'Try':
            self.try_stmt(s)
        elif k == 'If':
            self.if_stmt(s)
        elif k == 'While':
            self.while_stmt(s)
        elif k == 'For':
            self.for_stmt(s)
        elif k == 'Break':
            if self.loop_depth == 0:
                raise CompileError("'break' can only be used inside a loop", s.line)
            self.run_finallies(self.tries_in_loop())
            self.br(self.breaks[self.loop_depth - 1])
        elif k == 'Continue':
            if self.loop_depth == 0:
                raise CompileError("'continue' can only be used inside a loop", s.line)
            self.run_finallies(self.tries_in_loop())
            self.br(self.conts[self.loop_depth - 1])
        elif k == 'CompAppend':
            self.comp_append(s)
        elif k == 'Pass':
            pass
        else:
            raise CompileError(f'this kind of statement ({k}) is not supported here', s.line)

    def tries_in_loop(self) -> int:
        # how many of the innermost try statements sit inside the current loop
        n = 0
        k = self.try_depth
        while k > 0 and self.tries[k - 1].loop_depth == self.loop_depth:
            n += 1
            k -= 1
        return n

    def run_finallies(self, n: int):
        # run the finally blocks of the n innermost try statements, innermost first: a return, break or continue is
        # leaving them. A raise inside one of these blocks goes to the handlers outside its try (D22a).
        saved = self.try_depth
        for k in range(saved - 1, saved - n - 1, -1):
            if self.tries[k].has_final:
                self.try_depth = k
                self.block(self.tries[k].final)
        self.try_depth = saved

    def push_try(self, info: TryInfo):
        if self.try_depth < len(self.tries):
            self.tries[self.try_depth] = info
        else:
            self.tries.append(info)
        self.try_depth += 1

    def try_stmt(self, s: Node):
        handlers = s.fields[1].items
        for h in handlers:
            written = h.items[0].text
            ckey = self.mod.resolve(written)
            if ckey == '' or not self.mod.has_class(ckey) or not self.mod.subclass('@' + ckey, '@Error'):
                raise CompileError(f"'catch' needs an error class, but '{written}' is not one\nuse Error, RuntimeError, IOError or a class that extends Error", s.line)
        info = TryInfo()
        info.catch_l = self.label('catch')
        info.prop_l = self.label('prop')
        info.has_final = s.fields[3].tag == 'l'
        if info.has_final:
            info.final = val_nodes(s.fields[3])
        info.loop_depth = self.loop_depth
        else_l = self.label('tryelse')
        handled_l = self.label('tryhandled')
        end_l = self.label('tryend')
        self.push_try(info)
        self.block(val_nodes(s.fields[0]))
        if not self.terminated:
            self.br(else_l)
        # an error raised in the body arrives here with the pending error set
        self.place(info.catch_l)
        info.state = 'post'
        pending = self.tmp('ex')
        self.emit(f'{pending} = load ptr, ptr @tomato_exc')
        tp = self.tmp('tp')
        self.emit(f'{tp} = getelementptr {{ i64, i64 }}, ptr {pending}, i32 0, i32 1')
        raw = self.tmp('rawcode')
        self.emit(f'{raw} = load i64, ptr {tp}')
        code = self.tmp('code')
        self.emit(f'{code} = and i64 {raw}, 4294967295')
        for h in handlers:
            cname = self.mod.resolve(h.items[0].text)
            isa = self.tmp('isa')
            self.emit(isa + ' = call i32 @tomato_is_subclass(i64 ' + code + ', i64 ' + str(self.mod.code_of('@' + cname)) + ')')
            hit = self.tmp('hit')
            self.emit(f'{hit} = icmp ne i32 {isa}, 0')
            match = self.label('match')
            nxt = self.label('nomatch')
            self.cond_br(hit, match, nxt)
            self.place(match)
            self.emit('store ptr null, ptr @tomato_exc')             # handled: the catch variable takes the reference
            if self.mod.mode == 1:
                self.emit('call void @tomato_trace_clear()')
            if h.items[1].tag == 's':
                var = h.items[1].text
                reg = ''
                if var in self.slots and self.types[var] != '@' + cname:
                    reg = self.new_slot(var, '@' + cname)     # the name is bound again, to a new slot of the new type
                else:
                    reg = self.slot(var, '@' + cname, s.line)
                self.store_owned(reg, ex(pending, '@' + cname))
            else:
                self.emit(f'call void @tomato_release(ptr {pending})')
            self.block(val_nodes(h.items[2]))
            if not self.terminated:
                self.br(handled_l)
            self.place(nxt)
        self.br(info.prop_l)                                          # no clause matched: keep propagating
        self.place(else_l)
        if s.fields[2].tag == 'l':
            self.block(val_nodes(s.fields[2]))
        if not self.terminated:
            self.br(handled_l)
        # every normal way out of the statement runs the finally block once
        self.place(handled_l)
        self.try_depth -= 1
        if info.has_final:
            self.block(info.final)
        if not self.terminated:
            self.br(end_l)
        # an error is leaving the statement: park it while the finally block runs, then keep propagating
        self.place(info.prop_l)
        if info.has_final:
            hold = self.tmp('hold')
            self.make_slot(hold, 'File')
            held = self.tmp('pending')
            self.emit(f'{held} = load ptr, ptr @tomato_exc')
            self.emit(f'store ptr {held}, ptr {hold}')
            self.emit('store ptr null, ptr @tomato_exc')
            self.block(info.final)
            back = self.tmp('back')
            self.emit(f'{back} = load ptr, ptr {hold}')
            self.emit(f'store ptr {back}, ptr @tomato_exc')
        self.br(self.unwind_target())
        self.place(end_l)

    def assign_item(self, s: Node, target: Node):
        lst = self.unwrap(self.expr_b(val_node(target.fields[0]), [val_node(target.fields[1]), val_node(s.fields[1])]), s.line)
        if lst.ty.startswith('tuple['):
            raise CompileError('a tuple cannot be changed, so its items cannot be assigned\nuse a list if the items must change', s.line)
        if is_dict(lst.ty):
            k = self.expr(val_node(target.fields[1]))
            k = self.want(k, 'str', s.line, 'a dict key')
            dv = self.expr(val_node(s.fields[1]), dict_value(lst.ty))
            dv = self.want(dv, dict_value(lst.ty), s.line, 'the assigned value')
            slot = self.tmp('slot')
            self.emit(f'{slot} = call ptr @tomato_dict_insert(ptr {lst.reg}, i64 {self.key_word(k)}, i32 0)')
            self.store_owned(slot, dv)
            self.release(k)
            self.release(lst)
            return
        if is_class(lst.ty):
            f = self.mod.find_op(lst.ty[1:], 'set')
            if f is None or len(f.ptypes) != 2 or f.ret != '':
                raise CompileError("'" + lst.ty[1:] + "' objects cannot be assigned by index\nadd a method marked @set that takes the index and the new item", s.line)
            si = self.want(self.expr(val_node(target.fields[1])), f.ptypes[0], s.line, 'an index')
            sv = self.expr(val_node(s.fields[1]), f.ptypes[1])
            sv = self.want(sv, f.ptypes[1], s.line, 'the assigned item')
            self.marker_call(lst, f, [si, sv], s.line)
            return
        if not is_list(lst.ty):
            raise CompileError('only list and dict items can be assigned by index', s.line)
        i = self.expr(val_node(target.fields[1]))
        i = self.want(i, 'int', s.line, 'an index')
        i = ex(self.norm_index(lst, self.int_raw(i)), 'int')
        v = self.expr(val_node(s.fields[1]), elem_of(lst.ty))
        v = self.want(v, elem_of(lst.ty), s.line, 'the assigned item')
        addr = self.list_slot(lst, i)
        if is_rc(v.ty):
            old = self.tmp('old')
            self.emit(f'{old} = load ptr, ptr {addr}')
            self.emit(f'store ptr {v.reg}, ptr {addr}')
            self.emit(f'call void @tomato_release(ptr {old})')
        elif v.ty == 'int':
            self.store_owned(addr, v)
        else:
            self.store_item(lst.ty, v, addr)
        self.release(lst)

    def narrow_target(self, cond: Node) -> list[str]:
        # `x in Type` where x is a union variable and Type is one of its members: [x, Type]; else []
        if cond.kind != 'BinOp' or cond.fields[0].text != 'in':
            return []
        l = val_node(cond.fields[1])
        if l.kind != 'Name':
            return []
        name = l.fields[0].text
        tt = self.type_operand(val_node(cond.fields[2]))
        if tt == '' or name not in self.slots:
            return []
        if not is_union(self.types[name]) or tt not in union_members(self.types[name]):
            return []
        return [name, tt]

    def enter_narrow(self, name: str, member: str) -> list[str]:
        # inside the branch the variable is the member's own type: a copy of the value taken out of the box.
        # When several members are left (member is a union) the variable keeps its box and only its type gets smaller.
        saved = [self.slots[name], self.types[name]]
        if is_union(member):
            self.types[name] = member
            self.narrowed.append(name)
            return saved
        holder = self.tmp('whole')
        self.emit(f'{holder} = load ptr, ptr {saved[0]}')
        inner = self.unbox_value(ex(holder, saved[1]), member)
        shadow = self.new_slot(name, member)
        self.store_owned(shadow, inner)
        self.narrowed.append(name)
        return saved

    def leave_narrow(self, name: str, saved: list[str]):
        self.slots[name] = saved[0]
        self.types[name] = saved[1]
        self.narrowed = self.narrowed[:-1]

    def narrow_to(self, name: str, keep: list[str]) -> list[str]:
        # the members `keep` of a union variable (one member gives that type, several a smaller union)
        if len(keep) == 1:
            return self.enter_narrow(name, keep[0])
        return self.enter_narrow(name, union_type(keep))

    def settle_narrow(self, name: str, keep: list[str]):
        # after an if whose other branches all left the block: the variable stays narrowed to the end of the block
        saved = self.narrow_to(name, keep)
        self.settled.append(name)
        self.after.append([name, saved[0], saved[1]])

    def end_block_narrowing(self, depth: int):
        while len(self.after) > depth:
            entry = self.after[len(self.after) - 1]
            self.after = self.after[:-1]
            self.settled = self.settled[:-1]
            self.leave_narrow(entry[0], [entry[1], entry[2]])

    def if_stmt(self, s: Node):
        end = self.label('endif')
        var = ''                       # the union variable the first condition tests, if it does
        members: list[str] = []
        left: list[str] = []           # the members it can still be when the next condition is tested
        kept: list[str] = []           # the members it can be after the whole if, over the branches that do not leave
        branches = s.fields[0].items
        for k, branch in enumerate(branches):
            target = self.narrow_target(val_node(branch.items[0]))
            if k == 0 and len(target) > 0:
                var = target[0]
                members = union_members(self.types[var])
                left = members
            cond = self.truth(self.expr(val_node(branch.items[0])), s.line)
            then = self.label('then')
            nxt = self.label('next')
            self.cond_br(cond, then, nxt)
            self.place(then)
            saved: list[str] = []
            # a later branch that does not test the variable still knows which members are left, so it cannot assign it
            rest_known = var != '' and k > 0 and not (len(target) > 0 and target[0] == var) and len(left) > 0 and len(left) < len(members)
            saved_rest: list[str] = []
            if rest_known:
                saved_rest = self.narrow_to(var, left)
            if len(target) > 0:
                saved = self.enter_narrow(target[0], target[1])
            self.block(val_nodes(branch.items[1]))
            if len(target) > 0:
                self.leave_narrow(target[0], saved)
            if rest_known:
                self.leave_narrow(var, saved_rest)
            if not self.terminated:
                self.br(end)
                if var != '' and len(target) > 0 and target[0] == var:
                    kept.append(target[1])
                elif var != '':
                    kept = kept + left
            if var != '' and len(target) > 0 and target[0] == var:
                rest: list[str] = [m for m in left if m != target[1]]
                left = rest
            self.place(nxt)
        if s.fields[1].tag == 'l':
            # `else:` knows the variable is one of the members no condition above matched
            narrowed_else = var != '' and len(left) > 0 and len(left) < len(members)
            saved = []
            if narrowed_else:
                saved = self.narrow_to(var, left)
            self.block(val_nodes(s.fields[1]))
            if narrowed_else:
                self.leave_narrow(var, saved)
            if not self.terminated:
                kept = kept + left
        else:
            kept = kept + left
        if not self.terminated:
            self.br(end)
        self.place(end)
        if var != '' and len(kept) > 0 and self.types[var] == union_type(members):
            keep: list[str] = [m for m in members if m in kept]
            if len(keep) < len(members):
                self.settle_narrow(var, keep)

    # ---- small-integer loops. A `while` whose body is only int arithmetic on local variables (assignments built from + - * and
    # // % by a power of two, if/elif/else on comparisons) is compiled twice. The fast copy assumes every int variable it uses holds a
    # small number (checked once when the loop is entered, and again each time the general copy comes back to the loop head): it has no
    # tag tests, no big-number calls and no frees, and an operation that would leave the small range jumps to the start of the same
    # statement in the general copy (nothing of that statement has been stored yet), which carries on with big numbers as before.
    def fast_expr_ok(self, n: Node, names: list[str]) -> bool:
        if n.kind == 'IntLit':
            return n.fields[0].num < 2 ** 60
        if n.kind == 'UnOp':
            inner = val_node(n.fields[1])
            return n.fields[0].text == '-' and inner.kind == 'IntLit' and inner.fields[0].num < 2 ** 60
        if n.kind == 'Name':
            name = n.fields[0].text
            if name not in self.slots or self.types[name] != 'int' or name in self.narrowed or name in self.settled:
                return False
            if name not in names:
                names.append(name)
            return True
        if n.kind != 'BinOp':
            return False
        op = n.fields[0].text
        left = val_node(n.fields[1])
        right = val_node(n.fields[2])
        if op == '//' or op == '%':
            if right.kind != 'IntLit' or not self.is_pow2_literal(right.fields[0].num):
                return False
        elif op != '+' and op != '-' and op != '*':
            return False
        return self.fast_expr_ok(left, names) and self.fast_expr_ok(right, names)

    def is_pow2_literal(self, v: int) -> bool:
        # 2, 4, 8, ... up to 2**60
        if v < 2 or v > 2 ** 60:
            return False
        while v > 1:
            if v % 2 != 0:
                return False
            v = v // 2
        return True

    def fast_cond_ok(self, n: Node, names: list[str]) -> bool:
        if n.kind != 'BinOp':
            return False
        op = n.fields[0].text
        if not (op == '==' or op == '!=' or op == '<' or op == '<=' or op == '>' or op == '>='):
            return False
        return self.fast_expr_ok(val_node(n.fields[1]), names) and self.fast_expr_ok(val_node(n.fields[2]), names)

    def fast_stmts_ok(self, body: list[Node], names: list[str], counter: list[int]) -> bool:
        # also numbers the statements (Node.mark) that the fast copy may jump back to
        for s in body:
            if s.kind == 'Pass':
                continue
            if s.kind == 'Assign':
                t = val_node(s.fields[0])
                if t.kind != 'Name' or t.fields[0].text not in self.slots or self.types[t.fields[0].text] != 'int' or t.fields[0].text in self.narrowed or t.fields[0].text in self.settled:
                    return False
                if t.fields[0].text not in names:
                    names.append(t.fields[0].text)
                if not self.fast_expr_ok(val_node(s.fields[1]), names):
                    return False
                counter[0] += 1
                s.mark = counter[0]
            elif s.kind == 'If':
                counter[0] += 1
                s.mark = counter[0]
                for branch in s.fields[0].items:
                    if not self.fast_cond_ok(val_node(branch.items[0]), names):
                        return False
                    if not self.fast_stmts_ok(val_nodes(branch.items[1]), names, counter):
                        return False
                if s.fields[1].tag == 'l' and not self.fast_stmts_ok(val_nodes(s.fields[1]), names, counter):
                    return False
            else:
                return False
        return True

    def clear_marks(self, body: list[Node]):
        for s in body:
            s.mark = 0
            if s.kind == 'If':
                for branch in s.fields[0].items:
                    self.clear_marks(val_nodes(branch.items[1]))
                if s.fields[1].tag == 'l':
                    self.clear_marks(val_nodes(s.fields[1]))

    def fast_checked(self, intr: str, a: str, b: str, bail: str) -> str:
        # a 64-bit operation on tagged words whose overflow means "the result is outside the small range" (see tomato_int_add_c)
        name = f'llvm.{intr}.with.overflow.i64'
        self.mod.declare(f'declare {{i64, i1}} @{name}(i64, i64)')
        pair = self.tmp('pair')
        self.emit(f'{pair} = call {{i64, i1}} @{name}(i64 {a}, i64 {b})')
        r = self.tmp('r')
        self.emit(f'{r} = extractvalue {{i64, i1}} {pair}, 0')
        ov = self.tmp('ov')
        self.emit(f'{ov} = extractvalue {{i64, i1}} {pair}, 1')
        ok = self.label('fastok')
        self.cond_br(ov, bail, ok)
        self.place(ok)
        return r

    def fast_expr(self, n: Node, bail: str) -> str:
        if n.kind == 'IntLit':
            return str(n.fields[0].num * 2 + 1)
        if n.kind == 'UnOp':
            return str(1 - val_node(n.fields[1]).fields[0].num * 2)
        if n.kind == 'Name':
            r = self.tmp('fl')
            self.emit(f'{r} = load i64, ptr {self.slots[n.fields[0].text]}')
            return r
        op = n.fields[0].text
        a = self.fast_expr(val_node(n.fields[1]), bail)
        if op == '//' or op == '%':
            v = val_node(n.fields[2]).fields[0].num
            k = 0
            while v > 1:
                v = v // 2
                k += 1
            if op == '//':
                s = self.arith('ashr', a, str(k))
                return self.arith('or', s, '1')
            m = self.arith('and', a, str(2 ** (k + 1) - 2))
            return self.arith('or', m, '1')
        b = self.fast_expr(val_node(n.fields[2]), bail)
        if op == '+':
            return self.fast_checked('sadd', a, self.arith('sub', b, '1'), bail)
        if op == '-':
            return self.fast_checked('ssub', a, self.arith('sub', b, '1'), bail)
        am = self.arith('sub', a, '1')
        bm = self.arith('ashr', b, '1')
        p = self.fast_checked('smul', am, bm, bail)
        return self.arith('or', p, '1')

    def fast_cond(self, n: Node, bail: str) -> str:
        op = n.fields[0].text
        a = self.fast_expr(val_node(n.fields[1]), bail)
        b = self.fast_expr(val_node(n.fields[2]), bail)
        cc = 'eq'
        if op == '!=':
            cc = 'ne'
        elif op == '<':
            cc = 'slt'
        elif op == '<=':
            cc = 'sle'
        elif op == '>':
            cc = 'sgt'
        elif op == '>=':
            cc = 'sge'
        c = self.tmp('fc')
        self.emit(f'{c} = icmp {cc} i64 {a}, {b}')
        return c

    def fast_block(self, body: list[Node], prefix: str):
        for s in body:
            if s.kind == 'Pass':
                continue
            bail = f'{prefix}_{s.mark}'
            if s.kind == 'Assign':
                v = self.fast_expr(val_node(s.fields[1]), bail)
                self.emit(f'store i64 {v}, ptr {self.slots[val_node(s.fields[0]).fields[0].text]}')
                continue
            end = self.label('fendif')
            for branch in s.fields[0].items:
                c = self.fast_cond(val_node(branch.items[0]), bail)
                then = self.label('fthen')
                nxt = self.label('fnext')
                self.cond_br(c, then, nxt)
                self.place(then)
                self.fast_block(val_nodes(branch.items[1]), prefix)
                self.br(end)
                self.place(nxt)
            if s.fields[1].tag == 'l':
                self.fast_block(val_nodes(s.fields[1]), prefix)
            self.br(end)
            self.place(end)

    def small_loop(self, s: Node) -> bool:
        # compile `while` as the fast copy plus the general copy when its body qualifies; False means nothing was emitted
        if self.is_async or self.gen_n > 0:
            return False
        names: list[str] = []
        counter = [0]
        cond = val_node(s.fields[0])
        body = val_nodes(s.fields[1])
        ok = len(body) > 0 and self.fast_cond_ok(cond, names) and self.fast_stmts_ok(body, names, counter)
        if not ok:
            self.clear_marks(body)
            return False
        prefix = self.label('rb')
        saved_prefix = self.mark_prefix
        self.mark_prefix = prefix
        fhead = self.label('fwhile')
        fbody = self.label('fbody')
        ghead = self.label('while')
        gcond = self.label('gcond')
        gbody = self.label('body')
        end = self.label('endwhile')
        self.br(ghead)
        # the general loop head: every variable small (bit 0 of the AND of the words is set) -> the fast copy
        self.place(ghead)
        acc = ''
        for name in names:
            w = self.tmp('sm')
            self.emit(f'{w} = load i64, ptr {self.slots[name]}')
            if acc == '':
                acc = w
            else:
                acc = self.arith('and', acc, w)
        bit = self.arith('and', acc, '1')
        small = self.tmp('small')
        self.emit(f'{small} = icmp ne i64 {bit}, 0')
        self.cond_br(small, fhead, gcond)
        self.place(fhead)
        fc = self.fast_cond(cond, gcond)
        self.cond_br(fc, fbody, end)
        self.place(fbody)
        self.fast_block(body, prefix)
        self.br(fhead)
        self.place(gcond)
        c = self.truth(self.expr(cond), s.line)
        self.cond_br(c, gbody, end)
        self.place(gbody)
        self.push_loop(end, ghead)
        self.block(body)
        self.loop_depth -= 1
        if not self.terminated:
            self.br(ghead)
        self.place(end)
        self.mark_prefix = saved_prefix
        self.clear_marks(body)
        return True

    def while_stmt(self, s: Node):
        if self.small_loop(s):
            return
        head = self.label('while')
        body = self.label('body')
        end = self.label('endwhile')
        self.br(head)
        self.place(head)
        cond = self.truth(self.expr(val_node(s.fields[0])), s.line)
        self.cond_br(cond, body, end)
        self.place(body)
        self.push_loop(end, head)
        self.block(val_nodes(s.fields[1]))
        self.loop_depth -= 1
        if not self.terminated:
            self.br(head)
        self.place(end)

    def gen_push(self, c: GenCtx):
        if len(self.gens) > self.gen_n:
            self.gens[self.gen_n] = c
        else:
            self.gens.append(c)
        self.gen_n += 1

    def swap_scope(self, c: GenCtx):
        # exchange the names in scope with those the context keeps: the caller's loop body and the generator's body each see their own variables
        self.slots, c.slots = c.slots, self.slots
        self.types, c.types = c.types, self.types
        self.narrowed, c.narrowed = c.narrowed, self.narrowed
        self.settled, c.settled = c.settled, self.settled
        self.ret, c.ret = c.ret, self.ret
        self.owner, c.owner = c.owner, self.owner
        self.in_init, c.in_init = c.in_init, self.in_init
        self.mod.cur, c.module = c.module, self.mod.cur
        self.mod.tvars, c.targs = c.targs, self.mod.tvars

    def gen_args(self, info: FuncInfo, args: list[Node], line: int) -> list[Ex]:
        if info.stars > 0:
            raise CompileError(f"the generator '{info.name}' cannot take *args or **kwargs", line)
        required = len(info.ptypes) - len(info.defaults)
        if len(args) < required or len(args) > len(info.ptypes):
            raise CompileError("'" + info.name + "' takes " + plural(len(info.ptypes), 'argument') + ', but ' + str(len(args)) + ' given', line)
        return self.args_with_defaults(args, info.ptypes, info.defaults, line, "'" + info.name + "'")

    # the arguments of a call, then the defaults of the parameters it leaves out, each checked against its parameter's type
    def args_with_defaults(self, args: list[Node], ptypes: list[str], defaults: list[Node], line: int, callee: str) -> list[Ex]:
        required = len(ptypes) - len(defaults)
        vals: list[Ex] = []
        held_before = len(self.held)
        for k, a in enumerate(args):
            v = self.expr(a, ptypes[k])
            vals.append(self.want(v, ptypes[k], line, 'argument ' + str(k + 1) + ' of ' + callee))
            self.hold(vals[-1])
        for k in range(len(args), len(ptypes)):
            v = self.expr(defaults[k - required], ptypes[k])
            vals.append(self.want(v, ptypes[k], line, 'the default of argument ' + str(k + 1) + ' of ' + callee))
            self.hold(vals[-1])
        self.drop_held(held_before)
        return vals

    def inline_gen(self, s: Node, info: FuncInfo, recv: Ex, vals: list[Ex], line: int):
        # for x in <generator>: the generator's body is compiled right here, as part of the loop. Each `yield v` sets x to v and
        # runs the loop body; `break` leaves the whole thing and `continue` goes on after the yield. Nothing is built up in memory.
        if info.ret == '':
            raise CompileError(f"the generator '{info.name}' must say what it yields\nadd -> Type to its def, such as -> int", line)
        if self.gen_n >= 6:
            raise CompileError("generators are nested too deeply here\na generator cannot loop over itself", line)
        node = self.mod.node_of(info)
        var = self.slot(s.fields[0].text, info.ret, s.line)
        c = GenCtx()
        c.var = var
        c.ty = info.ret
        c.body = val_nodes(s.fields[2])
        c.end = self.label('endgen')
        c.try_depth = self.try_depth
        c.owner = info.owner
        c.module = info.module
        c.targs = info.targs
        self.swap_scope(c)
        self.gen_push(c)
        k = 0
        for p in val_nodes(node.fields[1]):
            pname = p.fields[0].text
            if pname == 'self' and info.owner != '':
                self.store_owned(self.slot('self', '@' + info.owner, line), recv)
            else:
                self.store_owned(self.slot(pname, info.ptypes[k], line), vals[k])
                k += 1
        self.block(val_nodes(node.fields[3]))
        if not self.terminated:
            self.br(c.end)
        self.place(c.end)
        self.gen_n -= 1
        self.swap_scope(c)

    def yield_stmt(self, s: Node):
        if self.gen_n == 0:
            raise CompileError("'yield' can only be used in a generator, that is a function or method that a for loop loops over", s.line)
        c = self.gens[self.gen_n - 1]
        if self.try_depth != c.try_depth:
            raise CompileError("'yield' cannot be used inside a try block", s.line)
        v = self.expr(val_node(s.fields[0]), c.ty)
        v = self.want(v, c.ty, s.line, 'the yielded value')
        self.store_owned(c.var, v)
        self.gen_n -= 1
        self.swap_scope(c)
        cont = self.label('afteryield')
        self.push_loop(c.end, cont)
        self.block(c.body)
        self.loop_depth -= 1
        if not self.terminated:
            self.br(cont)
        self.place(cont)
        self.swap_scope(c)
        self.gen_push(c)

    def gen_call(self, s: Node, it: Node) -> bool:
        # for x in gen(args) and for x in obj.gen(args), where the function or method is a generator
        if it.kind != 'Call' or len(it.fields[2].items) > 0:
            return False
        f = val_node(it.fields[0])
        args = val_nodes(it.fields[1])
        if f.kind == 'Name':
            name = f.fields[0].text
            if name in self.slots or name == 'range':
                return False
            key = self.mod.resolve(name)
            if key == '' or self.mod.has_class(key):
                return False
            if key in self.mod.generics:
                g = self.mod.generics[key]
                if g.kind != 'FuncDef' or not g.fields[7].flag:
                    return False
                info = self.mod.instance_func(key, self.infer_targs(key, val_nodes(g.fields[1]), args, s.line), s.line)
            else:
                info = self.mod.find(key, s.line)
            if not info.is_gen:
                return False
            self.inline_gen(s, info, ex('', ''), self.gen_args(info, args, s.line), s.line)
            return True
        if f.kind != 'Attr':
            return False
        name = f.fields[1].text
        known = False
        for fi in self.mod.infos:
            if fi.name == name and fi.owner != '' and fi.is_gen:
                known = True
        target = val_node(f.fields[0])
        if not known or (target.kind == 'Name' and target.fields[0].text not in self.slots):
            return False
        obj = self.unwrap(self.expr(target), s.line)
        found: FuncInfo | None = None
        if is_class(obj.ty):
            found = self.mod.lookup_method(obj.ty[1:], name)
        if found is None or not found.is_gen:
            self.release(obj)
            return False
        info: FuncInfo = found
        self.inline_gen(s, info, obj, self.gen_args(info, args, s.line), s.line)
        return True

    def for_text(self, s: Node, text: Ex):
        # for ch in text: each character as a one-character text
        holder = self.hidden_rc_slot('for.text')
        self.store_owned(holder, text)
        counter = self.hidden_slot('for.i')
        self.emit(f'store i64 0, ptr {counter}')
        var = self.slot(s.fields[0].text, 'str', s.line)
        head = self.label('eachchar')
        body = self.label('eachcharbody')
        step = self.label('eachcharstep')
        end = self.label('endeachchar')
        self.br(head)
        self.place(head)
        t = self.tmp('txt')
        self.emit(f'{t} = load ptr, ptr {holder}')
        i = self.tmp('i')
        self.emit(f'{i} = load i64, ptr {counter}')
        n = self.tmp('n')
        self.emit(f'{n} = call i64 @tomato_str_len(ptr {t})')
        go = self.tmp('go')
        self.emit(f'{go} = icmp slt i64 {i}, {n}')
        self.cond_br(go, body, end)
        self.place(body)
        ch = self.tmp('ch')
        self.emit(f'{ch} = call ptr @tomato_str_index(ptr {t}, i64 {i})')
        self.store_owned(var, ex(ch, 'str'))
        self.push_loop(end, step)
        self.block(val_nodes(s.fields[2]))
        self.loop_depth -= 1
        if not self.terminated:
            self.br(step)
        self.place(step)
        cur = self.tmp('cur')
        self.emit(f'{cur} = load i64, ptr {counter}')
        nxt = self.tmp('next')
        self.emit(f'{nxt} = add i64 {cur}, 1')
        self.emit(f'store i64 {nxt}, ptr {counter}')
        self.br(head)
        self.place(end)

    def item_type(self, t: str) -> str:
        # the type of the items a for loop gives over a value of type t, or '' when it is not known here
        if is_list(t):
            return elem_of(t)
        if t == 'str':
            return 'str'
        if is_class(t) and self.mod.has_op(t[1:], 'iter'):
            return self.mod.find_op(t[1:], 'iter').ret
        return ''

    def for_union(self, s: Node, name: str):
        # a loop over a union variable: the loop is compiled once for each member, in the branch where the variable is that member
        members = union_members(self.types[name])
        first = ''
        for m in members:
            item = self.item_type(m)
            if first == '':
                first = item
            elif item != '' and item != first:
                raise CompileError(f"a for loop over '{name}' needs the same item type in every member of {shown(self.types[name])}, but the items are {shown(first)} and {shown(item)}", s.line)
        whole = self.tmp('whole')
        self.emit(f'{whole} = load ptr, ptr {self.slots[name]}')
        end = self.label('endunion')
        then = ''
        nxt = ''
        for k, m in enumerate(members):
            if k < len(members) - 1:
                then = self.label('eachof')
                nxt = self.label('nextof')
                self.cond_br(self.box_is(ex(whole, self.types[name]), m), then, nxt)
                self.place(then)
            saved = self.enter_narrow(name, m)
            self.for_stmt(s)
            self.leave_narrow(name, saved)
            self.br(end)
            if k < len(members) - 1:
                self.place(nxt)
        self.place(end)

    def for_each(self, s: Node, it: Node):
        self.for_value(s, self.expr(it))

    # a loop over a value of an Iterable type: the loop is compiled once for each kind of value the box can hold, and the
    # one matching the box's contents runs (the same way a union is narrowed)
    def for_dyn(self, s: Node, box: Ex):
        if not dyn_iterable(box.ty):
            raise CompileError('a for loop cannot loop over a value of type Sized\nuse Iterable[T] to say what the loop gives', s.line)
        holder = self.hidden_rc_slot('for.dyn')
        self.store_owned(holder, box)
        join = self.label('enddyn')
        for member in self.mod.dyn_members(box.ty):
            held = self.tmp('held')
            self.emit(f'{held} = load ptr, ptr {holder}')
            yes = self.label('dynis')
            no = self.label('dynnot')
            self.cond_br(self.box_is(ex(held, box.ty), member), yes, no)
            self.place(yes)
            inner = self.unbox_value(ex(held, box.ty), member)
            if member == dyn_seq():
                inner = ex(inner.reg, 'list[' + dyn_item(box.ty) + ']')
            self.for_value(s, inner)
            if not self.terminated:
                self.br(join)
            self.place(no)
        self.br(join)
        self.place(join)

    # a loop over d.items() of a dict: keys and values are two snapshots walked together, so each variable has its own type
    def for_items(self, s: Node, it: Node):
        f = val_node(it.fields[0])
        obj = self.unwrap(self.expr(val_node(f.fields[0])), s.line)
        if not is_dict(obj.ty):
            self.for_value(s, self.method_on(obj, it, 'items', []))        # the unpack is the first statement of the body
            return
        vt = dict_value(obj.ty)
        ks = self.tmp('keys')
        self.emit(f'{ks} = call ptr @tomato_dict_keys(ptr {obj.reg}, i64 {self.mod.code_of("list[str]")}, i64 {item_width("list[str]")})')
        vl = f'list[{vt}]'
        vs_ = self.tmp('values')
        self.emit(f'{vs_} = call ptr @tomato_dict_values(ptr {obj.reg}, i64 {self.mod.code_of(vl)}, i64 {item_width(vl)}, i32 {elem_rc(vt)})')
        self.release(obj)
        self.for_value(s, ex(ks, 'list[str]'), ex(vs_, vl))

    def for_value(self, s: Node, lst: Ex, vals: Ex | None = None):
        if is_dyn(lst.ty):
            self.for_dyn(s, lst)
            return
        if is_class(lst.ty):
            ai = self.mod.find_op(lst.ty[1:], 'iter')
            if ai is not None and ai.is_async:
                raise CompileError("'" + lst.ty[1:] + "' loops over async statuses, so it needs async for\nwrite: async for " + s.fields[0].text + " in ...:", s.line)
        if is_class(lst.ty) and self.mod.has_op(lst.ty[1:], 'iter'):
            self.inline_gen(s, self.mod.find_op(lst.ty[1:], 'iter'), lst, [], s.line)
            return
        if is_set(lst.ty) or is_dict(lst.ty):
            # a loop over a set or dict walks a snapshot of its keys (P28)
            keys = f'list[{set_elem(lst.ty)}]'
            if is_dict(lst.ty):
                keys = 'list[str]'
            snap = self.tmp('keys')
            self.emit(f'{snap} = call ptr @tomato_dict_keys(ptr {lst.reg}, i64 {self.mod.code_of(keys)}, i64 {item_width(keys)})')
            self.release(lst)
            lst = ex(snap, keys)
        if lst.ty == 'str':
            self.for_text(s, lst)
            return
        if not is_list(lst.ty):
            if is_class(lst.ty):
                raise CompileError("a for loop cannot loop over a '" + lst.ty[1:] + "' object\ngive the class a method marked @iter that yields the items, or loop over a list field of it such as obj.items", s.line)
            raise CompileError(f'a for loop can loop over a range(), a list, a tuple, a set, a dict, text or an object with an @iter method, but this is {shown(lst.ty)}', s.line)
        elem = elem_of(lst.ty)
        holder = self.hidden_rc_slot('for.list')
        self.store_owned(holder, lst)
        counter = self.hidden_slot('for.i')
        self.emit(f'store i64 0, ptr {counter}')
        var = self.slot(s.fields[0].text, elem, s.line)
        holder2 = ''
        var2 = ''
        stmts = val_nodes(s.fields[2])
        if vals is not None:                     # for k, v in d.items(): the names are the fourth field, and the unpack is not needed
            holder2 = self.hidden_rc_slot('for.vals')
            self.store_owned(holder2, vals)
            var = self.slot(s.fields[3].items[0].text, elem, s.line)
            var2 = self.slot(s.fields[3].items[1].text, elem_of(vals.ty), s.line)
            stmts = stmts[1:]
        head = self.label('each')
        body = self.label('eachbody')
        step = self.label('eachstep')
        end = self.label('endeach')
        self.br(head)
        self.place(head)
        l = self.tmp('lst')
        self.emit(f'{l} = load ptr, ptr {holder}')
        i = self.tmp('i')
        self.emit(f'{i} = load i64, ptr {counter}')
        lenp = self.tmp('lenp')
        self.emit(f'{lenp} = getelementptr {{ i64, i64, i64, i64, ptr }}, ptr {l}, i32 0, i32 2')
        ln = self.tmp('n')
        self.emit(f'{ln} = load i64, ptr {lenp}')
        go = self.tmp('go')
        self.emit(f'{go} = icmp slt i64 {i}, {ln}')
        self.cond_br(go, body, end)
        self.place(body)
        addr = self.list_slot(ex(l, lst.ty), ex(i, 'int'))
        item = self.load_item(lst.ty, addr, 'item')
        e = ex(item, elem)
        self.retain(e)
        self.store_owned(var, e)
        if vals is not None:
            l2 = self.tmp('lst')
            self.emit(f'{l2} = load ptr, ptr {holder2}')
            addr2 = self.list_slot(ex(l2, vals.ty), ex(i, 'int'))
            item2 = self.load_item(vals.ty, addr2, 'item')
            e2 = ex(item2, elem_of(vals.ty))
            self.retain(e2)
            self.store_owned(var2, e2)
        self.push_loop(end, step)
        self.block(stmts)
        self.loop_depth -= 1
        if not self.terminated:
            self.br(step)
        self.place(step)
        cur = self.tmp('cur')
        self.emit(f'{cur} = load i64, ptr {counter}')
        nxt = self.tmp('next')
        self.emit(f'{nxt} = add i64 {cur}, 1')
        self.emit(f'store i64 {nxt}, ptr {counter}')
        self.br(head)
        self.place(end)

    def for_stmt(self, s: Node):
        it = val_node(s.fields[1])
        if len(s.fields) > 3:
            self.for_items(s, it)
            return
        if it.kind == 'Name' and it.fields[0].text in self.slots and is_union(self.types[it.fields[0].text]):
            self.for_union(s, it.fields[0].text)
            return
        if self.gen_call(s, it):
            return
        if not (it.kind == 'Call' and val_node(it.fields[0]).kind == 'Name' and val_node(it.fields[0]).fields[0].text == 'range'):
            self.for_each(s, it)
            return
        if it.kind != 'Call' or val_node(it.fields[0]).kind != 'Name' or val_node(it.fields[0]).fields[0].text != 'range':
            raise CompileError('a for loop with two variables is not supported here', s.line)
        bounds = val_nodes(it.fields[1])
        if len(bounds) < 1 or len(bounds) > 3:
            raise CompileError('range() takes 1 to 3 whole-number arguments: range(stop), range(start, stop) or range(start, stop, step)', s.line)
        start = '0'
        stop = ''
        stepv = '1'
        basev = '0'
        if len(bounds) == 1:
            e = self.expr(bounds[0])
            e = self.want(e, 'int', s.line, 'a range bound')
            stop = self.int_raw(e)
        else:
            a = self.expr(bounds[0])
            b = self.expr(bounds[1])
            a = self.want(a, 'int', s.line, 'a range bound')
            b = self.want(b, 'int', s.line, 'a range bound')
            start = self.int_raw(a)
            stop = self.int_raw(b)
        if len(bounds) == 3:
            c3 = self.expr(bounds[2])
            c3 = self.want(c3, 'int', s.line, 'a range bound')
            stepv = self.int_raw(c3)
            zero = self.tmp('zerostep')
            self.emit(f'{zero} = icmp eq i64 {stepv}, 0')
            self.fail_if(zero, 'range step cannot be zero')
            # (the raw bounds are 63-bit numbers, so stop - start is at most 2^63 - 1 and cannot overflow)
            # the number of times round: a division once, so the loop itself is one compare and one add
            up = self.tmp('up')
            self.emit(f'{up} = icmp sgt i64 {stepv}, 0')
            fwd = self.tmp('fwd')
            self.emit(f'{fwd} = sub i64 {stop}, {start}')
            back = self.tmp('back')
            self.emit(f'{back} = sub i64 {start}, {stop}')
            dist = self.tmp('dist')
            self.emit(f'{dist} = select i1 {up}, i64 {fwd}, i64 {back}')
            neg = self.tmp('neg')
            self.emit(f'{neg} = sub i64 0, {stepv}')
            width = self.tmp('width')
            self.emit(f'{width} = select i1 {up}, i64 {stepv}, i64 {neg}')
            less = self.tmp('less')
            self.emit(f'{less} = sub i64 {dist}, 1')
            quo = self.tmp('quo')
            self.emit(f'{quo} = sdiv i64 {less}, {width}')
            plus = self.tmp('plus')
            self.emit(f'{plus} = add i64 {quo}, 1')
            empty = self.tmp('empty')
            self.emit(f'{empty} = icmp sle i64 {dist}, 0')
            cnt = self.tmp('cnt')
            self.emit(f'{cnt} = select i1 {empty}, i64 0, i64 {plus}')
            basev = start
            start = '0'
            stop = cnt
        var = self.slot(s.fields[0].text, 'int', s.line)
        if len(bounds) < 3:
            old = self.tmp('old')
            self.emit(f'{old} = load i64, ptr {var}')
            self.emit(f'call void @tomato_int_free(i64 {old})')           # a number the variable held before the loop; the loop stores small ones
            self.emit(f'store i64 1, ptr {var}')
        counter = self.hidden_slot('for.i')
        limit = self.hidden_slot('for.n')
        stepslot = self.hidden_slot('for.s')
        baseslot = self.hidden_slot('for.b')
        self.emit(f'store i64 {start}, ptr {counter}')
        self.emit(f'store i64 {stop}, ptr {limit}')
        self.emit(f'store i64 {stepv}, ptr {stepslot}')
        self.emit(f'store i64 {basev}, ptr {baseslot}')
        head = self.label('for')
        body = self.label('forbody')
        step = self.label('forstep')
        end = self.label('endfor')
        self.br(head)
        self.place(head)
        i = self.tmp('i')
        self.emit(f'{i} = load i64, ptr {counter}')
        lim = self.tmp('lim')
        self.emit(f'{lim} = load i64, ptr {limit}')
        c = self.tmp('go')
        self.emit(f'{c} = icmp slt i64 {i}, {lim}')
        self.cond_br(c, body, end)
        self.place(body)
        if len(bounds) == 1 or len(bounds) == 3:         # the count starts at 0, so an index made from it is never negative
            nonneg = self.tmp('nonneg')
            self.emit(f'{nonneg} = icmp sge i64 {i}, 0')
            self.emit(f'call void @llvm.assume(i1 {nonneg})')
        if len(bounds) == 3:             # an empty loop leaves the variable alone; one the body gave a big number is freed first
            old = self.tmp('old')
            self.emit(f'{old} = load i64, ptr {var}')
            self.emit(f'call void @tomato_int_free(i64 {old})')
            bv = self.tmp('bv')
            self.emit(f'{bv} = load i64, ptr {baseslot}')
            sv = self.tmp('sv')
            self.emit(f'{sv} = load i64, ptr {stepslot}')
            off = self.tmp('off')
            self.emit(f'{off} = mul nsw i64 {i}, {sv}')
            i = self.tmp('val')
            self.emit(f'{i} = add nsw i64 {bv}, {off}')
        self.emit(f'store i64 {self.tag_small(i).reg}, ptr {var}')
        self.push_loop(end, step)
        self.block(val_nodes(s.fields[2]))
        self.loop_depth -= 1
        if not self.terminated:
            self.br(step)
        self.place(step)
        cur = self.tmp('cur')
        self.emit(f'{cur} = load i64, ptr {counter}')
        nxt = self.tmp('next')
        self.emit(f'{nxt} = add nsw i64 {cur}, 1')
        self.emit(f'store i64 {nxt}, ptr {counter}')
        self.br(head)
        self.place(end)

def async_symbol(mod: Mod, info: FuncInfo) -> str:
    # the constructor of an async function's task; the resume function is this name followed by .resume
    if info.owner == '':
        return f'@tomato.async.{info.key}'
    return '@tomato.async.m.' + str(mod.code_of('@' + info.owner)) + '.' + info.name

def function_symbol(mod: Mod, info: FuncInfo) -> str:
    if info.is_async:
        return async_symbol(mod, info)
    if info.owner == '':
        return f'@tomato.{info.key}'
    return '@tomato.m.' + str(mod.code_of('@' + info.owner)) + '.' + info.name

def finish_function(g: Gen, symbol: str, sig: list[str], ret: str) -> str:
    # the epilogue releases every slot that owns a heap value, then returns the stored result
    g.lines.append('epilogue:')
    for reg in g.rc_slots:
        o = g.tmp('rel')
        g.lines.append(f'  {o} = load ptr, ptr {reg}')
        g.lines.append(f'  call void @{g.slot_release(reg)}(ptr {o})')
    for reg in g.int_slots:
        o = g.tmp('free')
        g.lines.append(f'  {o} = load i64, ptr {reg}')
        g.lines.append(f'  call void @tomato_int_free(i64 {o})')
    llvm_ret = 'void'
    if ret != '':
        llvm_ret = llvm_type(ret)
        r = g.tmp('ret')
        g.lines.append(f'  {r} = load {llvm_ret}, ptr %retval')
        g.lines.append(f'  ret {llvm_ret} {r}')
    else:
        g.lines.append('  ret void')
    text = 'define ' + llvm_ret + ' ' + symbol + '(' + ', '.join(sig) + ') {\nentry:\n'
    if ret != '':
        text += f'  %retval = alloca {llvm_ret}\n  store {llvm_ret} {zero_of(ret)}, ptr %retval\n'
    if len(g.allocas) > 0:
        text += '\n'.join(g.allocas) + '\n'
    text += '\n'.join(g.lines) + '\n}\n'
    return text

def trace_name(info: FuncInfo) -> str:
    # the function as a call trace shows it: Class.method, or just the name
    if info.owner == '':
        return info.name
    return info.owner.split('.')[-1] + '.' + info.name

def compile_function(f: Node, mod: Mod, info: FuncInfo) -> str:
    mod.cur = info.module
    mod.tvars = info.targs
    g = Gen()
    g.mod = mod
    g.owner = info.owner
    g.fname = trace_name(info)
    g.in_init = info.is_init
    g.ret = info.ret
    params = val_nodes(f.fields[1])
    names: list[str] = []
    types: list[str] = []
    k = 0
    for p in params:
        if p.fields[0].text == 'self':
            if info.owner == '':
                raise CompileError("'self' can only be used in methods inside a class", p.line)
            names.append('self')
            types.append(f'@{info.owner}')
        else:
            names.append(p.fields[0].text)
            types.append(info.ptypes[k])
            k += 1
    sig: list[str] = []
    lent: list[list[str]] = []          # per rc or int parameter: its name, its slot, and the line index of its retain (of its copy, for an int)
    for k, name in enumerate(names):
        reg = g.slot(name, types[k], f.line)
        sig.append(f'{llvm_type(types[k])} %arg.{name}')
        if types[k] == 'int':
            lent.append([name, reg, str(len(g.lines))])
            g.emit(f'%arg.{name}.own = call i64 @tomato_int_dup(i64 %arg.{name})')    # the caller only lent it
            g.emit(f'store i64 %arg.{name}.own, ptr {reg}')
            continue
        g.emit(f'store {llvm_type(types[k])} %arg.{name}, ptr {reg}')
        if is_rc(types[k]):
            lent.append([name, reg, str(len(g.lines))])
            g.emit('call void @tomato_retain(ptr %arg.' + name + ')')    # the caller only lent it
    g.assigned = []
    g.block(val_nodes(f.fields[3]))
    # a parameter that the body never assigns keeps the caller's reference for as long as the call lasts (the caller holds one
    # during the call), so it needs no reference of its own: no retain now and no release in the epilogue
    for pl in lent:
        if pl[0] not in g.assigned:
            g.lines[int(pl[2])] = '  ; the parameter ' + pl[0] + ' is only lent'
            g.rc_slots = [r for r in g.rc_slots if r != pl[1]]
            if g.types[pl[0]] == 'int':
                # the slot holds the caller's number: no copy, and nothing to free
                g.lines[int(pl[2]) + 1] = '  store i64 %arg.' + pl[0] + ', ptr ' + pl[1]
                g.int_slots = [r for r in g.int_slots if r != pl[1]]
    if info.ret != '' and falls_through(val_nodes(f.fields[3])):
        raise CompileError(f"the function '{info.name}' can reach its end without returning a value\nend every path with a return, for example give the last if an else that returns", f.line)
    if not g.terminated:
        if info.ret == '':
            g.br('epilogue')
        else:
            g.emit('call void @tomato_fail(ptr ' + mod.intern('the function ended without returning a value') + '.c)')
            g.emit('unreachable')
            g.terminated = True
    return finish_function(g, function_symbol(mod, info), sig, info.ret)

def compile_async_function(f: Node, mod: Mod, info: FuncInfo) -> str:
    # an async function becomes a frame (its variables on the heap), a constructor that makes the frame from the arguments,
    # and a resume function that runs the body from where it last stopped
    mod.cur = info.module
    mod.tvars = info.targs
    g = Gen()
    g.mod = mod
    g.owner = info.owner
    g.fname = trace_name(info)
    g.is_async = True
    g.ret = info.ret
    g.ret_yields = info.yields
    cname = f'async.{info.key}'
    if info.owner != '':
        cname = f'async.m.{info.owner}.{info.name}'
    code = mod.code_of(f'@{cname}')
    g.frame_code = code
    g.allocas.append(f'  %state.p = getelementptr %class.{code}, ptr %frame, i32 0, i32 3')
    params = val_nodes(f.fields[1])
    names: list[str] = []
    types: list[str] = []
    k = 0
    for p in params:
        if p.fields[0].text == 'self':
            if info.owner == '':
                raise CompileError("'self' can only be used in methods inside a class", p.line)
            names.append('self')
            types.append(f'@{info.owner}')
        else:
            names.append(p.fields[0].text)
            types.append(info.ptypes[k])
            k += 1
    sig: list[str] = []
    k = 0
    for name in names:
        g.slot(name, types[k], f.line)
        sig.append(f'{llvm_type(types[k])} %arg.{name}')
        k += 1
    g.line = f.line
    g.check_cancel()                  # cancelled before it ever ran
    g.block(val_nodes(f.fields[3]))
    if info.ret != '' and falls_through(val_nodes(f.fields[3])):
        raise CompileError(f"the function '{info.name}' can reach its end without returning a value\nend every path with a return, for example give the last if an else that returns", f.line)
    if not g.terminated:
        if info.ret == '':
            g.br('epilogue')
        else:
            g.emit('call void @tomato_fail(ptr ' + mod.intern('the function ended without returning a value') + '.c)')
            g.emit('unreachable')
            g.terminated = True
    # the frame's type: the fixed fields, then one per variable
    result_ty = info.ret
    if result_ty == '':
        result_ty = 'u64'
    queue_ty = f'list[{info.yields}]' if info.yields != '' else 'File'
    fr = ClassInfo()
    fr.name = cname
    fr.display = 'task'
    fr.module = info.module
    fr.is_frame = True
    fr.done = True
    frame_types: list[str] = ['u64', 'u64', 'u64', 'u64', 'u64', 'u64', 'u64', 'u64', 'u64', 'str', '@Error', queue_ty, result_ty]
    for t in g.frame_types:
        frame_types.append(t)
    for ft in frame_types:
        slot = FieldInfo()
        slot.name = 'f'
        slot.ty = ft
        fr.fields.append(slot)
    mod.frames.append(fr)
    cls = f'%class.{code}'
    sym = async_symbol(mod, info)
    # the resume function
    text = f'define void {sym}.resume(ptr %frame) {{\nentry:\n'
    if info.ret != '':
        text += f'  %retval = alloca {llvm_type(info.ret)}\n  store {llvm_type(info.ret)} {zero_of(info.ret)}, ptr %retval\n'
    text += '\n'.join(g.allocas) + '\n'
    text += '  %st.v = load i64, ptr %state.p\n  switch i64 %st.v, label %start ['
    for i in range(g.awaits):
        text += f' i64 {str(i + 1)}, label %rs.{str(i + 1)}'
    text += ' ]\nstart:\n'
    text += '\n'.join(g.lines) + '\n'
    text += 'epilogue:\n'
    for reg in g.rc_slots:
        o = g.tmp('rel')
        text += f'  {o} = load ptr, ptr {reg}\n  call void @{g.slot_release(reg)}(ptr {o})\n  store ptr null, ptr {reg}\n'
    for reg in g.int_slots:
        o = g.tmp('free')
        text += f'  {o} = load i64, ptr {reg}\n  call void @tomato_int_free(i64 {o})\n  store i64 0, ptr {reg}\n'
    text += '  %ex.p = load ptr, ptr @tomato_exc\n  %ex.has = icmp ne ptr %ex.p, null\n  br i1 %ex.has, label %failed, label %succeeded\n'
    text += f'failed:\n  %e.p = getelementptr {cls}, ptr %frame, i32 0, i32 12\n  store ptr %ex.p, ptr %e.p\n'
    text += f'  %el = load i32, ptr @tomato_exc_line\n  %el64 = zext i32 %el to i64\n  %el.p = getelementptr {cls}, ptr %frame, i32 0, i32 6\n  store i64 %el64, ptr %el.p\n'
    text += f'  %er = load i32, ptr @tomato_exc_rt\n  %er64 = zext i32 %er to i64\n  %er.p = getelementptr {cls}, ptr %frame, i32 0, i32 7\n  store i64 %er64, ptr %er.p\n'
    text += f'  store ptr null, ptr @tomato_exc\n  %s2.p = getelementptr {cls}, ptr %frame, i32 0, i32 4\n  store i64 2, ptr %s2.p\n  br label %wake\n'
    text += 'succeeded:\n'
    text += '  call void @tomato_task_drop_starter(ptr %frame)\n'
    if info.ret != '':
        text += f'  %rv = load {llvm_type(info.ret)}, ptr %retval\n  %rv.p = getelementptr {cls}, ptr %frame, i32 0, i32 14\n  store {llvm_type(info.ret)} %rv, ptr %rv.p\n'
    text += f'  %s1.p = getelementptr {cls}, ptr %frame, i32 0, i32 4\n  store i64 1, ptr %s1.p\n  br label %wake\n'
    text += 'wake:\n  call void @tomato_wake_waiters(ptr %frame)\n  ret void\nsuspend:\n  ret void\n}\n'
    # the constructor
    text += 'define ptr ' + sym + '(' + ', '.join(sig) + ') {\nentry:\n'
    text += f'  %size = ptrtoint ptr getelementptr ({cls}, ptr null, i32 1) to i64\n'
    text += f'  %f = call ptr @tomato_alloc(i64 %size, i64 {code})\n'
    text += f'  %rf = getelementptr {cls}, ptr %f, i32 0, i32 2\n  store ptr {sym}.resume, ptr %rf\n'
    k = 0
    for name in names:
        text += f'  %pf{k} = getelementptr {cls}, ptr %f, i32 0, i32 {str(FRAME_FIXED + k + 2)}\n'
        if types[k] == 'int':
            text += f'  %arg.{name}.own = call i64 @tomato_int_dup(i64 %arg.{name})\n  store i64 %arg.{name}.own, ptr %pf{k}\n'
        else:
            text += f'  store {llvm_type(types[k])} %arg.{name}, ptr %pf{k}\n'
        if is_rc(types[k]):
            text += f'  call void @tomato_retain(ptr %arg.{name})\n'
        k += 1
    if info.yields != '':
        text += f'  %q = call ptr @tomato_list_new(i64 {mod.code_of(queue_ty)})\n'
        text += f'  %qf = getelementptr {cls}, ptr %f, i32 0, i32 13\n  store ptr %q, ptr %qf\n'
    text += '  ret ptr %f\n}\n'
    return text

def scheduler_ir(mod: Mod) -> str:
    # the code that runs tasks: step runs one frame until it stops, run keeps stepping whatever is ready until nothing is left
    t = 'define void @tomato.sched.step(ptr %f) {\n  %p = getelementptr i8, ptr %f, i64 16\n  %fn = load ptr, ptr %p\n  call void %fn(ptr %f)\n  ret void\n}\n'
    hdr = '{ i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, i64, ptr, ptr, ptr, i64 }'
    t += f'define void @tomato.task.raise(ptr %h) {{\n  call void @tomato_task_retrieved(ptr %h)\n  %ep = getelementptr {hdr}, ptr %h, i32 0, i32 12\n  %e = load ptr, ptr %ep\n  call void @tomato_retain(ptr %e)\n  store ptr %e, ptr @tomato_exc\n'
    t += f'  %lp = getelementptr {hdr}, ptr %h, i32 0, i32 6\n  %l = load i64, ptr %lp\n  %l32 = trunc i64 %l to i32\n  store i32 %l32, ptr @tomato_exc_line\n'
    t += f'  %rp = getelementptr {hdr}, ptr %h, i32 0, i32 7\n  %r = load i64, ptr %rp\n  %r32 = trunc i64 %r to i32\n  store i32 %r32, ptr @tomato_exc_rt\n  store i32 1, ptr @tomato_exc_seen\n  ret void\n}}\n'
    t += f'define void @tomato.sched.run(ptr %main) {{\nentry:\n  call void @tomato_set_mode(i32 {mod.mode})\n  call void @tomato_q_push(ptr %main)\n  br label %loop\n'
    t += 'loop:\n  %f = call ptr @tomato_q_pop()\n  %none = icmp eq ptr %f, null\n  br i1 %none, label %idle, label %go\n'
    t += 'go:\n  call void @tomato.sched.step(ptr %f)\n  call void @tomato_release(ptr %f)\n  br label %loop\n'
    t += 'idle:\n  %did = call i32 @tomato_sched_idle()\n  %more = icmp ne i32 %did, 0\n  br i1 %more, label %loop, label %done\n'
    t += 'done:\n  call void @tomato_pending_flush()\n  %sp = getelementptr i8, ptr %main, i64 32\n  %st = load i64, ptr %sp\n  %fin = icmp ne i64 %st, 0\n  br i1 %fin, label %finished, label %stuck\n'
    t += 'stuck:\n  call void @tomato_fail(ptr ' + mod.intern('every task is waiting for something that can no longer happen') + '.c)\n  unreachable\n'
    t += 'finished:\n  %bad = icmp eq i64 %st, 2\n  br i1 %bad, label %raise, label %out\n'
    t += 'raise:\n  call void @tomato.task.raise(ptr %main)\n  br label %out\nout:\n  call void @tomato_release(ptr %main)\n  ret void\n}\n'
    return t

def compile_constructor(c: ClassInfo, mod: Mod) -> str:
    # allocate, store the declared field defaults, then run @init
    mod.cur = c.module
    mod.tvars = c.targs
    g = Gen()
    g.mod = mod
    code = str(mod.code_of('@' + c.name))
    ptypes: list[str] = []
    if c.init != '':
        ptypes = mod.find_method(c.name, c.init, c.line).ptypes
    sig: list[str] = []
    for k, t in enumerate(ptypes):
        sig.append(f'{llvm_type(t)} %arg.{k}')
    size = g.tmp('size')
    g.emit(f'{size} = ptrtoint ptr getelementptr (%class.{code}, ptr null, i32 1) to i64')
    obj = g.tmp('obj')
    g.emit(f'{obj} = call ptr @tomato_alloc(i64 {size}, i64 {code})')
    for k, fld in enumerate(c.fields):
        if fld.default is not None:
            v = g.expr(fld.default, fld.ty)
            v = g.want(v, fld.ty, c.line, 'the default of field ' + fld.name)
            v = g.owned(v)
            addr = g.tmp('fld')
            g.emit(f'{addr} = getelementptr %class.{code}, ptr {obj}, i32 0, i32 {str(k + 2)}')
            g.emit(f'store {llvm_type(v.ty)} {v.reg}, ptr {addr}')
    if c.init != '':
        parts: list[str] = ['ptr ' + obj]
        for k, t in enumerate(ptypes):
            parts.append(f'{llvm_type(t)} %arg.{k}')
        g.emit('call void @' + 'tomato.m.' + str(mod.code_of('@' + mod.find_method(c.name, c.init, c.line).owner)) + '.' + c.init + '(' + ', '.join(parts) + ')')
        pending = g.tmp('ex')
        g.emit(f'{pending} = load ptr, ptr @tomato_exc')
        has = g.tmp('has')
        g.emit(f'{has} = icmp ne ptr {pending}, null')
        bad = g.label('initfailed')
        ok = g.label('initok')
        g.cond_br(has, bad, ok)
        g.place(bad)
        g.emit('call void @tomato_release(ptr ' + obj + ')')          # an @init that raised leaves no object behind
        g.br('epilogue')
        g.place(ok)
    g.emit(f'store ptr {obj}, ptr %retval')
    g.br('epilogue')
    return finish_function(g, '@tomato.new.' + code, sig, '@' + c.name)

def class_types(mod: Mod) -> str:
    # one struct type per class: the reference count and type code, then the fields
    t = ''
    for c in mod.classes:
        parts: list[str] = []
        parts.append('i64')
        parts.append('i64')
        for fld in c.fields:
            parts.append(llvm_type(fld.ty))
        t += '%class.' + str(mod.code_of('@' + c.name)) + ' = type { ' + ', '.join(parts) + ' }\n'
    return t

def vtables(mod: Mod) -> str:
    # one method table per class (a slot per method name), and the table of tables indexed by type code
    n = len(mod.codes) + 2
    heads = ['ptr null'] * n
    text = ''
    k = 0
    for code in mod.codes:
        slot = k + 2
        if is_class(code) and len(mod.slots) > 0:
            entries: list[str] = []
            for name in mod.slots:
                found = mod.lookup_method(code[1:], name)
                if found is not None and not found.is_gen:
                    entries.append(f'ptr {function_symbol(mod, found)}')
                else:
                    entries.append('ptr null')
            text += '@tomato.vt.' + str(slot) + ' = constant [' + str(len(entries)) + ' x ptr] [' + ', '.join(entries) + ']\n'
            heads[slot] = f'ptr @tomato.vt.{slot}'
        k += 1
    text += '@tomato_vtables = constant [' + str(n) + ' x ptr] [' + ', '.join(heads) + ']\n'
    return text

def int_of_bool(b: bool) -> int:
    if b:
        return 1
    return 0

def runtime_tables(mod: Mod) -> str:
    n = len(mod.codes) + 2
    names: list[str] = []
    zeros: list[str] = []
    kinds: list[str] = []
    offsets: list[str] = []
    extra = ''
    for k in range(n):
        names.append('ptr null')
        zeros.append('i64 0')
        offsets.append('ptr null')
        kinds.append('i32 0')
    k = 0
    for code in mod.codes:
        slot = k + 2
        if code.startswith('box:'):
            # a union's box: a class-like object with one field, at byte 16, that the runtime releases when it is a heap value
            kinds[slot] = 'i32 1'
            offs: list[str] = []
            if is_rc(code[4:]):
                offs.append('i32 16')
            offs.append('i32 -1')
            if code[4:] == 'int':
                offs.append('i32 16')           # the number it holds belongs to the box
            offs.append('i32 -1')
            extra += '@tomato.offs.' + str(slot) + ' = constant [' + str(len(offs)) + ' x i32] [' + ', '.join(offs) + ']\n'
            offsets[slot] = f'ptr @tomato.offs.{slot}'
        elif is_class(code):
            c = mod.find_class(code[1:], 0)
            kinds[slot] = 'i32 1'
            if c.is_frame:
                kinds[slot] = 'i32 1025'          # bit 10: a task frame, whose dropping may report an unread error
            if c.parent != '':
                zeros[slot] = 'i64 ' + str(mod.code_of('@' + c.parent))
            offs: list[str] = []
            for j, fld in enumerate(c.fields):
                if is_rc(fld.ty):
                    offs.append(f'i32 trunc (i64 ptrtoint (ptr getelementptr (%class.{slot}, ptr null, i32 0, i32 {str(j + 2)}) to i64) to i32)')
            offs.append('i32 -1')
            for j, fld in enumerate(c.fields):
                if fld.ty == 'int':
                    offs.append(f'i32 trunc (i64 ptrtoint (ptr getelementptr (%class.{slot}, ptr null, i32 0, i32 {str(j + 2)}) to i64) to i32)')
            offs.append('i32 -1')
            extra += '@tomato.offs.' + str(slot) + ' = constant [' + str(len(offs)) + ' x i32] [' + ', '.join(offs) + ']\n'
            offsets[slot] = f'ptr @tomato.offs.{slot}'
            extra += f'@tomato.name.{slot} = private constant [{str(len(c.display) + 1)} x i8] c"{c.display}\\00"\n'
            names[slot] = f'ptr @tomato.name.{slot}'
        elif is_set(code):
            kinds[slot] = 'i32 ' + str(3 + 256 * int_of_bool(set_elem(code) == 'str'))      # a set of ints says so in its key kind
        elif is_dict(code):
            kinds[slot] = 'i32 ' + str(3 + 256 + 512 * int_of_bool(is_rc(dict_value(code))) + 2048 * int_of_bool(dict_value(code) == 'int'))    # a table with text keys
        elif elem_of(code) == 'str' or is_rc(elem_of(code)):
            kinds[slot] = 'i32 258'          # a list: 2, plus 256 when its items are reference counted
        elif elem_of(code) == 'int':
            kinds[slot] = 'i32 2050'         # plus 2048 when its items are ints, whose big numbers it frees
        else:
            kinds[slot] = 'i32 2'
        k += 1
    count = str(n)
    t = '@tomato_exc = global ptr null\n'
    t += '@tomato_exc_line = global i32 0\n'
    t += '@tomato_exc_rt = global i32 0\n'
    t += '@tomato_exc_seen = global i32 0\n'
    t += extra
    t += '@tomato_class_names = constant [' + count + ' x ptr] [' + ', '.join(names) + ']\n'
    t += '@tomato_parents = global [' + count + ' x i64] [' + ', '.join(zeros) + ']\n'
    t += '@tomato_kinds = constant [' + count + ' x i32] [' + ', '.join(kinds) + ']\n'
    t += '@tomato_offsets = constant [' + count + ' x ptr] [' + ', '.join(offsets) + ']\n'
    return t

def declarations(mod: Mod) -> str:
    d = 'declare i32 @printf(ptr, ...)\n'
    d += 'declare i32 @putchar(i32)\n'
    d += 'declare void @tomato_fail(ptr)\n'
    d += 'declare void @tomato_trace(ptr, i32)\n'
    d += 'declare void @tomato_trace_clear()\n'
    d += 'declare void @tomato_leak_check()\n'
    d += 'declare void @tomato_retain(ptr)\n'
    d += 'declare void @tomato_release(ptr)\n'
    d += 'declare void @tomato_release_flat(ptr)\n'
    d += 'declare ptr @tomato_str_concat(ptr, ptr)\n'
    d += 'declare ptr @tomato_str_from_cstr(ptr)\n'
    d += 'declare i64 @tomato_str_len(ptr)\n'
    d += 'declare i32 @tomato_str_cmp(ptr, ptr)\n'
    d += 'declare ptr @tomato_str_index(ptr, i64)\n'
    d += 'declare ptr @tomato_str_slice(ptr, i64, i64)\n'
    d += 'declare ptr @tomato_list_concat(ptr, ptr, i32)\n'
    d += 'declare ptr @tomato_list_repeat(ptr, i64, i32)\n'
    d += 'declare ptr @tomato_str_repeat(ptr, i64)\n'
    d += 'declare ptr @tomato_str_slice3(ptr, i64, i64, i64, i32)\n'
    d += 'declare ptr @tomato_list_slice(ptr, i64, i64, i64, i32, i32)\n'
    d += 'declare ptr @tomato_list_sorted(ptr, i32)\n'
    d += 'declare ptr @tomato_list_insert_slot(ptr, i64, i64)\n'
    d += 'declare void @tomato_list_remove_at(ptr, i64, i64)\n'
    d += 'declare void @tomato_list_extend(ptr, ptr, i32)\n'
    d += 'declare void @tomato_list_reverse(ptr, i64)\n'
    d += 'declare void @tomato_list_swap(ptr, ptr)\n'
    d += 'declare i32 @tomato_list_eq_bytes(ptr, ptr, i64)\n'
    d += 'declare ptr @tomato_list_sorted_by(ptr, ptr, i32, i32)\n'
    d += 'declare i32 @tomato_callbacks()\n'
    d += 'declare ptr @tomato_list_sorted_cmp(ptr, ptr, ptr, i32)\n'
    d += 'declare ptr @tomato_str_from_i64(i64)\n'
    d += 'declare ptr @tomato_str_from_bool(i32)\n'
    d += 'declare ptr @tomato_str_from_f64(double)\n'
    d += 'declare ptr @tomato_box_str(ptr)\n'
    d += 'declare ptr @tomato_box_repr(ptr)\n'
    d += 'declare i64 @tomato_int_dup(i64)\n'

    for op in ['add', 'sub', 'mul', 'floordiv', 'mod', 'shl', 'shr']:
        d += f'declare i64 @tomato_int_{op}_c(i64, i64, i32)\n'
    d += 'declare i64 @tomato_int_floordivp2_c(i64, i32, i32)\n'
    d += 'declare i64 @tomato_int_modp2_c(i64, i32, i32)\n'
    d += 'declare i32 @tomato_int_cmp_c(i64, i64, i32)\n'
    d += 'declare i64 @tomato_int_raw_c(i64, i32)\n'
    d += 'declare void @tomato_int_free(i64)\n'
    d += 'declare void @llvm.assume(i1)\n'
    d += 'declare i64 @tomato_int_add(i64, i64)\n'
    d += 'declare i64 @tomato_int_sub(i64, i64)\n'
    d += 'declare i64 @tomato_int_mul(i64, i64)\n'
    d += 'declare i64 @tomato_int_floordiv(i64, i64)\n'
    d += 'declare i64 @tomato_int_mod(i64, i64)\n'
    d += 'declare i64 @tomato_int_shl(i64, i64)\n'
    d += 'declare i64 @tomato_int_shr(i64, i64)\n'
    d += 'declare i64 @tomato_int_pow(i64, i64)\n'
    d += 'declare i32 @tomato_int_cmp(i64, i64)\n'
    d += 'declare i32 @tomato_int_sign(i64)\n'
    d += 'declare i64 @tomato_int_from_i64(i64)\n'
    d += 'declare i64 @tomato_int_from_u64(i64)\n'
    d += 'declare i64 @tomato_int_raw(i64)\n'
    d += 'declare i64 @tomato_int_low64(i64)\n'
    d += 'declare i32 @tomato_int_in_range(i64, i32, i32)\n'
    d += 'declare double @tomato_int_to_f64(i64)\n'
    d += 'declare double @tomato_clock()\n'
    d += 'declare ptr @tomato_int_str(i64)\n'
    d += 'declare i64 @tomato_int_parse(ptr)\n'
    d += 'declare i64 @tomato_int_parse_cstr(ptr, i32)\n'
    d += 'declare i64 @tomato_int_bitop(i64, i64, i32)\n'
    d += 'declare i64 @tomato_int_not(i64)\n'
    d += 'declare i64 @tomato_f64_to_int(double)\n'
    d += 'declare double @tomato_parse_f64(ptr, i32)\n'
    d += 'declare i32 @tomato_ipow_check(i64, i64)\n'
    d += 'declare i64 @tomato_ipow(i64, i64)\n'
    d += 'declare double @tomato_floor_div_f64(double, double)\n'
    d += 'declare double @tomato_mod_f64(double, double)\n'
    d += 'declare double @tomato_pow_f64(double, double)\n'
    d += 'declare void @tomato_print_strobj(ptr)\n'
    d += 'declare ptr @tomato_alloc(i64, i64)\n'
    d += 'declare i32 @tomato_is_subclass(i64, i64)\n'
    d += 'declare ptr @tomato_dict_new(i64, i64, i32)\n'
    d += 'declare ptr @tomato_dict_find(ptr, i64)\n'
    d += 'declare ptr @tomato_dict_insert(ptr, i64, i32)\n'
    d += 'declare i32 @tomato_dict_delete(ptr, i64)\n'
    d += 'declare ptr @tomato_dict_keys(ptr, i64, i64)\n'
    d += 'declare void @tomato_usage(i32, i32)\n'
    d += 'declare i64 @tomato_parse_i64(ptr, i32)\n'
    d += 'declare i64 @tomato_parse_u64(ptr, i32)\n'
    d += 'declare void @tomato_fit_signed(i64, i32, i32)\n'
    d += 'declare void @tomato_fit_unsigned(i64, i32, i32)\n'
    d += 'declare i32 @tomato_parse_bool(ptr, i32)\n'
    d += 'declare void @tomato_report_uncaught(ptr, i32, i32, i32)\n'
    d += 'declare i64 @tomato_str_find(ptr, ptr)\n'
    d += 'declare i64 @tomato_str_find_from(ptr, ptr, i64)\n'
    d += 'declare i64 @tomato_str_search(ptr, ptr, i64, i64, i32)\n'
    d += 'declare i64 @tomato_str_rfind(ptr, ptr)\n'
    d += 'declare i64 @tomato_str_count(ptr, ptr)\n'
    d += 'declare ptr @tomato_str_chr(i64)\n'
    d += 'declare i64 @tomato_str_ord(ptr)\n'
    d += 'declare ptr @tomato_dict_values(ptr, i64, i64, i32)\n'
    d += 'declare ptr @tomato_dict_items(ptr, i64, i64, i64, i64, i64, i32)\n'
    d += 'declare i32 @tomato_str_startswith(ptr, ptr)\n'
    d += 'declare i32 @tomato_str_endswith(ptr, ptr)\n'
    d += 'declare i32 @tomato_str_contains(ptr, ptr)\n'
    d += 'declare ptr @tomato_str_replace(ptr, ptr, ptr)\n'
    d += 'declare ptr @tomato_str_split(ptr, ptr, i64, i64)\n'
    d += 'declare ptr @tomato_str_join(ptr, ptr)\n'
    d += 'declare ptr @tomato_str_upper(ptr)\n'
    d += 'declare ptr @tomato_str_lower(ptr)\n'
    d += 'declare ptr @tomato_str_strip(ptr)\n'
    d += 'declare ptr @tomato_file_open(ptr, ptr)\n'
    d += 'declare ptr @tomato_file_read(ptr)\n'
    d += 'declare void @tomato_file_write(ptr, ptr)\n'
    d += 'declare void @tomato_file_close(ptr)\n'
    d += 'declare ptr @tomato_input(ptr)\n'
    d += 'declare i32 @tomato_text_int_ok(ptr)\n'
    d += 'declare i64 @tomato_text_int(ptr)\n'
    d += 'declare i32 @tomato_text_float_ok(ptr)\n'
    d += 'declare double @tomato_text_float(ptr)\n'
    d += 'declare void @tomato_q_push(ptr)\n'
    d += 'declare ptr @tomato_q_pop()\n'
    d += 'declare void @tomato_input_wait(ptr, ptr)\n'
    d += 'declare i32 @tomato_sched_idle()\n'
    d += 'declare void @tomato_task_wait(ptr, ptr)\n'
    d += 'declare void @tomato_task_retrieved(ptr)\n'
    d += 'declare i32 @tomato_task_cancelled(ptr)\n'
    d += 'declare void @tomato_task_cancel(ptr)\n'
    d += 'declare void @tomato_sleep_wait(ptr, double)\n'
    d += 'declare void @tomato_http_wait(ptr, i64)\n'
    d += 'declare void @tomato_task_drop_starter(ptr)\n'
    d += 'declare ptr @tomato_pending_pop(ptr, ptr, ptr)\n'
    d += 'declare void @tomato_pending_flush()\n'
    d += 'declare void @tomato_set_mode(i32)\n'
    d += 'declare i32 @tomato_exit_code()\n'
    d += 'declare void @tomato_wake_waiters(ptr)\n'
    d += 'declare ptr @tomato_list_new(i64)\n'
    d += 'declare ptr @tomato_list_push(ptr, i64)\n'
    d += '@.fmt.int = private constant [5 x i8] c"%lld\\00"\n'
    d += '@.fmt.uint = private constant [5 x i8] c"%llu\\00"\n'
    for extra in mod.decls:
        d += f'{extra}\n'
    d += 'declare ptr @tomato_str_from_u64(i64)\n'
    return d

def literal_text(n: Node, ty: str) -> str:
    # the IR constant for a default written as a plain literal (entry point inputs)
    if ty == 'int' and n.kind == 'IntLit':
        if n.fields[0].num >= 2 ** 61:
            raise CompileError('the default of an entry point input must be a whole number below 2 ** 61', n.line)
        return str(n.fields[0].num * 2 + 1)
    if is_numeric(ty) and n.kind == 'IntLit':
        return str(n.fields[0].num)
    if ty == 'bool' and n.kind == 'BoolLit':
        if n.fields[0].flag:
            return '1'
        return '0'
    raise CompileError('an entry point input default must be a plain number, True or False', n.line)

def entry_wrapper(info: FuncInfo, mod: Mod) -> str:
    # main(): read the command-line inputs, run the entry point, report an error nobody caught (D28a, D22a)
    k = len(info.ptypes)
    low = k - len(info.defaults)
    out = 'define i32 @main(i32 %argc, ptr %argv) {\nentry:\n  %n = sub i32 %argc, 1\n'
    out += f'  %lo = icmp sge i32 %n, {low}\n  %hi = icmp sle i32 %n, {k}\n  %ok = and i1 %lo, %hi\n'
    out += '  br i1 %ok, label %go, label %bad\n'
    out += f'bad:\n  call void @tomato_usage(i32 {k}, i32 %n)\n  unreachable\ngo:\n'
    args: list[str] = []
    owned: list[str] = []
    owned_ints: list[str] = []
    for i, t in enumerate(info.ptypes):
        si = str(i)
        optional = i >= low
        if optional:
            out += f'  %has{si} = icmp sgt i32 %n, {si}\n  br i1 %has{si}, label %p{si}, label %d{si}\np{si}:\n'
        out += f'  %a{si}.ptr = getelementptr ptr, ptr %argv, i64 {str(i + 1)}\n'
        out += f'  %a{si}.s = load ptr, ptr %a{si}.ptr\n'
        reg = f'%a{si}'
        if t == 'str':
            out += f'  %a{si}.v = call ptr @tomato_str_from_cstr(ptr %a{si}.s)\n'
        elif t == 'int':
            out += f'  %a{si}.v = call i64 @tomato_int_parse_cstr(ptr %a{si}.s, i32 {str(i + 1)})\n'
        elif is_fixed(t):
            bits = bits_of(t)
            parse = 'tomato_parse_u64'
            fit = 'tomato_fit_unsigned'
            if is_signed(t):
                parse = 'tomato_parse_i64'
                fit = 'tomato_fit_signed'
            out += f'  %a{si}.w = call i64 @{parse}(ptr %a{si}.s, i32 {str(i + 1)})\n'
            if bits < 64:
                out += f'  call void @{fit}(i64 %a{si}.w, i32 {bits}, i32 {str(i + 1)})\n'
                out += f'  %a{si}.v = trunc i64 %a{si}.w to i{bits}\n'
            else:
                out += f'  %a{si}.v = add i64 %a{si}.w, 0\n'
        elif t == 'float':
            out += f'  %a{si}.v = call double @tomato_parse_f64(ptr %a{si}.s, i32 {str(i + 1)})\n'
        elif t == 'bool':
            out += f'  %a{si}.w = call i32 @tomato_parse_bool(ptr %a{si}.s, i32 {str(i + 1)})\n'
            out += f'  %a{si}.v = zext i32 %a{si}.w to i64\n'
        else:
            raise CompileError('a program input (a parameter of the @main function) must be an int, bool or str', 0)
        if optional:
            dflt = info.defaults[i - low]
            out += f'  br label %m{si}\nd{si}:\n  br label %m{si}\nm{si}:\n'
            if t == 'str':
                if dflt.kind != 'StrLit':
                    raise CompileError('the default of a text input must be a plain text such as "abc"', dflt.line)
                out += f'  %a{si} = phi ptr [ %a{si}.v, %p{si} ], [ {mod.intern(dflt.fields[0].text)}, %d{si} ]\n'
            elif t == 'float':
                raise CompileError('a program input cannot have a float default', dflt.line)
            else:
                out += f'  %a{si} = phi {llvm_type(t)} [ %a{si}.v, %p{si} ], [ {literal_text(dflt, t)}, %d{si} ]\n'
        else:
            reg = f'%a{si}.v'
        if t == 'str':
            args.append(f'ptr {reg}')
            owned.append(reg)
        elif t == 'float':
            args.append(f'double {reg}')
        else:
            args.append(f'{llvm_type(t)} {reg}')
            if t == 'int' and not optional:
                owned_ints.append(reg)
    if info.is_async:
        out += '  %fr = call ptr @tomato.async.' + info.key + '(' + ', '.join(args) + ')\n  call void @tomato.sched.run(ptr %fr)\n'
    else:
        out += '  call void @tomato.' + info.key + '(' + ', '.join(args) + ')\n'
    out += '  %ex = load ptr, ptr @tomato_exc\n  %has = icmp ne ptr %ex, null\n  br i1 %has, label %uncaught, label %fine\n'
    out += 'uncaught:\n  %eline = load i32, ptr @tomato_exc_line\n  %ert = load i32, ptr @tomato_exc_rt\n'
    out += f'  call void @tomato_report_uncaught(ptr %ex, i32 %eline, i32 %ert, i32 {mod.mode})\n  unreachable\n'
    out += 'fine:\n'
    for reg in owned:
        out += f'  call void @tomato_release(ptr {reg})\n'
    for reg in owned_ints:
        out += f'  call void @tomato_int_free(i64 {reg})\n'
    out += '  call void @tomato_leak_check()\n  %rc = call i32 @tomato_exit_code()\n  ret i32 %rc\n}\n'
    return out

def key_of(module: str, name: str) -> str:
    # the program-wide name of a declaration: plain in the main program and the built-ins, module.name elsewhere
    if module == 'main' or module == 'builtin':
        return name
    return f'{module}.{name}'

def function_info(item: Node, mod: Mod, owner: str) -> FuncInfo:
    info = FuncInfo()
    info.name = item.fields[0].text
    info.line = item.line
    info.owner = owner
    info.module = mod.cur
    info.key = key_of(mod.cur, info.name)
    if len(item.fields) > 6:
        info.is_private = item.fields[4].flag
        info.is_async = len(item.fields) > 8 and item.fields[8].flag
        info.is_gen = len(item.fields) > 7 and item.fields[7].flag and not info.is_async
        if info.is_async and item.fields[9].tag == 'n':
            info.yields = mod.type_name(item.fields[9])
            if info.yields == '':
                raise CompileError('this yields type is not supported\nan async function can yield int, bool, str, float, a list, a set, a dict or a class', item.line)
        info.is_override = item.fields[5].flag
        info.is_init = item.fields[6].tag == 's' and item.fields[6].text == 'init'
        if info.is_async and info.is_init:
            raise CompileError("'@init' cannot be async\nmake the setup a separate async method and call it after the object is made", item.line)
        if item.fields[6].tag == 's' and item.fields[6].text != 'init' and is_operator_marker(item.fields[6].text):
            info.op = item.fields[6].text
            if info.is_async and info.op != 'iter':
                raise CompileError(f'an operator or protocol method ({info.op}) cannot be async', item.line)
    if item.fields[2].tag != 'z':
        info.ret = mod.type_name(item.fields[2])
        if info.ret == '':
            raise CompileError('this return type is not supported\na function can return int, bool, str, float, a list, a set, a dict or a class', item.line)
    seen: list[str] = []
    for p in val_nodes(item.fields[1]):
        if p.fields[0].text in seen:
            raise CompileError(f"the parameter '{p.fields[0].text}' of '{info.name}' is declared twice\nrename one of them", p.line)
        seen.append(p.fields[0].text)
        if p.fields[0].text == 'self' and owner != '':
            continue
        if p.fields[2].tag == 'n':
            info.defaults.append(val_node(p.fields[2]))
        pt = mod.type_name(p.fields[1])
        if pt == '':
            raise CompileError('this parameter type is not supported\na function can take int, bool, str, float, a list, a set, a dict or a class', p.line)
        if p.fields[3].tag == 's':
            if p.fields[3].text == '*' and not pt.startswith('tuple['):
                raise CompileError(f"'*{p.fields[0].text}' needs a tuple type, such as tuple[int]", p.line)
            if p.fields[3].text == '**' and not is_dict(pt):
                raise CompileError(f"'**{p.fields[0].text}' needs a dict type, such as dict[int]", p.line)
            info.stars += 1
            if p.fields[3].text == '*':
                info.has_varargs = True
            else:
                info.has_kwargs = True
        info.pnames.append(p.fields[0].text)
        info.ptypes.append(pt)
    return info

def same_signature(a: FuncInfo, b: FuncInfo) -> bool:
    if a.is_async != b.is_async or a.yields != b.yields:
        return False
    if a.ret != b.ret or len(a.ptypes) != len(b.ptypes):
        return False
    for k, t in enumerate(a.ptypes):
        if t != b.ptypes[k]:
            return False
    return True

def check_classes(mod: Mod):
    # overrides name a parent method of the same types, and a class has every method its interfaces require (D12g, D12bg)
    for f in mod.infos:
        if f.owner != '' and not f.is_init:
            c = mod.find_class(f.owner, 0)
            inherited: FuncInfo | None = None
            if c.parent != '':
                inherited = mod.lookup_method(c.parent, f.name)
            if inherited is not None and not f.is_override:
                raise CompileError(f"'{f.owner}.{f.name}' replaces a method of the parent class\nwrite 'override def' to say so", c.line)
            if inherited is None and f.is_override:
                raise CompileError(f"'{f.owner}.{f.name}' is marked 'override' but no parent class has that method", c.line)
            if inherited is not None and not same_signature(f, inherited):
                raise CompileError(f"'{f.owner}.{f.name}' must take and return the same types as the method it overrides", c.line)
            if f.name not in mod.slots:
                mod.slots.append(f.name)
    for ifc in mod.ifaces:
        for r in ifc.reqs:
            if r.name not in mod.slots:
                mod.slots.append(r.name)
    for c in mod.classes:
        for iname in mod.class_ifaces(c.name):
            closure: list[str] = []
            mod.iface_closure(iname, closure)
            for j in closure:
                for r in mod.find_iface(j, 0).reqs:
                    found = mod.lookup_method(c.name, r.name)
                    if found is None:
                        raise CompileError(f"class '{c.name}' is missing the method '{r.name}' that interface '{j}' requires", c.line)
                    if not same_signature(found, r):
                        raise CompileError(f"'{c.name}.{r.name}' must take and return exactly the types that interface '{j}' declares", c.line)

def check_class_shapes(mod: Mod):
    # one @init per class (D12aj); a class with no @init anywhere needs every field to have a value (D12af);
    # a method name is declared once; no class inherits from itself
    for c in mod.classes:
        inits = 0
        names: list[str] = []
        for f in mod.infos:
            if f.owner == c.name:
                if f.name in names or field_position(c, f.name) >= 0:
                    raise CompileError(f"'{f.name}' is defined twice in class '{c.display}'\nrename one of them", f.line)
                names.append(f.name)
                if f.is_init:
                    inits += 1
        if inits > 1:
            raise CompileError(f"class '{c.display}' has more than one @init method\nkeep one", c.line)
        seen: list[str] = []
        walk = c
        while walk.parent != '':
            if walk.parent in seen or walk.parent == c.name:
                raise CompileError(f"class '{c.display}' inherits from itself, directly or through its parents", c.line)
            seen.append(walk.parent)
            walk = mod.find_class(walk.parent, c.line)
        if not has_init(mod, c):
            for fld in c.fields:
                if fld.owner == c.name and fld.default is None:
                    raise CompileError(f"class '{c.display}' has no @init method, but the field '{fld.name}' has no starting value\ngive the field a value, or add an @init method that sets it", c.line)

def has_init(mod: Mod, c: ClassInfo) -> bool:
    if c.init != '':
        return True
    if c.parent != '':
        return has_init(mod, mod.find_class(c.parent, c.line))
    return False

def show_item(mod: Mod, et: str, e: str, line: int) -> str:
    # Tomato source that shows the item `e` of type et inside a printed container
    if et == 'str':
        return f'_quote({e})'
    if is_list(et) or is_dict(et) or is_set(et):
        return mod.helper('show', et, line).name + '(' + e + ')'
    if is_class(et):
        if not mod.has_op(et[1:], 'str'):
            raise CompileError("'" + et[1:] + "' objects cannot be printed or converted to text\nadd a method marked @str that returns text", line)
    elif not (is_numeric(et) or et == 'bool' or et == 'float' or is_union(et)):
        raise CompileError(f'a list of {shown(et)} cannot be printed\nprint its items one by one instead', line)
    if is_union(et):
        return f'_repr_box({e})'
    return f'str({e})'

def iter_elem(mod: Mod, ty: str) -> str:
    # what the @iter method of a class yields
    return mod.find_op(ty[1:], 'iter').ret

def helper_source(mod: Mod, name: str, kind: str, ty: str, line: int) -> str:
    # the Tomato source of a helper function; parameters are written as int and given their real types by helper_types
    head = f'def {name}(x: int) -> str:\n'
    if is_class(ty):
        et = iter_elem(mod, ty)
        if kind == 'tolist':
            return f'{head}    out: list[{shown(et)}] = []\n    for v in x:\n        out.append(v)\n    return out\n'
        if not (et == 'int' or et == 'float' or (et == 'str' and kind != 'sum')):
            wanted = '' if kind == 'sum' else ' or text'
            raise CompileError(f'{kind}() needs something that gives numbers{wanted}, but {shown(ty)} gives {shown(et)}', line)
        zero = '0.0' if et == 'float' else '0'
        if et == 'str':
            zero = "''"
        if kind == 'sum':
            return f'{head}    total: {shown(et)} = {zero}\n    for v in x:\n        total = total + v\n    return total\n'
        better = '>' if kind == 'max' else '<'
        return f"{head}    first = True\n    best: {shown(et)} = {zero}\n    for v in x:\n        if first or v {better} best:\n            best = v\n            first = False\n    if first:\n        raise RuntimeError('{kind}() of an empty sequence')\n    return best\n"
    if kind == 'show':
        if is_dict(ty):
            body = "    out = '{'\n    first = True\n    for k in x:\n        if not first:\n            out = out + ', '\n        first = False\n"
            body += "        out = out + _quote(k) + ': ' + " + show_item(mod, dict_value(ty), 'x[k]', line) + '\n'
            return f"{head}{body}    return out + '}}'\n"
        open_text = '['
        close_text = ']'
        elem = elem_of(ty)
        if is_set(ty):
            open_text = '{'
            close_text = '}'
            elem = set_elem(ty)
        elif ty.startswith('tuple['):
            open_text = '('
            close_text = ')'
        body = ''
        if is_set(ty):
            body = "    if len(x) == 0:\n        return 'set()'\n"
        body += f"    out = '{open_text}'\n    first = True\n    for e in x:\n        if not first:\n            out = out + ', '\n        first = False\n"
        body += '        out = out + ' + show_item(mod, elem, 'e', line) + '\n'
        if ty.startswith('tuple['):
            body += "    if len(x) == 1:\n        out = out + ','\n"
        return f"{head}{body}    return out + '{close_text}'\n"
    if kind == 'sum':
        zero = '0.0' if elem_of(ty) == 'float' else '0'
        return f'{head}    total: {shown(elem_of(ty))} = {zero}\n    for v in x:\n        total = total + v\n    return total\n'
    if kind == 'min' or kind == 'max':
        better = '>' if kind == 'max' else '<'
        return f"{head}    if len(x) == 0:\n        raise RuntimeError('{kind}() of an empty list')\n    best = x[0]\n    for v in x:\n        if v {better} best:\n            best = v\n    return best\n"
    raise CompileError(f'internal compiler error: no helper of kind {kind}', line)

def helper_types(mod: Mod, info: FuncInfo, kind: str, ty: str):
    # give the stub parameter its real type
    if is_class(ty):
        info.ptypes[0] = ty
        if kind == 'tolist':
            info.ret = f'list[{iter_elem(mod, ty)}]'
        else:
            info.ret = iter_elem(mod, ty)
        return
    if kind == 'show':
        info.ptypes[0] = ty
        info.ret = 'str'
    else:
        info.ptypes[0] = ty
        info.ret = elem_of(ty)

def plural(n: int, word: str) -> str:
    if n == 1:
        return f'1 {word}'
    return f'{n} {word}s'

def top_level_message(item: Node) -> str:
    if item.kind == 'ExprStmt' or item.kind == 'Assign' or item.kind == 'AugAssign' or item.kind == 'Return' or item.kind == 'If' or item.kind == 'While' or item.kind == 'For' or item.kind == 'Pass':
        return 'this statement is outside any function\nprograms have no top-level code: put it inside a function marked @main (only the repl accepts bare statements)'
    return f'this kind of declaration ({item.kind}) is not supported'

def is_generic_item(item: Node) -> bool:
    # a class or function declared with type parameters, `class Box[T]` (D60a): its last field is the list of them
    if item.kind == 'ClassDef':
        return len(item.fields) > 5
    if item.kind == 'FuncDef':
        return len(item.fields) > 10
    return False

def class_def(c: ClassInfo) -> Node:
    n = c.node
    if n is None:
        raise CompileError(f'internal compiler error: class {c.name} has no declaration', c.line)
    return n

def field_position(c: ClassInfo, name: str) -> int:
    for k, fld in enumerate(c.fields):
        if fld.name == name:
            return k
    return -1

def resolve_class(mod: Mod, c: ClassInfo):
    # fill a class's fields and defaults, its parent's first (a field may name a class declared later)
    if c.done:
        return
    c.done = True
    node = class_def(c)
    mod.cur = c.module
    saved_vars = mod.tvars
    mod.tvars = c.targs
    if c.parent != '':
        p = mod.find_class(c.parent, node.line)
        resolve_class(mod, p)
        mod.cur = c.module
        c.fields += p.fields
    for fd in val_nodes(node.fields[3]):
        ft = mod.type_name(fd.fields[1])
        if ft == '':
            raise CompileError('this field type is not supported\na field can hold int, bool, str, float, a list, a set, a dict or a class', fd.line)
        before = field_position(c, fd.fields[0].text)
        if before >= 0:
            if c.fields[before].owner == c.name:
                raise CompileError(f"the field '{fd.fields[0].text}' is defined twice", fd.line)
            raise CompileError(f"the field '{fd.fields[0].text}' is already defined by a parent class\nuse a different name", node.line)
        fld = FieldInfo()
        fld.name = fd.fields[0].text
        fld.ty = ft
        fld.is_private = fd.fields[2].flag
        fld.is_const = fd.fields[3].flag
        fld.owner = c.name
        if fd.fields[4].tag == 'n':
            fld.default = val_node(fd.fields[4])
        c.fields.append(fld)
    mod.tvars = saved_vars

def read_module(dir: str, std: str, name: str, line: int) -> str:
    # a module next to the program, else one from the standard library
    text = ''
    try:
        f = open(f'{dir}{name}.tom')
        text = f.read()
        f.close()
    catch IOError:
        try:
            g = open(f'{std}{name}.tom')
            text = g.read()
            g.close()
        catch IOError:
            raise CompileError(f"cannot find the module '{name}'\nlooked for {name}.tom next to the program and in the standard library", line)
    return text

class TopItem:
    # a top-level declaration and the module that wrote it
    node: Node = Node()
    module: str = ''

def top_item(node: Node, module: str) -> TopItem:
    t = TopItem()
    t.node = node
    t.module = module
    return t

def collect_warnings(mod: Mod, own: list[Node], module: str, src: str):
    # the lint findings of one file as finished warnings, in line order, minus those silenced by an `# allow: KIND` comment on their line
    found = lint_items(own)
    lines = src.split('\n')
    taken = [False] * len(found)
    ordered: list[Finding] = []
    for _ in found:
        best = -1
        for i, f in enumerate(found):
            if not taken[i] and (best < 0 or f.line < found[best].line):
                best = i
        taken[best] = True
        ordered.append(found[best])
    for f in ordered:
        text = ''
        if 1 <= f.line and f.line <= len(lines):
            text = lines[f.line - 1]
        if f'allow: {f.kind}' not in text:
            mod.warnings.append(format_error(f.message, f.line, 0, src, warning_path(mod, module), 'warning'))

def warning_path(mod: Mod, module: str) -> str:
    if module == 'main':
        return mod.main_path
    return f'{module}.tom'

# does any declaration use the name bitarray or frozenbitarray (as a value or as a type)?
# does the module declare something called bitarray or frozenbitarray itself? (then the names are its own, not the library's)
def declares_bit_name(items: list[Node]) -> bool:
    for n in items:
        if (n.kind == 'ClassDef' or n.kind == 'FuncDef' or n.kind == 'ConstDef') and (n.fields[0].text == 'bitarray' or n.fields[0].text == 'frozenbitarray'):
            return True
    return False

def mentions_bit_types(items: list[Node]) -> bool:
    for n in items:
        if mentions_bit_node(n):
            return True
    return False

def mentions_bit_node(n: Node) -> bool:
    if (n.kind == 'Name' or n.kind == 'TypeRef') and (n.fields[0].text == 'bitarray' or n.fields[0].text == 'frozenbitarray'):
        return True
    for f in n.fields:
        if mentions_bit_val(f):
            return True
    return False

def mentions_bit_val(v: Val) -> bool:
    if v.tag == 'n':
        return mentions_bit_node(val_node(v))
    if v.tag == 'l' or v.tag == 't':
        for it in v.items:
            if mentions_bit_val(it):
                return True
    return False

def load_items(mod: Mod, dir: str, std: str, src: str, module: str, items: list[TopItem], imports: list[ImportInfo], loaded: list[str]) -> list[Node]:
    # the declarations of src, placed after those of the modules it imports (each module once)
    mod.sources[module] = src
    mod.loading = module
    mine = val_nodes(parse(src).fields[0])
    mod.loading = ''
    bits_imported = False
    for item in mine:
        if item.kind == 'Import':
            wanted = item.fields[0].text
            if wanted == 'bitarray':
                bits_imported = True
            ii = ImportInfo()
            ii.importer = module
            ii.module = wanted
            ii.line = item.line
            for nm in item.fields[1].items:
                ii.names.append(nm.text)
            imports.append(ii)
            if wanted not in loaded:
                mod.cur = module
                loaded.append(wanted)
                load_items(mod, dir, std, read_module(dir, std, wanted, item.line), wanted, items, imports, loaded)
    if module != 'bitarray' and not bits_imported and not declares_bit_name(mine) and mentions_bit_types(mine):
        # bitarray and frozenbitarray need no import: a module that uses either gets `from bitarray import bitarray, frozenbitarray`
        ib = ImportInfo()
        ib.importer = module
        ib.module = 'bitarray'
        ib.names = ['bitarray', 'frozenbitarray']
        imports.append(ib)
        if 'bitarray' not in loaded:
            mod.cur = module
            loaded.append('bitarray')
            load_items(mod, dir, std, read_module(dir, std, 'bitarray', 0), 'bitarray', items, imports, loaded)
    own: list[Node] = []
    for item in mine:
        if item.kind != 'Import':
            own.append(item)
            items.append(top_item(item, module))
    collect_warnings(mod, mine, module, src)
    return own

def build_scopes(mod: Mod, items: list[TopItem], imports: list[ImportInfo]):
    # every module sees its own declarations, the built-ins, and what it imports (D24c)
    for top in items:
        item = top.node
        if item.kind == 'FuncDef' or item.kind == 'ClassDef' or item.kind == 'InterfaceDef' or item.kind == 'ConstDef':
            name = item.fields[0].text
            mod.declare_name(top.module, name, key_of(top.module, name), item.exported, item.line)
    for ii in imports:
        if len(ii.names) == 1 and ii.names[0] == '*':
            # import module: every exported name of the module, written module.name
            for top in items:
                item = top.node
                if top.module == ii.module and item.exported and (item.kind == 'FuncDef' or item.kind == 'ClassDef' or item.kind == 'InterfaceDef' or item.kind == 'ConstDef'):
                    mod.declare_name(ii.importer, ii.module + '.' + item.fields[0].text, key_of(top.module, item.fields[0].text), False, ii.line)
            continue
        for nm in ii.names:
            mod.declare_name(ii.importer, nm, mod.exported_key(ii.module, nm, ii.line), False, ii.line)

def compile_with(mod: Mod, src: str, dir: str, std: str, entry_name: str, mode: str) -> str:
    if mode == 'release':
        mod.mode = 2
        table = open(f'{std}errors.txt')
        mod.errors = table.read().split('\n')
        table.close()
    elif mode == 'normal':
        raise CompileError("the mode 'normal' was renamed to 'release': use --mode release (the old release mode, which printed nothing, is gone)", 0)
    elif mode != 'debug':
        raise CompileError(f"the mode must be debug or release, not '{mode}'", 0)
    mod.loading = 'builtin'
    base = open(f'{std}builtin.tom')
    base_text = base.read()
    base.close()
    mod.sources['builtin'] = base_text
    items: list[TopItem] = [top_item(b, 'builtin') for b in val_nodes(parse(base_text).fields[0])]
    mod.loading = ''
    imports: list[ImportInfo] = []
    loaded: list[str] = []
    user = load_items(mod, dir, std, src, 'main', items, imports, loaded)
    build_scopes(mod, items, imports)
    plain: list[TopItem] = []
    for top in items:
        if is_generic_item(top.node):
            gk = key_of(top.module, top.node.fields[0].text)
            mod.generics[gk] = top.node
            mod.generic_mods[gk] = top.module
        else:
            plain.append(top)
    items = plain
    for top in items:
        item = top.node
        mod.cur = top.module
        if item.kind == 'InterfaceDef':
            ifc = IfaceInfo()
            ifc.name = key_of(top.module, item.fields[0].text)
            ifc.module = top.module
            ifc.line = item.line
            mod.ifaces.append(ifc)
        elif item.kind == 'ClassDef':
            c = ClassInfo()
            c.name = key_of(top.module, item.fields[0].text)
            c.display = item.fields[0].text
            c.module = top.module
            c.node = item
            c.line = item.line
            mod.classes.append(c)
    # parents, interfaces and `implements` lines, resolved in the module that wrote them
    for top in items:
        item = top.node
        mod.cur = top.module
        if item.kind == 'InterfaceDef':
            target = mod.find_iface(key_of(top.module, item.fields[0].text), item.line)
            for pv in item.fields[1].items:
                target.parents.append(mod.iface_key(pv.text, item.line))
        elif item.kind == 'ClassDef':
            c = mod.find_class(key_of(top.module, item.fields[0].text), item.line)
            if item.fields[1].tag == 's':
                c.parent = mod.class_key(item.fields[1].text, item.line)
            for iv in item.fields[2].items:
                c.ifaces.append(mod.iface_key(iv.text, item.line))
        elif item.kind == 'Implements':
            mod.find_class(mod.class_key(item.fields[0].text, item.line), item.line).ifaces.append(mod.iface_key(item.fields[1].text, item.line))
    for c in mod.classes:
        resolve_class(mod, c)
    for top in items:
        item = top.node
        mod.cur = top.module
        if item.kind == 'InterfaceDef':
            target = mod.find_iface(key_of(top.module, item.fields[0].text), item.line)
            for m in val_nodes(item.fields[2]):
                target.reqs.append(function_info(m, mod, 'self'))
    funcs: list[Node] = []
    entry = ''
    for top in items:
        item = top.node
        mod.cur = top.module
        if item.kind == 'FuncDef':
            info = function_info(item, mod, '')
            mod.infos.append(info)
            mod.func_nodes.append(item)
            funcs.append(item)
        elif item.kind == 'ClassDef':
            c = mod.find_class(key_of(top.module, item.fields[0].text), item.line)
            for m in val_nodes(item.fields[4]):
                info = function_info(m, mod, c.name)
                mod.infos.append(info)
                mod.func_nodes.append(m)
                funcs.append(m)
                if m.fields[6].tag == 's' and m.fields[6].text == 'init':
                    c.init = info.name
        elif item.kind == 'InterfaceDef' or item.kind == 'Implements':
            pass
        elif item.kind == 'ConstDef':
            cv = val_node(item.fields[1])
            if cv.kind == 'UnOp' and cv.fields[0].text == '-':
                cv = val_node(cv.fields[1])
            if not (cv.kind == 'IntLit' or cv.kind == 'FloatLit' or cv.kind == 'StrLit' or cv.kind == 'BoolLit'):
                raise CompileError(f"the constant '{item.fields[0].text}' must be a number, text or True or False written out\na constant is not code: write its value as a literal, such as 3.14", item.line)
            mod.consts[key_of(top.module, item.fields[0].text)] = val_node(item.fields[1])
        elif item.kind == 'LlvmDecl':
            decl = function_info(item, mod, '')
            for pt in decl.ptypes:
                if pt == 'File' or (is_rc(pt) and pt != 'str' and not pt.startswith('list[')):
                    raise CompileError('an LLVM function can only take int, bool, float, text and list values, and return int, bool, float and text', item.line)
            mod.llvm_decls.append(decl)
        else:
            raise CompileError(top_level_message(item), item.line)
    for entry in mod.preload:
        parts = entry.split('\n')
        mod.instance_class(parts[0], parts[1:], 0)
    mod.populate_pending()
    check_classes(mod)
    check_class_shapes(mod)
    mod.late = True
    for item in user:
        if item.kind == 'FuncDef' and item.fields[6].tag == 's' and item.fields[6].text == 'entry:' + entry_name:
            entry = item.fields[0].text
            if item.fields[2].tag != 'z':
                raise CompileError('an entry point (a function marked with @main or similar) cannot return a value', item.line)
    if entry == '':
        raise CompileError(f'no function is marked @{entry_name}\nwrite @{entry_name} on the line above the function that should start the program', 0)
    bodies = ''
    for k, f in enumerate(funcs):
        if not mod.infos[k].is_gen:          # a generator is compiled where a for loop uses it
            if mod.infos[k].is_async:
                bodies += f'{compile_async_function(f, mod, mod.infos[k])}\n'
            else:
                bodies += f'{compile_function(f, mod, mod.infos[k])}\n'
    # compiling a function can ask for more helper functions, so the list may grow while this runs
    done = 0
    while done < len(mod.extra_funcs):
        if not mod.infos[len(funcs) + done].is_gen:
            bodies += f'{compile_function(mod.extra_funcs[done], mod, mod.infos[len(funcs) + done])}\n'
        done += 1
    for c in mod.classes:
        bodies += f'{compile_constructor(c, mod)}\n'
    for fr in mod.frames:
        mod.classes.append(fr)
    if len(mod.frames) > 0:
        bodies += scheduler_ir(mod)
    mod.cur = 'main'
    wrapper = entry_wrapper(mod.find(entry, 1), mod)
    out = '; written by the Tomato compiler in Tomato (compiler/src/compiler.tom)\n'
    out += declarations(mod) + class_types(mod) + runtime_tables(mod) + vtables(mod)
    for j, s in enumerate(mod.strings):
        out += f'{string_global(j, s)}\n'
        out += f'{string_c(j, s)}\n'
    out += f'\n{bodies}'
    out += wrapper
    return out

def located(mod: Mod, message: str, line: int, col: int, module: str, path: str) -> str:
    # the error as the user sees it: the message, then the place and the source line of the module it is in
    if module in mod.sources:
        where = path
        if module != 'main':
            where = f'{module}.tom'
        return format_error(message, line, col, mod.sources[module], where)
    return format_error(message, 0, 0, '', '')

export def compile_module(src: str, dir: str, std: str, entry_name: str, mode: str = 'debug', path: str = '') -> str:
    # LLVM IR for the program, or a Diagnostic whose message is the finished error text
    mod = Mod()
    result = ''
    early: list[str] = []
    for attempt in range(40):
        mod = Mod()
        mod.preload = early
        mod.main_path = path
        try:
            result = compile_with(mod, src, dir, std, entry_name, mode)
        catch NeedsEarlyCopy as again:
            early.append(again.message)
            continue
        catch LexError as e:
            raise Diagnostic(located(mod, e.message, e.line, e.col, mod.loading, path))
        catch ParseError as e:
            raise Diagnostic(located(mod, e.message, e.line, e.col, mod.loading, path))
        catch CompileError as e:
            raise Diagnostic(located(mod, e.message, e.line, e.col, mod.cur, path))
        for warning in mod.warnings:
            for text_line in warning.split('\n'):
                result += f';! {text_line}\n'
        return result
    raise Diagnostic('internal compiler error: too many generic copies had to be made early')
