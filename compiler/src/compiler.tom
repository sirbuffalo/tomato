# The Tomato compiler, written in Tomato (D38a). It compiles itself, and it is the only implementation.
#
# It takes the syntax tree from compiler/src/parser.tom and writes LLVM IR text that links with the C runtime
# (runtime/tomato_rt.c). compile_module at the end is the entry point: it loads std/builtin.tom and every imported module,
# collects the classes, interfaces and functions (Mod), then compiles each function (Gen) and adds the type tables.
# Types are written as short texts: int, str, list[int], @Class, %Interface, U:a;b for a union, str? for str | None, and
# iN / uN for fixed-width integers. Heap values are reference counted: whoever an expression's value is handed to owns it.
# A problem with the program is raised as a CompileError and reported by diag.tom.
from parser import Node, Val, parse, is_operator_marker, ParseError, val_node, val_nodes, vn
from lexer import LexError
from diag import Diagnostic, format_error, closest

export class CompileError(Error):
    line: int = 0
    col: int = 0

    @init
    def make(self, message: str, line: int, col: int = 0):
        Error.start(self, message)
        self.line = line
        self.col = col

def basic_type(name: str) -> bool:
    return name == 'int' or name == 'bool' or name == 'str' or name == 'File' or name == 'float'

def is_list(t: str) -> bool:
    return t.startswith('list[') or t.startswith('tuple[')

def is_dict(t: str) -> bool:
    return t.startswith('dict[')

def is_set(t: str) -> bool:
    return t.startswith('set[')

# the type inside the brackets: the item type of list[T], tuple[T] and set[T], the value type of dict[V] (whose keys are text)
def elem_of(t: str) -> str:
    return t[t.find('[') + 1:-1]

def set_elem(t: str) -> str:
    return elem_of(t)

def dict_value(t: str) -> str:
    return elem_of(t)

def is_class(t: str) -> bool:
    return t.startswith('@')

def is_iface(t: str) -> bool:
    return t.startswith('%')

def is_union(t: str) -> bool:
    # a union of several types is written 'U:' and its members (sorted, so the same members always give the same type) joined by ';'
    return t.startswith('U:')

def union_members(t: str) -> list[str]:
    return t[2:].split(';')

def union_type(members: list[str]) -> str:
    return 'U:' + ';'.join(sorted(members))

def box_kind(member: str) -> int:
    # how the runtime prints a boxed value: 1 whole number, 3 float, 4 text, 5 bool, 6 anything else
    if member == 'int':
        return 1
    if member == 'float':
        return 3
    if member == 'str':
        return 4
    if member == 'bool':
        return 5
    return 6

def digits_value(s: str) -> int:
    # the number a text of digits writes, or -1 when it is not all digits
    if len(s) == 0:
        return -1
    v = 0
    for c in s:
        d = '0123456789'.find(c)
        if d < 0:
            return -1
        v = v * 10 + d
    return v

def is_fixed(t: str) -> bool:
    # int[length=N] is written iN and uint[length=N] uN
    if len(t) < 2:
        return False
    if not (t.startswith('i') or t.startswith('u')):
        return False
    return digits_value(t[1:]) > 0

def is_numeric(t: str) -> bool:
    return t == 'int' or is_fixed(t)

def bits_of(t: str) -> int:
    if t == 'int':
        return 64
    return digits_value(t[1:])

def is_signed(t: str) -> bool:
    return t == 'int' or t.startswith('i')

def contains(outer: str, inner: str) -> bool:
    # every value of integer type inner is a value of outer
    if is_signed(outer):
        if is_signed(inner):
            return bits_of(outer) >= bits_of(inner)
        return bits_of(outer) > bits_of(inner)
    if is_signed(inner):
        return False
    return bits_of(outer) >= bits_of(inner)

def fits_literal(n: int, t: str, negative: bool) -> bool:
    # does the literal n (written with a minus sign when negative) fit the integer type t?
    bits = bits_of(t)
    if is_signed(t):
        if bits >= 64:
            return True
        if negative:
            return n <= 2 ** (bits - 1)
        return n <= 2 ** (bits - 1) - 1
    if negative:
        return n == 0
    if bits >= 63:
        return True
    return n <= 2 ** bits - 1

def operator_marker_of(op: str) -> str:
    # the marker of the method that implements an operator ('' when the operator cannot be customised)
    if op == '+':
        return 'add'
    if op == '-':
        return 'sub'
    if op == '*':
        return 'mul'
    if op == '/':
        return 'div'
    if op == '//':
        return 'floordiv'
    if op == '%':
        return 'mod'
    if op == '**':
        return 'pow'
    if op == '==' or op == '!=':
        return 'eq'
    if op == '<':
        return 'lt'
    if op == '<=':
        return 'le'
    if op == '>':
        return 'gt'
    if op == '>=':
        return 'ge'
    return ''

def is_optional(t: str) -> bool:
    return t.endswith('?')

def strip_optional(t: str) -> str:
    if is_optional(t):
        return t[:-1]
    return t

def is_rc(t: str) -> bool:
    # heap values are reference counted; None is the null pointer, which counting ignores (D23b)
    return t == 'str' or is_list(t) or is_dict(t) or is_set(t) or is_class(t) or is_iface(t) or t == 'None' or is_optional(t) or is_union(t)

def shown(t: str) -> str:
    # a type as the user writes it
    if is_optional(t):
        return shown(strip_optional(t)) + ' | None'
    if is_class(t) or is_iface(t):
        return t[1:]
    if is_union(t):
        parts: list[str] = []
        for m in union_members(t):
            parts.append(shown(m))
        return ' | '.join(parts)
    if t.startswith('tuple['):
        return 'tuple[' + shown(elem_of(t)) + ']'
    if is_list(t):
        return 'list[' + shown(elem_of(t)) + ']'
    if is_dict(t):
        return 'dict[str, ' + shown(dict_value(t)) + ']'
    if is_set(t):
        return 'set[' + shown(set_elem(t)) + ']'
    if is_fixed(t):
        if t.startswith('i'):
            return 'int[length=' + t[1:] + ']'
        return 'uint[length=' + t[1:] + ']'
    return t

def llvm_type(t: str) -> str:
    if is_rc(t) or t == 'File':
        return 'ptr'
    if t == 'float':
        return 'double'
    if is_fixed(t):
        return 'i' + t[1:]
    return 'i64'

def zero_of(t: str) -> str:
    # the value a function returns when it never stored one
    if t == 'int':
        return '1'
    if is_rc(t):
        return 'null'
    if t == 'float':
        return '0.0'
    return '0'

# a class or interface name that nothing declares or imports
def not_found(what: str, name: str, line: int) -> CompileError:
    return CompileError("the " + what + " '" + name + "' does not exist\ncheck its spelling, or import it with 'from module import " + name + "'", line)

class Ex:
    # a compiled expression: the register or constant that holds it, and its Tomato type
    reg: str = ''
    ty: str = ''

def ex(reg: str, ty: str) -> Ex:
    e = Ex()
    e.reg = reg
    e.ty = ty
    return e

class FuncInfo:
    name: str = ''
    owner: str = ''          # the class a method belongs to, or ''
    ret: str = ''
    ptypes: list[str] = []   # without self
    pnames: list[str] = []   # the names of the parameters, in order
    stars: int = 0           # how many trailing parameters are *args or **kwargs
    has_varargs: bool = False
    has_kwargs: bool = False
    defaults: list[Node] = []     # the default values of the last parameters, in order
    is_init: bool = False
    op: str = ''           # the operator a method implements (@add and the other operator markers), or ''
    is_override: bool = False
    is_private: bool = False
    is_gen: bool = False     # the body has a yield: a generator, only usable as what a for loop loops over
    key: str = ''            # the program-wide name of a function (module.name outside the main program)
    module: str = 'main'

class ImportInfo:
    importer: str = ''
    module: str = ''
    names: list[str] = []
    line: int = 0

class IfaceInfo:
    name: str = ''
    module: str = 'main'
    parents: list[str] = []
    reqs: list[FuncInfo] = []     # the methods the interface itself requires (without self)
    line: int = 0

class FieldInfo:
    name: str = ''
    ty: str = ''
    is_private: bool = False
    is_const: bool = False
    owner: str = ''                # the class that declares the field
    default: Node | None = None   # the starting value, when the field has one

class ClassInfo:
    name: str = ''                # the program-wide key (module.Name outside the main program)
    display: str = ''             # the name as written
    module: str = 'main'
    node: Node | None = None
    fields: list[FieldInfo] = []  # parent fields first
    init: str = ''                # the name of the @init method, or ''
    parent: str = ''              # the parent class, or ''
    ifaces: list[str] = []        # the interfaces the class declares it implements
    done: bool = False            # fields and defaults are complete (inherited ones come first)
    line: int = 0

class Binding:
    # a name a module can see, and the program-wide key it stands for
    module: str = ''
    name: str = ''
    key: str = ''
    exported: bool = False

class Mod:
    # what every function of the program shares
    mode: int = 1                 # error output: 1 debug (full text), 2 normal (short codes), 3 release (nothing) (D34a)
    errors: list[str] = []        # the messages of std/errors.txt: the code of a message is its line number (normal mode)
    strings: list[str] = []       # the text constants, in the order they are numbered
    string_index: dict[str, int] = {}
    infos: list[FuncInfo] = []
    llvm_decls: list[FuncInfo] = []    # the `!name(...)` functions the program declares (D27a)
    consts: dict[str, Node] = {}  # module constants (export const pi = 3.14): the literal each program-wide name stands for
    decls: list[str] = []         # extra declarations (the overflow intrinsics the program uses)
    codes: list[str] = []         # the heap types the program uses; a type's code is 2 plus its place here
    code_index: dict[str, int] = {}
    classes: list[ClassInfo] = []
    ifaces: list[IfaceInfo] = []
    slots: list[str] = []         # method names, one vtable slot each
    cur: str = 'main'             # the module whose names are being resolved
    loading: str = ''             # the module being parsed, for a syntax error
    scope: list[Binding] = []     # the names each module can see, in the order they were declared
    helpers: dict[str, FuncInfo] = {}  # functions the compiler writes for itself (printing a list, sorted, ...), by kind and type
    extra_funcs: list[Node] = []
    func_nodes: list[Node] = []   # the FuncDef of each entry of infos, in the same order
    sources: dict[str, str] = {}  # the source text of each module loaded (for showing an error's line)
    helper_count: int = 0

    def code_of(self, t: str) -> int:
        if t in self.code_index:
            return self.code_index[t]
        self.codes.append(t)
        code = len(self.codes) + 1
        self.code_index[t] = code
        return code

    def failure_text(self, message: str, line: int) -> str:
        # what a failure the language raises says in this error mode (D34a): the message, a short code, or nothing
        if self.mode == 1:
            return message
        if self.mode == 3:
            return ''
        kind = 99
        for k, known in enumerate(self.errors):
            if known != '' and message.startswith(known):
                kind = k + 1
                break
        text = str(kind)
        if kind < 10:
            text = '0' + text
        return 'E' + text + ':' + str(line)

    def declare(self, text: str):
        if not (text in self.decls):
            self.decls.append(text)

    def intern(self, s: str) -> str:
        if not (s in self.string_index):
            self.string_index[s] = len(self.strings)
            self.strings.append(s)
        return '@.str.' + str(self.string_index[s])

    def helper(self, kind: str, ty: str, line: int) -> FuncInfo:
        # a function the compiler writes in Tomato for one kind of value (showing a list, sorting one, ...), made the first time it
        # is needed and compiled with the program
        key = kind + ':' + ty
        if key in self.helpers:
            return self.helpers[key]
        self.helper_count += 1
        name = '_' + kind + str(self.helper_count)
        fkey = key_of('builtin', name)
        saved = self.cur
        self.cur = 'builtin'
        self.declare_name('builtin', name, fkey, False, 0)
        text = helper_source(self, name, kind, ty, line)
        item = val_nodes(parse(text).fields[0])[0]
        info = function_info(item, self, '')
        helper_types(self, info, kind, ty)
        self.cur = saved
        self.helpers[key] = info
        self.infos.append(info)
        self.func_nodes.append(item)
        self.extra_funcs.append(item)
        return info

    def node_of(self, info: FuncInfo) -> Node:
        for k, f in enumerate(self.infos):
            if f.key == info.key and f.owner == info.owner and f.name == info.name:
                return self.func_nodes[k]
        raise CompileError("internal compiler error: no definition for '" + info.name + "'", 0)

    def find(self, key: str, line: int) -> FuncInfo:
        for f in self.infos:
            if f.key == key and f.owner == '':
                return f
        raise CompileError("the function '" + key + "' does not exist", line)

    def lookup_method(self, cls: str, name: str) -> FuncInfo | None:
        # the method as the class or its nearest parent defines it
        for f in self.infos:
            if f.name == name and f.owner == cls:
                return f
        c = self.find_class(cls, 0)
        if c.parent != '':
            return self.lookup_method(c.parent, name)
        return None

    def find_op(self, cls: str, marker: str) -> FuncInfo | None:
        # the method of the class (or its nearest parent) marked as implementing this operator
        for fi in self.infos:
            if fi.owner == cls and fi.op == marker:
                return fi
        c = self.find_class(cls, 0)
        if c.parent != '':
            return self.find_op(c.parent, marker)
        return None

    def has_op(self, cls: str, marker: str) -> bool:
        return self.find_op(cls, marker) is not None

    def find_method(self, cls: str, name: str, line: int) -> FuncInfo:
        found = self.lookup_method(cls, name)
        if found is None:
            raise CompileError("'" + cls + "' has no method '" + name + "'", line)
        return found

    def resolve(self, name: str) -> str:
        # the program-wide key a name written in the current module stands for, or '' (D24c)
        found = self.binding(self.cur, name)
        if found is None:
            found = self.binding('builtin', name)
        if found is None:
            return ''
        return found.key

    def binding(self, module: str, name: str) -> Binding | None:
        for b in self.scope:
            if b.module == module and b.name == name:
                return b
        return None

    def class_key(self, name: str, line: int) -> str:
        key = self.resolve(name)
        if key == '' or not self.has_class(key):
            raise not_found('class', name, line)
        return key

    def iface_key(self, name: str, line: int) -> str:
        key = self.resolve(name)
        if key == '' or not self.has_iface(key):
            raise not_found('interface', name, line)
        return key

    def declare_name(self, module: str, name: str, key: str, exported: bool, line: int):
        if self.binding(module, name) is not None:
            raise CompileError("'" + name + "' is defined twice in module '" + module + "'\nrename one of them", line)
        b = Binding()
        b.module = module
        b.name = name
        b.key = key
        b.exported = exported
        self.scope.append(b)

    def exported_key(self, module: str, name: str, line: int) -> str:
        b = self.binding(module, name)
        if b is not None:
            if not b.exported:
                raise CompileError("module '" + module + "' does not export '" + name + "'\nput 'export' before its definition in " + module + ".tom", line)
            return b.key
        raise CompileError("module '" + module + "' has no '" + name + "'\ncheck the spelling in " + module + ".tom", line)

    def has_iface(self, name: str) -> bool:
        for i in self.ifaces:
            if i.name == name:
                return True
        return False

    def find_iface(self, name: str, line: int) -> IfaceInfo:
        for i in self.ifaces:
            if i.name == name:
                return i
        raise not_found('interface', name, line)

    def iface_closure(self, name: str, out: list[str]):
        # the interface and every interface it extends
        if name in out:
            return
        out.append(name)
        for p in self.find_iface(name, 0).parents:
            self.iface_closure(p, out)

    def class_ifaces(self, cls: str) -> list[str]:
        # every interface a class satisfies: its own, its parents', and what those extend
        out: list[str] = []
        c = self.find_class(cls, 0)
        for i in c.ifaces:
            self.iface_closure(i, out)
        if c.parent != '':
            for i in self.class_ifaces(c.parent):
                self.iface_closure(i, out)
        return out

    def requirement(self, iface: str, name: str) -> FuncInfo | None:
        # the method an interface (or one it extends) requires
        closure: list[str] = []
        self.iface_closure(iface, closure)
        for i in closure:
            for r in self.find_iface(i, 0).reqs:
                if r.name == name:
                    return r
        return None

    def slot_of(self, name: str) -> int:
        for k, n in enumerate(self.slots):
            if n == name:
                return k
        raise CompileError('internal compiler error: no method table slot for ' + name, 0)

    def assignable(self, a: str, b: str) -> bool:
        # may a value of type a be used where b is wanted (no conversion needed)?
        if a == b or self.subclass(a, b):
            return True
        if is_iface(b):
            if is_class(a) and self.has_class(a[1:]):
                return b[1:] in self.class_ifaces(a[1:])
            if is_iface(a):
                closure: list[str] = []
                self.iface_closure(a[1:], closure)
                return b[1:] in closure
            return False
        if is_optional(b):
            return a == 'None' or self.assignable(a, strip_optional(b))
        return False

    def subclass(self, a: str, b: str) -> bool:
        # is class a (written '@A') the same as b or a descendant of it?
        if a == b:
            return True
        if not (is_class(a) and is_class(b)) or not self.has_class(a[1:]):
            return False
        c = self.find_class(a[1:], 0)
        if c.parent == '':
            return False
        return self.subclass('@' + c.parent, b)

    def has_class(self, name: str) -> bool:
        for c in self.classes:
            if c.name == name:
                return True
        return False

    def find_class(self, name: str, line: int) -> ClassInfo:
        for c in self.classes:
            if c.name == name:
                return c
        raise not_found('class', name, line)

    def field_index(self, c: ClassInfo, name: str, line: int) -> int:
        k = field_position(c, name)
        if k >= 0:
            return k
        raise CompileError("'" + c.name + "' has no field '" + name + "'", line)

    def has_none_member(self, members: list[Node]) -> bool:
        found = False
        for m in members:
            if m.fields[0].text == 'None':
                found = True
        return found

    def union_of(self, members: list[Node]) -> str:
        # a union of several types (D23g): each member is a type the compiler knows, none repeated
        names: list[str] = []
        inner = ''
        parts: list[str] = []
        for m in members:
            inner = self.type_name(vn(m))
            if inner == '' or is_fixed(inner) or is_optional(inner):
                return ''
            parts = [inner]
            if is_union(inner):
                parts = union_members(inner)
            for x in parts:
                if x in names:
                    return ''
                names.append(x)
        return union_type(names)

    def type_name(self, v: Val) -> str:
        # the name of a type the compiler knows: int, bool, str, a declared class ('@Name') or a list of those; '' otherwise
        if v.tag != 'n':
            return ''
        t = val_node(v)
        name = t.fields[0].text
        if (name == 'int' or name == 'uint') and t.fields[1].tag == 'n':
            length = val_node(t.fields[1])
            if length.kind != 'IntLit' or length.fields[0].num < 1 or length.fields[0].num > 64:
                return ''
            if name == 'int':
                return 'i' + str(length.fields[0].num)
            return 'u' + str(length.fields[0].num)
        if name == 'union':
            members = val_nodes(t.fields[2])
            if len(members) != 2 or not self.has_none_member(members):
                if self.has_none_member(members):
                    return ''
                return self.union_of(members)
            other = members[0]
            if other.fields[0].text == 'None':
                other = members[1]
            elif members[1].fields[0].text != 'None':
                return ''
            wrapped = self.type_name(vn(other))
            if not (wrapped == 'str' or is_list(wrapped) or is_dict(wrapped) or is_set(wrapped) or is_class(wrapped) or is_iface(wrapped)):
                return ''
            return wrapped + '?'
        if name == 'set' and t.fields[2].tag == 'n':
            member = self.type_name(t.fields[2])
            if member == 'str' or member == 'int' or member == 'bool':
                return 'set[' + member + ']'
            return ''
        if name == 'dict' and t.fields[2].tag == 'n' and t.fields[3].tag == 'n':
            if self.type_name(t.fields[2]) != 'str':
                return ''
            inner = self.type_name(t.fields[3])
            if inner == '' or is_fixed(inner):
                return ''
            return 'dict[' + inner + ']'
        if (name == 'list' or name == 'tuple') and t.fields[2].tag == 'n' and t.fields[1].tag == 'z':
            inner = self.type_name(t.fields[2])
            if inner == '' or is_fixed(inner):
                return ''
            return name + '[' + inner + ']'
        if t.fields[2].tag != 'z' or t.fields[1].tag != 'z':
            return ''
        if basic_type(name):
            return name
        key = self.resolve(name)
        if key != '' and self.has_class(key):
            return '@' + key
        if key != '' and self.has_iface(key):
            return '%' + key
        return ''

!tomato_str_nbytes(s: str) -> int
!tomato_str_byte(s: str, i: int) -> int

def escape_byte(b: int) -> str:
    # one byte of a text constant as LLVM writes it: printable ASCII as itself, anything else as \XX (D17a-b: text is UTF-8)
    ascii = ' !"#$%&\'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~'
    if b >= 32 and b < 127 and b != 34 and b != 92:
        return ascii[b - 32]
    digits = '0123456789ABCDEF'
    return '\\' + digits[b // 16] + digits[b % 16]

def escape_text(s: str) -> str:
    body = ''
    for i in range(!tomato_str_nbytes(s)):
        body += escape_byte(!tomato_str_byte(s, i))
    return body

def string_global(index: int, s: str) -> str:
    size = str(!tomato_str_nbytes(s) + 1)
    body = escape_text(s)
    return '@.str.' + str(index) + ' = private constant { i64, i64, i64, i64, [' + size + ' x i8] } { i64 -1, i64 1, i64 ' + str(!tomato_str_nbytes(s)) + ', i64 ' + str(len(s)) + ', [' + size + ' x i8] c"' + body + '\\00" }'

def string_c(index: int, s: str) -> str:
    # a plain C copy, which is what tomato_fail prints
    return '@.str.' + str(index) + '.c = private constant [' + str(!tomato_str_nbytes(s) + 1) + ' x i8] c"' + escape_text(s) + '\\00"'

class TryInfo:
    # a try statement being compiled (D22a)
    catch_l: str = ''         # where an error raised in the body goes
    prop_l: str = ''          # where an error leaving the statement goes (after the finally block runs)
    final: list[Node] = []
    has_final: bool = False
    loop_depth: int = 0
    state: str = 'body'       # 'body' while compiling the try body, then 'post'

class GenCtx:
    # one generator being compiled into a for loop: where the loop variable lives, the loop body, and the scope not currently in use
    var: str = ''
    ty: str = ''
    body: list[Node] = []
    end: str = ''
    try_depth: int = 0
    slots: dict[str, str] = {}
    types: dict[str, str] = {}
    narrowed: list[str] = []
    ret: str = ''
    owner: str = ''
    in_init: bool = False
    module: str = ''

class Gen:
    # one function being compiled
    mod: Mod = Mod()
    lines: list[str] = []
    allocas: list[str] = []
    rc_slots: list[str] = []
    kw: list[Val] = []            # the keyword arguments of the call being compiled, picked up by call_function
    narrowed: list[str] = []      # variables that are narrowed from a union inside the branch being compiled
    slots: dict[str, str] = {}
    types: dict[str, str] = {}
    n: int = 0
    terminated: bool = False
    breaks: list[str] = []
    conts: list[str] = []
    loop_depth: int = 0
    tries: list[TryInfo] = []
    try_depth: int = 0
    slot_count: int = 0
    line: int = 0
    owner: str = ''           # the class whose method is being compiled, or ''
    in_init: bool = False
    ret: str = ''
    gens: list[GenCtx] = []   # the generators being compiled into for loops, innermost last (only the first gen_n count)
    gen_n: int = 0

    def tmp(self, hint: str) -> str:
        self.n += 1
        return '%' + hint + '.' + str(self.n)

    def label(self, hint: str) -> str:
        self.n += 1
        return hint + '.' + str(self.n)

    def emit(self, text: str):
        if self.terminated:
            self.lines.append(self.label('dead') + ':')
            self.terminated = False
        self.lines.append('  ' + text)

    def place(self, label: str):
        self.lines.append(label + ':')
        self.terminated = False

    def br(self, label: str):
        self.emit('br label %' + label)
        self.terminated = True

    def cond_br(self, c: str, yes: str, no: str):
        self.emit('br i1 ' + c + ', label %' + yes + ', label %' + no)
        self.terminated = True

    def unwind_target(self) -> str:
        # where an error raised here goes: the innermost try's catch (or its finally once past the body), else out of
        # the function, which returns early so that its caller can check (D22a)
        if self.try_depth > 0:
            t = self.tries[self.try_depth - 1]
            if t.state == 'body':
                return t.catch_l
            return t.prop_l
        return 'epilogue'

    def slot(self, name: str, ty: str, line: int) -> str:
        if name in self.slots:
            if self.types[name] != ty:
                raise CompileError("the variable '" + name + "' already has type " + shown(self.types[name]) + ", so it cannot be redeclared as " + shown(ty), line)
            return self.slots[name]
        return self.new_slot(name, ty)

    def new_slot(self, name: str, ty: str) -> str:
        self.slot_count += 1
        reg = '%v.' + name + '.' + str(self.slot_count)
        self.allocas.append('  ' + reg + ' = alloca ' + llvm_type(ty))
        if is_rc(ty):
            self.allocas.append('  store ptr null, ptr ' + reg)
            self.rc_slots.append(reg)
        self.slots[name] = reg
        self.types[name] = ty
        return reg

    def hidden_slot(self, hint: str) -> str:
        reg = self.tmp(hint)
        self.allocas.append('  ' + reg + ' = alloca i64')
        return reg

    def hidden_rc_slot(self, hint: str) -> str:
        reg = self.tmp(hint)
        self.allocas.append('  ' + reg + ' = alloca ptr')
        self.allocas.append('  store ptr null, ptr ' + reg)
        self.rc_slots.append(reg)
        return reg

    # ---- reference counting
    def retain(self, e: Ex):
        if is_rc(e.ty):
            self.emit('call void @tomato_retain(ptr ' + e.reg + ')')

    def release(self, e: Ex):
        if is_rc(e.ty):
            self.emit('call void @tomato_release(ptr ' + e.reg + ')')

    def store_owned(self, slot: str, e: Ex):
        # the slot takes over the reference and releases what it held
        if is_rc(e.ty):
            old = self.tmp('old')
            self.emit(old + ' = load ptr, ptr ' + slot)
            self.emit('store ptr ' + e.reg + ', ptr ' + slot)
            self.emit('call void @tomato_release(ptr ' + old + ')')
        else:
            self.emit('store ' + llvm_type(e.ty) + ' ' + e.reg + ', ptr ' + slot)

    def unwrap(self, e: Ex, line: int) -> Ex:
        # an optional used where a value is needed: stop when it is None (D23b)
        if not is_optional(e.ty):
            return e
        bad = self.tmp('isnone')
        self.emit(bad + ' = icmp eq ptr ' + e.reg + ', null')
        self.fail_if(bad, 'None where a value is needed')
        return ex(e.reg, strip_optional(e.ty))

    def resize(self, e: Ex, to: str) -> Ex:
        # the same number in another integer type that holds all of its values
        if to == 'int' and e.ty != 'int':
            if bits_of(e.ty) < 62:
                return self.tag_small(self.widen(e, 64))
            return self.int_from_machine(self.widen(e, 64), is_signed(e.ty))
        fb = bits_of(e.ty)
        tb = bits_of(to)
        if fb == tb:
            return ex(e.reg, to)
        r = self.tmp('ext')
        op = 'zext'
        if is_signed(e.ty):
            op = 'sext'
        self.emit(r + ' = ' + op + ' ' + llvm_type(e.ty) + ' ' + e.reg + ' to ' + llvm_type(to))
        return ex(r, to)

    def want(self, e: Ex, ty: str, line: int, what: str) -> Ex:
        # check that e fits the type ty and return it as that type (a number is widened, an optional unwrapped)
        if is_optional(e.ty) and not is_optional(ty) and ty != 'None' and self.mod.assignable(strip_optional(e.ty), ty):
            self.unwrap(e, line)
            return ex(e.reg, strip_optional(e.ty))
        if e.ty == ty:
            return e
        if is_numeric(e.ty) and is_numeric(ty):
            if not contains(ty, e.ty):
                raise CompileError(what + ' has type ' + shown(e.ty) + ', but ' + shown(ty) + ' is expected\nconvert it explicitly first', line)
            return self.resize(e, ty)
        if is_union(ty) and not is_union(e.ty):
            return self.box_value(e, ty, line, what)
        if not self.mod.assignable(e.ty, ty):
            raise CompileError(what + ' has type ' + shown(e.ty) + ', but ' + shown(ty) + ' is expected', line)
        return e

    def union_member_for(self, vt: str, ty: str) -> str:
        # the member of union ty that a value of type vt belongs to: the same type first, else one it can be used as; '' when none
        members = union_members(ty)
        if vt in members:
            return vt
        for m in members:
            if self.mod.assignable(vt, m):
                return m
        return ''

    def box_value(self, e: Ex, ty: str, line: int, what: str) -> Ex:
        # a value stored where a union is wanted: a small heap object holding the value and which member it is
        member = self.union_member_for(e.ty, ty)
        if member == '':
            raise CompileError(what + ' has type ' + shown(e.ty) + ', but ' + shown(ty) + ' is expected', line)
        if is_numeric(e.ty) and e.ty != member:
            raise CompileError(what + ' has type ' + shown(e.ty) + ', but ' + shown(ty) + ' is expected', line)
        b = self.tmp('box')
        self.emit(b + ' = call ptr @tomato_alloc(i64 32, i64 ' + str(self.mod.code_of('box:' + member)) + ')')
        p = self.tmp('payload')
        self.emit(p + ' = getelementptr i8, ptr ' + b + ', i64 16')
        self.emit('store ' + llvm_type(member) + ' ' + e.reg + ', ptr ' + p)
        k = self.tmp('kind')
        self.emit(k + ' = getelementptr i8, ptr ' + b + ', i64 24')
        self.emit('store i64 ' + str(box_kind(member)) + ', ptr ' + k)
        return ex(b, ty)

    def unbox_value(self, box: Ex, member: str) -> Ex:
        # the value inside a union, as a new reference when it is a heap value
        p = self.tmp('payload')
        self.emit(p + ' = getelementptr i8, ptr ' + box.reg + ', i64 16')
        v = self.tmp('inner')
        self.emit(v + ' = load ' + llvm_type(member) + ', ptr ' + p)
        e = ex(v, member)
        self.retain(e)
        return e

    def box_is(self, box: Ex, member: str) -> str:
        # an i1: is this union holding that member?
        tp = self.tmp('tp')
        self.emit(tp + ' = getelementptr { i64, i64 }, ptr ' + box.reg + ', i32 0, i32 1')
        raw = self.tmp('rawcode')
        self.emit(raw + ' = load i64, ptr ' + tp)
        code = self.tmp('code')
        self.emit(code + ' = and i64 ' + raw + ', 4294967295')
        c = self.tmp('isbox')
        self.emit(c + ' = icmp eq i64 ' + code + ', ' + str(self.mod.code_of('box:' + member)))
        return c

    # ---- small instructions
    def truth(self, e: Ex, line: int) -> str:
        e = self.want(e, 'bool', line, 'a condition')
        r = self.tmp('cond')
        self.emit(r + ' = icmp ne i64 ' + e.reg + ', 0')
        return r

    def bool_of(self, i1: str) -> Ex:
        r = self.tmp('b')
        self.emit(r + ' = zext i1 ' + i1 + ' to i64')
        return ex(r, 'bool')

    def arith(self, op: str, a: str, b: str) -> str:
        r = self.tmp('t')
        self.emit(r + ' = ' + op + ' i64 ' + a + ', ' + b)
        return r

    def icmp(self, cc: str, a: str, b: str) -> Ex:
        c = self.tmp('cmp')
        self.emit(c + ' = icmp ' + cc + ' i64 ' + a + ', ' + b)
        return self.bool_of(c)

    def common_type(self, a: str, b: str, line: int) -> str:
        if contains(a, b):
            return a
        if contains(b, a):
            return b
        raise CompileError('these integer types have no common type: ' + shown(a) + ' and ' + shown(b) + '\nconvert one of them explicitly first', line)

    # ---- unlimited-size integers (D05c): an int is a tagged word, and the runtime does the arithmetic
    def int_call(self, name: str, a: str, b: str) -> Ex:
        r = self.tmp('int')
        self.emit(r + ' = call i64 @tomato_int_' + name + '(i64 ' + a + ', i64 ' + b + ')')
        return ex(r, 'int')

    def tag_small(self, raw: str) -> Ex:
        # a machine number known to be small (a length, a loop counter, a position) as an int
        s = self.tmp('shl')
        self.emit(s + ' = shl i64 ' + raw + ', 1')
        t = self.tmp('tag')
        self.emit(t + ' = or i64 ' + s + ', 1')
        return ex(t, 'int')

    def int_from_machine(self, raw: str, signed: bool) -> Ex:
        # any 64-bit machine number (or an unsigned one) as an int
        r = self.tmp('int')
        if signed:
            self.emit(r + ' = call i64 @tomato_int_from_i64(i64 ' + raw + ')')
        else:
            self.emit(r + ' = call i64 @tomato_int_from_u64(i64 ' + raw + ')')
        return ex(r, 'int')

    def int_raw(self, e: Ex) -> str:
        # the machine number for places that need one (an index, a range bound); stops when the int is too big
        r = self.tmp('raw')
        self.emit(r + ' = call i64 @tomato_int_raw(i64 ' + e.reg + ')')
        return r

    def int_zero_check(self, b: Ex, message: str):
        sign = self.tmp('sign')
        self.emit(sign + ' = call i32 @tomato_int_sign(i64 ' + b.reg + ')')
        zero = self.tmp('zero')
        self.emit(zero + ' = icmp eq i32 ' + sign + ', 0')
        self.fail_if(zero, message)

    def num_arith(self, op: str, a: Ex, b: Ex, line: int) -> Ex:
        # + - * with an overflow stop, in the type both operands fit
        t = self.common_type(a.ty, b.ty, line)
        x = self.resize(a, t)
        y = self.resize(b, t)
        if t == 'int':
            return self.int_call(op, x.reg, y.reg)
        llt = llvm_type(t)
        sg = 'u'
        if is_signed(t):
            sg = 's'
        intr = 'llvm.' + sg + op + '.with.overflow.' + llt
        self.mod.declare('declare {' + llt + ', i1} @' + intr + '(' + llt + ', ' + llt + ')')
        pair = self.tmp('pair')
        self.emit(pair + ' = call {' + llt + ', i1} @' + intr + '(' + llt + ' ' + x.reg + ', ' + llt + ' ' + y.reg + ')')
        r = self.tmp('r')
        self.emit(r + ' = extractvalue {' + llt + ', i1} ' + pair + ', 0')
        ov = self.tmp('ov')
        self.emit(ov + ' = extractvalue {' + llt + ', i1} ' + pair + ', 1')
        self.fail_if(ov, 'integer overflow')
        return ex(r, t)

    def int_compare(self, op: str, x: Ex, y: Ex) -> Ex:
        c = self.tmp('icmp')
        self.emit(c + ' = call i32 @tomato_int_cmp(i64 ' + x.reg + ', i64 ' + y.reg + ')')
        cc = 'eq'
        if op == '!=':
            cc = 'ne'
        elif op == '<':
            cc = 'slt'
        elif op == '<=':
            cc = 'sle'
        elif op == '>':
            cc = 'sgt'
        elif op == '>=':
            cc = 'sge'
        r = self.tmp('cmp')
        self.emit(r + ' = icmp ' + cc + ' i32 ' + c + ', 0')
        return self.bool_of(r)

    def num_compare(self, op: str, a: Ex, b: Ex, line: int) -> Ex:
        t = self.common_type(a.ty, b.ty, line)
        x = self.resize(a, t)
        y = self.resize(b, t)
        if t == 'int':
            return self.int_compare(op, x, y)
        cc = 'eq'
        if op == '!=':
            cc = 'ne'
        elif op != '==':
            sg = 'u'
            if is_signed(t):
                sg = 's'
            if op == '<':
                cc = sg + 'lt'
            elif op == '<=':
                cc = sg + 'le'
            elif op == '>':
                cc = sg + 'gt'
            else:
                cc = sg + 'ge'
        c = self.tmp('cmp')
        self.emit(c + ' = icmp ' + cc + ' ' + llvm_type(t) + ' ' + x.reg + ', ' + y.reg)
        return self.bool_of(c)

    def num_modulo(self, a: Ex, b: Ex, line: int) -> Ex:
        # Python-style: the result has the sign of the divisor (D05au); a zero divisor stops the program
        t = self.common_type(a.ty, b.ty, line)
        x = self.resize(a, t)
        y = self.resize(b, t)
        if t == 'int':
            self.int_zero_check(y, 'modulo by zero')
            return self.int_call('mod', x.reg, y.reg)
        llt = llvm_type(t)
        zero = self.tmp('zero')
        self.emit(zero + ' = icmp eq ' + llt + ' ' + y.reg + ', 0')
        self.fail_if(zero, 'modulo by zero')
        if not is_signed(t):
            r = self.tmp('urem')
            self.emit(r + ' = urem ' + llt + ' ' + x.reg + ', ' + y.reg)
            return ex(r, t)
        r = self.tmp('srem')
        self.emit(r + ' = srem ' + llt + ' ' + x.reg + ', ' + y.reg)
        mix = self.tmp('mix')
        self.emit(mix + ' = xor ' + llt + ' ' + r + ', ' + y.reg)
        differ = self.tmp('differ')
        self.emit(differ + ' = icmp slt ' + llt + ' ' + mix + ', 0')
        nonzero = self.tmp('nonzero')
        self.emit(nonzero + ' = icmp ne ' + llt + ' ' + r + ', 0')
        fix = self.tmp('fix')
        self.emit(fix + ' = and i1 ' + differ + ', ' + nonzero)
        amount = self.tmp('amount')
        self.emit(amount + ' = select i1 ' + fix + ', ' + llt + ' ' + y.reg + ', ' + llt + ' 0')
        out = self.tmp('mod')
        self.emit(out + ' = add ' + llt + ' ' + r + ', ' + amount)
        return ex(out, t)

    def num_floor_divide(self, a: Ex, b: Ex, line: int) -> Ex:
        # //: the quotient rounded toward minus infinity, like Python; a zero divisor stops the program
        t = self.common_type(a.ty, b.ty, line)
        x = self.resize(a, t)
        y = self.resize(b, t)
        if t == 'int':
            self.int_zero_check(y, 'division by zero')
            return self.int_call('floordiv', x.reg, y.reg)
        llt = llvm_type(t)
        zero = self.tmp('zero')
        self.emit(zero + ' = icmp eq ' + llt + ' ' + y.reg + ', 0')
        self.fail_if(zero, 'division by zero')
        if not is_signed(t):
            r = self.tmp('udiv')
            self.emit(r + ' = udiv ' + llt + ' ' + x.reg + ', ' + y.reg)
            return ex(r, t)
        least = self.tmp('least')
        self.emit(least + ' = shl ' + llt + ' 1, ' + str(bits_of(t) - 1))
        is_least = self.tmp('isleast')
        self.emit(is_least + ' = icmp eq ' + llt + ' ' + x.reg + ', ' + least)
        is_minus = self.tmp('isminus')
        self.emit(is_minus + ' = icmp eq ' + llt + ' ' + y.reg + ', -1')
        both = self.tmp('both')
        self.emit(both + ' = and i1 ' + is_least + ', ' + is_minus)
        self.fail_if(both, 'integer overflow')
        q = self.tmp('sdiv')
        self.emit(q + ' = sdiv ' + llt + ' ' + x.reg + ', ' + y.reg)
        r = self.tmp('srem')
        self.emit(r + ' = srem ' + llt + ' ' + x.reg + ', ' + y.reg)
        mix = self.tmp('mix')
        self.emit(mix + ' = xor ' + llt + ' ' + r + ', ' + y.reg)
        differ = self.tmp('differ')
        self.emit(differ + ' = icmp slt ' + llt + ' ' + mix + ', 0')
        nonzero = self.tmp('nonzero')
        self.emit(nonzero + ' = icmp ne ' + llt + ' ' + r + ', 0')
        fix = self.tmp('fix')
        self.emit(fix + ' = and i1 ' + differ + ', ' + nonzero)
        amount = self.tmp('amount')
        self.emit(amount + ' = select i1 ' + fix + ', ' + llt + ' 1, ' + llt + ' 0')
        out = self.tmp('floor')
        self.emit(out + ' = sub ' + llt + ' ' + q + ', ' + amount)
        return ex(out, t)

    def num_bitwise(self, op: str, a: Ex, b: Ex, line: int) -> Ex:
        # & | ^ on two's-complement integers of the common type
        t = self.common_type(a.ty, b.ty, line)
        x = self.resize(a, t)
        y = self.resize(b, t)
        if t == 'int':
            code = '0'
            if op == '|':
                code = '1'
            elif op == '^':
                code = '2'
            r = self.tmp('bit')
            self.emit(r + ' = call i64 @tomato_int_bitop(i64 ' + x.reg + ', i64 ' + y.reg + ', i32 ' + code + ')')
            return ex(r, 'int')
        ins = 'and'
        if op == '|':
            ins = 'or'
        elif op == '^':
            ins = 'xor'
        r = self.tmp('bit')
        self.emit(r + ' = ' + ins + ' ' + llvm_type(t) + ' ' + x.reg + ', ' + y.reg)
        return ex(r, t)

    def num_power(self, a: Ex, b: Ex, line: int) -> Ex:
        # ** on integers: whole-number powers that stop on overflow or a negative exponent; the result type is the
        # common type, converted back with a range check when it is a fixed width
        t = 'int'
        if a.ty != 'int' and b.ty != 'int':
            t = self.common_type(a.ty, b.ty, line)
        x = self.resize(a, 'int')
        y = self.resize(b, 'int')
        sign = self.tmp('expsign')
        self.emit(sign + ' = call i32 @tomato_int_sign(i64 ' + y.reg + ')')
        negative = self.tmp('negexp')
        self.emit(negative + ' = icmp slt i32 ' + sign + ', 0')
        self.fail_if(negative, 'a negative exponent needs a float')
        r = self.tmp('pow')
        self.emit(r + ' = call i64 @tomato_int_pow(i64 ' + x.reg + ', i64 ' + y.reg + ')')
        if t != 'int':
            return self.convert_explicit(ex(r, 'int'), t, line)
        return ex(r, 'int')

    def as_double(self, e: Ex) -> str:
        if e.ty == 'float':
            return e.reg
        return self.to_double(e)

    def float_op(self, op: str, a: Ex, b: Ex, line: int) -> Ex:
        # arithmetic and comparison when either side is a float: the other side is converted to a float
        if not (a.ty == 'float' or is_numeric(a.ty)) or not (b.ty == 'float' or is_numeric(b.ty)):
            raise CompileError("cannot use '" + op + "' with " + shown(a.ty) + ' and ' + shown(b.ty), line)
        x = self.as_double(a)
        y = self.as_double(b)
        if op == '+' or op == '-' or op == '*':
            ins = 'fadd'
            if op == '-':
                ins = 'fsub'
            elif op == '*':
                ins = 'fmul'
            r = self.tmp('f')
            self.emit(r + ' = ' + ins + ' double ' + x + ', ' + y)
            self.check_finite(r)
            return ex(r, 'float')
        if op == '/' or op == '//' or op == '%':
            zero = self.tmp('fzero')
            self.emit(zero + ' = fcmp oeq double ' + y + ', 0.0')
            if op == '%':
                self.fail_if(zero, 'modulo by zero')
            else:
                self.fail_if(zero, 'division by zero')
            r = self.tmp('f')
            if op == '/':
                self.emit(r + ' = fdiv double ' + x + ', ' + y)
            elif op == '//':
                self.emit(r + ' = call double @tomato_floor_div_f64(double ' + x + ', double ' + y + ')')
            else:
                self.emit(r + ' = call double @tomato_mod_f64(double ' + x + ', double ' + y + ')')
            self.check_finite(r)
            return ex(r, 'float')
        if op == '**':
            r = self.tmp('f')
            self.emit(r + ' = call double @tomato_pow_f64(double ' + x + ', double ' + y + ')')
            self.check_finite(r)
            return ex(r, 'float')
        cc = ''
        if op == '==':
            cc = 'oeq'
        elif op == '!=':
            cc = 'une'
        elif op == '<':
            cc = 'olt'
        elif op == '<=':
            cc = 'ole'
        elif op == '>':
            cc = 'ogt'
        elif op == '>=':
            cc = 'oge'
        else:
            raise CompileError("'" + op + "' does not work on floats\nuse it on integers, or use / // or ** on floats", line)
        c = self.tmp('fcmp')
        self.emit(c + ' = fcmp ' + cc + ' double ' + x + ', ' + y)
        return self.bool_of(c)

    def check_finite(self, r: str):
        # a float result that is infinite or not a number stops the program (P58)
        d = self.tmp('diff')
        self.emit(d + ' = fsub double ' + r + ', ' + r)
        ok = self.tmp('finite')
        self.emit(ok + ' = fcmp oeq double ' + d + ', 0.0')
        bad = self.tmp('notfinite')
        self.emit(bad + ' = xor i1 ' + ok + ', true')
        self.fail_if(bad, 'the float result is infinite or not a number')

    def float_call(self, v: Ex, line: int) -> Ex:
        # float(x): a whole number or a float as a float
        if v.ty == 'float':
            return v
        if is_numeric(v.ty):
            return ex(self.to_double(v), 'float')
        raise CompileError('float() takes a number, but this is ' + shown(v.ty), line)

    def float_to_int(self, v: Ex, line: int) -> Ex:
        # int(x) on a float: the whole part, towards zero (P58); infinity and NaN stop
        d = self.tmp('diff')
        self.emit(d + ' = fsub double ' + v.reg + ', ' + v.reg)
        ok = self.tmp('finite')
        self.emit(ok + ' = fcmp oeq double ' + d + ', 0.0')
        bad = self.tmp('notfinite')
        self.emit(bad + ' = xor i1 ' + ok + ', true')
        self.fail_if(bad, 'a float that is infinite or not a number cannot become an int')
        r = self.tmp('whole')
        self.emit(r + ' = call i64 @tomato_f64_to_int(double ' + v.reg + ')')
        return ex(r, 'int')

    def float_literal(self, mantissa: int, scale: int) -> Ex:
        # the digits as a decimal constant, which LLVM rounds to the nearest float
        text = str(mantissa) + '.0e'
        if scale > 0:
            text += '-' + str(scale)
        else:
            text += '+' + str(-scale)
        return ex(text, 'float')

    def to_double(self, e: Ex) -> str:
        if e.ty == 'int':
            d = self.tmp('fp')
            self.emit(d + ' = call double @tomato_int_to_f64(i64 ' + e.reg + ')')
            return d
        r = self.tmp('fp')
        op = 'uitofp'
        if is_signed(e.ty):
            op = 'sitofp'
        self.emit(r + ' = ' + op + ' ' + llvm_type(e.ty) + ' ' + e.reg + ' to double')
        return r

    def num_divide(self, a: Ex, b: Ex, line: int) -> Ex:
        if b.ty == 'int':
            self.int_zero_check(b, 'division by zero')
        else:
            zero = self.tmp('zero')
            self.emit(zero + ' = icmp eq ' + llvm_type(b.ty) + ' ' + b.reg + ', 0')
            self.fail_if(zero, 'division by zero')
        q = self.tmp('div')
        self.emit(q + ' = fdiv double ' + self.to_double(a) + ', ' + self.to_double(b))
        self.check_finite(q)
        return ex(q, 'float')

    def convert_explicit(self, v: Ex, target: str, line: int) -> Ex:
        # int[length=N](x): the same number in another integer type, or a stop when it does not fit (D05p)
        if not is_numeric(v.ty):
            raise CompileError('this conversion needs an integer, but the value is ' + shown(v.ty), line)
        if target == 'int' or contains(target, v.ty):
            return self.resize(v, target)
        if v.ty == 'int':
            ok = self.tmp('inrange')
            sg = '0'
            if is_signed(target):
                sg = '1'
            self.emit(ok + ' = call i32 @tomato_int_in_range(i64 ' + v.reg + ', i32 ' + str(bits_of(target)) + ', i32 ' + sg + ')')
            bad = self.tmp('bad')
            self.emit(bad + ' = icmp eq i32 ' + ok + ', 0')
            self.fail_if(bad, 'the number does not fit the integer type')
            low = self.tmp('low')
            self.emit(low + ' = call i64 @tomato_int_low64(i64 ' + v.reg + ')')
            if bits_of(target) == 64:
                return ex(low, target)
            cut = self.tmp('cut')
            self.emit(cut + ' = trunc i64 ' + low + ' to ' + llvm_type(target))
            return ex(cut, target)
        width = bits_of(v.ty)
        if bits_of(target) > width:
            width = bits_of(target)
        width += 1
        wide = ex(self.widen(v, width), 'int')
        cut = self.tmp('cut')
        self.emit(cut + ' = trunc i' + str(width) + ' ' + wide.reg + ' to ' + llvm_type(target))
        back = self.tmp('back')
        op = 'zext'
        if is_signed(target):
            op = 'sext'
        self.emit(back + ' = ' + op + ' ' + llvm_type(target) + ' ' + cut + ' to i' + str(width))
        bad = self.tmp('bad')
        self.emit(bad + ' = icmp ne i' + str(width) + ' ' + wide.reg + ', ' + back)
        self.fail_if(bad, 'the number does not fit the integer type')
        return ex(cut, target)

    def widen(self, v: Ex, width: int) -> str:
        if bits_of(v.ty) == width:
            return v.reg
        r = self.tmp('wide')
        op = 'zext'
        if is_signed(v.ty):
            op = 'sext'
        self.emit(r + ' = ' + op + ' ' + llvm_type(v.ty) + ' ' + v.reg + ' to i' + str(width))
        return r

    def modulo(self, a: str, b: str) -> str:
        # Python-style: the result has the sign of the divisor (D05au); a zero divisor is not checked yet (P53)
        r = self.arith('srem', a, b)
        x = self.arith('xor', r, b)
        differ = self.icmp('slt', x, '0')
        nonzero = self.icmp('ne', r, '0')
        fix = self.arith('and', differ.reg, nonzero.reg)
        amount = self.arith('mul', fix, b)
        return self.arith('add', r, amount)

    def fail_if(self, bad: str, message: str):
        # bad is an i1; when true, a RuntimeError is raised, which a catch can handle (D22a)
        self.fail_with(bad, 'RuntimeError', message)

    def fail_with(self, bad: str, cls: str, message: str):
        stop = self.label('stop')
        ok = self.label('ok')
        self.cond_br(bad, stop, ok)
        self.place(stop)
        err = self.tmp('err')
        self.emit(err + ' = call ptr @tomato.new.' + str(self.mod.code_of('@' + cls)) + '(ptr ' + self.mod.intern(self.mod.failure_text(message, self.line)) + ')')
        self.emit('store ptr ' + err + ', ptr @tomato_exc')
        self.emit('store i32 ' + str(self.line) + ', ptr @tomato_exc_line')
        self.emit('store i32 1, ptr @tomato_exc_rt')
        self.emit('store i32 1, ptr @tomato_exc_seen')
        self.br(self.unwind_target())
        self.place(ok)

    # ---- expressions
    def expr(self, n: Node, expected: str = '') -> Ex:
        k = n.kind
        if k == 'IntLit':
            return self.int_literal(n.fields[0].num, expected, False, n.line)
        if k == 'FloatLit':
            return self.float_literal(n.fields[0].num, n.fields[1].num)
        if k == 'BoolLit':
            if n.fields[0].flag:
                return ex('1', 'bool')
            return ex('0', 'bool')
        if k == 'StrLit':
            return ex(self.mod.intern(n.fields[0].text), 'str')
        if k == 'Name':
            name = n.fields[0].text
            if name == 'None' and not (name in self.slots):
                return ex('null', 'None')
            if not (name in self.slots):
                ck = self.mod.resolve(name)
                if ck in self.mod.consts:
                    return self.expr(self.mod.consts[ck], expected)
                raise CompileError("name '" + name + "' is not defined" + self.name_hint(name), n.line)
            ty = self.types[name]
            r = self.tmp('l')
            self.emit(r + ' = load ' + llvm_type(ty) + ', ptr ' + self.slots[name])
            e = ex(r, ty)
            self.retain(e)
            return e
        if k == 'UnOp':
            op = n.fields[0].text
            if op == '-' and val_node(n.fields[1]).kind == 'IntLit':
                return self.int_literal(val_node(n.fields[1]).fields[0].num, expected, True, n.line)
            v = self.expr(val_node(n.fields[1]), expected)
            if op == '-' and v.ty == 'float':
                negated = self.tmp('fneg')
                self.emit(negated + ' = fneg double ' + v.reg)
                return ex(negated, 'float')
            if op == '-':
                if not is_numeric(v.ty):
                    raise CompileError("cannot use '-' on " + shown(v.ty) + '\nonly numbers can be negated', n.line)
                if not is_signed(v.ty):
                    raise CompileError("cannot use '-' on an unsigned number\nconvert it to a signed int first", n.line)
                return self.num_arith('sub', ex('0', v.ty), v, n.line)
            v = self.want(v, 'bool', n.line, 'the operand of not')
            return ex(self.arith('xor', v.reg, '1'), 'bool')
        if k == 'BinOp':
            return self.binop(n, expected)
        if k == 'TypeCall':
            return self.type_call(n)
        if k == 'Call':
            return self.call(n, False)
        if k == 'ListLit' or k == 'TupleLit':
            return self.list_lit(n, expected)
        if k == 'MapLit':
            return self.map_lit(n, expected)
        if k == 'SetLit':
            return self.set_lit(n, expected)
        if k == 'Attr':
            return self.field_get(n)
        if k == 'Index':
            return self.index(n)
        if k == 'Slice':
            return self.slice(n)
        raise CompileError('this kind of expression (' + k + ') is not supported', n.line)

    def sequence_op(self, op: str, a: Ex, b: Ex, line: int) -> Ex:
        # list + list, tuple + tuple, list * n, n * list, text * n and n * text; an empty type when the operands are something else
        if op == '+' and is_list(a.ty) and a.ty == b.ty:
            rc = '0'
            if is_rc(elem_of(a.ty)):
                rc = '1'
            r = self.tmp('joined')
            self.emit(r + ' = call ptr @tomato_list_concat(ptr ' + a.reg + ', ptr ' + b.reg + ', i32 ' + rc + ')')
            self.release(a)
            self.release(b)
            return ex(r, a.ty)
        if op == '*' and (is_list(a.ty) or a.ty == 'str') and is_numeric(b.ty):
            return self.repeat_value(a, b, line)
        if op == '*' and (is_list(b.ty) or b.ty == 'str') and is_numeric(a.ty):
            return self.repeat_value(b, a, line)
        return ex('', '')

    def repeat_value(self, seq: Ex, count: Ex, line: int) -> Ex:
        n = self.want(count, 'int', line, 'the repeat count')
        r = self.tmp('repeated')
        if seq.ty == 'str':
            self.emit(r + ' = call ptr @tomato_str_repeat(ptr ' + seq.reg + ', i64 ' + self.int_raw(n) + ')')
        else:
            rc = '0'
            if is_rc(elem_of(seq.ty)):
                rc = '1'
            self.emit(r + ' = call ptr @tomato_list_repeat(ptr ' + seq.reg + ', i64 ' + self.int_raw(n) + ', i32 ' + rc + ')')
        self.release(seq)
        return ex(r, seq.ty)

    def call_helper(self, info: FuncInfo, values: list[Ex]) -> Ex:
        # call a helper function the compiler wrote; it only borrows its arguments
        parts: list[str] = []
        for v in values:
            parts.append(llvm_type(v.ty) + ' ' + v.reg)
        r = self.tmp('help')
        self.emit(r + ' = call ' + self.ret_llvm(info) + ' ' + function_symbol(self.mod, info) + '(' + ', '.join(parts) + ')')
        self.check_error(values)
        for v2 in values:
            self.release(v2)
        return ex(r, info.ret)

    def marker_call(self, a: Ex, info: FuncInfo, args: list[Ex], line: int) -> Ex:
        # run the method that a protocol marker (@len, @get, @slice, @contains, @reversed) names on the object a; a and the arguments are released
        parts: list[str] = ['ptr ' + a.reg]
        for b in args:
            parts.append(llvm_type(b.ty) + ' ' + b.reg)
        text = 'call ' + self.ret_llvm(info) + ' ' + self.dispatch(a, info.name) + '(' + ', '.join(parts) + ')'
        result = ex('', '')
        if info.ret == '':
            self.emit(text)
        else:
            r = self.tmp('mark')
            self.emit(r + ' = ' + text)
            result = ex(r, info.ret)
        values: list[Ex] = [a]
        for b2 in args:
            values.append(b2)
        self.check_error(values)
        for v in values:
            self.release(v)
        return result

    def object_slice(self, s: Ex, n: Node) -> Ex:
        # obj[a:b:c] on an object whose class has a method marked @slice(start, stop, step, flags): the flags say which of the three
        # were written (1 start, 2 stop, 4 step), the numbers that were not written are 0
        f = self.mod.find_op(s.ty[1:], 'slice')
        if f is None or len(f.ptypes) != 4 or f.ret == '':
            raise CompileError("'" + s.ty[1:] + "' objects cannot be sliced\nadd a method marked @slice that takes start, stop, step and flags (four ints)", n.line)
        flags = 0
        lo = ex('1', 'int')
        hi = ex('1', 'int')
        step = ex('1', 'int')
        if n.fields[1].tag == 'n':
            lo = self.want(self.expr(val_node(n.fields[1])), 'int', n.line, 'a slice start')
            flags += 1
        if n.fields[2].tag == 'n':
            hi = self.want(self.expr(val_node(n.fields[2])), 'int', n.line, 'a slice end')
            flags += 2
        if len(n.fields) > 3 and n.fields[3].tag == 'n':
            step = self.want(self.expr(val_node(n.fields[3])), 'int', n.line, 'a slice step')
            flags += 4
        return self.marker_call(s, f, [lo, hi, step, self.tag_small(str(flags))], n.line)

    def list_call(self, args: list[Node], line: int) -> Ex:
        # list(x): a new list of the items of a list, or of anything with a method marked @iter (a range, a progress bar, your own class)
        if len(args) != 1:
            raise CompileError('list() takes exactly one argument: a list or a range', line)
        v = self.unwrap(self.expr(args[0]), line)
        if is_class(v.ty) and self.mod.has_op(v.ty[1:], 'iter'):
            return self.call_helper(self.mod.helper('tolist', v.ty, line), [v])
        if is_list(v.ty) and not v.ty.startswith('tuple['):
            rc = '0'
            if is_rc(elem_of(v.ty)):
                rc = '1'
            r = self.tmp('copy')
            self.emit(r + ' = call ptr @tomato_list_slice(ptr ' + v.reg + ', i64 0, i64 0, i64 1, i32 0, i32 ' + rc + ')')
            self.release(v)
            return ex(r, v.ty)
        raise CompileError('list() takes a list or something that can be looped over (a range, or an object with an @iter method), but this is ' + shown(v.ty), line)

    def list_builtin(self, name: str, args: list[Node], line: int) -> Ex:
        # sorted, reversed, sum, min and max of a list
        lst = ex('', '')
        if (name == 'min' or name == 'max') and len(args) >= 2:
            items: list[Ex] = []
            first = self.expr(args[0])
            items.append(first)
            for a in args[1:]:
                items.append(self.want(self.expr(a), first.ty, line, 'every value given to ' + name + '()'))
            lst = self.build_tuple('list[' + first.ty + ']', items)
        else:
            if len(args) != 1:
                raise CompileError(name + '() takes one list', line)
            lst = self.unwrap(self.expr(args[0]), line)
        if is_class(lst.ty):
            if name == 'reversed':
                rf = self.mod.find_op(lst.ty[1:], 'reversed')
                if rf is not None:
                    return self.marker_call(lst, rf, [], line)
            if not self.mod.has_op(lst.ty[1:], 'iter'):
                raise CompileError(name + '() takes a list or an object with a method marked @iter, but this is ' + shown(lst.ty), line)
            if name == 'sorted' or name == 'reversed':
                lst = self.call_helper(self.mod.helper('tolist', lst.ty, line), [lst])
            else:
                return self.call_helper(self.mod.helper(name, lst.ty, line), [lst])
        if not is_list(lst.ty):
            raise CompileError(name + '() takes a list or a range, but this is ' + shown(lst.ty), line)
        elem = elem_of(lst.ty)
        if name == 'reversed':
            rc = '0'
            if is_rc(elem):
                rc = '1'
            r = self.tmp('reversed')
            self.emit(r + ' = call ptr @tomato_list_slice(ptr ' + lst.reg + ', i64 0, i64 0, i64 -1, i32 4, i32 ' + rc + ')')
            self.release(lst)
            return ex(r, lst.ty)
        if not (elem == 'int' or elem == 'float' or (elem == 'str' and name != 'sum')):
            wanted = 'numbers'
            if name != 'sum':
                wanted = 'numbers or text'
            raise CompileError(name + '() needs a list of ' + wanted + ', but this is ' + shown(lst.ty), line)
        info = self.mod.helper(name, lst.ty, line)
        return self.call_helper(info, [lst])

    def list_slot(self, lst: Ex, i: Ex) -> str:
        # the address of item i, after a bounds check
        lenp = self.tmp('lenp')
        self.emit(lenp + ' = getelementptr { i64, i64, i64, i64, ptr }, ptr ' + lst.reg + ', i32 0, i32 2')
        ln = self.tmp('len')
        self.emit(ln + ' = load i64, ptr ' + lenp)
        bad = self.tmp('oob')
        self.emit(bad + ' = icmp uge i64 ' + i.reg + ', ' + ln)
        self.fail_if(bad, 'index out of range')
        datap = self.tmp('datap')
        self.emit(datap + ' = getelementptr { i64, i64, i64, i64, ptr }, ptr ' + lst.reg + ', i32 0, i32 4')
        data = self.tmp('data')
        self.emit(data + ' = load ptr, ptr ' + datap)
        addr = self.tmp('addr')
        self.emit(addr + ' = getelementptr i64, ptr ' + data + ', i64 ' + i.reg)
        return addr

    def field_addr(self, obj: Ex, name: str, line: int) -> str:
        if not is_class(obj.ty):
            raise CompileError('a value of type ' + shown(obj.ty) + ' has no fields', line)
        c = self.mod.find_class(obj.ty[1:], line)
        idx = self.mod.field_index(c, name, line)
        addr = self.tmp('fld')
        self.emit(addr + ' = getelementptr %class.' + str(self.mod.code_of(obj.ty)) + ', ptr ' + obj.reg + ', i32 0, i32 ' + str(idx + 2))
        return addr

    def field_type(self, obj: Ex, name: str, line: int) -> str:
        c = self.mod.find_class(obj.ty[1:], line)
        return c.fields[self.mod.field_index(c, name, line)].ty

    def check_field_access(self, obj: Ex, name: str, writing: bool, line: int):
        # private fields belong to their class (D12ac, D12r); a const field is set only by its own class's @init (D12o)
        c = self.mod.find_class(obj.ty[1:], line)
        fld = c.fields[self.mod.field_index(c, name, line)]
        if fld.is_private and self.owner != fld.owner:
            raise CompileError("the field '" + name + "' is private to class '" + fld.owner + "'\nonly its own methods can use it", line)
        if writing and fld.is_const and not (self.in_init and self.owner == fld.owner):
            raise CompileError("the const field '" + name + "' cannot be changed after the object is created", line)

    def field_get(self, n: Node) -> Ex:
        obj = self.unwrap(self.expr(val_node(n.fields[0])), n.line)
        name = n.fields[1].text
        if is_class(obj.ty):
            self.check_field_access(obj, name, False, n.line)
        addr = self.field_addr(obj, name, n.line)
        ft = self.field_type(obj, name, n.line)
        v = self.tmp('f')
        self.emit(v + ' = load ' + llvm_type(ft) + ', ptr ' + addr)
        e = ex(v, ft)
        self.retain(e)
        self.release(obj)
        return e

    def assign_field(self, s: Node, target: Node):
        obj = self.unwrap(self.expr(val_node(target.fields[0])), s.line)
        name = target.fields[1].text
        if is_class(obj.ty):
            self.check_field_access(obj, name, True, s.line)
        ft = self.field_type(obj, name, s.line)
        v = self.expr(val_node(s.fields[1]), ft)
        v = self.want(v, ft, s.line, 'the assigned value')
        addr = self.field_addr(obj, name, s.line)
        self.store_owned(addr, v)
        self.release(obj)

    def list_lit(self, n: Node, expected: str) -> Ex:
        items = val_nodes(n.fields[0])
        t = ''
        first = ex('', '')
        kind = 'list'
        if n.kind == 'TupleLit':
            kind = 'tuple'
        if is_list(expected) and expected.startswith(kind + '['):
            t = expected
        else:
            if len(items) == 0:
                raise CompileError('the type of an empty ' + kind + ' cannot be guessed\ndeclare it, such as: xs: ' + kind + '[int] = []', n.line)
            first = self.expr(items[0])
            if first.ty == '':
                raise CompileError('a ' + kind + ' item needs a value', n.line)
            t = kind + '[' + first.ty + ']'
        lst = self.tmp('list')
        self.emit(lst + ' = call ptr @tomato_list_new(i64 ' + str(self.mod.code_of(t)) + ')')
        for k, item in enumerate(items):
            v = ex('', '')
            if k == 0 and first.ty != '':
                v = first
            else:
                v = self.expr(item, elem_of(t))
            v = self.want(v, elem_of(t), n.line, 'a list item')
            slot = self.tmp('slot')
            self.emit(slot + ' = call ptr @tomato_list_push(ptr ' + lst + ', i64 8)')
            self.emit('store ' + llvm_type(v.ty) + ' ' + v.reg + ', ptr ' + slot)     # the list takes the reference
        return ex(lst, t)

    def key_word(self, k: Ex) -> str:
        # a key as the 64-bit word the runtime hashes: the number itself, or the text's address
        if k.ty != 'str':
            return k.reg
        r = self.tmp('kw')
        self.emit(r + ' = ptrtoint ptr ' + k.reg + ' to i64')
        return r

    def new_set(self, t: str) -> Ex:
        kind = '0'
        if set_elem(t) == 'str':
            kind = '1'
        r = self.tmp('set')
        self.emit(r + ' = call ptr @tomato_dict_new(i64 ' + str(self.mod.code_of(t)) + ', i64 0, i32 ' + kind + ')')
        return ex(r, t)

    def set_lit(self, n: Node, expected: str) -> Ex:
        items = val_nodes(n.fields[0])
        t = expected
        first = ex('', '')
        if not is_set(expected):
            first = self.expr(items[0])
            t = 'set[' + first.ty + ']'
            if not is_set(t) or not (first.ty == 'str' or first.ty == 'int' or first.ty == 'bool'):
                raise CompileError('a set can hold only int, bool or str values', n.line)
        st = self.new_set(t)
        for k, item in enumerate(items):
            v = ex('', '')
            if k == 0 and first.ty != '':
                v = first
            else:
                v = self.expr(item, set_elem(t))
            v = self.want(v, set_elem(t), n.line, 'a set element')
            slot = self.tmp('slot')
            self.emit(slot + ' = call ptr @tomato_dict_insert(ptr ' + st.reg + ', i64 ' + self.key_word(v) + ', i32 0)')
            self.release(v)
        return st

    def map_lit(self, n: Node, expected: str) -> Ex:
        pairs = n.fields[0].items
        if is_set(expected) and len(pairs) == 0:
            return self.new_set(expected)
        if not is_dict(expected):
            raise CompileError('the type of an empty {} cannot be guessed\ndeclare it, such as: m: dict[str, int] = {}', n.line)
        value_t = dict_value(expected)
        d = self.tmp('dict')
        self.emit(d + ' = call ptr @tomato_dict_new(i64 ' + str(self.mod.code_of(expected)) + ', i64 8, i32 1)')
        for pair in pairs:
            k = self.expr(val_node(pair.items[0]))
            k = self.want(k, 'str', n.line, 'a dict key')
            v = self.expr(val_node(pair.items[1]), value_t)
            v = self.want(v, value_t, n.line, 'a dict value')
            slot = self.tmp('slot')
            self.emit(slot + ' = call ptr @tomato_dict_insert(ptr ' + d + ', i64 ' + self.key_word(k) + ', i32 1)')
            dup = self.tmp('dup')
            self.emit(dup + ' = icmp eq ptr ' + slot + ', null')
            self.fail_if(dup, 'duplicate key in a dict literal')
            self.emit('store ' + llvm_type(v.ty) + ' ' + v.reg + ', ptr ' + slot)
            self.release(k)
        return ex(d, expected)

    def int_literal(self, v: int, expected: str, negative: bool, line: int) -> Ex:
        # a whole-number literal takes the integer type its context wants (D05s-w), else int
        t = 'int'
        if is_fixed(expected):
            t = expected
        if not fits_literal(v, t, negative):
            raise CompileError(str(v) + ' does not fit in ' + shown(t) + '\nuse a wider type, or a value in its range', line)
        if t == 'int':
            if v >= 2 ** 61:
                text = str(v)
                if negative:
                    text = '-' + text
                r = self.tmp('big')
                self.emit(r + ' = call i64 @tomato_int_parse(ptr ' + self.mod.intern(text) + ')')
                return ex(r, 'int')
            if negative:
                return ex(str(1 - v * 2), t)
            return ex(str(v * 2 + 1), t)
        if negative:
            return ex(str(-v), t)
        return ex(str(v), t)

    def const_eval(self, n: Node) -> int:
        # the value of a tree of whole-number literals joined by + - * (and a minus sign)
        if n.kind == 'IntLit':
            return n.fields[0].num
        if n.kind == 'UnOp':
            return -self.const_eval(val_node(n.fields[1]))
        a = self.const_eval(val_node(n.fields[1]))
        b = self.const_eval(val_node(n.fields[2]))
        op = n.fields[0].text
        if op == '+':
            return a + b
        if op == '-':
            return a - b
        return a * b

    def is_zero_literal(self, n: Node) -> bool:
        if n.kind == 'IntLit':
            return n.fields[0].num == 0
        if n.kind == 'FloatLit':
            return n.fields[0].num == 0
        if n.kind == 'UnOp' and n.fields[0].text == '-':
            return self.is_zero_literal(val_node(n.fields[1]))
        return False

    def literal_only(self, n: Node) -> bool:
        if n.kind == 'IntLit':
            return True
        if n.kind == 'UnOp' and n.fields[0].text == '-':
            return self.literal_only(val_node(n.fields[1]))
        if n.kind == 'BinOp':
            op = n.fields[0].text
            return (op == '+' or op == '-' or op == '*') and self.literal_only(val_node(n.fields[1])) and self.literal_only(val_node(n.fields[2]))
        return False

    def type_call(self, n: Node) -> Ex:
        # int[length=8](x) and uint[length=8](x): an explicit conversion that stops when the number does not fit
        t = val_node(n.fields[0])
        target = self.mod.type_name(vn(t))
        if not is_fixed(target):
            raise CompileError('this conversion is not supported\nonly int(), float(), str() and int[length=N] / uint[length=N] conversions exist', n.line)
        args = val_nodes(n.fields[1])
        v = self.expr(args[0])
        return self.convert_explicit(v, target, n.line)

    def index(self, n: Node) -> Ex:
        s = self.unwrap(self.expr(val_node(n.fields[0])), n.line)
        if is_dict(s.ty):
            k = self.expr(val_node(n.fields[1]))
            k = self.want(k, 'str', n.line, 'a dict key')
            slot = self.tmp('slot')
            self.emit(slot + ' = call ptr @tomato_dict_find(ptr ' + s.reg + ', i64 ' + self.key_word(k) + ')')
            missing = self.tmp('missing')
            self.emit(missing + ' = icmp eq ptr ' + slot + ', null')
            self.fail_if(missing, 'the key is not there')
            vt = dict_value(s.ty)
            r = self.tmp('val')
            self.emit(r + ' = load ' + llvm_type(vt) + ', ptr ' + slot)
            e = ex(r, vt)
            self.retain(e)
            self.release(k)
            self.release(s)
            return e
        if is_class(s.ty):
            g = self.mod.find_op(s.ty[1:], 'get')
            if g is None or len(g.ptypes) != 1 or g.ret == '':
                raise CompileError("'" + s.ty[1:] + "' objects cannot be indexed\nadd a method marked @get that takes the index and returns the item", n.line)
            gi = self.want(self.expr(val_node(n.fields[1])), g.ptypes[0], n.line, 'an index')
            return self.marker_call(s, g, [gi], n.line)
        if is_list(s.ty):
            li = self.expr(val_node(n.fields[1]))
            li = self.want(li, 'int', n.line, 'an index')
            addr = self.list_slot(s, ex(self.norm_index(s, self.int_raw(li)), 'int'))
            item = self.tmp('item')
            self.emit(item + ' = load ' + llvm_type(elem_of(s.ty)) + ', ptr ' + addr)
            e = ex(item, elem_of(s.ty))
            self.retain(e)
            self.release(s)
            return e
        s = self.want(s, 'str', n.line, 'the value being indexed')
        i = self.expr(val_node(n.fields[1]))
        i = self.want(i, 'int', n.line, 'an index')
        r = self.tmp('ch')
        self.emit(r + ' = call ptr @tomato_str_index(ptr ' + s.reg + ', i64 ' + self.int_raw(i) + ')')
        bad = self.tmp('oob')
        self.emit(bad + ' = icmp eq ptr ' + r + ', null')
        self.fail_if(bad, 'index out of range')
        self.release(s)
        return ex(r, 'str')

    def norm_index(self, s: Ex, i: str) -> str:
        # a negative position counts from the end, as in Python: i + len when i < 0
        lenp = self.tmp('lenp')
        self.emit(lenp + ' = getelementptr { i64, i64, i64, i64, ptr }, ptr ' + s.reg + ', i32 0, i32 2')
        ln = self.tmp('len')
        self.emit(ln + ' = load i64, ptr ' + lenp)
        neg = self.tmp('neg')
        self.emit(neg + ' = icmp slt i64 ' + i + ', 0')
        shifted = self.tmp('shifted')
        self.emit(shifted + ' = add i64 ' + i + ', ' + ln)
        r = self.tmp('pos')
        self.emit(r + ' = select i1 ' + neg + ', i64 ' + shifted + ', i64 ' + i)
        return r

    def slice(self, n: Node) -> Ex:
        s = self.unwrap(self.expr(val_node(n.fields[0])), n.line)
        if is_class(s.ty):
            return self.object_slice(s, n)
        if not (s.ty == 'str' or is_list(s.ty)):
            raise CompileError('only text, lists, tuples and ranges can be sliced, but this is ' + shown(s.ty), n.line)
        flags = 0
        lo = '0'
        hi = '0'
        step = '1'
        if n.fields[1].tag == 'n':
            e = self.want(self.expr(val_node(n.fields[1])), 'int', n.line, 'a slice start')
            lo = self.int_raw(e)
            flags += 1
        if n.fields[2].tag == 'n':
            e2 = self.want(self.expr(val_node(n.fields[2])), 'int', n.line, 'a slice end')
            hi = self.int_raw(e2)
            flags += 2
        if len(n.fields) > 3 and n.fields[3].tag == 'n':
            e3 = self.want(self.expr(val_node(n.fields[3])), 'int', n.line, 'a slice step')
            step = self.int_raw(e3)
            flags += 4
        r = self.tmp('part')
        if s.ty == 'str':
            self.emit(r + ' = call ptr @tomato_str_slice3(ptr ' + s.reg + ', i64 ' + lo + ', i64 ' + hi + ', i64 ' + step + ', i32 ' + str(flags) + ')')
        else:
            rc = '0'
            if is_rc(elem_of(s.ty)):
                rc = '1'
            self.emit(r + ' = call ptr @tomato_list_slice(ptr ' + s.reg + ', i64 ' + lo + ', i64 ' + hi + ', i64 ' + step + ', i32 ' + str(flags) + ', i32 ' + rc + ')')
        bad = self.tmp('zero')
        self.emit(bad + ' = icmp eq ptr ' + r + ', null')
        self.fail_if(bad, 'slice step cannot be zero')
        self.release(s)
        return ex(r, s.ty)

    def membership(self, a: Ex, b: Ex, line: int) -> Ex:
        if is_class(b.ty):
            cf = self.mod.find_op(b.ty[1:], 'contains')
            if cf is None or len(cf.ptypes) != 1 or cf.ret != 'bool':
                raise CompileError("'in' does not work with '" + b.ty[1:] + "' objects\nadd a method marked @contains that takes the value and returns bool", line)
            a = self.want(a, cf.ptypes[0], line, 'the left side of in')
            return self.marker_call(b, cf, [a], line)
        if b.ty == 'str':
            a = self.want(a, 'str', line, 'the left side of in')
            c = self.tmp('c')
            self.emit(c + ' = call i32 @tomato_str_contains(ptr ' + b.reg + ', ptr ' + a.reg + ')')
            i1 = self.tmp('flag')
            self.emit(i1 + ' = icmp ne i32 ' + c + ', 0')
            self.release(a)
            self.release(b)
            return self.bool_of(i1)
        if is_set(b.ty):
            a = self.want(a, set_elem(b.ty), line, 'the left side of in')
            slot = self.tmp('slot')
            self.emit(slot + ' = call ptr @tomato_dict_find(ptr ' + b.reg + ', i64 ' + self.key_word(a) + ')')
            i1 = self.tmp('flag')
            self.emit(i1 + ' = icmp ne ptr ' + slot + ', null')
            self.release(a)
            self.release(b)
            return self.bool_of(i1)
        if is_dict(b.ty):
            a = self.want(a, 'str', line, 'the left side of in')
            slot = self.tmp('slot')
            self.emit(slot + ' = call ptr @tomato_dict_find(ptr ' + b.reg + ', i64 ' + self.key_word(a) + ')')
            i1 = self.tmp('flag')
            self.emit(i1 + ' = icmp ne ptr ' + slot + ', null')
            self.release(a)
            self.release(b)
            return self.bool_of(i1)
        if is_list(b.ty):
            return self.list_contains(a, b, line)
        raise CompileError("'in' does not work with " + shown(b.ty) + '\nit works on lists, sets, dicts and text', line)

    def list_contains(self, a: Ex, lst: Ex, line: int) -> Ex:
        # walk the items and compare each with ==, stopping at the first match (basic item types only)
        elem = elem_of(lst.ty)
        if not (elem == 'int' or elem == 'bool' or elem == 'str'):
            raise CompileError("'in' can search only lists of int, bool or str", line)
        a = self.want(a, elem, line, 'the left side of in')
        found = self.hidden_slot('in.found')
        counter = self.hidden_slot('in.i')
        self.emit('store i64 0, ptr ' + found)
        self.emit('store i64 0, ptr ' + counter)
        head = self.label('inhead')
        body = self.label('inbody')
        step = self.label('instep')
        end = self.label('inend')
        self.br(head)
        self.place(head)
        i = self.tmp('i')
        self.emit(i + ' = load i64, ptr ' + counter)
        lenp = self.tmp('lenp')
        self.emit(lenp + ' = getelementptr { i64, i64, i64, i64, ptr }, ptr ' + lst.reg + ', i32 0, i32 2')
        ln = self.tmp('n')
        self.emit(ln + ' = load i64, ptr ' + lenp)
        go = self.tmp('go')
        self.emit(go + ' = icmp slt i64 ' + i + ', ' + ln)
        self.cond_br(go, body, end)
        self.place(body)
        addr = self.list_slot(lst, ex(i, 'int'))
        item = self.tmp('item')
        self.emit(item + ' = load ' + llvm_type(elem) + ', ptr ' + addr)
        hit = self.tmp('hit')
        if elem == 'str':
            c = self.tmp('c')
            self.emit(c + ' = call i32 @tomato_str_cmp(ptr ' + item + ', ptr ' + a.reg + ')')
            self.emit(hit + ' = icmp eq i32 ' + c + ', 0')
        elif elem == 'int':
            c = self.tmp('c')
            self.emit(c + ' = call i32 @tomato_int_cmp(i64 ' + item + ', i64 ' + a.reg + ')')
            self.emit(hit + ' = icmp eq i32 ' + c + ', 0')
        else:
            self.emit(hit + ' = icmp eq i64 ' + item + ', ' + a.reg)
        yes = self.label('inhit')
        self.cond_br(hit, yes, step)
        self.place(yes)
        self.emit('store i64 1, ptr ' + found)
        self.br(end)
        self.place(step)
        cur = self.tmp('cur')
        self.emit(cur + ' = load i64, ptr ' + counter)
        nxt = self.tmp('next')
        self.emit(nxt + ' = add i64 ' + cur + ', 1')
        self.emit('store i64 ' + nxt + ', ptr ' + counter)
        self.br(head)
        self.place(end)
        f = self.tmp('found')
        self.emit(f + ' = load i64, ptr ' + found)
        i1 = self.tmp('flag')
        self.emit(i1 + ' = icmp ne i64 ' + f + ', 0')
        self.release(a)
        self.release(lst)
        return self.bool_of(i1)

    def compare_text(self, op: str, a: Ex, b: Ex) -> Ex:
        c = self.tmp('cmp32')
        self.emit(c + ' = call i32 @tomato_str_cmp(ptr ' + a.reg + ', ptr ' + b.reg + ')')
        cc = 'eq'
        if op == '!=':
            cc = 'ne'
        elif op == '<':
            cc = 'slt'
        elif op == '<=':
            cc = 'sle'
        elif op == '>':
            cc = 'sgt'
        elif op == '>=':
            cc = 'sge'
        r = self.tmp('c')
        self.emit(r + ' = icmp ' + cc + ' i32 ' + c + ', 0')
        self.release(a)
        self.release(b)
        return self.bool_of(r)

    def logic(self, n: Node, op: str) -> Ex:
        # and / or: the right side only runs when the left side does not decide the answer
        a = self.expr(val_node(n.fields[1]))
        a = self.want(a, 'bool', n.line, 'the left side of ' + op)
        res = self.hidden_slot('logic')
        self.emit('store i64 ' + a.reg + ', ptr ' + res)
        c = self.truth(a, n.line)
        rhs = self.label('rhs')
        end = self.label('endlogic')
        if op == 'and':
            self.cond_br(c, rhs, end)
        else:
            self.cond_br(c, end, rhs)
        self.place(rhs)
        b = self.expr(val_node(n.fields[2]))
        b = self.want(b, 'bool', n.line, 'the right side of ' + op)
        self.emit('store i64 ' + b.reg + ', ptr ' + res)
        self.br(end)
        self.place(end)
        r = self.tmp('logic')
        self.emit(r + ' = load i64, ptr ' + res)
        return ex(r, 'bool')

    def type_operand(self, n: Node) -> str:
        # the right side of `x in Type` (D23f): a type name that is not a variable; '' when it is something else
        if n.kind != 'Name':
            return ''
        name = n.fields[0].text
        if name in self.slots:
            return ''
        if name == 'None':
            return 'None'
        if basic_type(name) and name != 'File':
            return name
        key = self.mod.resolve(name)
        if key != '' and self.mod.has_class(key):
            return '@' + key
        if key != '' and self.mod.has_iface(key):
            return '%' + key
        return ''

    def type_test(self, left: Node, tt: str, line: int) -> Ex:
        # x in Type: true when the value's type is Type (a class name also matches its subclasses)
        a = self.expr(left)
        acc = ''
        c = ''
        if is_union(a.ty):
            for m in union_members(a.ty):
                if self.mod.assignable(m, tt):
                    c = self.box_is(a, m)
                    if acc == '':
                        acc = c
                    else:
                        merged = self.tmp('either')
                        self.emit(merged + ' = or i1 ' + acc + ', ' + c)
                        acc = merged
            if acc == '':
                acc = self.tmp('no')
                self.emit(acc + ' = icmp ne i64 0, 0')
        elif is_optional(a.ty):
            acc = self.tmp('opt')
            if tt == 'None':
                self.emit(acc + ' = icmp eq ptr ' + a.reg + ', null')
            elif self.mod.assignable(strip_optional(a.ty), tt):
                self.emit(acc + ' = icmp ne ptr ' + a.reg + ', null')
            else:
                self.emit(acc + ' = icmp ne i64 0, 0')
        else:
            acc = self.tmp('static')
            if self.mod.assignable(a.ty, tt):
                self.emit(acc + ' = icmp eq i64 0, 0')
            else:
                self.emit(acc + ' = icmp ne i64 0, 0')
        self.release(a)
        return self.bool_of(acc)

    def binop(self, n: Node, expected: str) -> Ex:
        op = n.fields[0].text
        if op == 'and' or op == 'or':
            return self.logic(n, op)
        left = val_node(n.fields[1])
        right = val_node(n.fields[2])
        if (op == '/' or op == '//' or op == '%') and self.is_zero_literal(right):
            raise CompileError('division by zero: the divisor is the constant 0', n.line)
        if (op == '+' or op == '-' or op == '*') and is_fixed(expected) and self.literal_only(n):
            total = self.const_eval(n)
            negative_total = total < 0
            if negative_total:
                total = -total
            if not fits_literal(total, expected, negative_total):
                raise CompileError('the constant ' + str(self.const_eval(n)) + ' does not fit in ' + shown(expected), n.line)
        if op == 'in' and self.type_operand(right) != '':
            return self.type_test(left, self.type_operand(right), n.line)
        a = ex('', '')
        b = ex('', '')
        if (op == '+' or op == '-' or op == '*') and self.literal_only(n) and is_fixed(expected):
            a = self.expr(left, expected)
            b = self.expr(right, expected)
        elif (op == '+' or op == '-' or op == '*') and self.literal_only(left) and not self.literal_only(right):
            b = self.expr(right)
            hint = ''
            if is_fixed(b.ty):
                hint = b.ty
            a = self.expr(left, hint)
        elif (op == '+' or op == '-' or op == '*') and self.literal_only(right) and not self.literal_only(left):
            a = self.expr(left)
            hint = ''
            if is_fixed(a.ty):
                hint = a.ty
            b = self.expr(right, hint)
        else:
            a = self.expr(left)
            b = self.expr(right)
        is_compare = op == '==' or op == '!=' or op == '<' or op == '<=' or op == '>' or op == '>='
        if op == 'in':
            return self.membership(a, b, n.line)
        if not ((op == 'is' or op == 'is not' or op == '==' or op == '!=') and (a.ty == 'None' or b.ty == 'None')):
            a = self.unwrap(a, n.line)
            b = self.unwrap(b, n.line)
        if (op == 'is' or op == 'is not' or op == '==' or op == '!=') and (a.ty == 'None' or b.ty == 'None'):
            if not is_rc(a.ty) or not is_rc(b.ty):
                raise CompileError('cannot compare ' + shown(a.ty) + ' and ' + shown(b.ty) + ' with None\nonly a value that can be None may be compared with None', n.line)
            cc = 'eq'
            if op == 'is not' or op == '!=':
                cc = 'ne'
            c = self.tmp('isnone')
            self.emit(c + ' = icmp ' + cc + ' ptr ' + a.reg + ', ' + b.reg)
            self.release(a)
            self.release(b)
            return self.bool_of(c)
        if is_class(a.ty) and operator_marker_of(op) != '' and (self.mod.has_op(a.ty[1:], operator_marker_of(op)) or not (op == '==' or op == '!=')):
            return self.operator_call(a, b, op, n.line)
        if (op == '+' or op == '*') and (is_list(a.ty) or is_list(b.ty) or a.ty == 'str' or b.ty == 'str'):
            joined = self.sequence_op(op, a, b, n.line)
            if joined.ty != '':
                return joined
        if a.ty == 'str' or b.ty == 'str':
            if a.ty != b.ty:
                raise CompileError("cannot use '" + op + "' with " + shown(a.ty) + ' and ' + shown(b.ty), n.line)
            if op == '+':
                r = self.tmp('cat')
                self.emit(r + ' = call ptr @tomato_str_concat(ptr ' + a.reg + ', ptr ' + b.reg + ')')
                self.release(a)
                self.release(b)
                return ex(r, 'str')
            if is_compare:
                return self.compare_text(op, a, b)
            raise CompileError("'" + op + "' does not work on text\nit works with numbers; use + to join text", n.line)
        if op == 'in':
            return self.membership(a, b, n.line)
        if op == 'xor':
            a = self.want(a, 'bool', n.line, 'the left side of ' + op)
            b = self.want(b, 'bool', n.line, 'the right side of ' + op)
            return ex(self.arith(op, a.reg, b.reg), 'bool')
        if a.ty == 'float' or b.ty == 'float':
            return self.float_op(op, a, b, n.line)
        if is_compare and a.ty == 'bool' and b.ty == 'bool':
            if op != '==' and op != '!=':
                raise CompileError('bool values cannot be ordered with < or >\nuse == or != to compare them', n.line)
        elif not (is_numeric(a.ty) and is_numeric(b.ty)):
            raise CompileError("cannot use '" + op + "' with " + shown(a.ty) + ' and ' + shown(b.ty), n.line)
        if is_numeric(a.ty):
            if op == '+':
                return self.num_arith('add', a, b, n.line)
            if op == '-':
                return self.num_arith('sub', a, b, n.line)
            if op == '*':
                return self.num_arith('mul', a, b, n.line)
            if op == '%':
                return self.num_modulo(a, b, n.line)
            if op == '/':
                return self.num_divide(a, b, n.line)
            if op == '//':
                return self.num_floor_divide(a, b, n.line)
            if op == '**':
                return self.num_power(a, b, n.line)
            if op == '&' or op == '|' or op == '^':
                return self.num_bitwise(op, a, b, n.line)
            if is_compare:
                return self.num_compare(op, a, b, n.line)
        elif is_compare:
            if op == '==':
                return self.icmp('eq', a.reg, b.reg)
            return self.icmp('ne', a.reg, b.reg)
        raise CompileError("the operator '" + op + "' is not supported here", n.line)

    def operator_call(self, a: Ex, b: Ex, op: str, line: int) -> Ex:
        # a + b on a class whose method is marked @add (and the same for the other operators): the method of the left
        # operand runs with the right operand as its one argument (D12l)
        marker = operator_marker_of(op)
        found = self.mod.find_op(a.ty[1:], marker)
        if found is None:
            raise CompileError("cannot use '" + op + "' on '" + a.ty[1:] + "' objects\nadd a method marked @" + marker + ' to the class', line)
        info = found
        if len(info.ptypes) != 1:
            raise CompileError("the @" + marker + " method '" + info.name + "' must take exactly one argument besides self", line)
        b = self.want(b, info.ptypes[0], line, 'the right operand of ' + op)
        values: list[Ex] = [a, b]
        text = 'call ' + self.ret_llvm(info) + ' ' + self.dispatch(a, info.name) + '(ptr ' + a.reg + ', ' + llvm_type(b.ty) + ' ' + b.reg + ')'
        result = ex('', '')
        if info.ret == '':
            self.emit(text)
        else:
            r = self.tmp('op')
            self.emit(r + ' = ' + text)
            result = ex(r, info.ret)
        self.check_error(values)
        self.release(a)
        self.release(b)
        if marker == 'eq' or marker == 'lt' or marker == 'le' or marker == 'gt' or marker == 'ge':
            if result.ty != 'bool':
                raise CompileError("the @" + marker + " method '" + info.name + "' must return bool", line)
        if op == '!=':
            return ex(self.arith('xor', result.reg, '1'), 'bool')
        return result

    def call(self, n: Node, statement: bool) -> Ex:
        f = val_node(n.fields[0])
        if f.kind == 'LlvmRef':
            if len(n.fields[2].items) > 0:
                raise CompileError('an LLVM function cannot take keyword arguments', n.line)
            return self.llvm_call(n, f.fields[0].text)
        if f.kind == 'Attr':
            self.kw = n.fields[2].items
            target = val_node(f.fields[0])
            if target.kind == 'Name' and not (target.fields[0].text in self.slots) and self.mod.resolve(target.fields[0].text) != '' and self.mod.has_class(self.mod.resolve(target.fields[0].text)):
                return self.qualified_call(n, f, self.mod.resolve(target.fields[0].text))
            return self.method_call(n, f)
        if f.kind != 'Name':
            raise CompileError('only a function name can be called here\ncalling the result of another expression is not supported', n.line)
        name = f.fields[0].text
        if len(n.fields[2].items) > 0 and name in ['print', 'open', 'len', 'str', 'int']:
            raise CompileError("'" + name + "' does not take keyword arguments", n.line)
        args = val_nodes(n.fields[1])
        if name == 'print':
            if not statement:
                raise CompileError("print() gives no value, so it cannot be used inside an expression", n.line)
            self.print_call(args)
            return ex('', '')
        if name == 'open':
            return self.open_call(args, n.line)
        if name == 'len':
            return self.len_call(args, n.line)
        if name == 'str':
            return self.str_call(args, n.line)
        if name == 'float' and len(args) == 1:
            return self.float_call(self.expr(args[0]), n.line)
        if name == 'int' and len(args) == 1:
            conv = self.expr(args[0])
            if conv.ty == 'float':
                return self.float_to_int(conv, n.line)
            return self.convert_explicit(conv, 'int', n.line)
        key = self.mod.resolve(name)
        if key == '' and name in ['sorted', 'reversed', 'sum', 'min', 'max']:
            self.kw = []
            return self.list_builtin(name, args, n.line)
        if name == 'range' and not (name in self.slots):
            # range(...) is a value of the builtin class `range` (std/builtin.tom); range(a, b, c) is its constructor
            if len(args) < 1 or len(args) > 3 or len(n.fields[2].items) > 0:
                raise CompileError('range() takes 1 to 3 whole-number arguments: range(stop), range(start, stop) or range(start, stop, step)', n.line)
            if len(args) < 3:
                helper = self.mod.resolve('_range' + str(len(args)))
                self.kw = []
                return self.call_function(self.mod.find(helper, n.line), '@tomato.' + helper, ex('', ''), args, n.line)
        if key == '' and name == 'list':
            return self.list_call(args, n.line)
        if key == '':
            raise CompileError(self.unknown_function(name), n.line)
        if self.mod.has_class(key):
            if len(n.fields[2].items) > 0:
                raise CompileError('keyword arguments are not supported when creating an object\npass the arguments by position', n.line)
            return self.construct(self.mod.find_class(key, n.line), args, n.line)
        self.kw = n.fields[2].items
        return self.call_function(self.mod.find(key, n.line), '@tomato.' + key, ex('', ''), args, n.line)

    def llvm_type_of(self, t: str) -> str:
        # how an LLVM function sees a Tomato type: a bool is one bit there
        if t == 'bool':
            return 'i1'
        return llvm_type(t)

    def llvm_call(self, n: Node, name: str) -> Ex:
        # a call to a declared LLVM function (D27b): the declaration gives the types, the linker the body
        decl = ex('', '')
        found: list[FuncInfo] = []
        for d in self.mod.llvm_decls:
            if d.name == name:
                found.append(d)
        if len(found) == 0:
            raise CompileError("the LLVM function '!" + name + "' is not declared\nadd a line like '!" + name + "(a: int) -> int' at the top level of the file", n.line)
        info = found[0]
        args = val_nodes(n.fields[1])
        if len(args) != len(info.ptypes):
            raise CompileError("the LLVM function '!" + name + "' takes " + plural(len(info.ptypes), 'argument') + ', but ' + str(len(args)) + ' given', n.line)
        parts: list[str] = []
        types: list[str] = []
        held: list[Ex] = []
        for k, a in enumerate(args):
            v = self.expr(a, info.ptypes[k])
            v = self.want(v, info.ptypes[k], n.line, 'argument ' + str(k + 1) + ' of !' + name)
            held.append(v)
            reg = v.reg
            if v.ty == 'bool':
                reg = self.tmp('bit')
                self.emit(reg + ' = trunc i64 ' + v.reg + ' to i1')
            elif v.ty == 'int':
                reg = self.int_raw(v)
            parts.append(self.llvm_type_of(v.ty) + ' ' + reg)
            types.append(self.llvm_type_of(v.ty))
        ret = 'void'
        if info.ret != '':
            ret = self.llvm_type_of(info.ret)
        self.mod.declare('declare ' + ret + ' @' + name + '(' + ', '.join(types) + ')')
        text = 'call ' + ret + ' @' + name + '(' + ', '.join(parts) + ')'
        r = ''
        if info.ret == '':
            self.emit(text)
        else:
            r = self.tmp('llvm')
            self.emit(r + ' = ' + text)
        for h in held:
            self.release(h)
        if info.ret == '':
            return ex('', '')
        if info.ret == 'bool':
            w = self.tmp('flag')
            self.emit(w + ' = zext i1 ' + r + ' to i64')
            return ex(w, 'bool')
        if info.ret == 'int':
            return self.int_from_machine(r, True)
        return ex(r, info.ret)

    def call_function(self, info: FuncInfo, symbol: str, receiver: Ex, args: list[Node], line: int) -> Ex:
        if info.is_gen:
            raise CompileError("'" + info.name + "' is a generator (it uses yield), so it can only be used as what a for loop loops over\nwrite: for x in " + info.name + "(...):", line)
        # a function, or a method when `receiver` holds the object; the callee only borrows its arguments
        keywords = self.kw
        self.kw = []
        nfixed = len(info.ptypes) - info.stars
        required = nfixed - len(info.defaults)
        if len(args) > nfixed and not info.has_varargs:
            raise CompileError("'" + info.name + "' takes " + plural(nfixed, 'argument') + ', but ' + str(len(args)) + ' given', line)
        values: list[Ex] = []
        if receiver.ty != '':
            values.append(receiver)
        slots: list[Ex] = []        # one per fixed parameter: its value, or an empty Ex until a keyword or a default fills it
        for pi in range(nfixed):
            slots.append(ex('', ''))
        extra: list[Ex] = []        # the positional values beyond the named parameters (for *args)
        k = 0
        v = ex('', '')
        for a in args:
            if k < nfixed:
                v = self.expr(a, info.ptypes[k])
                v = self.want(v, info.ptypes[k], line, 'argument ' + str(k + 1) + " of '" + info.name + "'")
                slots[k] = v
            else:
                v = self.expr(a, elem_of(info.ptypes[nfixed]))
                v = self.want(v, elem_of(info.ptypes[nfixed]), line, 'an extra argument of ' + info.name)
                extra.append(v)
            k += 1
        extra_names: list[str] = []
        extra_values: list[Ex] = []
        at = 0
        for kv in keywords:
            kname = kv.items[0].text
            at = -1
            for pi in range(nfixed):
                if info.pnames[pi] == kname:
                    at = pi
            if at >= 0:
                if slots[at].ty != '':
                    raise CompileError("the argument '" + kname + "' of '" + info.name + "' is given twice", line)
                v = self.expr(val_node(kv.items[1]), info.ptypes[at])
                v = self.want(v, info.ptypes[at], line, 'argument ' + kname + " of '" + info.name + "'")
                slots[at] = v
            elif info.has_kwargs:
                if kname in extra_names:
                    raise CompileError("the keyword argument '" + kname + "' is given twice", line)
                kt = dict_value(info.ptypes[-1])
                v = self.expr(val_node(kv.items[1]), kt)
                v = self.want(v, kt, line, 'keyword argument ' + kname + " of '" + info.name + "'")
                extra_names.append(kname)
                extra_values.append(v)
            else:
                raise CompileError("'" + info.name + "' has no parameter named '" + kname + "'", line)
        for pi in range(nfixed):               # the caller supplies the defaults it left out (D19c)
            if slots[pi].ty == '':
                if pi < required:
                    raise CompileError("'" + info.name + "' needs a value for '" + info.pnames[pi] + "'", line)
                v = self.expr(info.defaults[pi - required], info.ptypes[pi])
                v = self.want(v, info.ptypes[pi], line, 'the default of argument ' + str(pi + 1) + " of '" + info.name + "'")
                slots[pi] = v
            values.append(slots[pi])
        if info.has_varargs:
            values.append(self.build_tuple(info.ptypes[nfixed], extra))
        if info.has_kwargs:
            values.append(self.build_kwargs(info.ptypes[-1], extra_names, extra_values))
        parts: list[str] = []
        for v2 in values:
            parts.append(llvm_type(v2.ty) + ' ' + v2.reg)
        text = 'call ' + self.ret_llvm(info) + ' ' + symbol + '(' + ', '.join(parts) + ')'
        result = ex('', '')
        if info.ret == '':
            self.emit(text)
        else:
            r = self.tmp('call')
            self.emit(r + ' = ' + text)
            result = ex(r, info.ret)
        self.check_error(values)
        for v3 in values:
            self.release(v3)
        return result

    def build_tuple(self, t: str, items: list[Ex]) -> Ex:
        lst = self.tmp('varargs')
        self.emit(lst + ' = call ptr @tomato_list_new(i64 ' + str(self.mod.code_of(t)) + ')')
        for it in items:
            slot = self.tmp('slot')
            self.emit(slot + ' = call ptr @tomato_list_push(ptr ' + lst + ', i64 8)')
            self.emit('store ' + llvm_type(it.ty) + ' ' + it.reg + ', ptr ' + slot)
        return ex(lst, t)

    def build_kwargs(self, t: str, names: list[str], items: list[Ex]) -> Ex:
        d = self.tmp('kwargs')
        self.emit(d + ' = call ptr @tomato_dict_new(i64 ' + str(self.mod.code_of(t)) + ', i64 8, i32 1)')
        for k, it in enumerate(items):
            key = ex(self.mod.intern(names[k]), 'str')
            slot = self.tmp('slot')
            self.emit(slot + ' = call ptr @tomato_dict_insert(ptr ' + d + ', i64 ' + self.key_word(key) + ', i32 1)')
            self.emit('store ' + llvm_type(it.ty) + ' ' + it.reg + ', ptr ' + slot)
        return ex(d, t)

    def check_error(self, values: list[Ex]):
        # an error raised by the callee is pending: drop the borrowed arguments and leave this function (D22a)
        ex1 = self.tmp('ex')
        self.emit(ex1 + ' = load ptr, ptr @tomato_exc')
        has = self.tmp('has')
        self.emit(has + ' = icmp ne ptr ' + ex1 + ', null')
        bad = self.label('raised')
        fine = self.label('fine')
        self.cond_br(has, bad, fine)
        self.place(bad)
        for v in values:
            self.release(v)
        self.br(self.unwind_target())
        self.place(fine)

    def construct(self, c: ClassInfo, args: list[Node], line: int) -> Ex:
        # Name(args): allocate, set the declared defaults, run @init (the constructor function does all three)
        ptypes: list[str] = []
        if c.init != '':
            ptypes = self.mod.find_method(c.name, c.init, line).ptypes
        defaults: list[Node] = []
        if c.init != '':
            defaults = self.mod.find_method(c.name, c.init, line).defaults
        required = len(ptypes) - len(defaults)
        if len(args) < required or len(args) > len(ptypes):
            raise CompileError("'" + c.name + "' takes " + plural(len(ptypes), 'argument') + ', but ' + str(len(args)) + ' given', line)
        values = self.args_with_defaults(args, ptypes, defaults, line, c.name)
        parts: list[str] = []
        for v in values:
            parts.append(llvm_type(v.ty) + ' ' + v.reg)
        r = self.tmp('obj')
        self.emit(r + ' = call ptr @tomato.new.' + str(self.mod.code_of('@' + c.name)) + '(' + ', '.join(parts) + ')')
        self.check_error(values)
        for v in values:
            self.release(v)
        return ex(r, '@' + c.name)

    def dispatch(self, obj: Ex, name: str) -> str:
        # a virtual lookup: the object's type code picks a method table, the method name picks the slot
        tp = self.tmp('tp')
        self.emit(tp + ' = getelementptr { i64, i64 }, ptr ' + obj.reg + ', i32 0, i32 1')
        raw = self.tmp('rawcode')
        self.emit(raw + ' = load i64, ptr ' + tp)
        code = self.tmp('code')
        self.emit(code + ' = and i64 ' + raw + ', 4294967295')
        vts = self.tmp('vts')
        self.emit(vts + ' = getelementptr ptr, ptr @tomato_vtables, i64 ' + code)
        vt = self.tmp('vt')
        self.emit(vt + ' = load ptr, ptr ' + vts)
        fp = self.tmp('fp')
        self.emit(fp + ' = getelementptr ptr, ptr ' + vt + ', i64 ' + str(self.mod.slot_of(name)))
        f = self.tmp('f')
        self.emit(f + ' = load ptr, ptr ' + fp)
        return f

    def qualified_call(self, n: Node, f: Node, cls: str) -> Ex:
        # Class.method(self, args): the parent's version of a method, called on an object we already have (D12ao)
        info = self.mod.find_method(cls, f.fields[1].text, n.line)
        if info.is_private and self.owner != info.owner:
            raise CompileError("the method '" + info.name + "' is private to class '" + info.owner + "'\nonly its own methods can call it", n.line)
        args = val_nodes(n.fields[1])
        if len(args) == 0:
            raise CompileError("'" + cls + '.' + info.name + "' needs an object as its first argument", n.line)
        obj = self.expr(args[0])
        if not self.mod.subclass(obj.ty, '@' + cls):
            raise CompileError("the first argument must be a '" + cls + "' object", n.line)
        return self.call_function(info, '@tomato.m.' + str(self.mod.code_of('@' + info.owner)) + '.' + info.name, obj, args[1:], n.line)

    def method_call(self, n: Node, f: Node) -> Ex:
        name = f.fields[1].text
        obj = self.unwrap(self.expr(val_node(f.fields[0])), n.line)
        args = val_nodes(n.fields[1])
        if obj.ty.startswith('tuple[') and name == 'append':
            raise CompileError("a tuple cannot be changed, so it has no '" + name + "'\nuse a list if the items must change", n.line)
        if is_list(obj.ty) and name == 'append':
            if len(args) != 1:
                raise CompileError("append() takes 1 argument, but " + str(len(args)) + ' given', n.line)
            v = self.expr(args[0], elem_of(obj.ty))
            v = self.want(v, elem_of(obj.ty), n.line, 'the appended item')
            slot = self.tmp('slot')
            self.emit(slot + ' = call ptr @tomato_list_push(ptr ' + obj.reg + ', i64 8)')
            self.emit('store ' + llvm_type(v.ty) + ' ' + v.reg + ', ptr ' + slot)
            self.release(obj)
            return ex('', '')
        if is_set(obj.ty):
            return self.set_method(obj, name, args, n.line)
        if obj.ty == 'str':
            return self.text_method(obj, name, args, n.line)
        if obj.ty == 'File':
            return self.file_method(obj, name, args, n.line)
        if is_iface(obj.ty):
            req = self.mod.requirement(obj.ty[1:], name)
            if req is None:
                raise CompileError("the interface '" + obj.ty[1:] + "' has no method '" + name + "'", n.line)
            return self.call_function(req, self.dispatch(obj, name), obj, args, n.line)
        if is_class(obj.ty):
            info = self.mod.find_method(obj.ty[1:], name, n.line)
            if info.is_private and self.owner != info.owner:
                raise CompileError("the method '" + name + "' is private to class '" + info.owner + "'\nonly its own methods can call it", n.line)
            return self.call_function(info, self.dispatch(obj, name), obj, args, n.line)
        raise CompileError(self.no_method(name, obj.ty), n.line)

    def set_method(self, st: Ex, name: str, args: list[Node], line: int) -> Ex:
        if (name == 'add' or name == 'remove') and len(args) == 1:
            v = self.expr(args[0], set_elem(st.ty))
            v = self.want(v, set_elem(st.ty), line, 'the set element')
            kw = self.key_word(v)
            if name == 'add':
                self.emit('call ptr @tomato_dict_insert(ptr ' + st.reg + ', i64 ' + kw + ', i32 0)')
            else:
                slot = self.tmp('slot')
                self.emit(slot + ' = call ptr @tomato_dict_find(ptr ' + st.reg + ', i64 ' + kw + ')')
                missing = self.tmp('missing')
                self.emit(missing + ' = icmp eq ptr ' + slot + ', null')
                self.fail_if(missing, 'the element is not there')
                self.emit('call i32 @tomato_dict_delete(ptr ' + st.reg + ', i64 ' + kw + ')')
            self.release(v)
            self.release(st)
            return ex('', '')
        raise CompileError(self.no_method(name, 'set'), line)

    def text_args(self, obj: Ex, name: str, args: list[Node], count: int, line: int) -> list[Ex]:
        if len(args) != count:
            raise CompileError("'" + name + "' takes " + plural(count, 'argument') + ', but ' + str(len(args)) + ' given', line)
        out: list[Ex] = []
        for a in args:
            v = self.expr(a)
            v = self.want(v, 'str', line, 'the argument of ' + name)
            out.append(v)
        return out

    def not_empty(self, v: Ex, name: str):
        n = self.tmp('alen')
        self.emit(n + ' = call i64 @tomato_str_len(ptr ' + v.reg + ')')
        bad = self.tmp('empty')
        self.emit(bad + ' = icmp eq i64 ' + n + ', 0')
        self.fail_if(bad, 'an empty text cannot be used to ' + name)

    def text_method(self, obj: Ex, name: str, args: list[Node], line: int) -> Ex:
        if name == 'find' or name == 'startswith' or name == 'endswith':
            a = self.text_args(obj, name, args, 1, line)
            if name == 'find':
                r = self.tmp('found')
                self.emit(r + ' = call i64 @tomato_str_find(ptr ' + obj.reg + ', ptr ' + a[0].reg + ')')
                self.release(a[0])
                self.release(obj)
                return self.tag_small(r)
            c = self.tmp('c')
            self.emit(c + ' = call i32 @tomato_str_' + name + '(ptr ' + obj.reg + ', ptr ' + a[0].reg + ')')
            i1 = self.tmp('flag')
            self.emit(i1 + ' = icmp ne i32 ' + c + ', 0')
            self.release(a[0])
            self.release(obj)
            return self.bool_of(i1)
        if name == 'replace':
            a = self.text_args(obj, name, args, 2, line)
            self.not_empty(a[0], 'replace')
            r = self.tmp('replaced')
            self.emit(r + ' = call ptr @tomato_str_replace(ptr ' + obj.reg + ', ptr ' + a[0].reg + ', ptr ' + a[1].reg + ')')
            self.release(a[0])
            self.release(a[1])
            self.release(obj)
            return ex(r, 'str')
        if name == 'split':
            a = self.text_args(obj, name, args, 1, line)
            self.not_empty(a[0], 'split')
            r = self.tmp('pieces')
            self.emit(r + ' = call ptr @tomato_str_split(ptr ' + obj.reg + ', ptr ' + a[0].reg + ', i64 ' + str(self.mod.code_of('list[str]')) + ', i64 8)')
            self.release(a[0])
            self.release(obj)
            return ex(r, 'list[str]')
        if name == 'join':
            if len(args) != 1:
                raise CompileError("join() takes exactly one list[str]", line)
            lst = self.expr(args[0])
            lst = self.want(lst, 'list[str]', line, 'the argument of join')
            r = self.tmp('joined')
            self.emit(r + ' = call ptr @tomato_str_join(ptr ' + obj.reg + ', ptr ' + lst.reg + ')')
            self.release(lst)
            self.release(obj)
            return ex(r, 'str')
        if (name == 'upper' or name == 'lower' or name == 'strip') and len(args) == 0:
            r = self.tmp('changed')
            self.emit(r + ' = call ptr @tomato_str_' + name + '(ptr ' + obj.reg + ')')
            self.release(obj)
            return ex(r, 'str')
        raise CompileError(self.no_method(name, 'str'), line)

    def file_method(self, f: Ex, name: str, args: list[Node], line: int) -> Ex:
        if name == 'read' and len(args) == 0:
            r = self.tmp('text')
            self.emit(r + ' = call ptr @tomato_file_read(ptr ' + f.reg + ')')
            return ex(r, 'str')
        if name == 'write' and len(args) == 1:
            v = self.expr(args[0])
            v = self.want(v, 'str', line, 'the argument of write')
            self.emit('call void @tomato_file_write(ptr ' + f.reg + ', ptr ' + v.reg + ')')
            self.release(v)
            return ex('', '')
        if name == 'close' and len(args) == 0:
            self.emit('call void @tomato_file_close(ptr ' + f.reg + ')')
            return ex('', '')
        raise CompileError(self.no_method(name, 'File'), line)

    def open_call(self, args: list[Node], line: int) -> Ex:
        if len(args) < 1 or len(args) > 2:
            raise CompileError('open() takes a path, and optionally a mode, both as text: open(path) or open(path, mode)', line)
        path = self.expr(args[0])
        path = self.want(path, 'str', line, 'the path')
        mode = ex(self.mod.intern('r'), 'str')
        if len(args) == 2:
            mode = self.expr(args[1])
            mode = self.want(mode, 'str', line, 'the mode')
        r = self.tmp('file')
        self.emit(r + ' = call ptr @tomato_file_open(ptr ' + path.reg + ', ptr ' + mode.reg + ')')
        bad = self.tmp('nofile')
        self.emit(bad + ' = icmp eq ptr ' + r + ', null')
        self.release(path)
        self.release(mode)
        self.fail_with(bad, 'IOError', 'a file could not be opened')
        return ex(r, 'File')

    def ret_llvm(self, info: FuncInfo) -> str:
        if info.ret == '':
            return 'void'
        return llvm_type(info.ret)

    def len_call(self, args: list[Node], line: int) -> Ex:
        if len(args) != 1:
            raise CompileError('len() takes exactly one argument', line)
        v = self.expr(args[0])
        if is_class(v.ty):
            f = self.mod.find_op(v.ty[1:], 'len')
            if f is None or len(f.ptypes) != 0 or f.ret != 'int':
                raise CompileError("'" + v.ty[1:] + "' objects have no length\nadd a method marked @len that takes no argument and returns int", line)
            return self.marker_call(v, f, [], line)
        r = self.tmp('len')
        if is_list(v.ty) or is_dict(v.ty) or is_set(v.ty):
            lenp = self.tmp('lenp')
            self.emit(lenp + ' = getelementptr { i64, i64, i64, i64, ptr }, ptr ' + v.reg + ', i32 0, i32 2')
            self.emit(r + ' = load i64, ptr ' + lenp)
        else:
            v = self.want(v, 'str', line, 'the argument of len')
            self.emit(r + ' = call i64 @tomato_str_len(ptr ' + v.reg + ')')
        self.release(v)
        return self.tag_small(r)

    def class_text(self, v: Ex, line: int) -> Ex:
        # print and str() of an object whose class has a method marked @str: that method's text (P65)
        found = self.mod.find_op(v.ty[1:], 'str')
        if found is None:
            raise CompileError("'" + v.ty[1:] + "' objects cannot be printed or converted to text\nadd a method marked @str that returns text", line)
        info = found
        if len(info.ptypes) != 0 or info.ret != 'str':
            raise CompileError("the @str method '" + info.name + "' must take no argument besides self and return str", line)
        r = self.tmp('shown')
        self.emit(r + ' = call ptr ' + self.dispatch(v, info.name) + '(ptr ' + v.reg + ')')
        self.check_error([v])
        return ex(r, 'str')

    def show_text(self, v: Ex, line: int) -> Ex:
        # a list, tuple, set or dict as text, the way Python shows it: [1, 'a'] (the argument is released)
        info = self.mod.helper('show', v.ty, line)
        r = self.tmp('shown')
        self.emit(r + ' = call ptr ' + function_symbol(self.mod, info) + '(ptr ' + v.reg + ')')
        self.check_error([v])
        self.release(v)
        return ex(r, 'str')

    def str_call(self, args: list[Node], line: int) -> Ex:
        if len(args) != 1:
            raise CompileError('str() takes exactly one argument', line)
        v = self.expr(args[0])
        if v.ty == 'str':
            return v
        if is_class(v.ty):
            shown_text = self.class_text(v, line)
            self.release(v)
            return shown_text
        if is_list(v.ty) or is_dict(v.ty) or is_set(v.ty):
            return self.show_text(v, line)
        r = self.tmp('text')
        if v.ty == 'int':
            self.emit(r + ' = call ptr @tomato_int_str(i64 ' + v.reg + ')')
        elif is_numeric(v.ty):
            if is_signed(v.ty):
                self.emit(r + ' = call ptr @tomato_str_from_i64(i64 ' + self.widen(v, 64) + ')')
            else:
                self.emit(r + ' = call ptr @tomato_str_from_u64(i64 ' + self.widen(v, 64) + ')')
        elif is_union(v.ty):
            self.emit(r + ' = call ptr @tomato_box_str(ptr ' + v.reg + ')')
            self.release(v)
        elif v.ty == 'float':
            self.emit(r + ' = call ptr @tomato_str_from_f64(double ' + v.reg + ')')
        else:
            w = self.tmp('w')
            self.emit(w + ' = trunc i64 ' + v.reg + ' to i32')
            self.emit(r + ' = call ptr @tomato_str_from_bool(i32 ' + w + ')')
        return ex(r, 'str')

    def print_call(self, args: list[Node]):
        values: list[Ex] = []
        for a in args:
            v = self.expr(a)                   # every argument is evaluated before anything is printed
            values.append(v)
        for k, v in enumerate(values):
            if v.ty == 'int':
                t = self.tmp('text')
                self.emit(t + ' = call ptr @tomato_int_str(i64 ' + v.reg + ')')
                self.emit('call void @tomato_print_strobj(ptr ' + t + ')')
                self.emit('call void @tomato_release(ptr ' + t + ')')
            elif is_numeric(v.ty):
                wide = self.widen(v, 64)
                fmt = '@.fmt.int'
                if not is_signed(v.ty):
                    fmt = '@.fmt.uint'
                self.emit('call i32 (ptr, ...) @printf(ptr ' + fmt + ', i64 ' + wide + ')')
            elif v.ty == 'bool':
                w = self.tmp('w')
                self.emit(w + ' = trunc i64 ' + v.reg + ' to i32')
                t = self.tmp('text')
                self.emit(t + ' = call ptr @tomato_str_from_bool(i32 ' + w + ')')
                self.emit('call void @tomato_print_strobj(ptr ' + t + ')')
                self.emit('call void @tomato_release(ptr ' + t + ')')
            elif v.ty == 'float':
                t = self.tmp('text')
                self.emit(t + ' = call ptr @tomato_str_from_f64(double ' + v.reg + ')')
                self.emit('call void @tomato_print_strobj(ptr ' + t + ')')
                self.emit('call void @tomato_release(ptr ' + t + ')')
            elif is_list(v.ty) or is_dict(v.ty) or is_set(v.ty):
                shown_list = self.show_text(v, self.line)
                self.emit('call void @tomato_print_strobj(ptr ' + shown_list.reg + ')')
                self.emit('call void @tomato_release(ptr ' + shown_list.reg + ')')
            elif is_class(v.ty):
                t = self.tmp('text')
                shown_text = self.class_text(v, self.line)
                self.emit('call void @tomato_print_strobj(ptr ' + shown_text.reg + ')')
                self.emit('call void @tomato_release(ptr ' + shown_text.reg + ')')
                self.release(v)
            elif is_union(v.ty):
                t = self.tmp('text')
                self.emit(t + ' = call ptr @tomato_box_str(ptr ' + v.reg + ')')
                self.emit('call void @tomato_print_strobj(ptr ' + t + ')')
                self.emit('call void @tomato_release(ptr ' + t + ')')
                self.release(v)
            else:
                self.emit('call void @tomato_print_strobj(ptr ' + v.reg + ')')
                self.release(v)
            if k < len(values) - 1:
                self.emit('call i32 @putchar(i32 32)')
        self.emit('call i32 @putchar(i32 10)')

    # ---- statements
    def block(self, body: list[Node]):
        for s in body:
            self.stmt(s)

    def push_loop(self, brk: str, cont: str):
        if self.loop_depth < len(self.breaks):
            self.breaks[self.loop_depth] = brk
            self.conts[self.loop_depth] = cont
        else:
            self.breaks.append(brk)
            self.conts.append(cont)
        self.loop_depth += 1

    def visible_names(self) -> list[str]:
        # the names a program could have meant: variables, functions, classes and the built-ins
        out: list[str] = []
        for name in self.slots:
            out.append(name)
        for seen in self.mod.scope:
            if seen.module == self.mod.cur or seen.module == 'builtin':
                out.append(seen.name)
        for b in ['print', 'len', 'str', 'int', 'float', 'open', 'range']:
            out.append(b)
        return out

    def name_hint(self, name: str) -> str:
        if self.mod.resolve(name) != '':
            return "\n'" + name + "' is a function or class, not a variable; call it, such as " + name + '()'
        near = closest(name, self.visible_names())
        if near != '':
            return "\ndid you mean '" + near + "'?"
        return ''

    def unknown_function(self, name: str) -> str:
        if name in self.slots:
            return "'" + name + "' is a variable, not a function, so it cannot be called"
        if name in ['map', 'filter', 'lambda', 'reduce']:
            return "'" + name + "' is not available: Tomato has no function values yet\nuse a for loop instead"
        if name in ['abs', 'round', 'pow', 'divmod', 'any', 'all', 'chr', 'ord', 'input', 'list', 'dict', 'set', 'tuple', 'bool', 'type', 'isinstance', 'hash', 'format']:
            return "'" + name + "' is not built in"
        near = closest(name, self.visible_names())
        if near != '':
            return "the function '" + name + "' is not defined\ndid you mean '" + near + "'?"
        return "the function '" + name + "' is not defined\ncheck its spelling, or import it with 'from module import " + name + "'"

    def no_method(self, name: str, ty: str) -> str:
        known: list[str] = []
        word = shown(ty)
        if ty == 'str':
            known = ['find', 'startswith', 'endswith', 'replace', 'split', 'join', 'upper', 'lower', 'strip']
            word = 'text'
        elif is_set(ty) or ty == 'set':
            known = ['add', 'remove', 'discard']
        elif ty == 'File':
            known = ['read', 'write', 'close']
            word = 'a file'
        elif is_list(ty):
            known = ['append']
        near = closest(name, known)
        text = word + " has no method '" + name + "'"
        if near != '':
            return text + "\ndid you mean '" + near + "'?"
        if len(known) > 0:
            return text + '\nthe methods it has are: ' + ', '.join(known)
        return text

    def stmt(self, s: Node):
        self.line = s.line
        k = s.kind
        if k == 'ExprStmt':
            e = val_node(s.fields[0])
            if e.kind != 'Call':
                shown_value = self.expr(e)
                self.release(shown_value)
                return
            result = self.call(e, True)
            self.release(result)               # a value nobody keeps is released at once
        elif k == 'Assign':
            target = val_node(s.fields[0])
            if target.kind == 'Index':
                self.assign_item(s, target)
                return
            if target.kind == 'Attr':
                self.assign_field(s, target)
                return
            if target.kind != 'Name':
                raise CompileError('cannot assign to this expression\nthe left side of = must be a variable, a field or an item', s.line)
            name = target.fields[0].text
            if name in self.narrowed:
                raise CompileError("'" + name + "' is known to be " + shown(self.types[name]) + " inside this check, so it cannot be assigned here\nassign to it outside the check", s.line)
            expected = ''
            if name in self.slots:
                expected = self.types[name]
            v = self.expr(val_node(s.fields[1]), expected)
            slot_type = v.ty
            if name in self.slots:
                v = self.want(v, self.types[name], s.line, 'the assigned value')
                slot_type = self.types[name]
            if slot_type == 'None' or slot_type == '':
                raise CompileError("the type of '" + name + "' cannot be guessed from None\ndeclare it, such as: " + name + ': Item | None = None', s.line)
            self.store_owned(self.slot(name, slot_type, s.line), v)
        elif k == 'Declare':
            ty = self.mod.type_name(s.fields[1])
            if ty == '':
                raise CompileError('this variable cannot be given a type automatically\nwrite its type, such as: name: Type = value', s.line)
            v = self.expr(val_node(s.fields[2]), ty)
            v = self.want(v, ty, s.line, 'the value')
            self.store_owned(self.slot(s.fields[0].text, ty, s.line), v)
        elif k == 'Yield':
            self.yield_stmt(s)
        elif k == 'Return' and self.gen_n > 0:
            if s.fields[0].tag != 'z':
                raise CompileError("a generator cannot return a value\nuse yield to give out values", s.line)
            self.br(self.gens[self.gen_n - 1].end)
        elif k == 'Return':
            if s.fields[0].tag == 'z':
                if self.ret != '':
                    raise CompileError('this function must return a value of type ' + shown(self.ret) + '\nwrite: return <value>', s.line)
            else:
                if self.ret == '':
                    raise CompileError('this function is declared to return nothing, so it cannot return a value\nremove the value, or add -> Type to the def', s.line)
                v = self.expr(val_node(s.fields[0]), self.ret)
                v = self.want(v, self.ret, s.line, 'the returned value')
                self.emit('store ' + llvm_type(v.ty) + ' ' + v.reg + ', ptr %retval')
            self.run_finallies(self.try_depth)
            self.br('epilogue')
        elif k == 'Raise':
            v = self.expr(val_node(s.fields[0]))
            if not self.mod.subclass(v.ty, '@Error'):
                raise CompileError('raise needs an error object, but this is ' + shown(v.ty) + '\nwrite raise Error("message") or raise one of your Error subclasses', s.line)
            self.emit('store ptr ' + v.reg + ', ptr @tomato_exc')            # the pending error owns the reference
            self.emit('store i32 ' + str(s.line) + ', ptr @tomato_exc_line')
            self.emit('store i32 0, ptr @tomato_exc_rt')
            self.emit('store i32 1, ptr @tomato_exc_seen')
            self.br(self.unwind_target())
        elif k == 'Try':
            self.try_stmt(s)
        elif k == 'If':
            self.if_stmt(s)
        elif k == 'While':
            self.while_stmt(s)
        elif k == 'For':
            self.for_stmt(s)
        elif k == 'Break':
            if self.loop_depth == 0:
                raise CompileError("'break' can only be used inside a loop", s.line)
            self.run_finallies(self.tries_in_loop())
            self.br(self.breaks[self.loop_depth - 1])
        elif k == 'Continue':
            if self.loop_depth == 0:
                raise CompileError("'continue' can only be used inside a loop", s.line)
            self.run_finallies(self.tries_in_loop())
            self.br(self.conts[self.loop_depth - 1])
        elif k == 'Pass':
            pass
        else:
            raise CompileError('this kind of statement (' + k + ') is not supported here', s.line)

    def tries_in_loop(self) -> int:
        # how many of the innermost try statements sit inside the current loop
        n = 0
        k = self.try_depth
        while k > 0 and self.tries[k - 1].loop_depth == self.loop_depth:
            n += 1
            k -= 1
        return n

    def run_finallies(self, n: int):
        # run the finally blocks of the n innermost try statements, innermost first: a return, break or continue is
        # leaving them. A raise inside one of these blocks goes to the handlers outside its try (D22a).
        saved = self.try_depth
        for k in range(saved - 1, saved - n - 1, -1):
            if self.tries[k].has_final:
                self.try_depth = k
                self.block(self.tries[k].final)
        self.try_depth = saved

    def push_try(self, info: TryInfo):
        if self.try_depth < len(self.tries):
            self.tries[self.try_depth] = info
        else:
            self.tries.append(info)
        self.try_depth += 1

    def try_stmt(self, s: Node):
        handlers = s.fields[1].items
        for h in handlers:
            written = h.items[0].text
            ckey = self.mod.resolve(written)
            if ckey == '' or not self.mod.has_class(ckey) or not self.mod.subclass('@' + ckey, '@Error'):
                raise CompileError("'catch' needs an error class, but '" + written + "' is not one\nuse Error, RuntimeError, IOError or a class that extends Error", s.line)
        info = TryInfo()
        info.catch_l = self.label('catch')
        info.prop_l = self.label('prop')
        info.has_final = s.fields[3].tag == 'l'
        if info.has_final:
            info.final = val_nodes(s.fields[3])
        info.loop_depth = self.loop_depth
        else_l = self.label('tryelse')
        handled_l = self.label('tryhandled')
        end_l = self.label('tryend')
        self.push_try(info)
        self.block(val_nodes(s.fields[0]))
        if not self.terminated:
            self.br(else_l)
        # an error raised in the body arrives here with the pending error set
        self.place(info.catch_l)
        info.state = 'post'
        pending = self.tmp('ex')
        self.emit(pending + ' = load ptr, ptr @tomato_exc')
        tp = self.tmp('tp')
        self.emit(tp + ' = getelementptr { i64, i64 }, ptr ' + pending + ', i32 0, i32 1')
        raw = self.tmp('rawcode')
        self.emit(raw + ' = load i64, ptr ' + tp)
        code = self.tmp('code')
        self.emit(code + ' = and i64 ' + raw + ', 4294967295')
        for h in handlers:
            cname = self.mod.resolve(h.items[0].text)
            isa = self.tmp('isa')
            self.emit(isa + ' = call i32 @tomato_is_subclass(i64 ' + code + ', i64 ' + str(self.mod.code_of('@' + cname)) + ')')
            hit = self.tmp('hit')
            self.emit(hit + ' = icmp ne i32 ' + isa + ', 0')
            match = self.label('match')
            nxt = self.label('nomatch')
            self.cond_br(hit, match, nxt)
            self.place(match)
            self.emit('store ptr null, ptr @tomato_exc')             # handled: the catch variable takes the reference
            if h.items[1].tag == 's':
                var = h.items[1].text
                reg = ''
                if var in self.slots and self.types[var] != '@' + cname:
                    reg = self.new_slot(var, '@' + cname)     # the name is bound again, to a new slot of the new type
                else:
                    reg = self.slot(var, '@' + cname, s.line)
                self.store_owned(reg, ex(pending, '@' + cname))
            else:
                self.emit('call void @tomato_release(ptr ' + pending + ')')
            self.block(val_nodes(h.items[2]))
            if not self.terminated:
                self.br(handled_l)
            self.place(nxt)
        self.br(info.prop_l)                                          # no clause matched: keep propagating
        self.place(else_l)
        if s.fields[2].tag == 'l':
            self.block(val_nodes(s.fields[2]))
        if not self.terminated:
            self.br(handled_l)
        # every normal way out of the statement runs the finally block once
        self.place(handled_l)
        self.try_depth -= 1
        if info.has_final:
            self.block(info.final)
        if not self.terminated:
            self.br(end_l)
        # an error is leaving the statement: park it while the finally block runs, then keep propagating
        self.place(info.prop_l)
        if info.has_final:
            hold = self.tmp('hold')
            self.allocas.append('  ' + hold + ' = alloca ptr')
            held = self.tmp('pending')
            self.emit(held + ' = load ptr, ptr @tomato_exc')
            self.emit('store ptr ' + held + ', ptr ' + hold)
            self.emit('store ptr null, ptr @tomato_exc')
            self.block(info.final)
            back = self.tmp('back')
            self.emit(back + ' = load ptr, ptr ' + hold)
            self.emit('store ptr ' + back + ', ptr @tomato_exc')
        self.br(self.unwind_target())
        self.place(end_l)

    def assign_item(self, s: Node, target: Node):
        lst = self.unwrap(self.expr(val_node(target.fields[0])), s.line)
        if lst.ty.startswith('tuple['):
            raise CompileError('a tuple cannot be changed, so its items cannot be assigned\nuse a list if the items must change', s.line)
        if is_dict(lst.ty):
            k = self.expr(val_node(target.fields[1]))
            k = self.want(k, 'str', s.line, 'a dict key')
            dv = self.expr(val_node(s.fields[1]), dict_value(lst.ty))
            dv = self.want(dv, dict_value(lst.ty), s.line, 'the assigned value')
            slot = self.tmp('slot')
            self.emit(slot + ' = call ptr @tomato_dict_insert(ptr ' + lst.reg + ', i64 ' + self.key_word(k) + ', i32 0)')
            self.store_owned(slot, dv)
            self.release(k)
            self.release(lst)
            return
        if not is_list(lst.ty):
            raise CompileError('only list and dict items can be assigned by index', s.line)
        i = self.expr(val_node(target.fields[1]))
        i = self.want(i, 'int', s.line, 'an index')
        i = ex(self.norm_index(lst, self.int_raw(i)), 'int')
        v = self.expr(val_node(s.fields[1]), elem_of(lst.ty))
        v = self.want(v, elem_of(lst.ty), s.line, 'the assigned item')
        addr = self.list_slot(lst, i)
        if is_rc(v.ty):
            old = self.tmp('old')
            self.emit(old + ' = load ptr, ptr ' + addr)
            self.emit('store ptr ' + v.reg + ', ptr ' + addr)
            self.emit('call void @tomato_release(ptr ' + old + ')')
        else:
            self.emit('store ' + llvm_type(v.ty) + ' ' + v.reg + ', ptr ' + addr)
        self.release(lst)

    def narrow_target(self, cond: Node) -> list[str]:
        # `x in Type` where x is a union variable and Type is one of its members: [x, Type]; else []
        if cond.kind != 'BinOp' or cond.fields[0].text != 'in':
            return []
        l = val_node(cond.fields[1])
        if l.kind != 'Name':
            return []
        name = l.fields[0].text
        tt = self.type_operand(val_node(cond.fields[2]))
        if tt == '' or not (name in self.slots):
            return []
        if not is_union(self.types[name]) or not (tt in union_members(self.types[name])):
            return []
        return [name, tt]

    def enter_narrow(self, name: str, member: str) -> list[str]:
        # inside the branch the variable is the member's own type: a copy of the value taken out of the box
        saved = [self.slots[name], self.types[name]]
        holder = self.tmp('whole')
        self.emit(holder + ' = load ptr, ptr ' + saved[0])
        inner = self.unbox_value(ex(holder, saved[1]), member)
        shadow = self.new_slot(name, member)
        self.store_owned(shadow, inner)
        self.narrowed.append(name)
        return saved

    def leave_narrow(self, name: str, saved: list[str]):
        self.slots[name] = saved[0]
        self.types[name] = saved[1]
        self.narrowed = self.narrowed[:-1]

    def if_stmt(self, s: Node):
        end = self.label('endif')
        target: list[str] = []
        saved: list[str] = []
        for branch in s.fields[0].items:
            target = self.narrow_target(val_node(branch.items[0]))
            cond = self.truth(self.expr(val_node(branch.items[0])), s.line)
            then = self.label('then')
            nxt = self.label('next')
            self.cond_br(cond, then, nxt)
            self.place(then)
            if len(target) > 0:
                saved = self.enter_narrow(target[0], target[1])
            self.block(val_nodes(branch.items[1]))
            if len(target) > 0:
                self.leave_narrow(target[0], saved)
            if not self.terminated:
                self.br(end)
            self.place(nxt)
        if s.fields[1].tag == 'l':
            # `if x in T: ... else: ...` on a union of exactly two types: the else part knows x is the other one
            other = ''
            if len(s.fields[0].items) == 1 and len(target) > 0:
                members = union_members(self.types[target[0]])
                if len(members) == 2:
                    other = members[0]
                    if other == target[1]:
                        other = members[1]
            if other != '':
                saved = self.enter_narrow(target[0], other)
            self.block(val_nodes(s.fields[1]))
            if other != '':
                self.leave_narrow(target[0], saved)
        if not self.terminated:
            self.br(end)
        self.place(end)

    def while_stmt(self, s: Node):
        head = self.label('while')
        body = self.label('body')
        end = self.label('endwhile')
        self.br(head)
        self.place(head)
        cond = self.truth(self.expr(val_node(s.fields[0])), s.line)
        self.cond_br(cond, body, end)
        self.place(body)
        self.push_loop(end, head)
        self.block(val_nodes(s.fields[1]))
        self.loop_depth -= 1
        if not self.terminated:
            self.br(head)
        self.place(end)

    def gen_push(self, c: GenCtx):
        if len(self.gens) > self.gen_n:
            self.gens[self.gen_n] = c
        else:
            self.gens.append(c)
        self.gen_n += 1

    def swap_scope(self, c: GenCtx):
        # exchange the names in scope with those the context keeps: the caller's loop body and the generator's body each see their own variables
        t1 = self.slots
        self.slots = c.slots
        c.slots = t1
        t2 = self.types
        self.types = c.types
        c.types = t2
        t3 = self.narrowed
        self.narrowed = c.narrowed
        c.narrowed = t3
        t4 = self.ret
        self.ret = c.ret
        c.ret = t4
        t5 = self.owner
        self.owner = c.owner
        c.owner = t5
        t6 = self.in_init
        self.in_init = c.in_init
        c.in_init = t6
        t7 = self.mod.cur
        self.mod.cur = c.module
        c.module = t7

    def gen_args(self, info: FuncInfo, args: list[Node], line: int) -> list[Ex]:
        if info.stars > 0:
            raise CompileError("the generator '" + info.name + "' cannot take *args or **kwargs", line)
        required = len(info.ptypes) - len(info.defaults)
        if len(args) < required or len(args) > len(info.ptypes):
            raise CompileError("'" + info.name + "' takes " + plural(len(info.ptypes), 'argument') + ', but ' + str(len(args)) + ' given', line)
        return self.args_with_defaults(args, info.ptypes, info.defaults, line, "'" + info.name + "'")

    # the arguments of a call, then the defaults of the parameters it leaves out, each checked against its parameter's type
    def args_with_defaults(self, args: list[Node], ptypes: list[str], defaults: list[Node], line: int, callee: str) -> list[Ex]:
        required = len(ptypes) - len(defaults)
        vals: list[Ex] = []
        for k, a in enumerate(args):
            v = self.expr(a, ptypes[k])
            vals.append(self.want(v, ptypes[k], line, 'argument ' + str(k + 1) + ' of ' + callee))
        for k in range(len(args), len(ptypes)):
            v = self.expr(defaults[k - required], ptypes[k])
            vals.append(self.want(v, ptypes[k], line, 'the default of argument ' + str(k + 1) + ' of ' + callee))
        return vals

    def inline_gen(self, s: Node, info: FuncInfo, recv: Ex, vals: list[Ex], line: int):
        # for x in <generator>: the generator's body is compiled right here, as part of the loop. Each `yield v` sets x to v and
        # runs the loop body; `break` leaves the whole thing and `continue` goes on after the yield. Nothing is built up in memory.
        if info.ret == '':
            raise CompileError("the generator '" + info.name + "' must say what it yields\nadd -> Type to its def, such as -> int", line)
        if self.gen_n >= 6:
            raise CompileError("generators are nested too deeply here\na generator cannot loop over itself", line)
        node = self.mod.node_of(info)
        var = self.slot(s.fields[0].text, info.ret, s.line)
        c = GenCtx()
        c.var = var
        c.ty = info.ret
        c.body = val_nodes(s.fields[2])
        c.end = self.label('endgen')
        c.try_depth = self.try_depth
        c.owner = info.owner
        c.module = info.module
        self.swap_scope(c)
        self.gen_push(c)
        k = 0
        for p in val_nodes(node.fields[1]):
            pname = p.fields[0].text
            if pname == 'self' and info.owner != '':
                self.store_owned(self.slot('self', '@' + info.owner, line), recv)
            else:
                self.store_owned(self.slot(pname, info.ptypes[k], line), vals[k])
                k += 1
        self.block(val_nodes(node.fields[3]))
        if not self.terminated:
            self.br(c.end)
        self.place(c.end)
        self.gen_n -= 1
        self.swap_scope(c)

    def yield_stmt(self, s: Node):
        if self.gen_n == 0:
            raise CompileError("'yield' can only be used in a generator, that is a function or method that a for loop loops over", s.line)
        c = self.gens[self.gen_n - 1]
        if self.try_depth != c.try_depth:
            raise CompileError("'yield' cannot be used inside a try block", s.line)
        v = self.expr(val_node(s.fields[0]), c.ty)
        v = self.want(v, c.ty, s.line, 'the yielded value')
        self.store_owned(c.var, v)
        self.gen_n -= 1
        self.swap_scope(c)
        cont = self.label('afteryield')
        self.push_loop(c.end, cont)
        self.block(c.body)
        self.loop_depth -= 1
        if not self.terminated:
            self.br(cont)
        self.place(cont)
        self.swap_scope(c)
        self.gen_push(c)

    def gen_call(self, s: Node, it: Node) -> bool:
        # for x in gen(args) and for x in obj.gen(args), where the function or method is a generator
        if it.kind != 'Call' or len(it.fields[2].items) > 0:
            return False
        f = val_node(it.fields[0])
        args = val_nodes(it.fields[1])
        if f.kind == 'Name':
            name = f.fields[0].text
            if name in self.slots or name == 'range':
                return False
            key = self.mod.resolve(name)
            if key == '' or self.mod.has_class(key):
                return False
            info = self.mod.find(key, s.line)
            if not info.is_gen:
                return False
            self.inline_gen(s, info, ex('', ''), self.gen_args(info, args, s.line), s.line)
            return True
        if f.kind != 'Attr':
            return False
        name = f.fields[1].text
        known = False
        for fi in self.mod.infos:
            if fi.name == name and fi.owner != '' and fi.is_gen:
                known = True
        target = val_node(f.fields[0])
        if not known or (target.kind == 'Name' and not (target.fields[0].text in self.slots)):
            return False
        obj = self.unwrap(self.expr(target), s.line)
        found: FuncInfo | None = None
        if is_class(obj.ty):
            found = self.mod.lookup_method(obj.ty[1:], name)
        if found is None or not found.is_gen:
            self.release(obj)
            return False
        info: FuncInfo = found
        self.inline_gen(s, info, obj, self.gen_args(info, args, s.line), s.line)
        return True

    def for_text(self, s: Node, text: Ex):
        # for ch in text: each character as a one-character text
        holder = self.hidden_rc_slot('for.text')
        self.store_owned(holder, text)
        counter = self.hidden_slot('for.i')
        self.emit('store i64 0, ptr ' + counter)
        var = self.slot(s.fields[0].text, 'str', s.line)
        head = self.label('eachchar')
        body = self.label('eachcharbody')
        step = self.label('eachcharstep')
        end = self.label('endeachchar')
        self.br(head)
        self.place(head)
        t = self.tmp('txt')
        self.emit(t + ' = load ptr, ptr ' + holder)
        i = self.tmp('i')
        self.emit(i + ' = load i64, ptr ' + counter)
        n = self.tmp('n')
        self.emit(n + ' = call i64 @tomato_str_len(ptr ' + t + ')')
        go = self.tmp('go')
        self.emit(go + ' = icmp slt i64 ' + i + ', ' + n)
        self.cond_br(go, body, end)
        self.place(body)
        ch = self.tmp('ch')
        self.emit(ch + ' = call ptr @tomato_str_index(ptr ' + t + ', i64 ' + i + ')')
        self.store_owned(var, ex(ch, 'str'))
        self.push_loop(end, step)
        self.block(val_nodes(s.fields[2]))
        self.loop_depth -= 1
        if not self.terminated:
            self.br(step)
        self.place(step)
        cur = self.tmp('cur')
        self.emit(cur + ' = load i64, ptr ' + counter)
        nxt = self.tmp('next')
        self.emit(nxt + ' = add i64 ' + cur + ', 1')
        self.emit('store i64 ' + nxt + ', ptr ' + counter)
        self.br(head)
        self.place(end)

    def for_each(self, s: Node, it: Node):
        lst = self.expr(it)
        if is_class(lst.ty) and self.mod.has_op(lst.ty[1:], 'iter'):
            self.inline_gen(s, self.mod.find_op(lst.ty[1:], 'iter'), lst, [], s.line)
            return
        if is_set(lst.ty) or is_dict(lst.ty):
            # a loop over a set or dict walks a snapshot of its keys (P28)
            keys = 'list[' + set_elem(lst.ty) + ']'
            if is_dict(lst.ty):
                keys = 'list[str]'
            snap = self.tmp('keys')
            self.emit(snap + ' = call ptr @tomato_dict_keys(ptr ' + lst.reg + ', i64 ' + str(self.mod.code_of(keys)) + ', i64 8)')
            self.release(lst)
            lst = ex(snap, keys)
        if lst.ty == 'str':
            self.for_text(s, lst)
            return
        if not is_list(lst.ty):
            if is_class(lst.ty):
                raise CompileError("a for loop cannot loop over a '" + lst.ty[1:] + "' object\ngive the class a method marked @iter that yields the items, or loop over a list field of it such as obj.items", s.line)
            raise CompileError('a for loop can loop over a range(), a list, a tuple, a set, a dict, text or an object with an @iter method, but this is ' + shown(lst.ty), s.line)
        elem = elem_of(lst.ty)
        holder = self.hidden_rc_slot('for.list')
        self.store_owned(holder, lst)
        counter = self.hidden_slot('for.i')
        self.emit('store i64 0, ptr ' + counter)
        var = self.slot(s.fields[0].text, elem, s.line)
        head = self.label('each')
        body = self.label('eachbody')
        step = self.label('eachstep')
        end = self.label('endeach')
        self.br(head)
        self.place(head)
        l = self.tmp('lst')
        self.emit(l + ' = load ptr, ptr ' + holder)
        i = self.tmp('i')
        self.emit(i + ' = load i64, ptr ' + counter)
        lenp = self.tmp('lenp')
        self.emit(lenp + ' = getelementptr { i64, i64, i64, i64, ptr }, ptr ' + l + ', i32 0, i32 2')
        ln = self.tmp('n')
        self.emit(ln + ' = load i64, ptr ' + lenp)
        go = self.tmp('go')
        self.emit(go + ' = icmp slt i64 ' + i + ', ' + ln)
        self.cond_br(go, body, end)
        self.place(body)
        addr = self.list_slot(ex(l, lst.ty), ex(i, 'int'))
        item = self.tmp('item')
        self.emit(item + ' = load ' + llvm_type(elem) + ', ptr ' + addr)
        e = ex(item, elem)
        self.retain(e)
        self.store_owned(var, e)
        self.push_loop(end, step)
        self.block(val_nodes(s.fields[2]))
        self.loop_depth -= 1
        if not self.terminated:
            self.br(step)
        self.place(step)
        cur = self.tmp('cur')
        self.emit(cur + ' = load i64, ptr ' + counter)
        nxt = self.tmp('next')
        self.emit(nxt + ' = add i64 ' + cur + ', 1')
        self.emit('store i64 ' + nxt + ', ptr ' + counter)
        self.br(head)
        self.place(end)

    def for_stmt(self, s: Node):
        it = val_node(s.fields[1])
        if self.gen_call(s, it):
            return
        if not (it.kind == 'Call' and val_node(it.fields[0]).kind == 'Name' and val_node(it.fields[0]).fields[0].text == 'range'):
            self.for_each(s, it)
            return
        if it.kind != 'Call' or val_node(it.fields[0]).kind != 'Name' or val_node(it.fields[0]).fields[0].text != 'range':
            raise CompileError('a for loop with two variables is not supported here', s.line)
        bounds = val_nodes(it.fields[1])
        if len(bounds) == 3:
            self.for_each(s, it)
            return
        if len(bounds) != 1 and len(bounds) != 2:
            raise CompileError('range() takes 1 to 3 whole-number arguments: range(stop), range(start, stop) or range(start, stop, step)', s.line)
        start = '0'
        stop = ''
        if len(bounds) == 1:
            e = self.expr(bounds[0])
            e = self.want(e, 'int', s.line, 'a range bound')
            stop = self.int_raw(e)
        else:
            a = self.expr(bounds[0])
            b = self.expr(bounds[1])
            a = self.want(a, 'int', s.line, 'a range bound')
            b = self.want(b, 'int', s.line, 'a range bound')
            start = self.int_raw(a)
            stop = self.int_raw(b)
        var = self.slot(s.fields[0].text, 'int', s.line)
        counter = self.hidden_slot('for.i')
        limit = self.hidden_slot('for.n')
        self.emit('store i64 ' + start + ', ptr ' + counter)
        self.emit('store i64 ' + stop + ', ptr ' + limit)
        head = self.label('for')
        body = self.label('forbody')
        step = self.label('forstep')
        end = self.label('endfor')
        self.br(head)
        self.place(head)
        i = self.tmp('i')
        self.emit(i + ' = load i64, ptr ' + counter)
        lim = self.tmp('lim')
        self.emit(lim + ' = load i64, ptr ' + limit)
        c = self.tmp('go')
        self.emit(c + ' = icmp slt i64 ' + i + ', ' + lim)
        self.cond_br(c, body, end)
        self.place(body)
        self.emit('store i64 ' + self.tag_small(i).reg + ', ptr ' + var)
        self.push_loop(end, step)
        self.block(val_nodes(s.fields[2]))
        self.loop_depth -= 1
        if not self.terminated:
            self.br(step)
        self.place(step)
        cur = self.tmp('cur')
        self.emit(cur + ' = load i64, ptr ' + counter)
        nxt = self.tmp('next')
        self.emit(nxt + ' = add i64 ' + cur + ', 1')
        self.emit('store i64 ' + nxt + ', ptr ' + counter)
        self.br(head)
        self.place(end)

def function_symbol(mod: Mod, info: FuncInfo) -> str:
    if info.owner == '':
        return '@tomato.' + info.key
    return '@tomato.m.' + str(mod.code_of('@' + info.owner)) + '.' + info.name

def finish_function(g: Gen, symbol: str, sig: list[str], ret: str) -> str:
    # the epilogue releases every slot that owns a heap value, then returns the stored result
    g.lines.append('epilogue:')
    for reg in g.rc_slots:
        o = g.tmp('rel')
        g.lines.append('  ' + o + ' = load ptr, ptr ' + reg)
        g.lines.append('  call void @tomato_release(ptr ' + o + ')')
    llvm_ret = 'void'
    if ret != '':
        llvm_ret = llvm_type(ret)
        r = g.tmp('ret')
        g.lines.append('  ' + r + ' = load ' + llvm_ret + ', ptr %retval')
        g.lines.append('  ret ' + llvm_ret + ' ' + r)
    else:
        g.lines.append('  ret void')
    text = 'define ' + llvm_ret + ' ' + symbol + '(' + ', '.join(sig) + ') {\nentry:\n'
    if ret != '':
        text += '  %retval = alloca ' + llvm_ret + '\n  store ' + llvm_ret + ' ' + zero_of(ret) + ', ptr %retval\n'
    if len(g.allocas) > 0:
        text += '\n'.join(g.allocas) + '\n'
    text += '\n'.join(g.lines) + '\n}\n'
    return text

def compile_function(f: Node, mod: Mod, info: FuncInfo) -> str:
    mod.cur = info.module
    g = Gen()
    g.mod = mod
    g.owner = info.owner
    g.in_init = info.is_init
    g.ret = info.ret
    params = val_nodes(f.fields[1])
    names: list[str] = []
    types: list[str] = []
    k = 0
    for p in params:
        if p.fields[0].text == 'self':
            if info.owner == '':
                raise CompileError("'self' can only be used in methods inside a class", p.line)
            names.append('self')
            types.append('@' + info.owner)
        else:
            names.append(p.fields[0].text)
            types.append(info.ptypes[k])
            k += 1
    sig: list[str] = []
    for k, name in enumerate(names):
        reg = g.slot(name, types[k], f.line)
        sig.append(llvm_type(types[k]) + ' %arg.' + name)
        g.emit('store ' + llvm_type(types[k]) + ' %arg.' + name + ', ptr ' + reg)
        if is_rc(types[k]):
            g.emit('call void @tomato_retain(ptr %arg.' + name + ')')    # the caller only lent it
    g.block(val_nodes(f.fields[3]))
    if not g.terminated:
        if info.ret == '':
            g.br('epilogue')
        else:
            g.emit('call void @tomato_fail(ptr ' + mod.intern('the function ended without returning a value') + '.c)')
            g.emit('unreachable')
            g.terminated = True
    return finish_function(g, function_symbol(mod, info), sig, info.ret)

def compile_constructor(c: ClassInfo, mod: Mod) -> str:
    # allocate, store the declared field defaults, then run @init
    mod.cur = c.module
    g = Gen()
    g.mod = mod
    code = str(mod.code_of('@' + c.name))
    ptypes: list[str] = []
    if c.init != '':
        ptypes = mod.find_method(c.name, c.init, c.line).ptypes
    sig: list[str] = []
    for k, t in enumerate(ptypes):
        sig.append(llvm_type(t) + ' %arg.' + str(k))
    size = g.tmp('size')
    g.emit(size + ' = ptrtoint ptr getelementptr (%class.' + code + ', ptr null, i32 1) to i64')
    obj = g.tmp('obj')
    g.emit(obj + ' = call ptr @tomato_alloc(i64 ' + size + ', i64 ' + code + ')')
    for k, fld in enumerate(c.fields):
        if fld.default is not None:
            v = g.expr(fld.default, fld.ty)
            v = g.want(v, fld.ty, c.line, 'the default of field ' + fld.name)
            addr = g.tmp('fld')
            g.emit(addr + ' = getelementptr %class.' + code + ', ptr ' + obj + ', i32 0, i32 ' + str(k + 2))
            g.emit('store ' + llvm_type(v.ty) + ' ' + v.reg + ', ptr ' + addr)
    if c.init != '':
        parts: list[str] = ['ptr ' + obj]
        for k, t in enumerate(ptypes):
            parts.append(llvm_type(t) + ' %arg.' + str(k))
        g.emit('call void @' + 'tomato.m.' + str(mod.code_of('@' + mod.find_method(c.name, c.init, c.line).owner)) + '.' + c.init + '(' + ', '.join(parts) + ')')
        pending = g.tmp('ex')
        g.emit(pending + ' = load ptr, ptr @tomato_exc')
        has = g.tmp('has')
        g.emit(has + ' = icmp ne ptr ' + pending + ', null')
        bad = g.label('initfailed')
        ok = g.label('initok')
        g.cond_br(has, bad, ok)
        g.place(bad)
        g.emit('call void @tomato_release(ptr ' + obj + ')')          # an @init that raised leaves no object behind
        g.br('epilogue')
        g.place(ok)
    g.emit('store ptr ' + obj + ', ptr %retval')
    g.br('epilogue')
    return finish_function(g, '@tomato.new.' + code, sig, '@' + c.name)

def class_types(mod: Mod) -> str:
    # one struct type per class: the reference count and type code, then the fields
    t = ''
    for c in mod.classes:
        parts: list[str] = []
        parts.append('i64')
        parts.append('i64')
        for fld in c.fields:
            parts.append(llvm_type(fld.ty))
        t += '%class.' + str(mod.code_of('@' + c.name)) + ' = type { ' + ', '.join(parts) + ' }\n'
    return t

def vtables(mod: Mod) -> str:
    # one method table per class (a slot per method name), and the table of tables indexed by type code
    n = len(mod.codes) + 2
    heads: list[str] = []
    for k in range(n):
        heads.append('ptr null')
    text = ''
    k = 0
    for code in mod.codes:
        slot = k + 2
        if is_class(code) and len(mod.slots) > 0:
            entries: list[str] = []
            for name in mod.slots:
                found = mod.lookup_method(code[1:], name)
                if found is not None and not found.is_gen:
                    entries.append('ptr ' + function_symbol(mod, found))
                else:
                    entries.append('ptr null')
            text += '@tomato.vt.' + str(slot) + ' = constant [' + str(len(entries)) + ' x ptr] [' + ', '.join(entries) + ']\n'
            heads[slot] = 'ptr @tomato.vt.' + str(slot)
        k += 1
    text += '@tomato_vtables = constant [' + str(n) + ' x ptr] [' + ', '.join(heads) + ']\n'
    return text

def int_of_bool(b: bool) -> int:
    if b:
        return 1
    return 0

def runtime_tables(mod: Mod) -> str:
    n = len(mod.codes) + 2
    names: list[str] = []
    zeros: list[str] = []
    kinds: list[str] = []
    offsets: list[str] = []
    extra = ''
    for k in range(n):
        names.append('ptr null')
        zeros.append('i64 0')
        offsets.append('ptr null')
        kinds.append('i32 0')
    k = 0
    for code in mod.codes:
        slot = k + 2
        if code.startswith('box:'):
            # a union's box: a class-like object with one field, at byte 16, that the runtime releases when it is a heap value
            kinds[slot] = 'i32 1'
            offs: list[str] = []
            if is_rc(code[4:]):
                offs.append('i32 16')
            offs.append('i32 -1')
            extra += '@tomato.offs.' + str(slot) + ' = constant [' + str(len(offs)) + ' x i32] [' + ', '.join(offs) + ']\n'
            offsets[slot] = 'ptr @tomato.offs.' + str(slot)
        elif is_class(code):
            c = mod.find_class(code[1:], 0)
            kinds[slot] = 'i32 1'
            if c.parent != '':
                zeros[slot] = 'i64 ' + str(mod.code_of('@' + c.parent))
            offs: list[str] = []
            for j, fld in enumerate(c.fields):
                if is_rc(fld.ty):
                    offs.append('i32 trunc (i64 ptrtoint (ptr getelementptr (%class.' + str(slot) + ', ptr null, i32 0, i32 ' + str(j + 2) + ') to i64) to i32)')
            offs.append('i32 -1')
            extra += '@tomato.offs.' + str(slot) + ' = constant [' + str(len(offs)) + ' x i32] [' + ', '.join(offs) + ']\n'
            offsets[slot] = 'ptr @tomato.offs.' + str(slot)
            extra += '@tomato.name.' + str(slot) + ' = private constant [' + str(len(c.display) + 1) + ' x i8] c"' + c.display + '\\00"\n'
            names[slot] = 'ptr @tomato.name.' + str(slot)
        elif is_set(code):
            kinds[slot] = 'i32 ' + str(3 + 256 * int_of_bool(set_elem(code) == 'str'))
        elif is_dict(code):
            kinds[slot] = 'i32 ' + str(3 + 256 + 512 * int_of_bool(is_rc(dict_value(code))))    # a table with text keys
        elif elem_of(code) == 'str' or is_rc(elem_of(code)):
            kinds[slot] = 'i32 258'          # a list: 2, plus 256 when its items are reference counted
        else:
            kinds[slot] = 'i32 2'
        k += 1
    count = str(n)
    t = '@tomato_exc = global ptr null\n'
    t += '@tomato_exc_line = global i32 0\n'
    t += '@tomato_exc_rt = global i32 0\n'
    t += '@tomato_exc_seen = global i32 0\n'
    t += extra
    t += '@tomato_class_names = constant [' + count + ' x ptr] [' + ', '.join(names) + ']\n'
    t += '@tomato_parents = global [' + count + ' x i64] [' + ', '.join(zeros) + ']\n'
    t += '@tomato_kinds = constant [' + count + ' x i32] [' + ', '.join(kinds) + ']\n'
    t += '@tomato_offsets = constant [' + count + ' x ptr] [' + ', '.join(offsets) + ']\n'
    return t

def declarations(mod: Mod) -> str:
    d = 'declare i32 @printf(ptr, ...)\n'
    d += 'declare i32 @putchar(i32)\n'
    d += 'declare void @tomato_fail(ptr)\n'
    d += 'declare void @tomato_leak_check()\n'
    d += 'declare void @tomato_retain(ptr)\n'
    d += 'declare void @tomato_release(ptr)\n'
    d += 'declare ptr @tomato_str_concat(ptr, ptr)\n'
    d += 'declare ptr @tomato_str_from_cstr(ptr)\n'
    d += 'declare i64 @tomato_str_len(ptr)\n'
    d += 'declare i32 @tomato_str_cmp(ptr, ptr)\n'
    d += 'declare ptr @tomato_str_index(ptr, i64)\n'
    d += 'declare ptr @tomato_str_slice(ptr, i64, i64)\n'
    d += 'declare ptr @tomato_list_concat(ptr, ptr, i32)\n'
    d += 'declare ptr @tomato_list_repeat(ptr, i64, i32)\n'
    d += 'declare ptr @tomato_str_repeat(ptr, i64)\n'
    d += 'declare ptr @tomato_str_slice3(ptr, i64, i64, i64, i32)\n'
    d += 'declare ptr @tomato_list_slice(ptr, i64, i64, i64, i32, i32)\n'
    d += 'declare ptr @tomato_str_from_i64(i64)\n'
    d += 'declare ptr @tomato_str_from_bool(i32)\n'
    d += 'declare ptr @tomato_str_from_f64(double)\n'
    d += 'declare ptr @tomato_box_str(ptr)\n'
    d += 'declare i64 @tomato_int_add(i64, i64)\n'
    d += 'declare i64 @tomato_int_sub(i64, i64)\n'
    d += 'declare i64 @tomato_int_mul(i64, i64)\n'
    d += 'declare i64 @tomato_int_floordiv(i64, i64)\n'
    d += 'declare i64 @tomato_int_mod(i64, i64)\n'
    d += 'declare i64 @tomato_int_pow(i64, i64)\n'
    d += 'declare i32 @tomato_int_cmp(i64, i64)\n'
    d += 'declare i32 @tomato_int_sign(i64)\n'
    d += 'declare i64 @tomato_int_from_i64(i64)\n'
    d += 'declare i64 @tomato_int_from_u64(i64)\n'
    d += 'declare i64 @tomato_int_raw(i64)\n'
    d += 'declare i64 @tomato_int_low64(i64)\n'
    d += 'declare i32 @tomato_int_in_range(i64, i32, i32)\n'
    d += 'declare double @tomato_int_to_f64(i64)\n'
    d += 'declare ptr @tomato_int_str(i64)\n'
    d += 'declare i64 @tomato_int_parse(ptr)\n'
    d += 'declare i64 @tomato_int_parse_cstr(ptr, i32)\n'
    d += 'declare i64 @tomato_int_bitop(i64, i64, i32)\n'
    d += 'declare i64 @tomato_f64_to_int(double)\n'
    d += 'declare double @tomato_parse_f64(ptr, i32)\n'
    d += 'declare i32 @tomato_ipow_check(i64, i64)\n'
    d += 'declare i64 @tomato_ipow(i64, i64)\n'
    d += 'declare double @tomato_floor_div_f64(double, double)\n'
    d += 'declare double @tomato_mod_f64(double, double)\n'
    d += 'declare double @tomato_pow_f64(double, double)\n'
    d += 'declare void @tomato_print_strobj(ptr)\n'
    d += 'declare ptr @tomato_alloc(i64, i64)\n'
    d += 'declare i32 @tomato_is_subclass(i64, i64)\n'
    d += 'declare ptr @tomato_dict_new(i64, i64, i32)\n'
    d += 'declare ptr @tomato_dict_find(ptr, i64)\n'
    d += 'declare ptr @tomato_dict_insert(ptr, i64, i32)\n'
    d += 'declare i32 @tomato_dict_delete(ptr, i64)\n'
    d += 'declare ptr @tomato_dict_keys(ptr, i64, i64)\n'
    d += 'declare void @tomato_usage(i32, i32)\n'
    d += 'declare i64 @tomato_parse_i64(ptr, i32)\n'
    d += 'declare i64 @tomato_parse_u64(ptr, i32)\n'
    d += 'declare void @tomato_fit_signed(i64, i32, i32)\n'
    d += 'declare void @tomato_fit_unsigned(i64, i32, i32)\n'
    d += 'declare i32 @tomato_parse_bool(ptr, i32)\n'
    d += 'declare void @tomato_report_uncaught(ptr, i32, i32, i32)\n'
    d += 'declare i64 @tomato_str_find(ptr, ptr)\n'
    d += 'declare i32 @tomato_str_startswith(ptr, ptr)\n'
    d += 'declare i32 @tomato_str_endswith(ptr, ptr)\n'
    d += 'declare i32 @tomato_str_contains(ptr, ptr)\n'
    d += 'declare ptr @tomato_str_replace(ptr, ptr, ptr)\n'
    d += 'declare ptr @tomato_str_split(ptr, ptr, i64, i64)\n'
    d += 'declare ptr @tomato_str_join(ptr, ptr)\n'
    d += 'declare ptr @tomato_str_upper(ptr)\n'
    d += 'declare ptr @tomato_str_lower(ptr)\n'
    d += 'declare ptr @tomato_str_strip(ptr)\n'
    d += 'declare ptr @tomato_file_open(ptr, ptr)\n'
    d += 'declare ptr @tomato_file_read(ptr)\n'
    d += 'declare void @tomato_file_write(ptr, ptr)\n'
    d += 'declare void @tomato_file_close(ptr)\n'
    d += 'declare ptr @tomato_list_new(i64)\n'
    d += 'declare ptr @tomato_list_push(ptr, i64)\n'
    d += '@.fmt.int = private constant [5 x i8] c"%lld\\00"\n'
    d += '@.fmt.uint = private constant [5 x i8] c"%llu\\00"\n'
    for extra in mod.decls:
        d += extra + '\n'
    d += 'declare ptr @tomato_str_from_u64(i64)\n'
    return d

def literal_text(n: Node, ty: str) -> str:
    # the IR constant for a default written as a plain literal (entry point inputs)
    if ty == 'int' and n.kind == 'IntLit':
        if n.fields[0].num >= 2 ** 61:
            raise CompileError('the default of an entry point input must be a whole number below 2 ** 61', n.line)
        return str(n.fields[0].num * 2 + 1)
    if is_numeric(ty) and n.kind == 'IntLit':
        return str(n.fields[0].num)
    if ty == 'bool' and n.kind == 'BoolLit':
        if n.fields[0].flag:
            return '1'
        return '0'
    raise CompileError('an entry point input default must be a plain number, True or False', n.line)

def entry_wrapper(info: FuncInfo, mod: Mod) -> str:
    # main(): read the command-line inputs, run the entry point, report an error nobody caught (D28a, D22a)
    k = len(info.ptypes)
    low = k - len(info.defaults)
    out = 'define i32 @main(i32 %argc, ptr %argv) {\nentry:\n  %n = sub i32 %argc, 1\n'
    out += '  %lo = icmp sge i32 %n, ' + str(low) + '\n  %hi = icmp sle i32 %n, ' + str(k) + '\n  %ok = and i1 %lo, %hi\n'
    out += '  br i1 %ok, label %go, label %bad\n'
    out += 'bad:\n  call void @tomato_usage(i32 ' + str(k) + ', i32 %n)\n  unreachable\ngo:\n'
    args: list[str] = []
    owned: list[str] = []
    for i, t in enumerate(info.ptypes):
        si = str(i)
        optional = i >= low
        if optional:
            out += '  %has' + si + ' = icmp sgt i32 %n, ' + si + '\n  br i1 %has' + si + ', label %p' + si + ', label %d' + si + '\np' + si + ':\n'
        out += '  %a' + si + '.ptr = getelementptr ptr, ptr %argv, i64 ' + str(i + 1) + '\n'
        out += '  %a' + si + '.s = load ptr, ptr %a' + si + '.ptr\n'
        reg = '%a' + si
        if t == 'str':
            out += '  %a' + si + '.v = call ptr @tomato_str_from_cstr(ptr %a' + si + '.s)\n'
        elif t == 'int':
            out += '  %a' + si + '.v = call i64 @tomato_int_parse_cstr(ptr %a' + si + '.s, i32 ' + str(i + 1) + ')\n'
        elif is_fixed(t):
            bits = bits_of(t)
            parse = 'tomato_parse_u64'
            fit = 'tomato_fit_unsigned'
            if is_signed(t):
                parse = 'tomato_parse_i64'
                fit = 'tomato_fit_signed'
            out += '  %a' + si + '.w = call i64 @' + parse + '(ptr %a' + si + '.s, i32 ' + str(i + 1) + ')\n'
            if bits < 64:
                out += '  call void @' + fit + '(i64 %a' + si + '.w, i32 ' + str(bits) + ', i32 ' + str(i + 1) + ')\n'
                out += '  %a' + si + '.v = trunc i64 %a' + si + '.w to i' + str(bits) + '\n'
            else:
                out += '  %a' + si + '.v = add i64 %a' + si + '.w, 0\n'
        elif t == 'float':
            out += '  %a' + si + '.v = call double @tomato_parse_f64(ptr %a' + si + '.s, i32 ' + str(i + 1) + ')\n'
        elif t == 'bool':
            out += '  %a' + si + '.w = call i32 @tomato_parse_bool(ptr %a' + si + '.s, i32 ' + str(i + 1) + ')\n'
            out += '  %a' + si + '.v = zext i32 %a' + si + '.w to i64\n'
        else:
            raise CompileError('a program input (a parameter of the @main function) must be an int, bool or str', 0)
        if optional:
            dflt = info.defaults[i - low]
            out += '  br label %m' + si + '\nd' + si + ':\n  br label %m' + si + '\nm' + si + ':\n'
            if t == 'str':
                if dflt.kind != 'StrLit':
                    raise CompileError('the default of a text input must be a plain text such as "abc"', dflt.line)
                out += '  %a' + si + ' = phi ptr [ %a' + si + '.v, %p' + si + ' ], [ ' + mod.intern(dflt.fields[0].text) + ', %d' + si + ' ]\n'
            elif t == 'float':
                raise CompileError('a program input cannot have a float default', dflt.line)
            else:
                out += '  %a' + si + ' = phi ' + llvm_type(t) + ' [ %a' + si + '.v, %p' + si + ' ], [ ' + literal_text(dflt, t) + ', %d' + si + ' ]\n'
        else:
            reg = '%a' + si + '.v'
        if t == 'str':
            args.append('ptr ' + reg)
            owned.append(reg)
        elif t == 'float':
            args.append('double ' + reg)
        else:
            args.append(llvm_type(t) + ' ' + reg)
    out += '  call void @tomato.' + info.key + '(' + ', '.join(args) + ')\n'
    out += '  %ex = load ptr, ptr @tomato_exc\n  %has = icmp ne ptr %ex, null\n  br i1 %has, label %uncaught, label %fine\n'
    out += 'uncaught:\n  %eline = load i32, ptr @tomato_exc_line\n  %ert = load i32, ptr @tomato_exc_rt\n'
    out += '  call void @tomato_report_uncaught(ptr %ex, i32 %eline, i32 %ert, i32 ' + str(mod.mode) + ')\n  unreachable\n'
    out += 'fine:\n'
    for reg in owned:
        out += '  call void @tomato_release(ptr ' + reg + ')\n'
    out += '  call void @tomato_leak_check()\n  ret i32 0\n}\n'
    return out

def key_of(module: str, name: str) -> str:
    # the program-wide name of a declaration: plain in the main program and the built-ins, module.name elsewhere
    if module == 'main' or module == 'builtin':
        return name
    return module + '.' + name

def function_info(item: Node, mod: Mod, owner: str) -> FuncInfo:
    info = FuncInfo()
    info.name = item.fields[0].text
    info.owner = owner
    info.module = mod.cur
    info.key = key_of(mod.cur, info.name)
    if len(item.fields) > 6:
        info.is_private = item.fields[4].flag
        info.is_gen = len(item.fields) > 7 and item.fields[7].flag
        info.is_override = item.fields[5].flag
        info.is_init = item.fields[6].tag == 's' and item.fields[6].text == 'init'
        if item.fields[6].tag == 's' and item.fields[6].text != 'init' and is_operator_marker(item.fields[6].text):
            info.op = item.fields[6].text
    if item.fields[2].tag != 'z':
        info.ret = mod.type_name(item.fields[2])
        if info.ret == '':
            raise CompileError('this return type is not supported\na function can return int, bool, str, float, a list, a set, a dict or a class', item.line)
    for p in val_nodes(item.fields[1]):
        if p.fields[0].text == 'self' and owner != '':
            continue
        if p.fields[2].tag == 'n':
            info.defaults.append(val_node(p.fields[2]))
        pt = mod.type_name(p.fields[1])
        if pt == '':
            raise CompileError('this parameter type is not supported\na function can take int, bool, str, float, a list, a set, a dict or a class', p.line)
        if p.fields[3].tag == 's':
            if p.fields[3].text == '*' and not pt.startswith('tuple['):
                raise CompileError("'*" + p.fields[0].text + "' needs a tuple type, such as tuple[int]", p.line)
            if p.fields[3].text == '**' and not is_dict(pt):
                raise CompileError("'**" + p.fields[0].text + "' needs a dict type, such as dict[int]", p.line)
            info.stars += 1
            if p.fields[3].text == '*':
                info.has_varargs = True
            else:
                info.has_kwargs = True
        info.pnames.append(p.fields[0].text)
        info.ptypes.append(pt)
    return info

def same_signature(a: FuncInfo, b: FuncInfo) -> bool:
    if a.ret != b.ret or len(a.ptypes) != len(b.ptypes):
        return False
    for k, t in enumerate(a.ptypes):
        if t != b.ptypes[k]:
            return False
    return True

def check_classes(mod: Mod):
    # overrides name a parent method of the same types, and a class has every method its interfaces require (D12g, D12bg)
    for f in mod.infos:
        if f.owner != '' and not f.is_init:
            c = mod.find_class(f.owner, 0)
            inherited: FuncInfo | None = None
            if c.parent != '':
                inherited = mod.lookup_method(c.parent, f.name)
            if inherited is not None and not f.is_override:
                raise CompileError("'" + f.owner + '.' + f.name + "' replaces a method of the parent class\nwrite 'override def' to say so", c.line)
            if inherited is None and f.is_override:
                raise CompileError("'" + f.owner + '.' + f.name + "' is marked 'override' but no parent class has that method", c.line)
            if inherited is not None and not same_signature(f, inherited):
                raise CompileError("'" + f.owner + '.' + f.name + "' must take and return the same types as the method it overrides", c.line)
            if not (f.name in mod.slots):
                mod.slots.append(f.name)
    for ifc in mod.ifaces:
        for r in ifc.reqs:
            if not (r.name in mod.slots):
                mod.slots.append(r.name)
    for c in mod.classes:
        for iname in mod.class_ifaces(c.name):
            closure: list[str] = []
            mod.iface_closure(iname, closure)
            for j in closure:
                for r in mod.find_iface(j, 0).reqs:
                    found = mod.lookup_method(c.name, r.name)
                    if found is None:
                        raise CompileError("class '" + c.name + "' is missing the method '" + r.name + "' that interface '" + j + "' requires", c.line)
                    if not same_signature(found, r):
                        raise CompileError("'" + c.name + '.' + r.name + "' must take and return exactly the types that interface '" + j + "' declares", c.line)

def check_class_shapes(mod: Mod):
    # one @init per class (D12aj); a class with no @init anywhere needs every field to have a value (D12af);
    # a method name is declared once; no class inherits from itself
    for c in mod.classes:
        inits = 0
        names: list[str] = []
        for f in mod.infos:
            if f.owner == c.name:
                if f.name in names or field_position(c, f.name) >= 0:
                    raise CompileError("'" + f.name + "' is defined twice in class '" + c.display + "'", c.line)
                names.append(f.name)
                if f.is_init:
                    inits += 1
        if inits > 1:
            raise CompileError("class '" + c.display + "' has more than one @init method\nkeep one", c.line)
        seen: list[str] = []
        walk = c
        while walk.parent != '':
            if walk.parent in seen or walk.parent == c.name:
                raise CompileError("class '" + c.display + "' inherits from itself, directly or through its parents", c.line)
            seen.append(walk.parent)
            walk = mod.find_class(walk.parent, c.line)
        if not has_init(mod, c):
            for fld in c.fields:
                if fld.owner == c.name and fld.default is None:
                    raise CompileError("class '" + c.display + "' has no @init method, but the field '" + fld.name + "' has no starting value\ngive the field a value, or add an @init method that sets it", c.line)

def has_init(mod: Mod, c: ClassInfo) -> bool:
    if c.init != '':
        return True
    if c.parent != '':
        return has_init(mod, mod.find_class(c.parent, c.line))
    return False

def show_item(mod: Mod, et: str, e: str, line: int) -> str:
    # Tomato source that shows the item `e` of type et inside a printed container
    if et == 'str':
        return '_quote(' + e + ')'
    if is_list(et) or is_dict(et) or is_set(et):
        return mod.helper('show', et, line).name + '(' + e + ')'
    if is_class(et):
        if not mod.has_op(et[1:], 'str'):
            raise CompileError("'" + et[1:] + "' objects cannot be printed or converted to text\nadd a method marked @str that returns text", line)
    elif not (is_numeric(et) or et == 'bool' or et == 'float' or is_union(et)):
        raise CompileError('a list of ' + shown(et) + ' cannot be printed\nprint its items one by one instead', line)
    return 'str(' + e + ')'

def iter_elem(mod: Mod, ty: str) -> str:
    # what the @iter method of a class yields
    return mod.find_op(ty[1:], 'iter').ret

def helper_source(mod: Mod, name: str, kind: str, ty: str, line: int) -> str:
    # the Tomato source of a helper function; parameters are written as int and given their real types by helper_types
    head = 'def ' + name + '(x: int) -> str:\n'
    if is_class(ty):
        et = iter_elem(mod, ty)
        if kind == 'tolist':
            return head + '    out: list[' + shown(et) + '] = []\n    for v in x:\n        out.append(v)\n    return out\n'
        if not (et == 'int' or et == 'float' or (et == 'str' and kind != 'sum')):
            wanted = ' or text'
            if kind == 'sum':
                wanted = ''
            raise CompileError(kind + '() needs something that gives numbers' + wanted + ', but ' + shown(ty) + ' gives ' + shown(et), line)
        zero = '0'
        if et == 'float':
            zero = '0.0'
        if et == 'str':
            zero = "''"
        if kind == 'sum':
            return head + '    total: ' + shown(et) + ' = ' + zero + '\n    for v in x:\n        total = total + v\n    return total\n'
        better = '<'
        if kind == 'max':
            better = '>'
        return head + '    first = True\n    best: ' + shown(et) + ' = ' + zero + '\n    for v in x:\n        if first or v ' + better + ' best:\n            best = v\n            first = False\n    if first:\n        raise RuntimeError(\'' + kind + '() of an empty sequence\')\n    return best\n'
    if kind == 'show':
        if is_dict(ty):
            body = "    out = '{'\n    first = True\n    for k in x:\n        if not first:\n            out = out + ', '\n        first = False\n"
            body += "        out = out + _quote(k) + ': ' + " + show_item(mod, dict_value(ty), 'x[k]', line) + '\n'
            return head + body + "    return out + '}'\n"
        open_text = '['
        close_text = ']'
        elem = elem_of(ty)
        if is_set(ty):
            open_text = '{'
            close_text = '}'
            elem = set_elem(ty)
        elif ty.startswith('tuple['):
            open_text = '('
            close_text = ')'
        body = ''
        if is_set(ty):
            body = "    if len(x) == 0:\n        return 'set()'\n"
        body += "    out = '" + open_text + "'\n    first = True\n    for e in x:\n        if not first:\n            out = out + ', '\n        first = False\n"
        body += '        out = out + ' + show_item(mod, elem, 'e', line) + '\n'
        if ty.startswith('tuple['):
            body += "    if len(x) == 1:\n        out = out + ','\n"
        return head + body + "    return out + '" + close_text + "'\n"
    if kind == 'sum':
        zero = '0'
        if elem_of(ty) == 'float':
            zero = '0.0'
        return head + '    total: ' + shown(elem_of(ty)) + ' = ' + zero + '\n    for v in x:\n        total = total + v\n    return total\n'
    if kind == 'min' or kind == 'max':
        better = '<'
        if kind == 'max':
            better = '>'
        return head + "    if len(x) == 0:\n        raise RuntimeError('" + kind + "() of an empty list')\n    best = x[0]\n    for v in x:\n        if v " + better + ' best:\n            best = v\n    return best\n'
    if kind == 'sorted':
        t = shown(elem_of(ty))
        body = '    a: list[' + t + '] = []\n    b: list[' + t + '] = []\n    for v in x:\n        a.append(v)\n        b.append(v)\n'
        body += '    n = len(a)\n    width = 1\n    while width < n:\n        i = 0\n        while i < n:\n'
        body += '            mid = i + width\n            if mid > n:\n                mid = n\n            hi = i + 2 * width\n            if hi > n:\n                hi = n\n'
        body += '            left = i\n            right = mid\n            k = i\n            while left < mid and right < hi:\n'
        body += '                if a[right] < a[left]:\n                    b[k] = a[right]\n                    right = right + 1\n                else:\n                    b[k] = a[left]\n                    left = left + 1\n                k = k + 1\n'
        body += '            while left < mid:\n                b[k] = a[left]\n                left = left + 1\n                k = k + 1\n'
        body += '            while right < hi:\n                b[k] = a[right]\n                right = right + 1\n                k = k + 1\n'
        body += '            i = i + 2 * width\n        j = 0\n        while j < n:\n            a[j] = b[j]\n            j = j + 1\n        width = width * 2\n    return a\n'
        return head + body
    raise CompileError('internal compiler error: no helper of kind ' + kind, line)

def helper_types(mod: Mod, info: FuncInfo, kind: str, ty: str):
    # give the stub parameter its real type
    if is_class(ty):
        info.ptypes[0] = ty
        if kind == 'tolist':
            info.ret = 'list[' + iter_elem(mod, ty) + ']'
        else:
            info.ret = iter_elem(mod, ty)
        return
    if kind == 'show':
        info.ptypes[0] = ty
        info.ret = 'str'
    elif kind == 'sorted':
        info.ptypes[0] = ty
        info.ret = ty
    else:
        info.ptypes[0] = ty
        info.ret = elem_of(ty)

def plural(n: int, word: str) -> str:
    if n == 1:
        return '1 ' + word
    return str(n) + ' ' + word + 's'

def top_level_message(item: Node) -> str:
    if item.kind == 'ExprStmt' or item.kind == 'Assign' or item.kind == 'AugAssign' or item.kind == 'Return' or item.kind == 'If' or item.kind == 'While' or item.kind == 'For' or item.kind == 'Pass':
        return 'this statement is outside any function\nprograms have no top-level code: put it inside a function marked @main (only the repl accepts bare statements)'
    return 'this kind of declaration (' + item.kind + ') is not supported'

def class_def(c: ClassInfo) -> Node:
    n = c.node
    if n is None:
        raise CompileError('internal compiler error: class ' + c.name + ' has no declaration', c.line)
    return n

def field_position(c: ClassInfo, name: str) -> int:
    for k, fld in enumerate(c.fields):
        if fld.name == name:
            return k
    return -1

def resolve_class(mod: Mod, c: ClassInfo):
    # fill a class's fields and defaults, its parent's first (a field may name a class declared later)
    if c.done:
        return
    c.done = True
    node = class_def(c)
    mod.cur = c.module
    if c.parent != '':
        p = mod.find_class(c.parent, node.line)
        resolve_class(mod, p)
        mod.cur = c.module
        c.fields = c.fields + p.fields
    for fd in val_nodes(node.fields[3]):
        ft = mod.type_name(fd.fields[1])
        if ft == '':
            raise CompileError('this field type is not supported\na field can hold int, bool, str, float, a list, a set, a dict or a class', fd.line)
        before = field_position(c, fd.fields[0].text)
        if before >= 0:
            if c.fields[before].owner == c.name:
                raise CompileError("the field '" + fd.fields[0].text + "' is defined twice", fd.line)
            raise CompileError("the field '" + fd.fields[0].text + "' is already defined by a parent class\nuse a different name", node.line)
        fld = FieldInfo()
        fld.name = fd.fields[0].text
        fld.ty = ft
        fld.is_private = fd.fields[2].flag
        fld.is_const = fd.fields[3].flag
        fld.owner = c.name
        if fd.fields[4].tag == 'n':
            fld.default = val_node(fd.fields[4])
        c.fields.append(fld)

def read_module(dir: str, std: str, name: str, line: int) -> str:
    # a module next to the program, else one from the standard library
    text = ''
    try:
        f = open(dir + name + '.tom')
        text = f.read()
        f.close()
    catch IOError:
        try:
            g = open(std + name + '.tom')
            text = g.read()
            g.close()
        catch IOError:
            raise CompileError("cannot find the module '" + name + "'\nlooked for " + name + ".tom next to the program and in the standard library", line)
    return text

class TopItem:
    # a top-level declaration and the module that wrote it
    node: Node = Node()
    module: str = ''

def top_item(node: Node, module: str) -> TopItem:
    t = TopItem()
    t.node = node
    t.module = module
    return t

def load_items(mod: Mod, dir: str, std: str, src: str, module: str, items: list[TopItem], imports: list[ImportInfo], loaded: list[str]) -> list[Node]:
    # the declarations of src, placed after those of the modules it imports (each module once)
    mod.sources[module] = src
    mod.loading = module
    mine = val_nodes(parse(src).fields[0])
    mod.loading = ''
    for item in mine:
        if item.kind == 'Import':
            wanted = item.fields[0].text
            ii = ImportInfo()
            ii.importer = module
            ii.module = wanted
            ii.line = item.line
            for nm in item.fields[1].items:
                ii.names.append(nm.text)
            imports.append(ii)
            if not (wanted in loaded):
                mod.cur = module
                loaded.append(wanted)
                load_items(mod, dir, std, read_module(dir, std, wanted, item.line), wanted, items, imports, loaded)
    own: list[Node] = []
    for item in mine:
        if item.kind != 'Import':
            own.append(item)
            items.append(top_item(item, module))
    return own

def build_scopes(mod: Mod, items: list[TopItem], imports: list[ImportInfo]):
    # every module sees its own declarations, the built-ins, and what it imports (D24c)
    for top in items:
        item = top.node
        if item.kind == 'FuncDef' or item.kind == 'ClassDef' or item.kind == 'InterfaceDef' or item.kind == 'ConstDef':
            name = item.fields[0].text
            mod.declare_name(top.module, name, key_of(top.module, name), item.exported, item.line)
    for ii in imports:
        for nm in ii.names:
            mod.declare_name(ii.importer, nm, mod.exported_key(ii.module, nm, ii.line), False, ii.line)

def compile_with(mod: Mod, src: str, dir: str, std: str, entry_name: str, mode: str) -> str:
    if mode == 'normal':
        mod.mode = 2
        table = open(std + 'errors.txt')
        mod.errors = table.read().split('\n')
        table.close()
    elif mode == 'release':
        mod.mode = 3
    elif mode != 'debug':
        raise CompileError("the mode must be debug, normal or release, not '" + mode + "'", 0)
    mod.loading = 'builtin'
    base = open(std + 'builtin.tom')
    base_text = base.read()
    base.close()
    mod.sources['builtin'] = base_text
    items: list[TopItem] = []
    for b in val_nodes(parse(base_text).fields[0]):
        items.append(top_item(b, 'builtin'))
    mod.loading = ''
    imports: list[ImportInfo] = []
    loaded: list[str] = []
    user = load_items(mod, dir, std, src, 'main', items, imports, loaded)
    build_scopes(mod, items, imports)
    for top in items:
        item = top.node
        mod.cur = top.module
        if item.kind == 'InterfaceDef':
            ifc = IfaceInfo()
            ifc.name = key_of(top.module, item.fields[0].text)
            ifc.module = top.module
            ifc.line = item.line
            mod.ifaces.append(ifc)
        elif item.kind == 'ClassDef':
            c = ClassInfo()
            c.name = key_of(top.module, item.fields[0].text)
            c.display = item.fields[0].text
            c.module = top.module
            c.node = item
            c.line = item.line
            mod.classes.append(c)
    # parents, interfaces and `implements` lines, resolved in the module that wrote them
    for top in items:
        item = top.node
        mod.cur = top.module
        if item.kind == 'InterfaceDef':
            target = mod.find_iface(key_of(top.module, item.fields[0].text), item.line)
            for pv in item.fields[1].items:
                target.parents.append(mod.iface_key(pv.text, item.line))
        elif item.kind == 'ClassDef':
            c = mod.find_class(key_of(top.module, item.fields[0].text), item.line)
            if item.fields[1].tag == 's':
                c.parent = mod.class_key(item.fields[1].text, item.line)
            for iv in item.fields[2].items:
                c.ifaces.append(mod.iface_key(iv.text, item.line))
        elif item.kind == 'Implements':
            mod.find_class(mod.class_key(item.fields[0].text, item.line), item.line).ifaces.append(mod.iface_key(item.fields[1].text, item.line))
    for c in mod.classes:
        resolve_class(mod, c)
    for top in items:
        item = top.node
        mod.cur = top.module
        if item.kind == 'InterfaceDef':
            target = mod.find_iface(key_of(top.module, item.fields[0].text), item.line)
            for m in val_nodes(item.fields[2]):
                target.reqs.append(function_info(m, mod, 'self'))
    funcs: list[Node] = []
    entry = ''
    for top in items:
        item = top.node
        mod.cur = top.module
        if item.kind == 'FuncDef':
            info = function_info(item, mod, '')
            mod.infos.append(info)
            mod.func_nodes.append(item)
            funcs.append(item)
        elif item.kind == 'ClassDef':
            c = mod.find_class(key_of(top.module, item.fields[0].text), item.line)
            for m in val_nodes(item.fields[4]):
                info = function_info(m, mod, c.name)
                mod.infos.append(info)
                mod.func_nodes.append(m)
                funcs.append(m)
                if m.fields[6].tag == 's' and m.fields[6].text == 'init':
                    c.init = info.name
        elif item.kind == 'InterfaceDef' or item.kind == 'Implements':
            pass
        elif item.kind == 'ConstDef':
            cv = val_node(item.fields[1])
            if cv.kind == 'UnOp' and cv.fields[0].text == '-':
                cv = val_node(cv.fields[1])
            if not (cv.kind == 'IntLit' or cv.kind == 'FloatLit' or cv.kind == 'StrLit' or cv.kind == 'BoolLit'):
                raise CompileError("the constant '" + item.fields[0].text + "' must be a number, text or True or False written out\na constant is not code: write its value as a literal, such as 3.14", item.line)
            mod.consts[key_of(top.module, item.fields[0].text)] = val_node(item.fields[1])
        elif item.kind == 'LlvmDecl':
            decl = function_info(item, mod, '')
            for pt in decl.ptypes:
                if pt == 'File' or (is_rc(pt) and pt != 'str'):
                    raise CompileError('an LLVM function can only take and return int, bool and float values', item.line)
            mod.llvm_decls.append(decl)
        else:
            raise CompileError(top_level_message(item), item.line)
    check_classes(mod)
    check_class_shapes(mod)
    for item in user:
        if item.kind == 'FuncDef' and item.fields[6].tag == 's' and item.fields[6].text == 'entry:' + entry_name:
            entry = item.fields[0].text
            if item.fields[2].tag != 'z':
                raise CompileError('an entry point (a function marked with @main or similar) cannot return a value', item.line)
    if entry == '':
        raise CompileError("no function is marked @" + entry_name + "\nwrite @" + entry_name + " on the line above the function that should start the program", 0)
    bodies = ''
    for k, f in enumerate(funcs):
        if not mod.infos[k].is_gen:          # a generator is compiled where a for loop uses it
            bodies += compile_function(f, mod, mod.infos[k]) + '\n'
    # compiling a function can ask for more helper functions, so the list may grow while this runs
    done = 0
    while done < len(mod.extra_funcs):
        bodies += compile_function(mod.extra_funcs[done], mod, mod.infos[len(funcs) + done]) + '\n'
        done += 1
    for c in mod.classes:
        bodies += compile_constructor(c, mod) + '\n'
    mod.cur = 'main'
    wrapper = entry_wrapper(mod.find(entry, 1), mod)
    out = '; written by the Tomato compiler in Tomato (compiler/src/compiler.tom)\n'
    out += declarations(mod) + class_types(mod) + runtime_tables(mod) + vtables(mod)
    for j, s in enumerate(mod.strings):
        out += string_global(j, s) + '\n'
        out += string_c(j, s) + '\n'
    out += '\n' + bodies
    out += wrapper
    return out

def located(mod: Mod, message: str, line: int, col: int, module: str, path: str) -> str:
    # the error as the user sees it: the message, then the place and the source line of the module it is in
    if module in mod.sources:
        where = path
        if module != 'main':
            where = module + '.tom'
        return format_error(message, line, col, mod.sources[module], where)
    return format_error(message, 0, 0, '', '')

export def compile_module(src: str, dir: str, std: str, entry_name: str, mode: str = 'debug', path: str = '') -> str:
    # LLVM IR for the program, or a Diagnostic whose message is the finished error text
    mod = Mod()
    result = ''
    try:
        result = compile_with(mod, src, dir, std, entry_name, mode)
    catch LexError as e:
        raise Diagnostic(located(mod, e.message, e.line, e.col, mod.loading, path))
    catch ParseError as e:
        raise Diagnostic(located(mod, e.message, e.line, e.col, mod.loading, path))
    catch CompileError as e:
        raise Diagnostic(located(mod, e.message, e.line, e.col, mod.cur, path))
    return result
