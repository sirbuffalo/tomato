# The Tomato parser, written in Tomato (D38a): turns the lexer's tokens into a syntax tree.
#
# Every node is one class: a kind, a line and an ordered list of field values (a Val holds a name, number, bool,
# None, node, list or tuple), in the order the language grammar lists them. `dump` writes the tree as text so
# the tree can be inspected.
from lexer import Token, lex, make_token

export class ParseError(Error):
    line: int = 0
    col: int = 0

    @init
    def make(self, message: str, line: int, col: int = 0):
        Error.start(self, message)
        self.line = line
        self.col = col

export def val_node(v: Val) -> Node:
    n = v.node
    if n is None:
        raise ParseError('internal compiler error: a missing syntax node', 0)
    return n

export def val_nodes(v: Val) -> list[Node]:
    return [val_node(item) for item in v.items]

def pairing_call(n: Node) -> str:
    # enumerate or zip when this expression is a call of one, else ''
    if n.kind != 'Call':
        return ''
    f = val_node(n.fields[0])
    if f.kind == 'Name' and (f.fields[0].text == 'enumerate' or f.fields[0].text == 'zip'):
        return f.fields[0].text
    return ''

def path_text(n: Node) -> str:
    # a variable or a chain of fields written as text, or '' for any other expression
    if n.kind == 'Name':
        return n.fields[0].text
    if n.kind == 'Attr':
        inner = path_text(val_node(n.fields[0]))
        if inner == '':
            return ''
        return f'{inner}.{n.fields[1].text}'
    return ''

def found_text(t: Token) -> str:
    # what the offending token is, in words
    if t.kind == 'NEWLINE':
        return 'the end of the line'
    if t.kind == 'INDENT':
        return 'an unexpected indented line'
    if t.kind == 'DEDENT':
        return 'the end of the block'
    if t.kind == 'EOF':
        return 'the end of the file'
    if t.kind == 'STR':
        return 'a text'
    if t.kind == 'KW':
        return f"the word '{t.text}'"
    return f"'{t.text}'"

def kind_text(kind: str) -> str:
    if kind == 'NAME':
        return 'a name'
    if kind == 'NEWLINE':
        return 'the end of the line'
    if kind == 'INDENT':
        return 'an indented block'
    return f'a {kind}'

export class Val:
    tag: str = 'z'       # n node, s text, i number, b bool, z None, l list, t tuple
    text: str = ''
    num: int = 0
    flag: bool = False
    node: Node | None = None
    items: list[Val] = []

export class Node:
    kind: str = ''
    line: int = 0
    mark: int = 0            # the compiler numbers the statements of a small-int loop here while it compiles that loop
    spot: int = 0            # the same for the statements of a loop nest (see Gen.nest_loop in compiler.tom)
    exported: bool = False
    fields: list[Val] = []

export def vs(text: str) -> Val:
    v = Val()
    v.tag = 's'
    v.text = text
    return v

def vi(n: int) -> Val:
    v = Val()
    v.tag = 'i'
    v.num = n
    return v

export def vb(b: bool) -> Val:
    v = Val()
    v.tag = 'b'
    v.flag = b
    return v

export def vz() -> Val:
    return Val()

export def vn(n: Node) -> Val:
    v = Val()
    v.tag = 'n'
    v.node = n
    return v

export def vlist(items: list[Val]) -> Val:
    v = Val()
    v.tag = 'l'
    v.items = items
    return v

export def vtuple(items: list[Val]) -> Val:
    v = Val()
    v.tag = 't'
    v.items = items
    return v

export def vnodes(nodes: list[Node]) -> Val:
    return vlist([vn(n) for n in nodes])

def vopt_text(s: str) -> Val:
    # `None` is written as the empty text, which is never a real name
    if s == '':
        return vz()
    return vs(s)

export def mk(kind: str, line: int, fields: list[Val]) -> Node:
    n = Node()
    n.kind = kind
    n.line = line
    n.fields = fields
    return n

# ---- the text form of a tree

def escape(s: str) -> str:
    return s.replace('\\', '\\\\').replace('"', '\\"').replace('\n', '\\n').replace('\r', '\\r')

def dump_vals(items: list[Val]) -> str:
    parts: list[str] = [dump_val(v) for v in items]
    return ' '.join(parts)

def dump_val(v: Val) -> str:
    if v.tag == 'n':
        return dump(v.node)
    if v.tag == 's':
        return f'"{escape(v.text)}"'
    if v.tag == 'i':
        return str(v.num)
    if v.tag == 'b':
        if v.flag:
            return 'True'
        return 'False'
    if v.tag == 'l':
        return f'[{dump_vals(v.items)}]'
    if v.tag == 't':
        return f'<{dump_vals(v.items)}>'
    return 'None'

export def dump(n: Node) -> str:
    s = f'({n.kind} {n.line}'
    if n.exported:
        s += ' exported'
    for v in n.fields:
        s += f' {dump_val(v)}'
    return f'{s})'

def is_type_with_length(name: str) -> bool:
    return name == 'int' or name == 'uint'

const FLOAT_HAS_NO_LENGTH = 'float has no length: there is one float type, with an exponent of any size\nwrite float'

export def is_operator_marker(name: str) -> bool:
    # a method marked with an operator's name implements that operator for its class (D12j-l); names beyond @add are placeholders (P65); @neg is unary - and @rmul is a number on the left of *
    return name in ['add', 'sub', 'mul', 'div', 'floordiv', 'mod', 'pow', 'eq', 'lt', 'le', 'gt', 'ge', 'str',
                    'iter', 'len', 'get', 'slice', 'contains', 'reversed', 'static', 'bitarray', 'set', 'bitand', 'bitor', 'bitxor', 'invert', 'neg', 'rmul', 'hash']

def is_none_name(n: Node) -> bool:
    return n.kind == 'Name' and n.fields[0].text == 'None'

# gives a generated tree (made from text) the line of the statement it stands for
def set_line(v: Val, line: int):
    if v.tag == 'n' and v.node is not None:
        v.node.line = line
        for f in v.node.fields:
            set_line(f, line)
    elif v.tag == 'l' or v.tag == 't':
        for item in v.items:
            set_line(item, line)

def plural_values(n: int) -> str:
    if n == 1:
        return '1 value'
    return f'{n} values'

def plural_vars(n: int) -> str:
    if n == 1:
        return '1 variable'
    return f'{n} variables'

# the left side of = and += must be a variable, a field or a list item; t is the first token of the statement
def check_target(e: Node, t: Token):
    if not (e.kind == 'Name' or e.kind == 'Attr' or e.kind == 'Index'):
        raise ParseError('cannot assign to this expression\nthe left side of = must be a variable, a field or a list item', t.line, t.col)

export class Parser:
    toks: list[Token] = []
    p: int = 0
    unpacks: int = 0        # how many multiple assignments have been read (they name their hidden variables)
    yields: int = 0         # how many yield statements have been read so far (a function with any is a generator)

    def cur(self) -> Token:
        return self.toks[self.p]

    def peek(self, k: int) -> Token:
        return self.toks[min(self.p + k, len(self.toks) - 1)]

    def qualify(self, mod: str):
        # from here on, the tokens NAME(mod) OP(.) NAME(x) become one NAME 'mod.x'
        out: list[Token] = []
        i = 0
        toks = self.toks
        while i < len(toks):
            tk = toks[i]
            joined = (i >= self.p and tk.kind == 'NAME' and tk.text == mod and i + 2 < len(toks) and toks[i + 1].kind == 'OP'
                      and toks[i + 1].text == '.' and toks[i + 2].kind == 'NAME' and not (i > 0 and toks[i - 1].kind == 'OP' and toks[i - 1].text == '.'))
            if joined:
                out.append(make_token('NAME', mod + '.' + toks[i + 2].text, 0, tk.line, tk.col))
                i += 3
            else:
                out.append(tk)
                i += 1
        self.toks = out

    def adv(self) -> Token:
        t = self.toks[self.p]
        self.p += 1
        return t

    def peek_is(self, k: int, kind: str, text: str) -> bool:
        t = self.peek(k)
        return t.kind == kind and t.text == text

    def is_op(self, v: str) -> bool:
        return self.peek_is(0, 'OP', v)

    def is_kw(self, v: str) -> bool:
        return self.peek_is(0, 'KW', v)

    def accept_op(self, v: str) -> bool:
        if self.is_op(v):
            self.p += 1
            return True
        return False

    def accept_kw(self, v: str) -> bool:
        if self.is_kw(v):
            self.p += 1
            return True
        return False

    # one or more names separated by commas
    def name_texts(self) -> list[str]:
        names = [self.expect('NAME').text]
        while self.accept_op(','):
            names.append(self.expect('NAME').text)
        return names

    # the same, as text values
    def name_list(self) -> list[Val]:
        return [vs(name) for name in self.name_texts()]

    def err(self, msg: str):
        t = self.cur()
        raise ParseError(f'{msg}, but found {found_text(t)}', t.line, t.col)

    def expect_op(self, v: str) -> Token:
        if not self.is_op(v):
            self.err(f"expected '{v}'")
        return self.adv()

    def expect_kw(self, v: str) -> Token:
        if not self.is_kw(v):
            self.err(f"expected '{v}'")
        return self.adv()

    def expect(self, kind: str) -> Token:
        if self.cur().kind != kind:
            self.err(f'expected {kind_text(kind)}')
        return self.adv()

    # module
    def module(self) -> Node:
        body: list[Node] = []
        while self.cur().kind != 'EOF':
            item = self.top_item()
            if item.kind == 'Module':
                body.extend(val_nodes(item.fields[0]))     # `C implements A, B`: one Implements per interface
            else:
                body.append(item)
        return mk('Module', 1, [vnodes(body)])

    def top_item(self) -> Node:
        t = self.cur()
        if self.is_op('!'):
            self.adv()
            nm = self.expect('NAME')
            params = self.params()
            ret = vz()
            if self.accept_op('->'):
                ret = vn(self.type())
            self.expect('NEWLINE')
            return mk('LlvmDecl', t.line, [vs(nm.text), vnodes(params), ret])
        if self.is_kw('const'):
            self.adv()
            cn = self.expect('NAME')
            self.expect_op('=')
            cv = self.expr()
            self.expect('NEWLINE')
            return mk('ConstDef', t.line, [vs(cn.text), vn(cv)])
        if self.is_kw('export'):
            self.adv()
            if not (self.is_def() or self.is_kw('class') or self.is_kw('interface') or self.is_kw('const') or self.is_op('@')):
                self.err('expected a function, class, interface or constant after export')
            d = self.top_item()
            d.exported = True
            return d
        if self.is_kw('from'):
            self.adv()
            mod = self.expect('NAME').text
            self.expect_kw('import')
            names = self.name_list()
            self.expect('NEWLINE')
            return mk('Import', t.line, [vs(mod), vlist(names)])
        if self.is_kw('import'):
            # import module: afterwards `module.name` stands for the exported name (a NAME token written 'module.name'), so
            # the module's names are reached without bringing them in bare (D24b, D24c)
            self.adv()
            mod = self.expect('NAME').text
            self.expect('NEWLINE')
            self.qualify(mod)
            return mk('Import', t.line, [vs(mod), vlist([vs('*')])])
        if self.is_op('@'):
            self.adv()
            m = self.expect('NAME')
            if (m.text == 'init' or is_operator_marker(m.text)) and not self.is_op('.'):
                raise ParseError(f"'@{m.text}' marks a method, so it belongs inside a class\nmove this function into a class, or remove the marker", m.line, m.col - 1)
            marker = m.text
            while self.is_op('.'):
                # a dotted entry name, @greet.loud (D96a): the entry `greet` runs every @greet.*, `greet.loud` runs one
                self.adv()
                marker = marker + '.' + self.expect('NAME').text
            self.expect('NEWLINE')
            if not self.is_def():
                self.err(f'expected a function after @{marker}')
            return self.funcdef(False, 'entry:' + marker, False, True)
        if self.is_def():
            return self.funcdef(False, '', False, True)
        if self.is_kw('class'):
            return self.classdef()
        if self.is_kw('interface'):
            return self.interfacedef()
        if t.kind == 'NAME' and self.peek_is(1, 'KW', 'implements'):
            cls = self.adv()
            self.adv()
            out: list[Node] = []
            while True:
                out.append(mk('Implements', cls.line, [vs(cls.text), vs(self.expect('NAME').text)]))
                if not self.accept_op(','):
                    break
            self.expect('NEWLINE')
            if len(out) == 1:
                return out[0]
            return mk('Module', cls.line, [vnodes(out)])
        return self.statement()

    # types
    def type(self) -> Node:
        base = self.inter_type()
        if self.is_op('|'):
            members: list[Node] = [base]
            line = self.cur().line
            while self.is_op('|'):
                self.adv()
                members.append(self.inter_type())
            return mk('TypeRef', line, [vs('union'), vz(), vnodes(members), vz()])
        return base

    def inter_type(self) -> Node:
        base = self.base_type()
        if self.is_op('&'):
            members: list[Node] = [base]
            line = self.cur().line
            while self.is_op('&'):
                self.adv()
                members.append(self.base_type())
            return mk('TypeRef', line, [vs('intersection'), vz(), vnodes(members), vz()])
        return base

    def base_type(self) -> Node:
        if self.cur().kind != 'NAME':
            self.err('expected a type name')
        t = self.expect('NAME')
        if t.text == 'fn' and self.is_op('('):
            # a function value's type: fn(int, str) -> bool; without -> it returns nothing
            self.adv()
            ptypes: list[Node] = []
            while not self.is_op(')'):
                ptypes.append(self.type())
                if not self.accept_op(','):
                    break
            self.expect_op(')')
            res = vz()
            if self.accept_op('->'):
                res = vn(self.type())
            return mk('TypeRef', t.line, [vs('fn'), vz(), vnodes(ptypes), res])
        if t.text == 'list' or t.text == 'set' or t.text == 'tuple' or (t.text == 'Iterable' and self.is_op('[')):
            self.expect_op('[')
            arg = self.type()
            if t.text == 'tuple' and self.is_op(','):
                # tuple[str, int]: a tuple of a fixed length whose items have their own types (its item types are a list)
                items: list[Node] = [arg]
                while self.accept_op(','):
                    items.append(self.type())
                self.expect_op(']')
                return mk('TypeRef', t.line, [vs('tuple'), vz(), vnodes(items), vz()])
            self.expect_op(']')
            return mk('TypeRef', t.line, [vs(t.text), vz(), vn(arg), vz()])
        if t.text == 'task' and self.is_op('['):
            self.adv()
            targ = self.type()
            tstat = vz()
            if self.accept_op(','):
                tstat = vn(self.type())
            self.expect_op(']')
            return mk('TypeRef', t.line, [vs('task'), vz(), vn(targ), tstat])
        if t.text == 'dict':
            self.expect_op('[')
            arg = self.type()
            self.expect_op(',')
            arg2 = self.type()
            self.expect_op(']')
            return mk('TypeRef', t.line, [vs('dict'), vz(), vn(arg), vn(arg2)])
        length = vz()
        if t.text == 'float' and self.is_op('['):
            raise ParseError(FLOAT_HAS_NO_LENGTH, t.line, t.col)
        if is_type_with_length(t.text) and self.is_op('['):
            self.adv()
            key = self.expect('NAME')
            if key.text != 'length':
                raise ParseError('integer types take only length=, as in int[length=32]', key.line, key.col)
            self.expect_op('=')
            length = vn(self.expr())
            self.expect_op(']')
        elif self.is_op('[') and t.text != 'int' and t.text != 'uint':
            # a generic class with its type arguments: Box[int], Pair[str, int] (D60a)
            self.adv()
            first = self.type()
            second = vz()
            if self.accept_op(','):
                second = vn(self.type())
            if self.is_op(','):
                # three or more type arguments, Cache[int, int, str, float]: they are a list, as for tuple[A, B, C]
                parts: list[Node] = [first, val_node(second)]
                while self.accept_op(','):
                    parts.append(self.type())
                self.expect_op(']')
                return mk('TypeRef', t.line, [vs(t.text), vz(), vnodes(parts), vz()])
            self.expect_op(']')
            return mk('TypeRef', t.line, [vs(t.text), vz(), vn(first), second])
        return mk('TypeRef', t.line, [vs(t.text), length, vz(), vz()])

    # declarations
    def params(self) -> list[Node]:
        self.expect_op('(')
        out: list[Node] = []
        while not self.is_op(')'):
            star = ''
            if self.is_op('**'):
                self.adv()
                star = '**'
            elif self.is_op('*'):
                self.adv()
                if self.accept_op('*'):
                    star = '**'
                else:
                    star = '*'
            nm = self.expect('NAME')
            ty = vz()
            if self.accept_op(':'):
                ty = vn(self.type())
            default = vz()
            if self.accept_op('='):
                default = vn(self.expr())
            if star != '':
                if ty.tag == 'z' or default.tag != 'z':
                    raise ParseError(f"'{star}{nm.text}' needs a type and cannot have a default value", nm.line, nm.col)
                if self.any_star(out, '**') or (star == '*' and self.any_star(out, '')):
                    raise ParseError("'*args' must come before '**kwargs', and both must be last in the parameter list", nm.line, nm.col)
            elif self.any_star(out, ''):
                raise ParseError(f"the parameter '{nm.text}' cannot come after '*args' or '**kwargs'\nmove it before them", nm.line, nm.col)
            elif default.tag == 'z' and self.any_default(out):
                raise ParseError(f"the parameter '{nm.text}' needs a default value because an earlier parameter has one\ngive it a default such as '{nm.text}: int = 0', or move it before the others", nm.line, nm.col)
            out.append(mk('Param', nm.line, [vs(nm.text), ty, default, vopt_text(star)]))
            if not self.accept_op(','):
                break
        self.expect_op(')')
        return out

    def any_star(self, params: list[Node], which: str) -> bool:
        # which '' means any star parameter
        for q in params:
            s = q.fields[3]
            if s.tag == 's' and (which == '' or s.text == which):
                return True
        return False

    def any_default(self, params: list[Node]) -> bool:
        for q in params:
            if q.fields[3].tag == 'z' and q.fields[2].tag != 'z':
                return True
        return False

    def is_def(self) -> bool:
        return self.is_kw('def') or (self.is_kw('async') and self.peek(1).kind == 'KW' and self.peek(1).text == 'def')

    def funcdef(self, in_class: bool, marker: str, is_override: bool, body_required: bool) -> Node:
        is_async = self.accept_kw('async')
        line = self.expect_kw('def').line
        is_private = self.accept_kw('private')
        name = self.expect('NAME').text
        tparams = self.type_params()
        params = self.params()
        ret = vz()
        if self.accept_op('->'):
            ret = vn(self.type())
        yt = vz()
        if is_async and self.cur().kind == 'NAME' and self.cur().text == 'yields':
            self.adv()
            yt = vn(self.type())
        if not body_required:
            if self.is_op(':'):
                raise ParseError('an interface method has no body\nwrite only its signature', line)
            self.expect('NEWLINE')
            return self.with_params(mk('FuncDef', line, [vs(name), vnodes(params), ret, vz(), vb(is_private), vb(is_override), vopt_text(marker), vb(False), vb(is_async), yt]), tparams)
        self.expect_op(':')
        before = self.yields
        body = self.block()
        return self.with_params(mk('FuncDef', line, [vs(name), vnodes(params), ret, vnodes(body), vb(is_private), vb(is_override), vopt_text(marker), vb(self.yields > before), vb(is_async), yt]), tparams)

    # `[T]` or `[K, V]` after the name of a function or class: its type parameters (D60a)
    def type_params(self) -> list[Val]:
        out: list[Val] = []
        if not self.is_op('['):
            return out
        self.adv()
        while True:
            nm = self.expect('NAME')
            for seen in out:
                if seen.text == nm.text:
                    raise ParseError(f"the type parameter '{nm.text}' is declared twice", nm.line, nm.col)
            out.append(vs(nm.text))
            if len(out) > 5:
                raise ParseError('a class or function takes at most five type parameters', nm.line, nm.col)
            if not self.accept_op(','):
                break
        self.expect_op(']')
        return out

    # a declaration with type parameters carries them in one extra last field
    def with_params(self, n: Node, tparams: list[Val]) -> Node:
        if len(tparams) > 0:
            n.fields.append(vlist(tparams))
        return n

    def block(self) -> list[Node]:
        if self.cur().kind != 'NEWLINE':
            c = self.cur()
            raise ParseError("the body of a block goes on its own indented line\nstart a new line after the ':' and indent it", c.line, c.col)
        nl = self.adv()
        if self.cur().kind != 'INDENT':
            raise ParseError("this line ends with ':' but no indented block follows\nindent the lines that belong to it, or write 'pass' for an empty block", nl.line, nl.col)
        self.adv()
        out: list[Node] = []
        while self.cur().kind != 'DEDENT':
            out.append(self.statement())
        self.adv()
        return out

    def classdef(self) -> Node:
        line = self.expect_kw('class').line
        name = self.expect('NAME').text
        tparams = self.type_params()
        parent = vz()
        if self.accept_op('('):
            parent = vs(self.expect('NAME').text)
            if self.is_op(','):
                raise ParseError("a class can inherit from only one parent class\nto share more behavior, list interfaces after 'implements'", self.cur().line, self.cur().col)
            self.expect_op(')')
        ifaces: list[Val] = []
        if self.accept_kw('implements'):
            ifaces = self.name_list()
        self.expect_op(':')
        self.expect('NEWLINE')
        self.expect('INDENT')
        fields: list[Node] = []
        methods: list[Node] = []
        while self.cur().kind != 'DEDENT':
            if self.accept_kw('pass'):
                self.expect('NEWLINE')
                continue
            self.member(fields, methods)
        self.adv()
        return self.with_params(mk('ClassDef', line, [vs(name), parent, vlist(ifaces), vnodes(fields), vnodes(methods)]), tparams)

    def member(self, fields: list[Node], methods: list[Node]):
        marker = ''
        if self.is_op('@'):
            self.adv()
            m = self.expect('NAME')
            if m.text != 'init' and not is_operator_marker(m.text):
                raise ParseError(f"'@{m.text}' is not a method marker\nthe markers are @init, @iter and the operator markers such as @add", m.line, m.col - 1)
            marker = m.text
            self.expect('NEWLINE')
        is_override = self.accept_kw('override')
        if self.is_def():
            methods.append(self.funcdef(True, marker, is_override, True))
            return
        if marker != '' or is_override:
            self.err('expected a method after the marker')
        line = self.cur().line
        is_private = False
        is_const = False
        while self.is_kw('private') or self.is_kw('const'):
            if self.adv().text == 'private':
                if is_const:
                    raise ParseError("write 'private const', not 'const private'", line)
                is_private = True
            else:
                is_const = True
        nm = self.expect('NAME')
        self.expect_op(':')
        ty = self.type()
        value = vz()
        if self.accept_op('='):
            value = vn(self.expr())
        self.expect('NEWLINE')
        fields.append(mk('FieldDef', line, [vs(nm.text), vn(ty), vb(is_private), vb(is_const), value]))

    def interfacedef(self) -> Node:
        line = self.expect_kw('interface').line
        name = self.expect('NAME').text
        parents: list[Val] = []
        if self.accept_op('('):
            parents = self.name_list()
            self.expect_op(')')
        self.expect_op(':')
        self.expect('NEWLINE')
        self.expect('INDENT')
        methods: list[Node] = []
        while self.cur().kind != 'DEDENT':
            if self.accept_kw('pass'):
                self.expect('NEWLINE')
                continue
            methods.append(self.funcdef(True, '', False, False))
        self.adv()
        return mk('InterfaceDef', line, [vs(name), vlist(parents), vnodes(methods)])

    # for a, b in pairs: and for k, v in d.items(): take each item of the loop apart with an unpack (a hidden loop variable holds the item).
    # Over d.items() the loop also carries the names as a fourth field: when d turns out to be a dict, the compiler walks its keys and
    # values together (so v keeps its own type) and skips the unpack, the first statement of the body.
    def tuple_for(self, line: int, names: list[str], it: Node, body: list[Node]) -> Node:
        self.unpacks += 1
        stem = f'_pairs{line}_{self.unpacks}x{len(names)}'     # the number of names after the x (see unpack_count in the compiler)
        # the item is taken apart straight from the loop variable (no second hidden variable: the lint pass sees a comprehension's
        # loop without its statements in order)
        q = Parser()
        q.toks = lex(f"if len({stem}) != {len(names)}:\n    raise ValueError('cannot unpack ' + str(len({stem})) + ' values into {plural_vars(len(names))}', 'E63')\n")
        check = q.statement()
        set_line(vn(check), line)
        parts: list[Node] = [check]
        for k, nm in enumerate(names):
            item = mk('Index', line, [vn(mk('Name', line, [vs(stem)])), vn(mk('IntLit', line, [vi(k)]))])
            parts.append(mk('Assign', line, [vn(mk('Name', line, [vs(nm)])), vn(item)]))
        unpack = mk('Multi', line, [vnodes(parts)])
        fields: list[Val] = [vs(stem), vn(it), vnodes([unpack] + body)]
        if it.kind == 'Call' and len(names) == 2 and len(val_nodes(it.fields[1])) == 0 and len(it.fields[2].items) == 0:
            f = val_node(it.fields[0])
            if f.kind == 'Attr' and f.fields[1].text == 'items':
                fields.append(vlist([vs(nm) for nm in names]))
        return mk('For', line, fields)

    def pairs_for(self, line: int, names: list[str], it: Node, body: list[Node]) -> Node:
        # for i, x in enumerate(xs) and for a, b in zip(xs, ys) are written as ordinary index loops
        which = pairing_call(it)
        if which == '':
            return self.tuple_for(line, names, it, body)
        args = val_nodes(it.fields[1])
        paths: list[str] = []
        for a in args:
            p = path_text(a)
            if p == '':
                raise ParseError(f'{which}() in a for loop needs plain variables or fields\nassign the list to a variable first, then loop over that variable', line)
            paths.append(p)
        if len(it.fields[2].items) > 0:
            raise ParseError(f'{which}() takes no keyword arguments', line)
        text = ''
        if which == 'enumerate':
            if len(args) != 1 or len(names) != 2:
                raise ParseError('enumerate() takes one list and gives two variables\nwrite for i, x in enumerate(items):', line)
            text = f'for {names[0]} in range(len({paths[0]})):\n    {names[1]} = {paths[0]}[{names[0]}]\n    pass\n'
        else:
            if len(args) < 2 or len(args) != len(names):
                raise ParseError('zip() needs as many variables as lists\nwrite for a, b in zip(xs, ys):', line)
            idx = f'_zip_index{line}'
            text = f'for {idx} in range(len({paths[0]})):\n'
            for p in paths[1:]:
                text += f'    if {idx} >= len({p}):\n        break\n'
            for k, p in enumerate(paths):
                text += f'    {names[k]} = {p}[{idx}]\n'
            text += '    pass\n'
        q = Parser()
        q.toks = lex(text)
        loop = q.statement()
        stmts = [m for m in val_nodes(loop.fields[2]) if m.kind != 'Pass']
        for m in stmts:
            m.line = line
        return mk('For', line, [loop.fields[0], loop.fields[1], vnodes(stmts + body)])

    # statements
    def statement(self) -> Node:
        t = self.cur()
        if self.is_def() or self.is_kw('class') or self.is_kw('interface'):
            raise ParseError('a function, class or interface cannot be declared inside another block\nmove it to the top level of the file', t.line, t.col)
        if self.is_kw('return'):
            self.adv()
            rv = vz()
            if self.cur().kind != 'NEWLINE':
                first = self.expr()
                if self.is_op(','):
                    # return a, b: a tuple, as (a, b)
                    parts: list[Node] = [first]
                    while self.accept_op(','):
                        parts.append(self.expr())
                    first = mk('TupleLit', t.line, [vnodes(parts)])
                rv = vn(first)
            self.expect('NEWLINE')
            return mk('Return', t.line, [rv])
        if self.is_kw('pass'):
            self.adv()
            self.expect('NEWLINE')
            return mk('Pass', t.line, [])
        if self.is_kw('break') or self.is_kw('continue'):
            kw = self.adv().text
            self.expect('NEWLINE')
            if kw == 'break':
                return mk('Break', t.line, [])
            return mk('Continue', t.line, [])
        if self.is_kw('raise'):
            self.adv()
            v = self.expr()
            self.expect('NEWLINE')
            return mk('Raise', t.line, [vn(v)])
        if self.is_kw('assert'):
            # assert condition[, 'message'] is `if condition: pass else: raise AssertionError(message, 'E519')` (B-Q1): the error has the line
            # of the assert, and the message is worked out only when the check fails. E519 is the line of AssertionError in std/errors.txt.
            self.adv()
            cond = self.expr()
            msg = mk('StrLit', t.line, [vs('assertion failed')])
            if self.accept_op(','):
                msg = self.expr()
            self.expect('NEWLINE')
            err = mk('Call', t.line, [vn(mk('Name', t.line, [vs('AssertionError')])), vnodes([msg, mk('StrLit', t.line, [vs('E519')])]), vlist([])])
            return mk('If', t.line, [vlist([vtuple([vn(cond), vnodes([mk('Pass', t.line, [])])])]), vnodes([mk('Raise', t.line, [vn(err)])])])
        if self.is_kw('yield'):
            self.adv()
            yv = self.expr()
            self.expect('NEWLINE')
            self.yields += 1
            return mk('Yield', t.line, [vn(yv)])
        if self.is_kw('try'):
            return self.trystmt()
        if self.is_kw('if'):
            return self.ifstmt()
        if self.is_kw('async'):
            self.adv()
            if not self.is_kw('for'):
                self.err('expected def or for after async')
            self.adv()
            an = self.expect('NAME').text
            self.expect_kw('in')
            ait = self.expr()
            self.expect_op(':')
            return mk('AsyncFor', t.line, [vs(an), vn(ait), vnodes(self.block())])
        if self.is_kw('for'):
            self.adv()
            names = self.name_texts()
            self.expect_kw('in')
            it = self.expr()
            self.expect_op(':')
            body = self.block()
            if len(names) > 1 or pairing_call(it) != '':
                return self.pairs_for(t.line, names, it, body)
            return mk('For', t.line, [vs(names[0]), vn(it), vnodes(body)])
        if self.is_kw('while'):
            self.adv()
            cond = self.expr()
            self.expect_op(':')
            return mk('While', t.line, [vn(cond), vnodes(self.block())])
        e = self.expr()
        if self.is_op(','):
            return self.unpack_stmt(t, e)
        if self.is_op(':') and e.kind == 'Name':
            self.adv()
            ty = self.type()
            self.expect_op('=')
            v = self.expr()
            self.expect('NEWLINE')
            return mk('Declare', t.line, [e.fields[0], vn(ty), vn(v)])
        if self.is_op('='):
            self.adv()
            check_target(e, t)
            v = self.expr()
            self.expect('NEWLINE')
            return mk('Assign', t.line, [vn(e), vn(v)])
        if self.cur().kind == 'OP' and self.cur().text in ['+=', '-=', '*=', '/=', '%=', '//=', '**=', '&=', '|=', '^=', '<<=', '>>=']:
            # x += v is x = x + v (compound assignment, like Python)
            op = self.adv().text[:-1]
            check_target(e, t)
            v = self.expr()
            self.expect('NEWLINE')
            return mk('Assign', t.line, [vn(e), vn(mk('BinOp', t.line, [vs(op), vn(e), vn(v)]))])
        self.expect('NEWLINE')
        return mk('ExprStmt', t.line, [vn(e)])

    # a, b = b, a and a, b = pair: several targets on the left of =. The right side is evaluated first into hidden
    # variables, then each target is assigned from them. Written as a Multi node holding the ordinary statements.
    def unpack_stmt(self, t: Token, first: Node) -> Node:
        targets: list[Node] = [first]
        while self.accept_op(','):
            if self.is_op('='):
                break
            targets.append(self.expr())
        if not self.is_op('='):
            self.expect_op('=')
        self.adv()
        for target in targets:
            check_target(target, t)
        values: list[Node] = [self.expr()]
        while self.accept_op(','):
            values.append(self.expr())
        self.expect('NEWLINE')
        count = len(targets)
        # a tuple written out, (a, b), has a known length and is taken apart without being built
        literal = len(values) == 1 and values[0].kind == 'TupleLit'
        if literal:
            values = val_nodes(values[0].fields[0])
        self.unpacks += 1
        stem = f'_unpack{t.line}_{self.unpacks}x{count}'
        stmts: list[Node] = []
        if len(values) > 1 or literal:
            if len(values) != count:
                raise ParseError(f'cannot unpack {plural_values(len(values))} into {plural_vars(count)}\nwrite as many values as there are variables on the left of =', t.line, t.col)
            for k, v in enumerate(values):
                if is_none_name(v):
                    continue                # None has no effect to order, and a hidden variable could not be given a type from it
                stmts.append(mk('Assign', t.line, [vn(mk('Name', t.line, [vs(stem + '_' + str(k))])), vn(v)]))
            for k, target in enumerate(targets):
                source = values[k]
                if not is_none_name(source):
                    source = mk('Name', t.line, [vs(stem + '_' + str(k))])
                stmts.append(mk('Assign', t.line, [vn(target), vn(source)]))
            return mk('Multi', t.line, [vnodes(stmts)])
        # one value to take apart: a tuple (or list or text) whose length is only known when the program runs
        stmts.append(mk('Assign', t.line, [vn(mk('Name', t.line, [vs(stem)])), vn(values[0])]))
        text = f"if len({stem}) != {count}:\n    raise ValueError('cannot unpack ' + str(len({stem})) + ' values into {plural_vars(count)}', 'E63')\n"
        q = Parser()
        q.toks = lex(text)
        check = q.statement()
        set_line(vn(check), t.line)         # the generated lines are numbered from 1; an error must point at the statement
        stmts.append(check)
        for k, target in enumerate(targets):
            item = mk('Index', t.line, [vn(mk('Name', t.line, [vs(stem)])), vn(mk('IntLit', t.line, [vi(k)]))])
            stmts.append(mk('Assign', t.line, [vn(target), vn(item)]))
        return mk('Multi', t.line, [vnodes(stmts)])

    def trystmt(self) -> Node:
        line = self.adv().line
        self.expect_op(':')
        body = self.block()
        handlers: list[Val] = []
        orelse = vz()
        final = vz()
        while self.is_kw('catch'):
            self.adv()
            cls = self.expect('NAME').text
            var = vz()
            if self.accept_kw('as'):
                var = vs(self.expect('NAME').text)
            self.expect_op(':')
            handlers.append(vtuple([vs(cls), var, vnodes(self.block())]))
        if self.is_kw('else'):
            if len(handlers) == 0:
                raise ParseError("'else' after 'try' needs a 'catch' block before it", self.cur().line, self.cur().col)
            self.adv()
            self.expect_op(':')
            orelse = vnodes(self.block())
        if self.is_kw('finally'):
            self.adv()
            self.expect_op(':')
            final = vnodes(self.block())
        if len(handlers) == 0 and final.tag == 'z':
            raise ParseError("'try' needs a 'catch' or a 'finally' block after it", line)
        return mk('Try', line, [vnodes(body), vlist(handlers), orelse, final])

    def ifstmt(self) -> Node:
        line = self.adv().line
        branches: list[Val] = []
        cond = self.expr()
        self.expect_op(':')
        branches.append(vtuple([vn(cond), vnodes(self.block())]))
        orelse = vz()
        while True:
            if self.accept_kw('elif'):
                cond = self.expr()
                self.expect_op(':')
                branches.append(vtuple([vn(cond), vnodes(self.block())]))
            elif self.accept_kw('else'):
                self.expect_op(':')
                orelse = vnodes(self.block())
                break
            else:
                break
        return mk('If', line, [vlist(branches), orelse])

    # expressions
    def expr(self) -> Node:
        # a if condition else b: the loosest operator, grouping to the right
        lam = self.lambda_expr()
        if lam is not None:
            return lam
        e = self.or_()
        if self.is_kw('if'):
            ln = self.adv().line
            cond = self.or_()
            self.expect_kw('else')
            return mk('Cond', ln, [vn(cond), vn(e), vn(self.expr())])
        return e

    # a lambda: x -> expression, or (a, b) -> expression; its body is one expression
    def lambda_expr(self) -> Node | None:
        line = self.cur().line
        names: list[Val] = []
        if self.cur().kind == 'NAME' and self.peek_is(1, 'OP', '->'):
            names.append(vs(self.adv().text))
        elif self.is_op('('):
            k = 1
            ok = True
            while not self.peek_is(k, 'OP', ')'):
                if self.peek(k).kind != 'NAME':
                    ok = False
                    break
                k += 1
                if self.peek_is(k, 'OP', ','):
                    k += 1
                elif not self.peek_is(k, 'OP', ')'):
                    ok = False
                    break
            if not ok or not self.peek_is(k + 1, 'OP', '->'):
                return None
            self.adv()
            while not self.is_op(')'):
                names.append(vs(self.expect('NAME').text))
                self.accept_op(',')
            self.adv()
        else:
            return None
        self.expect_op('->')
        body = self.expr()
        return mk('Lambda', line, [vlist(names), vn(body)])

    def binop(self, op: str, line: int, left: Node, right: Node) -> Node:
        return mk('BinOp', line, [vs(op), vn(left), vn(right)])

    def or_(self) -> Node:
        e = self.xor_()
        while self.is_kw('or'):
            ln = self.adv().line
            e = self.binop('or', ln, e, self.xor_())
        return e

    def xor_(self) -> Node:
        e = self.and_()
        while self.is_kw('xor'):
            ln = self.adv().line
            e = self.binop('xor', ln, e, self.and_())
        return e

    def and_(self) -> Node:
        e = self.not_()
        while self.is_kw('and'):
            ln = self.adv().line
            e = self.binop('and', ln, e, self.not_())
        return e

    def not_(self) -> Node:
        if self.is_kw('not'):
            ln = self.adv().line
            return mk('UnOp', ln, [vs('not'), vn(self.not_())])
        return self.cmp()

    def is_cmp_op(self) -> bool:
        t = self.cur()
        return t.kind == 'OP' and t.text in ['==', '!=', '<', '<=', '>', '>=']

    def cmp(self) -> Node:
        e = self.bit_or()
        if self.is_kw('is'):
            t = self.adv()
            op = 'is not' if self.accept_kw('not') else 'is'
            return self.binop(op, t.line, e, self.bit_or())
        if self.is_kw('in'):
            t = self.adv()
            return self.binop('in', t.line, e, self.bit_or())
        if self.is_kw('not') and self.peek_is(1, 'KW', 'in'):
            # x not in y is not (x in y)
            t = self.adv()
            self.adv()
            inner = self.binop('in', t.line, e, self.bit_or())
            return mk('UnOp', t.line, [vs('not'), vn(inner)])
        if self.is_cmp_op():
            t = self.adv()
            e = self.binop(t.text, t.line, e, self.bit_or())
            if self.is_cmp_op():
                raise ParseError('comparisons cannot be chained like a < b < c\nwrite a < b and b < c instead', self.cur().line, self.cur().col)
        return e

    def bit_or(self) -> Node:
        e = self.bit_xor()
        while self.is_op('|'):
            t = self.adv()
            e = self.binop('|', t.line, e, self.bit_xor())
        return e

    def bit_xor(self) -> Node:
        e = self.bit_and()
        while self.is_op('^'):
            t = self.adv()
            e = self.binop('^', t.line, e, self.bit_and())
        return e

    def bit_and(self) -> Node:
        e = self.shift()
        while self.is_op('&'):
            t = self.adv()
            e = self.binop('&', t.line, e, self.shift())
        return e

    def shift(self) -> Node:
        e = self.add()
        while self.is_op('<<') or self.is_op('>>'):
            t = self.adv()
            e = self.binop(t.text, t.line, e, self.add())
        return e

    def add(self) -> Node:
        e = self.mul()
        while self.is_op('+') or self.is_op('-'):
            t = self.adv()
            e = self.binop(t.text, t.line, e, self.mul())
        return e

    def mul(self) -> Node:
        e = self.unary()
        while self.is_op('*') or self.is_op('/') or self.is_op('//') or self.is_op('%'):
            t = self.adv()
            e = self.binop(t.text, t.line, e, self.unary())
        return e

    def unary(self) -> Node:
        if self.is_kw('await'):
            ln = self.adv().line
            return mk('Await', ln, [vn(self.unary())])
        if self.is_op('-'):
            ln = self.adv().line
            return mk('UnOp', ln, [vs('-'), vn(self.unary())])
        if self.is_op('~'):
            ln = self.adv().line
            return mk('UnOp', ln, [vs('~'), vn(self.unary())])
        return self.power()

    def power(self) -> Node:
        # ** binds tighter than a minus sign on its left (-2 ** 2 is -4) and groups to the right
        e = self.postfix()
        if self.is_op('**'):
            t = self.adv()
            return self.binop('**', t.line, e, self.unary())
        return e

    def postfix(self) -> Node:
        e = self.atom()
        while True:
            if self.is_op('('):
                ln = self.adv().line
                args: list[Node] = []
                kwargs: list[Val] = []
                names: list[str] = []
                while not self.is_op(')'):
                    if self.cur().kind == 'NAME' and self.peek_is(1, 'OP', '='):
                        kw = self.adv()
                        self.adv()
                        if kw.text in names:
                            raise ParseError(f"the keyword argument '{kw.text}' is given twice\npass each argument only once", kw.line, kw.col)
                        names.append(kw.text)
                        kwargs.append(vtuple([vs(kw.text), vn(self.expr())]))
                    else:
                        if len(kwargs) > 0:
                            raise ParseError('a positional argument cannot follow a keyword argument\nput all positional arguments first', self.cur().line, self.cur().col)
                        args.append(self.expr())
                    if not self.accept_op(','):
                        break
                self.expect_op(')')
                e = mk('Call', ln, [vn(e), vnodes(args), vlist(kwargs)])
            elif self.is_op('['):
                ln = self.adv().line
                lo = vz()
                if not self.is_op(':'):
                    lo = vn(self.expr())
                if lo.tag == 'n' and self.is_op(','):
                    # several types in one index, as in tuple[str, int] or dict[str, int]: the index is a tuple of them
                    parts: list[Node] = [val_node(lo)]
                    while self.accept_op(','):
                        parts.append(self.expr())
                    self.expect_op(']')
                    e = mk('Index', ln, [vn(e), vn(mk('TupleLit', ln, [vnodes(parts)]))])
                elif self.accept_op(':'):
                    hi = vz()
                    step = vz()
                    if not self.is_op(']') and not self.is_op(':'):
                        hi = vn(self.expr())
                    if self.accept_op(':'):
                        if not self.is_op(']'):
                            step = vn(self.expr())
                    self.expect_op(']')
                    e = mk('Slice', ln, [vn(e), lo, hi, step])
                else:
                    self.expect_op(']')
                    e = mk('Index', ln, [vn(e), lo])
            elif self.is_op('.'):
                self.adv()
                e = mk('Attr', e.line, [vn(e), vs(self.expect('NAME').text)])
            else:
                return e

    # [item for x in items if condition] after its first item: the loop is an ordinary For whose body adds the item
    # to the list being built (a CompAppend statement), inside an If for the condition
    def comprehension(self, line: int, item: Node) -> Node:
        self.expect_kw('for')
        names = self.name_texts()
        self.expect_kw('in')
        it = self.or_()
        body: list[Node] = [mk('CompAppend', line, [vn(item)])]
        if self.is_kw('if'):
            ln = self.adv().line
            cond = self.or_()
            body = [mk('If', ln, [vlist([vtuple([vn(cond), vnodes(body)])]), vz()])]
        self.expect_op(']')
        if len(names) > 1 or pairing_call(it) != '':
            return mk('ListComp', line, [vn(self.pairs_for(line, names, it, body))])
        return mk('ListComp', line, [vn(mk('For', line, [vs(names[0]), vn(it), vnodes(body)]))])

    def atom(self) -> Node:
        t = self.cur()
        if t.kind == 'INT':
            self.adv()
            return mk('IntLit', t.line, [vi(t.num)])
        if t.kind == 'FLOAT':
            self.adv()
            return mk('FloatLit', t.line, [vi(t.num), vi(t.scale)])
        if t.kind == 'STR':
            self.adv()
            return mk('StrLit', t.line, [vs(t.text)])
        if t.kind == 'KW' and (t.text == 'True' or t.text == 'False'):
            self.adv()
            return mk('BoolLit', t.line, [vb(t.text == 'True')])
        if t.kind == 'NAME' and t.text == 'start' and (self.peek(1).kind == 'NAME' or (self.peek(1).kind == 'KW' and self.peek(1).text == 'await')):
            self.adv()
            return mk('Start', t.line, [vn(self.unary())])
        if t.kind == 'NAME':
            if t.text == 'float' and self.peek_is(1, 'OP', '['):
                raise ParseError(FLOAT_HAS_NO_LENGTH, t.line, t.col)
            if is_type_with_length(t.text) and self.peek_is(1, 'OP', '['):
                ty = self.type()
                self.expect_op('(')
                args: list[Node] = [self.expr()]
                self.expect_op(')')
                return mk('TypeCall', t.line, [vn(ty), vnodes(args)])
            self.adv()
            return mk('Name', t.line, [vs(t.text)])
        if self.is_op('('):
            self.adv()
            if self.accept_op(')'):
                return mk('TupleLit', t.line, [vnodes([])])
            e = self.expr()
            if self.is_op(','):
                # a tuple: (a, b), or (a,) for one item
                parts: list[Node] = [e]
                while self.accept_op(','):
                    if self.is_op(')'):
                        break
                    parts.append(self.expr())
                self.expect_op(')')
                return mk('TupleLit', t.line, [vnodes(parts)])
            self.expect_op(')')
            return e
        if self.is_op('!'):
            self.adv()
            nm = self.expect('NAME')
            return mk('LlvmRef', t.line, [vs(nm.text)])
        if self.is_op('{'):
            self.adv()
            if self.accept_op('}'):
                return mk('MapLit', t.line, [vlist([])])
            first = self.expr()
            if self.accept_op(':'):
                pairs: list[Val] = [vtuple([vn(first), vn(self.expr())])]
                while self.accept_op(','):
                    if self.is_op('}'):
                        break
                    k = self.expr()
                    self.expect_op(':')
                    pairs.append(vtuple([vn(k), vn(self.expr())]))
                self.expect_op('}')
                return mk('MapLit', t.line, [vlist(pairs)])
            items: list[Node] = [first]
            while self.accept_op(','):
                if self.is_op('}'):
                    break
                items.append(self.expr())
            self.expect_op('}')
            return mk('SetLit', t.line, [vnodes(items)])
        if self.is_op('['):
            self.adv()
            elems: list[Node] = []
            while not self.is_op(']'):
                elems.append(self.expr())
                if len(elems) == 1 and self.is_kw('for'):
                    return self.comprehension(t.line, elems[0])
                if not self.accept_op(','):
                    break
            self.expect_op(']')
            return mk('ListLit', t.line, [vnodes(elems)])
        self.err('expected a value or expression')

export def parse(src: str) -> Node:
    p = Parser()
    p.toks = lex(src)
    return p.module()
