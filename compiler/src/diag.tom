# How the Tomato compiler reports a problem with the user's program, in one format everywhere (the command line, the
# repl and the website playground):
#
#   error: name 'tets' is not defined
#     --> prog.tom:3:9
#      |
#    3 |     x = tets + 1
#      |         ^^^^
#      = help: did you mean 'test'?
#
# A message is its first line, then optional help lines after a newline. The column is 1-based and may be 0 when it is not
# known; the quoted name in the message is then looked up in the source line.

export class Diagnostic(Error):
    @init
    def make(self, message: str):
        Error.start(self, message)

def is_word_char(c: str) -> bool:
    return c in 'abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_'

# the text between the first pair of single quotes, or ''
export def first_quoted(message: str) -> str:
    a = message.find("'")
    if a < 0:
        return ''
    b = message.find("'", a + 1)
    if b < 0:
        return ''
    return message[a + 1:b]

# the first run of digits in the message, or ''
def first_number(message: str) -> str:
    i = 0
    while i < len(message) and message[i] not in '0123456789':
        i += 1
    j = i
    while j < len(message) and message[j] in '0123456789':
        j += 1
    return message[i:j]

# the first place `word` appears in `text` as a whole word, or -1
def find_word(text: str, word: str) -> int:
    if len(word) == 0:
        return -1
    start = 0
    while start + len(word) <= len(text):
        i = text.find(word, start)
        if i < 0:
            return -1
        before_ok = i == 0 or not is_word_char(text[i - 1]) or not is_word_char(word[0])
        after = i + len(word)
        after_ok = after >= len(text) or not is_word_char(text[after]) or not is_word_char(word[-1])
        if before_ok and after_ok:
            return i
        start = i + 1
    return -1

# how many characters of the token that starts at index `at`
def token_width(text: str, at: int) -> int:
    if at >= len(text):
        return 1
    c = text[at]
    if is_word_char(c):
        n = 0
        while at + n < len(text) and is_word_char(text[at + n]):
            n += 1
        return n
    if c == "'" or c == '"':
        end = text.find(c, at + 1)
        if end >= 0:
            return end - at + 1
    return 1

# the edit distance between two names, for did-you-mean
export def distance(a: str, b: str) -> int:
    prev = list(range(len(b) + 1))
    for i in range(len(a)):
        cur = [i + 1]
        for j in range(len(b)):
            cost = 0 if a[i] == b[j] else 1
            cur.append(min(prev[j] + cost, prev[j + 1] + 1, cur[j] + 1))
        prev = cur
    return prev[-1]

# the candidate nearest to `name` when it is close enough to be a likely typo, else ''
export def closest(name: str, candidates: list[str]) -> str:
    limit = 2 if len(name) >= 4 else 1
    if len(name) >= 8:
        limit = 3
    best = ''
    best_d = limit + 1
    for c in candidates:
        if c != name and not c.startswith('_'):
            d = distance(name, c)
            if d < best_d:
                best_d = d
                best = c
    return best

# the text of a source line without a trailing comment (a # outside a text), and without the spaces before it
def code_part(text: str) -> str:
    quote = ''
    i = 0
    while i < len(text):
        c = text[i]
        if quote != '':
            if c == '\\':
                i += 1
            elif c == quote:
                quote = ''
        elif c == "'" or c == '"':
            quote = c
        elif c == '#':
            return text[:i].rstrip(' ')
        i += 1
    return text

# Where in the source line the caret goes when the column is not known (0) or past the end (-1): at the word the message
# quotes, else at the first number it names, else under the whole line (without a comment at its end). Gives the 1-based
# column and the caret width. `lo` and `hi` (0-based, hi exclusive; hi 0 for the whole line) limit the search to the part
# of the line that the error is about: with nothing found there, the caret goes under that whole part.
def guess_span(head: str, text: str, at: int, lo: int = 0, hi: int = 0) -> tuple[int]:
    if at == -1:
        return (len(text) + 1, 1)
    q = first_quoted(head)
    if q == '':
        q = first_number(head)
    part = text
    if hi > 0:
        part = text[:hi]
    found = find_word(part[lo:], q)
    if found >= 0:
        return (lo + found + 1, len(q))
    if hi > 0:
        return (lo + 1, max(hi - lo, 1))
    code = code_part(text)
    indent = len(code) - len(code.lstrip(' '))
    return (indent + 1, max(len(code.strip()), 1))

# `col` is where the caret starts (0: not known, so look for the word the message quotes). `end` is the column just after the part
# the error is about: with `region` the caret goes at the quoted word inside col..end (else under all of it), without it the
# caret is exactly col..end; with no `end` it is as wide as the word at col.
export def format_error(message: str, line: int, col: int, src: str, path: str, label: str = 'error', end: int = 0, region: bool = False) -> str:
    parts = message.split('\n')
    head = parts[0]
    helps = parts[1:]
    out = f'{label}: {head}'
    if line < 1:
        for h in helps:
            out += f'\n  = help: {h}'
        return out
    lines = src.split('\n')
    ln = min(line, len(lines))
    at = col
    # a position past the last text (the end of the file): show the last line that has text, at its end
    while ln > 1 and len(lines[ln - 1].strip()) == 0:
        ln -= 1
        at = -1
    text = lines[ln - 1].rstrip('\r')
    width = 1
    if at > 0 and end > at and region:
        at, width = guess_span(head, text, 0, at - 1, min(end - 1, len(text)))
    elif at > 0 and end > at:
        width = end - at
    elif at <= 0:
        at, width = guess_span(head, text, at)
    else:
        width = token_width(text, at - 1)
    at = min(at, len(text) + 1)
    num = str(ln)
    pad = ' ' * len(num)
    where = path if path != '' else 'line'
    out += f'\n{pad}--> {where}:{num}:{at}'
    out += f'\n{pad} |'
    out += f'\n{num} | {text}'
    out += '\n' + pad + ' | ' + ' ' * (at - 1) + '^' * width
    for h in helps:
        out += f'\n{pad} = help: {h}'
    return out
