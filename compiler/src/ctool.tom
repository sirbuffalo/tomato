# The Tomato compiler (slice) as a command: tomato run compiler/src/ctool.tom compile FILE   (prints LLVM IR)
from driver import compile_ir, config_report, seed_command
from os import getenv
from sys import version

@main
def main():
    print('usage: tomato run compiler/src/ctool.tom compile FILE')

# the version the manifest's `tomato` key is checked against: the `tomato` command gives the text of its VERSION file in
# TOMATO_VERSION (a compiler built from the bootstrap file would otherwise report the version it was built at), else the one in std/sys.tom
def compiler_version() -> str:
    got = getenv('TOMATO_VERSION')
    if got is None or got == '':
        return version()
    return got

@compile
def compile(path: str, entry: str = 'main', std: str = 'std/', mode: str = 'debug', project: str = '', user: str = '', flags: str = ''):
    # The old compiler command (bin/tomatoc): the work is in driver.tom, which the `tomato` program also calls in its own process. project
    # and user are the paths of the tomato.toml and the config.toml to read ('' for none); the entry --config prints what they set
    # (`tomato config`) instead of compiling, and --seed runs a `tomato seed` command (driver.seed_command: the subcommand is `path`, its word
    # `mode`, `rev` is `user` and the flags are `flags`). Otherwise it prints the IR of the program and the comment lines after it
    # (driver.compile_ir).
    if entry == '--config':
        for line in config_report(project, user):
            print(line)
        return
    if entry == '--seed':
        for line in seed_command(path, mode, project, user, flags.split(' '), compiler_version()):
            print(line)
        return
    print(compile_ir(path, entry, std, mode, project, user, flags, compiler_version()))
