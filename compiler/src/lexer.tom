# The Tomato lexer (D38a): turns source text into tokens, with INDENT and DEDENT for the indentation.
#
# Used by compiler/src/parser.tom; the command-line tool is compiler/src/lextool.tom.

export class LexError(Error):
    line: int = 0
    col: int = 0

    @init
    def make(self, message: str, line: int, col: int = 0):
        Error.start(self, message)
        self.line = line
        self.col = col

export class Token:
    kind: str = ''       # INT, NAME, KW, STR, OP, NEWLINE, INDENT, DEDENT or EOF
    text: str = ''       # the source text, or the decoded text of a STR
    num: int = 0         # the value of an INT
    scale: int = 0       # for a FLOAT: the digits after the point, less the exponent
    line: int = 0
    col: int = 0

export def make_token(kind: str, text: str, num: int, line: int, col: int = 0) -> Token:
    t = Token()
    t.kind = kind
    t.text = text
    t.num = num
    t.line = line
    t.col = col
    return t

def is_digit(c: str) -> bool:
    return c in '0123456789'

def is_alpha(c: str) -> bool:
    return c in 'abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ'

def is_name_char(c: str) -> bool:
    return is_alpha(c) or is_digit(c) or c == '_'

def digit_value(c: str) -> int:
    return '0123456789'.find(c)

def is_keyword(w: str) -> bool:
    words = ['def', 'class', 'interface', 'implements', 'private', 'const', 'override', 'return', 'if', 'elif',
             'else', 'while', 'for', 'in', 'pass', 'break', 'continue', 'try', 'catch', 'finally', 'raise', 'yield',
             'import', 'from', 'export', 'async', 'await', 'as', 'is', 'and', 'or', 'xor', 'not', 'True', 'False']
    return w in words

def escape_char(e: str, line: int, col: int) -> str:
    if e == 'n':
        return '\n'
    if e == 't':
        return '\t'
    if e == 'r':
        return '\r'
    if e == '0':
        return '\0'
    if e == '\\' or e == "'" or e == '"':
        return e
    raise LexError("this text has an unknown escape '\\" + e + "'\nuse one of \\n \\t \\r \\0 \\\\ \\' \\\" (to write a backslash, double it)", line, col)

def lex_number(raw: str, i: int, ln: int, toks: list[Token]) -> int:
    # a whole number or a decimal literal, with an optional exponent (1.5e3, 2E-2); returns the index after it
    n = len(raw)
    j = i
    value = 0
    frac = 0
    exp = 0
    is_float = False
    while j < n and is_digit(raw[j]):
        value = value * 10 + digit_value(raw[j])
        j += 1
    if j + 1 < n and raw[j] == '.' and is_digit(raw[j + 1]):
        is_float = True
        j += 1
        while j < n and is_digit(raw[j]):
            if j - i > 17:
                raise LexError('this number has too many digits for a float\nwrite fewer significant digits (about 17 fit)', ln, i + 1)
            value = value * 10 + digit_value(raw[j])
            frac += 1
            j += 1
    if j < n and (raw[j] == 'e' or raw[j] == 'E'):
        k = j + 1
        negative = False
        if k < n and (raw[k] == '+' or raw[k] == '-'):
            negative = raw[k] == '-'
            k += 1
        if k < n and is_digit(raw[k]):
            is_float = True
            while k < n and is_digit(raw[k]):
                if k - j > 4:
                    raise LexError('this number has too large an exponent for a float\nuse an exponent between about -330 and 330', ln, i + 1)
                exp = exp * 10 + digit_value(raw[k])
                k += 1
            if negative:
                exp = -exp
            j = k
    if is_float:
        if j < n and (is_alpha(raw[j]) or raw[j] == '_'):
            word_end = j
            while word_end < n and is_name_char(raw[word_end]):
                word_end += 1
            raise LexError('a number cannot be followed by letters: ' + raw[i:word_end] + '\nput a space or an operator between the number and the name', ln, i + 1)
        if value > 9007199254740992 or frac - exp > 330 or frac - exp < -330:
            raise LexError('this number is too large or too precise for a float\nwrite it with fewer digits or a smaller exponent', ln, i + 1)
        tok = make_token('FLOAT', raw[i:j], value, ln)
        tok.scale = frac - exp
        toks.append(tok)
    else:
        if j < n and (is_alpha(raw[j]) or raw[j] in '._'):
            word_end = j + 1
            while word_end < n and is_name_char(raw[word_end]):
                word_end += 1
            raise LexError('a number cannot be followed by letters, an underscore or a dot: ' + raw[i:word_end] + '\nput a space or an operator between the number and the name', ln, i + 1)
        toks.append(make_token('INT', raw[i:j], value, ln))
    return j

def push_op(toks: list[Token], op: str, ln: int, col: int):
    t = make_token('OP', op, 0, ln, col)
    toks.append(t)

def push_text(toks: list[Token], text: str, ln: int, col: int):
    toks.append(make_token('STR', text, 0, ln, col))

# the index of the '}' that closes the replacement field whose expression starts at `start`
def field_end(raw: str, start: int, ln: int) -> int:
    n = len(raw)
    j = start
    nesting = 0
    while j < n:
        c = raw[j]
        if c == '"' or c == "'":
            j += 1
            while j < n and raw[j] != c:
                j += 1
        elif c in '([{':
            nesting += 1
        elif c in ')]':
            nesting -= 1
        elif c == '}':
            if nesting == 0:
                return j
            nesting -= 1
        elif c == ':' and nesting == 0:
            raise LexError("a replacement field in an f-string has no format options\nwrite just the expression, such as f'{x}'", ln, j + 1)
        j += 1
    raise LexError("this f-string has a '{' that is never closed\nadd '}' after the expression, or write '{{' for a literal brace", ln, start)

# An f-string f'text {expr} more' becomes the tokens of ('text ' + str(expr) + ' more'); returns the index after it.
def lex_fstring(raw: str, i: int, ln: int, toks: list[Token]) -> int:
    n = len(raw)
    quote = raw[i + 1]
    col = i + 1
    push_op(toks, '(', ln, col)
    buf = ''
    first = True
    j = i + 2
    while j < n and raw[j] != quote:
        c = raw[j]
        if c == '\\':
            j += 1
            if j >= n:
                break
            buf += escape_char(raw[j], ln, j)
        elif c == '{' and j + 1 < n and raw[j + 1] == '{':
            buf += '{'
            j += 1
        elif c == '}' and j + 1 < n and raw[j + 1] == '}':
            buf += '}'
            j += 1
        elif c == '}':
            raise LexError("this f-string has a single '}'\nwrite '}}' for a literal brace", ln, j + 1)
        elif c == '{':
            end = field_end(raw, j + 1, ln)
            source = raw[j + 1:end]
            if source.strip() == '':
                raise LexError("this f-string has an empty '{}'\nput an expression between the braces, or write '{{}}' for literal braces", ln, j + 1)
            if buf != '' or first:
                if not first:
                    push_op(toks, '+', ln, col)
                push_text(toks, buf, ln, col)
                buf = ''
            push_op(toks, '+', ln, col)
            toks.append(make_token('NAME', 'str', 0, ln, col))
            push_op(toks, '(', ln, col)
            inner: list[Token] = []
            lex_line(source, ln, inner, 0)
            for t in inner:
                t.col = j + 2
                toks.append(t)
            push_op(toks, ')', ln, col)
            first = False
            j = end
        else:
            buf += c
        j += 1
    if j >= n:
        raise LexError(f'this text is missing its closing quote {quote}\nadd {quote} at the end of the text', ln, i + 2)
    if buf != '' or first:
        if not first:
            push_op(toks, '+', ln, col)
        push_text(toks, buf, ln, col)
    push_op(toks, ')', ln, col)
    return j + 1

def lex_line(raw: str, ln: int, toks: list[Token], depth: int) -> int:
    # Lexes one line's tokens after its indentation; returns the bracket depth at the end of the line.
    i = 0
    n = len(raw)
    while i < n:
        c = raw[i]
        start = i
        made = len(toks)
        if c == ' ':
            i += 1
        elif c == '#':
            break
        elif is_digit(c):
            i = lex_number(raw, i, ln, toks)
        elif c == 'f' and i + 1 < n and (raw[i + 1] == '"' or raw[i + 1] == "'"):
            i = lex_fstring(raw, i, ln, toks)
        elif is_alpha(c) or c == '_':
            j = i
            while j < n and is_name_char(raw[j]):
                j += 1
            w = raw[i:j]
            if is_keyword(w):
                toks.append(make_token('KW', w, 0, ln))
            else:
                toks.append(make_token('NAME', w, 0, ln))
            i = j
        elif c == '"' or c == "'":
            j = i + 1
            buf = ''
            while j < n and raw[j] != c:
                if raw[j] == '\\':
                    j += 1
                    if j >= n:
                        break
                    buf += escape_char(raw[j], ln, j)
                else:
                    buf += raw[j]
                j += 1
            if j >= n:
                raise LexError(f'this text is missing its closing quote {c}\nadd {c} at the end of the text', ln, i + 1)
            toks.append(make_token('STR', buf, 0, ln))
            i = j + 1
        elif i + 2 < n and raw[i:i + 3] in ['//=', '**=', '<<=', '>>=']:
            toks.append(make_token('OP', raw[i:i + 3], 0, ln))
            i += 3
        elif i + 1 < n and raw[i:i + 2] in ['==', '!=', '<=', '>=', '->', '+=', '-=', '*=', '/=', '%=', '&=', '|=', '^=', '<<', '>>', '//', '**']:
            toks.append(make_token('OP', raw[i:i + 2], 0, ln))
            i += 2
        elif c in '+-*/%<>=()[]{}:,.@!|&^~':
            if c in '([{':
                depth += 1
            elif c in ')]}':
                depth -= 1
            toks.append(make_token('OP', c, 0, ln))
            i += 1
        else:
            raise LexError(f"unexpected character '{c}'\nTomato has no such symbol; remove it or put it inside a text", ln, i + 1)
        if len(toks) > made:
            toks[made].col = start + 1
    return depth

# the column of the first bracket opened among toks[first:] and not closed again on the same line
def open_bracket_col(toks: list[Token], first: int) -> int:
    col = 0
    nesting = 0
    for t in toks[first:]:
        if t.kind == 'OP' and t.text in ['(', '[', '{']:
            if nesting == 0:
                col = t.col
            nesting += 1
        elif t.kind == 'OP' and t.text in [')', ']', '}']:
            nesting -= 1
    return col

export def lex(src: str) -> list[Token]:
    toks: list[Token] = []
    indents = [0]       # the open blocks' indentation widths, innermost last
    depth = 0           # how many brackets are open; lines inside brackets have no indentation of their own
    open_line = 1
    open_col = 0
    lines = src.split('\n')
    for index, raw in enumerate(lines):
        ln = index + 1
        n = len(raw)
        if depth == 0:
            width = 0
            while width < n and raw[width] == ' ':
                width += 1
            if width < n and raw[width] == '\t':
                raise LexError('a tab cannot be used for indentation\nindent with spaces instead', ln, width + 1)
            if width >= n or raw[width] == '#':
                continue
            if width > indents[-1]:
                indents.append(width)
                toks.append(make_token('INDENT', '', 0, ln, width + 1))
            while width < indents[-1]:
                indents = indents[:-1]
                toks.append(make_token('DEDENT', '', 0, ln, width + 1))
                if width > indents[-1]:
                    raise LexError('this line is indented differently from the block it belongs to\nindent it by the same number of spaces as the lines above it, or as an outer line', ln, width + 1)
        before = depth
        first_tok = len(toks)
        depth = lex_line(raw, ln, toks, depth)
        if before == 0 and depth > 0:
            open_line = ln
            open_col = open_bracket_col(toks, first_tok)
        if depth == 0:
            toks.append(make_token('NEWLINE', '', 0, ln, n + 1))
    if depth != 0:
        raise LexError("a bracket is opened here but never closed\nadd the matching ')', ']' or '}'", open_line, open_col)
    for i in range(len(indents) - 1):
        toks.append(make_token('DEDENT', '', 0, len(lines)))
    toks.append(make_token('EOF', '', 0, len(lines)))
    return toks

export def describe(t: Token) -> str:
    if t.kind == 'INT':
        return f'INT {t.num} {t.line}'
    return t.kind + ' ' + t.text.replace('\n', '\\n').replace('\r', '\\r') + ' ' + str(t.line)
