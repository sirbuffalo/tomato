# Seeds without a registry (docs/package-registry-design.md sections 3, 5 and 6; decisions D95a, D94b and D100a): the part of the seed work
# that needs no registry and no network beyond `git`. A project lists `{ path = "../folder" }` and `{ git = "URL", rev = "COMMIT" }`
# seeds in tomato.toml; `tomato seed install` reads each seed's own manifest, computes its content hash and writes tomato.lock (a git
# seed is fetched first, into the store of seedstore.tom, and kept there by its hash); `tomato seed add`, `remove` and `vendor` change
# the manifest, lock again and copy the locked seeds into the vendor folder; a build (run, build, compile, test) reads the lock, checks
# it against the manifest, and gives the compiler the module map: which file holds each module of each seed the build uses ([seeds],
# and [test-seeds] too for `tomato test`). A registry seed (a plain version) is reported as "not yet supported".
from toml import dumps, dumps_value
from value import Value, Dict, List, Str, Int, Bool
from config import ConfigError, read_toml, is_table, is_array
from manifest import Manifest, SeedReq, Wanted, entry_markers_of, read_manifest, check_tomato, seeds_for, same_line, compare_versions, module_stem, name_problem, version_problem, handle_problem
from modnames import std_modules, reserved_modules
from parser import parse
from manedit import add_entry, remove_entries
from seedstore import store_dir, make_scratch, remove_tree, fetch_tree, resolve_ref, git_url_problem, is_commit_id, ref_problem, subdir_problem
from index import SeedRec, VersionRec, close_index, newest_listed, version_named, seed_name_problem
from regclient import Root, select, read_user_config, pick_registry, open_registry, pick_seed, need_seed, summary_lines, Pick, ignored_lines
from hashlib import sha256_hex
from utf8 import encode
from os import listdir, stat, read_bytes, write_bytes, read_text, write_text, getcwd, makedirs, rename
from ospath import exists, isfile, isdir, normpath, relpath, dirname
from sys import run, flush, write_stdout

# a seed as the lock holds it
export class Locked:
    name: str = ''
    version: str = ''
    source: str = ''           # 'path', 'git' or 'registry' (a seed an index vouches for, signed by an owner's key)
    path: str = ''             # source 'path': as written in tomato.toml; source 'git': the folder of the repository that holds the seed ('' for the root)
    git: str = ''              # source 'git' and 'registry': the URL (as written in tomato.toml, or in the owner's source statement)
    commit: str = ''           # source 'git' and 'registry': the commit, 40 hex digits (the manifest's rev)
    hash: str = ''             # 'sha256:' and the hex of the seed hash v1
    modules: list[str] = []
    symbols: list[str] = []    # the foreign `!name(...)` symbols the seed's modules declare, as the user accepted them (D94b item 9)
    sites: list[str] = []      # not in the lock: `name TAB where` for each declaration, to show when asking
    test_only: bool = False    # only [test-seeds] lists it: a plain build does not use it (design section 3, D94b)
    key: str = ''              # source 'registry': the fingerprint of the owner key that signed this version (the lock's pin)
    requires: list[str] = []   # source 'registry': the seeds it needs, `name minimum`, as its version entry says (so the lock alone can be resolved)

# what the command line asked for (native/tomato passes the words)
export class Opts:
    locked: bool = False       # install --locked: write nothing, fail when the lock would change
    offline: bool = False      # never run git: a seed missing from the store (and the vendor folder) is an error
    yes: bool = False          # accept the foreign symbols without asking
    tty: bool = False          # standard input is a terminal, so there may be a question
    test: bool = False         # add: into [test-seeds]
    dry_run: bool = False      # update: show what would change, write nothing
    allow_yanked: bool = False # add, install: fetch a version its owner yanked as malware
    registry: str = ''         # add: the registry to use (--registry NAME); '' for the lock's, else the default

export def opts_from(words: list[str]) -> Opts:
    o = Opts()
    o.locked = 'locked' in words
    o.offline = 'offline' in words
    o.yes = 'yes' in words
    o.tty = 'tty' in words
    o.test = 'test' in words
    o.dry_run = 'dry-run' in words
    o.allow_yanked = 'allow-yanked' in words
    return o

def fail(code: int, path: str, text: str):
    raise ConfigError(code, f'{path}: {text}')

# an error about a word of the command line (not about a file): no file in front of it
def fail_word(code: int, text: str):
    raise ConfigError(code, text)

# a path as the user would type it: below the current folder it is written without that folder, so a message does not print a long
# absolute path for tomato.toml in the folder the command was run from
def shown_path(path: str) -> str:
    here = getcwd()
    if here != '/' and path.startswith(here + '/'):
        return path[len(here) + 1:]
    return path

def seed_folder(m: Manifest, path: str) -> str:
    # the folder of a path seed, without a closing slash
    if path.startswith('/'):
        return normpath(path)
    return normpath(m.dir + path)

# ---------------------------------------------------------------------------------------------------------------------
# the content hash (section 6, seed hash v1): the files of the folder, sorted by path, one line `sha256  mode  path` for each, the
# sha256 of the lines together. A folder named .git is not part of a seed, and neither is the builds folder at the top (what
# `tomato build` writes is never part of a build, D94b). A symlink is refused (a link could point outside).

def collect(folder: str, rel: str, out: list[str]):
    names = listdir(folder if rel == '' else folder + '/' + rel)
    for name in names:
        if name == '.git' or (name == 'builds' and rel == ''):
            continue
        here = name if rel == '' else rel + '/' + name
        full = folder + '/' + here
        st = stat(full)
        if st.is_symlink:
            raise ConfigError(576, f'{folder}: {here} is a symbolic link, which a seed cannot contain (it could point outside the seed)')
        if st.is_dir:
            collect(folder, here, out)
        elif st.is_file:
            out.append(here)
        else:
            raise ConfigError(576, f'{folder}: {here} is neither a file nor a folder, and a seed holds only those')

export def seed_hash_lines(folder: str) -> str:
    files: list[str] = []
    collect(folder, '', files)
    text = ''
    for rel in sorted(files):
        st = stat(folder + '/' + rel)
        mode = '755' if (st.mode & 64) != 0 else '644'      # the owner's execute bit, the only one git's tree records (section 6)
        text += sha256_hex(read_bytes(folder + '/' + rel)) + '  ' + mode + '  ' + rel + '\n'
    return text

export def seed_hash(folder: str) -> str:
    return 'sha256:' + sha256_hex(encode(seed_hash_lines(folder)))

# ---------------------------------------------------------------------------------------------------------------------
# a seed folder

# the module files of a seed folder: `modules` of its manifest, else every src/*.tom; each must be `stem.tom` or `stem_*.tom`
# (section 5) and must exist
export def seed_modules(sm: Manifest, folder: str) -> list[str]:
    stem = module_stem(sm.name)
    mods: list[str] = []
    if sm.has_modules:
        mods = sorted(sm.modules)
    else:
        if not isdir(folder + '/src'):
            fail(575, sm.path, f'the seed has no src folder: its modules are the .tom files in {folder}/src, or the ones listed in seed.modules')
        for f in listdir(folder + '/src'):
            if f.endswith('.tom') and isfile(folder + '/src/' + f):
                mods.append(f[:len(f) - 4])
        mods = sorted(mods)
    for mod in mods:
        if mod != stem and not mod.startswith(stem + '_'):
            fail(575, sm.path, f"the module '{mod}' does not fit the seed name {sm.name}: a seed may contain only {stem}.tom and {stem}_*.tom")
        if not isfile(f'{folder}/src/{mod}.tom'):
            fail(575, sm.path, f"the module '{mod}' has no file {folder}/src/{mod}.tom")
        if mod in std_modules():
            fail(579, sm.path, f"the module '{mod}' has the name of a standard module, so imports of it would change meaning")
        if mod in reserved_modules():
            fail(615, sm.path, f"the module '{mod}' has a name the standard library keeps for a module it may add (std/reserved.txt), so a program could not import both once it does: rename the file")
    if len(mods) == 0:
        fail(575, sm.path, f'the seed has no modules: put {stem}.tom in {folder}/src')
    return mods

# the foreign symbols the modules of a seed declare (D94b item 9; a `!tomato_*` declaration is refused, D27c): the `!name(...)` lines, found by parsing each module as the seed checks of
# design section 11 do. Sets seed.symbols (the names, sorted, once each) and seed.sites (`name TAB src/module.tom:line`)
def find_symbols(seed: Locked, folder: str):
    names: list[str] = []
    sites: list[str] = []
    for mod in seed.modules:
        file = f'{folder}/src/{mod}.tom'
        try:
            tree = parse(read_text(file))
        catch Error as e:
            fail(600, file, f'cannot read the module to look for foreign symbols: {e}')
            return
        for item in tree.fields[0].items:
            node = item.node
            if node is not None and node.kind == 'LlvmDecl':
                name = node.fields[0].text
                if name.startswith('tomato_'):
                    # D27c: the runtime's functions are reserved, so they are not offered for consent: the seed is refused
                    fail(612, f'{file}:{node.line}', f'the seed declares !{name}: tomato_* functions belong to the runtime and are not part of the language, so only the standard library may use them\n  = help: use the std module that wraps it, or ask the seed author to')
                if name not in names:
                    names.append(name)
                sites.append(f'{name}\tsrc/{mod}.tom:{node.line}')
    seed.symbols = sorted(names)
    seed.sites = sorted(sites)

# a folder that is a seed (the one a path names, or a fetched git tree): its manifest, name, version, modules, content hash and symbols.
# want is the name the manifest lists it under ('' to take whatever it is called, for `seed add`)
def describe_folder(m: Manifest, want: str, folder: str, have: str, allow_deps: bool = False) -> Locked:
    file = folder + '/tomato.toml'
    if not isfile(file):
        fail(572, m.path, 'the seed has no tomato.toml: the folder of a seed needs one with a [seed] table')
    sm = read_manifest(file)
    if sm.kind != 'seed':
        fail(572, file, f'the folder is listed as the seed {want}, but its tomato.toml has no [seed] table')
    if want != '' and sm.name != want:
        fail(573, m.path, f'"{want}" is listed with the source {folder}, but the seed there is called "{sm.name}"')
    check_tomato(sm, have)
    for r in sm.reqs:
        if r.table == '' and not allow_deps:
            fail(574, m.path, f'the seed {sm.name} itself uses the seed {r.name}, and seeds that use seeds cannot be installed yet: there is no registry')
    out = Locked()
    out.name = sm.name
    out.version = sm.version
    out.modules = seed_modules(sm, folder)
    out.hash = seed_hash(folder)
    find_symbols(out, folder)
    return out

def locked_path_seed(m: Manifest, req: SeedReq, have: str) -> Locked:
    folder = seed_folder(m, req.path)
    file = folder + '/tomato.toml'
    if not isdir(folder):
        fail(572, m.path, f'the seed {req.name} is at "{req.path}", which is not a folder (a relative path starts at the folder of tomato.toml)')
    if not isfile(file):
        fail(572, m.path, f'the seed {req.name} at "{req.path}" has no tomato.toml: the folder of a seed needs one with a [seed] table')
    sm = read_manifest(file)
    if sm.kind != 'seed':
        fail(572, file, f'the folder is listed as the seed {req.name}, but its tomato.toml has no [seed] table')
    if sm.name != req.name:
        fail(573, m.path, f'"{req.name}" is listed with the path "{req.path}", but the seed there is called "{sm.name}"')
    out = describe_folder(m, req.name, folder, have)
    out.source = 'path'
    out.path = req.path
    return out

# ---------------------------------------------------------------------------------------------------------------------
# git seeds (design sections 6 and 15, stage 3): fetched with git into the store of seedstore.tom, named there by the content hash

def vendor_root(m: Manifest) -> str:
    # the vendor folder of [seed-store] vendor, '' when it is not set; it is a folder below the project's
    if m.vendor == '':
        return ''
    v = m.vendor
    if v.startswith('/') or '..' in v.split('/'):
        fail(604, m.path, f'seed-store.vendor is "{v}", but the vendor folder must be a folder below the one with tomato.toml (no leading / and no ..)')
    return m.dir + v.rstrip('/')

def vendor_folder(m: Manifest, name: str) -> str:
    root = vendor_root(m)
    if root == '':
        return ''
    return root + '/' + name

def git_source_problem(m: Manifest, r: SeedReq):
    label = f'the seed {r.name}' if r.name != '' else f'the seed at {r.url}'
    why = git_url_problem(r.url)
    if why != '':
        fail(598, m.path, f'the git URL of {label} cannot be used: {why}')
    if not is_commit_id(r.rev):
        fail(598, m.path, f'the rev "{r.rev}" of {label} is not a full commit id (40 lowercase hex digits): a tag or a branch moves, so the manifest names the commit (git rev-parse TAG^{{commit}} prints it)')
    if r.tag != '':
        why = ref_problem(r.tag)
        if why != '':
            fail(598, m.path, f'the tag "{r.tag}" of {label} cannot be used: {why}')
    if r.branch != '':
        why = ref_problem(r.branch)
        if why != '':
            fail(598, m.path, f'the branch "{r.branch}" of {label} cannot be used: {why}')
    why = subdir_problem(r.subdir)
    if why != '':
        fail(598, m.path, f'the path "{r.subdir}" of {label} cannot be used: {why} (it is a folder of the repository, written with / and no leading or trailing slash)')

def changed_copy(m: Manifest, s: Locked, folder: str, actual: str):
    fix = 'run `tomato seed vendor` to copy it again' if folder == vendor_folder(m, s.name) else 'run `tomato seed install` to fetch it again, which replaces the damaged copy'
    fail(601, m.path, f'the copy of {s.name} in {folder} has the content hash {actual}, but tomato.lock says {s.hash}: it was changed after it was put there ({fix})')

def fetch_git_seed(m: Manifest, r: SeedReq, have: str, expect: str) -> Locked:
    scratch = make_scratch()
    s = Locked()
    try:
        tree = scratch + '/tree'
        commit = fetch_tree(r.url, r.rev, tree, scratch, r.subdir)
        s = describe_folder(m, r.name, tree, have)
        if expect != '' and s.hash != expect:
            fail(601, m.path, f'the seed {s.name} fetched from {r.url} at {r.rev[:12]} has the content hash {s.hash}, but tomato.lock says {expect}: the repository does not hold what was locked (nothing was stored)')
        place = store_dir(s.hash)
        if isdir(place) and seed_hash(place) != s.hash:
            remove_tree(place)                  # a damaged copy (changed after it was stored) is replaced by the one just fetched
        if not isdir(place):
            makedirs(dirname(place), True)
            try:
                rename(tree, place)
            catch IOError as e:
                if not isdir(place):            # (another install may have put the same seed there a moment ago: that is the same folder)
                    fail(599, m.path, f'cannot put the seed into the store at {place}: {e}')
        s.source = 'git'
        s.git = r.url
        s.commit = commit
        s.path = r.subdir
    finally:
        remove_tree(scratch)
    return s

# the lock entry (or a seed `add` just resolved) that came from this git source
def find_git_entry(lists: list[list[Locked]], r: SeedReq) -> Locked | None:
    for entries in lists:
        for e in entries:
            if e.source == 'git' and e.git == r.url and e.commit == r.rev and e.path == r.subdir and (r.name == '' or e.name == r.name):
                return e
    return None

# the checks of git_source_problem for a requirement with no rev yet (--tag and --branch of `seed add`): the URL, the names and the path
def git_source_problem_ref(m: Manifest, r: SeedReq):
    probe = SeedReq()
    probe.name = r.name
    probe.url = r.url
    probe.rev = '0' * 40
    probe.tag = r.tag
    probe.branch = r.branch
    probe.subdir = r.subdir
    git_source_problem(m, probe)

def locked_git_seed(m: Manifest, r: SeedReq, have: str, lists: list[list[Locked]], opts: Opts) -> Locked:
    git_source_problem(m, r)
    found = find_git_entry(lists, r)
    if found is not None:
        # the lock knows the content hash: a copy in the store (or the vendor folder) is checked against it, and only a missing one is fetched
        for folder in [store_dir(found.hash), vendor_folder(m, found.name)]:
            if folder != '' and isdir(folder):
                s = describe_folder(m, found.name, folder, have)
                if s.hash != found.hash:
                    if folder == vendor_folder(m, found.name):
                        continue            # a vendor copy that was edited is not used (the store, or git, has the seed): `seed vendor` writes it again
                    if opts.offline:
                        changed_copy(m, found, folder, s.hash)
                    continue                # a damaged copy in the store is fetched again (and replaced) below, as a missing one is
                s.source = 'git'
                s.git = r.url
                s.commit = r.rev
                s.path = r.subdir
                return s
        if opts.offline:
            fail(605, m.path, f'the seed {found.name} is not in the seed store ({store_dir(found.hash)}) or the vendor folder, and --offline does not run git: run `tomato seed install` once with the network')
        return fetch_git_seed(m, r, have, found.hash)
    if opts.locked:
        fail(578, m.path, 'tomato.lock does not match this manifest: run `tomato seed install` and commit the new lock')
    if opts.offline:
        fail(605, m.path, f'the seed {r.name} at {r.url} {r.rev[:12]} is not in tomato.lock, and --offline does not run git: run `tomato seed install` once with the network')
    return fetch_git_seed(m, r, have, '')

# ---------------------------------------------------------------------------------------------------------------------
# the lock

def str_array(items: list[str]) -> Value:
    a: list[Value] = []
    for s in items:
        a.append(Str(s))
    return List(a)

# the format version a lock is written with: 1, the first, and 2 only when an entry uses what version 1 cannot say, a git seed's `path`. An
# older Tomato reads version 1 only and stops on a 2 with "not version 1" instead of building another tree from the same URL and commit
export def lock_version(seeds: list[Locked]) -> int:
    for s in seeds:
        if (s.source == 'git' or s.source == 'registry') and s.path != '':
            return 2
    return 1

export def lock_text(seeds: list[Locked], index: str = '') -> str:
    doc = Dict({})
    doc.as_dict()['version'] = Int(lock_version(seeds))
    if index != '':
        doc.as_dict()['index'] = Str(index)
    list_t: list[Value] = []
    for s in sorted(seeds, key=x -> x.name):
        fields: dict[str, Value] = {}
        fields['name'] = Str(s.name)
        fields['version'] = Str(s.version)
        fields['source'] = Str(s.source)
        if s.source == 'path':
            fields['path'] = Str(s.path)
        if s.source == 'git' or s.source == 'registry':
            fields['git'] = Str(s.git)
            fields['commit'] = Str(s.commit)
            if s.path != '':
                fields['path'] = Str(s.path)
        if s.source == 'registry':
            fields['key'] = Str(s.key)
        fields['hash'] = Str(s.hash)
        fields['modules'] = str_array(s.modules)
        if len(s.symbols) > 0:
            fields['symbols'] = str_array(s.symbols)
        fields['seeds'] = str_array(s.requires)
        if s.test_only:
            fields['test_only'] = Bool(True)
        list_t.append(Dict(fields))
    if len(seeds) > 0:
        doc.as_dict()['seed'] = List(list_t)
    return '# tomato.lock: generated by `tomato seed install`, do not edit\n' + dumps(doc)

def must_string(path: str, t: Value, key: str) -> str:
    if not t.has(key) or t[key].kind() != 'str':
        fail(578, path, f'a [[seed]] entry needs the text setting {key}: the lock is damaged, run `tomato seed install`')
    return t[key].as_str()

def string_list(path: str, t: Value, key: str) -> list[str]:
    out: list[str] = []
    if not t.has(key):
        return out
    a = t[key]
    if not is_array(a):
        fail(578, path, f'{key} in a [[seed]] entry must be an array of text: the lock is damaged, run `tomato seed install`')
    for item in a.as_list():
        if item.kind() != 'str':
            fail(578, path, f'{key} in a [[seed]] entry must be an array of text: the lock is damaged, run `tomato seed install`')
        out.append(item.as_str())
    return out

export def read_lock(path: str) -> list[Locked]:
    doc = read_toml(path)
    version = 0
    if doc.has('version') and doc['version'].kind() == 'int':
        version = doc['version'].as_int()
    if version != 1 and version != 2:
        fail(578, path, 'this lock is not version 1 or 2 (a newer Tomato wrote it?): run `tomato seed install` to write it again')
    out: list[Locked] = []
    if doc.has('seed'):
        a = doc['seed']
        if not is_array(a):
            fail(578, path, 'seed must be a list of [[seed]] tables: the lock is damaged, run `tomato seed install`')
        for t in a.as_list():
            if not is_table(t):
                fail(578, path, 'seed must be a list of [[seed]] tables: the lock is damaged, run `tomato seed install`')
            s = Locked()
            s.name = must_string(path, t, 'name')
            s.version = must_string(path, t, 'version')
            s.source = must_string(path, t, 'source')
            if s.source == 'path':
                s.path = must_string(path, t, 'path')
            if s.source == 'git' or s.source == 'registry':
                s.git = must_string(path, t, 'git')
                s.commit = must_string(path, t, 'commit')
                if s.source == 'registry':
                    s.key = must_string(path, t, 'key')
                    s.requires = string_list(path, t, 'seeds')
                if t.has('path'):
                    if version < 2:
                        fail(578, path, f'a {s.source} [[seed]] entry has a path, which only a lock of version 2 has: the lock is damaged, run `tomato seed install`')
                    s.path = must_string(path, t, 'path')
            s.hash = must_string(path, t, 'hash')
            s.modules = string_list(path, t, 'modules')
            s.symbols = string_list(path, t, 'symbols')
            if t.has('test_only'):
                if t['test_only'].kind() != 'bool':
                    fail(578, path, 'test_only in a [[seed]] entry must be true or false: the lock is damaged, run `tomato seed install`')
                s.test_only = t['test_only'].as_bool()
            out.append(s)
    return out

# the name of the registry the lock's seeds came from ('' when it has none)
def read_lock_index(path: str) -> str:
    if not isfile(path):
        return ''
    doc = read_toml(path)
    if doc.has('index') and doc['index'].kind() == 'str':
        return doc['index'].as_str()
    return ''

def lock_path(m: Manifest) -> str:
    return m.dir + 'tomato.lock'

# ---------------------------------------------------------------------------------------------------------------------
# tomato seed install: lock every seed of every table (the union, section 4), writing tomato.lock. A git seed whose commit the lock
# already knows is taken from the store (or the vendor folder) and fetched only when it is in neither; one the lock does not know is
# fetched. Returns the seeds and the lines to print.

# ---------------------------------------------------------------------------------------------------------------------
# registry seeds (design sections 3, 4 and 9; stage 4): a seed that an index vouches for. Its version entry, signed by the owner's key, says the
# git URL, the commit, the content hash and the seeds it needs; the files are fetched as a git seed's are and must hash to what the entry says,
# and the seed's own tomato.toml at that commit must say what the entry says. The lock keeps all of it, so a build, `install --locked` and `verify`
# need no index; only choosing versions (`add`, `install` of a manifest the lock does not cover) reads one.

def requires_text(reqs: dict[str, str]) -> list[str]:
    out: list[str] = []
    for k in sorted(reqs.keys()):
        out.append(f'{k} {reqs[k]}')
    return out

def requires_dict(items: list[str]) -> dict[str, str]:
    out: dict[str, str] = {}
    for item in items:
        parts = item.split(' ')
        if len(parts) == 2:
            out[parts[0]] = parts[1]
    return out

# what the seed's own tomato.toml says must be what the signed entry says (name, version, the seeds it needs, its modules): else the owner signed
# one thing and published another
def check_entry_match(m: Manifest, e: Locked, s: Locked, folder: str):
    sm = read_manifest(folder + '/tomato.toml')
    where = f'the seed {e.name} {e.version} (commit {e.commit[:12]})'
    if sm.version != e.version:
        fail(684, m.path, f'{where} says its version is {sm.version} in its tomato.toml, but its signed entry in the index says {e.version}')
    mine: dict[str, str] = {}
    for r in sm.reqs:
        if r.table != '':
            continue
        if r.kind != 'version':
            fail(684, m.path, f'{where} lists {r.name} from a git or path source in its tomato.toml, and a registered seed uses registered seeds only')
        mine[r.name] = r.version
    want = requires_dict(e.requires)
    if requires_text(mine) != requires_text(want):
        fail(684, m.path, f'{where} needs {", ".join(requires_text(mine)) if len(mine) > 0 else "no seeds"} by its tomato.toml, but its signed entry in the index says {", ".join(requires_text(want)) if len(want) > 0 else "none"}')
    if sorted(s.modules) != sorted(e.modules):
        fail(684, m.path, f'{where} has the modules {", ".join(s.modules)}, but its signed entry in the index says {", ".join(e.modules)}')

# the seed as `e` (a lock entry, or one made from an index entry) describes it, from the store, the vendor folder or git
def locked_registry_seed(m: Manifest, e: Locked, have: str, opts: Opts) -> Locked:
    why = git_url_problem(e.git)
    if why != '':
        fail(598, m.path, f'the git URL of the seed {e.name} cannot be used: {why}')
    for folder in [store_dir(e.hash), vendor_folder(m, e.name)]:
        if folder != '' and isdir(folder):
            there = read_manifest(folder + '/tomato.toml') if isfile(folder + '/tomato.toml') else Manifest()
            if there.kind == 'seed' and there.name != e.name and seed_hash(folder) == e.hash:
                fail(684, m.path, f'the signed entry of {e.name} {e.version} says its content hash is {e.hash}, which is the hash of the seed {there.name}, not of {e.name}')
            s = describe_folder(m, e.name, folder, have, True)
            if s.hash != e.hash:
                if folder == vendor_folder(m, e.name):
                    continue
                if opts.offline:
                    changed_copy(m, e, folder, s.hash)
                continue
            check_entry_match(m, e, s, folder)
            return with_entry_fields(s, e)
    if opts.offline:
        fail(605, m.path, f'the seed {e.name} is not in the seed store ({store_dir(e.hash)}) or the vendor folder, and --offline does not run git: run `tomato seed install` once with the network')
    scratch = make_scratch()
    s = Locked()
    try:
        tree = scratch + '/tree'
        fetch_tree(e.git, e.commit, tree, scratch, e.path)
        s = describe_folder(m, e.name, tree, have, True)
        if s.hash != e.hash:
            fail(601, m.path, f'the seed {e.name} fetched from {e.git} at {e.commit[:12]} has the content hash {s.hash}, but its signed entry (tomato.lock) says {e.hash}: the repository does not hold what the owner published (nothing was stored)')
        check_entry_match(m, e, s, tree)
        place = store_dir(s.hash)
        if isdir(place) and seed_hash(place) != s.hash:
            remove_tree(place)
        if not isdir(place):
            makedirs(dirname(place), True)
            try:
                rename(tree, place)
            catch IOError as err:
                if not isdir(place):
                    fail(599, m.path, f'cannot put the seed into the store at {place}: {err}')
    finally:
        remove_tree(scratch)
    return with_entry_fields(s, e)

def with_entry_fields(s: Locked, e: Locked) -> Locked:
    s.source = 'registry'
    s.git = e.git
    s.commit = e.commit
    s.path = e.path
    s.key = e.key
    s.requires = e.requires
    return s

# the lock entry that an index entry stands for
def entry_locked(rec: SeedRec, v: VersionRec) -> Locked:
    e = Locked()
    e.name = rec.full
    e.version = v.version
    e.source = 'registry'
    e.git = rec.git
    e.commit = v.commit
    e.path = rec.path
    e.hash = v.hash
    e.key = v.key
    e.modules = v.modules
    e.requires = requires_text(v.seeds)
    return e

def yank_word(v: VersionRec) -> str:
    who = 'by its owner' if v.yanked == 'owner' else 'by a maintainer of the registry'
    return f'{v.version} is yanked {who} ({v.yank_kind}): {v.yank_reason}'

# every registry seed of the build, with the seeds they need: chosen by minimal version selection from the lock alone when the lock covers the
# manifest (no index, no network but a missing store copy), else from the registry's index. Returns the lock entries (with their files in the store).
def registry_seeds(m: Manifest, have: str, opts: Opts, old: list[Locked], wanted: Wanted, out: Relocked) -> list[Locked]:
    roots: list[Root] = []
    for i in range(len(wanted.reqs)):
        r = wanted.reqs[i]
        if r.kind == 'version':
            root = Root()
            root.name = r.name
            root.version = r.version
            root.test = '' not in wanted.tables[i]
            roots.append(root)
    made: list[Locked] = []
    if len(roots) == 0:
        return made
    lock_index = read_lock_index(lock_path(m))
    known: dict[str, dict[str, dict[str, str]]] = {}
    byname: dict[str, Locked] = {}
    for e in old:
        if e.source == 'registry':
            byname[e.name] = e
            if e.name not in known:
                known[e.name] = {}
            known[e.name][e.version] = requires_dict(e.requires)
    res = select(roots, known, None)
    covered = res.ok
    if covered:
        for c in res.chosen:
            if c.name not in byname or byname[c.name].version != c.version:
                covered = False
    if covered and opts.registry != '' and lock_index != '' and opts.registry != lock_index:
        fail(679, m.path, f'tomato.lock holds seeds from the registry {lock_index}, and --registry {opts.registry} would mix registries in one lock')
    if covered:
        out.index = lock_index
        for c in res.chosen:
            e = byname[c.name]
            s = locked_registry_seed(m, e, have, opts)
            s.test_only = c.test_only
            made.append(s)
        return made
    if opts.locked:
        fail(578, m.path, 'tomato.lock does not match this manifest: run `tomato seed install` and commit the new lock')
    if opts.offline:
        fail(605, m.path, 'the lock does not cover the registry seeds of tomato.toml, and --offline does not read an index: run `tomato seed install` once with the network')
    cfg = read_user_config()
    reg = pick_registry(cfg, opts.registry, lock_index)
    if lock_index != '' and reg.name != lock_index:
        fail(679, m.path, f'tomato.lock holds seeds from the registry {lock_index}, and {reg.name} would mix registries in one lock')
    idx = open_registry(reg)
    try:
        fresh = select(roots, {}, idx)
        for c in fresh.chosen:
            rec = need_seed(idx, reg, c.name)
            v = version_named(rec, c.version)
            if v is None:
                fail(682, m.path, f'the registry {reg.name} has no version {c.version} of {c.name}')
                return made
            if rec.git == '':
                fail(682, m.path, f'the registry {reg.name} has no source statement for {c.name}: nothing says where to fetch it')
            e = entry_locked(rec, v)
            if c.name in byname:
                was = byname[c.name]
                if was.version == e.version and (was.commit != e.commit or was.hash != e.hash or was.key != e.key or was.git != e.git or was.path != e.path):
                    fail(684, m.path, f'tomato.lock has {c.name} {c.version} at commit {was.commit[:12]} ({short_hash(was.hash)}, key {was.key}), but the registry now says commit {e.commit[:12]} ({short_hash(e.hash)}, key {e.key}): a published version never changes, so one of them was altered (the lock is what builds)')
            if v.yanked != '':
                print(f'warning: {c.name} {yank_word(v)}')
            if v.yanked == 'owner' and v.yank_kind == 'malware' and not opts.allow_yanked and not isdir(store_dir(e.hash)):
                fail(685, m.path, f'{c.name} {yank_word(v)}: its owner says it is malware, so it is not fetched (add --allow-yanked to fetch it anyway)')
            s = locked_registry_seed(m, e, have, opts)
            s.test_only = c.test_only
            made.append(s)
    finally:
        close_index(idx)
    out.index = reg.name
    return made

class Relocked:
    seeds: list[Locked] = []
    said: list[str] = []
    index: str = ''            # the registry the lock's registry seeds came from

def old_lock(m: Manifest) -> list[Locked]:
    # the lock on disk, for what it already knows; a lock that cannot be read knows nothing (install writes it again)
    path = lock_path(m)
    out: list[Locked] = []
    if isfile(path):
        try:
            out = read_lock(path)
        catch ConfigError as e:
            out = []
    return out

# the lock's entry for a seed, or None
def entry_named(entries: list[Locked], name: str) -> Locked | None:
    for e in entries:
        if e.name == name:
            return e
    return None

def short_hash(h: str) -> str:
    return h[:19] + '...' if len(h) > 19 else h

# what changes in one seed when the lock is written again (`tomato seed update`): the version, the commit and the content hash, and the
# foreign symbols the lock does not hold yet (those make the command ask, or with --dry-run say it would)
def change_lines(before: list[Locked], s: Locked, fresh: list[str], opts: Opts) -> list[str]:
    out: list[str] = []
    old = entry_named(before, s.name)
    if old is None:
        out.append(f'{s.name}: {s.version} is new in tomato.lock')
    else:
        was = old
        same = was.version == s.version and was.hash == s.hash and was.commit == s.commit and was.git == s.git and was.path == s.path and was.source == s.source
        if same:
            out.append(f'{s.name} {s.version}: unchanged')
        else:
            if was.version != s.version:
                out.append(f'{s.name}: {was.version} -> {s.version}')
            else:
                out.append(f'{s.name} {s.version}: changed')
            if s.source == 'git' and was.commit != s.commit:
                out.append(f'  commit  {was.commit[:12]} -> {s.commit[:12]}')
            if was.hash != s.hash:
                out.append(f'  hash    {short_hash(was.hash)} -> {short_hash(s.hash)}')
            if was.version != s.version:
                c = compare_versions(s.version, was.version)
                if c < 0:
                    out.append(f'  warning: the version went down, from {was.version} to {s.version}')
                elif not same_line(s.version, was.version):
                    out.append(f'  note: {s.version} is not on the compatible line of {was.version} (a new major version, or a new minor one below 1.0)')
    if len(fresh) > 0:
        names = ', '.join(fresh)
        if opts.dry_run:
            out.append(f'  new foreign symbols: {names} (the update would ask you to accept them)')
        else:
            out.append(f'  new foreign symbols: {names} (you are asked below)')
    return out

def site_lines(s: Locked, fresh: list[str]) -> list[str]:
    out: list[str] = []
    for site in s.sites:
        parts = site.split('\t')
        if parts[0] in fresh:
            out.append(f'  {parts[0]}  ({parts[1]})')
    return out

def ask_yes() -> bool:
    # one line from standard input (`input()` is async, and nothing here is); end of input is no
    answer = ''
    try:
        f = open('/dev/stdin')
        answer = f.readline()
        f.close()
    catch IOError as e:
        answer = ''
    return answer.strip().lower() == 'y' or answer.strip().lower() == 'yes'

# the foreign symbols of a seed that the lock does not hold yet (D94b item 9): they are listed, and the user accepts them (`--yes`, or
# at a terminal an answer to one question) before anything is written; otherwise the command stops and changes nothing
def consent(m: Manifest, s: Locked, fresh: list[str], opts: Opts):
    head = f'the seed {s.name} {s.version} declares foreign symbols, !name(...) declarations that link functions of the runtime or of C into your program, with no check of their types by the compiler:'
    lines = site_lines(s, fresh)
    if opts.locked:
        fail(602, m.path, head + '\n' + '\n'.join(lines) + '\n  = help: tomato.lock does not hold these symbols: run `tomato seed install` and answer, or add --yes')
    if not opts.yes and not opts.tty:
        fail(602, m.path, head + '\n' + '\n'.join(lines) + '\n  = help: this command cannot ask here (standard input is not a terminal): run it at a terminal, or add --yes to accept them; nothing was changed')
    print(head)
    for line in lines:
        print(line)
    if opts.yes:
        print('accepted with --yes; they are recorded in tomato.lock')
        return
    write_stdout('accept these symbols and record them in tomato.lock? [y/N] ')
    flush()
    if not ask_yes():
        fail(602, m.path, f'the foreign symbols of {s.name} were not accepted; nothing was changed')

def relock(manifest_path: str, have: str, opts: Opts, known: list[Locked], approved: dict[str, list[str]], report: list[str]) -> Relocked:
    m = read_manifest(manifest_path)
    check_tomato(m, have)
    wanted = seeds_for(m, False, True)
    old = old_lock(m)
    out = Relocked()
    made: list[Locked] = []
    for i in range(len(wanted.reqs)):
        r = wanted.reqs[i]
        if r.kind == 'version':
            continue
        s = Locked()
        if r.kind == 'git':
            s = locked_git_seed(m, r, have, [known, old], opts)
        else:
            s = locked_path_seed(m, r, have)
        s.test_only = '' not in wanted.tables[i]
        made.append(s)
    made += registry_seeds(m, have, opts, old, wanted, out)
    for s in made:
        accepted: list[str] = []
        if s.name in approved:
            accepted = approved[s.name]
        for e in old:
            if e.name == s.name:
                accepted = accepted + e.symbols
        fresh = [x for x in s.symbols if x not in accepted]
        if s.name in report:
            # what `seed update` changes in this seed, shown before the question about its new symbols
            for line in change_lines(old, s, fresh, opts):
                print(line)
        if len(fresh) > 0 and not opts.dry_run:
            consent(m, s, fresh, opts)
        out.seeds.append(s)
        if s.source == 'git':
            where = f'git {s.git} {s.commit[:12]}' + (f' path {s.path}' if s.path != '' else '')
            out.said.append(f'{s.name} {s.version}  {s.hash}  ({where})')
        elif s.source == 'registry':
            out.said.append(f'{s.name} {s.version}  {s.hash}  (registry {out.index}, git {s.git} {s.commit[:12]})')
        else:
            out.said.append(f'{s.name} {s.version}  {s.hash}  (path {s.path})')
    # two seeds that both provide a module cannot be in one program (section 5)
    for i in range(len(out.seeds)):
        for j in range(i + 1, len(out.seeds)):
            for mod in out.seeds[i].modules:
                if mod in out.seeds[j].modules:
                    fail(577, m.path, f"the seeds {out.seeds[i].name} and {out.seeds[j].name} both provide the module '{mod}': one program holds one copy of a module")
    text = lock_text(out.seeds, out.index)
    path = lock_path(m)
    have_lock = isfile(path)
    if opts.locked:
        if (len(out.seeds) == 0 and not have_lock) or (have_lock and read_text(path) == text):
            out.said.append('tomato.lock is up to date')
            return out
        for s in out.seeds:
            e = entry_named(old, s.name)
            if e is not None and e.hash != s.hash and s.source == 'path':
                fail(578, m.path, f'tomato.lock does not match this manifest: the files of the path seed {s.name} ({s.path}) changed since the lock was written (hash {short_hash(e.hash)} in tomato.lock, {short_hash(s.hash)} now): run `tomato seed install` and commit the new lock')
        fail(578, m.path, 'tomato.lock does not match this manifest: run `tomato seed install` and commit the new lock')
    if len(out.seeds) == 0 and not have_lock:
        out.said.append('the manifest lists no seeds: nothing to lock')
        return out
    if opts.dry_run:
        out.said.append('dry run: tomato.toml and tomato.lock are as they were')
        return out
    write_text(path, text)
    out.said.append(f'wrote {shown_path(path)} ({len(out.seeds)} seed' + ('' if len(out.seeds) == 1 else 's') + ')')
    return out

export def install(manifest_path: str, have: str, opts: Opts) -> list[str]:
    return relock(manifest_path, have, opts, [], {}, []).said

# ---------------------------------------------------------------------------------------------------------------------
# a build: the lock against the manifest, and the module map of the seeds the build uses ([test-seeds] too when `tests`). Each line is `module TAB file TAB label`
# (the label, `name version`, is what an error in the module names instead of the bare file; design section 5 has the first two).

# where the files of a locked seed are: the vendor folder when [seed-store] vendor is set, else the seed's own folder (a path seed) or
# its folder in the store (a git seed)
def source_folder(m: Manifest, s: Locked) -> str:
    v = vendor_folder(m, s.name)
    if v != '':
        return v
    if s.source == 'git' or s.source == 'registry':
        return store_dir(s.hash)
    return seed_folder(m, s.path)

export def module_map(m: Manifest, tests: bool) -> list[str]:
    out: list[str] = []
    wanted = seeds_for(m, tests, False)
    if len(wanted.reqs) == 0:
        return out
    help = '\n  = help: run: tomato seed install'
    path = lock_path(m)
    if not isfile(path):
        fail(569, m.path, f'this uses the seed {wanted.reqs[0].name}, but there is no tomato.lock beside it{help}')
    lock = read_lock(path)
    owner: dict[str, str] = {}
    # the seeds the manifest asks for, then the registry seeds they need (the lock holds each one's requirements), each once
    names: list[str] = []
    req_of: dict[str, SeedReq] = {}
    for r0 in wanted.reqs:
        names.append(r0.name)
        req_of[r0.name] = r0
    k = 0
    while k < len(names):
        name = names[k]
        k += 1
        found = Locked()
        have_it = False
        for s in lock:
            if s.name == name:
                found = s
                have_it = True
        if not have_it:
            if name in req_of:
                fail(569, m.path, f'the seed {name} is in tomato.toml but not in tomato.lock{help}')
            fail(569, m.path, f'the seed {name} is needed by a seed in tomato.lock, but tomato.lock does not hold it{help}')
        if name in req_of:
            r = req_of[name]
            if r.kind == 'path':
                if found.source != 'path' or found.path != r.path:
                    fail(569, m.path, f'tomato.lock has the seed {r.name} from another source than the path "{r.path}" in tomato.toml{help}')
            elif r.kind == 'git':
                if found.source != 'git' or found.git != r.url or found.commit != r.rev or found.path != r.subdir:
                    fail(569, m.path, f'tomato.lock has the seed {r.name} from another source than the git URL and rev in tomato.toml{help}')
            elif r.kind == 'version':
                if found.source != 'registry' or compare_versions(found.version, r.version) < 0 or not same_line(found.version, r.version):
                    fail(569, m.path, f'tomato.lock has the seed {r.name} {found.version}, which does not meet the {r.version} in tomato.toml{help}')
        elif found.source != 'registry':
            fail(569, m.path, f'tomato.lock lists the seed {name} from a {found.source} source as needed by another seed, which only a registry seed does{help}')
        if found.source != 'path' and found.source != 'git' and found.source != 'registry':
            fail(571, m.path, f'the seed {name} comes from a {found.source}, which this version cannot build')
        if found.source == 'registry':
            for item in found.requires:
                parts = item.split(' ')
                dep = Locked()
                has_dep = False
                for s in lock:
                    if s.name == parts[0]:
                        dep = s
                        has_dep = True
                if len(parts) != 2 or not has_dep or compare_versions(dep.version, parts[1]) < 0 or not same_line(dep.version, parts[1]):
                    fail(569, m.path, f'tomato.lock has the seed {name} {found.version}, which needs {item}, but tomato.lock does not hold a seed that meets it{help}')
                if parts[0] not in names:
                    names.append(parts[0])
        folder = source_folder(m, found)
        if found.source == 'git' or found.source == 'registry' or vendor_folder(m, found.name) != '':
            # a copy in the store or the vendor folder is checked against the lock on every build (a path seed is a working folder and is not)
            if not isdir(folder):
                where = 'the vendor folder' if vendor_folder(m, found.name) != '' else 'the seed store'
                fix = 'tomato seed vendor' if vendor_folder(m, found.name) != '' else 'tomato seed install'
                fail(569, m.path, f'the seed {name} is not in {where} ({folder}){chr(10)}  = help: run: {fix}')
            actual = seed_hash(folder)
            if actual != found.hash:
                changed_copy(m, found, folder, actual)
        if found.source == 'path' and vendor_folder(m, found.name) == '':
            # a path seed is a working folder: a `!name(...)` symbol added after it was locked is asked about here, as `seed install` asks
            # (a module that cannot be read is left to the compile, which says what is wrong with it)
            now = Locked()
            now.name = found.name
            now.version = found.version
            now.modules = found.modules
            readable = True
            try:
                find_symbols(now, folder)
            catch ConfigError as e:
                readable = False
            fresh = [x for x in now.symbols if x not in found.symbols]
            if readable and len(fresh) > 0:
                check = Opts()
                check.locked = True
                consent(m, now, fresh, check)
        for mod in found.modules:
            if mod in owner:
                fail(577, m.path, f"the seeds {owner[mod]} and {found.name} both provide the module '{mod}': one program holds one copy of a module")
            owner[mod] = found.name
            out.append(f'{mod}\t{folder}/src/{mod}.tom\t{found.name} {found.version}')
    return out

# ---------------------------------------------------------------------------------------------------------------------
# tomato seed add and remove: the manifest's text is edited line by line (manedit.tom keeps the comments and the order), the result is
# read again with the manifest reader and must hold exactly the intended change, then the lock is written; if anything fails the
# manifest is put back as it was

export class AddSpec:
    kind: str = 'path'         # 'path' (--path DIR), 'git' (--git URL with --rev COMMIT, --tag TAG or --branch BRANCH) or 'registry' (a name the registry knows)
    path: str = ''             # the folder as the user wrote it, relative to the current folder
    url: str = ''
    rev: str = ''
    tag: str = ''              # git: a tag, resolved to its commit now; `seed update` follows it
    branch: str = ''           # git: a branch, the same
    subdir: str = ''           # git: the folder of the repository that holds the seed (--subdir)
    name: str = ''             # kind 'registry': what was typed, an alias, a short name or owner/name, without the @VERSION
    version: str = ''          # kind 'registry': the version after @, '' for the newest listed one

# ---------------------------------------------------------------------------------------------------------------------
# host shortcuts and handles (design sections 1.10 and 6; D117a: both are in for 1.0). `tomato seed add gh:USER/REPO --rev COMMIT` is
# `--git https://github.com/USER/REPO.git --rev COMMIT`: the word is expanded here, before anything else, and only the full URL ever reaches
# tomato.toml and tomato.lock (a shortcut that later changed meaning would change nothing already locked). A shortcut has no owner and no
# signature and is an unregistered source, like --git. A handle (`dave/thing`) is a registry name whose owner a maintainer granted: with no
# registry (stage 4) it can be recognised and checked, not looked up, so `add` says where to get the seed instead.

def host_base(host: str) -> str:
    if host == 'gh':
        return 'https://github.com/'
    if host == 'gitlab':
        return 'https://gitlab.com/'
    if host == 'codeberg':
        return 'https://codeberg.org/'
    if host == 'srht':
        return 'https://git.sr.ht/'
    return ''

# a user or repository part of a shortcut: letters, digits, dots, underscores and hyphens, not starting with a hyphen, not . or ..
def host_part_ok(s: str) -> bool:
    if s == '' or s == '.' or s == '..' or s.startswith('-'):
        return False
    for c in s:
        if not (('a' <= c and c <= 'z') or ('A' <= c and c <= 'Z') or ('0' <= c and c <= '9')) and c != '.' and c != '_' and c != '-':
            return False
    return True

# the https URL of a shortcut word `HOST:USER/REPO` (srht: `srht:~USER/REPO`); E621 when the part after the colon is not exactly that
export def expand_shortcut(path: str, word: str) -> str:
    at = word.find(':')
    host = word[:at]
    rest = word[at + 1:]
    form = f'{host}:~USER/REPO' if host == 'srht' else f'{host}:USER/REPO'
    parts = rest.split('/')
    if len(parts) != 2 or parts[0] == '' or parts[1] == '':
        fail_word(621, f'"{word}" is not a host shortcut: write {form} (exactly one user and one repository; a repository in a deeper folder takes --git URL and --subdir)')
    user = parts[0]
    repo = parts[1]
    if host == 'srht':
        if not user.startswith('~'):
            fail_word(621, f'"{word}" is not a host shortcut: a Sourcehut user starts with ~, so write {form}')
        user = user[1:]
    if not host_part_ok(user) or not host_part_ok(repo):
        fail_word(621, f'"{word}" is not a host shortcut: a user and a repository have letters, digits, dots, underscores and hyphens only; write {form}')
    if repo.endswith('.git'):
        fail_word(621, f'"{word}" is not a host shortcut: write the repository without .git ({form}); the shortcut adds what the host needs')
    if host == 'srht':
        return host_base(host) + '~' + user + '/' + repo
    return host_base(host) + user + '/' + repo + '.git'

# the AddSpec of the word given to `tomato seed add` (neither --path nor --git): a host shortcut becomes a git source, a seed name
# (`dave/thing`, `acme.example/json5`, with `@VERSION` allowed) is a registry seed, which cannot be added until there is a registry (E571)
export def add_spec_from_word(path: str, word: str, rev: str, tag: str, branch: str, subdir: str) -> AddSpec:
    if ':' in word:
        host = word[:word.find(':')]
        if host_base(host) == '':
            more = f' (a git URL goes after --git: tomato seed add --git {word} --rev COMMIT)' if '://' in word else ''
            fail_word(621, f'"{word}" is not a seed: a word with a colon is a host shortcut, and the shortcuts are gh:USER/REPO, gitlab:USER/REPO, codeberg:USER/REPO and srht:~USER/REPO{more}')
        spec = AddSpec()
        spec.kind = 'git'
        spec.url = expand_shortcut(path, word)
        spec.rev = rev
        spec.tag = tag
        spec.branch = branch
        spec.subdir = subdir
        n = 0
        for x in [rev, tag, branch]:
            if x != '':
                n += 1
        if n != 1:
            fail_word(621, f'a git seed needs one of --rev COMMIT (the full commit id), --tag TAG or --branch BRANCH: {word} is {spec.url}')
        return spec
    name = word
    version = ''
    if '@' in word:
        name = word[:word.find('@')]
        version = word[word.find('@') + 1:]
        problem = version_problem(version, True)
        if problem != '':
            fail_word(621, f'"{word}" has a version that is not one: {problem}')
    if '/' not in name:
        # a bare name: the user's alias, else a short name of the registry (section 1.7); the registry answers, so it is checked there
        problem = seed_name_problem(name)
        if problem != '':
            fail_word(621, f'"{word}" is not a seed name or a host shortcut: {problem} (a folder is --path DIR, a git URL is --git URL)')
    else:
        problem = name_problem(name)
        if problem != '':
            fail_word(621, f'"{word}" is not a seed name or a host shortcut: {problem} (a folder is --path DIR, a git URL is --git URL)')
        owner = name.split('/')[0]
        if '.' not in owner:
            problem = handle_problem(owner)
            if problem != '':
                fail_word(621, f'"{word}" is not a seed name: the owner {owner} has no dot, so it would be a handle, and it is not one ({problem}); a domain owner has a dot (acme.example)')
    spec = AddSpec()
    spec.kind = 'registry'
    spec.name = name
    spec.version = version
    return spec

# ---------------------------------------------------------------------------------------------------------------------
# the `# seeds:` header of a single .tom file (design sections 5 and 6; D117a): a program names the seeds it needs in a comment line at the
# top, `# seeds: dave/thing>=1.2, acme.example/json5`, and `tomato run`, `build` and `compile` read it. They never fetch: the line is
# checked against the project's tomato.toml and tomato.lock, which say where each seed comes from and which commit and hash it is; the
# line itself holds names and minimum versions only, so with no registry to look a name up it cannot make a seed appear. A seed the line
# names that the project does not list is an error with the command to run; a listed seed that is not locked or not in the store is the
# error of every build, `run: tomato seed install` (E569).

# one seed of the header: the name and the minimum version, written MAJOR.MINOR.PATCH ('' when the line sets none)
export class HeaderReq:
    name: str = ''
    version: str = ''
    line: int = 0

def header_word(file: str, n: int, item: str) -> HeaderReq:
    where = f'{file}:{n}'
    r = HeaderReq()
    r.line = n
    r.name = item
    at = item.find('>=')
    if at >= 0:
        r.name = item[:at].strip()
        r.version = item[at + 2:].strip()
    else:
        for c in ['=', '<', '>', '~', '^', '!', '@', ' ']:
            if c in item:
                fail(622, where, f'"{item}" in the "# seeds:" line is not NAME or NAME>=VERSION: a version is written as a minimum, dave/thing>=1.2 (the line has no other comparison)')
    problem = name_problem(r.name)
    if problem != '':
        fail(622, where, f'"{r.name}" in the "# seeds:" line is not a seed name: {problem}')
    if r.version != '':
        problem = version_problem(r.version, False)
        if problem != '':
            fail(622, where, f'">={r.version}" in the "# seeds:" line is not a version: {problem}')
        core = r.version
        pre = ''
        hy = r.version.find('-')
        if hy >= 0:
            core = r.version[:hy]
            pre = r.version[hy:]
        if len(core.split('.')) == 2:
            r.version = core + '.0' + pre
    return r

# the seeds the leading comment block of `src` names, in the order written, a seed named twice once with the higher minimum. The block is
# every line from the top that is blank or starts with # (a first line `#!...` too); the first other line ends it, so a `# seeds:` line
# further down is an ordinary comment. A line is `# seeds: ` and one or more `NAME` or `NAME>=VERSION` separated by commas (E622); more
# than one such line may be written
export def header_seeds(file: str, src: str) -> list[HeaderReq]:
    out: list[HeaderReq] = []
    n = 0
    for raw in src.split('\n'):
        n += 1
        line = raw.strip()
        if line == '' or (n == 1 and line.startswith('#!')):
            continue
        if not line.startswith('#'):
            break
        text = line[1:].strip()
        if not text.startswith('seeds:'):
            continue
        body = text[6:].strip()
        if body == '':
            fail(622, f'{file}:{n}', 'the "# seeds:" line names no seed: write # seeds: dave/thing>=1.2')
        for piece in body.split(','):
            item = piece.strip()
            if item == '':
                fail(622, f'{file}:{n}', 'the "# seeds:" line has an empty entry (a comma with no seed beside it)')
            r = header_word(file, n, item)
            at = -1
            for i in range(len(out)):
                if out[i].name == r.name:
                    at = i
                    if out[i].line == n:
                        fail(622, f'{file}:{n}', f'the "# seeds:" line names {r.name} twice')
            if at < 0:
                out.append(r)
            elif r.version != '' and (out[at].version == '' or compare_versions(r.version, out[at].version) > 0):
                out[at].version = r.version
    return out

def header_shown(h: HeaderReq) -> str:
    if h.version == '':
        return h.name
    return f'{h.name}>={h.version}'

# a program outside every project (no tomato.toml) with a header: there is no lock to take the seeds from
export def header_without_project(file: str, want: list[HeaderReq]):
    if len(want) == 0:
        return
    names = ', '.join([header_shown(h) for h in want])
    fail(622, file, f'the "# seeds:" line names {names}, but there is no tomato.toml in this folder or a parent folder, so no seed is locked for it\n  = help: start a project (tomato init), then add the seeds there (tomato seed add gh:USER/REPO --rev COMMIT, or --git URL, or --path DIR); a name alone cannot be fetched until there is a registry')

# the header of a program in a project, after the project's own seeds were checked (module_map): every seed it names must be one the build
# uses, at the version it asks or a later one of the same line (the rule of a minimum in [seeds], design section 4)
export def check_header(m: Manifest, file: str, want: list[HeaderReq], tests: bool):
    if len(want) == 0:
        return
    used = seeds_for(m, tests, False)
    lock = old_lock(m)
    for h in want:
        listed = False
        for r in used.reqs:
            if r.name == h.name:
                listed = True
        if not listed:
            more = ''
            for r in m.reqs:
                if r.name == h.name:
                    more = ' (it is in [test-seeds], which only tomato test reads)'
            fail(622, f'{file}:{h.line}', f'the "# seeds:" line names the seed {header_shown(h)}, but tomato.toml does not list it in [seeds]{more}\n  = help: tomato seed add gh:USER/REPO --rev COMMIT (or --git URL, or --path DIR) adds a seed and locks it; a name alone cannot be fetched until there is a registry')
        if h.version == '':
            continue
        for s in lock:
            if s.name == h.name and (compare_versions(s.version, h.version) < 0 or not same_line(s.version, h.version)):
                fail(622, f'{file}:{h.line}', f'the "# seeds:" line asks for {header_shown(h)}, but tomato.lock has {s.name} {s.version}: a minimum is met by the same version or a later one of the same compatible line\n  = help: use a seed of that version (tomato seed update, or add it at another rev), or change the line')

# the manifest's value of a git seed: { git = "URL", rev = "COMMIT" } and, when set, tag or branch, and path
def git_value(r: SeedReq) -> str:
    v = '{ git = ' + dumps_value(Str(r.url)) + ', rev = ' + dumps_value(Str(r.rev))
    if r.tag != '':
        v += ', tag = ' + dumps_value(Str(r.tag))
    if r.branch != '':
        v += ', branch = ' + dumps_value(Str(r.branch))
    if r.subdir != '':
        v += ', path = ' + dumps_value(Str(r.subdir))
    return v + ' }'

# the commit that the tag or branch of a git seed points at now (git runs; nothing else is touched)
def resolve_follow(m: Manifest, r: SeedReq) -> str:
    scratch = make_scratch()
    commit = ''
    try:
        commit = resolve_ref(r.url, r.tag, r.branch, scratch)
    finally:
        remove_tree(scratch)
    return commit

# one line for each requirement of every table, sorted: what an edit may change and nothing else
def req_keys(m: Manifest) -> list[str]:
    out: list[str] = []
    for r in m.reqs:
        out.append(req_key(r))
    return sorted(out)

# the manifest at path, read again after an edit: it must be the old requirements without those of `name` (in `table` only, when it is
# not ''), plus `added` ('' for none). Else the edit is refused with the line to write by hand
def check_edit(path: str, before: Manifest, name: str, table: str, added: str, by_hand: str):
    expected: list[str] = []
    for r in before.reqs:
        if r.name == name and (table == '*' or r.table == table):
            continue
        expected.append(req_key(r))
    if added != '':
        expected.append(added)
    after = Manifest()
    try:
        after = read_manifest(path)
    catch ConfigError as e:
        fail(603, path, f'the edit would leave tomato.toml unreadable ({e.message}); it was put back as it was. {by_hand}')
    seeds_for(after, False, True)          # (a seed that is now in both tables with two sources is E564)
    if req_keys(after) != sorted(expected):
        fail(603, path, f'tomato.toml has a form this command does not edit (a dotted key, a multi-line value, a table written another way): it was put back as it was. {by_hand}')

def req_key(r: SeedReq) -> str:
    return f'{r.table}|{r.name}|{r.kind}|{r.version}|{r.url}|{r.rev}|{r.path}|{r.tag}|{r.branch}|{r.subdir}'

# `tomato seed add NAME[@VERSION]` for a registry seed (section 12): the word is an alias, a short name or a full name; the registry's newest listed
# version (or the one named) is written as the minimum in tomato.toml, and the lock is made from it. The summary of what is added is printed
# before anything is written
def add_registry(manifest_path: str, m: Manifest, have: str, spec: AddSpec, opts: Opts) -> list[str]:
    cfg = read_user_config()
    lock_index = read_lock_index(lock_path(m))
    if opts.registry != '' and lock_index != '' and opts.registry != lock_index:
        fail(679, m.path, f'tomato.lock holds seeds from the registry {lock_index}, and --registry {opts.registry} would mix registries in one lock')
    reg = pick_registry(cfg, opts.registry, lock_index)
    opts.registry = reg.name
    idx = open_registry(reg)
    pick = Pick()
    full = ''
    version = ''
    lines: list[str] = []
    try:
        pick = pick_seed(cfg, idx, reg, spec.name)
        full = pick.full
        rec = need_seed(idx, reg, full)
        got: VersionRec | None = None
        if spec.version != '':
            got = version_named(rec, spec.version)
            if got is None:
                have_versions = ', '.join([v.version for v in rec.versions])
                fail(682, m.path, f'{full} has no version {spec.version} in the registry {reg.name} (its versions: {have_versions})' + ignored_lines(idx, full))
                return lines
            if got.yanked == 'owner' and got.yank_kind == 'malware' and not opts.allow_yanked:
                fail(685, m.path, f'{full} {yank_word(got)}: its owner says it is malware, so it is not added (add --allow-yanked to add it anyway)')
        else:
            got = newest_listed(rec)
            if got is None:
                fail(682, m.path, f'{full} has no version that is listed: every version is yanked or a pre-release; name one with {full}@VERSION')
                return lines
        version = got.version
        lines = summary_lines(idx, rec, got, pick, reg)
        if pick.said != '':
            lines.insert(0, pick.said)
    finally:
        close_index(idx)
    for line in lines:
        print(line)
    req = SeedReq()
    req.table = 'test' if opts.test else ''
    req.name = full
    req.kind = 'version'
    # an existing minimum that is higher on the same line stays: `add` never lowers a requirement
    for r0 in m.reqs:
        if r0.name == full and r0.table == req.table and r0.kind == 'version' and same_line(r0.version, version) and compare_versions(r0.version, version) > 0:
            version = r0.version
    req.version = version
    where = 'test-seeds' if opts.test else 'seeds'
    value = dumps_value(Str(version))
    original = read_text(manifest_path)
    write_text(manifest_path, add_entry(original, where, full, value))
    said: list[str] = []
    done = False
    try:
        check_edit(manifest_path, m, full, req.table, req_key(req), f'Add this line to [{where}] yourself: "{full}" = {value}')
        said = relock(manifest_path, have, opts, [], {}, []).said
        done = True
    finally:
        if not done:
            write_text(manifest_path, original)
    said.insert(0, f'added {full} {version} to [{where}] of {manifest_path}')
    return said

export def add(manifest_path: str, have: str, spec: AddSpec, opts: Opts) -> list[str]:
    m = read_manifest(manifest_path)
    check_tomato(m, have)
    if m.kind != 'project':
        what = 'a seed (a package can use only registered seeds, and there is no registry yet)' if m.kind == 'seed' else 'neither a project nor a seed'
        fail(604, m.path, f'seeds are added to a [project], and this file is {what}')
    if spec.kind == 'registry':
        return add_registry(manifest_path, m, have, spec, opts)
    req = SeedReq()
    req.table = 'test' if opts.test else ''
    old = old_lock(m)
    s = Locked()
    value = ''
    if spec.kind == 'path':
        here = spec.path.rstrip('/') if spec.path != '/' else '/'
        folder = here if here.startswith('/') else normpath(getcwd() + '/' + here)
        if not isdir(folder):
            fail(572, m.path, f'{spec.path} is not a folder')
        if not isfile(folder + '/tomato.toml'):
            fail(572, m.path, f'{spec.path} has no tomato.toml: the folder of a seed needs one with a [seed] table')
        sm = read_manifest(folder + '/tomato.toml')
        if sm.kind != 'seed':
            fail(572, folder + '/tomato.toml', 'the folder has no [seed] table, so it is not a seed')
        req.kind = 'path'
        req.name = sm.name
        req.path = here if here.startswith('/') else relpath(folder, m.dir if m.dir != '' else '.')
        s = locked_path_seed(m, req, have)
        value = '{ path = ' + dumps_value(Str(req.path)) + ' }'
    else:
        req.kind = 'git'
        req.url = spec.url
        req.rev = spec.rev
        req.tag = spec.tag
        req.branch = spec.branch
        req.subdir = spec.subdir
        if spec.tag != '' or spec.branch != '':
            # a tag or a branch names the commit the manifest holds (a build never follows it): git is asked once, here
            if opts.offline:
                fail(605, m.path, f'--offline does not run git, and {spec.tag if spec.tag != "" else spec.branch} has to be looked up in {spec.url}: use --rev COMMIT, or run it with the network')
            git_source_problem_ref(m, req)
            req.rev = resolve_follow(m, req)
        s = locked_git_seed(m, req, have, [old], opts)
        req.name = s.name
        value = git_value(req)
    # the question comes before anything is written
    accepted: list[str] = []
    for e in old:
        if e.name == s.name:
            accepted = accepted + e.symbols
    fresh = [x for x in s.symbols if x not in accepted]
    if len(fresh) > 0:
        consent(m, s, fresh, opts)
    where = 'test-seeds' if opts.test else 'seeds'
    original = read_text(manifest_path)
    write_text(manifest_path, add_entry(original, where, s.name, value))
    said: list[str] = []
    done = False
    try:
        check_edit(manifest_path, m, s.name, req.table, req_key(req), f'Add this line to [{where}] yourself: "{s.name}" = {value}')
        said = relock(manifest_path, have, opts, [s], {s.name: s.symbols}, []).said
        done = True
    finally:
        if not done:
            write_text(manifest_path, original)
    said.insert(0, f'added {s.name} {s.version} to [{where}] of {shown_path(manifest_path)}' + (f' (tag {req.tag} is at {req.rev[:12]})' if req.tag != '' else '') + (f' (branch {req.branch} is at {req.rev[:12]})' if req.branch != '' else ''))
    return said

# the seed a word names: the full name, or the short one `import` uses (`sd` for `me/sd`) when only one seed has it; otherwise the error
# lists the names there are
def full_seed_name(m: Manifest, word: str, where: str) -> str:
    names: list[str] = []
    short: list[str] = []
    for r in m.reqs:
        if r.name not in names:
            names.append(r.name)
        if r.name == word:
            return word
        if r.name.split('/')[-1] == word and r.name not in short:
            short.append(r.name)
    if len(short) == 1:
        return short[0]
    if len(short) > 1:
        fail_word(604, f'{word} is the short name of more than one seed ({", ".join(short)}): write the full name')
    here = ', '.join(names) if len(names) > 0 else 'none'
    fail_word(604, f'{word} is not in [seeds] or [test-seeds] of {where} (the seeds there: {here})')
    return word

export def remove(manifest_path: str, have: str, name: str, opts: Opts) -> list[str]:
    m = read_manifest(manifest_path)
    check_tomato(m, have)
    if m.kind != 'project':
        fail(604, m.path, 'seeds are removed from a [project]; this file is not one')
    name = full_seed_name(m, name, 'tomato.toml')
    tables: list[str] = []
    for r in m.reqs:
        if r.name == name:
            tables.append('[seeds]' if r.table == '' else '[test-seeds]')
    original = read_text(manifest_path)
    edited = remove_entries(original, name)
    if edited[1] != len(tables):
        fail(603, m.path, f'tomato.toml has a form this command does not edit (a dotted key, a multi-line value): nothing was changed. Remove the line of "{name}" yourself')
    write_text(manifest_path, edited[0])
    said: list[str] = []
    done = False
    try:
        check_edit(manifest_path, m, name, '*', '', f'Remove the line of "{name}" yourself')
        said = relock(manifest_path, have, opts, [], {}, []).said
        done = True
    finally:
        if not done:
            write_text(manifest_path, original)
    where = ' and '.join(tables)
    said.insert(0, f'removed {name} from {where} of {shown_path(manifest_path)}')
    return said

# ---------------------------------------------------------------------------------------------------------------------
# tomato seed update [NAME...] [--dry-run] (design sections 4 and 12): lock the named seeds (all, with no name) again from where they come
# from. There is no registry, so there are no newer versions to look up; what moves is the commit of a git seed that follows a tag or a branch
# (`tag = "v1"` or `branch = "main"` beside its rev in tomato.toml): git is asked where the tag or branch is now, and when that is another commit
# the rev in tomato.toml is changed to it (the same text edit as `add`) and the seed is fetched, hashed and locked: the new version, commit and
# content hash go into tomato.lock and the lines say what changed. A version bump asks nothing; a foreign symbol the lock does not hold asks
# again, as `add` does (the consent rule, D101a), and one refusal changes nothing. A git seed with no tag or branch is pinned to its commit
# and is left as it is (say so); a path seed is read again, as `install` does. --dry-run does all of it but the writes: tomato.toml and
# tomato.lock stay as they are (a seed that had to be fetched is kept in the store, which is only a cache named by hash).

# the manifest's requirements with the named seeds' revs replaced: what an edit of `update` may leave behind
def moved_keys(m: Manifest, moved: dict[str, str]) -> list[str]:
    out: list[str] = []
    for r in m.reqs:
        if r.name in moved:
            copy = SeedReq()
            copy.table = r.table
            copy.name = r.name
            copy.kind = r.kind
            copy.url = r.url
            copy.rev = moved[r.name]
            copy.tag = r.tag
            copy.branch = r.branch
            copy.subdir = r.subdir
            out.append(req_key(copy))
        else:
            out.append(req_key(r))
    return out

def check_moved(path: str, expected: list[str], by_hand: str):
    after = Manifest()
    try:
        after = read_manifest(path)
    catch ConfigError as e:
        fail(603, path, f'the edit would leave tomato.toml unreadable ({e.message}); it was put back as it was. {by_hand}')
    seeds_for(after, False, True)
    if req_keys(after) != sorted(expected):
        fail(603, path, f'tomato.toml has a form this command does not edit (a dotted key, a multi-line value, a table written another way): it was put back as it was. {by_hand}')

export def update(manifest_path: str, have: str, names: list[str], opts: Opts) -> list[str]:
    m = read_manifest(manifest_path)
    check_tomato(m, have)
    if m.kind != 'project':
        what = 'a seed (a package can use only registered seeds, and there is no registry yet)' if m.kind == 'seed' else 'neither a project nor a seed'
        fail(604, m.path, f'seeds are updated in a [project], and this file is {what}')
    wanted = seeds_for(m, False, True)
    names = [full_seed_name(m, n, 'tomato.toml') for n in names]
    if len(wanted.reqs) == 0:
        return ['the manifest lists no seeds: nothing to update']
    selected: list[str] = []
    moved: dict[str, str] = {}
    for r in wanted.reqs:
        if len(names) > 0 and r.name not in names:
            continue
        selected.append(r.name)
        if r.kind == 'version':
            fail(571, m.path, f'the seed {r.name} {r.version} comes from a registry, and tomato seed update does not raise registry seeds yet; add a newer version by hand: tomato seed add {r.name}@VERSION')
        if r.kind != 'git':
            continue
        if r.tag == '' and r.branch == '':
            print(f'{r.name}: pinned to the commit {r.rev[:12]}, with no tag or branch to follow (add tag = "..." or branch = "..." to its line in tomato.toml, or: tomato seed add --git {r.url} --rev NEWCOMMIT)')
            continue
        if opts.offline:
            fail(605, m.path, f'--offline does not run git, and the tag or branch of {r.name} has to be looked up in {r.url}')
        git_source_problem(m, r)
        commit = resolve_follow(m, r)
        follows = f'tag {r.tag}' if r.tag != '' else f'branch {r.branch}'
        if commit == r.rev:
            print(f'{r.name}: {follows} is still at {r.rev[:12]}')
        else:
            print(f'{r.name}: {follows} is now at {commit[:12]} (was {r.rev[:12]})')
            moved[r.name] = commit
    original = read_text(manifest_path)
    lock_before = ''
    if isfile(lock_path(m)):
        lock_before = read_text(lock_path(m))
    said: list[str] = []
    done = False
    try:
        if len(moved) > 0:
            text = original
            for r in m.reqs:
                if r.name in moved:
                    copy = SeedReq()
                    copy.url = r.url
                    copy.rev = moved[r.name]
                    copy.tag = r.tag
                    copy.branch = r.branch
                    copy.subdir = r.subdir
                    text = add_entry(text, 'test-seeds' if r.table == 'test' else 'seeds', r.name, git_value(copy))
            write_text(manifest_path, text)
            check_moved(manifest_path, moved_keys(m, moved), 'Change the rev of ' + ', '.join(sorted(moved.keys())) + ' yourself')
        got = relock(manifest_path, have, opts, [], {}, selected)
        said = [got.said[len(got.said) - 1]]
        if not opts.dry_run and isfile(lock_path(m)) and read_text(lock_path(m)) == lock_before:
            said = ['tomato.lock is already up to date']
        done = True
    finally:
        if (opts.dry_run or not done) and len(moved) > 0:
            write_text(manifest_path, original)
    if opts.dry_run and len(moved) > 0:
        said.append('the seeds above would move; run without --dry-run to do it')
    return said

# ---------------------------------------------------------------------------------------------------------------------
# tomato seed vendor: the locked seeds (the lock must be current: the check of `install --locked`) copied into the vendor folder of
# [seed-store] vendor (`vendor` when it is not set), one folder for each seed, OWNER/NAME, holding exactly the files the content hash
# covers. A folder of an earlier copy is replaced; one of a seed that is no longer in the lock is left where it is.

def copy_seed(folder: str, dest: str):
    files: list[str] = []
    collect(folder, '', files)
    makedirs(dest, True)
    for rel in sorted(files):
        out = dest + '/' + rel
        makedirs(dirname(out), True)
        write_bytes(out, read_bytes(folder + '/' + rel))
        if (stat(folder + '/' + rel).mode & 64) != 0:
            run(['chmod', '755', out], check=True)

export def vendor(manifest_path: str, have: str, opts: Opts) -> list[str]:
    m = read_manifest(manifest_path)
    check_tomato(m, have)
    root = vendor_root(m)
    if root == '':
        root = m.dir + 'vendor'
    if exists(root) and not isdir(root):
        fail(604, m.path, f'the vendor folder {root} is a file, not a folder: move it away or set [seed-store] vendor to another folder')
    opts.locked = True
    got = relock(manifest_path, have, opts, [], {}, [])
    said: list[str] = []
    for s in got.seeds:
        source = store_dir(s.hash) if s.source == 'git' or s.source == 'registry' else seed_folder(m, s.path)
        dest = root + '/' + s.name
        tmp = dest + '.new'
        remove_tree(tmp)
        copy_seed(source, tmp)
        actual = seed_hash(tmp)
        if actual != s.hash:
            remove_tree(tmp)
            fail(601, m.path, f'the copy of {s.name} has the content hash {actual}, not the {s.hash} of tomato.lock: nothing was vendored for it')
        remove_tree(dest)
        rename(tmp, dest)
        said.append(f'vendored {s.name} {s.version} into {dest}')
    if len(got.seeds) == 0:
        said.append('the lock holds no seeds: nothing to vendor')
    elif m.vendor == '':
        said.append('builds use the vendor folder once tomato.toml says so: add  [seed-store]  vendor = "vendor"')
    return said

# ---------------------------------------------------------------------------------------------------------------------
# tomato seed verify (design sections 6 and 12): every copy of every locked seed is hashed again (seed hash v1) and compared with
# tomato.lock: a git seed's folder in the store, the vendor folder's copy when [seed-store] vendor is set, and the folder of a path seed
# (a working folder that a build does not check; here it is, so a lock that went out of date after an edit shows). One line for each copy;
# a missing copy, a content hash that is not the lock's, or a module the lock lists that the copy lacks, is a problem, and any problem ends
# the command with an error (exit status 1) after all the lines. Nothing is fetched and nothing is written.

# '' when the folder is a copy of the seed as the lock holds it, else what is wrong with it
def copy_problem(s: Locked, folder: str) -> str:
    actual = ''
    try:
        actual = seed_hash(folder)
    catch ConfigError as e:
        return e.message
    if actual != s.hash:
        return f'has the content hash {actual}, but tomato.lock says {s.hash}'
    for mod in s.modules:
        if not isfile(f'{folder}/src/{mod}.tom'):
            return f'has no src/{mod}.tom, which tomato.lock lists as a module of the seed'
    return ''

export def verify(manifest_path: str, have: str) -> list[str]:
    m = read_manifest(manifest_path)
    check_tomato(m, have)
    path = lock_path(m)
    if not isfile(path):
        wanted = seeds_for(m, False, True)
        if len(wanted.reqs) == 0:
            return ['there is no tomato.lock and the manifest lists no seeds: nothing to verify']
        fail(569, m.path, f'the manifest lists seeds, but there is no tomato.lock beside it\n  = help: run: tomato seed install')
    lock = read_lock(path)
    if len(lock) == 0:
        return ['tomato.lock holds no seeds: nothing to verify']
    problems = 0
    copies = 0
    for s in lock:
        label = f'{s.name} {s.version}'
        if s.source != 'git' and s.source != 'path' and s.source != 'registry':
            print(f'PROBLEM  {label}: it comes from a {s.source}, which this version cannot check')
            problems += 1
            continue
        vfolder = vendor_folder(m, s.name)
        places: list[str] = []         # `kind TAB folder`
        if s.source == 'git' or s.source == 'registry':
            try:
                places.append('store\t' + store_dir(s.hash))
            catch ConfigError as e:
                print(f'PROBLEM  {label}: {e.message}')
                problems += 1
        else:
            places.append('path\t' + seed_folder(m, s.path))
        if vfolder != '':
            places.append('vendor\t' + vfolder)
        for place in places:
            parts = place.split('\t')
            kind = parts[0]
            folder = parts[1]
            if not isdir(folder):
                if kind == 'path' and vfolder != '':
                    print(f'skipped  {label}: the folder {folder} is not here, and the build uses the vendor copy')
                    continue
                fix = 'tomato seed vendor' if kind == 'vendor' else 'tomato seed install'
                if kind == 'path':
                    print(f'MISSING  {label}: the {kind} folder {folder} is not there')
                else:
                    print(f'MISSING  {label}: the {kind} copy {folder} is not there (run: {fix})')
                problems += 1
                continue
            copies += 1
            why = copy_problem(s, folder)
            if why == '':
                print(f'ok       {label}  {kind}: {folder}')
            else:
                fix = ''
                if kind == 'vendor':
                    fix = '; run: tomato seed vendor'
                elif kind == 'store':
                    fix = '; run: tomato seed install (it fetches the seed again and replaces the damaged copy)'
                else:
                    fix = '; the folder was edited after it was locked: run: tomato seed install'
                print(f'CHANGED  {label}: the {kind} copy {folder} {why}{fix}')
                problems += 1
    if problems > 0:
        raise ConfigError(606, f'{path}: verify found {problems} problem' + ('' if problems == 1 else 's') + f' in {len(lock)} locked seeds ({copies} copies checked)')
    return [f'verified {copies} cop' + ('y' if copies == 1 else 'ies') + f' of {len(lock)} locked seed' + ('' if len(lock) == 1 else 's') + ': all match tomato.lock']

# ---------------------------------------------------------------------------------------------------------------------
# tomato seed check and tomato seed hash

# is the owner of a seed name one a registry would accept: a domain name (a dot in it), a handle (a short name with no dot, D117a: the
# registry grants it, so only its shape is checked here) or k- and a key hash?
def publishable_owner(name: str) -> bool:
    owner = name.split('/')[0]
    if '.' in owner:
        return True
    if owner.startswith('k-') and len(owner) == 28:
        return True
    return handle_problem(owner) == ''

# the entry markers (`x.y` of `@x.y`) written in the .tom files of a seed's src/ and tests/ folders
def folder_markers(folder: str) -> list[str]:
    out: list[str] = []
    for sub in ['src', 'tests']:
        if not isdir(folder + '/' + sub):
            continue
        for f in sorted(listdir(folder + '/' + sub)):
            if f.endswith('.tom') and isfile(f'{folder}/{sub}/{f}'):
                out += entry_markers_of(read_text(f'{folder}/{sub}/{f}'))
    return out

# does a [build.TABLE] name an entry: a marker equal to it, or below it (the table applies to `x` when it is `x` or a prefix of it)
def names_an_entry(table: str, markers: list[str]) -> bool:
    for mk in markers:
        if mk == table or mk.startswith(table + '.'):
            return True
    return False

# the warnings for the [build.ENTRY] tables of a manifest that name no entry (no function of src/ or tests/, or of the program being built
# (`extra`: its entry markers), is marked with them): a typo
export def build_table_warnings(m: Manifest, folder: str, extra: list[str] = []) -> list[str]:
    out: list[str] = []
    markers: list[str] = []
    looked = False
    for b in m.builds:
        if b.table == '' or (b.mode == '' and b.output == ''):
            continue          # (a table with no setting is the parent of a dotted one, [build.grp] for [build.grp.one]: nothing to be unused)
        if not looked:
            markers = folder_markers(folder) + extra
            looked = True
        if not names_an_entry(b.table, markers):
            out.append(f'warning: [build.{b.table}] names no entry: no function in src/ or tests/ is marked @{b.table} (or @{b.table}.something), so the table is never used (a typo?)')
    return out

export def check_seed(manifest_path: str, have: str) -> list[str]:
    m = read_manifest(manifest_path)
    if m.kind != 'seed':
        fail(572, manifest_path, 'this is not a seed: it has no [seed] table (a [project] is a program that uses seeds)')
    check_tomato(m, have)
    folder = m.dir[:len(m.dir) - 1] if m.dir != '' else '.'
    mods = seed_modules(m, folder)
    said: list[str] = []
    owner = m.name.split('/')[0]
    if not publishable_owner(m.name):
        why = f' ({handle_problem(owner)})' if '.' not in owner else ''
        fail(580, manifest_path, f'the owner "{owner}" is not one a registry accepts: it is a domain name with a dot (acme.example), a handle (a short name with no dot, 2 to 32 characters) or k- and a key hash{why}')
    said.append(f'{m.name} {m.version}: ok')
    if '.' not in owner and not owner.startswith('k-'):
        said.append(f'note: the owner {owner} is a handle: a registry has to grant it (a reviewed pull request), and there is no registry yet, so the seed is used from its git URL')
    said.append(f"modules: {', '.join(mods)}")
    if m.description == '':
        said.append('note: seed.description is not set')
    if m.license == '':
        said.append('note: seed.license is not set')
    if m.description.startswith('TODO:'):
        said.append('warning: seed.description is still the placeholder `tomato init --seed` wrote: say what the seed is for')
    if m.license.startswith('TODO:'):
        said.append('warning: seed.license is still the placeholder `tomato init --seed` wrote: name a license such as MIT')
    if m.name.split('/')[0] == 'yourdomain.example':
        said.append('warning: the owner yourdomain.example is the placeholder `tomato init --seed` wrote: use a domain you own')
    for w in build_table_warnings(m, folder):
        said.append(w)
    said.append(seed_hash(folder))
    return said
