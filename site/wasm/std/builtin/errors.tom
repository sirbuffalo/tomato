# The error classes: Error and the failures the language and the standard library raise. Part of the built-ins
# (std/builtin/, D22a): every Tomato file can use these names without importing them.

# The runtime reads these two fields in this order (print_uncaught in runtime/tomato_rt.c).
class Error:
    message: str = ''
    # the id of the kind of failure, such as "E04" (the line of std/errors.txt); "" for an error a program makes up
    # itself
    id: str = ''

    @init
    def start(self, message: str, id: str = ""):
        self.message = message
        self.id = id

# Failures the language itself raises: division by zero, an index out of range, a missing key, bad text for int().
class RuntimeError(Error):
    @init
    def make(self, message: str, id: str = ""):
        Error.start(self, message, id)

# A list, text or range index (or a slice) that is out of range, and pop() from an empty list.
class IndexError(RuntimeError):
    @init
    def make_index(self, message: str, id: str = ""):
        RuntimeError.make(self, message, id)

# A key that a dict, set or table does not hold.
class KeyError(RuntimeError):
    @init
    def make_key(self, message: str, id: str = ""):
        RuntimeError.make(self, message, id)

# A value of the right type that the operation cannot use: int("abc"), chr(-1), a step of 0, sqrt(-1).
class ValueError(RuntimeError):
    @init
    def make_value(self, message: str, id: str = ""):
        RuntimeError.make(self, message, id)

# /, // or % by zero.
class ZeroDivisionError(RuntimeError):
    @init
    def make_zero(self, message: str, id: str = ""):
        RuntimeError.make(self, message, id)

# A number too big for its type, or a float result that is infinite.
class OverflowError(RuntimeError):
    @init
    def make_overflow(self, message: str, id: str = ""):
        RuntimeError.make(self, message, id)

class IOError(RuntimeError):
    @init
    def make_io(self, message: str, id: str = ""):
        RuntimeError.make(self, message, id)

# Raised by input() when there is no more input to read.
class EOFError(RuntimeError):
    @init
    def make_eof(self, message: str, id: str = ""):
        RuntimeError.make(self, message, id)

# Raised inside a task that was cancelled with t.cancel() (at its next wait), and by await on that task.
class CancelledError(RuntimeError):
    @init
    def make_cancelled(self, message: str, id: str = ""):
        RuntimeError.make(self, message, id)
