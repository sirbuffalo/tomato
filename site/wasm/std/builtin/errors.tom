# The error classes: Error and the failures the language and the standard library raise. Part of the built-ins
# (std/builtin/, D22a): every Tomato file can use these names without importing them.

# A class that extends Error and declares no fields of its own inherits the @init of its parent, so `class NotFound(Error): pass`
# is made with NotFound(), NotFound(message) or NotFound(message, id) (D93b).
# The runtime reads these two fields in this order (print_uncaught in runtime/tomato_rt.c).
class Error:
    message: str = ''
    # the id of the kind of failure, such as "E04" (the line of std/errors.txt); "" for an error a program makes up
    # itself
    id: str = ''

    @init
    def start(self, message: str = "", id: str = ""):
        self.message = message
        self.id = id

    # str(e), print(e) and f'{e}' give the message alone, as in Python; an uncaught error is printed with its class name
    # in front (print_uncaught). Every error class inherits this, so an error class can give its own @str instead.
    @str
    def message_text(self) -> str:
        return self.message

# A failed `assert` statement or testing assertion (Wave 2, pack B). A direct subclass of Error, so `catch RuntimeError` does not
# catch it: a failed check is a mistake in the program or its tests, not a failure of an operation.
class AssertionError(Error):
    pass

# Failures the language itself raises: division by zero, an index out of range, a missing key, bad text for int().
class RuntimeError(Error):
    @init
    def make(self, message: str = "", id: str = ""):
        Error.start(self, message, id)

# A list, text or range index (or a slice) that is out of range, and pop() from an empty list.
class IndexError(RuntimeError):
    pass

# A key that a dict, set or table does not hold.
class KeyError(RuntimeError):
    pass

# A value of the right type that the operation cannot use: int("abc"), chr(-1), a step of 0, sqrt(-1).
class ValueError(RuntimeError):
    @init
    def make_value(self, message: str = "", id: str = ""):
        RuntimeError.make(self, message, id)

# /, // or % by zero.
class ZeroDivisionError(RuntimeError):
    pass

# A number too big for its type, or a float result that is infinite.
class OverflowError(RuntimeError):
    pass

# Everything that fails because of the world outside the program: files, the network, the terminal, a program that cannot be started.
class IOError(RuntimeError):
    @init
    def make_io(self, message: str = "", id: str = ""):
        RuntimeError.make(self, message, id)

# One tree for the failures every library shares (D114a): a wait that ran out of time, and a connection that failed. The libraries
# that can raise them define subclasses of their own (asyncio.TimeoutError, requests.TimeoutError, requests.ConnectionError, the
# socket errors), so `catch TimeoutError` or `catch ConnectionError` handles the failure whichever library it came from.
class TimeoutError(IOError):
    pass

class ConnectionError(IOError):
    pass

# The file and directory failures that say why (os, ospath and open() raise them; each is an IOError, so catch IOError still
# catches them): the path is not there, is already there, may not be used, is a directory, or goes through something that is not one.
class FileNotFoundError(IOError):
    pass

class FileExistsError(IOError):
    pass

class PermissionError(IOError):
    pass

class IsADirectoryError(IOError):
    pass

class NotADirectoryError(IOError):
    pass

# Raised by input() when there is no more input to read.
class EOFError(RuntimeError):
    pass

# Raised inside a task that was cancelled with t.cancel() (at its next wait), and by await on that task.
class CancelledError(RuntimeError):
    pass
