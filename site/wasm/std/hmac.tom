# HMAC (RFC 2104). Keys, messages and digests are `bytes`:
#
#     print(hmac.hexdigest(b'key', b'message', 'sha256'))
#
# compare_digest avoids position-dependent early exits, but Tomato does not guarantee constant time.
import hashlib

export class HMAC:
    inner: hashlib.Hash = hashlib.sha256()
    outer: hashlib.Hash = hashlib.sha256()
    @init
    def make(self, key: bytes, digestmod: str):
        h = hashlib.new(digestmod)
        k = key
        if len(k) > 64:
            h.update(k)
            k = h.digest()
        k = k + bytes(64 - len(k))
        ipad: list[int] = []
        opad: list[int] = []
        for b in k:
            ipad.append(b ^ 54)
            opad.append(b ^ 92)
        self.inner = hashlib.new(digestmod, bytes(ipad))
        self.outer = hashlib.new(digestmod, bytes(opad))

    def update(self, data: bytes):
        self.inner.update(data)

    def digest(self) -> bytes:
        h = self.outer.copy()
        h.update(self.inner.digest())
        return h.digest()

    def hexdigest(self) -> str:
        return self.digest().hex()

    def copy(self) -> HMAC:
        h = HMAC(b'', self.inner.name)
        h.inner = self.inner.copy()
        h.outer = self.outer.copy()
        return h

export def digest(key: bytes, msg: bytes, digestmod: str) -> bytes:
    h = HMAC(key, digestmod)
    h.update(msg)
    return h.digest()

export def hexdigest(key: bytes, msg: bytes, digestmod: str) -> str:
    h = HMAC(key, digestmod)
    h.update(msg)
    return h.hexdigest()

export def compare_digest(a: bytes, b: bytes) -> bool:
    diff = len(a) ^ len(b)
    for i in range(min(len(a), len(b))):
        diff = diff | (a[i] ^ b[i])
    return diff == 0
