# Names every Tomato file can use without importing them (D22a).

class Error:
    message: str

    @init
    def start(self, message: str):
        self.message = message

# Failures the language itself raises: division by zero, an index out of range, a missing key, bad text for int().
class RuntimeError(Error):
    @init
    def make(self, message: str):
        Error.start(self, message)

class IOError(RuntimeError):
    @init
    def make_io(self, message: str):
        RuntimeError.make(self, message)

# Raised by input() when there is no more input to read.
class EOFError(RuntimeError):
    @init
    def make_eof(self, message: str):
        RuntimeError.make(self, message)

# Raised inside a task that was cancelled with t.cancel() (at its next wait), and by await on that task.
class CancelledError(RuntimeError):
    @init
    def make_cancelled(self, message: str):
        RuntimeError.make(self, message)

# range(stop), range(start, stop) and range(start, stop, step) are a value of their own. It keeps only the three numbers, so it
# takes the same small amount of memory however long it is, and prints as range(0, 100, 1). It is a sequence of ints: `for`,
# len(), indexing (negative too), slicing (gives another range), `in`, ==, reversed(), sorted(), sum(), min(), max() and
# list() all work, each through the method marked for it. `for i in range(n)`, `range(a, b)` and `range(a, b, step)` are counted by the compiler
# directly; everything else about range is written here, in Tomato.
class range:
    start: int
    stop: int
    step: int

    @init
    def make(self, start: int, stop: int, step: int):
        if step == 0:
            raise RuntimeError('range step cannot be zero')
        self.start = start
        self.stop = stop
        self.step = step

    @str
    def text(self) -> str:
        return f'range({self.start}, {self.stop}, {self.step})'

    @iter
    def numbers(self) -> int:
        i = self.start
        if self.step > 0:
            while i < self.stop:
                yield i
                i += self.step
        else:
            while i > self.stop:
                yield i
                i += self.step

    @len
    def count(self) -> int:
        if self.step > 0:
            if self.stop <= self.start:
                return 0
            return (self.stop - self.start - 1) // self.step + 1
        if self.start <= self.stop:
            return 0
        return (self.start - self.stop - 1) // -self.step + 1

    @get
    def at(self, i: int) -> int:
        n = self.count()
        if i < 0:
            i += n
        if i < 0 or i >= n:
            raise RuntimeError('index out of range')
        return self.start + i * self.step

    @contains
    def has(self, x: int) -> bool:
        if self.step > 0:
            return x >= self.start and x < self.stop and (x - self.start) % self.step == 0
        return x <= self.start and x > self.stop and (self.start - x) % -self.step == 0

    # flags: 1 = a start was written, 2 = an end was written, 4 = a step was written (as for list slices)
    @slice
    def part(self, lo: int, hi: int, st: int, flags: int) -> range:
        n = self.count()
        k = 1
        if flags & 4 != 0:
            k = st
        if k == 0:
            raise RuntimeError('slice step cannot be zero')
        # a forward slice runs over positions 0..n, a backward one over -1..n-1 (so it can stop before position 0)
        low = 0
        high = n
        a = 0
        b = n
        if k < 0:
            low = -1
            high = n - 1
            a = n - 1
            b = -1
        if flags & 1 != 0:
            a = _slice_bound(lo, n, low, high)
        if flags & 2 != 0:
            b = _slice_bound(hi, n, low, high)
        return range(self.start + a * self.step, self.start + b * self.step, self.step * k)

    @reversed
    def backwards(self) -> range:
        n = self.count()
        return range(self.start + (n - 1) * self.step, self.start - self.step, -self.step)

    # two ranges are equal when they hold the same numbers, so range(0) == range(5, 5)
    @eq
    def same(self, other: range) -> bool:
        n = self.count()
        if n != other.count():
            return False
        if n == 0:
            return True
        if self.start != other.start:
            return False
        return n == 1 or self.step == other.step

# A written slice bound as a position in a sequence of n items: negative counts from the end, then it is kept in low..high.
def _slice_bound(i: int, n: int, low: int, high: int) -> int:
    if i < 0:
        i += n
    if i < low:
        return low
    if i > high:
        return high
    return i

def _range1(stop: int) -> range:
    return range(0, stop, 1)

def _range2(start: int, stop: int) -> range:
    return range(start, stop, 1)

# The text of a string inside a printed list, dict or set, quoted the way Python shows it: 'abc'.
def _quote(s: str) -> str:
    q = "'"
    if s.find("'") >= 0 and s.find('"') < 0:
        q = '"'
    t = s.replace('\\', '\\\\')
    if q == "'":
        t = t.replace("'", "\\'")
    t = t.replace('\n', '\\n')
    t = t.replace('\t', '\\t')
    t = t.replace('\r', '\\r')
    return q + t + q

# abs(x) for an int and for a float
def _abs_int(x: int) -> int:
    if x < 0:
        return -x
    return x

def _abs_float(x: float) -> float:
    if x < 0.0:
        return 0.0 - x       # 0.0 - x, so that abs(-0.0) is 0.0 and not -0.0
    if x == 0.0:
        return 0.0
    return x

# str.isdigit(), isalpha(), isspace(): True when the text is not empty and every character is of that kind (ASCII
# characters only, like upper() and lower()).
def _str_isdigit(s: str) -> bool:
    return _all_in(s, '0123456789')

def _str_isalpha(s: str) -> bool:
    return _all_in(s, 'abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ')

def _str_isspace(s: str) -> bool:
    return _all_in(s, ' \t\n\r')

# True when s is not empty and every character of it is one of chars
def _all_in(s: str, chars: str) -> bool:
    if len(s) == 0:
        return False
    for c in s:
        if c not in chars:
            return False
    return True

# whitespace is a space, tab, newline or carriage return
def _is_space(c: str) -> bool:
    return c in ' \t\n\r'

def _str_lstrip(s: str) -> str:
    i = 0
    while i < len(s) and _is_space(s[i]):
        i += 1
    return s[i:]

def _str_rstrip(s: str) -> str:
    n = len(s)
    while n > 0 and _is_space(s[n - 1]):
        n -= 1
    return s[:n]

# sorted(xs, key=f), sorted(xs, cmp=f), map(f, xs) and filter(f, xs) are these, written in Tomato (so they run the same natively and in
# the browser). The sorts are stable: a merge sort that finds the runs already in order (a strictly descending run is reversed), extends
# short runs to a minimum length with binary insertion, and merges neighbouring runs; neighbours already in order are not merged.
# The key version works out the keys here (each once) and the runtime (tomato_list_sorted_by) sorts them and gathers the items; the
# cmp version sorts a copy of the items here, since it must call the function on pairs.
def _min_run(n: int) -> int:
    minrun = n
    extra = 0
    while minrun >= 64:
        if minrun % 2 == 1:
            extra = 1
        minrun = minrun // 2
    return minrun + extra

def _sorted_cmp[T](xs: list[T], cmp: fn(T, T) -> int) -> list[T]:
    n = len(xs)
    a = xs[0:n]
    if n < 2:
        return a
    minrun = _min_run(n)
    starts: list[int] = []
    lo = 0
    while lo < n:
        hi = lo + 1
        if hi < n:
            if cmp(a[hi], a[lo]) < 0:
                hi += 1
                while hi < n and cmp(a[hi], a[hi - 1]) < 0:
                    hi += 1
                i = lo
                j = hi - 1
                while i < j:
                    t = a[i]
                    a[i] = a[j]
                    a[j] = t
                    i += 1
                    j -= 1
            else:
                hi += 1
                while hi < n and not (cmp(a[hi], a[hi - 1]) < 0):
                    hi += 1
        end = lo + minrun
        if end > n:
            end = n
        p = hi
        while p < end:
            v = a[p]
            left = lo
            right = p
            while left < right:
                mid = (left + right) // 2
                if cmp(v, a[mid]) < 0:
                    right = mid
                else:
                    left = mid + 1
            q = p
            while q > left:
                a[q] = a[q - 1]
                q -= 1
            a[left] = v
            p += 1
        if hi < end:
            hi = end
        starts.append(lo)
        lo = hi
    starts.append(n)
    b = a[0:n]
    while len(starts) > 2:
        next_starts: list[int] = []
        runs = len(starts) - 1
        k = 0
        while k < runs:
            s = starts[k]
            if k + 1 < runs:
                mid = starts[k + 1]
                e = starts[k + 2]
                i = s
                j = mid
                o = s
                if cmp(a[mid], a[mid - 1]) < 0:
                    while i < mid and j < e:
                        if cmp(a[j], a[i]) < 0:
                            b[o] = a[j]
                            j += 1
                        else:
                            b[o] = a[i]
                            i += 1
                        o += 1
                while i < mid:
                    b[o] = a[i]
                    i += 1
                    o += 1
                while j < e:
                    b[o] = a[j]
                    j += 1
                    o += 1
                k += 2
            else:
                for o in range(s, starts[k + 1]):
                    b[o] = a[o]
                k += 1
            next_starts.append(s)
        next_starts.append(n)
        starts = next_starts
        t2 = a
        a = b
        b = t2
    return a

def _keys[T, K](xs: list[T], key: fn(T) -> K) -> list[K]:
    keys: list[K] = []
    for x in xs:
        keys.append(key(x))
    return keys

def _map[T, R](f: fn(T) -> R, xs: list[T]) -> list[R]:
    out: list[R] = []
    for x in xs:
        out.append(f(x))
    return out

def _filter[T](f: fn(T) -> bool, xs: list[T]) -> list[T]:
    out: list[T] = []
    for x in xs:
        if f(x):
            out.append(x)
    return out
