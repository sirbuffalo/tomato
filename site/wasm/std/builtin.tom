# Names every Tomato file can use without importing them (D22a).

# The runtime reads these two fields in this order (print_uncaught in runtime/tomato_rt.c).
class Error:
    message: str = ''
    # the id of the kind of failure, such as "E04" (the line of std/errors.txt); "" for an error a program makes up
    # itself
    id: str = ''

    @init
    def start(self, message: str, id: str = ""):
        self.message = message
        self.id = id

# Failures the language itself raises: division by zero, an index out of range, a missing key, bad text for int().
class RuntimeError(Error):
    @init
    def make(self, message: str, id: str = ""):
        Error.start(self, message, id)

# A list, text or range index (or a slice) that is out of range, and pop() from an empty list.
class IndexError(RuntimeError):
    @init
    def make_index(self, message: str, id: str = ""):
        RuntimeError.make(self, message, id)

# A key that a dict, set or table does not hold.
class KeyError(RuntimeError):
    @init
    def make_key(self, message: str, id: str = ""):
        RuntimeError.make(self, message, id)

# A value of the right type that the operation cannot use: int("abc"), chr(-1), a step of 0, sqrt(-1).
class ValueError(RuntimeError):
    @init
    def make_value(self, message: str, id: str = ""):
        RuntimeError.make(self, message, id)

# /, // or % by zero.
class ZeroDivisionError(RuntimeError):
    @init
    def make_zero(self, message: str, id: str = ""):
        RuntimeError.make(self, message, id)

# A number too big for its type, or a float result that is infinite.
class OverflowError(RuntimeError):
    @init
    def make_overflow(self, message: str, id: str = ""):
        RuntimeError.make(self, message, id)

class IOError(RuntimeError):
    @init
    def make_io(self, message: str, id: str = ""):
        RuntimeError.make(self, message, id)

# Raised by input() when there is no more input to read.
class EOFError(RuntimeError):
    @init
    def make_eof(self, message: str, id: str = ""):
        RuntimeError.make(self, message, id)

# Raised inside a task that was cancelled with t.cancel() (at its next wait), and by await on that task.
class CancelledError(RuntimeError):
    @init
    def make_cancelled(self, message: str, id: str = ""):
        RuntimeError.make(self, message, id)

# range(stop), range(start, stop) and range(start, stop, step) are a value of their own. It keeps only the three
# numbers, so it takes the same small amount of memory however long it is, and prints as range(0, 100, 1). It is a
# sequence of ints: `for`, len(), indexing (negative too), slicing (gives another range), `in`, ==, reversed(),
# sorted(), sum(), min(), max() and list() all work, each through the method marked for it. `for i in range(n)`,
# `range(a, b)` and `range(a, b, step)` are counted by the compiler directly; everything else about range is written
# here, in Tomato.
class range:
    start: int
    stop: int
    step: int

    @init
    def make(self, start: int, stop: int, step: int):
        if step == 0:
            raise ValueError('range step cannot be zero', 'E23')
        self.start = start
        self.stop = stop
        self.step = step

    @str
    def text(self) -> str:
        return f'range({self.start}, {self.stop}, {self.step})'

    @iter
    def numbers(self) -> int:
        i = self.start
        if self.step > 0:
            while i < self.stop:
                yield i
                i += self.step
        else:
            while i > self.stop:
                yield i
                i += self.step

    @len
    def count(self) -> int:
        if self.step > 0:
            if self.stop <= self.start:
                return 0
            return (self.stop - self.start - 1) // self.step + 1
        if self.start <= self.stop:
            return 0
        return (self.start - self.stop - 1) // -self.step + 1

    @get
    def at(self, i: int) -> int:
        n = self.count()
        if i < 0:
            i += n
        if i < 0 or i >= n:
            raise IndexError('index out of range', 'E04')
        return self.start + i * self.step

    @contains
    def has(self, x: int) -> bool:
        if self.step > 0:
            return x >= self.start and x < self.stop and (x - self.start) % self.step == 0
        return x <= self.start and x > self.stop and (self.start - x) % -self.step == 0

    # flags: 1 = a start was written, 2 = an end was written, 4 = a step was written (as for list slices)
    @slice
    def part(self, lo: int, hi: int, st: int, flags: int) -> range:
        n = self.count()
        k = 1
        if flags & 4 != 0:
            k = st
        if k == 0:
            raise ValueError('slice step cannot be zero', 'E24')
        # a forward slice runs over positions 0..n, a backward one over -1..n-1 (so it can stop before position 0)
        low = 0
        high = n
        a = 0
        b = n
        if k < 0:
            low = -1
            high = n - 1
            a = n - 1
            b = -1
        if flags & 1 != 0:
            a = _slice_bound(lo, n, low, high)
        if flags & 2 != 0:
            b = _slice_bound(hi, n, low, high)
        return range(self.start + a * self.step, self.start + b * self.step, self.step * k)

    @reversed
    def backwards(self) -> range:
        n = self.count()
        return range(self.start + (n - 1) * self.step, self.start - self.step, -self.step)

    # two ranges are equal when they hold the same numbers, so range(0) == range(5, 5)
    @eq
    def same(self, other: range) -> bool:
        n = self.count()
        if n != other.count():
            return False
        if n == 0:
            return True
        if self.start != other.start:
            return False
        return n == 1 or self.step == other.step

# A written slice bound as a position in a sequence of n items: negative counts from the end, then it is kept in
# low..high.
def _slice_bound(i: int, n: int, low: int, high: int) -> int:
    if i < 0:
        i += n
    if i < low:
        return low
    if i > high:
        return high
    return i

def _range1(stop: int) -> range:
    return range(0, stop, 1)

def _range2(start: int, stop: int) -> range:
    return range(start, stop, 1)

# The text of a string inside a printed list, dict or set, quoted the way Python shows it: 'abc'.
def _quote(s: str) -> str:
    q = '"' if "'" in s and '"' not in s else "'"
    t = s.replace('\\', '\\\\')
    if q == "'":
        t = t.replace("'", "\\'")
    t = t.replace('\n', '\\n')
    t = t.replace('\t', '\\t')
    t = t.replace('\r', '\\r')
    return q + t + q

# abs(x) for an int and for a float
def _abs_int(x: int) -> int:
    if x < 0:
        return -x
    return x

def _abs_float(x: float) -> float:
    if x < 0.0:
        return 0.0 - x       # 0.0 - x, so that abs(-0.0) is 0.0 and not -0.0
    if x == 0.0:
        return 0.0
    return x

# str.isspace(): True when the text is not empty and every character is a space, tab, newline or carriage return (isalpha()
# and isdigit() know all of Unicode and are in the runtime)
def _str_isspace(s: str) -> bool:
    return _all_in(s, ' \t\n\r')

# True when s is not empty and every character of it is one of chars
def _all_in(s: str, chars: str) -> bool:
    if s == '':
        return False
    for c in s:
        if c not in chars:
            return False
    return True

# s.lstrip() and s.rstrip(): whitespace is a space, tab, newline or carriage return
def _str_lstrip(s: str) -> str:
    return _str_lstrip_chars(s, ' \t\n\r')

def _str_rstrip(s: str) -> str:
    return _str_rstrip_chars(s, ' \t\n\r')

# sorted(xs, key=f), sorted(xs, cmp=f), map(f, xs) and filter(f, xs) are these, written in Tomato (so they run the same
# natively and in the browser). The sorts are stable: a merge sort that finds the runs already in order (a strictly
# descending run is reversed), extends short runs to a minimum length with binary insertion, and merges neighbouring
# runs; neighbours already in order are not merged. The key version works out the keys here (each once) and the runtime
# (tomato_list_sorted_by) sorts them and gathers the items; the cmp version sorts a copy of the items here, since it
# must call the function on pairs. Native builds do not use it for items that are ints or pointers: the compiler calls
# tomato_list_sorted_cmp (runtime/tomato_rt.c, the same algorithm in C). This one runs in the browser and for float,
# bool and fixed-width items.
def _min_run(n: int) -> int:
    minrun = n
    extra = 0
    while minrun >= 64:
        if minrun % 2 == 1:
            extra = 1
        minrun = minrun // 2
    return minrun + extra

def _sorted_cmp[T](xs: list[T], cmp: fn(T, T) -> int) -> list[T]:
    n = len(xs)
    a = xs[0:n]
    if n < 2:
        return a
    minrun = _min_run(n)
    starts: list[int] = []
    lo = 0
    while lo < n:
        hi = lo + 1
        if hi < n:
            if cmp(a[hi], a[lo]) < 0:
                hi += 1
                while hi < n and cmp(a[hi], a[hi - 1]) < 0:
                    hi += 1
                i = lo
                j = hi - 1
                while i < j:
                    a[i], a[j] = a[j], a[i]
                    i += 1
                    j -= 1
            else:
                hi += 1
                while hi < n and not (cmp(a[hi], a[hi - 1]) < 0):
                    hi += 1
        end = lo + minrun
        if end > n:
            end = n
        p = hi
        while p < end:
            v = a[p]
            left = lo
            right = p
            while left < right:
                mid = (left + right) // 2
                if cmp(v, a[mid]) < 0:
                    right = mid
                else:
                    left = mid + 1
            q = p
            while q > left:
                a[q] = a[q - 1]
                q -= 1
            a[left] = v
            p += 1
        if hi < end:
            hi = end
        starts.append(lo)
        lo = hi
    starts.append(n)
    b = a[0:n]
    while len(starts) > 2:
        next_starts: list[int] = []
        runs = len(starts) - 1
        k = 0
        while k < runs:
            s = starts[k]
            if k + 1 < runs:
                mid = starts[k + 1]
                e = starts[k + 2]
                i = s
                j = mid
                o = s
                if cmp(a[mid], a[mid - 1]) < 0:
                    while i < mid and j < e:
                        if cmp(a[j], a[i]) < 0:
                            b[o] = a[j]
                            j += 1
                        else:
                            b[o] = a[i]
                            i += 1
                        o += 1
                while i < mid:
                    b[o] = a[i]
                    i += 1
                    o += 1
                while j < e:
                    b[o] = a[j]
                    j += 1
                    o += 1
                k += 2
            else:
                for o in range(s, starts[k + 1]):
                    b[o] = a[o]
                k += 1
            next_starts.append(s)
        next_starts.append(n)
        starts = next_starts
        a, b = b, a
    return a

def _keys[T, K](xs: list[T], key: fn(T) -> K) -> list[K]:
    return [key(x) for x in xs]

def _map[T, R](f: fn(T) -> R, xs: list[T]) -> list[R]:
    return [f(x) for x in xs]

def _filter[T](f: fn(T) -> bool, xs: list[T]) -> list[T]:
    return [x for x in xs if f(x)]

# s.lstrip(chars), s.rstrip(chars) and s.strip(chars): take off the characters that are in chars (in any order) from the
# start, the end or both; an empty chars takes nothing off
def _str_lstrip_chars(s: str, chars: str) -> str:
    i = 0
    while i < len(s) and s[i] in chars:
        i += 1
    return s[i:]

def _str_rstrip_chars(s: str, chars: str) -> str:
    n = len(s)
    while n > 0 and s[n - 1] in chars:
        n -= 1
    return s[:n]

def _str_strip_chars(s: str, chars: str) -> str:
    return _str_rstrip_chars(_str_lstrip_chars(s, chars), chars)

# xs == ys on two lists of the same type: the same length and every pair of items equal
def _list_eq[T](a: list[T], b: list[T]) -> bool:
    if len(a) != len(b):
        return False
    for x, y in zip(a, b):
        if x != y:
            return False
    return True

# ---------------------------------------------------------------------------------------------------------------------
# round(), divmod(), any(), all() (D75a) and the text methods splitlines, partition, rpartition, rsplit, zfill, ljust,
# rjust, center, title, capitalize, isalnum, removeprefix and removesuffix (D75b). The compiler turns `s.zfill(5)` into
# _str_zfill(s, 5), and keeps the names and the defaults of the parameters below for the messages and for keywords.

# the C runtime rounds a float exactly (the same code natively and in the browser)
!tomato_float_round(x: float, ndigits: int) -> float
!tomato_is_finite(x: float) -> int

# round(x) for a float: the nearest int, a tie goes to the even one (round(0.5) is 0, round(1.5) is 2, round(2.5) is 2)
def _round_float0(x: float) -> int:
    return int(_round_float(x, 0))

# round(x, ndigits) for a float: the float nearest to x with ndigits digits after the decimal point (before it when
# ndigits is negative), judged on the exact value of x, so round(2.675, 2) is 2.67 and round(0.125, 2) is 0.12
def _round_float(x: float, ndigits: int) -> float:
    r = !tomato_float_round(x, ndigits)
    if !tomato_is_finite(r) == 0:
        raise OverflowError('the rounded value is too large to be a float', 'E417')
    return r

# round(n, ndigits) for an int: a negative ndigits rounds to tens, hundreds and so on, ties to even (round(25, -1) is 20)
def _round_int(n: int, ndigits: int) -> int:
    if ndigits >= 0:
        return n
    digits = len(str(abs(n)))
    if -ndigits > digits:
        return 0
    unit = 10 ** -ndigits
    q = n // unit
    r = n - q * unit
    if r * 2 > unit or (r * 2 == unit and q % 2 == 1):
        q += 1
    return q * unit

# divmod(a, b): the floor quotient and the remainder, so that a == q * b + r and r has the sign of b
def _divmod(a: int, b: int) -> tuple[int, int]:
    q = a // b
    return (q, a - q * b)

def _any(xs: list[bool]) -> bool:
    for x in xs:
        if x:
            return True
    return False

def _all(xs: list[bool]) -> bool:
    for x in xs:
        if not x:
            return False
    return True

# ends of a line for splitlines(): \n, \r, \v, \f, the separators \x1c to \x1e, NEL and the Unicode line and paragraph
# separators (as in Python)
def _is_line_end(code: int) -> bool:
    return code == 10 or code == 13 or code == 11 or code == 12 or (code >= 28 and code <= 30) or code == 133 or code == 8232 or code == 8233

def _str_splitlines(s: str, keepends: bool = False) -> list[str]:
    lines: list[str] = []
    n = len(s)
    start = 0
    i = 0
    while i < n:
        c = s[i]
        if not _is_line_end(ord(c)):
            i += 1
            continue
        end = i
        i += 1
        if c == '\r' and i < n and s[i] == '\n':
            i += 1
        if keepends:
            lines.append(s[start:i])
        else:
            lines.append(s[start:end])
        start = i
    if start < n:
        lines.append(s[start:])
    return lines

def _str_partition(s: str, sep: str) -> tuple[str, str, str]:
    if sep == '':
        raise ValueError('partition needs a separator that is not empty', 'E418')
    i = s.find(sep)
    if i < 0:
        return (s, '', '')
    return (s[:i], sep, s[i + len(sep):])

def _str_rpartition(s: str, sep: str) -> tuple[str, str, str]:
    if sep == '':
        raise ValueError('rpartition needs a separator that is not empty', 'E418')
    i = s.rfind(sep)
    if i < 0:
        return ('', '', s)
    return (s[:i], sep, s[i + len(sep):])

# s.rsplit(sep, maxsplit): split at most maxsplit times, from the right (all of them for a negative maxsplit); the empty
# sep splits at runs of whitespace (a space, tab, newline or carriage return, as strip() does) and drops the empty pieces
def _str_rsplit(s: str, sep: str = '', maxsplit: int = -1) -> list[str]:
    parts: list[str] = []
    if sep == '':
        i = len(s)
        count = 0
        while True:
            while i > 0 and s[i - 1] in ' \t\n\r':
                i -= 1
            if i == 0:
                break
            if maxsplit >= 0 and count == maxsplit:
                parts.append(s[:i])
                break
            j = i
            while j > 0 and s[j - 1] not in ' \t\n\r':
                j -= 1
            parts.append(s[j:i])
            count += 1
            i = j
        parts.reverse()
        return parts
    end = len(s)
    count = 0
    while maxsplit < 0 or count < maxsplit:
        j = s.rfind(sep, 0, end)
        if j < 0:
            break
        parts.append(s[j + len(sep):end])
        end = j
        count += 1
    parts.append(s[:end])
    parts.reverse()
    return parts

def _check_fill(fillchar: str, what: str):
    if len(fillchar) != 1:
        raise ValueError(f'{what} needs a fill character of exactly one character', 'E419')

# s.zfill(width): pad with zeros on the left up to width, after a leading + or -
def _str_zfill(s: str, width: int) -> str:
    n = len(s)
    if n >= width:
        return s
    zeros = '0' * (width - n)
    if s[:1] == '+' or s[:1] == '-':
        return s[:1] + zeros + s[1:]
    return zeros + s

def _str_ljust(s: str, width: int, fillchar: str = ' ') -> str:
    _check_fill(fillchar, 'ljust')
    return s + fillchar * (width - len(s))

def _str_rjust(s: str, width: int, fillchar: str = ' ') -> str:
    _check_fill(fillchar, 'rjust')
    return fillchar * (width - len(s)) + s

# center puts the extra fill character on the left when the padding is odd and the width is odd (as Python does)
def _str_center(s: str, width: int, fillchar: str = ' ') -> str:
    _check_fill(fillchar, 'center')
    pad = width - len(s)
    if pad <= 0:
        return s
    left = pad // 2
    if pad % 2 == 1 and width % 2 == 1:
        left += 1
    return fillchar * left + s + fillchar * (pad - left)

# a letter that has an upper and a lower case (the case tables are the runtime's: see unicode_case)
def _is_cased(c: str) -> bool:
    return c.upper() != c.lower()

# s.title(): each run of letters starts with an upper case letter and goes on in lower case
def _str_title(s: str) -> str:
    out: list[str] = []
    after_letter = False
    for c in s:
        if after_letter:
            out.append(c.lower())
        else:
            out.append(c.upper())
        after_letter = _is_cased(c)
    return ''.join(out)

def _str_capitalize(s: str) -> str:
    return s[:1].upper() + s[1:].lower()

# s.isalnum(): not empty, and every character a letter or a digit (the runtime's Unicode tables, as isalpha and isdigit)
def _str_isalnum(s: str) -> bool:
    if s == '':
        return False
    for c in s:
        if not (c.isalpha() or c.isdigit()):
            return False
    return True

def _str_removeprefix(s: str, prefix: str) -> str:
    if prefix != '' and s.startswith(prefix):
        return s[len(prefix):]
    return s

def _str_removesuffix(s: str, suffix: str) -> str:
    if suffix != '' and s.endswith(suffix):
        return s[:len(s) - len(suffix)]
    return s

# ---------------------------------------------------------------------------------------------------------------------
# f-string format specs (D75c): f'{x:>8.2f}'. The compiler turns the field into _fmt_str, _fmt_int or _fmt_float with the
# parts of the spec already taken apart (compiler.tom, format_call; the form of a spec is checked by the lexer): fill and
# align are '' when not written, sign is '', '+', '-' or ' ', width is 0 and precision -1 when not written, and kind is
# '', 'f', 'e' or 'g'. They follow Python.

# C's %.*f, %.*e or %.*g of a float (exact, ties to even), with its sign; kind is the code of the letter
!tomato_float_format(x: float, precision: int, kind: int) -> str

# the digits of a whole number with a comma before each group of three from the right
def _group3(digits: str) -> str:
    n = len(digits)
    if n <= 3:
        return digits
    parts: list[str] = []
    first = n % 3
    if first > 0:
        parts.append(digits[:first])
    i = first
    while i < n:
        parts.append(digits[i:i + 3])
        i += 3
    return ','.join(parts)

# fill goes to the left, the right or both sides of text so that it is width long; a '' fill is a space, or a 0 when the
# spec had a 0 before the width
def _fmt_pad(text: str, fill: str, align: str, zero: bool, width: int) -> str:
    pad = width - len(text)
    if pad <= 0:
        return text
    f = fill
    if f == '':
        f = '0' if zero else ' '
    if align == '>':
        return f * pad + text
    if align == '^':
        left = pad // 2
        return f * left + text + f * (pad - left)
    return text + f * pad

def _fmt_str(s: str, fill: str, align: str, zero: bool, width: int, precision: int) -> str:
    text = s
    if precision >= 0:
        text = s[:precision]
    return _fmt_pad(text, fill, align, zero, width)

# a number written as a sign, the digits of its whole part and the rest (a fraction, an exponent), in a field of width
def _fmt_number(sign: str, whole: str, rest: str, fill: str, align: str, zero: bool, width: int, comma: bool) -> str:
    if align == '' and zero and fill == '':
        # a 0 before the width pads after the sign, with zeros; with commas the zeros are grouped too, and the number
        # never starts with a comma
        total = width - len(sign) - len(rest)
        k = len(whole)
        if comma:
            while k + (k - 1) // 3 < total:
                k += 1
        elif k < total:
            k = total
        digits = '0' * (k - len(whole)) + whole
        if comma:
            digits = _group3(digits)
        return sign + digits + rest
    digits = whole
    if comma:
        digits = _group3(whole)
    a = align
    if a == '':
        a = '>'
    return _fmt_pad(sign + digits + rest, fill, a, zero, width)

def _fmt_sign(negative: bool, sign: str) -> str:
    if negative:
        return '-'
    if sign == '+' or sign == ' ':
        return sign
    return ''

def _fmt_int(n: int, fill: str, align: str, sign: str, zero: bool, width: int, comma: bool) -> str:
    digits = str(n)
    if n < 0:
        digits = digits[1:]
    return _fmt_number(_fmt_sign(n < 0, sign), digits, '', fill, align, zero, width, comma)

# a float with a precision and no type: the precision counts significant digits, as for g, but a number that is whole shows
# its .0 (as repr does) and the exponent form starts one place earlier: format(123.0, '.3') is 1.23e+02 and
# format(12.0, '.3') is 12.0
def _fmt_repr_digits(x: float, precision: int) -> str:
    p = precision
    if p < 1:
        p = 1
    text = !tomato_float_format(x, p - 1, 101)
    sign = ''
    if text.startswith('-'):
        sign = '-'
        text = text[1:]
    e = text.find('e')
    exponent = int(text[e + 1:])
    digits = text[:e].replace('.', '').rstrip('0')
    if digits == '':
        digits = '0'
    if exponent < -4 or exponent >= p - 1:
        if len(digits) > 1:
            return sign + digits[:1] + '.' + digits[1:] + text[e:]
        return sign + digits + text[e:]
    if exponent < 0:
        return sign + '0.' + '0' * (-exponent - 1) + digits
    if len(digits) <= exponent + 1:
        return sign + digits + '0' * (exponent + 1 - len(digits)) + '.0'
    return sign + digits[:exponent + 1] + '.' + digits[exponent + 1:]

# (an int beyond the largest float arrives here as infinity, and stops)
def _fmt_float(x: float, fill: str, align: str, sign: str, zero: bool, width: int, comma: bool, precision: int, kind: str) -> str:
    if !tomato_is_finite(x) == 0:
        raise OverflowError('an int is too large to be a float', 'E436')
    text = ''
    if kind == '' and precision < 0:
        text = str(x)
    elif kind == '':
        text = _fmt_repr_digits(x, precision)
    else:
        p = precision
        if p < 0:
            p = 6
        text = !tomato_float_format(x, p, ord(kind))
    negative = text.startswith('-')
    if negative:
        text = text[1:]
    i = 0
    while i < len(text) and text[i] in '0123456789':
        i += 1
    return _fmt_number(_fmt_sign(negative, sign), text[:i], text[i:], fill, align, zero, width, comma)
