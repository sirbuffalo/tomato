# Names every Tomato file can use without importing them (D22a).

class Error:
    message: str

    @init
    def start(self, message: str):
        self.message = message

# Failures the language itself raises: division by zero, an index out of range, a missing key, bad text for int().
class RuntimeError(Error):
    @init
    def make(self, message: str):
        Error.start(self, message)

class IOError(RuntimeError):
    @init
    def make_io(self, message: str):
        RuntimeError.make(self, message)

# range(...) used as a value (not directly in a `for`) is a list of ints, built by these helpers.
def _range1(stop: int) -> list[int]:
    return _range3(0, stop, 1)

def _range2(start: int, stop: int) -> list[int]:
    return _range3(start, stop, 1)

def _range3(start: int, stop: int, step: int) -> list[int]:
    if step == 0:
        raise RuntimeError('range step cannot be zero')
    result: list[int] = []
    i = start
    while (step > 0 and i < stop) or (step < 0 and i > stop):
        result.append(i)
        i = i + step
    return result

# The text of a string inside a printed list, dict or set, quoted the way Python shows it: 'abc'.
def _quote(s: str) -> str:
    q = "'"
    if s.find("'") >= 0 and s.find('"') < 0:
        q = '"'
    t = s.replace('\\', '\\\\')
    if q == "'":
        t = t.replace("'", "\\'")
    t = t.replace('\n', '\\n')
    t = t.replace('\t', '\\t')
    t = t.replace('\r', '\\r')
    return q + t + q
