# Secure random values, modelled on Python's `secrets`: `from secrets import token_hex, token_bytes, randbelow`.
#
#     key = token_bytes(16)             # 16 random bytes, as bytes
#     name = token_hex(8)               # 16 lower case hex digits
#     pick = randbelow(100)             # a whole number from 0 to 99
#
# Everything here comes from the operating system's cryptographic generator (getentropy natively; in the browser the
# host's crypto.getRandomValues through WASI random_get), never from `random`. When the system has no such source the
# call stops with a RuntimeError: there is no weaker substitute and no fixed sequence. Use these functions, not
# `random.Random`, for tokens, passwords and keys.

!tomato_entropy(out: list[int], n: int) -> int

# nbytes random bytes
export def token_bytes(nbytes: int = 32) -> bytes:
    if nbytes < 0:
        raise ValueError(f'token_bytes needs a length of 0 or more, but got {nbytes}', 'E401')
    out: list[int] = []
    if !tomato_entropy(out, nbytes) != 0:
        raise RuntimeError('secure random bytes are not available on this system', 'E404')
    return bytes(out)

# nbytes random bytes as 2 * nbytes lower case hex digits
export def token_hex(nbytes: int = 32) -> str:
    return token_bytes(nbytes).hex()

# a random whole number from 0 to n - 1, every one equally likely
export def randbelow(n: int) -> int:
    if n <= 0:
        raise ValueError(f'randbelow needs a bound above 0, but got {n}', 'E402')
    bits = 0
    m = n
    while m > 0:
        bits += 1
        m = m >> 1
    count = (bits + 7) // 8
    while True:
        value = 0
        for b in token_bytes(count):
            value = value * 256 + b
        value = value >> (8 * count - bits)
        if value < n:
            return value
