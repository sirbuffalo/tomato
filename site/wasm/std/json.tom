# JSON (RFC 8259) and MessagePack, written in Tomato with a small C scanner for speed.
#
#     from json import loads, load, dump, dumps
#     from json import loads_msgpack, dumps_msgpack, load_msgpack, dump_msgpack
#     from value import Value, Dict, List, Bool, Int, Float, Null
#
#     j = loads('{"name": "tomato", "tags": ["red", "round"], "n": 3}')
#     print(j['name'].as_str(), j['tags'][1].as_str(), j['n'].as_int())     # tomato round 3
#     print(dumps(j))                                                      # {"name":"tomato","tags":["red","round"],"n":3}
#     print(dumps(j, indent=2))
#
#     built = Dict({'ok': Bool(True), 'ids': List([Int(1), Null(), Float(0.5)])})
#
# loads(text) returns a Value (std/value.tom, shared with toml, D122a): one of Null, Bool, Int, Float, Str, List, Dict. A number with no
# fraction and no exponent is an int of any size, any other number is a float of any size (as float(text) reads it), with an
# exponent of at most 4300 digits (more is a JSONDecodeError, D77d). Such an exponent takes about 40 ms to read, so the time for
# a document grows with how many it holds (a 1 MB body of them about 8 s): limit the size of untrusted text.
# Objects keep the order of the document; a repeated key keeps its first place and its last value. The parser is strict:
# no trailing commas, comments, leading zeros, NaN or Infinity, single quotes, raw control characters in strings, lone
# surrogate escapes or invalid UTF-8, and at most 512 levels of nesting. A mistake raises JSONDecodeError.
#
# dumps(value, indent=0, sort_keys=False, ensure_ascii=False): compact text by default; indent=N puts each item on its own
# line indented by N spaces per level (an empty list or object stays `[]` or `{}`); sort_keys orders keys by code point;
# ensure_ascii writes every non-ASCII character as \uXXXX. A float is written as str() writes it (1e+400 beyond a double); one
# that is nan or infinite, or whose binary exponent has more than 4096 bits (str() gives 0x1.8p+E), cannot be JSON: JSONEncodeError.
# A value of a kind JSON has no way to write (a Bin, Ext or Timestamp, or a TOML date or time) is a JSONEncodeError too.

!tomato_json_scan(text: str, tape: list[int], strs: list[str], nums: list[float]) -> int
!tomato_json_quote(text: str, ascii: int) -> str
!tomato_bf_is_boxed(x: float) -> int[length=32]
!tomato_msgpack_scan(data: bytes, tape: list[int], strs: list[str], nums: list[float]) -> int
!tomato_mp_head(out: list[int], kind: int, n: int)
!tomato_mp_str(out: list[int], text: str)
!tomato_mp_f64(out: list[int], x: float)
!tomato_mp_i64(out: list[int], v: int)
!tomato_mp_u64(out: list[int], hi: int, lo: int)
!tomato_mp_blob(out: list[int], code: int, isext: int, data: bytes) -> int
!tomato_mp_ts(out: list[int], secs: int, nanos: int)
!tomato_file_read_bytes(path: str, out: list[bytes]) -> int
!tomato_file_write_bytes(path: str, data: bytes) -> int
!tomato_file_error(path: str, code: int) -> str

from value import Value, Null, Bool, Int, Float, Str, List, Dict, Bin, Ext, Timestamp

export class JSONDecodeError(ValueError):
    reason: str = ''
    line: int = 0
    column: int = 0
    pos: int = 0

    @init
    def make_decode(self, reason: str, pos: int, line: int, column: int, id: str = ''):
        RuntimeError.make(self, f'{reason}: line {line} column {column} (char {pos})', id)
        self.reason = reason
        self.pos = pos
        self.line = line
        self.column = column

export class JSONEncodeError(ValueError):
    pass

# Raised by loads_msgpack on bad data (pos is the byte offset) and by dumps_msgpack on a value MessagePack cannot hold.
export class MsgpackError(ValueError):
    pos: int = 0

    @init
    def make_msgpack(self, message: str, pos: int, id: str = ''):
        RuntimeError.make(self, message if pos < 0 else f'{message}: byte {pos}', id)
        self.pos = pos

class Writer:
    out: list[str] = []
    indent: int = 0
    sort_keys: bool = False
    ascii: int = 0

    def newline(self, depth: int) -> str:
        return '\n' + ' ' * (self.indent * depth)


# ---- writing: JSON text and MessagePack, by the kind of each value ---------------------------------------------------------------

def _dump_float(v: Value, w: Writer):
    if v is Float and v.special != '':
        raise JSONEncodeError(f'the float {v.special} is not valid JSON', 'E81')
    # written as str() writes it, so that it reads back as the same float, whatever its size (D77d): 1e+400, and a subnormal
    # double with the digits a float needs (4.9406564584124654e-324)
    text = str(v.as_float())
    if text == 'nan' or text == 'inf' or text == '-inf':
        raise JSONEncodeError(f'the float {text} is not valid JSON', 'E81')
    if 'x' in text:
        raise JSONEncodeError(f'the float {text} has an exponent too large to write in decimal, as JSON needs', 'E525')
    w.out.append(text)

def _dump(v: Value, w: Writer, depth: int):
    k = v.kind()
    if k == 'null':
        w.out.append('null')
    elif k == 'bool':
        w.out.append('true' if v.as_bool() else 'false')
    elif k == 'int':
        w.out.append(str(v.as_int()))
    elif k == 'float':
        _dump_float(v, w)
    elif k == 'str':
        w.out.append(!tomato_json_quote(v.as_str(), w.ascii))
    elif k == 'list':
        _dump_list(v.as_list(), w, depth)
    elif k == 'dict':
        _dump_dict(v.as_dict(), w, depth)
    elif k == 'bin':
        raise JSONEncodeError('a bin value cannot be written as JSON text (use dumps_msgpack)', 'E77')
    elif k == 'ext':
        raise JSONEncodeError('an ext value cannot be written as JSON text (use dumps_msgpack)', 'E78')
    elif k == 'timestamp':
        raise JSONEncodeError('a timestamp cannot be written as JSON text (use dumps_msgpack)', 'E79')
    else:
        raise JSONEncodeError('a date or time cannot be written as JSON text (write it as a Str)', 'E617')

def _dump_list(items: list[Value], w: Writer, depth: int):
    if depth >= 512:
        raise JSONEncodeError('nesting is deeper than 512 levels', 'E76')
    if len(items) == 0:
        w.out.append('[]')
        return
    w.out.append('[')
    pretty = w.indent > 0
    inner = w.newline(depth + 1)
    first = True
    for item in items:
        if not first:
            w.out.append(',')
        first = False
        if pretty:
            w.out.append(inner)
        _dump(item, w, depth + 1)
    if pretty:
        w.out.append(w.newline(depth))
    w.out.append(']')

def _dump_dict(fields: dict[str, Value], w: Writer, depth: int):
    if depth >= 512:
        raise JSONEncodeError('nesting is deeper than 512 levels', 'E76')
    if len(fields) == 0:
        w.out.append('{}')
        return
    w.out.append('{')
    pretty = w.indent > 0
    inner = w.newline(depth + 1)
    colon = ': ' if pretty else ':'
    keys: list[str] = list(fields.keys())
    if w.sort_keys:
        keys = sorted(keys)
    first = True
    for key in keys:
        if not first:
            w.out.append(',')
        first = False
        if pretty:
            w.out.append(inner)
        w.out.append(!tomato_json_quote(key, w.ascii))
        w.out.append(colon)
        _dump(fields[key], w, depth + 1)
    if pretty:
        w.out.append(w.newline(depth))
    w.out.append('}')

# MessagePack has only 64-bit floats (D77d): one in the subnormal range is written as the nearest double, as float64 holds it;
# one beyond the largest double, or so small that it would become 0.0, does not fit. A number read from JSON text is a 53-bit
# float first (1e-310 is a float of its own, not the subnormal double), so in rare cases it packs one unit of the last place away
# from the double C's strtod reads from the same text, and a text just above 2 ** -1075 (2.4703282292062328e-324) is E526
def _pack_float(v: Value, out: list[int]):
    if v is Float and v.special != '':
        raise MsgpackError(f'the float {v.special} cannot be written as MessagePack', -1, 'E619')
    x = v.as_float()
    if !tomato_bf_is_boxed(x) != 0 and (abs(x) > 1.7976931348623157e308 or abs(x) <= 2.0 ** -1075):
        raise MsgpackError(f'the float {x} does not fit in a 64-bit float, the largest MessagePack has', -1, 'E526')
    !tomato_mp_f64(out, x)

def _pack_int(v: int, out: list[int]):
    if v >= 0 and v < 128:
        out.append(v)
    elif v >= -32 and v < 0:
        out.append(256 + v)
    elif v >= -9223372036854775808 and v < 9223372036854775808:
        !tomato_mp_i64(out, v)
    elif v >= 9223372036854775808 and v < 18446744073709551616:
        !tomato_mp_u64(out, v // 4294967296, v % 4294967296)
    else:
        raise MsgpackError(f'the integer {v} does not fit in 64 bits', -1, 'E86')

def _pack(v: Value, out: list[int], depth: int):
    k = v.kind()
    if k == 'null':
        out.append(192)
    elif k == 'bool':
        out.append(195 if v.as_bool() else 194)
    elif k == 'int':
        _pack_int(v.as_int(), out)
    elif k == 'float':
        _pack_float(v, out)
    elif k == 'str':
        !tomato_mp_str(out, v.as_str())
    elif k == 'list':
        if depth >= 512:
            raise MsgpackError('nesting is deeper than 512 levels', -1, 'E82')
        items = v.as_list()
        !tomato_mp_head(out, 0, len(items))
        for item in items:
            _pack(item, out, depth + 1)
    elif k == 'dict':
        if depth >= 512:
            raise MsgpackError('nesting is deeper than 512 levels', -1, 'E82')
        fields = v.as_dict()
        !tomato_mp_head(out, 1, len(fields))
        for key in fields:
            !tomato_mp_str(out, key)
            _pack(fields[key], out, depth + 1)
    elif k == 'bin':
        !tomato_mp_blob(out, 0, 0, v.as_bytes())
    elif k == 'ext':
        code = v.ext_type()
        if code < -128 or code > 127 or code == -1:
            raise MsgpackError(f'the ext type {code} must be from -128 to 127 and not -1', -1, 'E87')
        !tomato_mp_blob(out, code, 1, v.as_bytes())
    elif k == 'timestamp':
        secs = v.seconds()
        ns = v.nanos()
        if ns < 0 or ns > 999999999:
            raise MsgpackError('timestamp nanoseconds must be from 0 to 999999999', -1, 'E84')
        if secs < -4611686018427387904 or secs > 4611686018427387903:
            raise MsgpackError('the timestamp seconds are out of range', -1, 'E85')
        !tomato_mp_ts(out, secs, ns)
    else:
        raise MsgpackError('a date or time cannot be written as MessagePack (use a Timestamp)', -1, 'E618')

# Turns the scanner's tape back into a Value tree.
class Builder:
    tape: list[int] = []
    strs: list[str] = []
    nums: list[float] = []
    t: int = 0
    s: int = 0
    n: int = 0
    null_v: Value = Null()
    true_v: Value = Bool(True)
    false_v: Value = Bool(False)

    def build(self) -> Value:
        k = self.tape[self.t]
        self.t += 1
        if k == 6:
            self.s += 1
            return Str(self.strs[self.s - 1])
        if k == 3:
            self.t += 1
            return Int(self.tape[self.t - 1])
        if k == 7:
            items: list[Value] = []
            while self.tape[self.t] != 8:
                items.append(self.build())
            self.t += 1
            return List(items)
        if k == 9:
            fields: dict[str, Value] = {}
            while self.tape[self.t] != 10:
                self.t += 1
                self.s += 1
                key = self.strs[self.s - 1]
                fields[key] = self.build()
            self.t += 1
            return Dict(fields)
        if k == 5:
            self.n += 1
            return Float(self.nums[self.n - 1])
        if k == 11:
            size = self.tape[self.t]
            self.t += 1 + size
            return Bin(bytes(self.tape[self.t - size:self.t]))
        if k == 12:
            code = self.tape[self.t]
            size = self.tape[self.t + 1]
            self.t += 2 + size
            return Ext(code, bytes(self.tape[self.t - size:self.t]))
        if k == 13:
            self.t += 2
            return Timestamp(self.tape[self.t - 2], self.tape[self.t - 1])
        if k == 0:
            return self.null_v
        if k == 1:
            return self.true_v
        if k == 2:
            return self.false_v
        self.s += 1
        return Int(int(self.strs[self.s - 1]))

export def loads(text: str) -> Value:
    b = Builder()
    if !tomato_json_scan(text, b.tape, b.strs, b.nums) != 0:
        e = len(b.tape)
        raise JSONDecodeError(b.strs[-1], b.tape[e - 3], b.tape[e - 2], b.tape[e - 1], 'E88')
    return b.build()

export def dumps(value: Value, indent: int = 0, sort_keys: bool = False, ensure_ascii: bool = False) -> str:
    if indent < 0:
        raise JSONEncodeError('indent cannot be negative', 'E80')
    w = Writer()
    w.indent = indent
    w.sort_keys = sort_keys
    w.ascii = 1 if ensure_ascii else 0
    _dump(value, w, 0)
    return ''.join(w.out)

# MessagePack, from and to bytes (D17e). Decoding gives the same Value values as loads, plus Bin,
# Ext and Timestamp; map keys must be text; NaN and infinite floats are kept (JSON text refuses them); an
# invalid UTF-8 str, a byte 0xc1, truncated or trailing data and more than 512 levels of nesting are a MsgpackError.
# Encoding writes each int in its shortest form (up to 64 bits, signed or unsigned), floats as float64 (one in the subnormal range
# as the nearest double; one beyond the largest double or below half the smallest is a MsgpackError), text as str, a
# Bin as bin, a Ext as ext and a Timestamp as the shortest timestamp.
export def loads_msgpack(data: bytes) -> Value:
    b = Builder()
    if !tomato_msgpack_scan(data, b.tape, b.strs, b.nums) != 0:
        raise MsgpackError(b.strs[-1], b.tape[-1], 'E89')
    return b.build()

export def dumps_msgpack(value: Value) -> bytes:
    out: list[int] = []
    _pack(value, out, 0)
    return bytes(out)

# File counterparts of loads and dumps (text files, UTF-8): load(path) reads and parses the file; dump(value, path, ...)
# writes dumps(value, ...) to it, replacing it. An unreadable or unwritable path raises IOError, and the text is made
# before the file is opened, so a value JSON cannot hold (JSONEncodeError) leaves the file alone.
export def load(path: str) -> Value:
    f = open(path, 'r')
    text = f.read()
    f.close()
    return loads(text)

export def dump(value: Value, path: str, indent: int = 0, sort_keys: bool = False, ensure_ascii: bool = False):
    text = dumps(value, indent=indent, sort_keys=sort_keys, ensure_ascii=ensure_ascii)
    f = open(path, 'w')
    f.write(text)
    f.close()

# File counterparts of loads_msgpack and dumps_msgpack (binary files): load_msgpack(path) reads the whole file as bytes and
# decodes it; dump_msgpack(value, path) writes dumps_msgpack(value) to it, replacing it. A path that cannot be opened raises
# IOError with the same text as open() (could not open 'PATH': REASON); a file that opens but cannot be read (a directory)
# or written (a full disk) raises IOError (could not read / could not write 'PATH': REASON). Bad bytes in the file raise
# MsgpackError as loads_msgpack does, and the bytes are made before the file is opened, so a value MessagePack cannot
# hold (MsgpackError) leaves the file alone.
export def load_msgpack(path: str) -> Value:
    data: list[bytes] = []
    r = !tomato_file_read_bytes(path, data)
    if r == 1:
        raise IOError(!tomato_file_error(path, r), 'E25')
    if r != 0:
        raise IOError(!tomato_file_error(path, r), 'E381')
    return loads_msgpack(data[0])

export def dump_msgpack(value: Value, path: str):
    data = dumps_msgpack(value)
    r = !tomato_file_write_bytes(path, data)
    if r == 1:
        raise IOError(!tomato_file_error(path, r), 'E25')
    if r != 0:
        raise IOError(!tomato_file_error(path, r), 'E382')
