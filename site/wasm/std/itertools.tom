# Loop helpers, written in Tomato: `progress_bar`, `permutations`, `combinations`, `product`, `chain`, `pairwise`, `batched`, `repeat`, ...
# The progress bar shows a count and a percentage but no speed or time left (the built-in `clock()` would give one).
#
#     for x in progress_bar(items, 'copying'):     # items: any iterable with a length (list, range, text, a class)
#         ...
#
# or by hand:
#
#     bar = progress_bar(items, 'copying')
#     for x in items:
#         ...
#         bar.update()
#     bar.close()
#
# update() draws the bar on standard error (so it does not mix with what the program prints); render() returns the
# same line as text, which is what the tests check. An empty list gives a total of 0, which shows only the count.
# When standard error is a terminal the bar is one line that is redrawn in place ('\r'). When it is not (a pipe, a file, closed),
# a plain line is written at the first update and then at each new tenth of the percentage (10%, 20%, ...) and once at the end, and nothing fails if the stream is closed.
# The repl runs your code with standard error captured, so it sets TOMATO_PROGRESS_TTY=1 and the bar then draws on the
# controlling terminal (/dev/tty) when there is one.
# Looping over the bar itself (its @iter method) draws as it goes and ends the line when the loop is done.

!tomato_tty_open(path: str) -> int
!tomato_tty_close(fd: int) -> int
!tomato_tty_is(fd: int) -> int
!tomato_tty_write(fd: int, text: str) -> int
!tomato_env_has(name: str) -> int
!tomato_write_fd(fd: int, text: str) -> int

export class progress_bar[T]:
    items: Iterable[T] & Sized
    total: int = 0
    count: int = 0
    label: str = ''
    width: int = 30
    private tty: int = -1          # a terminal descriptor opened for drawing (the repl case), or -1
    private tried: bool = False
    private live: bool = False     # one redrawn line (standard error, or the terminal) instead of plain lines
    private last_line: str = ''    # the last plain line written
    private last_pct: int = -1

    @init
    def make(self, items: Iterable[T] & Sized, label: str = '', width: int = 30):
        if width < 1:
            raise ValueError('a progress bar width must be at least 1', 'E38')
        self.items = items
        self.total = len(items)
        self.label = label
        self.width = width

    def render(self) -> str:
        prefix = f'{self.label}: ' if self.label != '' else ''
        if self.total == 0:
            return f'{prefix}{self.count}it'
        shown = max(0, min(self.count, self.total))     # (a count that went below 0 with update(-n) shows as 0%)
        filled = shown * self.width // self.total
        pct = str(shown * 100 // self.total)
        pct = ' ' * (3 - len(pct)) + pct          # right-aligned in three places
        bar = '#' * filled + '-' * (self.width - filled)
        return f'{prefix}{pct}%|{bar}| {self.count}/{self.total}'

    # Where the bar goes, decided at the first draw: standard error when it is a terminal; else, in the repl, the controlling
    # terminal; else standard error as plain lines.
    def pick(self):
        self.tried = True
        if !tomato_tty_is(2) == 1:
            self.live = True
        elif !tomato_env_has('TOMATO_PROGRESS_TTY') == 1:
            fd = !tomato_tty_open('/dev/tty')
            if fd >= 0:
                self.tty = fd
                self.live = True

    def emit(self, text: str):
        if self.tty >= 0:
            _r = !tomato_tty_write(self.tty, text)
        else:
            _r = !tomato_write_fd(2, text)

    def show(self, end: str):
        if not self.tried:
            self.pick()
        line = self.render()
        if self.live:
            self.emit(f'\r{line}{end}')
            return
        pct = max(0, min(self.count, self.total)) * 100 // self.total if self.total > 0 else -1
        if end == '\n':
            if line != self.last_line:
                self.emit(f'{line}\n')
        elif pct >= 0 and pct // 10 != self.last_pct:
            self.last_pct = pct // 10
            self.last_line = line
            self.emit(f'{line}\n')

    def update(self, n: int = 1):
        self.count += n
        self.show('')

    def close(self):
        self.show('\n')
        if self.tty >= 0:
            _r = !tomato_tty_close(self.tty)
            self.tty = -1

    @iter
    def each(self) -> T:
        for x in self.items:
            yield x
            self.update()
        self.close()

# The helpers below take lists of any item type T and return whole lists (the type is worked out from the arguments).
# Results come in the same order as Python's itertools.

# Every ordering of r items from `items` (all of them when r is -1), by position, so repeated values repeat.
export def permutations[T](items: list[T], r: int = -1) -> list[list[T]]:
    size = len(items) if r < 0 else r
    result: list[list[T]] = []
    if size > len(items):
        return result
    _permute_into(items, size, [], [False] * len(items), result)
    return result

def _permute_into[T](items: list[T], size: int, prefix: list[T], used: list[bool], result: list[list[T]]):
    if len(prefix) == size:
        result.append(prefix)
        return
    for i, x in enumerate(items):
        if not used[i]:
            used[i] = True
            _permute_into(items, size, prefix + [x], used, result)
            used[i] = False

# Every r-item selection in input order, with no repeats of a position.
export def combinations[T](items: list[T], r: int) -> list[list[T]]:
    result: list[list[T]] = []
    if r < 0 or r > len(items):
        return result
    _combine_into(items, r, 0, [], False, result)
    return result

# Like combinations, but an item may be picked again.
export def combinations_with_replacement[T](items: list[T], r: int) -> list[list[T]]:
    result: list[list[T]] = []
    if r < 0:
        return result
    _combine_into(items, r, 0, [], True, result)
    return result

def _combine_into[T](items: list[T], r: int, first: int, prefix: list[T], again: bool, result: list[list[T]]):
    if len(prefix) == r:
        result.append(prefix)
        return
    for i in range(first, len(items)):
        next_first = i if again else i + 1
        _combine_into(items, r, next_first, prefix + [items[i]], again, result)

# Every pair (a, b) as a two-item list, first list varying slowest.
export def product[T](a: list[T], b: list[T]) -> list[list[T]]:
    result: list[list[T]] = []
    for x in a:
        for y in b:
            result.append([x, y])
    return result

# Every list of `repeat` items from `items` (the product of items with itself repeat times).
export def product_repeat[T](items: list[T], repeat: int) -> list[list[T]]:  # allow: shadow
    result: list[list[T]] = []
    if repeat < 0:
        return result
    result.append([])
    for step in range(repeat):
        grown: list[list[T]] = []
        for prefix in result:
            for x in items:
                grown.append(prefix + [x])
        result = grown
    return result

# Running totals: accumulate([1, 2, 3]) is [1, 3, 6].
export def accumulate(items: list[int]) -> list[int]:
    out: list[int] = []
    total = 0
    for x in items:
        total += x
        out.append(total)
    return out

export def chain[T](a: list[T], b: list[T]) -> list[T]:
    return a + b

# Neighbouring pairs: pairwise([1, 2, 3]) is [[1, 2], [2, 3]].
export def pairwise[T](items: list[T]) -> list[list[T]]:
    return [[items[i - 1], items[i]] for i in range(1, len(items))]

# Chunks of n items; the last may be shorter.
export def batched[T](items: list[T], n: int) -> list[list[T]]:
    if n < 1:
        raise ValueError('batched needs a batch size of at least 1', 'E39')
    return [items[i:i + n] for i in range(0, len(items), n)]

export def repeat[T](item: T, times: int) -> list[T]:
    return [item] * times
