# UTF-8 conversion between text and bytes (`import utf8`):
#
#     print(utf8.encode('hé'))                  # b'h\xc3\xa9'
#     print(utf8.decode(b'h\xc3\xa9'))          # hé
#
# encode(text) -> bytes is `text.encode()`, but it also keeps invalid bytes that are already in the text.
# decode(data: bytes, errors='strict') -> str is `data.decode(errors=errors)`: errors is 'strict' or 'replace'.
!tomato_str_nbytes(s: str) -> int
!tomato_str_byte(s: str, i: int) -> int

export def encode(text: str) -> bytes:
    out: list[int] = []
    for i in range(!tomato_str_nbytes(text)):
        out.append(!tomato_str_byte(text, i))
    return bytes(out)

export def decode(data: bytes, errors: str = 'strict') -> str:
    if errors != 'strict' and errors != 'replace':
        raise ValueError('unknown UTF-8 error mode', 'E497')
    return data.decode(errors=errors)
