# TOML v1.0.0, written in Tomato: `from toml import loads, load, dump, dumps`.
#
#     doc = loads('title = "demo"\n[server]\nport = 8080\n')
#     print(doc['title'].as_str(), doc['server']['port'].as_int())
#     print(dumps(doc))
#
# A decoded document is a `Value` (std/value.tom, shared with json, D122a): a table is a Dict (its keys in the order they were
# written), an array a List (of any kinds, as TOML 1.0 allows), a string a Str, an integer an Int (an unlimited int, but loads
# accepts only the 64-bit range TOML requires), a float a Float (of any size; for inf and nan, which a Tomato float cannot
# hold, its `special` is 'inf', '-inf' or 'nan'), a boolean a Bool, and the four date and time types a Moment (kind() says
# which: 'datetime' for an offset date-time, 'local-datetime', 'local-date' or 'local-time').
#
# `doc['key']` reads a table and `doc['key'] = ...` is not available: change the dict that doc.as_dict() gives. Errors in the
# text raise TOMLDecodeError with the position (line and column count from 1, pos is the character offset from 0).
# dumps and dumps_value raise ValueError (E620) for a value TOML has no way to write: a Null, Bin, Ext or Timestamp.
from value import Value, Bool, Int, Float, Str, List, Dict, Moment

# ---------------------------------------------------------------------------------------------------------------------
# errors and date/time values

export class TOMLDecodeError(ValueError):
    reason: str = ''
    line: int = 0
    column: int = 0
    pos: int = 0

    @init
    def make_decode(self, reason: str, line: int, column: int, pos: int, id: str = ''):
        RuntimeError.make(self, f'{reason}: line {line} column {column} (char {pos})', id)
        self.reason = reason
        self.line = line
        self.column = column
        self.pos = pos

def _pad(n: int, width: int) -> str:
    s = str(n)
    return '0' * (width - len(s)) + s

# ---------------------------------------------------------------------------------------------------------------------
# the parser's tree: one class for every kind of value, with the bookkeeping that TOML's rules need (how a table came to be). When
# the whole text has been read it is turned into the Value tree that loads returns.
#
#     'table'     fields (key -> _Node) and order (the keys, in the order they were written)
#     'array'     items
#     'string'    text;   'integer'   num;   'boolean'   flag
#     'float'     real; for inf and nan `special` is 'inf', '-inf' or 'nan'
#     'datetime', 'local-datetime', 'local-date', 'local-time'   moment

class _Node:
    kind: str = 'table'
    text: str = ''
    num: int = 0
    real: float = 0.0
    special: str = ''
    flag: bool = False
    moment: Moment | None = None
    items: list[_Node] = []
    fields: dict[str, _Node] = {}
    order: list[str] = []
    origin: str = ''          # how a table or array came to be (header, implicit, dotted, inline, aot, static)

    def put(self, key: str, value: _Node):
        if key not in self.fields:
            self.order.append(key)
        self.fields[key] = value

def _table() -> _Node:
    t = _Node()
    t.kind = 'table'
    return t

def _array() -> _Node:
    t = _Node()
    t.kind = 'array'
    return t

def _moment_node(m: Moment) -> _Node:
    t = _Node()
    t.kind = m.form
    t.moment = m
    return t

def _to_value(n: _Node) -> Value:
    k = n.kind
    if k == 'table':
        fields: dict[str, Value] = {}
        for key in n.order:
            fields[key] = _to_value(n.fields[key])
        return Dict(fields)
    if k == 'array':
        items: list[Value] = []
        for x in n.items:
            items.append(_to_value(x))
        return List(items)
    if k == 'string':
        return Str(n.text)
    if k == 'integer':
        return Int(n.num)
    if k == 'float':
        return Float(n.real, n.special)
    if k == 'boolean':
        return Bool(n.flag)
    if n.moment is None:
        return Dict({})          # (not reached: a date or time node always holds its moment)
    m: Moment = n.moment
    return m

# ---------------------------------------------------------------------------------------------------------------------
# character helpers (a character is a one-character text; '' is the end of a line)

def _is_digit(c: str) -> bool:
    return len(c) == 1 and c in '0123456789'

def _is_hex(c: str) -> bool:
    return len(c) == 1 and c in '0123456789abcdefABCDEF'

def _is_bare(c: str) -> bool:
    return len(c) == 1 and c in 'abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_-'

def _is_space(c: str) -> bool:
    return len(c) == 1 and (c == ' ' or c == '\t')

# a control character that may not appear in a string or comment (a tab may)
def _is_control(c: str) -> bool:
    o = ord(c)
    return (o < 32 and o != 9) or o == 127


def _digit_value(c: str) -> int:
    if c in '0123456789':
        return ord(c) - 48
    if c in 'abcdef':
        return ord(c) - 87
    return ord(c) - 55

def _leap(y: int) -> bool:
    return (y % 4 == 0 and y % 100 != 0) or y % 400 == 0

def _days_in(y: int, m: int) -> int:
    if m == 2:
        if _leap(y):
            return 29
        return 28
    if m == 4 or m == 6 or m == 9 or m == 11:
        return 30
    return 31

# the value of s[a:b] when it is all digits, else -1
def _digits(s: str, a: int, b: int) -> int:
    if b > len(s) or a >= b:
        return -1
    n = 0
    for i in range(a, b):
        c = s[i]
        if not _is_digit(c):
            return -1
        n = n * 10 + ord(c) - 48
    return n

# ---------------------------------------------------------------------------------------------------------------------
# the parser: it walks the text line by line, so reading a character of a line costs at most the length of that line

class _Parser:
    lines: list[str] = []
    ln: int = 0               # the current line, from 0
    line: str = ''            # its text, without the line end
    n: int = 0
    i: int = 0
    root: _Node = _Node()
    cur: _Node = _Node()
    depth: int = 0

    @init
    def make_parser(self, text: str):
        if len(text) > 0 and text[0] == chr(65279):
            text = text[1:]
        self.lines = text.split('\n')
        self.root = _table()
        self.root.origin = 'root'
        self.cur = self.root
        self.load(0)

    def load(self, ln: int):
        self.ln = ln
        self.i = 0
        if ln >= len(self.lines):
            self.line = ''
            self.n = 0
            return
        s = self.lines[ln]
        if s.endswith('\r'):
            s = s[:-1]
        self.line = s
        self.n = len(s)

    def fail_at(self, reason: str, ln: int, i: int):
        pos = 0
        for k in range(ln):
            pos += len(self.lines[k]) + 1
        raise TOMLDecodeError(reason, ln + 1, i + 1, pos + i, 'E356')

    def fail(self, reason: str):
        self.fail_at(reason, self.ln, self.i)

    def ch(self) -> str:
        if self.i >= self.n:
            return ''
        return self.line[self.i]

    def at(self, k: int) -> str:
        if self.i + k >= self.n:
            return ''
        return self.line[self.i + k]

    def starts(self, s: str) -> bool:
        return self.line[self.i:self.i + len(s)] == s

    def skip_ws(self):
        while self.i < self.n and _is_space(self.line[self.i]):
            self.i += 1

    # a comment runs to the end of the line; control characters are not allowed in it
    def skip_comment(self):
        if self.ch() == '#':
            j = self.i + 1
            while j < self.n:
                if _is_control(self.line[j]):
                    self.fail_at('Invalid control character in a comment', self.ln, j)
                j += 1
            self.i = self.n

    # inside an array: spaces, comments and line ends
    def skip_ws_nl(self):
        while True:
            self.skip_ws()
            self.skip_comment()
            if self.i < self.n:
                return
            if self.ln + 1 >= len(self.lines):
                self.fail('Unterminated array')
            self.load(self.ln + 1)

    # ---- keys ----
    def parse_key(self) -> list[str]:
        parts: list[str] = []
        while True:
            self.skip_ws()
            c = self.ch()
            if c == '"':
                parts.append(self.basic_string())
            elif c == "'":
                parts.append(self.literal_string())
            elif _is_bare(c):
                j = self.i
                while j < self.n and _is_bare(self.line[j]):
                    j += 1
                parts.append(self.line[self.i:j])
                self.i = j
            else:
                self.fail('Invalid key')
            self.skip_ws()
            if self.ch() == '.':
                self.i += 1
            else:
                return parts

    # ---- strings ----
    def escape(self) -> str:
        # the backslash is at self.i
        c = self.at(1)
        self.i += 2
        if c == 'n':
            return '\n'
        if c == 't':
            return '\t'
        if c == '"':
            return '"'
        if c == '\\':
            return '\\'
        if c == 'r':
            return '\r'
        if c == 'b':
            return chr(8)
        if c == 'f':
            return chr(12)
        if c == 'u' or c == 'U':
            count = 4
            if c == 'U':
                count = 8
            if self.i + count > self.n:
                self.fail('Invalid unicode escape')
            v = 0
            for k in range(count):
                h = self.line[self.i + k]
                if not _is_hex(h):
                    self.fail_at('Invalid unicode escape', self.ln, self.i + k)
                v = v * 16 + _digit_value(h)
            if v > 1114111 or (v >= 55296 and v <= 57343):
                self.fail('Invalid unicode escape: not a unicode scalar value')
            self.i += count
            return chr(v)
        self.i -= 2
        self.fail('Invalid escape sequence')
        return ''

    # "..." on one line; self.i is at the opening quote
    def basic_string(self) -> str:
        self.i += 1
        out: list[str] = []
        start = self.i
        while True:
            if self.i >= self.n:
                self.fail('Unterminated string')
            c = self.line[self.i]
            if c == '"':
                out.append(self.line[start:self.i])
                self.i += 1
                return ''.join(out)
            if c == '\\':
                out.append(self.line[start:self.i])
                out.append(self.escape())
                start = self.i
            elif _is_control(c):
                self.fail('Invalid control character in a string')
            else:
                self.i += 1

    # '...' on one line
    def literal_string(self) -> str:
        self.i += 1
        start = self.i
        while True:
            if self.i >= self.n:
                self.fail('Unterminated string')
            c = self.line[self.i]
            if c == "'":
                s = self.line[start:self.i]
                self.i += 1
                return s
            if _is_control(c):
                self.fail('Invalid control character in a string')
            self.i += 1

    # """...""" or '''...''' over several lines; self.i is at the opening quotes
    def multiline_string(self, q: str, escapes: bool) -> str:
        start_ln = self.ln
        start_i = self.i
        self.i += 3
        out: list[str] = []
        if self.i >= self.n:               # a newline right after the opening quotes is dropped
            if self.ln + 1 >= len(self.lines):
                self.fail_at('Unterminated string', start_ln, start_i)
            self.load(self.ln + 1)
        seg = self.i
        while True:
            if self.i >= self.n:
                out.append(self.line[seg:self.n])
                out.append('\n')
                if self.ln + 1 >= len(self.lines):
                    self.fail_at('Unterminated string', start_ln, start_i)
                self.load(self.ln + 1)
                seg = 0
                continue
            c = self.line[self.i]
            if c == q:
                run = 0
                while self.i + run < self.n and self.line[self.i + run] == q:
                    run += 1
                if run >= 3:
                    if run > 5:
                        self.fail_at('Too many quotes in a multi-line string', self.ln, self.i + 5)
                    out.append(self.line[seg:self.i])
                    out.append(q * (run - 3))
                    self.i += run
                    return ''.join(out)
                self.i += run
            elif c == '\\' and escapes:
                out.append(self.line[seg:self.i])
                # a backslash that ends the line takes the whitespace and line ends that follow it
                j = self.i + 1
                while j < self.n and _is_space(self.line[j]):
                    j += 1
                if j >= self.n:
                    while True:
                        if self.ln + 1 >= len(self.lines):
                            self.fail_at('Unterminated string', start_ln, start_i)
                        self.load(self.ln + 1)
                        while self.i < self.n and _is_space(self.line[self.i]):
                            self.i += 1
                        if self.i < self.n:
                            break
                else:
                    out.append(self.escape())
                seg = self.i
            elif _is_control(c):
                self.fail('Invalid control character in a string')
            else:
                self.i += 1

    # ---- numbers and dates: a token is a run of characters that can belong to one ----
    def token(self) -> str:
        j = self.i
        while j < self.n:
            c = self.line[j]
            if _is_bare(c) or c == '+' or c == '.' or c == ':':
                j += 1
            else:
                break
        t = self.line[self.i:j]
        self.i = j
        return t

    def digits_only(self, s: str, start: int, base: str, what: str, at: int) -> str:
        # s[start:] is digits of the base with single underscores between digits; the digits without underscores
        if start >= len(s):
            self.fail_at(f'Invalid {what}', self.ln, at)
        out: list[str] = []
        prev = '_'
        for k in range(start, len(s)):
            c = s[k]
            if c == '_':
                if prev == '_':
                    self.fail_at(f'Invalid {what}: misplaced underscore', self.ln, at)
            elif c in base:
                out.append(c)
            else:
                self.fail_at(f'Invalid {what}', self.ln, at)
            prev = c
        if prev == '_':
            self.fail_at(f'Invalid {what}: misplaced underscore', self.ln, at)
        return ''.join(out)

    def parse_number(self, tok: str, at: int) -> _Node:
        v = _Node()
        sign = ''
        body = tok
        if body.startswith('+') or body.startswith('-'):
            sign = body[:1]
            body = body[1:]
        if body == 'inf' or body == 'nan':
            v.kind = 'float'
            if body == 'nan':
                v.special = 'nan'
            elif sign == '-':
                v.special = '-inf'
            else:
                v.special = 'inf'
            return v
        if sign == '' and len(body) > 2 and body[0] == '0' and body[1] in 'xob':
            base = '01234567'
            mult = 8
            if body[1] == 'x':
                base = '0123456789abcdefABCDEF'
                mult = 16
            elif body[1] == 'b':
                base = '01'
                mult = 2
            digits = self.digits_only(body, 2, base, 'integer', at)
            n = 0
            for c in digits:
                n = n * mult + _digit_value(c)
            if n >= 9223372036854775808 * 2:
                self.fail_at('Integer is out of the 64-bit range', self.ln, at)
            if n >= 9223372036854775808:
                self.fail_at('Integer is out of the 64-bit range', self.ln, at)
            v.kind = 'integer'
            v.num = n
            return v
        # decimal: int part, then optional fraction and exponent
        is_float = False
        k = 0
        n = len(body)
        while k < n and body[k] != '.' and body[k] != 'e' and body[k] != 'E':
            k += 1
        int_part = self.digits_only(body[:k], 0, '0123456789', 'number', at)
        if len(int_part) > 1 and int_part[0] == '0':
            self.fail_at('Invalid number: leading zeros are not allowed', self.ln, at)
        clean = int_part
        if k < n and body[k] == '.':
            is_float = True
            j = k + 1
            while j < n and body[j] != 'e' and body[j] != 'E':
                j += 1
            clean += '.' + self.digits_only(body[k + 1:j], 0, '0123456789', 'number', at)
            k = j
        if k < n:
            is_float = True
            rest = body[k + 1:]
            esign = ''
            if rest.startswith('+') or rest.startswith('-'):
                esign = rest[:1]
                rest = rest[1:]
            edigits = self.digits_only(rest, 0, '0123456789', 'number', at)
            if len(edigits) > 4300:
                # reading an exponent takes time in the square of its length: more than 4300 digits (Python's limit on the digits
                # of an int read from text) is refused, so that one number cannot stall the reader (D77d). That bounds each number
                # to about 40 ms, not a document, whose time still grows with how many it holds: limit the size of untrusted text
                self.fail_at('Float is out of range', self.ln, at)
            clean += 'e' + esign + edigits
        if is_float:
            v.kind = 'float'
            v.real = float(sign + clean)          # a float of any size (D77d): 1e400 is 1e+400, 1e-400 is not 0.0
            return v
        x = int(sign + clean)
        if x > 9223372036854775807 or x < -9223372036854775808:
            self.fail_at('Integer is out of the 64-bit range', self.ln, at)
        v.kind = 'integer'
        v.num = x
        return v

    # YYYY-MM-DD at s[a:a+10]
    def parse_date(self, s: str, a: int, m: Moment, at: int):
        if a + 10 > len(s) or s[a + 4] != '-' or s[a + 7] != '-':
            self.fail_at('Invalid date', self.ln, at)
        y = _digits(s, a, a + 4)
        mo = _digits(s, a + 5, a + 7)
        d = _digits(s, a + 8, a + 10)
        if y < 0 or mo < 0 or d < 0:
            self.fail_at('Invalid date', self.ln, at)
        if mo < 1 or mo > 12:
            self.fail_at('Invalid date: the month is out of range', self.ln, at)
        if d < 1 or d > _days_in(y, mo):
            self.fail_at('Invalid date: the day is out of range', self.ln, at)
        m.year = y
        m.month = mo
        m.day = d

    # HH:MM:SS[.frac] at s[a:], up to a Z or offset; returns the index after the time
    def parse_time(self, s: str, a: int, m: Moment, at: int) -> int:
        if a + 8 > len(s) or s[a + 2] != ':' or s[a + 5] != ':':
            self.fail_at('Invalid time', self.ln, at)
        h = _digits(s, a, a + 2)
        mi = _digits(s, a + 3, a + 5)
        sec = _digits(s, a + 6, a + 8)
        if h < 0 or mi < 0 or sec < 0:
            self.fail_at('Invalid time', self.ln, at)
        if h > 23 or mi > 59 or sec > 60:
            self.fail_at('Invalid time: a part is out of range', self.ln, at)
        m.hour = h
        m.minute = mi
        m.second = sec
        j = a + 8
        if j < len(s) and s[j] == '.':
            j += 1
            k = j
            while k < len(s) and _is_digit(s[k]):
                k += 1
            if k == j:
                self.fail_at('Invalid time: no digits after the decimal point', self.ln, at)
            frac = s[j:k]
            if len(frac) > 9:
                frac = frac[:9]
            frac += '0' * (9 - len(frac))
            m.nano = int(frac)
            j = k
        return j

    def parse_datetime(self, tok: str, at: int) -> _Node:
        m = Moment()
        if len(tok) >= 3 and tok[2] == ':':
            m.form = 'local-time'
            j = self.parse_time(tok, 0, m, at)
            if j != len(tok):
                self.fail_at('Invalid time', self.ln, at)
            return _moment_node(m)
        self.parse_date(tok, 0, m, at)
        if len(tok) == 10:
            m.form = 'local-date'
            return _moment_node(m)
        if tok[10] != 'T' and tok[10] != 't':
            self.fail_at('Invalid date-time', self.ln, at)
        j = self.parse_time(tok, 11, m, at)
        m.form = 'local-datetime'
        if j == len(tok):
            return _moment_node(m)
        m.form = 'datetime'
        if tok[j] == 'Z' or tok[j] == 'z':
            if j + 1 != len(tok):
                self.fail_at('Invalid date-time', self.ln, at)
            return _moment_node(m)
        if (tok[j] == '+' or tok[j] == '-') and len(tok) == j + 6 and tok[j + 3] == ':':
            oh = _digits(tok, j + 1, j + 3)
            om = _digits(tok, j + 4, j + 6)
            if oh < 0 or om < 0 or oh > 23 or om > 59:
                self.fail_at('Invalid date-time: the offset is out of range', self.ln, at)
            m.offset = oh * 60 + om
            if tok[j] == '-':
                m.offset = -m.offset
            return _moment_node(m)
        self.fail_at('Invalid date-time', self.ln, at)
        return _moment_node(m)

    # ---- values ----
    def parse_value(self) -> _Node:
        c = self.ch()
        if c == '':
            self.fail('Expected a value')
        v = _Node()
        if c == '"':
            v.kind = 'string'
            if self.starts('"""'):
                v.text = self.multiline_string('"', True)
            else:
                v.text = self.basic_string()
            return v
        if c == "'":
            v.kind = 'string'
            if self.starts("'''"):
                v.text = self.multiline_string("'", False)
            else:
                v.text = self.literal_string()
            return v
        if c == '[':
            return self.parse_array()
        if c == '{':
            return self.parse_inline_table()
        at = self.i
        tok = self.token()
        if tok == '':
            self.fail_at('Invalid value', self.ln, at)
        if tok == 'true' or tok == 'false':
            v.kind = 'boolean'
            v.flag = tok == 'true'
            return v
        # a date and a time written with a space between them are one value
        if len(tok) == 10 and tok[4] == '-' and self.ch() == ' ' and _is_digit(self.at(1)):
            self.i += 1
            tok += 'T' + self.token()
        if len(tok) >= 10 and tok[4] == '-' and _is_digit(tok[0]) or (len(tok) >= 3 and tok[2] == ':'):
            return self.parse_datetime(tok, at)
        return self.parse_number(tok, at)

    def enter(self):
        self.depth += 1
        if self.depth > 500:
            self.fail('Arrays and inline tables are nested too deeply')

    def parse_array(self) -> _Node:
        a = _array()
        a.origin = 'static'
        self.enter()
        self.i += 1
        while True:
            self.skip_ws_nl()
            if self.ch() == ']':
                self.i += 1
                self.depth -= 1
                return a
            a.items.append(self.parse_value())
            self.skip_ws_nl()
            c = self.ch()
            if c == ',':
                self.i += 1
            elif c == ']':
                self.i += 1
                self.depth -= 1
                return a
            else:
                self.fail('Expected a comma or the closing bracket of an array')

    def parse_inline_table(self) -> _Node:
        t = _table()
        t.origin = 'root'
        self.enter()
        self.i += 1
        self.skip_ws()
        if self.ch() == '}':
            self.i += 1
            self.depth -= 1
            t.origin = 'inline'
            return t
        while True:
            self.skip_ws()
            self.parse_keyval(t)
            self.skip_ws()
            c = self.ch()
            if c == ',':
                self.i += 1
            elif c == '}':
                self.i += 1
                self.depth -= 1
                t.origin = 'inline'
                return t
            else:
                self.fail('Expected a comma or the closing brace of an inline table')

    # ---- key/value pairs and headers ----
    def parse_keyval(self, owner: _Node):
        key_ln = self.ln
        key_i = self.i
        parts = self.parse_key()
        if self.ch() != '=':
            self.fail("Expected '=' after a key")
        self.i += 1
        self.skip_ws()
        t = owner
        for k in range(len(parts) - 1):
            p = parts[k]
            if p in t.fields:
                nx = t.fields[p]
                if nx.kind != 'table' or nx.origin != 'dotted':
                    self.fail_at(f'Cannot add to {p}: it is already defined', key_ln, key_i)
                t = nx
            else:
                nx = _table()
                nx.origin = 'dotted'
                t.put(p, nx)
                t = nx
        last = parts[-1]
        if last in t.fields:
            self.fail_at(f'Duplicate key {last}', key_ln, key_i)
        t.put(last, self.parse_value())

    # walk one step of a header path: create an implicit table, or enter the last element of an array of tables
    def descend(self, t: _Node, p: str, ln: int, col: int) -> _Node:
        if p not in t.fields:
            nx = _table()
            nx.origin = 'implicit'
            t.put(p, nx)
            return nx
        nx = t.fields[p]
        if nx.kind == 'table':
            if nx.origin == 'inline':
                self.fail_at(f'Cannot add to {p}: it is an inline table', ln, col)
            return nx
        if nx.kind == 'array' and nx.origin == 'aot':
            return nx.items[-1]
        self.fail_at(f'Cannot add to {p}: it is not a table', ln, col)
        return nx

    def parse_header(self):
        ln = self.ln
        col = self.i
        aot = self.starts('[[')
        if aot:
            self.i += 2
        else:
            self.i += 1
        parts = self.parse_key()
        if aot:
            if not self.starts(']]'):
                self.fail("Expected ']]' to close the array of tables header")
            self.i += 2
        else:
            if self.ch() != ']':
                self.fail("Expected ']' to close the table header")
            self.i += 1
        t = self.root
        for k in range(len(parts) - 1):
            t = self.descend(t, parts[k], ln, col)
        last = parts[-1]
        if aot:
            if last not in t.fields:
                a = _array()
                a.origin = 'aot'
                t.put(last, a)
            a = t.fields[last]
            if a.kind != 'array' or a.origin != 'aot':
                self.fail_at(f'Cannot redefine {last} as an array of tables', ln, col)
            nt = _table()
            nt.origin = 'header'
            a.items.append(nt)
            self.cur = nt
            return
        if last not in t.fields:
            nt = _table()
            nt.origin = 'header'
            t.put(last, nt)
            self.cur = nt
            return
        nx = t.fields[last]
        if nx.kind == 'table' and nx.origin == 'implicit':
            nx.origin = 'header'
            self.cur = nx
            return
        self.fail_at(f'Cannot redefine the table {last}', ln, col)

    def parse(self) -> _Node:
        while self.ln < len(self.lines):
            self.skip_ws()
            c = self.ch()
            if c == '[':
                self.parse_header()
            elif c != '' and c != '#':
                self.parse_keyval(self.cur)
            if c != '':
                self.skip_ws()
                self.skip_comment()
                if self.i < self.n:
                    self.fail('Expected a newline or the end of the document after a statement')
            elif c == '#':
                self.skip_comment()
            self.load(self.ln + 1)
        return self.root

export def loads(text: str) -> Value:
    p = _Parser(text)
    return _to_value(p.parse())

export def load(path: str) -> Value:
    f = open(path, 'r')
    text = f.read()
    f.close()
    return loads(text)

# ---------------------------------------------------------------------------------------------------------------------
# dumps

def _escape(s: str) -> str:
    out: list[str] = []
    for c in s:
        o = ord(c)
        if c == '"':
            out.append('\\"')
        elif c == '\\':
            out.append('\\\\')
        elif c == '\n':
            out.append('\\n')
        elif c == '\t':
            out.append('\\t')
        elif c == '\r':
            out.append('\\r')
        elif o == 8:
            out.append('\\b')
        elif o == 12:
            out.append('\\f')
        elif o < 32 or o == 127:
            h = '0123456789abcdef'
            out.append('\\u00' + h[o // 16] + h[o % 16])
        else:
            out.append(c)
    return '"' + ''.join(out) + '"'

def _key_text(k: str) -> str:
    if len(k) == 0:
        return '""'
    for c in k:
        if not _is_bare(c):
            return _escape(k)
    return k

def _path_text(path: list[str]) -> str:
    parts: list[str] = []
    for p in path:
        parts.append(_key_text(p))
    return '.'.join(parts)

# a float as str() writes it (1e+400 beyond a double, D77d); 0x1.8p+E (an exponent of more than 4096 bits) is not TOML
def _float_text(v: Value) -> str:
    if v is Float and v.special != '':
        return v.special
    s = str(v.as_float())
    if 'x' in s:
        raise ValueError(f'the float {s} has an exponent too large to write in decimal, as TOML needs', 'E527')
    if '.' not in s and 'e' not in s and 'E' not in s:
        s += '.0'
    return s

# a value written on one line
def _inline(v: Value) -> str:
    k = v.kind()
    if k == 'str':
        return _escape(v.as_str())
    if k == 'int':
        return str(v.as_int())
    if k == 'float':
        return _float_text(v)
    if k == 'bool':
        if v.as_bool():
            return 'true'
        return 'false'
    if k == 'list':
        parts: list[str] = []
        for x in v.as_list():
            parts.append(_inline(x))
        return '[' + ', '.join(parts) + ']'
    if k == 'dict':
        fields = v.as_dict()
        if len(fields) == 0:
            return '{}'
        pairs: list[str] = []
        for key in fields:
            pairs.append(_key_text(key) + ' = ' + _inline(fields[key]))
        return '{ ' + ', '.join(pairs) + ' }'
    if k == 'null' or k == 'bin' or k == 'ext' or k == 'timestamp':
        raise ValueError(f'{v.what()} value cannot be written as TOML', 'E620')
    return v.as_moment().moment_text()

# an array that is written as [[name]] sections: not empty, and every item a table
def _is_table_array(v: Value) -> bool:
    if v.kind() != 'list' or len(v) == 0:
        return False
    for x in v.as_list():
        if x.kind() != 'dict':
            return False
    return True

def _dump_table(t: Value, path: list[str], out: list[str]):
    fields = t.as_dict()
    for k in fields:
        v = fields[k]
        if v.kind() != 'dict' and not _is_table_array(v):
            out.append(_key_text(k) + ' = ' + _inline(v))
    for k in fields:
        v = fields[k]
        if v.kind() == 'dict':
            sub = path + [k]
            plain = False
            inner = v.as_dict()
            for k2 in inner:
                v2 = inner[k2]
                if v2.kind() != 'dict' and not _is_table_array(v2):
                    plain = True
            if plain or len(inner) == 0:
                if len(out) > 0:
                    out.append('')
                out.append('[' + _path_text(sub) + ']')
            _dump_table(v, sub, out)
        elif _is_table_array(v):
            sub = path + [k]
            for x in v.as_list():
                if len(out) > 0:
                    out.append('')
                out.append('[[' + _path_text(sub) + ']]')
                _dump_table(x, sub, out)

export def dumps_value(v: Value) -> str:
    if v.kind() == 'dict':
        out: list[str] = []
        _dump_table(v, [], out)
        if len(out) == 0:
            return ''
        return '\n'.join(out) + '\n'
    return _inline(v)

export def dumps(value: Value) -> str:
    if value.kind() != 'dict':
        raise ValueError('dumps needs a table: a TOML document is a table of keys', 'E70')
    return dumps_value(value)

# dump(value, path) writes dumps(value) to the file at path (replacing it), the counterpart of load(path). An unwritable
# path raises IOError; a value that is not a table raises RuntimeError before the file is touched.
export def dump(value: Value, path: str):
    text = dumps(value)
    f = open(path, 'w')
    f.write(text)
    f.close()
