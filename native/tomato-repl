#!/bin/bash
# tomato repl [FILE ...]: type Tomato one piece at a time. It needs only the Tomato compiler and clang.
#
# A function or class defined in the repl cannot read your variables: statements run inside main() as locals, while
# definitions are module level. Pass what a function needs as arguments.
# An error shows the piece you typed: what is wrong, --> repl:LINE:COL, your line and a caret (the format of docs/errors.md).
# Every piece you enter is added to the session. The session is a program (your definitions, then your statements), and
# each time it is compiled with tomato and run from the top; only the output that is new is shown, so earlier lines do
# not print twice. A bare expression shows its value. Because the whole session re-runs, a line with a side effect
# outside the program (writing a file, say) happens again with every later line.
#
# Defining a function, class or interface again replaces the earlier one (a recalled def, edited, or :load of a file you changed). The
# session runs again from the top, so everything that used the old definition uses the new one, including the values that earlier lines
# made (an object of an old class is built again by the new class). If an earlier line or definition does not work with the new one (a
# parameter or a field that is gone, say), the new definition is refused with that error and the old one stays. A redefinition shows
# no output of its own: what the earlier lines printed was shown when they ran. A variable declared again (`x: int = 2`) replaces
# its earlier declaration; if the new line is refused, the old variable and its value are still there.
#
# Editing: Up and Down recall earlier pieces, a block as a whole; the arrows move within it and between its lines. Enter runs the
# piece when it is complete (a block ends at an empty line; an open bracket goes on to the next line), Tab completes a name (keywords,
# built-ins, what the session uses, standard modules after import, :commands) or indents, Ctrl-C cancels. The
# code is colored as you type it (keywords red, texts green, ...) on a terminal with colors: --color=always|never, TOMATO_COLOR and
# NO_COLOR decide, as for the error colors.
#
#   :load FILE     add a file's definitions and statements      :program   show the session as one program
#   :save FILE     write the session program to FILE            :compile   print the session's LLVM IR
#   :reset         forget everything                            :help      this text
#   :quit          leave (also leave(), exit(), quit() and Ctrl-D)
tomato="${TOMATO_CMD:-tomato}"
# the session runs with standard error captured (its errors are shown by the repl), so a progress bar draws on the terminal instead
[ -t 2 ] && export TOMATO_PROGRESS_TTY=1
S="$(mktemp -d)" || { echo "error: cannot make a temporary folder" >&2; exit 1; }
trap 'rm -rf "$S"' EXIT
trap 'exit 130' INT; trap 'exit 143' TERM; trap 'exit 129' HUP      # the session folder goes on Ctrl-C, SIGTERM and hangup too
mkdir -p "$S/d"
# Speed: the runtime is compiled to an object once, and each line then costs one tomatoc run plus a quick unoptimized
# link, instead of compiling the whole runtime with optimization on every line.
tomatoc="${TOMATO_TOMATOC:-}"; runtime="${TOMATO_RUNTIME:-}"; std="${TOMATO_STD:-}"
jsc="${TOMATO_JSC:-/System/Library/Frameworks/JavaScriptCore.framework/Versions/A/Helpers/jsc}"
wasmdir="${TOMATO_WASM:-}"
fast=0
if [ -x "$jsc" ] && [ -f "$wasmdir/tomatoc.wasm" ] && [ -f "$wasmdir/current" ] && [ -f "${TOMATO_JSC_JS:-}" ]; then fast=2   # no new native program per line (see tomato-jsc.js)
elif [ -x "$tomatoc" ] && [ -f "$runtime" ] && clang -O0 -w -pthread -c -o "$S/rt.o" "$runtime" 2>/dev/null; then fast=1; fi
: > "$S/stmts"; : > "$S/shown"; : > "$S/inputs"; seq=0

say() { printf '%s\n' "$*"; }
# red errors when standard error is a terminal (TOMATO_COLOR=always or never, and NO_COLOR, decide too; see `tomato help`); the programs the
# session runs write plain text, which friendly and err then paint
repl_color=0
case "${TOMATO_COLOR:-auto}" in
  always) repl_color=1 ;;
  never) ;;
  *) [ -z "${NO_COLOR:-}" ] && [ "${TERM:-}" != dumb ] && [ -t 2 ] && repl_color=1 ;;
esac
color_mode="${TOMATO_COLOR:-auto}"; case "$color_mode" in always|never) ;; *) color_mode=auto ;; esac   # for the line editor
export TOMATO_COLOR=never
err() { if [ $repl_color = 1 ]; then printf '%s\n' "$*" | "$tomato" paint >&2; else printf '%s\n' "$*" >&2; fi; }

# Split text on stdin into declarations (to $1) and statements (to $2): a top-level line starting with def, class,
# interface, from, import, export, @ or ! (or "X implements Y") starts a declaration, and the lines indented under it
# belong to it; anything else is a statement.
split() {
  awk -v D="$1" -v B="$2" '
    function isdecl(l) { return l ~ /^(def|class|interface|from|import|export)[ (]/ || l ~ /^async def / || l ~ /^[@!]/ || l ~ /^[A-Za-z_][A-Za-z_0-9]* implements / }
    { l = $0 }
    l ~ /^[ \t]/ || l ~ /^[ \t]*$/ || l ~ /^#/ { if (cur == "d") print l >> D; else if (cur == "b") print l >> B; next }
    { if (afterat) { print l >> D; afterat = 0; next }
      if (isdecl(l)) { cur = "d"; print l >> D; if (l ~ /^@/) afterat = 1 }
      else { cur = "b"; print l >> B } }
  '
}

# A declaration is kept in a file of its own, d/NNNN_NAME (NAME: the function, class or interface it defines, or -N for the others,
# such as an import). A piece that defines a name again replaces the earlier declaration of it: REDEF holds those names (one per line)
# while the piece is tried and committed, and redefined says whether a declaration file is one of them.
REDEF=""
declname() { b="${1##*/}"; printf '%s\n' "${b#*_}"; }
redefined() { case "
$REDEF" in *"
$(declname "$1")
"*) return 0 ;; esac; return 1; }
# The declarations in file $1, one file each in $S/ch (1, 2, ...) and, in $S/ch/keys, the name each one defines ("-": none).
decl_chunks() {
  rm -rf "$S/ch"; mkdir "$S/ch"
  awk -v DIR="$S/ch" '
    function key(l,   m) { sub(/^export +/, "", l); if (!match(l, /^(async +)?(def|class|interface) +[A-Za-z_0-9]+/)) return "-"; m = substr(l, RSTART, RLENGTH); sub(/^(async +)?(def|class|interface) +/, "", m); return m }
    { top = ($0 !~ /^[ \t]/ && $0 !~ /^[ \t]*$/ && $0 !~ /^#/); at = (substr($0, 1, 1) == "@")
      if (top && !afterat) { if (n > 0) close(f); n++; f = DIR "/" n; k[n] = at ? "-" : key($0); afterat = at }
      else if (top) { k[n] = key($0); afterat = 0 }
      if (n > 0) print $0 >> f }
    END { for (i = 1; i <= n; i++) print k[i] > (DIR "/keys") }
  ' "$1"
}

program() {   # the session as one program on stdout
  for f in "$S"/d/*; do [ -f "$f" ] && ! redefined "$f" && { cat "$f"; echo; }; done
  echo "@main"; echo "$(main_kw "$S/stmts") tomato_repl_main():"
  if [ -s "$S/stmts" ]; then sed 's/^/    /' "$S/stmts"; else echo "    pass"; fi
}

# the session runs inside one function; it must be async when a statement awaits, starts a task or loops over statuses
main_kw() { if grep -Eq '(^|[^A-Za-z0-9_])(await|async|start) ' "$1"; then echo "async def"; else echo "def"; fi; }

# Run a candidate (declaration text in $1 file, statement text in $2 file) on top of the session, once. RUN_RC is the program's exit code.
# The answers given to input so far are its standard input (one per line), and TOMATO_INPUT_ASK makes it stop with 75 when it wants one more.
try_once() {
  cp "$S/stmts" "$S/stmts.try"; cat "$2" >> "$S/stmts.try"
  # where the new piece sits in the generated program, so an error can be shown against what the user typed (see friendly)
  prev=0; for f in "$S"/d/*; do [ -f "$f" ] && ! redefined "$f" && prev=$((prev + $(wc -l < "$f") + 1)); done
  DECL_FILE="$1"; STMT_FILE="$2"; DECL_BASE=$((prev + 1)); DECL_N=0; total=$prev
  if [ -s "$1" ]; then DECL_N=$(wc -l < "$1"); total=$((prev + DECL_N + 1)); fi
  PREV_N=$(wc -l < "$S/stmts"); PREV_BASE=$((total + 3)); STMT_BASE=$((PREV_BASE + PREV_N)); STMT_N=$(wc -l < "$2")
  { for f in "$S"/d/*; do [ -f "$f" ] && ! redefined "$f" && { cat "$f"; echo; }; done
    [ -s "$1" ] && { cat "$1"; echo; }
    echo "@main"; echo "$(main_kw "$S/stmts.try") tomato_repl_main():"
    if [ -s "$S/stmts.try" ]; then sed 's/^/    /' "$S/stmts.try"; else echo "    pass"; fi
  } > "$S/try.tom"
  if [ $fast = 2 ]; then
    "$jsc" "$TOMATO_JSC_JS" -- "$wasmdir" run "$S/try.tom" "$S/inputs.try" ask > "$S/out" 2> "$S/err"
    rc=$(sed -n 's/^~rc //p' "$S/err" | tail -1); grep -v -e '^~rc ' -e '^Could not open file: ' "$S/err" | sed -e 's/ (raised on line [0-9]*)//' -e '/^  at /d' -e '/^  \.\.\. and /d' > "$S/err2"; mv "$S/err2" "$S/err"
    RUN_RC="$rc"
    if [ "$rc" = 75 ]; then   # jsc added a newline after the prompt
      sz=$(wc -c < "$S/out" | tr -d ' '); [ "$sz" -gt 0 ] && head -c $((sz - 1)) "$S/out" > "$S/out2" && mv "$S/out2" "$S/out"
    fi
    [ -n "$rc" ] && [ "$rc" = 0 ]; return
  elif [ $fast = 1 ]; then
    if ! "$tomatoc" "$S/try.tom" main "$std" > "$S/try.ll" 2> "$S/err"; then
      : > "$S/out"; return 1
    fi
    clang -O0 -w -o "$S/try" "$S/try.ll" "$S/rt.o" -pthread -lm $([ "$(uname)" = Linux ] && echo -ldl) 2> "$S/err" || return 1   # -ldl as native/tomato links: older glibc keeps dlopen in libdl
    TOMATO_INPUT_ASK=1 "$S/try" < "$S/inputs.try" > "$S/out" 2> "$S/err"; rc=$?
    RUN_RC=$rc
    sed -e 's/ (raised on line [0-9]*)//' -e '/^  at /d' -e '/^  \.\.\. and /d' "$S/err" > "$S/err2"; mv "$S/err2" "$S/err"
    return $rc
  else
    TOMATO_INPUT_ASK=1 "$tomato" run "$S/try.tom" --no-warnings < "$S/inputs.try" > "$S/out" 2> "$S/err"; RUN_RC=$?
    return $RUN_RC
  fi
}

# Run the candidate; each time the program wants input there is no answer for, show what it printed so far (ending with its
# prompt), read the answer and run it again with that answer added (the earlier answers are replayed, so nothing asks twice).
try_run() {
  cp "$S/inputs" "$S/inputs.try"; cp "$S/shown" "$S/shown.try"; asked=0
  while :; do
    try_once "$1" "$2"; ok=$?
    if [ "$RUN_RC" = 75 ]; then
      asked=1
      new_output "$S/shown.try"
      cp "$S/out" "$S/shown.try"
      if ! readline ""; then echo; : > "$S/err"; cp "$S/shown.try" "$S/shown"; return 1; fi
      printf '%s\n' "$REPLY_LINE" >> "$S/inputs.try"
      [ $interactive = 0 ] && say "$REPLY_LINE"
      printf '%s\n' "$REPLY_LINE" >> "$S/shown.try"
      continue
    fi
    [ $asked = 1 ] && cp "$S/shown.try" "$S/shown"
    return $ok
  done
}

# Show a compiler error against what the user typed. The compiler names a line and column of the generated program; this
# maps them back to the piece just entered (its definitions, or its statements, which the session indents four spaces)
# and shows that piece's own text, in the same format as `tomato run`: error, --> repl:LINE:COL, the source line, a caret.
friendly() { if [ $repl_color = 1 ]; then friendly_plain | "$tomato" paint >&2; else friendly_plain >&2; fi; }
friendly_plain() {   # reads $S/err, prints the message on stderr; writes "in-definition" to $S/where when the error is in a definition
  : > "$S/where"
  sed -e "s#$S/[^ :]*/*##g" "$S/err" | awk -v D0="$DECL_BASE" -v DN="$DECL_N" -v S0="$STMT_BASE" -v SN="$STMT_N" -v DF="$DECL_FILE" -v SF="$STMT_FILE" -v W="$S/where" -v P0="$PREV_BASE" -v PN="$PREV_N" -v PF="$S/stmts" '
    function digits(n) { return length(n ""); }
    function sp(n,   s) { s = ""; while (n-- > 0) s = s " "; return s; }
    { l[NR] = $0 }
    END {
      h = 0
      for (i = 1; i <= NR; i++) if (l[i] ~ /^ *--> .*:[0-9]+:[0-9]+$/) { h = i; break }
      mapped = 0
      if (h > 0) {
        loc = l[h]; sub(/^ *--> /, "", loc); n = split(loc, p, ":"); L = p[n-1] + 0; C = p[n] + 0
        if (DN > 0 && L >= D0 && L < D0 + DN) { file = DF; ul = L - D0 + 1; uc = C; mapped = 1; print "in-definition" > W }
        else if (L >= S0 && L < S0 + SN) { file = SF; ul = L - S0 + 1; uc = C - 4; mapped = 1 }
        else if (L >= P0 && L < P0 + PN) { file = PF; ul = L - P0 + 1; uc = C - 4; mapped = 1; name = "session" }   # an earlier line of the session, which a redefinition broke
        if (mapped) {
          k = 0; while ((getline t < file) > 0) { k++; if (k == ul) { src = t; break } } close(file)
          if (uc < 1) uc = 1
          car = l[h + 3]; w = gsub(/\^/, "^", car); if (w < 1) w = 1
          pad = sp(digits(ul)); carets = ""; for (j = 0; j < w; j++) carets = carets "^"
        }
      }
      for (i = 1; i <= NR; i++) {
        if (h > 0 && i >= h && i <= h + 3) {
          if (!mapped) continue
          if (i == h) print pad "--> " (name == "" ? "repl" : name) ":" ul ":" uc
          else if (i == h + 1) print pad " |"
          else if (i == h + 2) print ul " | " src
          else print pad " | " sp(uc - 1) carets
          continue
        }
        x = l[i]
        if (h > 0 && mapped) sub(/^ *= help:/, pad " = help:", x)
        else if (h > 0) sub(/^ *= help:/, "  = help:", x)
        print x
      }
    }'
}


new_output() {  # print the part of $S/out that is not in the previous output ($1, default $S/shown)
  prev_out="${1:-$S/shown}"
  have=$(wc -c < "$prev_out" | tr -d ' ')
  if [ "$have" -gt 0 ] && head -c "$have" "$S/out" | cmp -s - "$prev_out"; then tail -c +$((have + 1)) "$S/out" > "$S/new"; else cat "$S/out" > "$S/new"; fi
  cat "$S/new"
}
# the line editor draws its prompt from the start of the line: end a last line the program left open (print(x, end=''))
end_open_line() { [ "${use_edit:-0}" = 1 ] && [ -s "$S/new" ] && [ -n "$(tail -c 1 "$S/new" | tr -d '\n')" ] && echo; return 0; }

commit() {   # the candidate worked: keep it ($S/ch holds its declarations, one file each; see decl_chunks)
  cat "$S/stmts.try" > "$S/stmts"
  if [ -s "$1" ]; then
    for f in "$S"/d/*; do [ -f "$f" ] && redefined "$f" && rm -f "$f"; done   # a name defined again replaces the earlier declaration
    i=0
    while IFS= read -r key; do
      i=$((i + 1)); seq=$((seq + 1))
      [ "$key" = - ] && key="-$seq"
      cp "$S/ch/$i" "$S/d/$(printf '%04d' $seq)_$key"
    done < "$S/ch/keys"
  fi
  cp "$S/out" "$S/shown"; cp "$S/inputs.try" "$S/inputs"
}

# the output of a candidate that is kept or refused. A redefinition runs the earlier lines again with the new definition, so the part
# of the output that is "new" cannot be told from them: it shows nothing (what the earlier lines printed was shown when they ran).
show_new() { [ -n "$REDEF" ] || { new_output; end_open_line; }; }
# a refused candidate: the compiler's error against what was typed; for a redefinition, also why the old definition is still there
refused() {
  show_new
  friendly
  grep -q "^in-definition" "$S/where" 2>/dev/null && grep -q "is not defined" "$S/err" 2>/dev/null && err "hint: a function or class defined here cannot read repl variables; pass them as arguments"
  if [ -n "$REDEF" ] && ! grep -q "^in-definition" "$S/where" 2>/dev/null; then
    err "hint: the earlier lines of the session run again with the new $(printf '%s' "$REDEF" | paste -sd, - | sed 's/,/, /g'), and one of them does not work with it; the earlier definition is kept"
  fi
  [ -f "$S/stmts.keep" ] && cp "$S/stmts.keep" "$S/stmts"   # a redeclared variable that is refused: the old declaration stays, with its value
  REDEF=""      # the session is as it was: program and the completer see the earlier definition again
}

submit() {   # one piece of source text in $1
  : > "$S/cd"; : > "$S/cb"; rm -f "$S/stmts.keep"
  printf '%s\n' "$1" | split "$S/cd" "$S/cb"
  # a redeclared variable replaces its earlier declaration
  if [ -s "$S/cb" ]; then
    name=$(head -1 "$S/cb" | sed -nE 's/^([A-Za-z_][A-Za-z_0-9]*) *:[^=]*=.*/\1/p')
    if [ -n "$name" ]; then cp "$S/stmts" "$S/stmts.keep"; grep -vE "^$name *:" "$S/stmts" > "$S/stmts.n"; cp "$S/stmts.n" "$S/stmts"; fi
  fi
  # a name that is defined again replaces its earlier definition (see REDEF); the new definition goes first, alone, so a mixed piece's
  # output is only its own statements
  REDEF=""
  if [ -s "$S/cd" ]; then
    decl_chunks "$S/cd"
    while IFS= read -r key; do
      [ "$key" = - ] && continue
      for f in "$S"/d/*; do [ -f "$f" ] && [ "$(declname "$f")" = "$key" ] && { REDEF="$REDEF$key
"; break; }; done
    done < "$S/ch/keys"
  fi
  if [ -n "$REDEF" ] && [ -s "$S/cb" ]; then
    : > "$S/empty"
    if try_run "$S/cd" "$S/empty"; then commit "$S/cd"; REDEF=""; : > "$S/cd"; else refused; return; fi
  fi
  if [ ! -s "$S/cd" ] && [ -s "$S/cb" ]; then
    first=$(head -1 "$S/cb")
    # a bare expression shows its value
    if printf '%s' "$first" | grep -qvE '^(print|for|while|if|elif|else|try|catch|finally|raise|assert|return|pass|break|continue)([ (:]|$)' \
       && ! printf '%s' "$first" | grep -qE '^[A-Za-z_][A-Za-z_0-9]*( *:[^=]+)? *([-+*/%&|^]|//|\*\*)?= *[^=]' \
       && [ "$(wc -l < "$S/cb" | tr -d ' ')" = 1 ] && ! printf '%s' "$first" | grep -q ':$'; then
      printf 'print(%s)\n' "$first" > "$S/ce"
      if try_run "$S/cd" "$S/ce"; then new_output; end_open_line; commit "$S/cd"; return; fi
    fi
  fi
  if try_run "$S/cd" "$S/cb"; then show_new; commit "$S/cd"; REDEF=""; else refused; fi
}

load_file() {
  [ -f "$1" ] || { err "error: cannot read $1"; return; }
  text="$(cat "$1")"
  # A file with its own @main would clash with the @main the repl generates (the website's wrapMain also leaves such a
  # program alone): drop the marker and call that function, so loading a program runs it.
  entry="$(printf '%s\n' "$text" | awk '/^@main[ \t]*$/ { getline; sub(/^(async )?def /, ""); sub(/\(.*/, ""); print; exit }')"
  if [ -n "$entry" ]; then
    text="$(printf '%s\n' "$text" | grep -v '^@main[[:space:]]*$')"
    submit "$text" && submit "$entry()"
  else
    submit "$text"
  fi
}

help() { awk 'NR > 1 { if ($0 !~ /^#/) exit; sub(/^# ?/, ""); print }' "$0"; }   # the comment block at the top of this file

interactive=0; [ -t 0 ] && interactive=1
# The line editor (tomato-repl-edit, built from compiler/src/repledit.tom by install-native.sh; native/tomato sets TOMATO_REPL_EDIT): it
# reads a whole piece on the terminal (Up and Down recall whole blocks from the history file, the arrows move between lines, Enter runs
# the piece when it is complete) and prints it. It is used when standard input is a terminal and TERM is not dumb. Its exit status:
# 0 the piece is on its standard output, 10 Ctrl-D (leave), 11 Ctrl-C (a new prompt); anything else means it failed, and the repl goes
# on with plain input (read -e: no history, a block typed line by line) for the rest of the session, after saying so once.
edit="${TOMATO_REPL_EDIT:-}"; hist="${TOMATO_HISTORY:-$HOME/.tomato/repl_history_v2}"; use_edit=0
plain_note() { printf '%s\n' "the line editor is not available; using plain input" >&2; }
if [ $interactive = 1 ] && [ "${TERM:-}" != dumb ]; then
  if [ -n "$edit" ] && [ -x "$edit" ]; then use_edit=1; else plain_note; fi
fi
for f in "$@"; do load_file "$f"; done
# plain input (no editor, and the answers to input()): read -e gives the arrow keys within a line. Tab inserts an indent: readline's own file-completion would list
# the directory, and bind in a script is not enough (bash 3.2 ignores it), so readline gets a private inputrc.
if [ $interactive = 1 ]; then { printf '%s\n' '$include /etc/inputrc'; user="${INPUTRC:-$HOME/.inputrc}"; [ -f "$user" ] && printf '%s\n' "\$include $user"; printf '%s\n' '"\t": "    "' 'set bell-style none'; } > "$S/inputrc"; export INPUTRC="$S/inputrc"; fi
readline() {   # readline PROMPT [INITIAL TEXT] -> sets $REPLY_LINE
  if [ $interactive = 1 ]; then
    if [ "${BASH_VERSINFO[0]}" -ge 4 ]; then IFS= read -r -e -p "$1" -i "$2" REPLY_LINE || return 1   # macOS ships bash 3.2, which has no -i: there Tab inserts the indent
    else IFS= read -r -e -p "$1" REPLY_LINE || return 1; fi
  else IFS= read -r REPLY_LINE || return 1; fi
}

[ $interactive = 1 ] && say "Tomato repl (each line re-runs the whole session, so file writes repeat). :help for commands, :quit or Ctrl-D to leave."

while :; do
  if [ $use_edit = 1 ]; then
    program > "$S/session.tom"     # the names the session uses, for Tab completion
    text="$(TOMATO_COLOR="$color_mode" "$edit" --history "$hist" --session "$S/session.tom" --color="$color_mode")"; rc=$?
    case $rc in
      0) ;;
      10) break ;;
      11) continue ;;
      *) use_edit=0; [ $rc -ge 128 ] && echo; plain_note; continue ;;   # (killed by a signal: it may have left its prompt on the line)
    esac
  else
    readline '>>> ' || { [ $interactive = 1 ] && echo; break; }
    text="$REPLY_LINE"
  fi
  case "$text" in
    *"
"*) ;;   # a block from the editor (a command is one line)
    "") continue ;;
    :quit|:q|:exit|"leave()"|"exit()"|"quit()") break ;;
    :help) help; continue ;;
    :reset) rm -f "$S"/d/*; : > "$S/stmts"; : > "$S/shown"; : > "$S/inputs"; say "session cleared"; continue ;;
    :program) program; continue ;;
    :compile) program > "$S/p.tom"; "$tomato" compile "$S/p.tom"; continue ;;
    :save\ *) program > "${text#:save }" && say "wrote ${text#:save }"; continue ;;
    :load\ *) load_file "${text#:load }"; continue ;;
    :*) err "error: unknown command ${text%% *} (try :help)"; continue ;;
  esac
  if [ $use_edit = 0 ]; then
    case "$text" in *:|@*)
      # a block: read lines until an empty one; each line starts with the previous line's indent (four more after a colon)
      prev="$text"
      while :; do
        indent="$(printf '%s' "$prev" | sed 's/^\([ ]*\).*/\1/')"
        case "$prev" in *:) indent="$indent    " ;; esac
        readline '... ' "$indent" || break
        more="$REPLY_LINE"
        [ -z "$(printf '%s' "$more" | tr -d ' ')" ] && break
        prev="$more"
        text="$text
$more"
      done ;;
    esac
  fi
  submit "$text"
done

exit 0
