           addusage="usage: tomato seed add --path DIR | --git URL (--rev COMMIT | --tag TAG | --branch BRANCH) [--subdir DIR] [--test] [--yes] [--offline]"
           while [ $# -gt 0 ]; do
             case "$1" in
               --path) [ $# -ge 2 ] || die "--path needs a folder ($addusage)"; arg="$2"; mode_set=$((mode_set + 1)); shift ;;
               --git) [ $# -ge 2 ] || die "--git needs a URL ($addusage)"; arg="$2"; mode_set=$((mode_set + 10)); shift ;;
               --rev) [ $# -ge 2 ] || die "--rev needs a commit id"; arev="$2"; shift ;;
               --tag) [ $# -ge 2 ] || die "--tag needs a tag name"; atag="$2"; shift ;;
               --branch) [ $# -ge 2 ] || die "--branch needs a branch name"; abranch="$2"; shift ;;
               --subdir) [ $# -ge 2 ] || die "--subdir needs a folder of the repository"; asub="$2"; shift ;;
