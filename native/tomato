#!/bin/sh
# The `tomato` command, built on the Tomato compiler written in Tomato (tomatoc). Needs only clang.
#   tomato run FILE [ENTRY [INPUTS...]] [--llvm FILE.ll ...]   compile, link and run a program
#   tomato build FILE [-o OUT] [--entry NAME] [--llvm FILE.ll ...]   write a native program
#   tomato compile FILE [--entry NAME]                         print the LLVM IR
#   tomato version
src="$0"
while [ -L "$src" ]; do
  dir=$(cd "$(dirname "$src")" && pwd)
  src=$(readlink "$src")
  case "$src" in /*) ;; *) src="$dir/$src" ;; esac
done
home="$(cd "$(dirname "$src")/.." && pwd)"
tomatoc="$home/bin/tomatoc"
runtime="$home/runtime/tomato_rt.c"
std="$home/std/"
usage() { sed -n '2,6p' "$src" | sed 's/^# \{0,1\}//' >&2; exit 2; }
die() { echo "error: $*" >&2; exit 1; }

cmd="$1"; [ -n "$cmd" ] || usage; shift
case "$cmd" in
  version) echo "Tomato (compiler written in Tomato)"; exit 0 ;;
  run|build|compile) ;;
  *) usage ;;
esac

nl="
"
file=""; entry=""; out=""; llvm=""; inputs=""
# the words after FILE: for run, ENTRY then inputs; for build/compile, flags
[ $# -ge 1 ] || usage
file="$1"; shift
[ -f "$file" ] || die "cannot read $file"
positional=""
while [ $# -gt 0 ]; do
  case "$1" in
    -o) [ $# -ge 2 ] || usage; out="$2"; shift 2 ;;
    --entry) [ $# -ge 2 ] || usage; entry="$2"; shift 2 ;;
    --llvm) [ $# -ge 2 ] || usage; llvm="$llvm$2$nl"; shift 2 ;;
    *) positional="$positional
$1"; shift ;;
  esac
done

nl='
'
if [ "$cmd" = run ]; then
  # the first positional word is the entry point, the rest are inputs
  entry="${entry:-main}"
  first=1
  OLDIFS="$IFS"; IFS="$nl"
  for w in $positional; do
    if [ $first = 1 ]; then entry="$w"; first=0; else inputs="$inputs$w$nl"; fi
  done
  IFS="$OLDIFS"
else
  [ -z "$positional" ] || usage
  entry="${entry:-main}"
fi

tmp="$(mktemp -d)"; trap 'rm -rf "$tmp"' EXIT
if ! "$tomatoc" "$file" "$entry" "$std" > "$tmp/program.ll" 2> "$tmp/errors"; then
  sed -e 's/^error: line [0-9]*: uncaught error \([A-Za-z]*\): line \([0-9]*\): /\1 on line \2: /' -e 's/^error: line [0-9]*: uncaught error \([A-Za-z]*\): /\1: /' "$tmp/errors" >&2
  exit 1
fi
[ "$cmd" = compile ] && { cat "$tmp/program.ll"; exit 0; }
exe="$tmp/program"
[ "$cmd" = build ] && exe="${out:-$(basename "${file%.tom}")}"
set -- clang -O1 -Wno-override-module -o "$exe" "$tmp/program.ll"
OLDIFS="$IFS"; IFS="$nl"
for f in $llvm; do set -- "$@" "$f"; done
IFS="$OLDIFS"
set -- "$@" "$runtime" -lm
"$@" || exit 1
[ "$cmd" = build ] && { echo "wrote $exe"; exit 0; }
OLDIFS="$IFS"; IFS="$nl"
set --
for w in $inputs; do set -- "$@" "$w"; done
IFS="$OLDIFS"
"$exe" "$@"
