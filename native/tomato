    # after it is a file, the entry or raw input, even a word that starts with - (`tomato test x.tom e --filter` passes --filter to e).
    # `--` ends the options earlier, and the next word is still the first file.
    while [ $# -gt 0 ]; do
      case "$1" in
        --) shift; break ;;
        --filter) [ $# -ge 2 ] || die_usage "$1 needs a value"; tfilter="$2"; shift 2 ;;
        --mode) [ $# -ge 2 ] || die_usage "$1 needs a value"; tmode="$2"; shift 2 ;;
        --timeout) [ $# -ge 2 ] || die_usage "$1 needs a value"; ttimeout="$2"; shift 2 ;;
