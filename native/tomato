    add_file() { k=$((k + 1)); printf '%s|%s\n' "$k" "$1" >> "$tmpd/list"; : > "$tmpd/args.$k"; : > "$tmpd/entry.$k"; }
    if [ $# -eq 0 ]; then
      if [ -d tests ]; then
        set -- tests
      else
        # from a folder below the project's (src/, say), as run and build do: the tests/ of the folder that holds the nearest tomato.toml
        find_config .
        troot=""; [ -z "$project_cfg" ] || troot="$(dirname "$project_cfg")"
        [ -z "$troot" ] || [ -d "$troot/tests" ] || die "the project in $troot has no tests folder: run tomato test FILE..., or put test files in $troot/tests/ (each tests/NAME.tom is one test)"
        [ -n "$troot" ] || die "no tests folder here: run tomato test FILE..., or put test files in tests/ (each tests/NAME.tom is one test)"
        set -- "$troot/tests"
      fi
    fi
    while [ $# -gt 0 ]; do
      a="$1"; shift
      if [ -d "$a" ]; then
        any=0
        for f in "${a%/}"/*.tom; do
          [ -f "$f" ] || continue
          case "$(basename "$f")" in _*) continue ;; esac
          add_file "$f"; any=1
        done
