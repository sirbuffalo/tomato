             1) [ -z "$arev$atag$abranch$asub" ] || die "--rev, --tag, --branch and --subdir go with --git, not with --path" ;;
             10) n=0; [ -z "$arev" ] || n=$((n + 1)); [ -z "$atag" ] || n=$((n + 1)); [ -z "$abranch" ] || n=$((n + 1))
                 [ "$n" = 1 ] || die "a git seed needs one of --rev COMMIT (the full commit id), --tag TAG or --branch BRANCH ($addusage)"
                 seedopt git
