    nfiles=0; npassed=0; nfailed=0; nskipped=0; status=0
    # run_prog: the program and its words, the output in $out, with the time limit when there is one; sets prc (its status) and timed_out.
    # A test reads no input: its standard input is /dev/null, with or without --timeout (a test that asks for input sees the end of it
    # at once instead of waiting on the terminal).
    # proc_tree PID: PID and every process below it (what a test started with sys.run or sys.spawn), so that a time-out stops them too
    proc_tree() { echo "$1"; for c in $(pgrep -P "$1" 2>/dev/null); do proc_tree "$c"; done; }
    run_prog() {
      timed_out=0
      if [ -z "$ttimeout" ]; then "$@" >> "$out" 2>&1 </dev/null; prc=$?; return 0; fi
      "$@" >> "$out" 2>&1 </dev/null &
      job=$!
      # (the watcher's own sleep is stopped with it: a TERM to the subshell would leave the sleep running until its time is up; the
      # processes are listed once, before the TERM, so that one whose parent has ended by the KILL is still found)
      ( sleep "$ttimeout" & nap=$!; trap 'kill "$nap" 2>/dev/null; exit 0' TERM; wait "$nap"
        : > "$tmpd/timeout"; pids="$(proc_tree "$job")"; kill -TERM $pids 2>/dev/null; sleep 1; kill -KILL $pids 2>/dev/null ) >/dev/null 2>&1 </dev/null &
      watcher=$!
      { wait "$job"; } 2>/dev/null; prc=$?
      kill "$watcher" 2>/dev/null; wait "$watcher" 2>/dev/null
      job=""; watcher=""
      [ ! -f "$tmpd/timeout" ] || timed_out=1
      return 0
    }
    while IFS= read -r line <&3; do
      k="${line%%|*}"; f="${line#*|}"
      if [ -n "$tfilter" ]; then case "$f" in *"$tfilter"*) ;; *) continue ;; esac; fi
      nfiles=$((nfiles + 1))
      rm -f "$prog" "$progress" "$tmpd/timeout"; : > "$out"
      # what runs: the entry named after the file, else the file as a whole: the functions marked @test (the entry test, through the
      # driver, whatever else the file has: its [build.test] and [test-seeds] apply), or, with none, the program (@main; a file
      # with neither says what is missing)
      entry="$(cat "$tmpd/entry.$k")"
      if [ -n "$entry" ]; then
        case "$entry" in test|test.*) kind=test ;; *) kind=main ;; esac
      else
        entry=main; kind=main
        if grep -Eq '^@test([.][A-Za-z_]|[[:space:]]*(#.*)?$)' "$f" 2>/dev/null; then entry=test; kind=test; fi
      fi
      verdict=ok; why=""
      if [ "$kind" = test ] && [ -s "$tmpd/args.$k" ]; then
        verdict=FAIL; why="the entry test (the functions marked @test) takes no inputs"
      else
        if [ -n "$tmode" ]; then set -- --mode "$tmode"; else set --; fi
        if ! TOMATO_WARNINGS="$warnings" "$invoked" build "$f" --test-seeds --entry "$entry" "$@" -o "$prog" 2>> "$out" >/dev/null; then
          verdict=FAIL; why="did not compile"
        else
          if [ "$kind" = test ]; then
            set -- "$prog" --progress "$progress"
          else
            set -- "$prog"
            while IFS= read -r w; do set -- "$@" "$w"; done < "$tmpd/args.$k"
          fi
          run_prog "$@"
          state=""; passed=0; failed=0; skipped=0; total=0; index=0; name=""
          [ ! -f "$progress" ] || read -r state passed failed skipped total index name < "$progress"
          if [ "$timed_out" = 1 ]; then verdict=FAIL; why="timed out after $ttimeout seconds"; [ -z "$name" ] || [ "$name" = "-" ] || why="$why, in $name"
          elif [ "$kind" = test ] && [ "$state" != done ] && [ "$prc" -ne 2 ]; then
            verdict=FAIL
            if [ -z "$state" ]; then why="the program ended before it ran a test (status $prc)"
            elif [ "$prc" -gt 128 ]; then why="the program ended in $name with status $prc (killed by signal $((prc - 128)), or sys.exit($prc))"
            else why="the program ended in $name with status $prc (a test must not call sys.exit)"; fi
          elif [ "$prc" -gt 128 ]; then verdict=FAIL; why="exit status $prc (killed by signal $((prc - 128)), or sys.exit($prc))"
          elif [ "$prc" -ne 0 ]; then
            # an uncaught skip() ends a file with this error id (E523, SkipTest): the file is skipped, not failed
            reason="$(sed -n 's/^error\[E523\]: SkipTest: //p' "$out" | head -1 | sed 's/ (raised on line [0-9]*)$//')"
            if [ "$kind" = main ] && grep -Eq '^error(\[| )E523' "$out"; then verdict=skip; why="$reason"
            else verdict=FAIL; why="exit status $prc"; [ "$kind" != test ] || [ "$failed" -eq 0 ] || why="$failed of $total tests failed"
              # an entry (main, by default) with an input that has no default cannot run with none: say the rule (the runtime's own line follows)
              if [ "$kind" = main ] && [ ! -s "$tmpd/args.$k" ] && grep -q 'error.E352' "$out"; then why="exit status $prc: a function run with no inputs must give every input a default (or be run with inputs: tomato test FILE ENTRY INPUTS...)"; fi
            fi
          elif [ "$kind" = test ]; then why="$passed passed"; [ "$skipped" -eq 0 ] || why="$why, $skipped skipped"
          fi
        fi
      fi
      case "$verdict" in
        ok) npassed=$((npassed + 1)); if [ -n "$why" ]; then printf 'ok   %s  (%s)\n' "$f" "$why"; else printf 'ok   %s\n' "$f"; fi
            [ "$tverbose" = 0 ] || sed 's/^/    /' "$out" ;;
        skip) nskipped=$((nskipped + 1)); if [ -n "$why" ]; then printf 'skip %s  (%s)\n' "$f" "$why"; else printf 'skip %s\n' "$f"; fi
            [ "$tverbose" = 0 ] || sed 's/^/    /' "$out" ;;
