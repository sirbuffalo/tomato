             *) die "tomato seed add takes --path DIR or --git URL --rev COMMIT, one of them once (a registry name is not supported yet: there is no registry)" ;;
           esac ;;
      update) while [ $# -gt 0 ]; do
                case "$1" in
                  --dry-run) seedopt dry-run ;; --yes) seedopt yes ;;
                  -*) die "unknown option '$1' for 'tomato seed update' (usage: tomato seed update [NAME...] [--dry-run] [--yes])" ;;
                  *) arg="${arg:+$arg }$1" ;;
                esac
                shift
              done ;;
      verify) [ $# -eq 0 ] || die "tomato seed verify takes no words (usage: tomato seed verify)" ;;
      remove) [ $# -ge 1 ] || die_usage "tomato seed remove needs the name of a seed (usage: tomato seed remove NAME)"
              [ $# -eq 1 ] || usage
              case "$1" in -*) die "unknown option '$1' for 'tomato seed remove' (usage: tomato seed remove NAME)" ;; esac
              arg="$1" ;;
      vendor) while [ $# -gt 0 ]; do
                case "$1" in
                  --offline) seedopt offline ;;
                  *) die "unknown option '$1' for 'tomato seed vendor' (run 'tomato help')" ;;
                esac
                shift
              done ;;
      check) [ $# -eq 0 ] || usage ;;
      hash) [ $# -le 1 ] || usage; arg="${1:-.}" ;;
      *) die "unknown seed command '$sub' (run 'tomato help'; the commands here are install, add, remove, update, verify, vendor, check and hash)" ;;
    esac
    find_config .
    if [ "$sub" != hash ] && [ -z "$project_cfg" ]; then die "there is no tomato.toml in this folder or a parent folder"; fi
    case "$sub" in
      install|add|remove|vendor|update|verify)
        [ -t 0 ] && seedopt tty
        errf="$(mktemp "${TMPDIR:-/tmp}/tomato-seed.XXXXXX")" || die "cannot make a temporary file"
        trap 'rm -f "$errf"' EXIT; trap 'exit 130' INT; trap 'exit 143' TERM; trap 'exit 129' HUP   # (also on Ctrl-C at the prompt or during a git fetch)
        if TOMATO_VERSION="$(tomato_version)" "$tomatoc" "$sub" --seed "$std" "$arg" "$project_cfg" "$rev" "$sflags" 2> "$errf"; then
