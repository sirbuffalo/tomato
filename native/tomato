#!/bin/sh
# The `tomato` command, built on the Tomato compiler written in Tomato (tomatoc). Needs only clang.
#   tomato init [NAME] [--seed]                                       start a project in this folder: tomato.toml, src/main.tom, tests/ with an example test, .gitignore (--seed: a seed)
#   tomato run [FILE] [ENTRY [INPUTS...]] [--mode MODE] [--llvm F.ll]   compile, link and run (no word: the project's src/main.tom; a first word that ends in .tom or has a / is the FILE, any
#                                                                     other is an ENTRY of it; MODE: debug or release, debug is the default). Everything after the entry is raw input
#   tomato build [FILE] [-o OUT] [--entry NAME] [--mode MODE] [--llvm F.ll]   write a native program, by default builds/NAME from src/main.tom; it takes [ENTRY [INPUTS...]]
#   tomato compile [FILE] [--entry NAME] [--mode MODE]                print the LLVM IR
#   tomato test [--filter TEXT] [--timeout SECONDS] [--mode MODE] [-v] [FILE]... | FILE ENTRY [INPUTS...]   run each file as a test (no word: every tests/*.tom; FILE ENTRY INPUTS... as in `tomato run`; a bare word before a file is an error); one line per file and a summary; exit 1 if any failed
#   tomato explain CODE [FILE]                                        decode an error id such as E04 or E04:12 (the class and message, with FILE the source line)
#   tomato config [FILE]                                              show the settings in effect (tomato.toml near FILE or the current folder, and ~/.tomato/config.toml)
#   tomato seed install [--locked] [--offline] [--yes]                lock the seeds of tomato.toml (path and git seeds) into tomato.lock, fetching a git seed into ~/.tomato/seeds; --locked checks without writing, --offline never runs git
#   tomato seed add --path DIR | --git URL (--rev COMMIT | --tag TAG | --branch BRANCH) [--subdir DIR] [--test] [--yes] [--offline]   list a local or git seed in [seeds] (--test: [test-seeds]) of tomato.toml and lock it; a tag or branch is looked up once and its commit written as the rev (update follows it), --subdir is the folder of the repository that holds the seed; it lists the !name(...) symbols the seed declares and asks to accept them (--yes: do not ask)
#   tomato seed update [NAME...] [--dry-run] [--yes]                  lock the named seeds (all with no name) again: a git seed that follows a tag or branch gets the commit it points at now (new rev in tomato.toml, new hash in tomato.lock); asks only about new !name(...) symbols; --dry-run writes nothing
#   tomato seed verify                                                hash every locked seed in the store, the vendor folder and the path folders again and compare with tomato.lock: exit 1 on a missing or changed copy
#   tomato seed remove NAME                                           drop a seed from [seeds] and [test-seeds] and lock again
#   tomato seed vendor [--offline]                                    copy the locked seeds into the vendor folder ([seed-store] vendor, default vendor/)
#   tomato seed check                                                 check the seed in this folder (its tomato.toml and src/ modules) and print its content hash
#   tomato seed hash [FOLDER]                                         print the content hash (sha256:...) of a folder
#   tomato repl [FILE ...]                                            type Tomato one piece at a time
#   tomato update [--minor] [--pre]                                   install the newest release: patch releases (1.0.x) at once; a new
#                                                                     minor or major version (1.1.0, 2.0.0), which may change behaviour, only
#                                                                     with --minor; pre-releases (1.1.0-rc.1) only with --pre or when one is installed
#   tomato version                                                    print the version (also --version)
# Options of run, build and compile (tomato.toml: docs/manifest.md): --test-seeds also uses the seeds of [test-seeds] (tomato test does); [build] mode and output
# (and [build.ENTRY]) are the defaults of --mode and -o; the flags win. In `run`, options go before the entry: the words after it are the entry's inputs, read raw.
# Options for every command: --color=auto|always|never (red errors on a terminal; also TOMATO_COLOR, and NO_COLOR turns it off),
# --no-warnings (hide the warnings the compiler gives about code that runs but looks wrong; also TOMATO_WARNINGS=off).
# After `--`, no word is read as an option: `tomato run f.tom -- main -o` runs main with the input -o (the first word is still ENTRY).
# The layout of a project (docs/manifest.md): tomato.toml at the root, code in src/ (the entry is src/main.tom), tests in tests/, programs built into builds/.
invoked="$0"
src="$0"
while [ -L "$src" ]; do
  dir=$(cd "$(dirname "$src")" && pwd)
  src=$(readlink "$src")
  case "$src" in /*) ;; *) src="$dir/$src" ;; esac
done
home="$(cd "$(dirname "$src")/.." && pwd)"
tomatoc="$home/bin/tomatoc"
runtime="$home/runtime/tomato_rt.c"
. "$(dirname "$src")/rtcache.sh"      # the cache of the compiled runtime (installed beside this file)
std="$home/std/"
commands() { awk 'NR > 2 { if ($0 !~ /^#/) exit; sub(/^# ?/, ""); print }' "$src"; }
usage() { sed -n '2p' "$src" | sed 's/^# \{0,1\}//' >&2; commands >&2; exit 2; }
# does standard error get color? --color=always or never decides; auto asks for a terminal, no NO_COLOR and a TERM that is not dumb
want_color() {
  case "${color:-${TOMATO_COLOR:-auto}}" in always) return 0 ;; never) return 1 ;; esac
  [ -z "${NO_COLOR:-}" ] && [ "${TERM:-}" != dumb ] && [ -t 2 ]
}
# paint: error text (docs/errors.md) on standard input, with the colors on standard output: the label bold red (yellow for a
# warning), the message bold, the location cyan, the gutter blue, the caret under the span red, hints green, traceback dim.
# The text itself is not changed, so with the color off the output is the same words.
paint() {
  awk 'BEGIN { E = sprintf("%c", 27); R = E "[0m"; ccol = "31" }
    match($0, /^(error|warning)(\[E[0-9]+\])?: /) { label = substr($0, 1, RLENGTH - 2); ccol = (label ~ /^warning/) ? "33" : "31"; print E "[1;" ccol "m" label ":" R " " E "[1m" substr($0, RLENGTH + 1) R; next }
    /^ *--> / { match($0, /-->/); print substr($0, 1, RSTART - 1) E "[1;34m-->" R " " E "[36m" substr($0, RSTART + 4) R; next }
    /^ *[0-9]* \|/ { match($0, /\|/); g = substr($0, 1, RSTART); rest = substr($0, RSTART + 1)
      if (rest ~ /^ *\^+$/) { match(rest, /\^+/); print E "[1;34m" g R substr(rest, 1, RSTART - 1) E "[1;" ccol "m" substr(rest, RSTART) R }
      else print E "[1;34m" g R rest
      next }
    /^ *= help: / { match($0, /=/); print substr($0, 1, RSTART - 1) E "[1;34m=" R " " E "[1;32mhelp:" R " " E "[32m" substr($0, RSTART + 8) R; next }
    /^  (at |\.\.\. and )/ { print E "[2m" $0 R; next }
    { print }'
}
# shows text on standard error, painted when the color is on
show_error() { if want_color; then paint >&2; else cat >&2; fi; }
die() { printf 'error: %s\n' "$*" | show_error; exit 1; }
# a usage error that one line explains (a missing value, a missing name): status 2 as `usage` gives, but without the whole help
die_usage() { printf 'error: %s\n' "$*" | show_error; exit 2; }
die_id() { id="$1"; shift; printf 'error[%s]: %s\n' "$id" "$*" | show_error; exit 1; }
# SemVer 2.0 precedence of two version texts: prints -1, 0 or 1 (the first below, equal to or above the second). MAJOR.MINOR.PATCH
# by number, a missing part counting as 0 (the old 0.NN numbers are 0.NN.0); then a -PRERELEASE is below the release itself,
# its dot-separated identifiers compared in turn (numbers by value and below words, words in ASCII order, a longer list above
# its prefix: 1.0.0-alpha < 1.0.0-alpha.1 < 1.0.0-beta < 1.0.0-rc.2 < 1.0.0-rc.10 < 1.0.0); +BUILD is ignored.
# The same text is in native/tomato and release/release.sh; tests/run.sh checks that they agree.
semver_cmp() {
  LC_ALL=C awk -v a="$1" -v b="$2" '
    function part(v, i,   c) { c = v; sub(/[-+].*/, "", c); split(c, w, "."); return w[i] + 0 }
    function pre(v) { sub(/\+.*/, "", v); return index(v, "-") ? substr(v, index(v, "-") + 1) : "" }
    function cmp(x, y,   i, xp, yp, n, m, xn, yn) {
      for (i = 1; i <= 3; i++) if (part(x, i) != part(y, i)) return part(x, i) < part(y, i) ? -1 : 1
      xp = pre(x); yp = pre(y)
      if (xp == yp) return 0
      if (xp == "") return 1
      if (yp == "") return -1
      n = split(xp, u, "."); m = split(yp, t, ".")
      for (i = 1; i <= n && i <= m; i++) {
        xn = u[i] ~ /^[0-9]+$/; yn = t[i] ~ /^[0-9]+$/
        if (xn && yn) { if (u[i] + 0 != t[i] + 0) return u[i] + 0 < t[i] + 0 ? -1 : 1 }
        else if (xn != yn) return xn ? -1 : 1
        else if ((u[i] "") != (t[i] "")) return (u[i] "") < (t[i] "") ? -1 : 1
      }
      return n == m ? 0 : n < m ? -1 : 1
    }
    BEGIN { print cmp(a, b) }'
}
# The tomato.toml is read by the compiler (compiler/src/manifest.tom), which is told this version for the manifest's `tomato` key
# (a compiler built from the bootstrap file knows only the version it was built at, not the one of this install).
tomato_version() { cat "$home/VERSION" 2>/dev/null || echo 0; }
# The settings (docs/decisions.md D77g): [limits] in a project's tomato.toml (the one in the program's folder or the nearest parent) and in
# the user's config.toml (${TOMATO_HOME:-$HOME/.tomato}/config.toml). This script only finds the two files; the compiler reads them
# (compiler/src/config.tom) and writes the settings into the program, so a built program reads no file when it runs.
# find_config FOLDER sets project_cfg and user_cfg to the paths of the files that exist, else to empty text.
find_config() {
  project_cfg=""; user_cfg="${TOMATO_HOME:-${HOME:-}/.tomato}/config.toml"
  [ -f "$user_cfg" ] || user_cfg=""
  d="$(cd "$1" 2>/dev/null && pwd -P)" || return 0
  while :; do
    if [ -f "$d/tomato.toml" ]; then project_cfg="$d/tomato.toml"; return 0; fi
    [ "$d" = / ] && return 0
    d="$(dirname "$d")"
  done
}
# update downloads use https only, including after redirects (file:// only for tests, with the override)
# (only called in a subshell, a $(...) or a background job, where `exec` makes the subshell curl itself: a signal sent to the job stops curl)
curl_safe() {
  if [ -n "$TOMATO_UPDATE_ALLOW_ANY_URL" ] || [ -n "$TOMATO_UPDATE_ALLOW_FILE" ]; then exec curl -fsSL "$@"; else exec curl -fsSL --proto '=https' --proto-redir '=https' "$@"; fi
}

cmd="$1"; [ -n "$cmd" ] || usage; shift
# the options every command takes are read first, from anywhere before a `--`: --color=auto|always|never, --no-warnings
color=""; warnings="${TOMATO_WARNINGS:-on}"
n=$#; stop=0
[ "$cmd" = run ] || [ "$cmd" = test ] && n=0      # (run and test read their options themselves: they stop at the entry, and what follows it is raw input)
while [ $n -gt 0 ]; do
  n=$((n - 1))
  if [ $stop = 1 ]; then set -- "$@" "$1"; shift; continue; fi
  case "$1" in
    --) stop=1; set -- "$@" "$1"; shift ;;
    --color=*) color="${1#--color=}"; shift ;;
    --color) [ $n -ge 1 ] || die_usage "--color needs a value (auto, always or never)"; color="$2"; shift 2; n=$((n - 1)) ;;
    --no-warnings) warnings=off; shift ;;
    *) set -- "$@" "$1"; shift ;;
  esac
done
check_color() {
  case "$color" in ""|auto|always|never) ;; *) die "--color takes auto, always or never, not '$color'" ;; esac
  [ -z "$color" ] || export TOMATO_COLOR="$color"   # the program run by `tomato run` (and the repl) follows it too
}
check_color
case "$cmd" in
  help|--help|-h) sed -n '2p' "$src" | sed 's/^# \{0,1\}//'; commands; exit 0 ;;
  version|--version|-V) echo "Tomato v$(cat "$home/VERSION" 2>/dev/null || echo 0) (compiler written in Tomato)"; exit 0 ;;
  update)
    # tomato update: read the manifest, and if a newer release exists download it and run its installer. site/latest.json names
    # the latest stable release only; a pre-release (1.1.0-rc.1) is in site/latest-pre.json, read only with --pre or when the
    # installed version is itself a pre-release, so a stable install is never moved to an rc unasked, while an rc install moves to
    # a later rc or to the release. Patch releases keep programs working (docs/releasing.md, Version numbers), so they install at
    # once; a newer MAJOR.MINOR from 1.0 on needs --minor, because a minor version may change behaviour.
    # only an install made by install-native.sh (or the .pkg) is replaced: run from a checkout, $home is the repository (it has
    # install-native.sh and compiler/), and the installer would swap its native/ folder for an install
    if [ -f "$home/install-native.sh" ] && [ -d "$home/compiler" ]; then die "tomato update replaces an install, and $home is not one (run ./install-native.sh in a checkout)"; fi
    minor=0; pre=0
    for a in "$@"; do case "$a" in --minor) minor=1 ;; --pre) pre=1 ;; *) die "tomato update takes --minor and --pre, not $a" ;; esac; done
    url="${TOMATO_UPDATE_URL:-https://tomato.davismcd.com/latest.json}"
    pre_url="${TOMATO_UPDATE_PRE_URL:-https://tomato.davismcd.com/latest-pre.json}"
    have="$(cat "$home/VERSION" 2>/dev/null || echo 0)"
    command -v curl >/dev/null || die "tomato update needs curl"
    # the site's own HTTPS may not be ready (GitHub issues its certificate after DNS is set up), so fall back to the
    # same manifest attached to the latest GitHub release (not the main branch, and never a pre-release: GitHub's "latest"
    # skips them); plain HTTP is never used because the manifest carries the checksum
    manifest="$(curl_safe "$url" 2>/dev/null)" || manifest="$(curl_safe "${TOMATO_UPDATE_FALLBACK:-https://github.com/sirbuffalo/tomato/releases/latest/download/latest.json}" 2>/dev/null)" || die "cannot read $url"
    mversion() { printf '%s' "$1" | sed -n 's/.*"version" *: *"\([^"]*\)".*/\1/p' | head -1; }
    latest="$(mversion "$manifest")"
    case "$have" in *-*) pre=1 ;; esac
    if [ "$pre" = 1 ] && pmanifest="$(curl_safe "$pre_url" 2>/dev/null)" && platest="$(mversion "$pmanifest")" && [ -n "$platest" ]; then
      if [ -z "$latest" ] || [ "$(semver_cmp "$platest" "$latest")" = 1 ]; then manifest="$pmanifest"; latest="$platest"; fi
    fi
    archive="$(printf '%s' "$manifest" | sed -n 's/.*"url" *: *"\([^"]*\)".*/\1/p' | head -1)"
    [ -n "$latest" ] && [ -n "$archive" ] || die "the manifest at $url is not understood"
    # only upgrade: an older or equal version (a stale cache, a rolled-back manifest) is left alone
    if [ "$(semver_cmp "$latest" "$have")" != 1 ]; then echo "tomato v$have is the latest"; exit 0; fi
    if [ "$minor" = 0 ] && [ "${have%%.*}" != 0 ] && [ "$(semver_cmp "$(echo "$latest" | cut -d. -f1,2).0" "$(echo "$have" | cut -d. -f1,2).0")" = 1 ]; then
      echo "tomato v$latest is out, a new minor or major version: it may change how programs behave (see its release notes)."
      echo "You have v$have. Install it with: tomato update --minor$(case "$latest" in *-*) echo " --pre" ;; esac)"; exit 0
    fi
    echo "updating v$have -> v$latest"
    # everything is downloaded and checked in a temporary folder, which goes on any exit, error or signal (Ctrl-C, SIGTERM): a
    # download or the installer that is running is stopped first. The install itself is replaced as a whole by install-native.sh
    # (staged beside the old one, then one rename), so an update that fails or is interrupted leaves the old install as it was.
    work="$(mktemp -d)" || die "cannot make a temporary folder"; job=""
    trap 'trap "" INT TERM HUP; [ -z "$job" ] || kill "$job" 2>/dev/null; wait 2>/dev/null; rm -rf "$work"' EXIT
    trap 'exit 130' INT; trap 'exit 143' TERM; trap 'exit 129' HUP
    # run a command as a background job and wait for it: a signal then ends this script at once, not when the command ends
    # (a background job of a script ignores SIGINT, so the trap above stops it with SIGTERM; the terminal's ^C reaches this script)
    run() { "$@" & job=$!; if wait "$job"; then job=""; else rc=$?; job=""; return $rc; fi; }
    want="$(printf '%s' "$manifest" | sed -n 's/.*"sha256" *: *"\([^"]*\)".*/\1/p' | head -1)"
    # fail closed: the manifest is the only integrity anchor, so it must carry a checksum and name an official download
    if [ "${#want}" -ne 64 ] || [ -n "$(printf '%s' "$want" | tr -d '0-9a-f')" ]; then die "the manifest has no valid sha256: not updating"; fi
    if [ -z "$TOMATO_UPDATE_ALLOW_ANY_URL" ]; then
      case "$archive" in https://github.com/sirbuffalo/tomato/releases/download/*) ;; *) die "the download is not an official release URL: not updating" ;; esac
    fi
    run curl_safe "$archive" -o "$work/tomato.tar.gz" || die "cannot download $archive"
    if command -v shasum >/dev/null 2>&1; then got="$(shasum -a 256 "$work/tomato.tar.gz")"; else got="$(sha256sum "$work/tomato.tar.gz")"; fi   # macOS has shasum, some Linux systems only sha256sum
    got="${got%% *}"
    [ "$got" = "$want" ] || die "the download does not match its checksum"
    tar -xzf "$work/tomato.tar.gz" -C "$work" || die "the download is not a valid archive"
    installer=""; for f in "$work"/tomato-*/install-native.sh; do [ -f "$f" ] && installer="$f" && break; done
    [ -n "$installer" ] || die "the download has no installer: not updating"
    # the link directory: where this command was reached through a symlink, else the default (never the real bin folder)
    if [ -L "$invoked" ]; then bindir_for_update="$(cd "$(dirname "$invoked")" && pwd)"; else bindir_for_update="${TOMATO_BIN:-$HOME/.local/bin}"; fi
    # reinstall where this copy lives, not into the default folders. This script is part of the install being replaced: the
    # installer renames the old folder away and deletes it, and the shell keeps reading this file through its open descriptor.
    run env TOMATO_HOME="${home%/native}" TOMATO_BIN="$bindir_for_update" sh "$installer" || die "the installer failed"
    exit 0 ;;
  explain)
    # tomato explain CODE [FILE]: an error id such as E04 (or E04:12 with the source line, as a release build prints it): the
    # class and message of the error kind, and with a FILE and a line the source line, laid out like a compiler error
    [ $# -ge 1 ] && [ $# -le 2 ] || usage
    code="$1"; src_file="${2:-}"
    invalid_code() { die "$code is not an error id (they look like E04 or E04:12)"; }
    digits="${code%%:*}"
    case "$digits" in E[0-9][0-9]*) digits="${digits#E}" ;; *) invalid_code ;; esac
    case "$digits" in *[!0-9]*) invalid_code ;; esac
    kind="$(printf '%s' "$digits" | sed 's/^0*//')"
    [ -n "$kind" ] || invalid_code
    line=""
    case "$code" in
      *:*) line="${code#*:}"; case "$line" in ""|*[!0-9]*) invalid_code ;; esac ;;
    esac
    entry="$(awk -v kind="$kind" 'NR == kind { print; exit }' "$home/std/errors.txt")"
    id="E$kind"; [ "${#kind}" -eq 1 ] && id="E0$kind"
    if [ -z "$entry" ]; then echo "error[$id]: an error the table does not list"; else
      cls="${entry%% *}"; msg="${entry#* }"
      echo "error[$id]: $cls: $msg"
    fi
    [ -n "$src_file" ] && [ -n "$line" ] || exit 0
    line="$(printf '%s' "$line" | sed 's/^0*//')"
    [ -n "$line" ] || exit 0                         # line zero means the runtime had no source location
    [ -f "$src_file" ] || die "cannot read $src_file"
    if ! text="$(awk -v line="$line" 'NR == line { print; found = 1; exit } END { if (!found) exit 1 }' "$src_file")"; then
      echo "  (line $line is past the end of $src_file: is this the file the program was built from?)"
      exit 0
    fi
    trimmed="$(printf '%s' "$text" | sed 's/^ *//')"      # (a tab cannot indent Tomato; BSD sed would read \t in [] as a backslash and a t)
    indent=$(( ${#text} - ${#trimmed} ))
    pad="$(printf '%*s' "${#line}" '')"
    echo " --> $src_file:$line"
    echo "$pad |"
    echo "$line | $text"
    printf '%s | %*s%s\n' "$pad" "$indent" '' "$(printf '%s' "$trimmed" | sed 's/./^/g')"
    exit 0 ;;
  init)
    # tomato init [NAME] [--seed] (D94b): a project in the current folder. tomato.toml at the root, code in src/ (the program is
    # src/main.tom), tests in tests/ (each file is one test: a program that passes when it runs without raising an error), what
    # `tomato build` writes in builds/ (left out of git). Nothing is overwritten: when any file would be, none is written and the
    # message names them. With --seed the folder is a seed (a package): its name is owner/name and its modules are src/STEM.tom.
    seed=0; name=""; dd=0
    for a in "$@"; do
      if [ $dd = 0 ]; then
        case "$a" in
          --) dd=1; continue ;;
          --seed) seed=1; continue ;;
          -*) die "unknown option '$a' for 'tomato init' (usage: tomato init [NAME] [--seed])" ;;
        esac
      fi
      [ -z "$name" ] || die "tomato init takes one NAME, not '$name' and '$a'"
      name="$a"
    done
    folder="$(basename "$(pwd -P)")"
    if [ "$seed" = 1 ]; then
      if [ -z "$name" ]; then name="yourdomain.example/$(printf '%s' "$folder" | tr 'A-Z' 'a-z' | sed 's/[^a-z0-9_-]/-/g')"; fi
      printf '%s' "$name" | grep -Eq '^[a-z0-9]([a-z0-9.-]*[a-z0-9])?/[a-z][a-z0-9_-]{0,63}$' \
        || die "'$name' is not a seed name: write tomato init --seed owner/name (an owner is lowercase letters, digits, dots and hyphens, a name starts with a letter)"
      stem="$(printf '%s' "${name#*/}" | tr - _)"
      mainfile="src/$stem.tom"
    else
      [ -n "$name" ] || name="$folder"
      case "$name" in ""|/) die "give the project a name: tomato init NAME" ;; esac
      mainfile="src/main.tom"
    fi
    case "$name" in *[![:print:]]*) die "the name must be plain printable text" ;; esac
    # a project's name becomes the file name of its program (builds/NAME), where a / turns into a -: a name that goes up or stays (../x, ./x, a/../b) is not a name
    if [ "$seed" = 0 ]; then
      case "/$name/" in
        */../*|*/./*) die "'$name' is not a project name: it has a . or .. part, as a path does (tomato init NAME starts the project in this folder; to start it in another folder, go there first)" ;;
      esac
    fi
    existing=""
    for f in tomato.toml "$mainfile" tests/example.tom .gitignore; do
      if [ -e "$f" ] || [ -L "$f" ]; then existing="$existing${existing:+, }$f"; fi
    done
    [ -z "$existing" ] || die "tomato init will not overwrite: $existing (nothing was written; move them away, or use another folder)$(case "$existing" in *.gitignore*) echo "; an existing .gitignore needs the line builds/ added by hand" ;; esac)"
    for d in src tests; do
      if [ -e "$d" ] && [ ! -d "$d" ]; then die "$d exists and is not a folder (nothing was written)"; fi
    done
    mkdir -p src tests || die "cannot make the src and tests folders"
    qname="$(printf '%s' "$name" | sed 's/\\/\\\\/g; s/"/\\"/g')"
    ver="$(tomato_version)"
    case "$ver" in *-*) minv="$ver" ;; *) minv="$(printf '%s' "$ver" | awk -F. '{ print $1 "." $2 }')" ;; esac    # the oldest compiler that builds it: this one (a pre-release needs its own number, 1.1 is newer than 1.1.0-rc.1)
    if [ "$seed" = 1 ]; then
      {
        echo "[seed]"
        printf 'name = "%s"\n' "$qname"
        echo 'version = "0.1.0"'
        echo "tomato = \"$minv\""
        echo 'description = "TODO: one line about what this seed is for"'
        echo 'license = "TODO: a license such as MIT"'
        echo
        echo "# Seeds this seed uses, as \"owner/name\" = \"minimum version\":"
        echo "# [seeds]"
        echo "#"
        echo "# Seeds only its tests use (tomato test reads them; whoever uses this seed never does):"
        echo "# [test-seeds]"
      } > tomato.toml
      {
        printf '%s\n' "# The modules of a seed are the .tom files in src/ named $stem.tom or ${stem}_*.tom: users write import $stem."
        echo "export def hello(name: str) -> str:"
        echo "    return f'hello, {name}'"
      } > "$mainfile"
      {
        echo "# A test is a file in tests/ that runs without raising an error: tomato test runs each one, and a failed assert raises."
        echo "# The modules of src/ are imported by name."
        printf '%s\n' "from $stem import hello"
        echo
        echo "@main"
        echo "def main():"
        echo "    assert hello('tomato') == 'hello, tomato'"
      } > tests/example.tom
    else
      {
        echo "[project]"
        printf 'name = "%s"\n' "$qname"
        echo 'version = "0.1.0"'
        echo "tomato = \"$minv\""
        echo
        echo "# Seeds this project uses, as \"owner/name\" = \"minimum version\" (or { path = \"../folder\" }):"
        echo "# [seeds]"
        echo "#"
        echo "# Seeds only its tests use (tomato test reads them; a build does not):"
        echo "# [test-seeds]"
