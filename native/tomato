    fi
    if [ $have_file = 0 ] && file_word "$1"; then file="$1"; have_file=1; shift; continue; fi
    if file_word "$1"; then die "'$1' looks like a file, but the file is already $file: after it comes an entry name such as main (tomato run FILE [ENTRY [INPUTS...]])"; fi
    entry="$1"; shift; break
  done
  check_color
  # "$@" now holds the raw inputs
else
  dd=0; nfile=0
  while [ $# -gt 0 ]; do
    if [ $dd = 0 ]; then
      case "$1" in
        --) dd=1; shift; continue ;;
        -o) [ $# -ge 2 ] || die_usage "$1 needs a value"; out="$2"; shift 2; continue ;;
        --entry) [ $# -ge 2 ] || die_usage "$1 needs a value"; entry="$2"; shift 2; continue ;;
        --mode) [ $# -ge 2 ] || die_usage "$1 needs a value"; mode="$2"; mode_given=1; shift 2; continue ;;
        --llvm) [ $# -ge 2 ] || die_usage "$1 needs a value"; llvm="$llvm$2$nl"; shift 2; continue ;;
        --test-seeds) testseeds=1; shift; continue ;;
        -?*) die "unknown option '$1' for 'tomato $cmd' (run 'tomato help')" ;;
      esac
    fi
    [ $nfile = 0 ] || usage
    file_word "$1" || die "'$1' is not a file: a file ends in .tom or has a / in it (tomato $cmd [FILE]; with no FILE it is the project's src/main.tom)"
    file="$1"; nfile=1; shift
  done
fi
# no FILE: the project's program, src/main.tom of the folder that holds the nearest tomato.toml
if [ -z "$file" ]; then
  find_config .
  [ -n "$project_cfg" ] || die "there is no tomato.toml in this folder or a parent folder, so there is no project's src/main.tom to $cmd: name a file (tomato $cmd FILE.tom), or start a project here with tomato init"
  root="$(dirname "$project_cfg")"
  if [ "$root" = "$(pwd -P)" ]; then file="src/main.tom"; else file="$root/src/main.tom"; fi
