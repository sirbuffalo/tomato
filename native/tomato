        if [ $# -gt 0 ] && ! file_word "$1" && [ ! -d "$1" ]; then
          printf '%s\n' "$1" > "$tmpd/entry.$k"; shift
          while [ $# -gt 0 ]; do printf '%s\n' "$1" >> "$tmpd/args.$k"; shift; done
        fi
      else
        die "'$a' is not a file: write tomato test $a.tom (or tests/$a.tom); a word that is not a file is only accepted right after a file, as the entry to run in it (tomato test x.tom $a)"
