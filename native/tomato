    errf="$(mktemp "${TMPDIR:-/tmp}/tomato-config.XXXXXX")" || die "cannot make a temporary file"
    if out="$(TOMATO_VERSION="$(tomato_version)" "$tomatoc" "" --config "$std" debug "$project_cfg" "$user_cfg" 2> "$errf")"; then
      rm -f "$errf"; printf '%s\n' "$out"; exit 0
    fi
    show_error < "$errf"; rm -f "$errf"; exit 1 ;;
  seed)
