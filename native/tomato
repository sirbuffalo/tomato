set -f      # words are split on newlines below; never expand * or ? in them
nl="
"
file=""; entry=""; out=""; llvm=""; mode=""; mode_given=0; testseeds=0     # mode: the flag, else [build].mode of tomato.toml, else debug (decided by the compiler below)
# A FILE is a word that ends in .tom or has a / in it; any other word where a FILE could be is an ENTRY (D94b). Positional words are kept
# in "$@" (not a string) so empty and glob-like inputs survive untouched.
file_word() { case "$1" in *.tom|*/*) return 0 ;; esac; return 1; }
if [ "$cmd" = run ]; then
  # run [OPTIONS] [FILE] [OPTIONS] [ENTRY [INPUTS...]]: the options are read until the entry, and everything after the entry is raw
  # input (no flag is read there; `--` ends the options earlier, and the next word is still the FILE or the ENTRY)
  dd=0; have_file=0
  while [ $# -gt 0 ]; do
    if [ $dd = 0 ]; then
      case "$1" in
        --) dd=1; shift; continue ;;
        --color=*) color="${1#--color=}"; shift; continue ;;
        --color) [ $# -ge 2 ] || die_usage "--color needs a value (auto, always or never)"; color="$2"; shift 2; continue ;;
        --no-warnings) warnings=off; shift; continue ;;
        --entry) [ $# -ge 2 ] || die_usage "$1 needs a value"; entry="$2"; shift 2; continue ;;
        --mode) [ $# -ge 2 ] || die_usage "$1 needs a value"; mode="$2"; mode_given=1; shift 2; continue ;;
        --llvm) [ $# -ge 2 ] || die_usage "$1 needs a value"; llvm="$llvm$2$nl"; shift 2; continue ;;
