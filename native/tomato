        fi
        show_error < "$errf"; rm -f "$errf"; exit 1 ;;
    esac
    out="$(TOMATO_VERSION="$(tomato_version)" "$tomatoc" "$sub" --seed "$std" "$arg" "$project_cfg" "" "" 2>&1)" || { printf '%s\n' "$out" | show_error; exit 1; }
    printf '%s\n' "$out"; exit 0 ;;
