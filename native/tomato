#!/bin/sh
# The `tomato` command, built on the Tomato compiler written in Tomato (tomatoc). Needs only clang.
#   tomato run FILE [ENTRY [INPUTS...]] [--llvm FILE.ll ...]   compile, link and run (-- ends flags, so inputs may look like flags)
#   tomato build FILE [-o OUT] [--entry NAME] [--llvm FILE.ll ...]   write a native program
#   tomato compile FILE [--entry NAME]                         print the LLVM IR
#   tomato repl [FILE ...]                                     type Tomato one piece at a time 
#   tomato update                                              install the newest release
#   tomato version
invoked="$0"
src="$0"
while [ -L "$src" ]; do
  dir=$(cd "$(dirname "$src")" && pwd)
  src=$(readlink "$src")
  case "$src" in /*) ;; *) src="$dir/$src" ;; esac
done
home="$(cd "$(dirname "$src")/.." && pwd)"
tomatoc="$home/bin/tomatoc"
runtime="$home/runtime/tomato_rt.c"
std="$home/std/"
commands() { sed -n '3,8p' "$src" | sed 's/^# \{0,1\}//'; }
usage() { sed -n '2p' "$src" | sed 's/^# \{0,1\}//' >&2; commands >&2; exit 2; }
die() { echo "error: $*" >&2; exit 1; }
# update downloads use https only, including after redirects (file:// only for tests, with the override)
curl_safe() {
  if [ -n "$TOMATO_UPDATE_ALLOW_ANY_URL" ] || [ -n "$TOMATO_UPDATE_ALLOW_FILE" ]; then curl -fsSL "$@"; else curl -fsSL --proto '=https' --proto-redir '=https' "$@"; fi
}

cmd="$1"; [ -n "$cmd" ] || usage; shift
case "$cmd" in
  help|--help|-h) sed -n '2p' "$src" | sed 's/^# \{0,1\}//'; commands; exit 0 ;;
  version) echo "Tomato v$(cat "$home/VERSION" 2>/dev/null || echo 0) (compiler written in Tomato)"; exit 0 ;;
  update)
    # tomato update: read the manifest, and if a newer release exists download it and run its installer
    url="${TOMATO_UPDATE_URL:-https://tomato.davismcd.com/latest.json}"
    have="$(cat "$home/VERSION" 2>/dev/null || echo 0)"
    command -v curl >/dev/null || die "tomato update needs curl"
    # the site's own HTTPS may not be ready (GitHub issues its certificate after DNS is set up), so fall back to the
    # same manifest attached to the latest GitHub release (not the main branch); plain HTTP is never used because the manifest carries the checksum
    manifest="$(curl_safe "$url" 2>/dev/null)" || manifest="$(curl_safe "${TOMATO_UPDATE_FALLBACK:-https://github.com/sirbuffalo/tomato/releases/latest/download/latest.json}" 2>/dev/null)" || die "cannot read $url"
    latest="$(printf '%s' "$manifest" | sed -n 's/.*"version" *: *"\([^"]*\)".*/\1/p' | head -1)"
    archive="$(printf '%s' "$manifest" | sed -n 's/.*"url" *: *"\([^"]*\)".*/\1/p' | head -1)"
    [ -n "$latest" ] && [ -n "$archive" ] || die "the manifest at $url is not understood"
    # only upgrade: an older or equal version (a stale cache, a rolled-back manifest) is left alone
    newer="$(printf '%s\n%s\n' "$have" "$latest" | sort -t. -k1,1n -k2,2n -k3,3n | tail -1)"
    if [ "$latest" = "$have" ] || [ "$newer" != "$latest" ]; then echo "tomato v$have is the latest"; exit 0; fi
    echo "updating v$have -> v$latest"
    work="$(mktemp -d)"; trap 'rm -rf "$work"' EXIT
    want="$(printf '%s' "$manifest" | sed -n 's/.*"sha256" *: *"\([^"]*\)".*/\1/p' | head -1)"
    # fail closed: the manifest is the only integrity anchor, so it must carry a checksum and name an official download
    case "$want" in [0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]) ;; *) die "the manifest has no valid sha256: not updating" ;; esac
    if [ -z "$TOMATO_UPDATE_ALLOW_ANY_URL" ]; then
      case "$archive" in https://github.com/sirbuffalo/tomato/releases/download/*) ;; *) die "the download is not an official release URL: not updating" ;; esac
    fi
    curl_safe "$archive" -o "$work/tomato.tar.gz" || die "cannot download $archive"
    got="$(shasum -a 256 "$work/tomato.tar.gz" | cut -d' ' -f1)"
    [ "$got" = "$want" ] || die "the download does not match its checksum"
    tar -xzf "$work/tomato.tar.gz" -C "$work" || die "the download is not a valid archive"
    # the link directory: where this command was reached through a symlink, else the default (never the real bin folder)
    if [ -L "$invoked" ]; then bindir_for_update="$(cd "$(dirname "$invoked")" && pwd)"; else bindir_for_update="${TOMATO_BIN:-$HOME/.local/bin}"; fi
    # reinstall where this copy lives, not into the default folders
    TOMATO_HOME="${home%/native}" TOMATO_BIN="$bindir_for_update" "$work"/tomato-*/install-native.sh || die "the installer failed"
    exit 0 ;;
  repl|shell) TOMATO_CMD="$home/bin/tomato" TOMATO_TOMATOC="$tomatoc" TOMATO_RUNTIME="$runtime" TOMATO_STD="$std" TOMATO_WASM="$home/wasm" TOMATO_JSC_JS="$home/wasm/tomato-jsc.js" exec bash "$home/bin/tomato-repl" "$@" ;;
  run|build|compile) ;;
  *) echo "error: unknown command '$cmd'" >&2; echo "run 'tomato help' for the commands" >&2; exit 2 ;;
esac

set -f      # words are split on newlines below; never expand * or ? in them
nl="
"
file=""; entry=""; out=""; llvm=""
# the words after FILE: for run, ENTRY then inputs; for build/compile, flags. Positional words are kept in "$@" (not
# a string) so empty and glob-like inputs survive untouched.
[ $# -ge 1 ] || usage
file="$1"; shift
[ -f "$file" ] || die "cannot read $file"
n=$#
stop=0     # after `--` every word is a positional input, even one that looks like a flag
while [ $n -gt 0 ]; do
  n=$((n - 1))
  if [ $stop = 1 ]; then set -- "$@" "$1"; shift; continue; fi
  case "$1" in
    --) stop=1; shift ;;
    -o) [ "$cmd" = run ] && usage; [ $# -ge 2 ] || usage; out="$2"; shift 2; n=$((n - 1)) ;;
    --entry) [ $# -ge 2 ] || usage; entry="$2"; shift 2; n=$((n - 1)) ;;
    --llvm) [ $# -ge 2 ] || usage; llvm="$llvm$2$nl"; shift 2; n=$((n - 1)) ;;
    *) set -- "$@" "$1"; shift ;;
  esac
done
# "$@" now holds only the positional words
if [ "$cmd" = run ]; then
  if [ $# -ge 1 ]; then entry="$1"; shift; fi
  entry="${entry:-main}"
else
  [ $# -eq 0 ] || usage
  entry="${entry:-main}"
fi

tmp="$(mktemp -d)"; trap 'rm -rf "$tmp"' EXIT
if ! "$tomatoc" "$file" "$entry" "$std" > "$tmp/program.ll" 2> "$tmp/errors"; then
  sed -e 's/^error: line [0-9]*: uncaught error \([A-Za-z]*\): line \([0-9]*\): /\1 on line \2: /' -e 's/^error: line [0-9]*: uncaught error \([A-Za-z]*\): /\1: /' "$tmp/errors" >&2
  exit 1
fi
[ "$cmd" = compile ] && { cat "$tmp/program.ll"; exit 0; }
exe="$tmp/program"
[ "$cmd" = build ] && exe="${out:-$(basename "${file%.tom}")}"
link() {   # a function has its own "$@", so the run inputs survive
  set -- clang -O1 -Wno-override-module -o "$exe" "$tmp/program.ll"
  OLDIFS="$IFS"; IFS="$nl"
  for f in $llvm; do set -- "$@" "$f"; done
  IFS="$OLDIFS"
  "$@" "$runtime" -lm
}
link || exit 1
[ "$cmd" = build ] && { echo "wrote $exe"; exit 0; }
"$exe" "$@"
