from math import is_prime

@main
def main():
    print('no inputs')

@prime
def prime(n: int):
    print(n, is_prime(n))

@greet
def greet(name: str, times: uint[length=8], loud: bool):
    for i in range(times):
        if loud:
            print(name.upper())
        else:
            print(name)
