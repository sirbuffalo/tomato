# LLVM functions are declared with their Tomato types, then called with !name (D27b).
# Run with: tomato run --llvm examples/mathlib.ll examples/mathlib.tom main
!sqrt(x: float) -> float
!add(a: int, b: int) -> int
!is_even(n: int[length=32]) -> bool
!mul32(a: int[length=32], b: int[length=32]) -> int[length=32]
!nothing()

@main
def main():
    print(!sqrt(2 / 1))
    print(!add(40, 2))
    print(!is_even(10), !is_even(7))
    print(!mul32(1000, 1000000))
    !nothing()
