# Heap values the compiler allocates and frees by reference counting (D36a).
# tomato build examples/objects.tom -o objects && ./objects 5
class Item:
    name: str
    qty: int

    @init
    def make(self, name: str, qty: int):
        self.name = name
        self.qty = qty

class Inventory:
    items: list[Item] = []

    def add(self, name: str, qty: int):
        self.items.append(Item(name, qty))

    def total(self) -> int:
        return sum([item.qty for item in self.items])

    def describe(self) -> str:
        return ''.join([f'{item.name}x{item.qty} ' for item in self.items])

@main
def main(n: int):
    inv = Inventory()
    for i in range(n):
        inv.add(f'item{i}', i * 2)
    print(inv.describe())
    print('total', inv.total(), 'chars', len(inv.describe()))
