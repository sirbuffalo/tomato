from math import gcd, pow

class NegativeError(Error):
    @init
    def make(self, message: str):
        Error.start(self, message)

def square_root_floor(n: int) -> int:
    if n < 0:
        raise NegativeError('no square root of a negative number')
    r = 0
    while (r + 1) * (r + 1) <= n:
        r += 1
    return r

@main
def main():
    words = 'the quick brown fox jumps over the lazy dog the end'.split(' ')
    counts: dict[str, int] = {}
    for w in words:
        counts[w] = counts.get(w, 0) + 1
    print(counts['the'], len(counts))
    seen: set[str] = {}
    for w in words:
        seen.add(w)
    print(len(seen), 'fox' in seen)
    print(gcd(84, 36), pow(2, 20))
    for n in [16, 17, -4]:
        try:
            print(n, square_root_floor(n))
        catch NegativeError as e:
            print(n, 'error:', e.message)
        finally:
            print('checked', n)
    total = 0
    for i in range(100):
        if i % 2 == 1:
            continue
        if i > 10:
            break
        total += i
    print(total)
