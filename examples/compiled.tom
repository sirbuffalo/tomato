# A program in the subset the LLVM compiler handles: tomato build examples/compiled.tom -o compiled
def fib(n: int) -> int:
    if n < 2:
        return n
    return fib(n - 1) + fib(n - 2)

def is_prime(n: int) -> bool:
    if n < 2:
        return False
    d = 2
    while d * d <= n:
        if n % d == 0:
            return False
        d = d + 1
    return True

@main
def main(n: int):
    print('fib', n, '=', fib(n))
    count = 0
    for i in range(2, n + 1):
        if is_prime(i):
            count = count + 1
    print('primes up to', n, ':', count)
    print(n / 7, n % 7)
