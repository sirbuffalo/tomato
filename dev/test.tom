# The test suite, in Tomato (docs/shell-to-tomato-plan.md, stage 4; tests/README.md says how to run it).
#
#     tomato run dev/test.tom main [-j N] [--fast] [--times]
#     tomato run dev/test.tom ci_report LOGFILE
#     tomato run dev/test.tom error_templates
#     tomato run dev/test.tom highlighter_lists
#
# `main` is tests/run.sh over again: the same tiers (--fast, or TOMATO_TEST_FAST=1), the same -j (TOMATO_TEST_JOBS=N; the default is
# half the cores, at most 64, less when the machine is busy), --times (TOMATO_TEST_TIMES=1), the same lines in the same order whatever
# -j is, the same count and exit status. The tests are started longest first and printed in their place, as there.
#
# While the move is going on, the list of tests is still made by tests/run.sh: it registers them (`TOMATO_TEST_BRIDGE=plan`), this
# program starts and orders them, and runs a test itself when it has been ported (a function `native_NAME` below); every other one is
# run by tests/run.sh, one process each (`TOMATO_TEST_BRIDGE=job`), with the folder this program shares with it. A ported test prints
# the very lines its old function printed, so the output of the two runners can be compared line for line. When the last test is
# ported, the list moves here and tests/run.sh goes.
import sys
import os
import ospath
import time
import asyncio
import host
import checks
import highlighter_lists as hl
import error_templates as et
import ci_report as ci

const USAGE = 'usage: tomato run dev/test.tom main [-j N] [--fast] [--times] [--only WORDS]   (or TOMATO_TEST_JOBS=N, TOMATO_TEST_FAST=1, TOMATO_TEST_TIMES=1)'

# One test (or heading) of the plan, in the order of the output.
class Test:
    num: int = 0
    kind: str = ''        # s: a heading, t: a test, l: a test that must be run alone, after the others
    place: str = ''       # free, long, first, early, gate, cli or rest: when it is started
    section: str = ''
    func: str = ''        # the function of tests/run.sh (t_NAME)
    args: list[str] = []
    text: str = ''        # what it printed
    done: bool = False
    rc: int = 0
    passed: int = 0
    failed: int = 0
    work: str = ''
    cpu: list[int] = [0]

    @init
    def make(self, num: int, kind: str, place: str, section: str):
        self.num = num
        self.kind = kind
        self.place = place
        self.section = section
        self.args = []
        self.cpu = [0]

    def ok(self, name: str):
        self.text += 'ok   ' + name + '\n'
        self.passed += 1

    # FAIL name, and the detail under it, every line indented by 5
    def bad(self, name: str, detail: str = ''):
        self.text += 'FAIL ' + name + '\n'
        self.failed += 1
        if detail != '':
            self.indent(detail)

    def indent(self, detail: str):
        for line in detail.split('\n'):
            self.text += '     ' + line + '\n'

    # the shell's check: the two texts are equal once the newlines at their ends are taken off (as $(...) does)
    def check(self, name: str, expected: str, got: str):
        if expected.rstrip('\n') == got.rstrip('\n'):
            self.ok(name)
        else:
            self.bad(name, 'expected: ' + expected.rstrip('\n') + '\ngot:      ' + got.rstrip('\n'))

    # the results of a check of dev/checks.tom
    def outcomes(self, results: list[checks.Outcome]):
        for o in results:
            if o.note != '':
                self.text += o.note + '\n'
            elif o.passed:
                self.ok(o.name)
            else:
                self.bad(o.name, o.detail)

# The AddressSanitizer build of one program, made once by the first test that needs it.
class AsanBuild:
    done: asyncio.Event = asyncio.Event()
    built: bool = False
    ll: str = ''
    err: str = ''
    exe: str = ''

class Row:
    wall: int = 0
    section: str = ''
    label: str = ''
    cpu: int = 0

    @init
    def make(self, wall: int, section: str, label: str, cpu: int):
        self.wall = wall
        self.section = section
        self.label = label
        self.cpu = cpu

class Total:
    wall: int = 0
    cpu: int = 0
    slowest: int = 0
    count: int = 0

class Run:
    root: str = ''
    shared: str = ''
    script: str = ''
    jobs: int = 1
    cores: int = 1
    fast: bool = False
    times: bool = False
    tests: list[Test] = []
    skipped: list[str] = []
    next_print: int = 0
    slots: asyncio.Semaphore = asyncio.Semaphore(1)
    asan: dict[str, AsanBuild] = {}
    rows: list[Row] = []
    only: list[str] = []      # --only: run just the tests whose function (t_NAME) holds one of these words (for working on a test)

    @init
    def make(self, root: str, shared: str, jobs: int, cores: int, fast: bool, times: bool):
        self.root = root
        self.shared = shared
        self.script = root + '/tests/run.sh'
        self.jobs = jobs
        self.cores = cores
        self.fast = fast
        self.times = times
        self.tests = []
        self.skipped = []
        self.slots = asyncio.Semaphore(jobs)
        self.asan = {}
        self.rows = []
        self.only = []

    # tests/run.sh is started as the bridge: what it should do, and the folder it shares
    def bridge(self, what: str) -> dict[str, str]:
        env: dict[str, str] = {}
        env['TOMATO_TEST_BRIDGE'] = what
        env['TOMATO_TEST_SHARED'] = self.shared
        return env

    def flags(self) -> list[str]:
        out = ['-j', '1']
        if self.fast:
            out.append('--fast')
        if self.times:
            out.append('--times')
        return out

    # for the CPU time of a test, when --times asks for it
    def cpu_of(self, t: Test) -> list[int] | None:
        if self.times:
            return t.cpu
        return None

def env_flag(name: str) -> bool:
    v = os.getenv(name)
    if v is None:
        return False
    return v != '' and v != '0'

# The words of text, as the shell splits an unquoted variable (without looking for files)
def words(text: str) -> list[str]:
    out: list[str] = []
    for w in text.replace('\t', ' ').replace('\n', ' ').split(' '):
        if w != '':
            out.append(w)
    return out

# What the shell's `eval` reads out of a line of words each in single quotes, as tests/run.sh registers them
def unquote_words(line: str) -> list[str]:
    out: list[str] = []
    cur = ''
    have = False
    i = 0
    n = len(line)
    while i < n:
        c = line[i]
        if c == "'":
            j = line.find("'", i + 1)
            if j < 0:
                j = n
            cur += line[i + 1:j]
            have = True
            i = j + 1
        elif c == '\\' and i + 1 < n:
            cur += line[i + 1]
            have = True
            i += 2
        elif c == ' ':
            if have:
                out.append(cur)
                cur = ''
                have = False
            i += 1
        else:
            cur += c
            have = True
            i += 1
    if have:
        out.append(cur)
    return out

# ---- the plan ------------------------------------------------------------------------------------------------------------------

async def load_plan(r: Run):
    res = await host.run(['sh', r.script] + r.flags(), r.root, r.bridge('plan'))
    if res.status != 0:
        sys.write_stderr('dev/test.tom: tests/run.sh could not list the tests:\n' + res.stderr + res.stdout)
        sys.exit(1)
    for line in res.stdout.split('\n'):
        if line == '':
            continue
        parts = line.split('\t')
        if parts[0] == 'skip':
            r.skipped.append(parts[1])
            continue
        t = Test(int(parts[0]), parts[1], parts[2], parts[3])
        if t.kind != 's':
            w = unquote_words(os.read_text(r.shared + '/cmd.' + parts[0]))
            t.func = w[0]
            t.args = w[1:]
        if t.num != len(r.tests) + 1:
            sys.write_stderr('dev/test.tom: the plan is out of order at ' + parts[0] + '\n')
            sys.exit(1)
        r.tests.append(t)

# makes the runtime objects (while the compiler is built), as tests/run.sh does at its start
async def prepare(r: Run):
    _res = await host.run(['sh', r.script, '-j', '1'], r.root, r.bridge('prep'))

# ---- running a test ------------------------------------------------------------------------------------------------------------

def pump(r: Run):
    while r.next_print < len(r.tests) and r.tests[r.next_print].done:
        sys.write_stdout(r.tests[r.next_print].text)
        r.next_print += 1

# a test of tests/run.sh, run by it
async def run_legacy(r: Run, t: Test):
    env = r.bridge('job')
    env['TOMATO_TEST_JOB'] = str(t.num)
    env['TOMATO_TEST_CMD'] = os.read_text(r.shared + '/cmd.' + str(t.num))
    env['TOMATO_TEST_SECTION'] = t.section
    res = await host.run(['sh', r.script] + r.flags(), r.root, env)
    t.text += res.stdout + res.stderr
    t.rc = res.status
    if res.signal != 0 or res.status > 128:      # killed by a signal
        t.text += f'FAIL job died before it finished (status {res.status})\n'
        t.failed += 1

async def await_file(path: str) -> bool:
    i = 0
    while not ospath.exists(path):
        await sleep(0.05)
        i += 1
        if i > 12000:
            return False
    return True

# the path that a file of the shared folder names (the runtime objects, made by `prepare`)
async def shared_path(r: Run, name: str) -> str:
    _ok = await await_file(r.shared + '/' + name)
    return os.read_text(r.shared + '/' + name).rstrip('\n')

def is_native(func: str) -> bool:
    for name in ['t_example', 't_program', 't_program_asan', 't_asan', 't_neg', 't_error_text', 't_rt', 't_gap', 't_wasm_program', 't_wasm_neg', 't_wasm_rt', 't_error_templates', 't_highlighter_lists', 't_sys_version', 't_docs_in_sync', 't_versions', 't_error_raises', 't_builtin_folder', 't_std_modules', 't_reserved_names', 't_std_sheets', 't_generated_tables', 't_reserved_all', 't_module_names', 't_input', 't_input_traffic', 't_input_ask', 't_bigfloat', 't_bigdiv', 't_bigmul', 't_bigdec', 't_sort_fallback', 't_lock_gc', 't_release_asan', 't_release_leak', 't_release_error_line', 't_compiler_build', 't_fixed_point', 't_install', 't_wasm_config', 't_wasm_unstable', 't_wasm_browser', 't_wasm_sockets', 't_wasm_repl_import', 't_wasm_test_entry', 't_wasm_site_errors', 't_wasm_site_editor', 't_shell_portability', 't_std_public_fields']:
        if func == name:
            return True
    return False

# the ones that do not link a program with the runtime do not wait for it
def needs_runtime(func: str) -> bool:
    for name in ['t_install', 't_compiler_build', 't_error_templates', 't_highlighter_lists', 't_error_raises', 't_sys_version', 't_builtin_folder', 't_docs_in_sync', 't_versions']:
        if func == name:
            return False
    return not func.startswith('t_wasm_')

def short_name(t: Test) -> str:
    name = t.func
    if name.startswith('t_'):
        name = name[2:]
    first = ''
    if len(t.args) > 0:
        first = t.args[0]
    return name + ' ' + first

async def run_native(r: Run, t: Test):
    t.work = r.shared + '/j' + str(t.num)
    host.make_dir(t.work)
    try:
        rt_o = ''
        if needs_runtime(t.func):
            rt_o = await shared_path(r, 'rt_o.path')
        started = time.monotonic_ns()
        if t.func == 't_example':
            await native_example(r, t, rt_o)
        elif t.func == 't_program':
            await native_program(r, t, rt_o)
        elif t.func == 't_program_asan':
            await native_program_asan(r, t)
        elif t.func == 't_asan':
            await native_asan(r, t)
        elif t.func == 't_neg':
            await native_neg(r, t)
        elif t.func == 't_error_text':
            await native_error_text(r, t)
        elif t.func == 't_rt':
            await native_rt(r, t, rt_o)
        elif t.func == 't_gap':
            await native_gap(r, t, rt_o)
        elif t.func == 't_wasm_program':
            await native_wasm_program(r, t)
        elif t.func == 't_wasm_neg':
            await native_wasm_neg(r, t)
        elif t.func == 't_wasm_rt':
            await native_wasm_rt(r, t)
        elif t.func == 't_sys_version':
            t.outcomes(checks.sys_version())
        elif t.func == 't_docs_in_sync':
            t.outcomes(checks.docs_in_sync())
        elif t.func == 't_versions':
            t.outcomes(checks.versions())
        elif t.func == 't_error_raises':
            t.outcomes(checks.error_raises())
        elif t.func == 't_builtin_folder':
            t.outcomes(checks.builtin_folder())
        elif t.func == 't_std_modules':
            t.outcomes(checks.std_modules())
        elif t.func == 't_reserved_names':
            t.outcomes(checks.reserved_names(os.read_text('tests/run.sh')))
        elif t.func == 't_std_sheets':
            t.outcomes(checks.std_sheets())
        elif t.func == 't_generated_tables':
            t.outcomes(checks.generated_tables())
        elif t.func == 't_reserved_all':
            await native_reserved_all(r, t)
        elif t.func == 't_module_names':
            await native_module_names(r, t)
        elif t.func == 't_input':
            await native_input(r, t, rt_o)
        elif t.func == 't_input_traffic':
            await native_input_traffic(r, t, rt_o)
        elif t.func == 't_input_ask':
            await native_input_ask(r, t, rt_o)
        elif t.func == 't_bigfloat':
            await native_c_test(r, t, 'tests/bigfloat.c', [], ['-pthread', '-lm'], ['1500'], 'floats of any size (asan and ubsan, against an exact reference)', 'floats of any size', 'floats of any size')
        elif t.func == 't_bigdiv':
            await native_c_test(r, t, 'tests/bigdiv.c', [], ['-lm'], [], 'big integer division (asan and ubsan, against bitwise division)', 'big integer division', 'big integer division')
        elif t.func == 't_bigmul':
            await native_c_test(r, t, 'tests/bigmul.c', [], ['-lm'], [], 'big integer multiplication (asan and ubsan, Karatsuba and squaring against schoolbook)', 'big integer multiplication', 'big integer multiplication')
        elif t.func == 't_bigdec':
            flags = words(t.args[0])
            shown = ''
            if t.args[0] != '':
                shown = ' (' + t.args[0] + ')'
            await native_c_test(r, t, 'tests/bigdec.c', flags, ['-pthread', '-lm'], [], 'big integer decimal text' + shown + ' (asan and ubsan, against the plain loops)', 'big integer decimal text ' + t.args[0], 'big integer decimal text')
        elif t.func == 't_sort_fallback':
            await native_sort_fallback(r, t)
        elif t.func == 't_lock_gc':
            await native_lock_gc(r, t)
        elif t.func == 't_release_asan':
            await native_release_asan(r, t)
        elif t.func == 't_release_leak':
            await native_release_leak(r, t)
        elif t.func == 't_release_error_line':
            await native_release_error_line(r, t)
        elif t.func == 't_wasm_config':
            await native_wasm_config(r, t)
        elif t.func == 't_wasm_unstable':
            await native_wasm_unstable(r, t)
        elif t.func == 't_wasm_browser':
            await native_wasm_browser(r, t)
        elif t.func == 't_wasm_sockets':
            await native_wasm_sockets(r, t)
        elif t.func == 't_wasm_repl_import':
            await native_wasm_repl_import(r, t)
        elif t.func == 't_wasm_test_entry':
            await native_wasm_test_entry(r, t)
        elif t.func == 't_wasm_site_errors':
            await native_js_script(r, t, 'tests/site_errors.js', 'website: tomatoErrors keeps the words, escapes them, styles with classes', 'website: tomatoErrors')
        elif t.func == 't_wasm_site_editor':
            await native_js_script(r, t, 'tests/site_editor.js', 'website: editor auto-indent after a colon, backspace and tab', 'website: editor auto-indent')
        elif t.func == 't_shell_portability':
            await native_sh_script(r, t, 'tests/shell_portability.sh', 'no shipped shell script has a case inside a command substitution (bash 3.2)', 'shell portability')
        elif t.func == 't_std_public_fields':
            await native_sh_script(r, t, 'tests/std_public_fields.sh', 'no std class that calls the runtime has an unlisted public field', 'std public fields')
        elif t.func == 't_compiler_build':
            t.rc = await native_compiler_build(r, t)
        elif t.func == 't_fixed_point':
            await native_fixed_point(r, t)
        elif t.func == 't_install':
            await native_install(r, t)
        elif t.func == 't_error_templates':
            native_error_templates(t)
        elif t.func == 't_highlighter_lists':
            native_highlighter_lists(t)
        if r.times:
            wall = (time.monotonic_ns() - started) // 1000000
            r.rows.append(Row(wall, t.section, short_name(t), t.cpu[0]))
    finally:
        _x = await sys.run_async(['rm', '-rf', t.work])

def wanted(r: Run, t: Test) -> bool:
    if len(r.only) == 0 or t.place == 'gate':       # (the compiler is built whatever else is run)
        return True
    for w in r.only:
        if w in t.func:
            return True
    return False

async def execute(r: Run, t: Test):
    try:
        if not wanted(r, t):
            pass
        elif is_native(t.func):
            await run_native(r, t)
        else:
            await run_legacy(r, t)
    catch Error as e:
        t.text += f'FAIL {t.func}: the runner stopped it: {e.message}\n'
        t.failed += 1
    t.done = True
    pump(r)

# a job: it holds one of the slots while it runs
async def job(r: Run, t: Test) -> int:
    try:
        await execute(r, t)
    finally:
        r.slots.release()
    return t.rc

async def launch(r: Run, t: Test) -> task[int]:
    await r.slots.acquire()
    return start job(r, t)  # allow: unstable

# ---- the order: what tests/run.sh's run_all does ---------------------------------------------------------------------------------

def of_place(r: Run, place: str) -> list[Test]:
    out: list[Test] = []
    for t in r.tests:
        if t.kind != 's' and t.place == place:
            out.append(t)
    return out

def cli_ready(r: Run, install: Test | None) -> bool:
    if ospath.exists(r.shared + '/install.rc'):
        return True
    if install is not None and install.done:
        os.write_text(r.shared + '/install.rc', '1\n')
        return True
    return False

# Runs everything; gives 1 when the compiler could not be built (nothing else can run then), else 0.
async def run_all(r: Run) -> int:
    for t in r.tests:
        if t.kind == 's':
            t.text = t.section + '\n'
            t.done = True
    if r.jobs <= 1:                  # one after the other, in the order of the output
        for t in r.tests:
            if t.kind == 's':
                pump(r)
                continue
            await execute(r, t)
            if t.place == 'gate' and t.rc != 0:
                pump(r)
                return 1
        pump(r)
        return 0
    running: list[task[int]] = []
    early = of_place(r, 'early')
    gate = of_place(r, 'gate')
    free = of_place(r, 'free')
    install: Test | None = None
    if len(early) > 0:
        install = early[0]
    for t in early:
        running.append(await launch(r, t))
    if len(gate) > 0:                # the compiler: nothing else that uses it can start before it; the tests that do not run beside it
        g = gate[0]
        gate_task = await launch(r, g)
        running.append(gate_task)
        while len(free) > 0 and not g.done:
            running.append(await launch(r, free.pop(0)))
        await gate_task
        if g.rc != 0:
            await asyncio.wait_all(running)
            pump(r)
            return 1
    todo = free + of_place(r, 'long') + of_place(r, 'first') + of_place(r, 'rest')
    cli = of_place(r, 'cli')
    deferred: list[Test] = []
    while True:                      # the tests that need the installed `tomato` first, as soon as it is there; then the long ones; then the others
        pick: Test | None = None
        if len(cli) > 0 and cli_ready(r, install):
            pick = cli.pop(0)
        elif len(todo) > 0:
            pick = todo.pop(0)
        elif len(cli) > 0:
            await sleep(0.05)
            continue
        else:
            break
        if pick is not None:
            if pick.kind == 'l':
                deferred.append(pick)
            else:
                running.append(await launch(r, pick))
    await asyncio.wait_all(running)
    pump(r)
    for t in deferred:              # alone, after everything else
        await execute(r, t)
    pump(r)
    return 0

# ---- the ported tests ----------------------------------------------------------------------------------------------------------

def errors_in(marked: list[str]) -> bool:
    return len(marked) > 0

# the first n of the lines of the IR that start with ";! " (what the compiler said)
def warning_lines(marked: list[str], n: int) -> list[str]:
    out: list[str] = []
    for line in marked:
        out.append(line)
        if len(out) >= n:
            break
    return out

# Does the IR carry a warning other than the unstable-feature one? A program of tests/programs may use the marker names and `start` (U5,
# U6: D129a) without `# allow: unstable` on every use; the warning is tested by tests/errors/unstable_* and the CLI tests.
def own_warnings(marked: list[str]) -> bool:
    skip = False
    for line in marked:
        if line.startswith(';! warning') or line.startswith(';! error'):
            skip = 'is an unstable feature' in line
        if not skip:
            return True
    return False

# A program whose first line says "# borrowed loops: N" must compile exactly N loops that borrow their item
def lent_loops_ok(ll: str, name: str) -> bool:
    first = host.read_text_lossy('tests/programs/' + name + '.tom').split('\n')[0]
    if not first.startswith('# borrowed loops: '):
        return True
    want = first[len('# borrowed loops: '):]
    if want == '':
        return True
    return str(host.count_matching(ll, 'lent\\.slot\\.[0-9]* = alloca')) == want

# the programs that write files get the folder of their test; some take inputs
def program_arg(name: str, work: str) -> list[str]:
    for w in ['toml_api', 'json_files', 'msgpack_files', 'msgpack_file_basics', 'os_files', 'file_lines', 'file_loop_close', 'file_modes', 'file_closed', 'file_drop_loop', 'bytes_files', 'sys_run', 'sys_async']:
        if name == w:
            return [work]
    if name == 'sys_basics':
        return ['alpha']
    if name == 'sys_args':
        return ['7', 'b', 'c']
    return []

# compiles a program with the compiler of this run (c1) and keeps the IR in `ll`
# (the IR goes straight to the file, as `> ll` does: it is megabytes, and this one process reads the output of every test)
async def compile_ir(r: Run, t: Test, args: list[str], ll: str) -> sys.RunResult:
    rc = await host.redirect([r.shared + '/c1'] + args, ll, r.root, None, r.cpu_of(t), None, '', ll + '.err')
    return sys.RunResult(rc, 0, '', host.read_text_lossy(ll + '.err'))

# a compile of which only the messages are wanted (`2>&1 >/dev/null`): its status and standard error
async def compile_messages(r: Run, t: Test, args: list[str], work: str) -> sys.RunResult:
    rc = await host.redirect([r.shared + '/c1'] + args, '/dev/null', r.root, None, r.cpu_of(t), None, '', work + '/messages')
    return sys.RunResult(rc, 0, '', host.read_text_lossy(work + '/messages'))

# a clang that links `ll` with the runtime object `rt` into `exe`: its status
async def link(r: Run, t: Test, ll: str, rt: str, exe: str) -> int:
    res = await host.run(['clang', '-O1', '-w', '-o', exe, ll, rt, '-pthread', '-lm'], r.root, None, r.cpu_of(t))
    if res.status != 0:
        t.text += res.stdout + res.stderr
    return res.status

# does the program's output (both streams in `out`) equal the expected file
def same_bytes(a: str, b: str) -> bool:
    return host.read_bytes_or_empty(a) == host.read_bytes_or_empty(b) and ospath.exists(a) and ospath.exists(b)

async def native_example(r: Run, t: Test, rt_o: str):
    name = t.args[0]
    entry = t.args[1]
    rest = t.args[2]
    tag = name + ' ' + entry
    ll = t.work + '/p.ll'
    res = await compile_ir(r, t, ['examples/' + name + '.tom', entry, 'std/'], ll)
    if res.status != 0:
        t.text += f'FAIL {tag}: {res.stderr.rstrip(chr(10))}\n'
        t.failed += 1
        return
    marked = host.marked_lines(ll)
    if errors_in(marked):
        t.text += f'FAIL {tag}: warnings\n'
        t.indent('\n'.join(warning_lines(marked, 6)))
        t.failed += 1
        return
    if await link(r, t, ll, rt_o, t.work + '/p') != 0:
        t.text += f'FAIL {tag}: link\n'
        t.failed += 1
        return
    out = t.work + '/out'
    _rc = await host.redirect([t.work + '/p'] + words(rest), out, r.root, None, r.cpu_of(t))
    expected = 'tests/expected/' + name + '.' + entry + '.out'
    if same_bytes(out, expected):
        t.text += f'ok   {tag}\n'
        t.passed += 1
    else:
        t.text += f'FAIL {tag}\n'
        t.indent('\n'.join(host.diff_head(out, expected, 5)))
        t.failed += 1

async def native_program(r: Run, t: Test, rt_o: str):
    name = t.args[0]
    ll = t.work + '/p.ll'
    res = await compile_ir(r, t, ['tests/programs/' + name + '.tom', 'main', 'std/'], ll)
    if own_warnings(host.marked_lines(ll)):
        t.text += f'FAIL program {name} has warnings\n'
        t.failed += 1
        return
    if not lent_loops_ok(ll, name):
        t.text += f'FAIL program {name}: the number of loops that borrow their item changed\n'
        t.failed += 1
        return
    out = t.work + '/out'
    if ospath.getsize(ll) > 0 and await link(r, t, ll, rt_o, t.work + '/p') == 0:
        _rc = await host.redirect([t.work + '/p'] + program_arg(name, t.work), out, r.root, None, r.cpu_of(t))
    expected = 'tests/expected/' + name + '.main.out'
    if same_bytes(out, expected):
        t.text += f'ok   program {name}\n'
        t.passed += 1
    else:
        t.text += f'FAIL program {name}\n'
        detail: list[str] = []
        for line in res.stderr.split('\n')[:3]:
            if line != '':
                detail.append(line)
        t.indent('\n'.join(detail + host.diff_head(out, expected, 5)))
        t.failed += 1

# The IR of a program, with what the compiler said, and its AddressSanitizer build. Made once, by the first of the tests that need it
# (the others wait for it); `built` is False when this clang cannot build with AddressSanitizer.
async def asan_build(r: Run, t: Test, path: str) -> AsanBuild:
    key = path.replace('/', '_')
    known = r.asan.get(key)
    if known is not None:
        await known.done.wait()
        return known
    b = AsanBuild()
    dir = r.shared + '/asan'
    host.make_dir(dir)
    b.ll = dir + '/' + key + '.ll'
    b.err = dir + '/' + key + '.err'
    b.exe = dir + '/' + key + '.exe'
    r.asan[key] = b
    try:
        rt_asan = await shared_path(r, 'rt_asan.path')
        res = await compile_ir(r, t, [path + '.tom', 'main', 'std/'], b.ll)
        os.write_text(b.err, res.stderr)
        if rt_asan != '':
            c = await host.run(['clang', '-O1', '-w', '-g', '-fsanitize=address', '-o', b.exe + '.tmp', b.ll, rt_asan, '-pthread', '-lm'], r.root, None, r.cpu_of(t))
            if c.status == 0:
                os.rename(b.exe + '.tmp', b.exe)
                b.built = True
    finally:
        b.done.set()
    return b

# the same test as native_program, for a program that an AddressSanitizer test builds too: its output (standard output and standard
# error) from that build, which asan_build makes once for both
async def native_program_asan(r: Run, t: Test):
    name = t.args[0]
    b = await asan_build(r, t, 'tests/programs/' + name)
    if own_warnings(host.marked_lines(b.ll)):
        t.text += f'FAIL program {name} has warnings\n'
        t.failed += 1
        return
    if not lent_loops_ok(b.ll, name):
        t.text += f'FAIL program {name}: the number of loops that borrow their item changed\n'
        t.failed += 1
        return
    out = t.work + '/out'
    if b.built:
        _rc = await host.redirect([b.exe] + program_arg(name, t.work), out, r.root, None, r.cpu_of(t))
    expected = 'tests/expected/' + name + '.main.out'
    if same_bytes(out, expected):
        t.text += f'ok   program {name}\n'
        t.passed += 1
    else:
        t.text += f'FAIL program {name}\n'
        detail: list[str] = []
        for line in host.read_text_lossy(b.err).split('\n')[:3]:
            if line != '':
                detail.append(line)
        t.indent('\n'.join(detail + host.diff_head(out, expected, 5)))
        t.failed += 1

# PATH:ARGUMENT, the argument being a folder the program may write into when it is WORK
async def native_asan(r: Run, t: Test):
    spec = t.args[0]
    path = spec.partition(':')[0]
    name = path.rpartition('/')[2]
    arg = spec.partition(':')[2]
    if arg == 'WORK':
        arg = t.work
    b = await asan_build(r, t, path)
    if b.built:
        # a failure shows the head of the sanitizer report (with ASAN_SYMBOLIZER_PATH set, as the Linux CI job does, that includes the
        # leaking allocation's stack)
        res = await host.run([b.exe] + words(arg), r.root, None, r.cpu_of(t))
        head: list[str] = []
        for line in res.stderr.split('\n')[:14]:
            head.append(line)
        out = '\n'.join(head).rstrip('\n')
        if out == '':
            t.ok('asan ' + name)
        else:
            t.bad('asan ' + name, out)
    else:
        t.bad('asan ' + name, 'this clang cannot build with -fsanitize=address')

# FILE, the message the compiler must report, and the entry name (default main; `test` for the @test checks)
async def native_neg(r: Run, t: Test):
    entry = 'main'
    if len(t.args) > 2 and t.args[2] != '':
        entry = t.args[2]
    res = await compile_messages(r, t, ['tests/negative/' + t.args[0] + '.tom', entry, 'std/'], t.work)
    msg = res.stderr.rstrip('\n')
    if t.args[1] in msg:
        if res.status != 0:
            t.ok('rejects ' + t.args[0])
        else:
            t.bad('rejects ' + t.args[0], 'exit status was 0')
    else:
        t.bad('rejects ' + t.args[0], 'wanted: ' + t.args[1] + '\ngot:    ' + msg)

# the whole text of what the compiler says about a program (its errors, then its warnings: they travel as comment lines at the end of the IR)
async def native_error_text(r: Run, t: Test):
    f = t.args[0]
    n = f.rpartition('/')[2]
    n = n[:len(n) - 4]
    res = await compile_ir(r, t, [f, 'main', 'std/'], t.work + '/err.ll')
    got = res.stderr
    for line in host.marked_lines(t.work + '/err.ll'):
        got += line[3:] + '\n'
    expected = 'tests/errors/' + n + '.out'
    if got == host.read_text_lossy(expected):
        t.ok('error text: ' + n)
    else:
        os.write_text(t.work + '/err.out', got)
        t.bad('error text: ' + n, '\n'.join(host.diff_head(t.work + '/err.out', expected, 6)))

# FILE, the text that the program's output (standard output, then standard error) must hold, and its exit status
async def native_rt(r: Run, t: Test, rt_o: str):
    name = t.args[0]
    ll = t.work + '/r.ll'
    res = await compile_ir(r, t, ['tests/runtime/' + name + '.tom', 'main', 'std/'], ll)
    if res.status != 0 or await link(r, t, ll, rt_o, t.work + '/r') != 0:
        t.bad('runtime ' + name, 'did not build')
        return
    run = await host.run([t.work + '/r'], r.root, None, r.cpu_of(t))
    seen = run.stdout + run.stderr
    if t.args[1] in seen.rstrip('\n'):
        if str(run.status) == t.args[2]:
            t.ok('runtime ' + name)
        else:
            t.bad('runtime ' + name, f'exit status {run.status}, wanted {t.args[2]}')
    else:
        t.bad('runtime ' + name, f"wanted '{t.args[1]}', got: {seen.rstrip(chr(10))}")

# Each file is a program a decision says must be rejected (should_reject_*) or must work (should_work_*). The test passes while the gap
# exists and FAILS when the compiler gains the behavior, so the list cannot go stale.
async def native_gap(r: Run, t: Test, rt_o: str):
    f = t.args[0]
    n = f.rpartition('/')[2]
    n = n[:len(n) - 4]
    accepted = 'no'
    ll = t.work + '/g.ll'
    res = await compile_ir(r, t, [f, 'main', 'std/'], ll)
    if res.status == 0:
        c = await host.run(['clang', '-O1', '-w', '-o', t.work + '/g', ll, rt_o, '-pthread', '-lm'], r.root, None, r.cpu_of(t))
        if c.status == 0:
            accepted = 'yes'
            run = await host.run([t.work + '/g'], r.root, None, r.cpu_of(t))
            if run.status != 0:
                accepted = 'fails'
    if n.startswith('should_reject_'):
        if accepted == 'no':
            t.bad('known gap closed: ' + n, 'move it to tests/negative')
        else:
            t.ok('known gap: ' + n + ' (still accepted)')
    elif n.startswith('should_work_'):
        if accepted == 'yes':
            t.bad('known gap closed: ' + n, 'move it to tests/programs')
        else:
            t.ok('known gap: ' + n + ' (still unsupported)')

# ---- the same programs through WebAssembly (site/wasm, the website and repl path) ----------------------------------------------------
# A JavaScript shell: jsc on macOS, else Node running the same script through native/jsc-on-node.js (the script is not changed).

def js_shell(r: Run) -> list[str]:
    mac = '/System/Library/Frameworks/JavaScriptCore.framework/Versions/A/Helpers/jsc'
    if ospath.isfile(mac):
        return [mac]
    node = host.which('node')
    if node is not None:
        return ['node', r.root + '/native/jsc-on-node.js']
    return []

# The toolchain script, with the run limit. A run the limit stopped (the toolchain says error[E369]: it ran out of time, on a machine that is
# busy) is run again with three times the limit, up to three runs in all; a wrong answer, a compile error, a crash or anything else is the
# first run's result, never run again. Gives what the last run printed (standard output, then standard error) and its status.
async def tjsc(r: Run, t: Test, args: list[str]) -> tuple[str, str, int]:
    limit = 30000
    v = os.getenv('TOMATO_WASM_TIMEOUT_MS')
    if v is not None and v.isdigit():
        limit = int(v)
    tries = 1
    while True:
        res = await host.run(js_shell(r) + ['native/tomato-jsc.js', '--', f'--timeout-ms={limit}'] + args, r.root, None, r.cpu_of(t))
        if tries < 3 and '\nerror[E369]' in '\n' + res.stderr:
            limit = limit * 3
            tries += 1
            continue
        return (res.stdout, res.stderr, res.status)

# does the text hold each of the pieces, in this order (the shell's case pattern *A*B*)
def holds_in_order(text: str, pieces: list[str]) -> bool:
    at = 0
    for piece in pieces:
        i = text.find(piece, at)
        if i < 0:
            return False
        at = i + len(piece)
    return True

async def native_wasm_program(r: Run, t: Test):
    name = t.args[0]
    got = await tjsc(r, t, ['site/wasm', 'run', 'tests/programs/' + name + '.tom'])
    expected = 'tests/expected/' + name + '.main.out'
    # the runner drops one trailing newline and adds an "~rc" line; compare ignoring both
    if got[0].rstrip('\n') == host.read_text_lossy(expected).rstrip('\n'):
        t.ok('wasm ' + name)
    else:
        os.write_text(t.work + '/js.out', got[0])
        detail = host.diff_head(t.work + '/js.out', expected, 4)
        for line in got[1].split('\n')[:2]:
            detail.append(line)
        t.bad('wasm ' + name, '\n'.join(detail).rstrip('\n'))

# rejected programs and runtime errors through the same path (the messages and failures must agree with native)
async def native_wasm_neg(r: Run, t: Test):
    got = await tjsc(r, t, ['site/wasm', 'run', 'tests/negative/' + t.args[0] + '.tom'])
    m = (got[0] + got[1]).rstrip('\n')
    if holds_in_order(m, [t.args[1], '~rc 1']):
        t.ok('wasm rejects ' + t.args[0])
    else:
        t.bad('wasm rejects ' + t.args[0], 'wanted: ' + t.args[1] + '\ngot: ' + m)

async def native_wasm_rt(r: Run, t: Test):
    got = await tjsc(r, t, ['site/wasm', 'run', 'tests/runtime/' + t.args[0] + '.tom'])
    m = (got[0] + got[1]).rstrip('\n')
    if holds_in_order(m, [t.args[1], '~rc ' + t.args[2]]):
        t.ok('wasm runtime ' + t.args[0])
    else:
        t.bad('wasm runtime ' + t.args[0], f'wanted: {t.args[1]} (rc {t.args[2]})\ngot: {m}')

# ---- more ported tests -----------------------------------------------------------------------------------------------------------

# the text of the first n lines of a file (head -n), without the newline at its end
def head_lines(path: str, n: int) -> str:
    out: list[str] = []
    for line in host.read_text_lossy(path).split('\n'):
        if len(out) >= n:
            break
        out.append(line)
    return '\n'.join(out).rstrip('\n')

# the last of the lines of IR that the compiler marks as warnings, without their marker, as text (grep '^;! ' | sed 's/^;! //')
def warnings_text(ll: str) -> str:
    out = ''
    for line in host.marked_lines(ll):
        out += line[3:] + '\n'
    return out

async def native_reserved_all(r: Run, t: Test):
    bad_names = ''
    for n in ['bench', 'example', 'setup', 'teardown', 'deprecated', 'main', 'init', 'add', 'sub', 'mul', 'div', 'floordiv', 'mod', 'pow', 'eq', 'lt', 'le', 'gt', 'ge', 'str', 'iter', 'len', 'get', 'slice', 'contains', 'reversed', 'static', 'bitarray', 'set', 'bitand', 'bitor', 'bitxor', 'invert', 'neg', 'rmul', 'hash']:
        src = t.work + '/res.tom'
        os.write_text(src, f'@{n}.x\ndef f():\n    print(1)\n\n@main\ndef main():\n    pass\n')
        res = await compile_messages(r, t, [src, 'main', 'std/'], t.work)
        if f"'@{n}.x' uses a name the language reserves" not in res.stderr.rstrip('\n'):
            bad_names += ' ' + n
    if bad_names == '':
        t.ok('every reserved marker name is refused when dotted')
    else:
        t.bad('every reserved marker name is refused when dotted', 'not refused:' + bad_names)

# a project file with the name of a std module warns (once for each name), and a file with a planned name does not (D115a)
async def native_module_names(r: Run, t: Test):
    d = t.work + '/mn'
    host.make_dir(d)
    os.write_text(d + '/json.tom', 'export def hello() -> str:\n    return "mine"\n')
    os.write_text(d + '/queue.tom', 'export def q() -> int:\n    return 1\n')
    os.write_text(d + '/shadow.tom', 'import json\nfrom json import hello\nimport queue\n\n@main\ndef main():\n    print(json.hello(), hello(), queue.q())\n')
    res = await compile_ir(r, t, [d + '/shadow.tom', 'main', 'std/'], d + '/mn.ll')
    got = res.stderr + warnings_text(d + '/mn.ll')
    t.check("module names: a file with a std module's name warns once, naming both", "warning: the file json.tom of this project shadows the standard module 'json'\n --> " + d + "/shadow.tom:1:8\n  |\n1 | import json\n  |        ^^^^\n  = help: importing 'json' gets the file, not the standard library's module; rename the file to get the standard one\n  = help: to keep the file on purpose, write '# allow: module-shadow' on the import line", got)
    os.write_text(d + '/quiet.tom', 'import json  # allow: module-shadow\nimport queue\n\n@main\ndef main():\n    print(json.hello(), queue.q())\n')
    res = await compile_ir(r, t, [d + '/quiet.tom', 'main', 'std/'], d + '/mn.ll')
    t.check('module names: # allow: module-shadow silences it, and a planned name (queue) never warns', '', res.stderr + warnings_text(d + '/mn.ll'))
    os.write_text(d + '/aliased.tom', 'import json as j\n\n@main\ndef main():\n    print(j.hello())\n')
    res = await compile_ir(r, t, [d + '/aliased.tom', 'main', 'std/'], d + '/mn.ll')
    first = warnings_text(d + '/mn.ll').split('\n')[0]
    t.check('module names: an alias does not hide the shadowing', "warning: the file json.tom of this project shadows the standard module 'json'", res.stderr + first + '\n')
    os.write_text(d + '/uses_json.tom', 'import json\nexport def x() -> str:\n    return json.hello()\n')
    os.write_text(d + '/two_files.tom', 'import json\nimport uses_json\n\n@main\ndef main():\n    print(json.hello(), uses_json.x())\n')
    _res = await compile_ir(r, t, [d + '/two_files.tom', 'main', 'std/'], d + '/mn.ll')
    count = 0
    for line in host.marked_lines(d + '/mn.ll'):
        if line.startswith(';! warning: the file json.tom'):
            count += 1
    t.check('module names: the warning comes once for each name in a build, though two files import it', '1', str(count))

# ---- input: the file NAME.in is the standard input, NAME.out the whole output ----

async def native_input(r: Run, t: Test, rt_o: str):
    f = t.args[0]
    n = f.rpartition('/')[2]
    n = n[:len(n) - 4]
    ll = t.work + '/i.ll'
    res = await compile_ir(r, t, [f, 'main', 'std/'], ll)
    if res.status != 0 or await link(r, t, ll, rt_o, t.work + '/i') != 0:
        t.bad('input ' + n, 'did not build: ' + res.stderr.rstrip('\n'))
        return
    out = t.work + '/o'
    expected = 'tests/input/' + n + '.out'
    _rc = await host.redirect([t.work + '/i'], out, r.root, None, r.cpu_of(t), None, 'tests/input/' + n + '.in')
    if same_bytes(out, expected):
        t.ok('input ' + n)
    else:
        t.bad('input ' + n, '\n'.join(host.diff_head(out, expected, 6)))
    if len(js_shell(r)) > 0:
        got = await tjsc(r, t, ['site/wasm', 'run', f, 'tests/input/' + n + '.in'])
        kept: list[str] = []
        for line in (got[0] + got[1]).split('\n'):
            if not line.startswith('~rc '):
                kept.append(line)
        if '\n'.join(kept).rstrip('\n') == host.read_text_lossy(expected).rstrip('\n'):
            t.ok('wasm input ' + n)
        else:
            t.bad('wasm input ' + n, '\n'.join((got[0] + got[1]).split('\n')[:6]).rstrip('\n'))

# an endless socket exchange must not keep a waiting input from a line that is already there
async def native_input_traffic(r: Run, t: Test, rt_o: str):
    ll = t.work + '/i.ll'
    res = await compile_ir(r, t, ['tests/input_traffic.tom', 'main', 'std/'], ll)
    if res.status != 0 or await link(r, t, ll, rt_o, t.work + '/i') != 0:
        t.bad('input with socket traffic', 'did not build: ' + res.stderr.rstrip('\n'))
        return
    os.write_text(t.work + '/in', 'ready\n')
    _rc = await host.redirect([t.work + '/i'], t.work + '/o', r.root, None, r.cpu_of(t), None, t.work + '/in')
    t.check('input with socket traffic', 'ready? line ready', host.read_text_lossy(t.work + '/o'))

# with no answer in the pipe, the host is asked (exit 75) only after the task that was due has printed
async def native_input_ask(r: Run, t: Test, rt_o: str):
    ll = t.work + '/i.ll'
    res = await compile_ir(r, t, ['tests/input_ask.tom', 'main', 'std/'], ll)
    if res.status != 0 or await link(r, t, ll, rt_o, t.work + '/i') != 0:
        t.bad('input asks last', 'did not build: ' + res.stderr.rstrip('\n'))
        return
    env: dict[str, str] = {}
    env['TOMATO_INPUT_ASK'] = '1'
    rc = await host.redirect([t.work + '/i'], t.work + '/o', r.root, env, r.cpu_of(t))
    got = host.read_text_lossy(t.work + '/o') + f'rc={rc}'
    t.check('input asks last', 'tick\nready? rc=75', got)

# ---- the C tests of the runtime's big numbers, under AddressSanitizer and UBSan ----

async def native_c_test(r: Run, t: Test, source: str, flags: list[str], libs: list[str], args: list[str], ok_name: str, bad_name: str, bad_build_name: str):
    c = await host.run(['clang', '-O1', '-w', '-g', '-fsanitize=address,undefined', '-fno-sanitize-recover=undefined'] + flags + ['-o', t.work + '/bin', source] + libs, r.root, None, r.cpu_of(t))
    if c.status != 0:
        first: list[str] = []
        for line in c.stderr.split('\n')[:3]:
            first.append(line)
        t.bad(bad_build_name, source + ' does not build: ' + '\n'.join(first).rstrip('\n'))
        return
    _rc = await host.redirect([t.work + '/bin'] + args, t.work + '/o', r.root, None, r.cpu_of(t))
    out = head_lines(t.work + '/o', 14)
    if out == 'ok':
        t.ok(ok_name)
    else:
        t.bad(bad_name, out)

async def native_sort_fallback(r: Run, t: Test):
    ll = t.work + '/p.ll'
    res = await compile_ir(r, t, ['tests/programs/native_sort.tom', 'main', 'std/'], ll)
    got = ''
    if res.status == 0:
        obj = await host.rtcache_object(r.root, t.work, 'o', r.root + '/runtime/tomato_rt.c', ['-O1', '-pthread', '-w', '-DSORT_DEPTH_MUL=0'])
        c = await host.run(['clang', '-O1', '-w', '-o', t.work + '/p', ll, obj, '-pthread', '-lm'], r.root, None, r.cpu_of(t))
        if c.status == 0:
            _rc = await host.redirect([t.work + '/p'], t.work + '/out', r.root, None, r.cpu_of(t))
            got = host.read_text_lossy(t.work + '/out')
    t.check('sort with the depth limit forced to 0', host.read_text_lossy('tests/expected/native_sort.main.out'), got)

# A task waiting for a lock that the cycle collector frees must leave the runtime's list of lock waiters: the deadlock report after it names
# only the task that is really waiting, and AddressSanitizer sees no read of the freed frame or lock
async def native_lock_gc(r: Run, t: Test):
    name = 'lock waiters freed by the collector leave no stale report'
    rt_asan = await shared_path(r, 'rt_asan.path')
    ll = t.work + '/g.ll'
    _res = await compile_ir(r, t, ['tests/runtime/async_lock_gc.tom', 'main', 'std/'], ll)
    c = await host.run(['clang', '-O1', '-w', '-g', '-fsanitize=address', '-o', t.work + '/g', ll, rt_asan, '-pthread', '-lm'], r.root, None, r.cpu_of(t))
    if c.status != 0:
        t.bad(name, 'does not build')
        return
    env: dict[str, str] = {}
    env['ASAN_OPTIONS'] = 'detect_leaks=0'
    _rc = await host.redirect([t.work + '/g'], t.work + '/out', r.root, env, r.cpu_of(t))
    text = host.read_text_lossy(t.work + '/out')
    n = 0
    for line in text.split('\n'):
        if line.startswith('  task ') and ' is waiting' in line:
            rest = line[len('  task '):].partition(' ')[0]
            if rest == '' or rest.isdigit():
                n += 1
    if n == 1 and 'task 1 is waiting at line 31 for a lock held since line 30' in text and 'AddressSanitizer' not in text:
        t.ok(name)
    else:
        t.bad(name, head_lines(t.work + '/out', 8))

# program, "leaks" to look for leaks too
async def native_release_asan(r: Run, t: Test):
    name = t.args[0]
    rt_asan = await shared_path(r, 'rt_asan.path')
    arg: list[str] = []
    if name == 'file_closed' or name == 'sys_run' or name == 'sys_async':
        arg.append(t.work)             # it writes files: into this test's own folder
    ll = t.work + '/p.ll'
    _res = await compile_ir(r, t, ['tests/programs/' + name + '.tom', 'main', 'std/', 'release'], ll)
    c = await host.run(['clang', '-O1', '-w', '-g', '-fsanitize=address', '-o', t.work + '/rel', ll, rt_asan, '-pthread', '-lm'], r.root, None, r.cpu_of(t))
    if c.status != 0:
        t.bad('release ' + name, 'does not build')
        return
    leaks = len(t.args) > 1 and t.args[1] == 'leaks'
    env: dict[str, str] = {}
    if not leaks:
        env['ASAN_OPTIONS'] = 'detect_leaks=0'
    _rc = await host.redirect([t.work + '/rel'] + arg, t.work + '/out', r.root, env, r.cpu_of(t), None, '', t.work + '/e')
    body = host.read_bytes_or_empty(t.work + '/out')
    err = host.read_bytes_or_empty(t.work + '/e')
    if leaks:
        body = body + err
    else:
        pieces = err.split(b'\n')
        if len(pieces) > 0 and len(pieces[len(pieces) - 1]) == 0:
            pieces.pop()
        for piece in pieces:
            if b'never freed' not in piece:
                body = body + piece + b'\n'
    os.write_bytes(t.work + '/out', body)
    expected = 'tests/expected/' + name + '.main.out'
    if same_bytes(t.work + '/out', expected):
        t.ok('release ' + name)
    else:
        t.bad('release ' + name, '\n'.join(host.diff_head(t.work + '/out', expected, 5)))

# fused expressions over big numbers; the test itself is tested by taking the frees out of the runtime
async def native_release_leak(r: Run, t: Test):
    rt_asan = await shared_path(r, 'rt_asan.path')
    os.write_text(t.work + '/leak.tom', 'def work():\n    x = 2 ** 70\n    xs = [2 ** 65, 7]\n    for i in range(40):\n        x = x * 3 - i * xs[i % 2] + 1\n        xs[1] = xs[1] * xs[0] - x % 1000003\n    print(x % 97, xs[1] % 97)\n\n@main\ndef main():\n    work()\n')
    ll = t.work + '/p.ll'
    res = await compile_ir(r, t, [t.work + '/leak.tom', 'main', 'std/', 'release'], ll)
    got = ''
    if res.status == 0:
        c = await host.run(['clang', '-O1', '-w', '-g', '-fsanitize=address', '-o', t.work + '/rel', ll, rt_asan, '-pthread', '-lm'], r.root, None, r.cpu_of(t))
        if c.status == 0:
            _rc = await host.redirect([t.work + '/rel'], t.work + '/o1', r.root, None, r.cpu_of(t))
            got = host.read_text_lossy(t.work + '/o1')
    t.check('release: big numbers in fused expressions are freed', '55 51', got)
    kept: list[str] = []
    for line in host.read_text_lossy('runtime/tomato_rt.c').split('\n'):
        if line.startswith('#define INT_CONSUME(m, x, y) '):
            kept.append('#define INT_CONSUME(m, x, y) do { } while (0)')
        else:
            kept.append(line)
    os.write_text(t.work + '/leaky.c', '\n'.join(kept))
    obj = await host.rtcache_object(r.root, t.work, 'o', t.work + '/leaky.c', ['-O1', '-pthread', '-w'])   # (kept in the cache by what the file holds)
    c = await host.run(['clang', '-O1', '-w', '-o', t.work + '/leaky', ll, obj, '-pthread', '-lm'], r.root, None, r.cpu_of(t))
    seen = ''
    if c.status == 0:
        _rc = await host.redirect([t.work + '/leaky'], t.work + '/o2', r.root, None, r.cpu_of(t))
        seen = host.read_text_lossy(t.work + '/o2')
    if 'never freed' in seen:
        t.ok('release: a big number that is not freed is reported')
    else:
        t.bad('release: a big number that is not freed is reported')

# An uncaught error in release mode prints one line, `error[ID]: Class: message (line N)` (a runtime failure: no class), and no trace.
# The long message is 10000 bytes; the same programs run under AddressSanitizer, whose runtime reports nothing.
async def native_release_error_line(r: Run, t: Test):
    rt_asan = await shared_path(r, 'rt_asan.path')
    long_text = 'config file missing key '
    for _i in range(2000):
        long_text += 'port '
    long_want = 'error[E11]: ValueError: ' + long_text + ' (line 5)'
    for spec in [('release_long_message', long_want), ('divide_by_zero', 'error[E01]: division by zero (line ')]:
        name = spec[0]
        want = spec[1]
        ll = t.work + '/p.ll'
        _res = await compile_ir(r, t, ['tests/runtime/' + name + '.tom', 'main', 'std/', 'release'], ll)
        c = await host.run(['clang', '-O1', '-w', '-g', '-fsanitize=address', '-o', t.work + '/rel', ll, rt_asan, '-pthread', '-lm'], r.root, None, r.cpu_of(t))
        if c.status != 0:
            t.bad('release ASan: ' + name, 'does not build')
            continue
        env: dict[str, str] = {}
        env['ASAN_OPTIONS'] = 'detect_leaks=0'
        rc = await host.redirect([t.work + '/rel'], t.work + '/out', r.root, env, r.cpu_of(t), None, '', t.work + '/err')
        err = host.read_text_lossy(t.work + '/err')
        lines = 0
        for ch in err:
            if ch == '\n':
                lines += 1
        if err.rstrip('\n').startswith(want):
            t.ok('release ASan: ' + name + ' prints the class, the message and the line')
        else:
            t.bad('release ASan: ' + name + ' prints the class, the message and the line', err[:300])
        t.check('release ASan: ' + name + ' is one line, no trace, status 1', '1 1', f'{lines} {rc}')

# ---- the compiler and the install: what every other test uses ------------------------------------------------------------------

# the compiler everything else uses: shared/c0 (from the bootstrap IR) and shared/c1 (built by c0); gives 0, or 1 when it could not be made
async def native_compiler_build(r: Run, t: Test) -> int:
    # the IR is compiled while the runtime object is made (or fetched from the cache), then they are linked: the same program as one clang command
    ir = start host.run([r.root + '/compiler/bootstrap/build-object.sh', r.shared + '/c0.o'], r.root)  # allow: unstable
    rt_o = await shared_path(r, 'rt_o.path')
    built = await ir
    errors = built.stderr
    if built.status == 0:
        os.write_text(r.shared + '/c0.o.done', '')
    else:
        os.write_text(r.shared + '/c0.o.failed', '')
    # build-object.sh falls back to one clang process when the parallel build fails; that works, so the suite would stay green and only slow: fail it here
    if 'the split build failed' in errors:
        t.bad('the bootstrap IR compiles in parallel parts', first_lines(errors, 5))
    else:
        t.ok('the bootstrap IR compiles in parallel parts')
    linked = False
    if ospath.exists(r.shared + '/c0.o.done'):
        c = await host.run(['clang', '-O1', '-w', '-o', r.shared + '/c0', r.shared + '/c0.o', rt_o, '-pthread', '-lm'], r.root, None, r.cpu_of(t))
        errors += c.stderr
        linked = c.status == 0
    if linked:
        t.ok('builds from the bootstrap IR')
    else:
        t.bad('builds from the bootstrap IR', first_lines(errors, 5))
        return 1
    rc = await host.redirect([r.shared + '/c0', 'compiler/src/ctool.tom', 'compile'], r.shared + '/ir1.ll', r.root, None, r.cpu_of(t), None, '', t.work + '/ctool.err')
    if rc == 0:
        t.ok('compiles its own source')
    else:
        t.bad('compiles its own source', host.read_text_lossy(t.work + '/ctool.err').rstrip('\n'))
    # c1 is c0 compiled from ir1.ll: when ir1.ll is the checked-in IR (the normal case, and what t_fixed_point checks) that is the very
    # program c0 already is, so it is not built a second time (half a minute); when it is not, c1 is built, and the tests use it
    if host.same_file(r.shared + '/ir1.ll', 'compiler/bootstrap/tomatoc.ll'):
        _x = await host.run(['cp', r.shared + '/c0', r.shared + '/c1'])
    else:
        _x = await host.run(['clang', '-O1', '-w', '-o', r.shared + '/c1', r.shared + '/ir1.ll', rt_o, '-pthread', '-lm'], r.root, None, r.cpu_of(t))
    if ospath.isfile(r.shared + '/c1'):
        return 0
    return 1

async def native_fixed_point(r: Run, t: Test):
    ir2 = t.work + '/ir2.ll'
    _rc = await host.redirect([r.shared + '/c1', 'compiler/src/ctool.tom', 'compile'], ir2, r.root, None, r.cpu_of(t), None, '', t.work + '/ctool.err')
    if host.same_file(r.shared + '/ir1.ll', ir2):
        t.ok('stage 2 reproduces itself (fixed point)')
    else:
        t.bad('stage 2 reproduces itself (fixed point)')
    if host.same_file(ir2, 'compiler/bootstrap/tomatoc.ll'):
        t.ok('compiler/bootstrap/tomatoc.ll is current')
    else:
        t.bad('compiler/bootstrap/tomatoc.ll is current', 'run compiler/bootstrap/refresh.sh')
    marked = warning_lines(host.marked_lines(r.shared + '/ir1.ll'), 6)
    if len(marked) > 0:
        t.bad("the compiler's own source compiles without warnings", '\n'.join(marked))
    else:
        t.ok("the compiler's own source compiles without warnings")

# the installed `tomato` command: the command line tests use it, and only read it. Installation reuses the same completed bootstrap
# object while still compiling the runtime and linking for real.
async def native_install(r: Run, t: Test):
    code = 1
    # (the object never comes when the compiler build has failed: the install fails too, at once)
    i = 0
    waiting = True
    while waiting:
        if ospath.exists(r.shared + '/c0.o.done'):
            break
        if ospath.exists(r.shared + '/c0.o.failed') or i > 12000:
            waiting = False
            break
        await sleep(0.05)
        i += 1
    if waiting:
        env: dict[str, str] = {}
        env['TOMATO_TEST_BOOTSTRAP_OBJECT'] = r.shared + '/c0.o'
        env['TOMATO_HOME'] = r.shared + '/home'
        env['TOMATO_BIN'] = r.shared + '/home/bin'
        res = await host.run([r.root + '/install-native.sh'], r.root, env, r.cpu_of(t))
        code = res.status
    os.write_text(r.shared + '/install.tmp', str(code) + '\n')
    os.rename(r.shared + '/install.tmp', r.shared + '/install.rc')

def first_lines(text: str, n: int) -> str:
    out: list[str] = []
    for line in text.split('\n'):
        if len(out) >= n:
            break
        out.append(line)
    return '\n'.join(out).rstrip('\n')

# ---- WebAssembly: the rest ----

# what the shell's `grep -v '^Could not open file: '` leaves of a text (real jsc's read() prints that on standard error for each std module
# it looks for beside the program, caught or not; tomato-repl drops it too)
def without_could_not_open(text: str) -> str:
    kept: list[str] = []
    for line in text.split('\n'):
        if not line.startswith('Could not open file: '):
            kept.append(line)
    return '\n'.join(kept)

# the lines of a text that start with / contain a word (grep)
def lines_with(text: str, word: str, at_start: bool) -> list[str]:
    out: list[str] = []
    for line in text.split('\n'):
        if (at_start and line.startswith(word)) or (not at_start and word in line):
            out.append(line)
    return out

# the browser path takes the limits from a tomato.toml given to the compiler (D77g); without one the defaults apply
async def native_wasm_config(r: Run, t: Test):
    os.write_text(t.work + '/wl.tom', 'from math import exp\n@main\ndef main():\n    try:\n        print(len(str(exp(float(\'1e5000\')))) > 0)\n    catch OverflowError as e:\n        print(e.message, e.id)\n    try:\n        print(len(f"{float(\'1e1500\'):.1f}"))\n    catch OverflowError as e:\n        print(e.message, e.id)\n')
    os.write_text(t.work + '/wl.toml', '[limits]\nexp_bits = 2048\nformat_digits = 1000\n')
    got = await tjsc(r, t, ['site/wasm', 'run', t.work + '/wl.tom'])
    m = without_could_not_open((got[0] + got[1])).rstrip('\n')
    if m == 'True\n1503\n~rc 0':
        t.ok('wasm: no tomato.toml means the default limits')
    else:
        t.bad('wasm: no tomato.toml means the default limits', m)
    got = await tjsc(r, t, ['site/wasm', 'run', t.work + '/wl.tom', '--config=' + t.work + '/wl.toml'])
    m = without_could_not_open((got[0] + got[1])).rstrip('\n')
    if m == 'the result is too large to calculate: its exponent would have more than 2048 bits E528\nthe number is too large to write with f: it has more than 1000 digits before the point E529\n~rc 0':
        t.ok('wasm: the limits come from a tomato.toml given to the compiler')
    else:
        t.bad('wasm: the limits come from a tomato.toml given to the compiler', m)
    os.write_text(t.work + '/wl.toml', '[limits]\nexp_bits = 5\n')
    got = await tjsc(r, t, ['site/wasm', 'compile', t.work + '/wl.tom', '--config=' + t.work + '/wl.toml'])
    m = (got[0] + got[1]).rstrip('\n')
    if holds_in_order(m, ['error[E543]: /tomato.toml: limits.exp_bits must be a whole number from 2048 to 2147483647, not 5']) and m.endswith('~rc 1'):
        t.ok('wasm: a bad tomato.toml is an error')
    else:
        t.bad('wasm: a bad tomato.toml is an error', m)

# the website's compiler (WebAssembly) gives the same unstable-feature and deprecation warnings as the native one: once for each feature, none when allowed or stable
async def native_wasm_unstable(r: Run, t: Test):
    for n in ['errors/unstable_use', 'errors/unstable_dotted', 'errors/unstable_allow', 'errors/unstable_quiet', 'errors/unstable_markers', 'errors/unstable_start', 'deprecated/use', 'deprecated/module', 'deprecated/allow', 'deprecated/quiet']:
        base = n.rpartition('/')[2]
        got = await tjsc(r, t, ['site/wasm', 'compile', 'tests/' + n + '.tom'])
        mine = ''
        for line in got[0].split('\n'):
            if line.startswith(';! '):
                text = line[3:]
                if not text.lstrip(' ').startswith('-->'):
                    mine += text + '\n'
        want = ''
        for line in host.read_text_lossy('tests/' + n + '.out').split('\n'):
            if not line.lstrip(' ').startswith('-->') and line != '':
                want += line + '\n'
        if mine == want:
            t.ok('wasm warnings: ' + n)
        else:
            os.write_text(t.work + '/w.' + base, mine)
            os.write_text(t.work + '/n.' + base, want)
            t.bad('wasm warnings: ' + n, '\n'.join(host.diff_head(t.work + '/w.' + base, t.work + '/n.' + base, 6)))

async def native_wasm_browser(r: Run, t: Test):
    got = await tjsc(r, t, ['site/wasm', 'run', 'tests/programs/requests_browser.tom'])
    found = lines_with(got[0] + got[1], 'no network', False)
    t.check('wasm requests raise ConnectionError', 'no network: True', '\n'.join(found))

async def native_wasm_sockets(r: Run, t: Test):
    got = await tjsc(r, t, ['site/wasm', 'run', 'tests/programs/socket_browser.tom'])
    found = lines_with(got[0] + got[1], 'no ', True)
    t.check('wasm sockets raise SocketError', 'no sockets: True E446\nno listening: E446\nno udp: E446\nno lookup: E446', '\n'.join(found))

# a script of the JavaScript shell, with no run limit
async def jsc_script(r: Run, t: Test, args: list[str]) -> str:
    res = await host.run(js_shell(r) + args, r.root, None, r.cpu_of(t))
    return res.stdout + res.stderr

# the website repl wraps what you type in a program (wrapMain): a piece with only an import must still be checked, not fail with "no @main"
async def native_wasm_repl_import(r: Run, t: Test):
    wrapped = await jsc_script(r, t, ['tests/repl_wrap.js', '--', 'from itertools import progres_bar'])
    os.write_text(t.work + '/imp.tom', wrapped)
    got = await tjsc(r, t, ['site/wasm', 'run', t.work + '/imp.tom'])
    m = (got[0] + got[1]).rstrip('\n')
    if holds_in_order(m, ["error[E226]: module 'itertools' has no 'progres_bar'", "did you mean 'progress_bar'?", '~rc 1']):
        t.ok('wasm repl: a bad import is reported as itself')
    else:
        t.bad('wasm repl: a bad import is reported as itself', m)
    wrapped = await jsc_script(r, t, ['tests/repl_wrap.js', '--', 'from itertools import progress_bar'])
    os.write_text(t.work + '/imp2.tom', wrapped)
    got = await tjsc(r, t, ['site/wasm', 'run', t.work + '/imp2.tom'])
    m = (got[0] + got[1]).rstrip('\n')
    if '~rc 0' in m:
        t.ok('wasm repl: a good import alone runs')
    else:
        t.bad('wasm repl: a good import alone runs', m)
    # the echo of a bare expression (site/play.html) is _core_print(...): the built-in, even where the session defines print
    os.write_text(t.work + '/echo.tom', 'def print(x: int):\n    _core_print("mine", x)\n\n@main\ndef m():\n    _core_print(6 * 7)\n    print(5)\n')
    got = await tjsc(r, t, ['site/wasm', 'run', t.work + '/echo.tom'])
    m = (got[0] + got[1]).rstrip('\n')
    if m.startswith('42\nmine 5') and '~rc 0' in m[len('42\nmine 5'):]:
        t.ok('wasm repl: the echo uses the built-in print when the session defines print')
    else:
        t.bad('wasm repl: the echo uses the built-in print when the session defines print', m)

# the entry name `test` in the browser path: the driver runs the @test functions, with the line, and the status is 1
async def native_wasm_test_entry(r: Run, t: Test):
    os.write_text(t.work + '/wt.tom', 'from testing import assert_equal, skip\n\n@test.adds\ndef adds():\n    assert_equal(1 + 1, 2)\n\n@test.fails\ndef fails():\n    assert_equal(1 + 1, 3)\n\n@test.lookup\ndef lookup():\n    skip("no network")\n')
    got = await tjsc(r, t, ['site/wasm', 'run', t.work + '/wt.tom', '--entry=test'])
    m = without_could_not_open(got[0] + got[1]).rstrip('\n')
    if m == 'ok   adds\nFAIL fails\n     expected 3, got 2  (raised on line 9)\nskip lookup  (no network)\n1 passed, 1 failed, 1 skipped\n~rc 1':
        t.ok('wasm: the entry test runs the @test functions')
    else:
        t.bad('wasm: the entry test runs the @test functions', m)
    got = await tjsc(r, t, ['site/wasm', 'run', t.work + '/wt.tom', '--entry=test.adds'])
    m = without_could_not_open(got[0] + got[1]).rstrip('\n')
    if m == 'ok   adds\n1 passed, 0 failed, 0 skipped\n~rc 0':
        t.ok('wasm: the entry test.adds runs one test')
    else:
        t.bad('wasm: the entry test.adds runs one test', m)
    got = await tjsc(r, t, ['site/wasm', 'run', t.work + '/wt.tom'])
    m = (got[0] + got[1]).rstrip('\n')
    if holds_in_order(m, ['no function is marked @main']) and m.endswith('~rc 1'):
        t.ok('wasm: a test file without @main is not a program')
    else:
        t.bad('wasm: a test file without @main is not a program', m)

# a JavaScript test of the website: it prints ok
async def native_js_script(r: Run, t: Test, script: str, ok_name: str, bad_name: str):
    out = (await jsc_script(r, t, [script])).rstrip('\n')
    if out == 'ok':
        t.ok(ok_name)
    else:
        t.bad(bad_name, out)

# a shell script of tests/ that prints ok, or what is wrong
async def native_sh_script(r: Run, t: Test, script: str, ok_name: str, bad_name: str):
    res = await host.run(['sh', script], r.root, None, r.cpu_of(t))
    out = (res.stdout + res.stderr).rstrip('\n')
    if out == 'ok':
        t.ok(ok_name)
    else:
        t.bad(bad_name, out)

def native_error_templates(t: Test):
    missing = ''
    table = os.read_text('std/errors.txt').split('\n')
    for tpl in et.templates():
        if len(tpl.replace('{}', '')) < 12:
            continue
        if 'CompileError ' + tpl not in table:
            missing += '\n  ' + tpl
    if missing == '':
        t.ok('every extracted compile error template has an id in std/errors.txt')
    else:
        t.bad('every extracted compile error template has an id in std/errors.txt', 'add these lines (CompileError TEMPLATE):' + missing)

def native_highlighter_lists(t: Test):
    found = hl.problems()
    if len(found) == 0:
        t.ok('highlighters know every lexer keyword and built-in')
    else:
        t.bad('highlighters', '\n'.join(found))

# ---- the end of the run: the count and --times ------------------------------------------------------------------------------------

def count_lines(path: str) -> int:
    if not ospath.exists(path):
        return 0
    n = 0
    for line in os.read_text(path).split('\n'):
        if line != '':
            n += 1
    return n

def row_wall(x: Row) -> int:
    return x.wall

# the heading of a section as the --times report shows it: without the "== " and " ==" around it
def plain_section(s: str) -> str:
    out = s
    if out.startswith('== '):
        out = out[3:]
    if out.endswith(' =='):
        out = out[:len(out) - 3]
    return out

def fixed(ms: int, width: int) -> str:
    whole = ms // 100            # tenths of a second, rounded to the nearest
    if ms % 100 >= 50:
        whole += 1
    text = f'{whole // 10}.{whole % 10}'
    while len(text) < width:
        text = ' ' + text
    return text

def pad(n: int, width: int) -> str:
    text = str(n)
    while len(text) < width:
        text = ' ' + text
    return text

# the times that the tests of tests/run.sh wrote (one line each: milliseconds, section, label, CPU milliseconds)
def read_times(r: Run):
    path = r.shared + '/times'
    if r.times and ospath.exists(path):
        for line in os.read_text(path).split('\n'):
            parts = line.split('\t')
            if len(parts) >= 4:
                r.rows.append(Row(int(parts[0]), parts[1], parts[2], int(parts[3])))

def report_times(r: Run, seconds: int):
    rows = r.rows
    if len(rows) == 0:
        return
    # wall seconds depend on what else the machine is doing; the CPU seconds (user and system, of the test and everything it started) mostly do not
    print()
    print(f"slowest 20 tests (wall seconds, and CPU seconds), of the whole run's {seconds} s:")
    rows.sort(key=row_wall)
    rows.reverse()
    for x in rows[:20]:
        print(f'{fixed(x.wall, 8)} {fixed(x.cpu, 8)}  {x.label}   [{plain_section(x.section)[:44]}]')
    print()
    print('per section (seconds): wall and CPU summed over its tests, the slowest test (wall), the number of tests')
    sums: dict[str, Total] = {}
    names: list[str] = []
    for x in rows:
        if sums.get(x.section) is None:
            sums[x.section] = Total()
            names.append(x.section)
        s = sums[x.section]
        s.wall += x.wall
        s.cpu += x.cpu
        if x.wall > s.slowest:
            s.slowest = x.wall
        s.count += 1
    lines: list[tuple[int, str]] = []
    wall_all = 0
    cpu_all = 0
    for name in names:
        s = sums[name]
        wall_all += s.wall
        cpu_all += s.cpu
        lines.append((s.wall, f'{fixed(s.wall, 9)} {fixed(s.cpu, 9)} {fixed(s.slowest, 8)} {pad(s.count, 5)}  {plain_section(name)[:60]}'))
    lines.sort(key=line_wall)
    lines.reverse()
    for pair in lines:
        print(pair[1])
    print()
    print(f'total over {len(rows)} tests: {(wall_all + 500) // 1000} s wall (summed), {(cpu_all + 500) // 1000} s CPU. CPU is what the machine paid; wall includes waiting for cores.')
    print(f'load average at the end: {host.load_text()}, jobs: {r.jobs}, cores: {r.cores}')

def line_wall(x: tuple[int, str]) -> int:
    return x[0]

# ---- the entries ---------------------------------------------------------------------------------------------------------------

@main
async def main(*args: tuple[str]):
    jobs_text = ''
    v = os.getenv('TOMATO_TEST_JOBS')
    if v is not None:
        jobs_text = v
    times = env_flag('TOMATO_TEST_TIMES')
    fast = env_flag('TOMATO_TEST_FAST')
    only_words: list[str] = []
    i = 0
    given: list[str] = []
    for a0 in args:
        given.append(a0)
    while i < len(given):
        a = given[i]
        if a == '-j':
            if i + 1 >= len(given):
                sys.write_stderr('dev/test.tom: -j needs a number\n')
                sys.exit(2)
            jobs_text = given[i + 1]
            i += 2
        elif a.startswith('-j'):
            jobs_text = a[2:]
            i += 1
        elif a == '--times':
            times = True
            i += 1
        elif a == '--fast':
            fast = True
            i += 1
        elif a == '--full':
            fast = False
            i += 1
        elif a == '--only':
            if i + 1 >= len(given):
                sys.write_stderr('dev/test.tom: --only needs words\n')
                sys.exit(2)
            only_words = words(given[i + 1].replace(',', ' '))
            i += 2
        elif a == '-h' or a == '--help':
            print(USAGE)
            return
        else:
            sys.write_stderr(USAGE + '\n')
            sys.exit(2)
    cores = host.cpu_count()
    jobs = 0
    if jobs_text == '':
        jobs = cores // 2
        if jobs > 64:
            jobs = 64
        load = host.load()
        if load >= 0:                # a busy machine: about half of what is idle, but at least 4
            free = (cores - load) // 2
            if free < 4:
                free = 4
            if jobs > free:
                jobs = free
    else:
        if not jobs_text.isdigit():
            sys.write_stderr(f"dev/test.tom: the number of jobs must be a number, not '{jobs_text}'\n")
            sys.exit(2)
        jobs = int(jobs_text)
    if jobs < 1:
        jobs = 1
    # The WebAssembly runner stops a program after 5 s, which a loaded machine or a hosted CI runner can exceed: give it more room.
    wasm = os.getenv('TOMATO_WASM_TIMEOUT_MS')
    if wasm is None or not wasm.isdigit() or wasm == '0':
        os.putenv('TOMATO_WASM_TIMEOUT_MS', '30000')
    root = ospath.abspath(os.getcwd())
    if not ospath.isfile(root + '/tests/run.sh'):
        sys.write_stderr('dev/test.tom: run it from the root of the repository: tomato run dev/test.tom main\n')
        sys.exit(2)
    started = time.time()
    shared = host.mkdtemp()
    r = Run(root, shared, jobs, cores, fast, times)
    r.only = only_words
    rc = 0
    passes = 0
    fails = 0
    try:
        await load_plan(r)
        prep = start prepare(r)  # allow: unstable
        rc = await run_all(r)
        await prep
        passes = count_lines(shared + '/passed')      # the ones tests/run.sh ran count in files of the shared folder
        fails = count_lines(shared + '/failed')
        read_times(r)
    finally:
        host.rmtree(shared)
    if rc != 0:
        sys.exit(rc)
    for t in r.tests:
        passes += t.passed
        fails += t.failed
    print()
    print(f'{passes} passed, {fails} failed')
    if fast:                         # the tests the fast tier did not run
        print()
        print(f'fast tier: {len(r.skipped)} tests were not run (tests/run.sh with no flag runs them all):')
        for line in r.skipped:
            print(line)
    if times:
        report_times(r, int(time.time() - started))
    if fails != 0:
        sys.exit(1)

@ci_report
def entry_ci_report(log: str, name: str = 'dev/test.tom'):
    ci.report(log, name)

@error_templates
def entry_error_templates():
    for t in et.templates():
        print(t)

@highlighter_lists
def entry_highlighter_lists():
    found = hl.problems()
    if len(found) == 0:
        print('ok')
        return
    for line in found:
        print(line)
    sys.exit(1)
