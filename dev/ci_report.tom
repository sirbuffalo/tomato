# Makes a failed run of the suite visible without the job log (which GitHub shows only to people with admin rights on the repository):
# every FAIL line, with the few lines under it, becomes an error annotation (the check-runs API and the run's summary page show
# annotations to everyone) and goes into the job summary. The port of tests/ci_report.sh; `report(log, name)` is the entry
# `ci_report LOGFILE` of dev/test.tom (used by the workflows).
import os
import ospath
import sys

def _first(text: str, n: int) -> str:
    return text[:n]

# GitHub's escaping of an annotation message
def _escape(msg: str) -> str:
    return msg.replace('%', '%25').replace('\r', '%0D').replace('\n', '%0A')

# the output: to the file of the job summary when there is one, else standard output
def _emit(text: str):
    path = os.getenv('GITHUB_STEP_SUMMARY')
    if path is None or path == '':
        sys.write_stdout(text)
    else:
        os.write_text(path, text, True)

export def report(log: str, name: str):
    if not ospath.isfile(log):
        sys.write_stderr(f"ci_report: no log at '{log}'\n")
        return
    lines = os.read_text(log).split('\n')
    if len(lines) > 0 and lines[len(lines) - 1] == '':
        lines.pop()
    fails = 0
    summary = ''
    for line in lines:
        if line.startswith('FAIL'):
            fails += 1
        if _is_count_line(line):
            summary = line
    out = f'### {name}: {summary}\n\n'
    if fails > 0:
        out += f'{fails} failing checks:\n\n'
        out += '```\n'
        shown = 0
        show = False
        for line in lines:
            if line.startswith('FAIL'):
                show = True
            elif line.startswith('     ') and show:
                pass
            else:
                show = False
                continue
            if shown < 300:
                out += _first(line, 300) + '\n'
                shown += 1
        out += '```\n'
    else:
        out += 'No FAIL line: the run stopped early (see the end of the log).\n\n'
        out += '```\n'
        start = len(lines) - 30
        if start < 0:
            start = 0
        for line in lines[start:]:
            out += _first(line, 300) + '\n'
        out += '```\n'
    _emit(out)
    # at most 10 annotations are shown per step: one per failing check, the detail lines joined into the message
    count = 0
    msg = ''
    have = False
    show = False
    used = 0
    for line in lines:
        if line.startswith('FAIL'):
            if have:
                print('::error title=' + name + '::' + _escape(msg))
                count += 1
            have = False
            msg = ''
            if count >= 9:
                break
            msg = _first(line, 300)
            have = True
            show = True
            used = 0
            continue
        if line.startswith('     ') and show:
            if used < 6:
                msg += '\n' + _first(line, 200)
                used += 1
            continue
        show = False
    if have and count < 9:
        print('::error title=' + name + '::' + _escape(msg))
    if fails == 0:
        tail: list[str] = []
        start = len(lines) - 3
        if start < 0:
            start = 0
        for line in lines[start:]:
            tail.append(line)
        print('::error title=' + name + '::the run failed without a FAIL line: ' + _first(' '.join(tail) + ' ', 400))

# "12 passed, 0 failed": digits, " passed, ", digits, " failed"
def _is_count_line(line: str) -> bool:
    i = 0
    while i < len(line) and line[i].isdigit():
        i += 1
    if i == 0 or not line[i:].startswith(' passed, '):
        return False
    j = i + len(' passed, ')
    k = j
    while k < len(line) and line[k].isdigit():
        k += 1
    return k > j and line[k:].startswith(' failed')
