# ---- on a pseudo-terminal, through expect ----

# is expect there? When it is not: a failure in CI, a skip line elsewhere (as the shell tests did)
def have_expect(t: Test, bad_name: str, skip_text: str) -> bool:
    if host.which('expect') is not None:
        return True
    ci = os.getenv('CI')
    if ci is not None and ci != '':
        t.bad(bad_name, 'expect is required in CI')
    else:
        t.text += 'skip: ' + skip_text + '\n'
    return False

async def run_expect(r: Run, t: Test, args: list[str], with_path: bool) -> str:
    env: dict[str, str] = {}
    if with_path:
        path = os.getenv('PATH')
        base = ''
        if path is not None:
            base = path
        env['PATH'] = r.shared + '/home/bin:' + base
    env['TOMATO_HOME'] = r.shared + '/home'
    env['TOMATO_BIN'] = r.shared + '/home/bin'
    _rc = await host.redirect(['expect'] + args, t.work + '/expect.out', r.root, env, r.cpu_of(t))
    return last_line(host.read_text_lossy(t.work + '/expect.out'))

async def pty_terminal(r: Run, t: Test):
    if not await cli_setup(r, t):
        return
    if not have_expect(t, 'terminal pty test', 'expect is not installed, so the terminal pty test did not run'):
        return
    built = await tom(r, t, ['build', 'tests/terminal_pty.tom', '--entry', 'main', '-o', t.work + '/terminal_pty'])
    if built.status == 0:
        t.check('terminal: raw mode, keys, size, resize and the restore on a pty', 'ok', await run_expect(r, t, ['tests/terminal_pty.exp', t.work + '/terminal_pty'], False))
    else:
        t.bad('terminal pty test: tests/terminal_pty.tom does not build', head(built.text, 5))

async def pty_expect(r: Run, t: Test, script: str, bad_name: str, ok_name: str):
    if not await cli_setup(r, t):
        return
    if not have_expect(t, bad_name, 'expect is not installed, so the ' + bad_name + ' did not run'):
        return
    t.check(ok_name, 'ok', await run_expect(r, t, [script], True))
