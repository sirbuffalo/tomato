# Benchmark: longest Collatz chain for a start below n, no caching. Prints the start and the chain length.
@main
def main(n: int):
    best_start = 1
    best_length = 1
    for start in range(1, n):
        x = start
        length = 1
        while x != 1:
            if x % 2 == 0:
                x //= 2
            else:
                x = 3 * x + 1
            length += 1
        if length > best_length:
            best_length = length
            best_start = start
    print(best_start, best_length)
