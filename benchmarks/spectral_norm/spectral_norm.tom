# Benchmark: spectral norm of an infinite matrix, cut to n x n (float arithmetic in nested loops, function calls).
# Ten rounds of the power method; prints the norm times 1e9, cut to a whole number.
from math import sqrt

def a(i: int, j: int) -> float:
    return 1.0 / ((i + j) * (i + j + 1) // 2 + i + 1)

def times_a(n: int, v: list[float], out: list[float]):
    for i in range(n):
        s = 0.0
        for j in range(n):
            s += a(i, j) * v[j]
        out[i] = s

def times_a_transposed(n: int, v: list[float], out: list[float]):
    for i in range(n):
        s = 0.0
        for j in range(n):
            s += a(j, i) * v[j]
        out[i] = s

def times_at_a(n: int, v: list[float], out: list[float], tmp: list[float]):
    times_a(n, v, tmp)
    times_a_transposed(n, tmp, out)

@main
def main(n: int):
    u = [1.0] * n
    v = [0.0] * n
    tmp = [0.0] * n
    for round in range(10):
        times_at_a(n, u, v, tmp)
        times_at_a(n, v, u, tmp)
    vbv = 0.0
    vv = 0.0
    for i in range(n):
        vbv += u[i] * v[i]
        vv += v[i] * v[i]
    print(int(sqrt(vbv / vv) * 1000000000.0))
