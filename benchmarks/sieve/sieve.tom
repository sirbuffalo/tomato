# Benchmark: sieve of Eratosthenes. Prints how many primes are <= n.
@main
def main(n: int):
    composite = [False] * (n + 1)
    count = 0
    for i in range(2, n + 1):
        if composite[i]:
            continue
        count += 1
        for j in range(i * i, n + 1, i):
            composite[j] = True
    print(count)
