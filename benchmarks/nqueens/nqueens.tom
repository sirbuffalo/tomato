# Benchmark: n queens. Counts the ways to place n queens on an n x n board so that none attacks another (backtracking,
# recursion, lists of bools for the columns and the two diagonals).
def place(n: int, row: int, cols: list[bool], diag1: list[bool], diag2: list[bool]) -> int:
    if row == n:
        return 1
    count = 0
    for c in range(n):
        d1 = row + c
        d2 = row - c + n - 1
        if cols[c] or diag1[d1] or diag2[d2]:
            continue
        cols[c] = True
        diag1[d1] = True
        diag2[d2] = True
        count += place(n, row + 1, cols, diag1, diag2)
        cols[c] = False
        diag1[d1] = False
        diag2[d2] = False
    return count

@main
def main(n: int):
    cols = [False] * n
    diag1 = [False] * (2 * n)
    diag2 = [False] * (2 * n)
    print(place(n, 0, cols, diag1, diag2))
