{
  "comments": { "lineComment": "#" },
  "brackets": [["(", ")"], ["[", "]"], ["{", "}"]],
  "autoClosingPairs": [
    { "open": "(", "close": ")" }, { "open": "[", "close": "]" }, { "open": "{", "close": "}" },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] }, { "open": "'", "close": "'", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [["(", ")"], ["[", "]"], ["{", "}"], ["\"", "\""], ["'", "'"]],
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(def|class|interface|if|elif|else|while|for|try|catch|finally)\\b.*:\\s*(#.*)?$",
    "decreaseIndentPattern": "^\\s*(elif|else|catch|finally)\\b.*:\\s*(#.*)?$"
  },
  "onEnterRules": [
    { "beforeText": "^\\s*(?:def|class|interface|if|elif|else|while|for|try|catch|finally)\\b.*:\\s*(#.*)?$", "action": { "indent": "indent" } }
  ]
}
