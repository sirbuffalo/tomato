{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Tomato",
  "scopeName": "source.tomato",
  "fileTypes": ["tom"],
  "patterns": [
    { "include": "#comment" },
    { "include": "#decorator" },
    { "include": "#llvm-declaration" },
    { "include": "#definition" },
    { "include": "#fstring" },
    { "include": "#string" },
    { "include": "#number" },
    { "include": "#fixed-type" },
    { "include": "#fn-type" },
    { "include": "#start-expression" },
    { "include": "#yields-clause" },
    { "include": "#import-module" },
    { "include": "#generic-type" },
    { "include": "#keyword" },
    { "include": "#constant" },
    { "include": "#type" },
    { "include": "#builtin" },
    { "include": "#llvm-call" },
    { "include": "#call" },
    { "include": "#operator" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comment": { "name": "comment.line.number-sign.tomato", "match": "#.*$" },
    "decorator": {
      "match": "^\\s*(@)([A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*)",
      "captures": { "1": { "name": "punctuation.definition.decorator.tomato" }, "2": { "name": "entity.name.function.decorator.tomato" } }
    },
    "llvm-declaration": {
      "match": "^\\s*(!)([A-Za-z_][A-Za-z0-9_]*)",
      "captures": { "1": { "name": "keyword.operator.llvm.tomato" }, "2": { "name": "entity.name.function.llvm.tomato" } }
    },
    "llvm-call": {
      "match": "(!)([A-Za-z_][A-Za-z0-9_]*)(?=\\s*\\()",
      "captures": { "1": { "name": "keyword.operator.llvm.tomato" }, "2": { "name": "support.function.llvm.tomato" } }
    },
    "definition": {
      "patterns": [
        {
          "match": "\\b(def)\\s+(?:(private)\\s+)?([A-Za-z_][A-Za-z0-9_]*)",
          "captures": { "1": { "name": "storage.type.function.tomato" }, "2": { "name": "storage.modifier.tomato" }, "3": { "name": "entity.name.function.tomato" } }
        },
        {
          "match": "\\b(class)\\s+([A-Za-z_][A-Za-z0-9_]*)(?:\\s+(implements)\\s+([A-Za-z_][A-Za-z0-9_, ]*))?",
          "captures": { "1": { "name": "storage.type.class.tomato" }, "2": { "name": "entity.name.type.class.tomato" }, "3": { "name": "keyword.other.implements.tomato" }, "4": { "name": "entity.other.inherited-class.tomato" } }
        },
        {
          "match": "\\b(interface)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": { "1": { "name": "storage.type.interface.tomato" }, "2": { "name": "entity.name.type.interface.tomato" } }
        }
      ]
    },
    "fstring": {
      "patterns": [
        { "name": "string.quoted.double.tomato", "begin": "\\bf\"", "end": "\"", "patterns": [{ "include": "#fstring-body" }] },
        { "name": "string.quoted.single.tomato", "begin": "\\bf'", "end": "'", "patterns": [{ "include": "#fstring-body" }] }
      ]
    },
    "fstring-body": {
      "patterns": [
        { "include": "#escape" },
        { "name": "constant.character.escape.brace.tomato", "match": "\\{\\{|\\}\\}" },
        {
          "name": "meta.embedded.expression.tomato", "begin": "\\{", "end": "\\}",
          "beginCaptures": { "0": { "name": "punctuation.section.embedded.begin.tomato" } },
          "endCaptures": { "0": { "name": "punctuation.section.embedded.end.tomato" } },
          "patterns": [
            { "match": "(:)([^{}'\"\\\\\\[\\]()]*)(?=\\})", "captures": { "1": { "name": "punctuation.separator.format-spec.tomato" }, "2": { "name": "constant.other.format-spec.tomato" } } },
            { "include": "$self" }
          ]
        }
      ]
    },
    "string": {
      "patterns": [
        { "name": "string.quoted.double.tomato", "begin": "(?:\\bb)?\"", "end": "\"", "patterns": [{ "include": "#escape" }] },
        { "name": "string.quoted.single.tomato", "begin": "(?:\\bb)?'", "end": "'", "patterns": [{ "include": "#escape" }] }
      ]
    },
    "escape": { "name": "constant.character.escape.tomato", "match": "\\\\(?:[ntr0\\\\'\"]|x[0-9a-fA-F]{2})" },
    "number": {
      "patterns": [
        { "name": "constant.numeric.float.tomato", "match": "\\b[0-9]+(?:\\.[0-9]+(?:[eE][+-]?[0-9]+)?|[eE][+-]?[0-9]+)\\b" },
        { "name": "constant.numeric.integer.tomato", "match": "\\b[0-9]+\\b" }
      ]
    },
    "fixed-type": {
      "match": "\\b(u?int)(\\[)(length)(=)([0-9A-Za-z_ *+-]+)(\\])",
      "captures": {
        "1": { "name": "support.type.primitive.tomato" }, "2": { "name": "punctuation.definition.bracket.tomato" },
        "3": { "name": "variable.parameter.tomato" }, "4": { "name": "keyword.operator.assignment.tomato" },
        "5": { "name": "constant.numeric.integer.tomato" }, "6": { "name": "punctuation.definition.bracket.tomato" }
      }
    },
    "fn-type": { "name": "support.type.primitive.tomato", "match": "\\bfn(?=\\s*\\()" },
    "start-expression": {
      "match": "\\b(start)\\b(?=\\s+(?!(?:in|is|and|or|xor|not|if|else|for|as)\\b)[A-Za-z_])",
      "captures": { "1": { "name": "keyword.control.async.tomato" } }
    },
    "yields-clause": {
      "match": "\\b(yields)\\b(?=\\s+(?!(?:in|is|and|or|xor|not|if|else|for|as)\\b)[A-Za-z_])",
      "captures": { "1": { "name": "keyword.control.async.tomato" } }
    },
    "import-module": {
      "match": "\\b(import|from)\\s+(asyncio|base64|cache|csv|datetime|hex|hashlib|hmac|html|io|itertools|json|lineedit|math|os|ospath|random|rational|re|requests|secrets|socket|statistics|struct|sys|terminal|testing|textwrap|time|toml|urlparse|utf8|uuid|value|zlib)\\b",
      "captures": { "1": { "name": "keyword.control.import.tomato" }, "2": { "name": "entity.name.namespace.tomato" } }
    },
    "generic-type": { "name": "support.type.primitive.tomato", "match": "\\b(task|Iterable)(?=\\s*\\[)" },
    "keyword": {
      "patterns": [
        { "name": "keyword.control.flow.tomato", "match": "\\b(if|elif|else|while|for|return|break|continue|pass)\\b" },
        { "name": "keyword.control.exception.tomato", "match": "\\b(try|catch|finally|raise|assert)\\b" },
        { "name": "keyword.control.flow.tomato", "match": "\\b(yield)\\b" },
        { "name": "keyword.control.import.tomato", "match": "\\b(import|from|export|as)\\b" },
        { "name": "keyword.control.async.tomato", "match": "\\b(async|await)\\b" },
        { "name": "keyword.operator.logical.tomato", "match": "\\b(and|or|xor|not|in|is)\\b" },
        { "name": "storage.modifier.tomato", "match": "\\b(private|const|override)\\b" },
        { "name": "storage.type.tomato", "match": "\\b(def|class|interface|implements)\\b" },
        { "name": "variable.language.self.tomato", "match": "\\bself\\b" }
      ]
    },
    "constant": { "name": "constant.language.tomato", "match": "\\b(True|False|None)\\b" },
    "type": {
      "name": "support.type.primitive.tomato",
      "match": "\\b(int|uint|float|rational|bool|str|bytes|list|dict|set|tuple|File|range|Error|RuntimeError|IndexError|KeyError|ValueError|ZeroDivisionError|OverflowError|IOError|FileNotFoundError|FileExistsError|PermissionError|IsADirectoryError|NotADirectoryError|TimeoutError|ConnectionError|EOFError|CancelledError|Sized|bitarray|frozenbitarray)\\b(?!\\s*\\()"
    },
    "builtin": { "name": "support.function.builtin.tomato", "match": "\\b(print|len|str|int|float|rational|range|open|input|sleep|clock|min|max|sum|abs|chr|ord|round|divmod|any|all|hash|sorted|reversed|enumerate|zip|map|filter|list|dict|set|tuple|bool|bytes)(?=\\s*\\()" },
    "call": { "name": "entity.name.function.call.tomato", "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\s*\\()" },
    "operator": {
      "patterns": [
        { "name": "keyword.operator.arrow.tomato", "match": "->" },
        { "name": "keyword.operator.assignment.compound.tomato", "match": "<<=|>>=|\\*\\*=|//=|[-+*/%&|^]=" },
        { "name": "keyword.operator.bitwise.tomato", "match": "<<|>>|~" },
        { "name": "keyword.operator.arithmetic.tomato", "match": "\\*\\*|//|[-+*/%]" },
        { "name": "keyword.operator.comparison.tomato", "match": "==|!=|<=|>=|<|>" },
        { "name": "keyword.operator.bitwise.tomato", "match": "[&|^]" },
        { "name": "keyword.operator.assignment.tomato", "match": "=" }
      ]
    },
    "punctuation": { "name": "punctuation.separator.tomato", "match": "[,:.]" }
  }
}
