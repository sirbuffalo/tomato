# The Tomato compiler (slice) as a command: tomato run selfhost/ctool.tom compile FILE   (prints LLVM IR)
from compiler import compile_module

@main
def main():
    print('usage: tomato run selfhost/ctool.tom compile FILE')

@compile
def compile(path: str, entry: str = 'main'):
    f = open(path)
    src = f.read()
    f.close()
    i = len(path)
    while i > 0 and path[i - 1] != '/':
        i = i - 1
    print(compile_module(src, path[0:i], entry))
