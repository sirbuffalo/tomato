# A slice of the Tomato compiler, written in Tomato (D38a): int, bool and str programs.
#
# It takes the syntax tree from selfhost/parser.tom and writes LLVM IR text that links with the C runtime
# (tomato/runtime/tomato_rt.c). Supported: functions with int/bool/str parameters and results, locals, + - * % and
# comparisons, string + == != < <= > >=, indexing and slicing, len, str(), and/or/xor/not, if/elif/else, while,
# for over range(), break, continue, calls, print, and an @main entry point without inputs. Text values are
# reference counted exactly like the Python compiler: every text value an expression produces is owned by whoever
# uses it, and a slot releases what it held. Everything else stops with a CompileError that says what is not
# supported yet. Numbers are 64-bit and wrap on overflow, a zero `%` divisor is not checked, and `and` and `or`
# evaluate both sides (P53).
from parser import Node, Val, parse

export class CompileError(Error):
    @init
    def make(self, message: str, line: int):
        Error.start(self, message)

def val_node(v: Val) -> Node:
    n = v.node
    if n is None:
        raise CompileError('internal error: a missing syntax node', 0)
    return n

def val_nodes(v: Val) -> list[Node]:
    out: list[Node] = []
    for item in v.items:
        out.append(val_node(item))
    return out

def basic_type(name: str) -> bool:
    return name == 'int' or name == 'bool' or name == 'str'

def type_name(v: Val) -> str:
    # the name of a type the compiler knows: int, bool, str, or list[...] of one of those; '' for anything else
    if v.tag != 'n':
        return ''
    t = val_node(v)
    name = t.fields[0].text
    if name == 'list' and t.fields[2].tag == 'n' and t.fields[1].tag == 'z':
        inner = type_name(t.fields[2])
        if basic_type(inner):
            return 'list[' + inner + ']'
        return ''
    if t.fields[2].tag != 'z' or t.fields[1].tag != 'z':
        return ''
    if basic_type(name):
        return name
    return ''

def is_list(t: str) -> bool:
    return t.startswith('list[')

def is_rc(t: str) -> bool:
    return t == 'str' or is_list(t)

def elem_of(t: str) -> str:
    return t[5:len(t) - 1]

def llvm_type(t: str) -> str:
    if is_rc(t):
        return 'ptr'
    return 'i64'

class Ex:
    # a compiled expression: the register or constant that holds it, and its Tomato type
    reg: str = ''
    ty: str = ''

def ex(reg: str, ty: str) -> Ex:
    e = Ex()
    e.reg = reg
    e.ty = ty
    return e

class FuncInfo:
    name: str = ''
    ret: str = ''
    ptypes: list[str] = []

class Mod:
    # what every function of the program shares
    strings: list[str] = []
    infos: list[FuncInfo] = []
    codes: list[str] = []         # the list types the program uses; a type's code is 2 plus its place here

    def code_of(self, t: str) -> int:
        k = 0
        for x in self.codes:
            if x == t:
                return k + 2
            k = k + 1
        self.codes.append(t)
        return len(self.codes) + 1

    def intern(self, s: str) -> str:
        k = 0
        for x in self.strings:
            if x == s:
                return '@.str.' + str(k)
            k = k + 1
        self.strings.append(s)
        return '@.str.' + str(k)

    def find(self, name: str, line: int) -> FuncInfo:
        for f in self.infos:
            if f.name == name:
                return f
        raise CompileError('unknown function ' + name, line)

def escape_char(c: str, line: int) -> str:
    plain = ' !#$%&\'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[]^_`abcdefghijklmnopqrstuvwxyz{|}~'
    if plain.find(c) >= 0:
        return c
    if c == '\n':
        return '\\0A'
    if c == '\t':
        return '\\09'
    if c == '\r':
        return '\\0D'
    if c == '"':
        return '\\22'
    if c == '\\':
        return '\\5C'
    if c == '\0':
        return '\\00'
    raise CompileError('the Tomato compiler only supports ASCII text literals yet', line)

def escape_text(s: str) -> str:
    body = ''
    i = 0
    while i < len(s):
        body = body + escape_char(s[i], 0)
        i = i + 1
    return body

def string_global(index: int, s: str) -> str:
    size = str(len(s) + 1)
    body = escape_text(s)
    return '@.str.' + str(index) + ' = private constant { i64, i64, i64, i64, [' + size + ' x i8] } { i64 -1, i64 1, i64 ' + str(len(s)) + ', i64 ' + str(len(s)) + ', [' + size + ' x i8] c"' + body + '\\00" }'

def string_c(index: int, s: str) -> str:
    # a plain C copy, which is what tomato_fail prints
    return '@.str.' + str(index) + '.c = private constant [' + str(len(s) + 1) + ' x i8] c"' + escape_text(s) + '\\00"'

class Gen:
    # one function being compiled
    mod: Mod = Mod()
    lines: list[str] = []
    allocas: list[str] = []
    rc_slots: list[str] = []
    slots: dict[str, str] = {}
    types: dict[str, str] = {}
    n: int = 0
    terminated: bool = False
    breaks: list[str] = []
    conts: list[str] = []
    loop_depth: int = 0
    ret: str = ''

    def tmp(self, hint: str) -> str:
        self.n = self.n + 1
        return '%' + hint + '.' + str(self.n)

    def label(self, hint: str) -> str:
        self.n = self.n + 1
        return hint + '.' + str(self.n)

    def emit(self, text: str):
        if self.terminated:
            self.lines.append(self.label('dead') + ':')
            self.terminated = False
        self.lines.append('  ' + text)

    def place(self, label: str):
        self.lines.append(label + ':')
        self.terminated = False

    def br(self, label: str):
        self.emit('br label %' + label)
        self.terminated = True

    def cond_br(self, c: str, yes: str, no: str):
        self.emit('br i1 ' + c + ', label %' + yes + ', label %' + no)
        self.terminated = True

    def slot(self, name: str, ty: str, line: int) -> str:
        if name in self.slots:
            if self.types[name] != ty:
                raise CompileError('variable ' + name + ' has type ' + self.types[name] + ', not ' + ty, line)
            return self.slots[name]
        reg = '%v.' + name + '.' + str(len(self.slots))
        self.allocas.append('  ' + reg + ' = alloca ' + llvm_type(ty))
        if is_rc(ty):
            self.allocas.append('  store ptr null, ptr ' + reg)
            self.rc_slots.append(reg)
        self.slots[name] = reg
        self.types[name] = ty
        return reg

    def hidden_slot(self, hint: str) -> str:
        reg = self.tmp(hint)
        self.allocas.append('  ' + reg + ' = alloca i64')
        return reg

    def hidden_rc_slot(self, hint: str) -> str:
        reg = self.tmp(hint)
        self.allocas.append('  ' + reg + ' = alloca ptr')
        self.allocas.append('  store ptr null, ptr ' + reg)
        self.rc_slots.append(reg)
        return reg

    # ---- reference counting
    def retain(self, e: Ex):
        if is_rc(e.ty):
            self.emit('call void @tomato_retain(ptr ' + e.reg + ')')

    def release(self, e: Ex):
        if is_rc(e.ty):
            self.emit('call void @tomato_release(ptr ' + e.reg + ')')

    def store_owned(self, slot: str, e: Ex):
        # the slot takes over the reference and releases what it held
        if is_rc(e.ty):
            old = self.tmp('old')
            self.emit(old + ' = load ptr, ptr ' + slot)
            self.emit('store ptr ' + e.reg + ', ptr ' + slot)
            self.emit('call void @tomato_release(ptr ' + old + ')')
        else:
            self.emit('store i64 ' + e.reg + ', ptr ' + slot)

    def want(self, e: Ex, ty: str, line: int, what: str):
        if e.ty != ty:
            raise CompileError('type error: ' + what + ' is ' + e.ty + ' where ' + ty + ' is needed', line)

    # ---- small instructions
    def truth(self, e: Ex, line: int) -> str:
        self.want(e, 'bool', line, 'a condition')
        r = self.tmp('cond')
        self.emit(r + ' = icmp ne i64 ' + e.reg + ', 0')
        return r

    def bool_of(self, i1: str) -> Ex:
        r = self.tmp('b')
        self.emit(r + ' = zext i1 ' + i1 + ' to i64')
        return ex(r, 'bool')

    def arith(self, op: str, a: str, b: str) -> str:
        r = self.tmp('t')
        self.emit(r + ' = ' + op + ' i64 ' + a + ', ' + b)
        return r

    def icmp(self, cc: str, a: str, b: str) -> Ex:
        c = self.tmp('cmp')
        self.emit(c + ' = icmp ' + cc + ' i64 ' + a + ', ' + b)
        return self.bool_of(c)

    def modulo(self, a: str, b: str) -> str:
        # Python-style: the result has the sign of the divisor (D05au); a zero divisor is not checked yet (P53)
        r = self.arith('srem', a, b)
        x = self.arith('xor', r, b)
        differ = self.icmp('slt', x, '0')
        nonzero = self.icmp('ne', r, '0')
        fix = self.arith('and', differ.reg, nonzero.reg)
        amount = self.arith('mul', fix, b)
        return self.arith('add', r, amount)

    def fail_if(self, bad: str, message: str):
        # bad is an i1; when true, report the error and stop
        stop = self.label('stop')
        ok = self.label('ok')
        self.cond_br(bad, stop, ok)
        self.place(stop)
        self.emit('call void @tomato_fail(ptr ' + self.mod.intern(message) + '.c)')
        self.emit('unreachable')
        self.terminated = True
        self.place(ok)

    # ---- expressions
    def expr(self, n: Node, expected: str = '') -> Ex:
        k = n.kind
        if k == 'IntLit':
            return ex(str(n.fields[0].num), 'int')
        if k == 'BoolLit':
            if n.fields[0].flag:
                return ex('1', 'bool')
            return ex('0', 'bool')
        if k == 'StrLit':
            return ex(self.mod.intern(n.fields[0].text), 'str')
        if k == 'Name':
            name = n.fields[0].text
            if not (name in self.slots):
                raise CompileError('unknown name ' + name, n.line)
            ty = self.types[name]
            r = self.tmp('l')
            self.emit(r + ' = load ' + llvm_type(ty) + ', ptr ' + self.slots[name])
            e = ex(r, ty)
            self.retain(e)
            return e
        if k == 'UnOp':
            op = n.fields[0].text
            v = self.expr(val_node(n.fields[1]))
            if op == '-':
                self.want(v, 'int', n.line, 'the operand of -')
                return ex(self.arith('sub', '0', v.reg), 'int')
            self.want(v, 'bool', n.line, 'the operand of not')
            return ex(self.arith('xor', v.reg, '1'), 'bool')
        if k == 'BinOp':
            return self.binop(n)
        if k == 'Call':
            return self.call(n, False)
        if k == 'ListLit':
            return self.list_lit(n, expected)
        if k == 'Index':
            return self.index(n)
        if k == 'Slice':
            return self.slice(n)
        raise CompileError('the Tomato compiler does not support ' + k + ' yet', n.line)

    def list_slot(self, lst: Ex, i: Ex) -> str:
        # the address of item i, after a bounds check
        lenp = self.tmp('lenp')
        self.emit(lenp + ' = getelementptr { i64, i64, i64, i64, ptr }, ptr ' + lst.reg + ', i32 0, i32 2')
        ln = self.tmp('len')
        self.emit(ln + ' = load i64, ptr ' + lenp)
        bad = self.tmp('oob')
        self.emit(bad + ' = icmp uge i64 ' + i.reg + ', ' + ln)
        self.fail_if(bad, 'index out of range')
        datap = self.tmp('datap')
        self.emit(datap + ' = getelementptr { i64, i64, i64, i64, ptr }, ptr ' + lst.reg + ', i32 0, i32 4')
        data = self.tmp('data')
        self.emit(data + ' = load ptr, ptr ' + datap)
        addr = self.tmp('addr')
        self.emit(addr + ' = getelementptr i64, ptr ' + data + ', i64 ' + i.reg)
        return addr

    def list_lit(self, n: Node, expected: str) -> Ex:
        items = val_nodes(n.fields[0])
        t = ''
        first = ex('', '')
        if is_list(expected):
            t = expected
        else:
            if len(items) == 0:
                raise CompileError('the type of an empty list needs a declaration: xs: list[int] = []', n.line)
            first = self.expr(items[0])
            t = 'list[' + first.ty + ']'
            if not is_list(t) or not basic_type(first.ty):
                raise CompileError('the Tomato compiler only builds lists of int, bool and str yet', n.line)
        lst = self.tmp('list')
        self.emit(lst + ' = call ptr @tomato_list_new(i64 ' + str(self.mod.code_of(t)) + ')')
        k = 0
        for item in items:
            v = ex('', '')
            if k == 0 and first.ty != '':
                v = first
            else:
                v = self.expr(item, elem_of(t))
            self.want(v, elem_of(t), n.line, 'a list item')
            slot = self.tmp('slot')
            self.emit(slot + ' = call ptr @tomato_list_push(ptr ' + lst + ', i64 8)')
            self.emit('store ' + llvm_type(v.ty) + ' ' + v.reg + ', ptr ' + slot)     # the list takes the reference
            k = k + 1
        return ex(lst, t)

    def index(self, n: Node) -> Ex:
        s = self.expr(val_node(n.fields[0]))
        if is_list(s.ty):
            li = self.expr(val_node(n.fields[1]))
            self.want(li, 'int', n.line, 'an index')
            addr = self.list_slot(s, li)
            item = self.tmp('item')
            self.emit(item + ' = load ' + llvm_type(elem_of(s.ty)) + ', ptr ' + addr)
            e = ex(item, elem_of(s.ty))
            self.retain(e)
            self.release(s)
            return e
        self.want(s, 'str', n.line, 'the value being indexed')
        i = self.expr(val_node(n.fields[1]))
        self.want(i, 'int', n.line, 'an index')
        r = self.tmp('ch')
        self.emit(r + ' = call ptr @tomato_str_index(ptr ' + s.reg + ', i64 ' + i.reg + ')')
        bad = self.tmp('oob')
        self.emit(bad + ' = icmp eq ptr ' + r + ', null')
        self.fail_if(bad, 'index out of range')
        self.release(s)
        return ex(r, 'str')

    def slice(self, n: Node) -> Ex:
        s = self.expr(val_node(n.fields[0]))
        self.want(s, 'str', n.line, 'the value being sliced')
        lo = '0'
        if n.fields[1].tag == 'n':
            e = self.expr(val_node(n.fields[1]))
            self.want(e, 'int', n.line, 'a slice bound')
            lo = e.reg
        hi = ''
        if n.fields[2].tag == 'n':
            e2 = self.expr(val_node(n.fields[2]))
            self.want(e2, 'int', n.line, 'a slice bound')
            hi = e2.reg
        else:
            hi = self.tmp('len')
            self.emit(hi + ' = call i64 @tomato_str_len(ptr ' + s.reg + ')')
        r = self.tmp('part')
        self.emit(r + ' = call ptr @tomato_str_slice(ptr ' + s.reg + ', i64 ' + lo + ', i64 ' + hi + ')')
        bad = self.tmp('oob')
        self.emit(bad + ' = icmp eq ptr ' + r + ', null')
        self.fail_if(bad, 'slice out of range')
        self.release(s)
        return ex(r, 'str')

    def compare_text(self, op: str, a: Ex, b: Ex) -> Ex:
        c = self.tmp('cmp32')
        self.emit(c + ' = call i32 @tomato_str_cmp(ptr ' + a.reg + ', ptr ' + b.reg + ')')
        cc = 'eq'
        if op == '!=':
            cc = 'ne'
        elif op == '<':
            cc = 'slt'
        elif op == '<=':
            cc = 'sle'
        elif op == '>':
            cc = 'sgt'
        elif op == '>=':
            cc = 'sge'
        r = self.tmp('c')
        self.emit(r + ' = icmp ' + cc + ' i32 ' + c + ', 0')
        self.release(a)
        self.release(b)
        return self.bool_of(r)

    def binop(self, n: Node) -> Ex:
        op = n.fields[0].text
        a = self.expr(val_node(n.fields[1]))
        b = self.expr(val_node(n.fields[2]))
        is_compare = op == '==' or op == '!=' or op == '<' or op == '<=' or op == '>' or op == '>='
        if a.ty == 'str' or b.ty == 'str':
            if a.ty != b.ty:
                raise CompileError('type error: cannot use ' + op + ' with ' + a.ty + ' and ' + b.ty, n.line)
            if op == '+':
                r = self.tmp('cat')
                self.emit(r + ' = call ptr @tomato_str_concat(ptr ' + a.reg + ', ptr ' + b.reg + ')')
                self.release(a)
                self.release(b)
                return ex(r, 'str')
            if is_compare:
                return self.compare_text(op, a, b)
            raise CompileError('the Tomato compiler does not support ' + op + ' on text yet', n.line)
        if op == 'and' or op == 'or' or op == 'xor':
            self.want(a, 'bool', n.line, 'the left side of ' + op)
            self.want(b, 'bool', n.line, 'the right side of ' + op)
            return ex(self.arith(op, a.reg, b.reg), 'bool')
        if is_compare and a.ty == 'bool' and b.ty == 'bool':
            if op != '==' and op != '!=':
                raise CompileError('type error: cannot order bools', n.line)
        elif a.ty != 'int' or b.ty != 'int':
            raise CompileError('type error: cannot use ' + op + ' with ' + a.ty + ' and ' + b.ty, n.line)
        if op == '+':
            return ex(self.arith('add', a.reg, b.reg), 'int')
        if op == '-':
            return ex(self.arith('sub', a.reg, b.reg), 'int')
        if op == '*':
            return ex(self.arith('mul', a.reg, b.reg), 'int')
        if op == '%':
            return ex(self.modulo(a.reg, b.reg), 'int')
        if op == '==':
            return self.icmp('eq', a.reg, b.reg)
        if op == '!=':
            return self.icmp('ne', a.reg, b.reg)
        if op == '<':
            return self.icmp('slt', a.reg, b.reg)
        if op == '<=':
            return self.icmp('sle', a.reg, b.reg)
        if op == '>':
            return self.icmp('sgt', a.reg, b.reg)
        if op == '>=':
            return self.icmp('sge', a.reg, b.reg)
        raise CompileError('the Tomato compiler does not support the operator ' + op + ' yet', n.line)

    def call(self, n: Node, statement: bool) -> Ex:
        f = val_node(n.fields[0])
        if f.kind == 'Attr':
            return self.method_call(n, f)
        if f.kind != 'Name':
            raise CompileError('the Tomato compiler only calls plain functions yet', n.line)
        if len(n.fields[2].items) > 0:
            raise CompileError('the Tomato compiler does not support keyword arguments yet', n.line)
        name = f.fields[0].text
        args = val_nodes(n.fields[1])
        if name == 'print':
            if not statement:
                raise CompileError('print has no value', n.line)
            self.print_call(args)
            return ex('', '')
        if name == 'len':
            return self.len_call(args, n.line)
        if name == 'str':
            return self.str_call(args, n.line)
        info = self.mod.find(name, n.line)
        if len(args) != len(info.ptypes):
            raise CompileError(name + ' takes ' + str(len(info.ptypes)) + ' argument(s), got ' + str(len(args)), n.line)
        values: list[Ex] = []
        k = 0
        for a in args:
            v = self.expr(a, info.ptypes[k])
            self.want(v, info.ptypes[k], n.line, 'argument ' + str(k + 1) + ' of ' + name)
            values.append(v)
            k = k + 1
        parts: list[str] = []
        for v in values:
            parts.append(llvm_type(v.ty) + ' ' + v.reg)
        text = 'call ' + self.ret_llvm(info) + ' @tomato.' + name + '(' + ', '.join(parts) + ')'
        result = ex('', '')
        if info.ret == '':
            self.emit(text)
        else:
            r = self.tmp('call')
            self.emit(r + ' = ' + text)
            result = ex(r, info.ret)
        for v in values:
            self.release(v)       # the callee only borrowed its arguments
        return result

    def method_call(self, n: Node, f: Node) -> Ex:
        name = f.fields[1].text
        obj = self.expr(val_node(f.fields[0]))
        args = val_nodes(n.fields[1])
        if is_list(obj.ty) and name == 'append':
            if len(args) != 1:
                raise CompileError('append takes 1 argument, got ' + str(len(args)), n.line)
            v = self.expr(args[0], elem_of(obj.ty))
            self.want(v, elem_of(obj.ty), n.line, 'the appended item')
            slot = self.tmp('slot')
            self.emit(slot + ' = call ptr @tomato_list_push(ptr ' + obj.reg + ', i64 8)')
            self.emit('store ' + llvm_type(v.ty) + ' ' + v.reg + ', ptr ' + slot)
            self.release(obj)
            return ex('', '')
        raise CompileError('the Tomato compiler does not support the method ' + name + ' on ' + obj.ty + ' yet', n.line)

    def ret_llvm(self, info: FuncInfo) -> str:
        if info.ret == '':
            return 'void'
        return llvm_type(info.ret)

    def len_call(self, args: list[Node], line: int) -> Ex:
        if len(args) != 1:
            raise CompileError('len(x) takes one argument', line)
        v = self.expr(args[0])
        r = self.tmp('len')
        if is_list(v.ty):
            lenp = self.tmp('lenp')
            self.emit(lenp + ' = getelementptr { i64, i64, i64, i64, ptr }, ptr ' + v.reg + ', i32 0, i32 2')
            self.emit(r + ' = load i64, ptr ' + lenp)
        else:
            self.want(v, 'str', line, 'the argument of len')
            self.emit(r + ' = call i64 @tomato_str_len(ptr ' + v.reg + ')')
        self.release(v)
        return ex(r, 'int')

    def str_call(self, args: list[Node], line: int) -> Ex:
        if len(args) != 1:
            raise CompileError('str(x) takes one argument', line)
        v = self.expr(args[0])
        if v.ty == 'str':
            return v
        r = self.tmp('text')
        if v.ty == 'int':
            self.emit(r + ' = call ptr @tomato_str_from_i64(i64 ' + v.reg + ')')
        else:
            w = self.tmp('w')
            self.emit(w + ' = trunc i64 ' + v.reg + ' to i32')
            self.emit(r + ' = call ptr @tomato_str_from_bool(i32 ' + w + ')')
        return ex(r, 'str')

    def print_call(self, args: list[Node]):
        values: list[Ex] = []
        for a in args:
            v = self.expr(a)                   # every argument is evaluated before anything is printed
            if is_list(v.ty):
                raise CompileError('the Tomato compiler does not print lists yet', a.line)
            values.append(v)
        k = 0
        for v in values:
            if v.ty == 'int':
                self.emit('call i32 (ptr, ...) @printf(ptr @.fmt.int, i64 ' + v.reg + ')')
            elif v.ty == 'bool':
                w = self.tmp('w')
                self.emit(w + ' = trunc i64 ' + v.reg + ' to i32')
                t = self.tmp('text')
                self.emit(t + ' = call ptr @tomato_str_from_bool(i32 ' + w + ')')
                self.emit('call void @tomato_print_strobj(ptr ' + t + ')')
                self.emit('call void @tomato_release(ptr ' + t + ')')
            else:
                self.emit('call void @tomato_print_strobj(ptr ' + v.reg + ')')
                self.release(v)
            if k < len(values) - 1:
                self.emit('call i32 @putchar(i32 32)')
            k = k + 1
        self.emit('call i32 @putchar(i32 10)')

    # ---- statements
    def block(self, body: list[Node]):
        for s in body:
            self.stmt(s)

    def push_loop(self, brk: str, cont: str):
        if self.loop_depth < len(self.breaks):
            self.breaks[self.loop_depth] = brk
            self.conts[self.loop_depth] = cont
        else:
            self.breaks.append(brk)
            self.conts.append(cont)
        self.loop_depth = self.loop_depth + 1

    def stmt(self, s: Node):
        k = s.kind
        if k == 'ExprStmt':
            e = val_node(s.fields[0])
            if e.kind != 'Call':
                raise CompileError('the Tomato compiler only runs calls as statements yet', s.line)
            result = self.call(e, True)
            self.release(result)               # a value nobody keeps is released at once
        elif k == 'Assign':
            target = val_node(s.fields[0])
            if target.kind == 'Index':
                self.assign_item(s, target)
                return
            if target.kind != 'Name':
                raise CompileError('the Tomato compiler can only assign to a variable or a list item yet', s.line)
            name = target.fields[0].text
            expected = ''
            if name in self.slots:
                expected = self.types[name]
            v = self.expr(val_node(s.fields[1]), expected)
            if name in self.slots:
                self.want(v, self.types[name], s.line, 'the assigned value')
            self.store_owned(self.slot(name, v.ty, s.line), v)
        elif k == 'Declare':
            ty = type_name(s.fields[1])
            if ty == '':
                raise CompileError('the Tomato compiler only declares int, bool, str and list variables yet', s.line)
            v = self.expr(val_node(s.fields[2]), ty)
            self.want(v, ty, s.line, 'the value')
            self.store_owned(self.slot(s.fields[0].text, ty, s.line), v)
        elif k == 'Return':
            if s.fields[0].tag == 'z':
                if self.ret != '':
                    raise CompileError('this function must return a ' + self.ret, s.line)
            else:
                if self.ret == '':
                    raise CompileError('this function returns no value', s.line)
                v = self.expr(val_node(s.fields[0]), self.ret)
                self.want(v, self.ret, s.line, 'the returned value')
                self.emit('store ' + llvm_type(v.ty) + ' ' + v.reg + ', ptr %retval')
            self.br('epilogue')
        elif k == 'If':
            self.if_stmt(s)
        elif k == 'While':
            self.while_stmt(s)
        elif k == 'For':
            self.for_stmt(s)
        elif k == 'Break':
            if self.loop_depth == 0:
                raise CompileError('break outside a loop', s.line)
            self.br(self.breaks[self.loop_depth - 1])
        elif k == 'Continue':
            if self.loop_depth == 0:
                raise CompileError('continue outside a loop', s.line)
            self.br(self.conts[self.loop_depth - 1])
        elif k == 'Pass':
            pass
        else:
            raise CompileError('the Tomato compiler does not support ' + k + ' statements yet', s.line)

    def assign_item(self, s: Node, target: Node):
        lst = self.expr(val_node(target.fields[0]))
        if not is_list(lst.ty):
            raise CompileError('only list items can be assigned by index', s.line)
        i = self.expr(val_node(target.fields[1]))
        self.want(i, 'int', s.line, 'an index')
        v = self.expr(val_node(s.fields[1]), elem_of(lst.ty))
        self.want(v, elem_of(lst.ty), s.line, 'the assigned item')
        addr = self.list_slot(lst, i)
        if is_rc(v.ty):
            old = self.tmp('old')
            self.emit(old + ' = load ptr, ptr ' + addr)
            self.emit('store ptr ' + v.reg + ', ptr ' + addr)
            self.emit('call void @tomato_release(ptr ' + old + ')')
        else:
            self.emit('store i64 ' + v.reg + ', ptr ' + addr)
        self.release(lst)

    def if_stmt(self, s: Node):
        end = self.label('endif')
        for branch in s.fields[0].items:
            cond = self.truth(self.expr(val_node(branch.items[0])), s.line)
            then = self.label('then')
            nxt = self.label('next')
            self.cond_br(cond, then, nxt)
            self.place(then)
            self.block(val_nodes(branch.items[1]))
            if not self.terminated:
                self.br(end)
            self.place(nxt)
        if s.fields[1].tag == 'l':
            self.block(val_nodes(s.fields[1]))
        if not self.terminated:
            self.br(end)
        self.place(end)

    def while_stmt(self, s: Node):
        head = self.label('while')
        body = self.label('body')
        end = self.label('endwhile')
        self.br(head)
        self.place(head)
        cond = self.truth(self.expr(val_node(s.fields[0])), s.line)
        self.cond_br(cond, body, end)
        self.place(body)
        self.push_loop(end, head)
        self.block(val_nodes(s.fields[1]))
        self.loop_depth = self.loop_depth - 1
        if not self.terminated:
            self.br(head)
        self.place(end)

    def for_each(self, s: Node, it: Node):
        lst = self.expr(it)
        if not is_list(lst.ty):
            raise CompileError('the Tomato compiler only loops over range() and lists yet', s.line)
        elem = elem_of(lst.ty)
        holder = self.hidden_rc_slot('for.list')
        self.store_owned(holder, lst)
        counter = self.hidden_slot('for.i')
        self.emit('store i64 0, ptr ' + counter)
        var = self.slot(s.fields[0].text, elem, s.line)
        head = self.label('each')
        body = self.label('eachbody')
        step = self.label('eachstep')
        end = self.label('endeach')
        self.br(head)
        self.place(head)
        l = self.tmp('lst')
        self.emit(l + ' = load ptr, ptr ' + holder)
        i = self.tmp('i')
        self.emit(i + ' = load i64, ptr ' + counter)
        lenp = self.tmp('lenp')
        self.emit(lenp + ' = getelementptr { i64, i64, i64, i64, ptr }, ptr ' + l + ', i32 0, i32 2')
        ln = self.tmp('n')
        self.emit(ln + ' = load i64, ptr ' + lenp)
        go = self.tmp('go')
        self.emit(go + ' = icmp slt i64 ' + i + ', ' + ln)
        self.cond_br(go, body, end)
        self.place(body)
        addr = self.list_slot(ex(l, lst.ty), ex(i, 'int'))
        item = self.tmp('item')
        self.emit(item + ' = load ' + llvm_type(elem) + ', ptr ' + addr)
        e = ex(item, elem)
        self.retain(e)
        self.store_owned(var, e)
        self.push_loop(end, step)
        self.block(val_nodes(s.fields[2]))
        self.loop_depth = self.loop_depth - 1
        if not self.terminated:
            self.br(step)
        self.place(step)
        cur = self.tmp('cur')
        self.emit(cur + ' = load i64, ptr ' + counter)
        nxt = self.tmp('next')
        self.emit(nxt + ' = add i64 ' + cur + ', 1')
        self.emit('store i64 ' + nxt + ', ptr ' + counter)
        self.br(head)
        self.place(end)

    def for_stmt(self, s: Node):
        it = val_node(s.fields[1])
        if not (it.kind == 'Call' and val_node(it.fields[0]).kind == 'Name' and val_node(it.fields[0]).fields[0].text == 'range'):
            self.for_each(s, it)
            return
        if it.kind != 'Call' or val_node(it.fields[0]).kind != 'Name' or val_node(it.fields[0]).fields[0].text != 'range':
            raise CompileError('the Tomato compiler only loops over range() yet', s.line)
        bounds = val_nodes(it.fields[1])
        if len(bounds) != 1 and len(bounds) != 2:
            raise CompileError('the Tomato compiler supports range(stop) and range(start, stop) yet', s.line)
        start = '0'
        stop = ''
        if len(bounds) == 1:
            e = self.expr(bounds[0])
            self.want(e, 'int', s.line, 'a range bound')
            stop = e.reg
        else:
            a = self.expr(bounds[0])
            b = self.expr(bounds[1])
            self.want(a, 'int', s.line, 'a range bound')
            self.want(b, 'int', s.line, 'a range bound')
            start = a.reg
            stop = b.reg
        var = self.slot(s.fields[0].text, 'int', s.line)
        counter = self.hidden_slot('for.i')
        limit = self.hidden_slot('for.n')
        self.emit('store i64 ' + start + ', ptr ' + counter)
        self.emit('store i64 ' + stop + ', ptr ' + limit)
        head = self.label('for')
        body = self.label('forbody')
        step = self.label('forstep')
        end = self.label('endfor')
        self.br(head)
        self.place(head)
        i = self.tmp('i')
        self.emit(i + ' = load i64, ptr ' + counter)
        lim = self.tmp('lim')
        self.emit(lim + ' = load i64, ptr ' + limit)
        c = self.tmp('go')
        self.emit(c + ' = icmp slt i64 ' + i + ', ' + lim)
        self.cond_br(c, body, end)
        self.place(body)
        self.emit('store i64 ' + i + ', ptr ' + var)
        self.push_loop(end, step)
        self.block(val_nodes(s.fields[2]))
        self.loop_depth = self.loop_depth - 1
        if not self.terminated:
            self.br(step)
        self.place(step)
        cur = self.tmp('cur')
        self.emit(cur + ' = load i64, ptr ' + counter)
        nxt = self.tmp('next')
        self.emit(nxt + ' = add i64 ' + cur + ', 1')
        self.emit('store i64 ' + nxt + ', ptr ' + counter)
        self.br(head)
        self.place(end)

def compile_function(f: Node, mod: Mod, info: FuncInfo) -> str:
    g = Gen()
    g.mod = mod
    g.ret = info.ret
    name = f.fields[0].text
    params = val_nodes(f.fields[1])
    sig: list[str] = []
    k = 0
    for p in params:
        reg = g.slot(p.fields[0].text, info.ptypes[k], p.line)
        sig.append(llvm_type(info.ptypes[k]) + ' %arg.' + p.fields[0].text)
        g.emit('store ' + llvm_type(info.ptypes[k]) + ' %arg.' + p.fields[0].text + ', ptr ' + reg)
        if is_rc(info.ptypes[k]):
            g.emit('call void @tomato_retain(ptr %arg.' + p.fields[0].text + ')')    # the caller only lent it
        k = k + 1
    g.block(val_nodes(f.fields[3]))
    if not g.terminated:
        if info.ret == '':
            g.br('epilogue')
        else:
            g.emit('call void @tomato_fail(ptr ' + mod.intern('the function ended without returning a value') + '.c)')
            g.emit('unreachable')
            g.terminated = True
    g.lines.append('epilogue:')
    for reg in g.rc_slots:
        o = g.tmp('rel')
        g.lines.append('  ' + o + ' = load ptr, ptr ' + reg)
        g.lines.append('  call void @tomato_release(ptr ' + o + ')')
    ret = 'void'
    if info.ret != '':
        ret = llvm_type(info.ret)
        r = g.tmp('ret')
        g.lines.append('  ' + r + ' = load ' + ret + ', ptr %retval')
        g.lines.append('  ret ' + ret + ' ' + r)
    else:
        g.lines.append('  ret void')
    text = 'define ' + ret + ' @tomato.' + name + '(' + ', '.join(sig) + ') {\nentry:\n'
    if info.ret != '':
        zero = '0'
        if is_rc(info.ret):
            zero = 'null'
        text = text + '  %retval = alloca ' + ret + '\n  store ' + ret + ' ' + zero + ', ptr %retval\n'
    if len(g.allocas) > 0:
        text = text + '\n'.join(g.allocas) + '\n'
    text = text + '\n'.join(g.lines) + '\n}\n'
    return text

def runtime_tables(mod: Mod) -> str:
    n = len(mod.codes) + 2
    names = new_strs()
    zeros = new_strs()
    kinds = new_strs()
    for k in range(n):
        names.append('ptr null')
        zeros.append('i64 0')
        if k >= 2 and elem_of(mod.codes[k - 2]) == 'str':
            kinds.append('i32 258')          # a list that holds text: 2, plus 256 for reference counted items
        elif k >= 2:
            kinds.append('i32 2')
        else:
            kinds.append('i32 0')
    count = str(n)
    t = '@tomato_exc = global ptr null\n'
    t = t + '@tomato_exc_line = global i32 0\n'
    t = t + '@tomato_exc_rt = global i32 0\n'
    t = t + '@tomato_exc_seen = global i32 0\n'
    t = t + '@tomato_class_names = constant [' + count + ' x ptr] [' + ', '.join(names) + ']\n'
    t = t + '@tomato_parents = global [' + count + ' x i64] [' + ', '.join(zeros) + ']\n'
    t = t + '@tomato_kinds = constant [' + count + ' x i32] [' + ', '.join(kinds) + ']\n'
    t = t + '@tomato_offsets = constant [' + count + ' x ptr] [' + ', '.join(names) + ']\n'
    return t

def new_strs() -> list[str]:
    return []

def declarations() -> str:
    d = 'declare i32 @printf(ptr, ...)\n'
    d = d + 'declare i32 @putchar(i32)\n'
    d = d + 'declare void @tomato_fail(ptr)\n'
    d = d + 'declare void @tomato_leak_check()\n'
    d = d + 'declare void @tomato_retain(ptr)\n'
    d = d + 'declare void @tomato_release(ptr)\n'
    d = d + 'declare ptr @tomato_str_concat(ptr, ptr)\n'
    d = d + 'declare i64 @tomato_str_len(ptr)\n'
    d = d + 'declare i32 @tomato_str_cmp(ptr, ptr)\n'
    d = d + 'declare ptr @tomato_str_index(ptr, i64)\n'
    d = d + 'declare ptr @tomato_str_slice(ptr, i64, i64)\n'
    d = d + 'declare ptr @tomato_str_from_i64(i64)\n'
    d = d + 'declare ptr @tomato_str_from_bool(i32)\n'
    d = d + 'declare void @tomato_print_strobj(ptr)\n'
    d = d + 'declare ptr @tomato_list_new(i64)\n'
    d = d + 'declare ptr @tomato_list_push(ptr, i64)\n'
    d = d + '@.fmt.int = private constant [5 x i8] c"%lld\\00"\n'
    return d

export def compile_module(src: str) -> str:
    tree = parse(src)
    mod = Mod()
    funcs: list[Node] = []
    entry = ''
    for item in val_nodes(tree.fields[0]):
        if item.kind != 'FuncDef':
            raise CompileError('the Tomato compiler does not support ' + item.kind + ' declarations yet', item.line)
        info = FuncInfo()
        info.name = item.fields[0].text
        if item.fields[2].tag != 'z':
            info.ret = type_name(item.fields[2])
            if info.ret == '':
                raise CompileError('the Tomato compiler only returns int, bool, str and list values yet', item.line)
        for p in val_nodes(item.fields[1]):
            if p.fields[3].tag != 'z' or p.fields[2].tag != 'z':
                raise CompileError('the Tomato compiler does not support defaults or *args yet', p.line)
            pt = type_name(p.fields[1])
            if pt == '':
                raise CompileError('the Tomato compiler only takes int, bool, str and list parameters yet', p.line)
            info.ptypes.append(pt)
        mod.infos.append(info)
        funcs.append(item)
        if item.fields[6].tag == 's' and item.fields[6].text == 'entry:main':
            entry = info.name
            if len(info.ptypes) != 0 or info.ret != '':
                raise CompileError('the Tomato compiler runs an @main without inputs or a result yet', item.line)
    if entry == '':
        raise CompileError('no function marked @main', 1)
    bodies = ''
    k = 0
    for f in funcs:
        bodies = bodies + compile_function(f, mod, mod.infos[k]) + '\n'
        k = k + 1
    out = '; written by the Tomato compiler in Tomato (selfhost/compiler.tom)\n'
    out = out + declarations() + runtime_tables(mod)
    j = 0
    for s in mod.strings:
        out = out + string_global(j, s) + '\n'
        out = out + string_c(j, s) + '\n'
        j = j + 1
    out = out + '\n' + bodies
    out = out + 'define i32 @main() {\n  call void @tomato.' + entry + '()\n  call void @tomato_leak_check()\n  ret i32 0\n}\n'
    return out
