# A slice of the Tomato compiler, written in Tomato (D38a): int, bool and str programs.
#
# It takes the syntax tree from selfhost/parser.tom and writes LLVM IR text that links with the C runtime
# (tomato/runtime/tomato_rt.c). Supported: functions with int/bool/str parameters and results, locals, + - * % and
# comparisons, string + == != < <= > >=, indexing and slicing, len, str(), and/or/xor/not, if/elif/else, while,
# for over range(), break, continue, calls, print, and an @main entry point without inputs. Text values are
# reference counted exactly like the Python compiler: every text value an expression produces is owned by whoever
# uses it, and a slot releases what it held. Everything else stops with a CompileError that says what is not
# supported yet. Numbers are 64-bit and wrap on overflow, a zero `%` divisor is not checked, and `and` and `or`
# evaluate both sides (P53).
from parser import Node, Val, parse, new_strs

export class CompileError(Error):
    @init
    def make(self, message: str, line: int):
        Error.start(self, message)

def val_node(v: Val) -> Node:
    n = v.node
    if n is None:
        raise CompileError('internal error: a missing syntax node', 0)
    return n

def node_val(n: Node) -> Val:
    v = Val()
    v.tag = 'n'
    v.node = n
    return v

def val_nodes(v: Val) -> list[Node]:
    out: list[Node] = []
    for item in v.items:
        out.append(val_node(item))
    return out

def basic_type(name: str) -> bool:
    return name == 'int' or name == 'bool' or name == 'str' or name == 'File' or name == 'float'

def is_list(t: str) -> bool:
    return t.startswith('list[')

def is_dict(t: str) -> bool:
    return t.startswith('dict[')

def dict_value(t: str) -> str:
    # the value type of dict[V], a dict with text keys
    return t[5:len(t) - 1]

def is_class(t: str) -> bool:
    return t.startswith('@')

def is_optional(t: str) -> bool:
    return t.endswith('?')

def strip_optional(t: str) -> str:
    if is_optional(t):
        return t[0:len(t) - 1]
    return t

def is_rc(t: str) -> bool:
    # heap values are reference counted; None is the null pointer, which counting ignores (D23b)
    return t == 'str' or is_list(t) or is_dict(t) or is_class(t) or t == 'None' or is_optional(t)

def elem_of(t: str) -> str:
    return t[5:len(t) - 1]

def shown(t: str) -> str:
    # a type as the user writes it
    if is_optional(t):
        return shown(strip_optional(t)) + ' | None'
    if is_class(t):
        return t[1:]
    if is_list(t):
        return 'list[' + shown(elem_of(t)) + ']'
    if is_dict(t):
        return 'dict[str, ' + shown(dict_value(t)) + ']'
    return t

def llvm_type(t: str) -> str:
    if is_rc(t) or t == 'File':
        return 'ptr'
    if t == 'float':
        return 'double'
    return 'i64'

def zero_of(t: str) -> str:
    # the value a function returns when it never stored one
    if is_rc(t):
        return 'null'
    if t == 'float':
        return '0.0'
    return '0'

class Ex:
    # a compiled expression: the register or constant that holds it, and its Tomato type
    reg: str = ''
    ty: str = ''

def ex(reg: str, ty: str) -> Ex:
    e = Ex()
    e.reg = reg
    e.ty = ty
    return e

class FuncInfo:
    name: str = ''
    owner: str = ''          # the class a method belongs to, or ''
    ret: str = ''
    ptypes: list[str] = []   # without self
    defaults: list[Node] = []     # the default values of the last parameters, in order

class ClassInfo:
    name: str = ''
    fnames: list[str] = []
    ftypes: list[str] = []
    has_default: list[bool] = []
    defaults: list[Node] = []     # only the fields that have a default, in order
    init: str = ''                # the name of the @init method, or ''
    parent: str = ''              # the parent class, or ''
    done: bool = False            # fields and defaults are complete (inherited ones come first)
    line: int = 0

class Mod:
    # what every function of the program shares
    strings: list[str] = []
    infos: list[FuncInfo] = []
    codes: list[str] = []         # the heap types the program uses; a type's code is 2 plus its place here
    classes: list[ClassInfo] = []

    def code_of(self, t: str) -> int:
        k = 0
        for x in self.codes:
            if x == t:
                return k + 2
            k = k + 1
        self.codes.append(t)
        return len(self.codes) + 1

    def intern(self, s: str) -> str:
        k = 0
        for x in self.strings:
            if x == s:
                return '@.str.' + str(k)
            k = k + 1
        self.strings.append(s)
        return '@.str.' + str(k)

    def find(self, name: str, line: int) -> FuncInfo:
        for f in self.infos:
            if f.name == name and f.owner == '':
                return f
        raise CompileError('unknown function ' + name, line)

    def find_method(self, cls: str, name: str, line: int) -> FuncInfo:
        # the method as the class or its nearest parent defines it
        for f in self.infos:
            if f.name == name and f.owner == cls:
                return f
        c = self.find_class(cls, line)
        if c.parent != '':
            return self.find_method(c.parent, name, line)
        raise CompileError(cls + ' has no method ' + name, line)

    def assignable(self, a: str, b: str) -> bool:
        # may a value of type a be used where b is wanted (no conversion needed)?
        if a == b or self.subclass(a, b):
            return True
        if is_optional(b):
            return a == 'None' or self.assignable(a, strip_optional(b))
        return False

    def subclass(self, a: str, b: str) -> bool:
        # is class a (written '@A') the same as b or a descendant of it?
        if a == b:
            return True
        if not (is_class(a) and is_class(b)) or not self.has_class(a[1:]):
            return False
        c = self.find_class(a[1:], 0)
        if c.parent == '':
            return False
        return self.subclass('@' + c.parent, b)

    def has_class(self, name: str) -> bool:
        for c in self.classes:
            if c.name == name:
                return True
        return False

    def find_class(self, name: str, line: int) -> ClassInfo:
        for c in self.classes:
            if c.name == name:
                return c
        raise CompileError('unknown class ' + name, line)

    def field_index(self, c: ClassInfo, name: str, line: int) -> int:
        k = 0
        for f in c.fnames:
            if f == name:
                return k
            k = k + 1
        raise CompileError(c.name + ' has no field ' + name, line)

    def type_name(self, v: Val) -> str:
        # the name of a type the compiler knows: int, bool, str, a declared class ('@Name') or a list of those; '' otherwise
        if v.tag != 'n':
            return ''
        t = val_node(v)
        name = t.fields[0].text
        if name == 'union':
            members = val_nodes(t.fields[2])
            if len(members) != 2:
                return ''
            other = members[0]
            if other.fields[0].text == 'None':
                other = members[1]
            elif members[1].fields[0].text != 'None':
                return ''
            wrapped = self.type_name(node_val(other))
            if not (wrapped == 'str' or is_list(wrapped) or is_dict(wrapped) or is_class(wrapped)):
                return ''
            return wrapped + '?'
        if name == 'dict' and t.fields[2].tag == 'n' and t.fields[3].tag == 'n':
            if self.type_name(t.fields[2]) != 'str':
                return ''
            inner = self.type_name(t.fields[3])
            if inner == '':
                return ''
            return 'dict[' + inner + ']'
        if name == 'list' and t.fields[2].tag == 'n' and t.fields[1].tag == 'z':
            inner = self.type_name(t.fields[2])
            if inner == '':
                return ''
            return 'list[' + inner + ']'
        if t.fields[2].tag != 'z' or t.fields[1].tag != 'z':
            return ''
        if basic_type(name):
            return name
        if self.has_class(name):
            return '@' + name
        return ''

def escape_ir_char(c: str, line: int) -> str:
    plain = ' !#$%&\'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[]^_`abcdefghijklmnopqrstuvwxyz{|}~'
    if plain.find(c) >= 0:
        return c
    if c == '\n':
        return '\\0A'
    if c == '\t':
        return '\\09'
    if c == '\r':
        return '\\0D'
    if c == '"':
        return '\\22'
    if c == '\\':
        return '\\5C'
    if c == '\0':
        return '\\00'
    raise CompileError('the Tomato compiler only supports ASCII text literals yet', line)

def escape_text(s: str) -> str:
    body = ''
    i = 0
    while i < len(s):
        body = body + escape_ir_char(s[i], 0)
        i = i + 1
    return body

def string_global(index: int, s: str) -> str:
    size = str(len(s) + 1)
    body = escape_text(s)
    return '@.str.' + str(index) + ' = private constant { i64, i64, i64, i64, [' + size + ' x i8] } { i64 -1, i64 1, i64 ' + str(len(s)) + ', i64 ' + str(len(s)) + ', [' + size + ' x i8] c"' + body + '\\00" }'

def string_c(index: int, s: str) -> str:
    # a plain C copy, which is what tomato_fail prints
    return '@.str.' + str(index) + '.c = private constant [' + str(len(s) + 1) + ' x i8] c"' + escape_text(s) + '\\00"'

class TryInfo:
    # a try statement being compiled (D22a)
    catch_l: str = ''         # where an error raised in the body goes
    prop_l: str = ''          # where an error leaving the statement goes (after the finally block runs)
    final: list[Node] = []
    has_final: bool = False
    loop_depth: int = 0
    state: str = 'body'       # 'body' while compiling the try body, then 'post'

class Gen:
    # one function being compiled
    mod: Mod = Mod()
    lines: list[str] = []
    allocas: list[str] = []
    rc_slots: list[str] = []
    slots: dict[str, str] = {}
    types: dict[str, str] = {}
    n: int = 0
    terminated: bool = False
    breaks: list[str] = []
    conts: list[str] = []
    loop_depth: int = 0
    tries: list[TryInfo] = []
    try_depth: int = 0
    slot_count: int = 0
    ret: str = ''

    def tmp(self, hint: str) -> str:
        self.n = self.n + 1
        return '%' + hint + '.' + str(self.n)

    def label(self, hint: str) -> str:
        self.n = self.n + 1
        return hint + '.' + str(self.n)

    def emit(self, text: str):
        if self.terminated:
            self.lines.append(self.label('dead') + ':')
            self.terminated = False
        self.lines.append('  ' + text)

    def place(self, label: str):
        self.lines.append(label + ':')
        self.terminated = False

    def br(self, label: str):
        self.emit('br label %' + label)
        self.terminated = True

    def cond_br(self, c: str, yes: str, no: str):
        self.emit('br i1 ' + c + ', label %' + yes + ', label %' + no)
        self.terminated = True

    def unwind_target(self) -> str:
        # where an error raised here goes: the innermost try's catch (or its finally once past the body), else out of
        # the function, which returns early so that its caller can check (D22a)
        if self.try_depth > 0:
            t = self.tries[self.try_depth - 1]
            if t.state == 'body':
                return t.catch_l
            return t.prop_l
        return 'epilogue'

    def slot(self, name: str, ty: str, line: int) -> str:
        if name in self.slots:
            if self.types[name] != ty:
                raise CompileError('variable ' + name + ' has type ' + self.types[name] + ', not ' + ty, line)
            return self.slots[name]
        return self.new_slot(name, ty)

    def new_slot(self, name: str, ty: str) -> str:
        self.slot_count = self.slot_count + 1
        reg = '%v.' + name + '.' + str(self.slot_count)
        self.allocas.append('  ' + reg + ' = alloca ' + llvm_type(ty))
        if is_rc(ty):
            self.allocas.append('  store ptr null, ptr ' + reg)
            self.rc_slots.append(reg)
        self.slots[name] = reg
        self.types[name] = ty
        return reg

    def hidden_slot(self, hint: str) -> str:
        reg = self.tmp(hint)
        self.allocas.append('  ' + reg + ' = alloca i64')
        return reg

    def hidden_rc_slot(self, hint: str) -> str:
        reg = self.tmp(hint)
        self.allocas.append('  ' + reg + ' = alloca ptr')
        self.allocas.append('  store ptr null, ptr ' + reg)
        self.rc_slots.append(reg)
        return reg

    # ---- reference counting
    def retain(self, e: Ex):
        if is_rc(e.ty):
            self.emit('call void @tomato_retain(ptr ' + e.reg + ')')

    def release(self, e: Ex):
        if is_rc(e.ty):
            self.emit('call void @tomato_release(ptr ' + e.reg + ')')

    def store_owned(self, slot: str, e: Ex):
        # the slot takes over the reference and releases what it held
        if is_rc(e.ty):
            old = self.tmp('old')
            self.emit(old + ' = load ptr, ptr ' + slot)
            self.emit('store ptr ' + e.reg + ', ptr ' + slot)
            self.emit('call void @tomato_release(ptr ' + old + ')')
        else:
            self.emit('store ' + llvm_type(e.ty) + ' ' + e.reg + ', ptr ' + slot)

    def unwrap(self, e: Ex, line: int) -> Ex:
        # an optional used where a value is needed: stop when it is None (D23b)
        if not is_optional(e.ty):
            return e
        bad = self.tmp('isnone')
        self.emit(bad + ' = icmp eq ptr ' + e.reg + ', null')
        self.fail_if(bad, 'None where a value is needed')
        return ex(e.reg, strip_optional(e.ty))

    def want(self, e: Ex, ty: str, line: int, what: str):
        if is_optional(e.ty) and not is_optional(ty) and ty != 'None' and self.mod.assignable(strip_optional(e.ty), ty):
            self.unwrap(e, line)
            return
        if not self.mod.assignable(e.ty, ty):
            raise CompileError('type error: ' + what + ' is ' + e.ty + ' where ' + ty + ' is needed', line)

    # ---- small instructions
    def truth(self, e: Ex, line: int) -> str:
        self.want(e, 'bool', line, 'a condition')
        r = self.tmp('cond')
        self.emit(r + ' = icmp ne i64 ' + e.reg + ', 0')
        return r

    def bool_of(self, i1: str) -> Ex:
        r = self.tmp('b')
        self.emit(r + ' = zext i1 ' + i1 + ' to i64')
        return ex(r, 'bool')

    def arith(self, op: str, a: str, b: str) -> str:
        r = self.tmp('t')
        self.emit(r + ' = ' + op + ' i64 ' + a + ', ' + b)
        return r

    def icmp(self, cc: str, a: str, b: str) -> Ex:
        c = self.tmp('cmp')
        self.emit(c + ' = icmp ' + cc + ' i64 ' + a + ', ' + b)
        return self.bool_of(c)

    def modulo(self, a: str, b: str) -> str:
        # Python-style: the result has the sign of the divisor (D05au); a zero divisor is not checked yet (P53)
        r = self.arith('srem', a, b)
        x = self.arith('xor', r, b)
        differ = self.icmp('slt', x, '0')
        nonzero = self.icmp('ne', r, '0')
        fix = self.arith('and', differ.reg, nonzero.reg)
        amount = self.arith('mul', fix, b)
        return self.arith('add', r, amount)

    def fail_if(self, bad: str, message: str):
        # bad is an i1; when true, report the error and stop
        stop = self.label('stop')
        ok = self.label('ok')
        self.cond_br(bad, stop, ok)
        self.place(stop)
        self.emit('call void @tomato_fail(ptr ' + self.mod.intern(message) + '.c)')
        self.emit('unreachable')
        self.terminated = True
        self.place(ok)

    # ---- expressions
    def expr(self, n: Node, expected: str = '') -> Ex:
        k = n.kind
        if k == 'IntLit':
            return ex(str(n.fields[0].num), 'int')
        if k == 'BoolLit':
            if n.fields[0].flag:
                return ex('1', 'bool')
            return ex('0', 'bool')
        if k == 'StrLit':
            return ex(self.mod.intern(n.fields[0].text), 'str')
        if k == 'Name':
            name = n.fields[0].text
            if name == 'None' and not (name in self.slots):
                return ex('null', 'None')
            if not (name in self.slots):
                raise CompileError('unknown name ' + name, n.line)
            ty = self.types[name]
            r = self.tmp('l')
            self.emit(r + ' = load ' + llvm_type(ty) + ', ptr ' + self.slots[name])
            e = ex(r, ty)
            self.retain(e)
            return e
        if k == 'UnOp':
            op = n.fields[0].text
            v = self.expr(val_node(n.fields[1]))
            if op == '-':
                self.want(v, 'int', n.line, 'the operand of -')
                return ex(self.arith('sub', '0', v.reg), 'int')
            self.want(v, 'bool', n.line, 'the operand of not')
            return ex(self.arith('xor', v.reg, '1'), 'bool')
        if k == 'BinOp':
            return self.binop(n)
        if k == 'Call':
            return self.call(n, False)
        if k == 'ListLit':
            return self.list_lit(n, expected)
        if k == 'MapLit':
            return self.map_lit(n, expected)
        if k == 'Attr':
            return self.field_get(n)
        if k == 'Index':
            return self.index(n)
        if k == 'Slice':
            return self.slice(n)
        raise CompileError('the Tomato compiler does not support ' + k + ' yet', n.line)

    def list_slot(self, lst: Ex, i: Ex) -> str:
        # the address of item i, after a bounds check
        lenp = self.tmp('lenp')
        self.emit(lenp + ' = getelementptr { i64, i64, i64, i64, ptr }, ptr ' + lst.reg + ', i32 0, i32 2')
        ln = self.tmp('len')
        self.emit(ln + ' = load i64, ptr ' + lenp)
        bad = self.tmp('oob')
        self.emit(bad + ' = icmp uge i64 ' + i.reg + ', ' + ln)
        self.fail_if(bad, 'index out of range')
        datap = self.tmp('datap')
        self.emit(datap + ' = getelementptr { i64, i64, i64, i64, ptr }, ptr ' + lst.reg + ', i32 0, i32 4')
        data = self.tmp('data')
        self.emit(data + ' = load ptr, ptr ' + datap)
        addr = self.tmp('addr')
        self.emit(addr + ' = getelementptr i64, ptr ' + data + ', i64 ' + i.reg)
        return addr

    def field_addr(self, obj: Ex, name: str, line: int) -> str:
        if not is_class(obj.ty):
            raise CompileError('type error: ' + shown(obj.ty) + ' has no fields', line)
        c = self.mod.find_class(obj.ty[1:], line)
        idx = self.mod.field_index(c, name, line)
        addr = self.tmp('fld')
        self.emit(addr + ' = getelementptr %class.' + str(self.mod.code_of(obj.ty)) + ', ptr ' + obj.reg + ', i32 0, i32 ' + str(idx + 2))
        return addr

    def field_type(self, obj: Ex, name: str, line: int) -> str:
        c = self.mod.find_class(obj.ty[1:], line)
        return c.ftypes[self.mod.field_index(c, name, line)]

    def field_get(self, n: Node) -> Ex:
        obj = self.unwrap(self.expr(val_node(n.fields[0])), n.line)
        name = n.fields[1].text
        addr = self.field_addr(obj, name, n.line)
        ft = self.field_type(obj, name, n.line)
        v = self.tmp('f')
        self.emit(v + ' = load ' + llvm_type(ft) + ', ptr ' + addr)
        e = ex(v, ft)
        self.retain(e)
        self.release(obj)
        return e

    def assign_field(self, s: Node, target: Node):
        obj = self.unwrap(self.expr(val_node(target.fields[0])), s.line)
        name = target.fields[1].text
        ft = self.field_type(obj, name, s.line)
        v = self.expr(val_node(s.fields[1]), ft)
        self.want(v, ft, s.line, 'the assigned value')
        addr = self.field_addr(obj, name, s.line)
        self.store_owned(addr, v)
        self.release(obj)

    def list_lit(self, n: Node, expected: str) -> Ex:
        items = val_nodes(n.fields[0])
        t = ''
        first = ex('', '')
        if is_list(expected):
            t = expected
        else:
            if len(items) == 0:
                raise CompileError('the type of an empty list needs a declaration: xs: list[int] = []', n.line)
            first = self.expr(items[0])
            if first.ty == '':
                raise CompileError('a list item needs a value', n.line)
            t = 'list[' + first.ty + ']'
        lst = self.tmp('list')
        self.emit(lst + ' = call ptr @tomato_list_new(i64 ' + str(self.mod.code_of(t)) + ')')
        k = 0
        for item in items:
            v = ex('', '')
            if k == 0 and first.ty != '':
                v = first
            else:
                v = self.expr(item, elem_of(t))
            self.want(v, elem_of(t), n.line, 'a list item')
            slot = self.tmp('slot')
            self.emit(slot + ' = call ptr @tomato_list_push(ptr ' + lst + ', i64 8)')
            self.emit('store ' + llvm_type(v.ty) + ' ' + v.reg + ', ptr ' + slot)     # the list takes the reference
            k = k + 1
        return ex(lst, t)

    def key_word(self, k: Ex) -> str:
        r = self.tmp('kw')
        self.emit(r + ' = ptrtoint ptr ' + k.reg + ' to i64')
        return r

    def map_lit(self, n: Node, expected: str) -> Ex:
        pairs = n.fields[0].items
        if not is_dict(expected):
            raise CompileError('the type of a {} needs a declaration: m: dict[str, int] = {}', n.line)
        value_t = dict_value(expected)
        d = self.tmp('dict')
        self.emit(d + ' = call ptr @tomato_dict_new(i64 ' + str(self.mod.code_of(expected)) + ', i64 8, i32 1)')
        for pair in pairs:
            k = self.expr(val_node(pair.items[0]))
            self.want(k, 'str', n.line, 'a dict key')
            v = self.expr(val_node(pair.items[1]), value_t)
            self.want(v, value_t, n.line, 'a dict value')
            slot = self.tmp('slot')
            self.emit(slot + ' = call ptr @tomato_dict_insert(ptr ' + d + ', i64 ' + self.key_word(k) + ', i32 1)')
            dup = self.tmp('dup')
            self.emit(dup + ' = icmp eq ptr ' + slot + ', null')
            self.fail_if(dup, 'duplicate key in a dict literal')
            self.emit('store ' + llvm_type(v.ty) + ' ' + v.reg + ', ptr ' + slot)
            self.release(k)
        return ex(d, expected)

    def index(self, n: Node) -> Ex:
        s = self.unwrap(self.expr(val_node(n.fields[0])), n.line)
        if is_dict(s.ty):
            k = self.expr(val_node(n.fields[1]))
            self.want(k, 'str', n.line, 'a dict key')
            slot = self.tmp('slot')
            self.emit(slot + ' = call ptr @tomato_dict_find(ptr ' + s.reg + ', i64 ' + self.key_word(k) + ')')
            missing = self.tmp('missing')
            self.emit(missing + ' = icmp eq ptr ' + slot + ', null')
            self.fail_if(missing, 'the key is not there')
            vt = dict_value(s.ty)
            r = self.tmp('val')
            self.emit(r + ' = load ' + llvm_type(vt) + ', ptr ' + slot)
            e = ex(r, vt)
            self.retain(e)
            self.release(k)
            self.release(s)
            return e
        if is_list(s.ty):
            li = self.expr(val_node(n.fields[1]))
            self.want(li, 'int', n.line, 'an index')
            addr = self.list_slot(s, li)
            item = self.tmp('item')
            self.emit(item + ' = load ' + llvm_type(elem_of(s.ty)) + ', ptr ' + addr)
            e = ex(item, elem_of(s.ty))
            self.retain(e)
            self.release(s)
            return e
        self.want(s, 'str', n.line, 'the value being indexed')
        i = self.expr(val_node(n.fields[1]))
        self.want(i, 'int', n.line, 'an index')
        r = self.tmp('ch')
        self.emit(r + ' = call ptr @tomato_str_index(ptr ' + s.reg + ', i64 ' + i.reg + ')')
        bad = self.tmp('oob')
        self.emit(bad + ' = icmp eq ptr ' + r + ', null')
        self.fail_if(bad, 'index out of range')
        self.release(s)
        return ex(r, 'str')

    def slice(self, n: Node) -> Ex:
        s = self.unwrap(self.expr(val_node(n.fields[0])), n.line)
        self.want(s, 'str', n.line, 'the value being sliced')
        lo = '0'
        if n.fields[1].tag == 'n':
            e = self.expr(val_node(n.fields[1]))
            self.want(e, 'int', n.line, 'a slice bound')
            lo = e.reg
        hi = ''
        if n.fields[2].tag == 'n':
            e2 = self.expr(val_node(n.fields[2]))
            self.want(e2, 'int', n.line, 'a slice bound')
            hi = e2.reg
        else:
            hi = self.tmp('len')
            self.emit(hi + ' = call i64 @tomato_str_len(ptr ' + s.reg + ')')
        r = self.tmp('part')
        self.emit(r + ' = call ptr @tomato_str_slice(ptr ' + s.reg + ', i64 ' + lo + ', i64 ' + hi + ')')
        bad = self.tmp('oob')
        self.emit(bad + ' = icmp eq ptr ' + r + ', null')
        self.fail_if(bad, 'slice out of range')
        self.release(s)
        return ex(r, 'str')

    def membership(self, a: Ex, b: Ex, line: int) -> Ex:
        if b.ty == 'str':
            self.want(a, 'str', line, 'the left side of in')
            c = self.tmp('c')
            self.emit(c + ' = call i32 @tomato_str_contains(ptr ' + b.reg + ', ptr ' + a.reg + ')')
            i1 = self.tmp('flag')
            self.emit(i1 + ' = icmp ne i32 ' + c + ', 0')
            self.release(a)
            self.release(b)
            return self.bool_of(i1)
        if is_dict(b.ty):
            self.want(a, 'str', line, 'the left side of in')
            slot = self.tmp('slot')
            self.emit(slot + ' = call ptr @tomato_dict_find(ptr ' + b.reg + ', i64 ' + self.key_word(a) + ')')
            i1 = self.tmp('flag')
            self.emit(i1 + ' = icmp ne ptr ' + slot + ', null')
            self.release(a)
            self.release(b)
            return self.bool_of(i1)
        if is_list(b.ty):
            return self.list_contains(a, b, line)
        raise CompileError('the Tomato compiler does not support in on ' + shown(b.ty) + ' yet', line)

    def list_contains(self, a: Ex, lst: Ex, line: int) -> Ex:
        # walk the items and compare each with ==, stopping at the first match (basic item types only)
        elem = elem_of(lst.ty)
        if not (elem == 'int' or elem == 'bool' or elem == 'str'):
            raise CompileError('the Tomato compiler only searches lists of int, bool and str yet', line)
        self.want(a, elem, line, 'the left side of in')
        found = self.hidden_slot('in.found')
        counter = self.hidden_slot('in.i')
        self.emit('store i64 0, ptr ' + found)
        self.emit('store i64 0, ptr ' + counter)
        head = self.label('inhead')
        body = self.label('inbody')
        step = self.label('instep')
        end = self.label('inend')
        self.br(head)
        self.place(head)
        i = self.tmp('i')
        self.emit(i + ' = load i64, ptr ' + counter)
        lenp = self.tmp('lenp')
        self.emit(lenp + ' = getelementptr { i64, i64, i64, i64, ptr }, ptr ' + lst.reg + ', i32 0, i32 2')
        ln = self.tmp('n')
        self.emit(ln + ' = load i64, ptr ' + lenp)
        go = self.tmp('go')
        self.emit(go + ' = icmp slt i64 ' + i + ', ' + ln)
        self.cond_br(go, body, end)
        self.place(body)
        addr = self.list_slot(lst, ex(i, 'int'))
        item = self.tmp('item')
        self.emit(item + ' = load ' + llvm_type(elem) + ', ptr ' + addr)
        hit = self.tmp('hit')
        if elem == 'str':
            c = self.tmp('c')
            self.emit(c + ' = call i32 @tomato_str_cmp(ptr ' + item + ', ptr ' + a.reg + ')')
            self.emit(hit + ' = icmp eq i32 ' + c + ', 0')
        else:
            self.emit(hit + ' = icmp eq i64 ' + item + ', ' + a.reg)
        yes = self.label('inhit')
        self.cond_br(hit, yes, step)
        self.place(yes)
        self.emit('store i64 1, ptr ' + found)
        self.br(end)
        self.place(step)
        cur = self.tmp('cur')
        self.emit(cur + ' = load i64, ptr ' + counter)
        nxt = self.tmp('next')
        self.emit(nxt + ' = add i64 ' + cur + ', 1')
        self.emit('store i64 ' + nxt + ', ptr ' + counter)
        self.br(head)
        self.place(end)
        f = self.tmp('found')
        self.emit(f + ' = load i64, ptr ' + found)
        i1 = self.tmp('flag')
        self.emit(i1 + ' = icmp ne i64 ' + f + ', 0')
        self.release(a)
        self.release(lst)
        return self.bool_of(i1)

    def compare_text(self, op: str, a: Ex, b: Ex) -> Ex:
        c = self.tmp('cmp32')
        self.emit(c + ' = call i32 @tomato_str_cmp(ptr ' + a.reg + ', ptr ' + b.reg + ')')
        cc = 'eq'
        if op == '!=':
            cc = 'ne'
        elif op == '<':
            cc = 'slt'
        elif op == '<=':
            cc = 'sle'
        elif op == '>':
            cc = 'sgt'
        elif op == '>=':
            cc = 'sge'
        r = self.tmp('c')
        self.emit(r + ' = icmp ' + cc + ' i32 ' + c + ', 0')
        self.release(a)
        self.release(b)
        return self.bool_of(r)

    def logic(self, n: Node, op: str) -> Ex:
        # and / or: the right side only runs when the left side does not decide the answer
        a = self.expr(val_node(n.fields[1]))
        self.want(a, 'bool', n.line, 'the left side of ' + op)
        res = self.hidden_slot('logic')
        self.emit('store i64 ' + a.reg + ', ptr ' + res)
        c = self.truth(a, n.line)
        rhs = self.label('rhs')
        end = self.label('endlogic')
        if op == 'and':
            self.cond_br(c, rhs, end)
        else:
            self.cond_br(c, end, rhs)
        self.place(rhs)
        b = self.expr(val_node(n.fields[2]))
        self.want(b, 'bool', n.line, 'the right side of ' + op)
        self.emit('store i64 ' + b.reg + ', ptr ' + res)
        self.br(end)
        self.place(end)
        r = self.tmp('logic')
        self.emit(r + ' = load i64, ptr ' + res)
        return ex(r, 'bool')

    def binop(self, n: Node) -> Ex:
        op = n.fields[0].text
        if op == 'and' or op == 'or':
            return self.logic(n, op)
        a = self.expr(val_node(n.fields[1]))
        b = self.expr(val_node(n.fields[2]))
        is_compare = op == '==' or op == '!=' or op == '<' or op == '<=' or op == '>' or op == '>='
        if op == 'in':
            return self.membership(a, b, n.line)
        if not ((op == 'is' or op == 'is not' or op == '==' or op == '!=') and (a.ty == 'None' or b.ty == 'None')):
            a = self.unwrap(a, n.line)
            b = self.unwrap(b, n.line)
        if (op == 'is' or op == 'is not' or op == '==' or op == '!=') and (a.ty == 'None' or b.ty == 'None'):
            if not is_rc(a.ty) or not is_rc(b.ty):
                raise CompileError('type error: ' + shown(a.ty) + ' and ' + shown(b.ty) + ' cannot be compared with None', n.line)
            cc = 'eq'
            if op == 'is not' or op == '!=':
                cc = 'ne'
            c = self.tmp('isnone')
            self.emit(c + ' = icmp ' + cc + ' ptr ' + a.reg + ', ' + b.reg)
            self.release(a)
            self.release(b)
            return self.bool_of(c)
        if a.ty == 'str' or b.ty == 'str':
            if a.ty != b.ty:
                raise CompileError('type error: cannot use ' + op + ' with ' + a.ty + ' and ' + b.ty, n.line)
            if op == '+':
                r = self.tmp('cat')
                self.emit(r + ' = call ptr @tomato_str_concat(ptr ' + a.reg + ', ptr ' + b.reg + ')')
                self.release(a)
                self.release(b)
                return ex(r, 'str')
            if is_compare:
                return self.compare_text(op, a, b)
            raise CompileError('the Tomato compiler does not support ' + op + ' on text yet', n.line)
        if op == 'in':
            return self.membership(a, b, n.line)
        if op == 'xor':
            self.want(a, 'bool', n.line, 'the left side of ' + op)
            self.want(b, 'bool', n.line, 'the right side of ' + op)
            return ex(self.arith(op, a.reg, b.reg), 'bool')
        if is_compare and a.ty == 'bool' and b.ty == 'bool':
            if op != '==' and op != '!=':
                raise CompileError('type error: cannot order bools', n.line)
        elif a.ty != 'int' or b.ty != 'int':
            raise CompileError('type error: cannot use ' + op + ' with ' + a.ty + ' and ' + b.ty, n.line)
        if op == '+':
            return ex(self.arith('add', a.reg, b.reg), 'int')
        if op == '-':
            return ex(self.arith('sub', a.reg, b.reg), 'int')
        if op == '*':
            return ex(self.arith('mul', a.reg, b.reg), 'int')
        if op == '%':
            return ex(self.modulo(a.reg, b.reg), 'int')
        if op == '/':
            bad = self.tmp('zero')
            self.emit(bad + ' = icmp eq i64 ' + b.reg + ', 0')
            self.fail_if(bad, 'division by zero')
            x = self.tmp('x')
            self.emit(x + ' = sitofp i64 ' + a.reg + ' to double')
            y = self.tmp('y')
            self.emit(y + ' = sitofp i64 ' + b.reg + ' to double')
            q = self.tmp('div')
            self.emit(q + ' = fdiv double ' + x + ', ' + y)
            return ex(q, 'float')
        if op == '==':
            return self.icmp('eq', a.reg, b.reg)
        if op == '!=':
            return self.icmp('ne', a.reg, b.reg)
        if op == '<':
            return self.icmp('slt', a.reg, b.reg)
        if op == '<=':
            return self.icmp('sle', a.reg, b.reg)
        if op == '>':
            return self.icmp('sgt', a.reg, b.reg)
        if op == '>=':
            return self.icmp('sge', a.reg, b.reg)
        raise CompileError('the Tomato compiler does not support the operator ' + op + ' yet', n.line)

    def call(self, n: Node, statement: bool) -> Ex:
        f = val_node(n.fields[0])
        if f.kind == 'Attr':
            target = val_node(f.fields[0])
            if target.kind == 'Name' and not (target.fields[0].text in self.slots) and self.mod.has_class(target.fields[0].text):
                return self.qualified_call(n, f, target.fields[0].text)
            return self.method_call(n, f)
        if f.kind != 'Name':
            raise CompileError('the Tomato compiler only calls plain functions yet', n.line)
        if len(n.fields[2].items) > 0:
            raise CompileError('the Tomato compiler does not support keyword arguments yet', n.line)
        name = f.fields[0].text
        args = val_nodes(n.fields[1])
        if name == 'print':
            if not statement:
                raise CompileError('print has no value', n.line)
            self.print_call(args)
            return ex('', '')
        if name == 'open':
            return self.open_call(args, n.line)
        if name == 'len':
            return self.len_call(args, n.line)
        if name == 'str':
            return self.str_call(args, n.line)
        if self.mod.has_class(name):
            return self.construct(self.mod.find_class(name, n.line), args, n.line)
        return self.call_function(self.mod.find(name, n.line), '@tomato.' + name, ex('', ''), args, n.line)

    def call_function(self, info: FuncInfo, symbol: str, receiver: Ex, args: list[Node], line: int) -> Ex:
        # a function, or a method when `receiver` holds the object; the callee only borrows its arguments
        required = len(info.ptypes) - len(info.defaults)
        if len(args) < required or len(args) > len(info.ptypes):
            raise CompileError(info.name + ' takes ' + str(len(info.ptypes)) + ' argument(s), got ' + str(len(args)), line)
        values: list[Ex] = []
        if receiver.ty != '':
            values.append(receiver)
        k = 0
        for a in args:
            v = self.expr(a, info.ptypes[k])
            self.want(v, info.ptypes[k], line, 'argument ' + str(k + 1) + ' of ' + info.name)
            values.append(v)
            k = k + 1
        while k < len(info.ptypes):             # the caller supplies the defaults it left out (D19c)
            v = self.expr(info.defaults[k - required], info.ptypes[k])
            self.want(v, info.ptypes[k], line, 'the default of argument ' + str(k + 1) + ' of ' + info.name)
            values.append(v)
            k = k + 1
        parts: list[str] = []
        for v in values:
            parts.append(llvm_type(v.ty) + ' ' + v.reg)
        text = 'call ' + self.ret_llvm(info) + ' ' + symbol + '(' + ', '.join(parts) + ')'
        result = ex('', '')
        if info.ret == '':
            self.emit(text)
        else:
            r = self.tmp('call')
            self.emit(r + ' = ' + text)
            result = ex(r, info.ret)
        self.check_error(values)
        for v in values:
            self.release(v)
        return result

    def check_error(self, values: list[Ex]):
        # an error raised by the callee is pending: drop the borrowed arguments and leave this function (D22a)
        ex1 = self.tmp('ex')
        self.emit(ex1 + ' = load ptr, ptr @tomato_exc')
        has = self.tmp('has')
        self.emit(has + ' = icmp ne ptr ' + ex1 + ', null')
        bad = self.label('raised')
        fine = self.label('fine')
        self.cond_br(has, bad, fine)
        self.place(bad)
        for v in values:
            self.release(v)
        self.br(self.unwind_target())
        self.place(fine)

    def construct(self, c: ClassInfo, args: list[Node], line: int) -> Ex:
        # Name(args): allocate, set the declared defaults, run @init (the constructor function does all three)
        ptypes: list[str] = []
        if c.init != '':
            ptypes = self.mod.find_method(c.name, c.init, line).ptypes
        defaults: list[Node] = []
        if c.init != '':
            defaults = self.mod.find_method(c.name, c.init, line).defaults
        required = len(ptypes) - len(defaults)
        if len(args) < required or len(args) > len(ptypes):
            raise CompileError(c.name + ' takes ' + str(len(ptypes)) + ' argument(s), got ' + str(len(args)), line)
        values: list[Ex] = []
        k = 0
        for a in args:
            v = self.expr(a, ptypes[k])
            self.want(v, ptypes[k], line, 'argument ' + str(k + 1) + ' of ' + c.name)
            values.append(v)
            k = k + 1
        while k < len(ptypes):
            v = self.expr(defaults[k - required], ptypes[k])
            self.want(v, ptypes[k], line, 'the default of argument ' + str(k + 1) + ' of ' + c.name)
            values.append(v)
            k = k + 1
        parts: list[str] = []
        for v in values:
            parts.append(llvm_type(v.ty) + ' ' + v.reg)
        r = self.tmp('obj')
        self.emit(r + ' = call ptr @tomato.new.' + str(self.mod.code_of('@' + c.name)) + '(' + ', '.join(parts) + ')')
        self.check_error(values)
        for v in values:
            self.release(v)
        return ex(r, '@' + c.name)

    def qualified_call(self, n: Node, f: Node, cls: str) -> Ex:
        # Class.method(self, args): the parent's version of a method, called on an object we already have (D12ao)
        info = self.mod.find_method(cls, f.fields[1].text, n.line)
        args = val_nodes(n.fields[1])
        if len(args) == 0:
            raise CompileError(cls + '.' + info.name + ' needs self as its first argument', n.line)
        obj = self.expr(args[0])
        if not self.mod.subclass(obj.ty, '@' + cls):
            raise CompileError('the first argument must be an instance of ' + cls, n.line)
        rest: list[Node] = []
        k = 0
        for a in args:
            if k > 0:
                rest.append(a)
            k = k + 1
        return self.call_function(info, '@tomato.m.' + str(self.mod.code_of('@' + info.owner)) + '.' + info.name, obj, rest, n.line)

    def method_call(self, n: Node, f: Node) -> Ex:
        name = f.fields[1].text
        obj = self.unwrap(self.expr(val_node(f.fields[0])), n.line)
        args = val_nodes(n.fields[1])
        if is_list(obj.ty) and name == 'append':
            if len(args) != 1:
                raise CompileError('append takes 1 argument, got ' + str(len(args)), n.line)
            v = self.expr(args[0], elem_of(obj.ty))
            self.want(v, elem_of(obj.ty), n.line, 'the appended item')
            slot = self.tmp('slot')
            self.emit(slot + ' = call ptr @tomato_list_push(ptr ' + obj.reg + ', i64 8)')
            self.emit('store ' + llvm_type(v.ty) + ' ' + v.reg + ', ptr ' + slot)
            self.release(obj)
            return ex('', '')
        if obj.ty == 'str':
            return self.text_method(obj, name, args, n.line)
        if obj.ty == 'File':
            return self.file_method(obj, name, args, n.line)
        if is_class(obj.ty):
            info = self.mod.find_method(obj.ty[1:], name, n.line)
            return self.call_function(info, '@tomato.m.' + str(self.mod.code_of('@' + info.owner)) + '.' + name, obj, args, n.line)
        raise CompileError('the Tomato compiler does not support the method ' + name + ' on ' + shown(obj.ty) + ' yet', n.line)

    def text_args(self, obj: Ex, name: str, args: list[Node], count: int, line: int) -> list[Ex]:
        if len(args) != count:
            raise CompileError(name + ' takes ' + str(count) + ' argument(s), got ' + str(len(args)), line)
        out: list[Ex] = []
        for a in args:
            v = self.expr(a)
            self.want(v, 'str', line, 'the argument of ' + name)
            out.append(v)
        return out

    def not_empty(self, v: Ex, name: str):
        n = self.tmp('alen')
        self.emit(n + ' = call i64 @tomato_str_len(ptr ' + v.reg + ')')
        bad = self.tmp('empty')
        self.emit(bad + ' = icmp eq i64 ' + n + ', 0')
        self.fail_if(bad, 'an empty text to ' + name + ' on is not decided')

    def text_method(self, obj: Ex, name: str, args: list[Node], line: int) -> Ex:
        if name == 'find' or name == 'startswith' or name == 'endswith':
            a = self.text_args(obj, name, args, 1, line)
            if name == 'find':
                r = self.tmp('found')
                self.emit(r + ' = call i64 @tomato_str_find(ptr ' + obj.reg + ', ptr ' + a[0].reg + ')')
                self.release(a[0])
                self.release(obj)
                return ex(r, 'int')
            c = self.tmp('c')
            self.emit(c + ' = call i32 @tomato_str_' + name + '(ptr ' + obj.reg + ', ptr ' + a[0].reg + ')')
            i1 = self.tmp('flag')
            self.emit(i1 + ' = icmp ne i32 ' + c + ', 0')
            self.release(a[0])
            self.release(obj)
            return self.bool_of(i1)
        if name == 'replace':
            a = self.text_args(obj, name, args, 2, line)
            self.not_empty(a[0], 'replace')
            r = self.tmp('replaced')
            self.emit(r + ' = call ptr @tomato_str_replace(ptr ' + obj.reg + ', ptr ' + a[0].reg + ', ptr ' + a[1].reg + ')')
            self.release(a[0])
            self.release(a[1])
            self.release(obj)
            return ex(r, 'str')
        if name == 'split':
            a = self.text_args(obj, name, args, 1, line)
            self.not_empty(a[0], 'split')
            r = self.tmp('pieces')
            self.emit(r + ' = call ptr @tomato_str_split(ptr ' + obj.reg + ', ptr ' + a[0].reg + ', i64 ' + str(self.mod.code_of('list[str]')) + ', i64 8)')
            self.release(a[0])
            self.release(obj)
            return ex(r, 'list[str]')
        if name == 'join':
            if len(args) != 1:
                raise CompileError('join takes a list[str]', line)
            lst = self.expr(args[0])
            self.want(lst, 'list[str]', line, 'the argument of join')
            r = self.tmp('joined')
            self.emit(r + ' = call ptr @tomato_str_join(ptr ' + obj.reg + ', ptr ' + lst.reg + ')')
            self.release(lst)
            self.release(obj)
            return ex(r, 'str')
        raise CompileError('the Tomato compiler does not support the text method ' + name + ' yet', line)

    def file_method(self, f: Ex, name: str, args: list[Node], line: int) -> Ex:
        if name == 'read' and len(args) == 0:
            r = self.tmp('text')
            self.emit(r + ' = call ptr @tomato_file_read(ptr ' + f.reg + ')')
            return ex(r, 'str')
        if name == 'write' and len(args) == 1:
            v = self.expr(args[0])
            self.want(v, 'str', line, 'the argument of write')
            self.emit('call void @tomato_file_write(ptr ' + f.reg + ', ptr ' + v.reg + ')')
            self.release(v)
            return ex('', '')
        if name == 'close' and len(args) == 0:
            self.emit('call void @tomato_file_close(ptr ' + f.reg + ')')
            return ex('', '')
        raise CompileError('the Tomato compiler does not support the file method ' + name + ' yet', line)

    def open_call(self, args: list[Node], line: int) -> Ex:
        if len(args) < 1 or len(args) > 2:
            raise CompileError('open(path) or open(path, mode) takes text', line)
        path = self.expr(args[0])
        self.want(path, 'str', line, 'the path')
        mode = ex(self.mod.intern('r'), 'str')
        if len(args) == 2:
            mode = self.expr(args[1])
            self.want(mode, 'str', line, 'the mode')
        r = self.tmp('file')
        self.emit(r + ' = call ptr @tomato_file_open(ptr ' + path.reg + ', ptr ' + mode.reg + ')')
        bad = self.tmp('nofile')
        self.emit(bad + ' = icmp eq ptr ' + r + ', null')
        self.release(path)
        self.release(mode)
        self.fail_if(bad, 'a file could not be opened')
        return ex(r, 'File')

    def ret_llvm(self, info: FuncInfo) -> str:
        if info.ret == '':
            return 'void'
        return llvm_type(info.ret)

    def len_call(self, args: list[Node], line: int) -> Ex:
        if len(args) != 1:
            raise CompileError('len(x) takes one argument', line)
        v = self.expr(args[0])
        r = self.tmp('len')
        if is_list(v.ty) or is_dict(v.ty):
            lenp = self.tmp('lenp')
            self.emit(lenp + ' = getelementptr { i64, i64, i64, i64, ptr }, ptr ' + v.reg + ', i32 0, i32 2')
            self.emit(r + ' = load i64, ptr ' + lenp)
        else:
            self.want(v, 'str', line, 'the argument of len')
            self.emit(r + ' = call i64 @tomato_str_len(ptr ' + v.reg + ')')
        self.release(v)
        return ex(r, 'int')

    def str_call(self, args: list[Node], line: int) -> Ex:
        if len(args) != 1:
            raise CompileError('str(x) takes one argument', line)
        v = self.expr(args[0])
        if v.ty == 'str':
            return v
        r = self.tmp('text')
        if v.ty == 'int':
            self.emit(r + ' = call ptr @tomato_str_from_i64(i64 ' + v.reg + ')')
        elif v.ty == 'float':
            self.emit(r + ' = call ptr @tomato_str_from_f64(double ' + v.reg + ')')
        else:
            w = self.tmp('w')
            self.emit(w + ' = trunc i64 ' + v.reg + ' to i32')
            self.emit(r + ' = call ptr @tomato_str_from_bool(i32 ' + w + ')')
        return ex(r, 'str')

    def print_call(self, args: list[Node]):
        values: list[Ex] = []
        for a in args:
            v = self.expr(a)                   # every argument is evaluated before anything is printed
            if is_list(v.ty):
                raise CompileError('the Tomato compiler does not print lists yet', a.line)
            values.append(v)
        k = 0
        for v in values:
            if v.ty == 'int':
                self.emit('call i32 (ptr, ...) @printf(ptr @.fmt.int, i64 ' + v.reg + ')')
            elif v.ty == 'bool':
                w = self.tmp('w')
                self.emit(w + ' = trunc i64 ' + v.reg + ' to i32')
                t = self.tmp('text')
                self.emit(t + ' = call ptr @tomato_str_from_bool(i32 ' + w + ')')
                self.emit('call void @tomato_print_strobj(ptr ' + t + ')')
                self.emit('call void @tomato_release(ptr ' + t + ')')
            elif v.ty == 'float':
                t = self.tmp('text')
                self.emit(t + ' = call ptr @tomato_str_from_f64(double ' + v.reg + ')')
                self.emit('call void @tomato_print_strobj(ptr ' + t + ')')
                self.emit('call void @tomato_release(ptr ' + t + ')')
            else:
                self.emit('call void @tomato_print_strobj(ptr ' + v.reg + ')')
                self.release(v)
            if k < len(values) - 1:
                self.emit('call i32 @putchar(i32 32)')
            k = k + 1
        self.emit('call i32 @putchar(i32 10)')

    # ---- statements
    def block(self, body: list[Node]):
        for s in body:
            self.stmt(s)

    def push_loop(self, brk: str, cont: str):
        if self.loop_depth < len(self.breaks):
            self.breaks[self.loop_depth] = brk
            self.conts[self.loop_depth] = cont
        else:
            self.breaks.append(brk)
            self.conts.append(cont)
        self.loop_depth = self.loop_depth + 1

    def stmt(self, s: Node):
        k = s.kind
        if k == 'ExprStmt':
            e = val_node(s.fields[0])
            if e.kind != 'Call':
                raise CompileError('the Tomato compiler only runs calls as statements yet', s.line)
            result = self.call(e, True)
            self.release(result)               # a value nobody keeps is released at once
        elif k == 'Assign':
            target = val_node(s.fields[0])
            if target.kind == 'Index':
                self.assign_item(s, target)
                return
            if target.kind == 'Attr':
                self.assign_field(s, target)
                return
            if target.kind != 'Name':
                raise CompileError('the Tomato compiler can only assign to a variable or a list item yet', s.line)
            name = target.fields[0].text
            expected = ''
            if name in self.slots:
                expected = self.types[name]
            v = self.expr(val_node(s.fields[1]), expected)
            slot_type = v.ty
            if name in self.slots:
                self.want(v, self.types[name], s.line, 'the assigned value')
                slot_type = self.types[name]
            if slot_type == 'None' or slot_type == '':
                raise CompileError('the type of ' + name + ' needs a declaration: ' + name + ': Item | None = None', s.line)
            self.store_owned(self.slot(name, slot_type, s.line), v)
        elif k == 'Declare':
            ty = self.mod.type_name(s.fields[1])
            if ty == '':
                raise CompileError('the Tomato compiler only declares int, bool, str and list variables yet', s.line)
            v = self.expr(val_node(s.fields[2]), ty)
            self.want(v, ty, s.line, 'the value')
            self.store_owned(self.slot(s.fields[0].text, ty, s.line), v)
        elif k == 'Return':
            if s.fields[0].tag == 'z':
                if self.ret != '':
                    raise CompileError('this function must return a ' + self.ret, s.line)
            else:
                if self.ret == '':
                    raise CompileError('this function returns no value', s.line)
                v = self.expr(val_node(s.fields[0]), self.ret)
                self.want(v, self.ret, s.line, 'the returned value')
                self.emit('store ' + llvm_type(v.ty) + ' ' + v.reg + ', ptr %retval')
            self.run_finallies(self.try_depth)
            self.br('epilogue')
        elif k == 'Raise':
            v = self.expr(val_node(s.fields[0]))
            if not self.mod.subclass(v.ty, '@Error'):
                raise CompileError('raise needs an Error object, found ' + shown(v.ty), s.line)
            self.emit('store ptr ' + v.reg + ', ptr @tomato_exc')            # the pending error owns the reference
            self.emit('store i32 ' + str(s.line) + ', ptr @tomato_exc_line')
            self.emit('store i32 0, ptr @tomato_exc_rt')
            self.emit('store i32 1, ptr @tomato_exc_seen')
            self.br(self.unwind_target())
        elif k == 'Try':
            self.try_stmt(s)
        elif k == 'If':
            self.if_stmt(s)
        elif k == 'While':
            self.while_stmt(s)
        elif k == 'For':
            self.for_stmt(s)
        elif k == 'Break':
            if self.loop_depth == 0:
                raise CompileError('break outside a loop', s.line)
            self.run_finallies(self.tries_in_loop())
            self.br(self.breaks[self.loop_depth - 1])
        elif k == 'Continue':
            if self.loop_depth == 0:
                raise CompileError('continue outside a loop', s.line)
            self.run_finallies(self.tries_in_loop())
            self.br(self.conts[self.loop_depth - 1])
        elif k == 'Pass':
            pass
        else:
            raise CompileError('the Tomato compiler does not support ' + k + ' statements yet', s.line)

    def tries_in_loop(self) -> int:
        # how many of the innermost try statements sit inside the current loop
        n = 0
        k = self.try_depth
        while k > 0 and self.tries[k - 1].loop_depth == self.loop_depth:
            n = n + 1
            k = k - 1
        return n

    def run_finallies(self, n: int):
        # run the finally blocks of the n innermost try statements, innermost first: a return, break or continue is
        # leaving them. A raise inside one of these blocks goes to the handlers outside its try (D22a).
        saved = self.try_depth
        k = saved - 1
        while k >= saved - n:
            if self.tries[k].has_final:
                self.try_depth = k
                self.block(self.tries[k].final)
            k = k - 1
        self.try_depth = saved

    def push_try(self, info: TryInfo):
        if self.try_depth < len(self.tries):
            self.tries[self.try_depth] = info
        else:
            self.tries.append(info)
        self.try_depth = self.try_depth + 1

    def try_stmt(self, s: Node):
        handlers = s.fields[1].items
        for h in handlers:
            cname = h.items[0].text
            if not self.mod.has_class(cname) or not self.mod.subclass('@' + cname, '@Error'):
                raise CompileError('catch needs an error class (a subclass of Error), found ' + cname, s.line)
        info = TryInfo()
        info.catch_l = self.label('catch')
        info.prop_l = self.label('prop')
        info.has_final = s.fields[3].tag == 'l'
        if info.has_final:
            info.final = val_nodes(s.fields[3])
        info.loop_depth = self.loop_depth
        else_l = self.label('tryelse')
        handled_l = self.label('tryhandled')
        end_l = self.label('tryend')
        self.push_try(info)
        self.block(val_nodes(s.fields[0]))
        if not self.terminated:
            self.br(else_l)
        # an error raised in the body arrives here with the pending error set
        self.place(info.catch_l)
        info.state = 'post'
        pending = self.tmp('ex')
        self.emit(pending + ' = load ptr, ptr @tomato_exc')
        tp = self.tmp('tp')
        self.emit(tp + ' = getelementptr { i64, i64 }, ptr ' + pending + ', i32 0, i32 1')
        raw = self.tmp('rawcode')
        self.emit(raw + ' = load i64, ptr ' + tp)
        code = self.tmp('code')
        self.emit(code + ' = and i64 ' + raw + ', 4294967295')
        for h in handlers:
            cname = h.items[0].text
            isa = self.tmp('isa')
            self.emit(isa + ' = call i32 @tomato_is_subclass(i64 ' + code + ', i64 ' + str(self.mod.code_of('@' + cname)) + ')')
            hit = self.tmp('hit')
            self.emit(hit + ' = icmp ne i32 ' + isa + ', 0')
            match = self.label('match')
            nxt = self.label('nomatch')
            self.cond_br(hit, match, nxt)
            self.place(match)
            self.emit('store ptr null, ptr @tomato_exc')             # handled: the catch variable takes the reference
            if h.items[1].tag == 's':
                var = h.items[1].text
                reg = ''
                if var in self.slots and self.types[var] != '@' + cname:
                    reg = self.new_slot(var, '@' + cname)     # the name is bound again, to a new slot of the new type
                else:
                    reg = self.slot(var, '@' + cname, s.line)
                self.store_owned(reg, ex(pending, '@' + cname))
            else:
                self.emit('call void @tomato_release(ptr ' + pending + ')')
            self.block(val_nodes(h.items[2]))
            if not self.terminated:
                self.br(handled_l)
            self.place(nxt)
        self.br(info.prop_l)                                          # no clause matched: keep propagating
        self.place(else_l)
        if s.fields[2].tag == 'l':
            self.block(val_nodes(s.fields[2]))
        if not self.terminated:
            self.br(handled_l)
        # every normal way out of the statement runs the finally block once
        self.place(handled_l)
        self.try_depth = self.try_depth - 1
        if info.has_final:
            self.block(info.final)
        if not self.terminated:
            self.br(end_l)
        # an error is leaving the statement: park it while the finally block runs, then keep propagating
        self.place(info.prop_l)
        if info.has_final:
            hold = self.tmp('hold')
            self.allocas.append('  ' + hold + ' = alloca ptr')
            held = self.tmp('pending')
            self.emit(held + ' = load ptr, ptr @tomato_exc')
            self.emit('store ptr ' + held + ', ptr ' + hold)
            self.emit('store ptr null, ptr @tomato_exc')
            self.block(info.final)
            back = self.tmp('back')
            self.emit(back + ' = load ptr, ptr ' + hold)
            self.emit('store ptr ' + back + ', ptr @tomato_exc')
        self.br(self.unwind_target())
        self.place(end_l)

    def assign_item(self, s: Node, target: Node):
        lst = self.unwrap(self.expr(val_node(target.fields[0])), s.line)
        if is_dict(lst.ty):
            k = self.expr(val_node(target.fields[1]))
            self.want(k, 'str', s.line, 'a dict key')
            dv = self.expr(val_node(s.fields[1]), dict_value(lst.ty))
            self.want(dv, dict_value(lst.ty), s.line, 'the assigned value')
            slot = self.tmp('slot')
            self.emit(slot + ' = call ptr @tomato_dict_insert(ptr ' + lst.reg + ', i64 ' + self.key_word(k) + ', i32 0)')
            self.store_owned(slot, dv)
            self.release(k)
            self.release(lst)
            return
        if not is_list(lst.ty):
            raise CompileError('only list and dict items can be assigned by index', s.line)
        i = self.expr(val_node(target.fields[1]))
        self.want(i, 'int', s.line, 'an index')
        v = self.expr(val_node(s.fields[1]), elem_of(lst.ty))
        self.want(v, elem_of(lst.ty), s.line, 'the assigned item')
        addr = self.list_slot(lst, i)
        if is_rc(v.ty):
            old = self.tmp('old')
            self.emit(old + ' = load ptr, ptr ' + addr)
            self.emit('store ptr ' + v.reg + ', ptr ' + addr)
            self.emit('call void @tomato_release(ptr ' + old + ')')
        else:
            self.emit('store i64 ' + v.reg + ', ptr ' + addr)
        self.release(lst)

    def if_stmt(self, s: Node):
        end = self.label('endif')
        for branch in s.fields[0].items:
            cond = self.truth(self.expr(val_node(branch.items[0])), s.line)
            then = self.label('then')
            nxt = self.label('next')
            self.cond_br(cond, then, nxt)
            self.place(then)
            self.block(val_nodes(branch.items[1]))
            if not self.terminated:
                self.br(end)
            self.place(nxt)
        if s.fields[1].tag == 'l':
            self.block(val_nodes(s.fields[1]))
        if not self.terminated:
            self.br(end)
        self.place(end)

    def while_stmt(self, s: Node):
        head = self.label('while')
        body = self.label('body')
        end = self.label('endwhile')
        self.br(head)
        self.place(head)
        cond = self.truth(self.expr(val_node(s.fields[0])), s.line)
        self.cond_br(cond, body, end)
        self.place(body)
        self.push_loop(end, head)
        self.block(val_nodes(s.fields[1]))
        self.loop_depth = self.loop_depth - 1
        if not self.terminated:
            self.br(head)
        self.place(end)

    def for_each(self, s: Node, it: Node):
        lst = self.expr(it)
        if not is_list(lst.ty):
            raise CompileError('the Tomato compiler only loops over range() and lists yet', s.line)
        elem = elem_of(lst.ty)
        holder = self.hidden_rc_slot('for.list')
        self.store_owned(holder, lst)
        counter = self.hidden_slot('for.i')
        self.emit('store i64 0, ptr ' + counter)
        var = self.slot(s.fields[0].text, elem, s.line)
        head = self.label('each')
        body = self.label('eachbody')
        step = self.label('eachstep')
        end = self.label('endeach')
        self.br(head)
        self.place(head)
        l = self.tmp('lst')
        self.emit(l + ' = load ptr, ptr ' + holder)
        i = self.tmp('i')
        self.emit(i + ' = load i64, ptr ' + counter)
        lenp = self.tmp('lenp')
        self.emit(lenp + ' = getelementptr { i64, i64, i64, i64, ptr }, ptr ' + l + ', i32 0, i32 2')
        ln = self.tmp('n')
        self.emit(ln + ' = load i64, ptr ' + lenp)
        go = self.tmp('go')
        self.emit(go + ' = icmp slt i64 ' + i + ', ' + ln)
        self.cond_br(go, body, end)
        self.place(body)
        addr = self.list_slot(ex(l, lst.ty), ex(i, 'int'))
        item = self.tmp('item')
        self.emit(item + ' = load ' + llvm_type(elem) + ', ptr ' + addr)
        e = ex(item, elem)
        self.retain(e)
        self.store_owned(var, e)
        self.push_loop(end, step)
        self.block(val_nodes(s.fields[2]))
        self.loop_depth = self.loop_depth - 1
        if not self.terminated:
            self.br(step)
        self.place(step)
        cur = self.tmp('cur')
        self.emit(cur + ' = load i64, ptr ' + counter)
        nxt = self.tmp('next')
        self.emit(nxt + ' = add i64 ' + cur + ', 1')
        self.emit('store i64 ' + nxt + ', ptr ' + counter)
        self.br(head)
        self.place(end)

    def for_stmt(self, s: Node):
        it = val_node(s.fields[1])
        if not (it.kind == 'Call' and val_node(it.fields[0]).kind == 'Name' and val_node(it.fields[0]).fields[0].text == 'range'):
            self.for_each(s, it)
            return
        if it.kind != 'Call' or val_node(it.fields[0]).kind != 'Name' or val_node(it.fields[0]).fields[0].text != 'range':
            raise CompileError('the Tomato compiler only loops over range() yet', s.line)
        bounds = val_nodes(it.fields[1])
        if len(bounds) != 1 and len(bounds) != 2:
            raise CompileError('the Tomato compiler supports range(stop) and range(start, stop) yet', s.line)
        start = '0'
        stop = ''
        if len(bounds) == 1:
            e = self.expr(bounds[0])
            self.want(e, 'int', s.line, 'a range bound')
            stop = e.reg
        else:
            a = self.expr(bounds[0])
            b = self.expr(bounds[1])
            self.want(a, 'int', s.line, 'a range bound')
            self.want(b, 'int', s.line, 'a range bound')
            start = a.reg
            stop = b.reg
        var = self.slot(s.fields[0].text, 'int', s.line)
        counter = self.hidden_slot('for.i')
        limit = self.hidden_slot('for.n')
        self.emit('store i64 ' + start + ', ptr ' + counter)
        self.emit('store i64 ' + stop + ', ptr ' + limit)
        head = self.label('for')
        body = self.label('forbody')
        step = self.label('forstep')
        end = self.label('endfor')
        self.br(head)
        self.place(head)
        i = self.tmp('i')
        self.emit(i + ' = load i64, ptr ' + counter)
        lim = self.tmp('lim')
        self.emit(lim + ' = load i64, ptr ' + limit)
        c = self.tmp('go')
        self.emit(c + ' = icmp slt i64 ' + i + ', ' + lim)
        self.cond_br(c, body, end)
        self.place(body)
        self.emit('store i64 ' + i + ', ptr ' + var)
        self.push_loop(end, step)
        self.block(val_nodes(s.fields[2]))
        self.loop_depth = self.loop_depth - 1
        if not self.terminated:
            self.br(step)
        self.place(step)
        cur = self.tmp('cur')
        self.emit(cur + ' = load i64, ptr ' + counter)
        nxt = self.tmp('next')
        self.emit(nxt + ' = add i64 ' + cur + ', 1')
        self.emit('store i64 ' + nxt + ', ptr ' + counter)
        self.br(head)
        self.place(end)

def function_symbol(mod: Mod, info: FuncInfo) -> str:
    if info.owner == '':
        return '@tomato.' + info.name
    return '@tomato.m.' + str(mod.code_of('@' + info.owner)) + '.' + info.name

def finish_function(g: Gen, symbol: str, sig: list[str], ret: str) -> str:
    # the epilogue releases every slot that owns a heap value, then returns the stored result
    g.lines.append('epilogue:')
    for reg in g.rc_slots:
        o = g.tmp('rel')
        g.lines.append('  ' + o + ' = load ptr, ptr ' + reg)
        g.lines.append('  call void @tomato_release(ptr ' + o + ')')
    llvm_ret = 'void'
    if ret != '':
        llvm_ret = llvm_type(ret)
        r = g.tmp('ret')
        g.lines.append('  ' + r + ' = load ' + llvm_ret + ', ptr %retval')
        g.lines.append('  ret ' + llvm_ret + ' ' + r)
    else:
        g.lines.append('  ret void')
    text = 'define ' + llvm_ret + ' ' + symbol + '(' + ', '.join(sig) + ') {\nentry:\n'
    if ret != '':
        text = text + '  %retval = alloca ' + llvm_ret + '\n  store ' + llvm_ret + ' ' + zero_of(ret) + ', ptr %retval\n'
    if len(g.allocas) > 0:
        text = text + '\n'.join(g.allocas) + '\n'
    text = text + '\n'.join(g.lines) + '\n}\n'
    return text

def compile_function(f: Node, mod: Mod, info: FuncInfo) -> str:
    g = Gen()
    g.mod = mod
    g.ret = info.ret
    params = val_nodes(f.fields[1])
    names: list[str] = []
    types: list[str] = []
    k = 0
    for p in params:
        if p.fields[0].text == 'self':
            if info.owner == '':
                raise CompileError('self is only for methods', p.line)
            names.append('self')
            types.append('@' + info.owner)
        else:
            names.append(p.fields[0].text)
            types.append(info.ptypes[k])
            k = k + 1
    sig: list[str] = []
    k = 0
    for name in names:
        reg = g.slot(name, types[k], f.line)
        sig.append(llvm_type(types[k]) + ' %arg.' + name)
        g.emit('store ' + llvm_type(types[k]) + ' %arg.' + name + ', ptr ' + reg)
        if is_rc(types[k]):
            g.emit('call void @tomato_retain(ptr %arg.' + name + ')')    # the caller only lent it
        k = k + 1
    g.block(val_nodes(f.fields[3]))
    if not g.terminated:
        if info.ret == '':
            g.br('epilogue')
        else:
            g.emit('call void @tomato_fail(ptr ' + mod.intern('the function ended without returning a value') + '.c)')
            g.emit('unreachable')
            g.terminated = True
    return finish_function(g, function_symbol(mod, info), sig, info.ret)

def compile_constructor(c: ClassInfo, mod: Mod) -> str:
    # allocate, store the declared field defaults, then run @init
    g = Gen()
    g.mod = mod
    code = str(mod.code_of('@' + c.name))
    ptypes: list[str] = []
    if c.init != '':
        ptypes = mod.find_method(c.name, c.init, c.line).ptypes
    sig: list[str] = []
    k = 0
    for t in ptypes:
        sig.append(llvm_type(t) + ' %arg.' + str(k))
        k = k + 1
    size = g.tmp('size')
    g.emit(size + ' = ptrtoint ptr getelementptr (%class.' + code + ', ptr null, i32 1) to i64')
    obj = g.tmp('obj')
    g.emit(obj + ' = call ptr @tomato_alloc(i64 ' + size + ', i64 ' + code + ')')
    d = 0
    k = 0
    for name in c.fnames:
        if c.has_default[k]:
            v = g.expr(c.defaults[d], c.ftypes[k])
            g.want(v, c.ftypes[k], c.line, 'the default of field ' + name)
            addr = g.tmp('fld')
            g.emit(addr + ' = getelementptr %class.' + code + ', ptr ' + obj + ', i32 0, i32 ' + str(k + 2))
            g.emit('store ' + llvm_type(v.ty) + ' ' + v.reg + ', ptr ' + addr)
            d = d + 1
        k = k + 1
    if c.init != '':
        parts: list[str] = ['ptr ' + obj]
        k = 0
        for t in ptypes:
            parts.append(llvm_type(t) + ' %arg.' + str(k))
            k = k + 1
        g.emit('call void @' + 'tomato.m.' + str(mod.code_of('@' + mod.find_method(c.name, c.init, c.line).owner)) + '.' + c.init + '(' + ', '.join(parts) + ')')
        pending = g.tmp('ex')
        g.emit(pending + ' = load ptr, ptr @tomato_exc')
        has = g.tmp('has')
        g.emit(has + ' = icmp ne ptr ' + pending + ', null')
        bad = g.label('initfailed')
        ok = g.label('initok')
        g.cond_br(has, bad, ok)
        g.place(bad)
        g.emit('call void @tomato_release(ptr ' + obj + ')')          # an @init that raised leaves no object behind
        g.br('epilogue')
        g.place(ok)
    g.emit('store ptr ' + obj + ', ptr %retval')
    g.br('epilogue')
    return finish_function(g, '@tomato.new.' + code, sig, '@' + c.name)

def class_types(mod: Mod) -> str:
    # one struct type per class: the reference count and type code, then the fields
    t = ''
    for c in mod.classes:
        parts = new_strs()
        parts.append('i64')
        parts.append('i64')
        for ft in c.ftypes:
            parts.append(llvm_type(ft))
        t = t + '%class.' + str(mod.code_of('@' + c.name)) + ' = type { ' + ', '.join(parts) + ' }\n'
    return t

def int_of_bool(b: bool) -> int:
    if b:
        return 1
    return 0

def runtime_tables(mod: Mod) -> str:
    n = len(mod.codes) + 2
    names = new_strs()
    zeros = new_strs()
    kinds = new_strs()
    offsets = new_strs()
    extra = ''
    for k in range(n):
        names.append('ptr null')
        zeros.append('i64 0')
        offsets.append('ptr null')
        kinds.append('i32 0')
    k = 0
    for code in mod.codes:
        slot = k + 2
        if is_class(code):
            c = mod.find_class(code[1:], 0)
            kinds[slot] = 'i32 1'
            if c.parent != '':
                zeros[slot] = 'i64 ' + str(mod.code_of('@' + c.parent))
            offs = new_strs()
            j = 0
            for ft in c.ftypes:
                if is_rc(ft):
                    offs.append('i32 trunc (i64 ptrtoint (ptr getelementptr (%class.' + str(slot) + ', ptr null, i32 0, i32 ' + str(j + 2) + ') to i64) to i32)')
                j = j + 1
            offs.append('i32 -1')
            extra = extra + '@tomato.offs.' + str(slot) + ' = constant [' + str(len(offs)) + ' x i32] [' + ', '.join(offs) + ']\n'
            offsets[slot] = 'ptr @tomato.offs.' + str(slot)
            extra = extra + '@tomato.name.' + str(slot) + ' = private constant [' + str(len(c.name) + 1) + ' x i8] c"' + c.name + '\\00"\n'
            names[slot] = 'ptr @tomato.name.' + str(slot)
        elif is_dict(code):
            kinds[slot] = 'i32 ' + str(3 + 256 + 512 * int_of_bool(is_rc(dict_value(code))))    # a table with text keys
        elif elem_of(code) == 'str' or is_rc(elem_of(code)):
            kinds[slot] = 'i32 258'          # a list: 2, plus 256 when its items are reference counted
        else:
            kinds[slot] = 'i32 2'
        k = k + 1
    count = str(n)
    t = '@tomato_exc = global ptr null\n'
    t = t + '@tomato_exc_line = global i32 0\n'
    t = t + '@tomato_exc_rt = global i32 0\n'
    t = t + '@tomato_exc_seen = global i32 0\n'
    t = t + extra
    t = t + '@tomato_class_names = constant [' + count + ' x ptr] [' + ', '.join(names) + ']\n'
    t = t + '@tomato_parents = global [' + count + ' x i64] [' + ', '.join(zeros) + ']\n'
    t = t + '@tomato_kinds = constant [' + count + ' x i32] [' + ', '.join(kinds) + ']\n'
    t = t + '@tomato_offsets = constant [' + count + ' x ptr] [' + ', '.join(offsets) + ']\n'
    return t

def declarations() -> str:
    d = 'declare i32 @printf(ptr, ...)\n'
    d = d + 'declare i32 @putchar(i32)\n'
    d = d + 'declare void @tomato_fail(ptr)\n'
    d = d + 'declare void @tomato_leak_check()\n'
    d = d + 'declare void @tomato_retain(ptr)\n'
    d = d + 'declare void @tomato_release(ptr)\n'
    d = d + 'declare ptr @tomato_str_concat(ptr, ptr)\n'
    d = d + 'declare ptr @tomato_str_from_cstr(ptr)\n'
    d = d + 'declare i64 @tomato_str_len(ptr)\n'
    d = d + 'declare i32 @tomato_str_cmp(ptr, ptr)\n'
    d = d + 'declare ptr @tomato_str_index(ptr, i64)\n'
    d = d + 'declare ptr @tomato_str_slice(ptr, i64, i64)\n'
    d = d + 'declare ptr @tomato_str_from_i64(i64)\n'
    d = d + 'declare ptr @tomato_str_from_bool(i32)\n'
    d = d + 'declare ptr @tomato_str_from_f64(double)\n'
    d = d + 'declare double @tomato_parse_f64(ptr, i32)\n'
    d = d + 'declare void @tomato_print_strobj(ptr)\n'
    d = d + 'declare ptr @tomato_alloc(i64, i64)\n'
    d = d + 'declare i32 @tomato_is_subclass(i64, i64)\n'
    d = d + 'declare ptr @tomato_dict_new(i64, i64, i32)\n'
    d = d + 'declare ptr @tomato_dict_find(ptr, i64)\n'
    d = d + 'declare ptr @tomato_dict_insert(ptr, i64, i32)\n'
    d = d + 'declare void @tomato_usage(i32, i32)\n'
    d = d + 'declare i64 @tomato_parse_i64(ptr, i32)\n'
    d = d + 'declare i32 @tomato_parse_bool(ptr, i32)\n'
    d = d + 'declare void @tomato_report_uncaught(ptr, i32, i32, i32)\n'
    d = d + 'declare i64 @tomato_str_find(ptr, ptr)\n'
    d = d + 'declare i32 @tomato_str_startswith(ptr, ptr)\n'
    d = d + 'declare i32 @tomato_str_endswith(ptr, ptr)\n'
    d = d + 'declare i32 @tomato_str_contains(ptr, ptr)\n'
    d = d + 'declare ptr @tomato_str_replace(ptr, ptr, ptr)\n'
    d = d + 'declare ptr @tomato_str_split(ptr, ptr, i64, i64)\n'
    d = d + 'declare ptr @tomato_str_join(ptr, ptr)\n'
    d = d + 'declare ptr @tomato_file_open(ptr, ptr)\n'
    d = d + 'declare ptr @tomato_file_read(ptr)\n'
    d = d + 'declare void @tomato_file_write(ptr, ptr)\n'
    d = d + 'declare void @tomato_file_close(ptr)\n'
    d = d + 'declare ptr @tomato_list_new(i64)\n'
    d = d + 'declare ptr @tomato_list_push(ptr, i64)\n'
    d = d + '@.fmt.int = private constant [5 x i8] c"%lld\\00"\n'
    return d

def literal_text(n: Node, ty: str) -> str:
    # the IR constant for a default written as a plain literal (entry point inputs)
    if ty == 'int' and n.kind == 'IntLit':
        return str(n.fields[0].num)
    if ty == 'bool' and n.kind == 'BoolLit':
        if n.fields[0].flag:
            return '1'
        return '0'
    raise CompileError('the Tomato compiler reads an entry point default only as an int or bool literal yet', n.line)

def entry_wrapper(info: FuncInfo, mod: Mod) -> str:
    # main(): read the command-line inputs, run the entry point, report an error nobody caught (D28a, D22a)
    k = len(info.ptypes)
    low = k - len(info.defaults)
    out = 'define i32 @main(i32 %argc, ptr %argv) {\nentry:\n  %n = sub i32 %argc, 1\n'
    out = out + '  %lo = icmp sge i32 %n, ' + str(low) + '\n  %hi = icmp sle i32 %n, ' + str(k) + '\n  %ok = and i1 %lo, %hi\n'
    out = out + '  br i1 %ok, label %go, label %bad\n'
    out = out + 'bad:\n  call void @tomato_usage(i32 ' + str(k) + ', i32 %n)\n  unreachable\ngo:\n'
    args = new_strs()
    owned = new_strs()
    i = 0
    for t in info.ptypes:
        si = str(i)
        optional = i >= low
        if optional:
            out = out + '  %has' + si + ' = icmp sgt i32 %n, ' + si + '\n  br i1 %has' + si + ', label %p' + si + ', label %d' + si + '\np' + si + ':\n'
        out = out + '  %a' + si + '.ptr = getelementptr ptr, ptr %argv, i64 ' + str(i + 1) + '\n'
        out = out + '  %a' + si + '.s = load ptr, ptr %a' + si + '.ptr\n'
        reg = '%a' + si
        if t == 'str':
            out = out + '  %a' + si + '.v = call ptr @tomato_str_from_cstr(ptr %a' + si + '.s)\n'
        elif t == 'int':
            out = out + '  %a' + si + '.v = call i64 @tomato_parse_i64(ptr %a' + si + '.s, i32 ' + str(i + 1) + ')\n'
        elif t == 'float':
            out = out + '  %a' + si + '.v = call double @tomato_parse_f64(ptr %a' + si + '.s, i32 ' + str(i + 1) + ')\n'
        elif t == 'bool':
            out = out + '  %a' + si + '.w = call i32 @tomato_parse_bool(ptr %a' + si + '.s, i32 ' + str(i + 1) + ')\n'
            out = out + '  %a' + si + '.v = zext i32 %a' + si + '.w to i64\n'
        else:
            raise CompileError('the Tomato compiler reads entry point inputs of type int, bool and str only', 0)
        if optional:
            dflt = info.defaults[i - low]
            out = out + '  br label %m' + si + '\nd' + si + ':\n  br label %m' + si + '\nm' + si + ':\n'
            if t == 'str':
                if dflt.kind != 'StrLit':
                    raise CompileError('the Tomato compiler reads a text entry point default only as a text literal yet', dflt.line)
                out = out + '  %a' + si + ' = phi ptr [ %a' + si + '.v, %p' + si + ' ], [ ' + mod.intern(dflt.fields[0].text) + ', %d' + si + ' ]\n'
            elif t == 'float':
                raise CompileError('the Tomato compiler does not read a float entry point default yet', dflt.line)
            else:
                out = out + '  %a' + si + ' = phi i64 [ %a' + si + '.v, %p' + si + ' ], [ ' + literal_text(dflt, t) + ', %d' + si + ' ]\n'
        else:
            reg = '%a' + si + '.v'
        if t == 'str':
            args.append('ptr ' + reg)
            owned.append(reg)
        elif t == 'float':
            args.append('double ' + reg)
        else:
            args.append('i64 ' + reg)
        i = i + 1
    out = out + '  call void @tomato.' + info.name + '(' + ', '.join(args) + ')\n'
    out = out + '  %ex = load ptr, ptr @tomato_exc\n  %has = icmp ne ptr %ex, null\n  br i1 %has, label %uncaught, label %fine\n'
    out = out + 'uncaught:\n  %eline = load i32, ptr @tomato_exc_line\n  %ert = load i32, ptr @tomato_exc_rt\n'
    out = out + '  call void @tomato_report_uncaught(ptr %ex, i32 %eline, i32 %ert, i32 1)\n  unreachable\n'
    out = out + 'fine:\n'
    for reg in owned:
        out = out + '  call void @tomato_release(ptr ' + reg + ')\n'
    out = out + '  call void @tomato_leak_check()\n  ret i32 0\n}\n'
    return out

def function_info(item: Node, mod: Mod, owner: str) -> FuncInfo:
    info = FuncInfo()
    info.name = item.fields[0].text
    info.owner = owner
    if item.fields[2].tag != 'z':
        info.ret = mod.type_name(item.fields[2])
        if info.ret == '':
            raise CompileError('the Tomato compiler only returns int, bool, str, list and class values yet', item.line)
    for p in val_nodes(item.fields[1]):
        if p.fields[0].text == 'self' and owner != '':
            continue
        if p.fields[3].tag != 'z':
            raise CompileError('the Tomato compiler does not support *args or **kwargs yet', p.line)
        if p.fields[2].tag == 'n':
            info.defaults.append(val_node(p.fields[2]))
        pt = mod.type_name(p.fields[1])
        if pt == '':
            raise CompileError('the Tomato compiler only takes int, bool, str, list and class parameters yet', p.line)
        info.ptypes.append(pt)
    return info

def builtin_source() -> str:
    # the names every program can use without importing them (D22a): the same text as tomato/std/builtin.tom
    t = 'class Error:\n    message: str\n\n    @init\n    def start(self, message: str):\n        self.message = message\n\n'
    t = t + 'class RuntimeError(Error):\n    @init\n    def make(self, message: str):\n        Error.start(self, message)\n\n'
    t = t + 'class IOError(RuntimeError):\n    @init\n    def make_io(self, message: str):\n        RuntimeError.make(self, message)\n'
    return t

def class_node(items: list[Node], name: str) -> Node:
    for item in items:
        if item.kind == 'ClassDef' and item.fields[0].text == name:
            return item
    raise CompileError('unknown class ' + name, 0)

def resolve_class(mod: Mod, items: list[Node], name: str):
    # fill a class's fields and defaults, its parent's first (a field may name a class declared later)
    c = mod.find_class(name, 0)
    if c.done:
        return
    c.done = True
    node = class_node(items, name)
    if c.parent != '':
        if not mod.has_class(c.parent):
            raise CompileError('unknown parent class ' + c.parent, node.line)
        resolve_class(mod, items, c.parent)
        p = mod.find_class(c.parent, node.line)
        for fname in p.fnames:
            c.fnames.append(fname)
        for ftype in p.ftypes:
            c.ftypes.append(ftype)
        for flag in p.has_default:
            c.has_default.append(flag)
        for dnode in p.defaults:
            c.defaults.append(dnode)
    for fd in val_nodes(node.fields[3]):
        ft = mod.type_name(fd.fields[1])
        if ft == '':
            raise CompileError('the Tomato compiler only supports int, bool, str, list and class fields yet', fd.line)
        c.fnames.append(fd.fields[0].text)
        c.ftypes.append(ft)
        c.has_default.append(fd.fields[4].tag == 'n')
        if fd.fields[4].tag == 'n':
            c.defaults.append(val_node(fd.fields[4]))

def read_module(dir: str, name: str, line: int) -> str:
    f = open(dir + name + '.tom')
    text = f.read()
    f.close()
    return text

def load_items(dir: str, src: str, items: list[Node], loaded: list[str], names: list[str]) -> list[Node]:
    # the declarations of src with the declarations of the modules it imports placed before them (each once)
    mine = val_nodes(parse(src).fields[0])
    for item in mine:
        if item.kind == 'Import':
            module = item.fields[0].text
            if not (module in loaded):
                loaded.append(module)
                load_items(dir, read_module(dir, module, item.line), items, loaded, names)
    own: list[Node] = []
    for item in mine:
        if item.kind != 'Import':
            own.append(item)
            if item.kind == 'FuncDef' or item.kind == 'ClassDef':
                name = item.fields[0].text
                if name in names:
                    raise CompileError(name + ' is declared in more than one module (the Tomato compiler has no module namespaces yet)', item.line)
                names.append(name)
    for item in own:
        items.append(item)
    return own

export def compile_module(src: str, dir: str, entry_name: str) -> str:
    mod = Mod()
    items = val_nodes(parse(builtin_source()).fields[0])
    names = new_strs()
    loaded = new_strs()
    for b in items:
        names.append(b.fields[0].text)
    user = load_items(dir, src, items, loaded, names)
    for item in items:
        if item.kind == 'ClassDef':
            if len(item.fields[2].items) > 0:
                raise CompileError('the Tomato compiler does not support interfaces yet', item.line)
            c = ClassInfo()
            c.name = item.fields[0].text
            c.line = item.line
            if item.fields[1].tag == 's':
                c.parent = item.fields[1].text
            mod.classes.append(c)
    for c in mod.classes:
        resolve_class(mod, items, c.name)
    funcs: list[Node] = []
    entry = ''
    for item in items:
        if item.kind == 'FuncDef':
            info = function_info(item, mod, '')
            mod.infos.append(info)
            funcs.append(item)
        elif item.kind == 'ClassDef':
            c = mod.find_class(item.fields[0].text, item.line)
            for m in val_nodes(item.fields[4]):
                if m.fields[5].flag:
                    raise CompileError('the Tomato compiler does not support override yet', m.line)
                info = function_info(m, mod, c.name)
                mod.infos.append(info)
                funcs.append(m)
                if m.fields[6].tag == 's' and m.fields[6].text == 'init':
                    c.init = info.name
        else:
            raise CompileError('the Tomato compiler does not support ' + item.kind + ' declarations yet', item.line)
    for item in user:
        if item.kind == 'FuncDef' and item.fields[6].tag == 's' and item.fields[6].text == 'entry:' + entry_name:
            entry = item.fields[0].text
            if item.fields[2].tag != 'z':
                raise CompileError('the Tomato compiler runs an entry point without a result yet', item.line)
    if entry == '':
        raise CompileError('no function marked @' + entry_name, 1)
    bodies = ''
    k = 0
    for f in funcs:
        bodies = bodies + compile_function(f, mod, mod.infos[k]) + '\n'
        k = k + 1
    for c in mod.classes:
        bodies = bodies + compile_constructor(c, mod) + '\n'
    wrapper = entry_wrapper(mod.find(entry, 1), mod)
    out = '; written by the Tomato compiler in Tomato (selfhost/compiler.tom)\n'
    out = out + declarations() + class_types(mod) + runtime_tables(mod)
    j = 0
    for s in mod.strings:
        out = out + string_global(j, s) + '\n'
        out = out + string_c(j, s) + '\n'
        j = j + 1
    out = out + '\n' + bodies
    out = out + wrapper
    return out
