# D12az, P15: `Circle(s)` converts a parent-typed value to the subclass (it fails if the object is not a Circle). Today it is refused (E128).
class Shape:
    name: str

    @init
    def init(self, name: str):
        self.name = name

class Circle(Shape):
    r: int

    @init
    def init(self, name: str, r: int):
        self.name = name
        self.r = r

@main
def main():
    s: Shape = Circle('c', 3)
    c = Circle(s)
    print(c.r)
