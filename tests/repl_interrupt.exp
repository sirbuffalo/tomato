# Drives the real `tomato repl` on a pseudo-terminal: Ctrl-C while a piece runs (an endless loop) stops that piece only. The session goes
# on at the prompt, with what was typed before still there (fourth audit 25: it used to end the session, status 130).
# Usage: expect tests/repl_interrupt.exp   (needs `tomato` on PATH; the last line printed is `ok` or `FAIL: ...`)
set timeout 300
log_user 0
set env(TERM) dumb
set env(TOMATO_REPL_EDIT) /nonexistent
spawn tomato repl
proc fail {msg} { puts "FAIL: $msg"; exit 1 }
proc want {re what} {
  expect {
    -re $re {}
    timeout { fail "timed out waiting for $what" }
    eof { fail "the session ended while waiting for $what" }
  }
}
want {>>> } "the first prompt"
send "x = 5\r"
want {>>> } "the prompt after x = 5"
send "while True:\r    pass\r\r"
# (a fixed wait: the endless loop prints nothing that says it is running; a Ctrl-C that comes while it is still compiled stops that too)
after 4000
send "\003"
want {interrupted} "the interrupted message"
want {>>> } "a prompt after Ctrl-C"
send "x + 1\r"
want {\n6\r\n} "the session still has x"
send "quit()\r"
expect {
  eof {}
  timeout { fail "the session did not end" }
}
puts ok
