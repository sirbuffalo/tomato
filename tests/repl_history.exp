# Drives the real `tomato repl` with its line editor (tomato-repl-edit, TOMATO_REPL_EDIT) on a pseudo-terminal, through a shell (no Python):
# a block typed with auto-indent, recalled whole by the up arrow and edited in place (a middle line changed, a line added, a line
# deleted), Ctrl-C, a bracketed paste, a UTF-8 line, a resize, Ctrl-D; Tab completion (the session's names, keywords, modules, commands); the history file in its plain ⏎ format holding only what was
# typed; the terminal's settings (`stty -g`) the same after the session as before; and the fallbacks: a helper that fails (exit 1) or
# is killed (SIGTERM) gives a one-line note and plain input, and TERM=dumb gives plain input with no note.
# Usage: TOMATO_REPL_EDIT=HELPER expect tests/repl_history.exp   (needs `tomato` on PATH; the last line printed is `ok` or `FAIL: ...`)
# It fails, never skips, when the helper is missing. TOMATO_REPL_TRANSCRIPT=FILE also writes the session, as the terminal got it, to FILE.
# No fixed sleeps: every key is sent only after the editor has drawn the prompt it answers (the editor turns bracketed paste on,
# ESC[?2004h, once its terminal is raw, and then draws the first frame), so a loaded machine only makes the session slower.
set timeout 180
encoding system utf-8
match_max 200000
log_user 0
proc fail {msg} { global work; puts "FAIL: $msg"; catch {exec rm -rf $work}; exit 1 }
if {![info exists env(TOMATO_REPL_EDIT)] || ![file executable $env(TOMATO_REPL_EDIT)]} {
  puts "FAIL: the line editor (TOMATO_REPL_EDIT) is missing: [expr {[info exists env(TOMATO_REPL_EDIT)] ? $env(TOMATO_REPL_EDIT) : {not set}}]"
  exit 1
}
set edit $env(TOMATO_REPL_EDIT)
set work [exec mktemp -d]
if {[info exists env(TOMATO_REPL_TRANSCRIPT)]} { log_file -a -noappend $env(TOMATO_REPL_TRANSCRIPT) }
set env(HOME) $work
set env(TERM) xterm
set env(TOMATO_HISTORY) $work/hist
set env(NO_COLOR) 1          ;# the editor sections below are about the text; the colors have a section of their own at the end
catch {unset env(TOMATO_COLOR)}
catch {unset env(COLORTERM)}
catch {unset env(LINES)}
catch {unset env(COLUMNS)}

# want REGEXP WHAT: wait for the output to match; fail if it never does
proc want {re what} {
  global expect_out
  expect {
    -re $re {}
    timeout { fail "timed out waiting for $what" }
    eof { fail "the session ended while waiting for $what" }
  }
}
set ESC \x1b
# the editor is reading keys: bracketed paste on, then the first frame (an empty prompt, the cursor after it)
set promptre {>>> \x1b\[5G}
proc prompt {what} { global promptre; want "\\x1b\\\[\\?2004h\\r\\x1b\\\[J$promptre" "the editor's prompt ($what)" }
# the piece has been run (its output follows the editor's last write, ESC[?25h: the cursor shown again) and the next prompt is live
proc ran {re what} { want $re $what; prompt "after $what" }
proc normal {text} {   # stty -g without macOS's PENDIN bit, which is the kernel's state and not a setting (see tests/terminal_pty.exp)
  if {[regexp {^(.*lflag=)([0-9a-f]+)(.*)$} $text -> head flags tail]} {
    scan $flags %x bits
    set text "$head[format %x [expr {$bits & ~0x20000000}]]$tail"
  }
  return $text
}
# runs `tomato repl` in the shell with the settings saved before and after (the suffix N names the files)
proc start_repl {n env_words {flags ""}} {
  global work
  send "stty -g > $work/before$n; $env_words tomato repl $flags; echo EXIT=\$?; stty -g > $work/after$n\r"
}
proc ended {n what} {
  global work
  want {EXIT=0\r\n} "the repl to leave ($what)"
  send "echo DO\"\"NE\r"
  want {DONE\r\n} "the shell after $what"
  set a [normal [exec cat $work/before$n]]
  set b [normal [exec cat $work/after$n]]
  if {$a ne $b} { fail "$what: the terminal settings changed: before '$a', after '$b'" }
}

spawn sh
set slave $spawn_out(slave,name)
exec stty rows 30 cols 100 < $slave

# ---- the editor ------------------------------------------------------------------------------------------------------------
start_repl 1 ""
prompt "start"
# a block: Enter after a line ending in ':' indents the next line; an empty last line runs it
send "for i in range(2):\r"
want {>>> for i in range\(2\):\r\n\.\.\.     \x1b\[9G} "the auto-indented second line"
send "y = i\r"
want {\.\.\.     y = i\r\n\.\.\.     \x1b\[9G} "the third line"
send "print(y)\r"
want {\.\.\.     print\(y\)\r\n\.\.\.     \x1b\[9G} "the fourth line"
send "\r"
ran {\?25h0\r\n1\r\n} "the block runs"
send "x = 5\r"
prompt "x = 5"
send "print(1 + \"a\")\r"
ran {cannot use '\+' with int and str} "the error"
send ":help\r"
ran {:reset} ":help"
# Up three times: the block comes back as its real lines, the cursor at its end; Up again goes to its middle line
send "\033\[A\033\[A\033\[A"
want {>>> for i in range\(2\):\r\n\.\.\.     y = i\r\n\.\.\.     print\(y\)\x1b\[17G} "the recalled block"
send "\033\[A * 10"
want {\.\.\.     y = i \* 10\r\n\.\.\.     print\(y\)\x1b\[1A\x1b\[19G} "the edited middle line"
# Down to the last line, Enter adds a line (the block is still open), and Enter on that empty line runs it
send "\033\[B\r"
want {print\(y\)\r\n\.\.\.     \x1b\[9G} "the new last line"
send "\r"
ran {\?25h0\r\n10\r\n} "the edited block runs"
# add a line to the recalled block
send "\033\[A"
want {y = i \* 10\r\n\.\.\.     print\(y\)\x1b\[17G} "the edited block recalled"
send "\rprint(-y)\r"
want {print\(-y\)\r\n\.\.\.     \x1b\[9G} "the added line"
send "\r"
ran {\?25h0\r\n0\r\n10\r\n-10\r\n} "the block with the added line"
# delete that line again: Ctrl-U empties it, Backspace joins it to the line above
send "\033\[A"
want {print\(-y\)\x1b\[18G} "the four-line block recalled"
send "\025\177"
want {\.\.\.     print\(y\)\x1b\[17G} "the deleted line"
send "\r\r"
ran {\?25h0\r\n10\r\n} "the block without the line"
# Ctrl-C drops what was typed and gives a new prompt
send "oops"
want {>>> oops\x1b\[9G} "the typed text"
send "\003"
ran {>>> oops\x1b\[9G\r\nKeyboardInterrupt\r\n} "KeyboardInterrupt"
# a bracketed paste of two lines is inserted as it is, and Enter runs it
send "\033\[200~print(7)\rprint(8)\033\[201~"
want {>>> print\(7\)\r\n\.\.\. print\(8\)\x1b\[13G} "the pasted lines"
send "\r"
ran {\?25h7\r\n8\r\n} "the pasted lines run"
# UTF-8: wide characters, the cursor placed by cells
send "print('héllo 中')"
want "print\\('héllo 中'\\)\x1b\\\[22G" "the UTF-8 line"
send "\r"
ran "\\?25hhéllo 中\r\n" "the UTF-8 line runs"
# a resize: the editor redraws at the new width, and a long line wraps there
exec stty cols 30 < $slave
send "print('abcdefghijklmnopqrstuvwxyz')"
want {>>> print\('abcdefghijklmnopqrs\r\ntuvwxyz'\)\x1b\[10G} "the line wrapped at the new width"
send "\r"
ran {\?25habcdefghijklmnopqrstuvwxyz\r\n} "the wrapped line runs"
exec stty cols 100 < $slave
# Ctrl-D on an empty prompt leaves
send "\004"
ended 1 "Ctrl-D"
set hist [exec cat $work/hist]
set bad ""
if {![string match "for i in range(2):⏎    y = i⏎    print(y)\n*" $hist]} { append bad "the block is not one entry in the ⏎ format: $hist; " }
if {![string match "*\nfor i in range(2):⏎    y = i \\* 10⏎    print(y)⏎    print(-y)\n*" $hist]} { append bad "the block with the added line is not in the history; " }
if {![string match "*\nprint(7)⏎print(8)\n*" $hist]} { append bad "the paste is not one entry; " }
if {![string match "*\nprint('héllo 中')\n*" $hist]} { append bad "the UTF-8 line is not in the history; " }
if {[string match "*:help*" $hist]} { append bad "a :command is in the history; " }
if {[string match "*oops*" $hist]} { append bad "the text dropped by Ctrl-C is in the history; " }
if {[string match "*Error*" $hist] || [string match "*cannot use*" $hist]} { append bad "error text in the history; " }
if {[llength [split [string trim $hist] "\n"]] != 9} { append bad "the history does not have 9 entries: $hist; " }
if {$bad ne ""} { fail $bad }

# ---- completion ------------------------------------------------------------------------------------------------------------
# Tab completes the name before the cursor: what the session uses (total, below), a keyword or built-in (one candidate is put in; several
# give their common start and then a list under the text, which the next key takes away), a standard module after import, and a :command;
# in an indent it still inserts four spaces. Nothing is completed after a dot, and Tab after other text does nothing.
start_repl 12 "TOMATO_HISTORY=$work/hist12"
prompt "completion"
send "total = 5\r"
prompt "total = 5"
send "print(tot\t"
want {>>> print\(total\x1b\[16G} "the session's name completed"
send "\003"
ran {KeyboardInterrupt\r\n} "KeyboardInterrupt (completion)"
send "pri\t"
want {>>> pri\r\nprint    private\x1b\[1A\x1b\[8G} "the list of the candidates under the text"
send "n"
want {\x1b\[J>>> prin\x1b\[9G} "the list gone with the next key"
send "\t"
want {>>> print\x1b\[10G} "print completed"
send "\003"
ran {KeyboardInterrupt\r\n} "KeyboardInterrupt (print)"
send "import ma\t"
want {>>> import math\x1b\[16G} "a standard module completed after import"
send "\003"
ran {KeyboardInterrupt\r\n} "KeyboardInterrupt (import)"
send ":he\t"
want {>>> :help\x1b\[10G} "a :command completed"
send "\003"
ran {KeyboardInterrupt\r\n} "KeyboardInterrupt (:command)"
send "xs.ap\tx"
want {>>> xs\.apx\x1b\[11G} "nothing completed or inserted by Tab after a dot"
send "\003"
ran {KeyboardInterrupt\r\n} "KeyboardInterrupt (dot)"
send "for i in range(2):\r\t"
want {\.\.\.         \x1b\[13G} "Tab in an indent inserts four more spaces"
send "\003"
ran {KeyboardInterrupt\r\n} "KeyboardInterrupt (indent)"
send "\004"
ended 12 "completion"

# ---- redefinition ----------------------------------------------------------------------------------------------------------
# A def recalled with Up, edited and run again replaces the earlier one (it was E120 "defined twice"): the next call uses it, the session
# shows no output of its own for the redefinition, and the history holds both blocks. A class redefined so that an earlier line no longer
# works is refused with that error and a hint, the old class stays and the session goes on; the completer offers the names as before.
start_repl 13 "TOMATO_HISTORY=$work/hist13"
prompt "redefinition"
send "def fval() -> int:\r"
want {>>> def fval\(\) -> int:\r\n\.\.\.     \x1b\[9G} "the def's second line"
send "return 1\r\r"
ran {\?25h} "the def"
send "fval()\r"
ran {\?25h1\r\n} "the first definition's value"
# Up twice: the call, then the def block, the cursor at its last line; replace the 1 by 2 and run it
send "\033\[A\033\[A"
want {>>> def fval\(\) -> int:\r\n\.\.\.     return 1\x1b\[17G} "the def recalled"
send "\177"
send "2"
want {return 2\x1b\[17G} "the edited def"
send "\r\r"
ran {\?25h} "the redefinition runs (no error, no output)"
send "fval()\r"
ran {\?25h2\r\n} "the new definition's value"
# a name that the completer knows because of the redefinition
send "fva\t"
want {>>> fval\x1b\[9G} "the redefined name completed"
send "\003"
ran {KeyboardInterrupt\r\n} "KeyboardInterrupt (redefined name)"
# a class, an object of it, then a class that an earlier line no longer fits (its field is gone): refused, the old class stays
send "class Pt:\r"
send "x: int = 3\r\r"
ran {\?25h} "the class"
send "p = Pt()\r"
prompt "the object"
send "print(p.x)\r"
ran {\?25h3\r\n} "the field"
send "class Pt:\r"
send "z: int = 1\r\r"
want {hint: the earlier lines of the session run again with the new Pt} "the hint"
prompt "after the refusal"
send "p.x\r"
ran {\?25h3\r\n} "the old class is still there"
send "\004"
ended 13 "redefinition"
set hist [exec cat $work/hist13]
if {[llength [split [string trim $hist] "\n"]] != 9} { fail "redefinition: the history does not have 9 entries: $hist" }
if {![string match "def fval() -> int:⏎    return 1\n*def fval() -> int:⏎    return 2\n*" $hist]} { fail "redefinition: both definitions are in the history: $hist" }

# a variable declared again with a type that does not fit: refused, and the old variable and its value stay usable
start_repl 14 "TOMATO_HISTORY=$work/hist14"
prompt "variable redeclaration"
send "vv: int = 7\r"
prompt "the variable"
send "vv: int = \"a\"\r"
want {the value has type str, but int is expected} "the refused redeclaration"
prompt "after the refused redeclaration"
send "vv + 1\r"
ran {\?25h8\r\n} "the old variable is still there"
send "\004"
ended 14 "variable redeclaration"

# a variable declared again takes the place of the old one: an earlier line that used it runs with the new one, the old value is dropped,
# a redeclaration with a type an earlier line does not fit is refused with a hint (the old variable stays), and the history keeps every entry
start_repl 15 "TOMATO_HISTORY=$work/hist15"
prompt "variable replaced in place"
send "rv: int = 1\r"
prompt "the variable"
send "print(rv)\r"
ran {\?25h1\r\n} "the value"
send "rv: int = 5\r"
ran {\?25h} "the redeclaration runs (no error, no output)"
send "print(rv + 1)\r"
ran {\?25h6\r\n} "the old value is gone"
send "rv: str = \"a\"\r"
want {cannot use '\+' with} "the redeclaration an earlier line does not fit is refused"
want {the earlier declaration is kept} "the hint"
prompt "after the refusal"
send "rv * 2\r"
ran {\?25h10\r\n} "the old variable is still there"
send "\004"
ended 15 "variable replaced in place"
set hist [exec cat $work/hist15]
if {[llength [split [string trim $hist] "\n"]] != 6} { fail "variable replaced in place: the history does not have 6 entries: $hist" }
if {![string match "rv: int = 1\n*rv: int = 5\n*rv: str = \"a\"\n*" $hist]} { fail "variable replaced in place: the history holds every entry: $hist" }

# ---- the colors ------------------------------------------------------------------------------------------------------------
# The code is colored as it is typed, lowered to the terminal's colors: 24 bits (COLORTERM), 256 (TERM), 16. --color=always wins over
# NO_COLOR, --color=never and NO_COLOR (and TOMATO_COLOR=never) leave the text plain, and TOMATO_COLOR=always works like the flag. The
# brand red (keywords) and green (texts and the prompt), comments dim, numbers cyan, built-ins bright blue, names after def bold.
set rst {\x1b\[0m}
# a session that types a line, checks how it is drawn, and leaves: kw and str are the sequences that start a keyword and a text
proc colored {n env_words flags kw str what} {
  global rst promptre
  set promptre ">>> \\x1b\\\[5G"
  set promptre "$str>>> $rst\\x1b\\\[5G"
  start_repl $n $env_words $flags
  prompt "$what"
  send "for x in 'a':"
  want "${kw}for${rst} x ${kw}in${rst} ${str}'a'${rst}:" "the colored line ($what)"
  send "\003"
  ran {KeyboardInterrupt\r\n} "KeyboardInterrupt ($what)"
  send "\004"
  ended $n $what
  set promptre {>>> \x1b\[5G}
}
# a session that types the same line and checks that nothing was colored
proc plain {n env_words flags what} {
  global promptre expect_out
  start_repl $n $env_words $flags
  prompt "$what"
  send "for x in 'a':"
  want {for x in 'a':\x1b\[18G} "the plain line ($what)"
  if {[regexp {\x1b\[[0-9;]*m} $expect_out(buffer)]} { fail "$what: a color appeared: [string map [list \x1b ESC] $expect_out(buffer)]" }
  send "\003"
  ran {KeyboardInterrupt\r\n} "KeyboardInterrupt ($what)"
  send "\004"
  ended $n $what
}
# 24-bit colors, and a recalled line edited in place: the line comes back colored, the edit changes the colors
set tkw {\x1b\[38;2;235;60;39m}
set tstr {\x1b\[38;2;0;150;57m}
set promptre "$tstr>>> $rst\\x1b\\\[5G"
start_repl 5 "TOMATO_HISTORY=$work/hist5 TERM=xterm-256color COLORTERM=truecolor NO_COLOR=1" "--color=always"
prompt "24-bit colors"
send "print('hi', 3)"
want "\\x1b\\\[94mprint$rst\\(${tstr}'hi'$rst, \\x1b\\\[36m3$rst\\)" "the typed line in 24-bit colors"
send "\r"
ran {\?25hhi 3\r\n} "the colored line runs"
send "\033\[A"
want "\\x1b\\\[94mprint$rst\\(${tstr}'hi'$rst, \\x1b\\\[36m3$rst\\)\\x1b\\\[19G" "the recalled line, colored"
send "\177\17742)"
want "\\x1b\\\[36m42$rst\\)\\x1b\\\[20G" "the edited recalled line"
send "\r"
ran {\?25hhi 42\r\n} "the edited line runs"
send "x = \$"
want {x = \x1b\[4;38;2;235;60;39m\$\x1b\[0m\x1b\[10G} "a character that is not Tomato, underlined red"
send "\003"
ran {KeyboardInterrupt\r\n} "KeyboardInterrupt (24 bits)"
send "# note"
want {\x1b\[2m# note\x1b\[0m\x1b\[11G} "a comment, dim"
send "\003"
ran {KeyboardInterrupt\r\n} "KeyboardInterrupt (comment)"
send "\004"
ended 5 "24-bit colors"
set promptre {>>> \x1b\[5G}
# 256 colors (the nearest to the brand red is an orange, so the red is 196), always wins over NO_COLOR
colored 6 "TERM=xterm-256color COLORTERM= NO_COLOR=1" "--color=always" {\x1b\[38;5;196m} {\x1b\[38;5;29m} "256 colors"
# 16 colors: the terminal's own red and green; the color decided by the environment alone (a terminal, NO_COLOR empty), and by TOMATO_COLOR
colored 7 "TERM=xterm COLORTERM= NO_COLOR=" "" {\x1b\[31m} {\x1b\[32m} "16 colors, automatic"
colored 8 "TERM=xterm COLORTERM= NO_COLOR=1 TOMATO_COLOR=always" "" {\x1b\[31m} {\x1b\[32m} "TOMATO_COLOR=always"
# no colors: NO_COLOR, --color=never, TOMATO_COLOR=never, TERM=dumb has no editor at all
plain 9 "TERM=xterm-256color NO_COLOR=1" "" "NO_COLOR"
plain 10 "TERM=xterm-256color NO_COLOR=" "--color=never" "--color=never"
plain 11 "TERM=xterm-256color NO_COLOR= TOMATO_COLOR=never" "" "TOMATO_COLOR=never"

# ---- the fallbacks ---------------------------------------------------------------------------------------------------------
# a helper that fails: a one-line note, then plain input (readline) for the rest of the session; only exit 10 leaves
set fake $work/failing-editor
exec sh -c "printf '#!/bin/sh\\nexit 1\\n' > $fake; chmod +x $fake"
start_repl 2 "TOMATO_REPL_EDIT=$fake"
want {the line editor is not available; using plain input\r\n} "the note for a failing editor"
want {>>> } "the plain prompt"
send "print(5)\r"
want {[\r\n]5\r\n} "plain input runs"
want {>>> } "the plain prompt again"
send ":quit\r"
ended 2 "a failing editor"
# the editor killed by SIGTERM while it reads: the same note, and the terminal given back
start_repl 3 "TOMATO_HISTORY=$work/hist3"
prompt "before the kill"
set pid [exec pgrep -f -- "--history $work/hist3"]
exec kill -TERM $pid
want {the line editor is not available; using plain input\r\n} "the note for a killed editor"
want {>>> } "the plain prompt after the kill"
send ":quit\r"
ended 3 "a killed editor"
# TERM=dumb: plain input, and no note
start_repl 4 "TERM=dumb"
expect {
  -re {line editor} { fail "TERM=dumb printed the note" }
  -re {>>> } {}
  timeout { fail "timed out waiting for the plain prompt with TERM=dumb" }
}
send "print(6)\r"
want {[\r\n]6\r\n} "TERM=dumb runs"
send ":quit\r"
ended 4 "TERM=dumb"
catch {exec rm -rf $work}
puts ok
