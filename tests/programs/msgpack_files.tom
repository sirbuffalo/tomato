# json load_msgpack(path) / dump_msgpack(value, path): round trips through binary files, large values, bad bytes in the
# file, and paths that cannot be opened, read or written (the IOError names the file, as open() does).
from json import loads, dumps, loads_msgpack, dumps_msgpack, load_msgpack, dump_msgpack, MsgpackError, Json, JsonBin, JsonExt, JsonTimestamp, JsonInt, JsonFloat, JsonStr, JsonList, JsonDict, JsonNull, JsonBool

def hexs(b: list[int]) -> str:
    digits = '0123456789abcdef'
    out: list[str] = []
    for x in b:
        out.append(digits[x // 16] + digits[x % 16])
    return ''.join(out)

# the file holds exactly the bytes of dumps_msgpack, and reading it back gives the same value
def round_trip(label: str, j: Json, path: str):
    dump_msgpack(j, path)
    back = load_msgpack(path)
    print(label, dumps_msgpack(back) == dumps_msgpack(j), back.kind())

def write_text(path: str, text: str):
    f = open(path, 'w')
    f.write(text)
    f.close()

# the IOError text names the file: the run's own folder is shown as <dir>, so the output is the same on every run
def try_load(label: str, path: str, dir: str):
    try:
        print(label, 'loaded', dumps(load_msgpack(path)))
    catch MsgpackError as e:
        print(label, 'MsgpackError', e.id, e.pos, e.message)
    catch IOError as e:
        print(label, 'IOError', e.id, e.message.replace(dir, '<dir>'))

def try_dump(label: str, j: Json, path: str, dir: str):
    try:
        dump_msgpack(j, path)
        print(label, 'written')
    catch MsgpackError as e:
        print(label, 'MsgpackError', e.id, e.message)
    catch IOError as e:
        print(label, 'IOError', e.id, e.message.replace(dir, '<dir>'))

def nested(depth: int) -> Json:
    j: Json = JsonInt(1)
    for i in range(depth):
        j = JsonList([j])
    return j

@main
def main(dir: str = '/tmp'):
    # tests/run.sh passes its own temporary folder: a fixed name in a shared /tmp can belong to another user
    path = dir + '/tomato_msgpack_files_test.msgpack'
    print('-- round trips')
    every = JsonDict({
        'null': JsonNull(), 'yes': JsonBool(True), 'no': JsonBool(False),
        'ints': JsonList([JsonInt(0), JsonInt(127), JsonInt(-32), JsonInt(255), JsonInt(-129), JsonInt(65536), JsonInt(-2147483649), JsonInt(9223372036854775807), JsonInt(-9223372036854775808), JsonInt(18446744073709551615)]),
        'floats': JsonList([JsonFloat(0.5), JsonFloat(-0.0), JsonFloat(1e300), loads_msgpack([203, 127, 248, 0, 0, 0, 0, 0, 0]), loads_msgpack([203, 255, 240, 0, 0, 0, 0, 0, 0])]),
        'text': JsonStr('tomato é ✓ 🍅'), 'empty': JsonStr(''),
        'bin': JsonBin([0, 1, 127, 128, 255]), 'ext': JsonExt(5, [1, 2, 3]),
        'ts': JsonTimestamp(1700000000, 123456789), 'old': JsonTimestamp(-1, 0),
        'nest': JsonList([JsonDict({}), JsonList([]), JsonDict({'a': JsonList([JsonNull()])})])})
    round_trip('every kind', every, path)
    back = load_msgpack(path)
    print(back['text'].as_str(), back['ints'][9].as_int(), back['bin'].as_bytes(), back['ext'].ext_type(), back['ts'].nanos(), back['old'].seconds())
    print(str(back['floats'][3].as_float()), str(back['floats'][4].as_float()))
    tops: list[Json] = [JsonNull(), JsonBool(True), JsonInt(-1), JsonFloat(2.5), JsonStr('x'), JsonBin([]), JsonList([]), JsonDict({})]
    for j in tops:
        round_trip('top level', j, path)
    # the exact bytes: [1, "a", nil] is 93 01 a1 61 c0
    dump_msgpack(loads('[1, "a", null]'), path)
    print(hexs(dumps_msgpack(load_msgpack(path))))
    # a bin of 150 a's is c4 96 61 61 ..., which is also UTF-8 text (U+0116 and 150 a's), so open() can check the file
    dump_msgpack(JsonBin([97] * 150), path)
    f = open(path, 'r')
    print(f.read() == chr(278) + 'a' * 150)
    f.close()
    # a shorter value replaces the file (no bytes of the longer one are left at the end)
    dump_msgpack(every, path)
    dump_msgpack(JsonInt(7), path)
    print(dumps(load_msgpack(path)))
    # the same Json as loads gives for a JSON document
    doc = loads('{"name": "tomato", "tags": ["red", "round"], "n": 3, "big": 123456789012345678901, "f": 0.25}')
    try_dump('too big for 64 bits', doc, path, dir)
    doc = loads('{"name": "tomato", "tags": ["red", "round"], "n": 3, "f": 0.25}')
    dump_msgpack(doc, path)
    print(dumps(load_msgpack(path)) == dumps(doc), dumps(load_msgpack(path)))
    odd = dir + '/tomato msgpack é test.msgpack'
    round_trip('path with a space and é', doc, odd)

    print('-- large values')
    ints: list[Json] = []
    for i in range(200000):
        ints.append(JsonInt(i * 7919 - 500000))
    round_trip('200000 ints', JsonList(ints), path)
    print(len(load_msgpack(path)), load_msgpack(path)[199999].as_int())
    round_trip('5 MB str', JsonStr('tomato🍅' * 500000), path)
    print(len(load_msgpack(path).as_str()))
    bytes: list[int] = []
    for i in range(300000):
        bytes.append(i % 256)
    round_trip('300000-byte bin', JsonBin(bytes), path)
    print(load_msgpack(path).as_bytes() == bytes)
    fields: dict[str, Json] = {}
    for i in range(20000):
        fields[f'key{i}'] = JsonList([JsonInt(i), JsonStr(str(i)), JsonFloat(i / 4)])
    round_trip('20000-key dict', JsonDict(fields), path)
    print(load_msgpack(path)['key19999'][1].as_str())
    round_trip('512 levels', nested(511), path)

    print('-- values MessagePack cannot hold leave the file alone')
    dump_msgpack(JsonStr('kept'), path)
    try_dump('513 levels', nested(513), path, dir)
    try_dump('65-bit int', JsonInt(36893488147419103232), path, dir)
    try_dump('bad byte', JsonBin([1, 256]), path, dir)
    try_dump('bad ext type', JsonExt(-1, [1]), path, dir)
    try_dump('bad nanos', JsonTimestamp(0, 1000000000), path, dir)
    try_load('still', path, dir)

    print('-- bad bytes in the file')
    bad = dir + '/tomato_msgpack_files_bad.msgpack'
    write_text(bad, '')
    try_load('empty file', bad, dir)
    write_text(bad, 'abc')
    try_load('extra data', bad, dir)
    write_text(bad, chr(1808))
    try_load('truncated array', bad, dir)
    write_text(bad, '{"a": 1}')
    try_load('JSON text', bad, dir)
    write_text(bad, '{')
    try_load('one fixint', bad, dir)

    print('-- paths that cannot be used')
    missing = '/nonexistent_dir_for_tomato/x.msgpack'
    try:
        f = open(missing, 'r')
        f.close()
    catch IOError as e:
        print('open():', e.id, e.message)
    try_load('load missing dir', missing, dir)
    try_load('load missing file', dir + '/tomato_msgpack_files_never_written.msgpack', dir)
    try_dump('dump missing dir', JsonNull(), missing, dir)
    try_load('load a directory', dir, dir)
    try_dump('dump a directory', JsonNull(), dir, dir)
    try:
        load_msgpack(missing)
    catch RuntimeError as e:
        print('a RuntimeError too:', e.id)
