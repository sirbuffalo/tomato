# Dict keys and set elements that are optional (`T | None`), unions, interface values and fixed-width integers. Each is hashed and
# compared the way its members are: None hashes to 0 and equals only None; a union value equals another only when it holds the same
# kind of member with an equal value (1 and True and 1.0 are three different keys); an interface value is hashed by its object's class,
# which needs a @hash; fixed-width integers are keys by value.

interface Shape:
    def area(self) -> int

class Sq implements Shape:
    n: int

    @init
    def make(self, n: int):
        self.n = n

    def area(self) -> int:
        return self.n * self.n

    @eq
    def same(self, other: Sq) -> bool:
        return self.n == other.n

    @hash
    def h(self) -> int:
        return self.n

# @hash but no @eq: equal only to itself
class Ci implements Shape:
    n: int

    @init
    def make(self, n: int):
        self.n = n

    def area(self) -> int:
        return self.n * 3

    @hash
    def h(self) -> int:
        return self.n

class Big(Sq):
    @init
    def make(self, n: int):
        Sq.make(self, n)

class Careful:
    n: int

    @init
    def make(self, n: int):
        self.n = n

    @hash
    def h(self) -> int:
        if self.n < 0:
            raise ValueError('negative has no hash')
        return self.n

class Point:
    x: int
    y: int

    @init
    def make(self, x: int, y: int):
        self.x = x
        self.y = y

    @eq
    def same(self, other: Point) -> bool:
        return self.x == other.x and self.y == other.y

    @hash
    def h(self) -> int:
        return hash(self.x) * 31 + hash(self.y)

@main
def main():
    # optional keys: None is a key like any other
    o: dict[str | None, int] = {}
    o[None] = 1
    o['a'] = 2
    k: str | None = 'a'
    n: str | None = None
    print(len(o), o[k], o[n], k in o, n in o, 'b' in o)
    o[n] += 10
    o.remove(k)
    print(len(o), o[None], k in o)
    print(o.keys()[0] is None, hash(n), hash(k) == hash('a'))
    sp: set[Point | None] = {Point(1, 2), None, Point(1, 2), None}
    sp.add(Point(3, 4))
    print(len(sp), None in sp, Point(1, 2) in sp, Point(9, 9) in sp)

    # unions: the member's kind is part of the key
    u: dict[int | str | float | bool, str] = {}
    u[1] = 'int'
    u['1'] = 'str'
    u[1.5] = 'float'
    u[True] = 'bool'
    u[10 ** 30] = 'big'
    u[1] = 'int again'
    print(len(u), u[1], u['1'], u[1.5], u[True], u[10 ** 30])
    print(u)
    print(hash(True) == hash(1), 1 in u, 2 in u, 'x' in u)
    up: dict[int | Point, str] = {}
    up[Point(1, 2)] = 'p'
    up[7] = 'seven'
    up[Point(1, 2)] = 'p again'
    print(len(up), up[Point(1, 2)], up[7], 8 in up, Point(0, 0) in up)
    uc: dict[Careful | int, int] = {}
    uc[Careful(1)] = 1
    uc[2] = 2
    try:
        uc[Careful(-1)] = 3
    catch ValueError as e:
        print('caught', e.message)
    print(len(uc))
    ut: dict[int | tuple[int, int], str] = {}
    pair: tuple[int, int] = (1, 2)
    ut[pair] = 'pair'
    ut[5] = 'five'
    print(len(ut), ut[pair], 5 in ut)

    # interface keys: Sq compares by its @eq, Ci by identity; a Big is a Sq
    s: dict[Shape, str] = {}
    a = Sq(2)
    s[a] = 'sq2'
    s[Sq(2)] = 'sq2 again'
    c = Ci(2)
    s[c] = 'ci2'
    s[Ci(2)] = 'another ci2'
    print(len(s), s[a], s[c], Sq(3) in s)
    s[Big(2)] = 'big2'
    print(len(s), s[Sq(2)])
    sh: set[Shape] = {Sq(1), Sq(1), Ci(1)}
    print(len(sh))
    print(hash(Sq(5)) == hash(Big(5)), hash(a) == hash(Sq(2)))

    # fixed-width integers
    f: dict[int[length=8], str] = {}
    f[5] = 'five'
    f[-3] = 'minus three'
    f[5] = 'FIVE'
    print(len(f), f[5], f[-3], 5 in f, 6 in f)
    for key in f:
        print(key)
    f.remove(5)
    print(len(f), f.keys())
    g: dict[uint[length=16], int] = {}
    g[65535] = 1
    g[0] = 2
    g[65535] += 5
    print(g[65535], g[0], len(g), hash(g.keys()[0]))
    sf: set[uint[length=32]] = {1, 2, 4294967295, 1}
    print(len(sf), 4294967295 in sf, 3 in sf)
