@main
def main():
    xs = list(range(1, 11))
    print(xs[0:3])
    print(xs[3:])
    print(xs[:2])
    print(xs[::2])
    print(xs[-3:])
    print(xs[:-7])
    print(xs[::-1])
    print(xs[8:100])
    print(xs[-100:2])
    print(xs[5:2])
    print(xs[7:1:-2])
    print(xs[-1], xs[-10])
    s = 'hello'
    print(s[1:3], s[-2:], s[::2], s[::-1], s[:10])
    t = (1, 2, 3)
    print(t[1:])
    xs[-1] = 99
    print(xs[-2:])
    ys: list[str] = ['a', 'b', 'c']
    print(ys[1:])
    print(ys[-1])
