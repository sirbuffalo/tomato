# dumps: compact and indented output, sort_keys, ensure_ascii, builders, and what cannot be written
from json import loads, dumps, JSONEncodeError
from value import Value, Str, Dict, Int, Bool, List, Float, Null

def fails(j: Value):
    try:
        print(dumps(j))
    catch JSONEncodeError as e:
        print('error:', e.message)

@main
def main():
    doc = loads('{"b": [1, 2.5, {"z": null, "y": []}], "a": {"k": "v", "e": {}}, "c": true}')
    print(dumps(doc))
    print(dumps(doc, indent=2))
    print(dumps(doc, indent=1))
    print(dumps(doc, indent=0))
    print(dumps(doc, sort_keys=True))
    print(dumps(doc, indent=4, sort_keys=True))
    # strings: escapes, non-ASCII, ensure_ascii
    s = Str('quote " slash \\ solidus / tab \t nl \n cr \r bell ' + chr(7) + ' del ' + chr(127) + ' é € 😀')
    print(dumps(s))
    print(dumps(s, ensure_ascii=True))
    print(dumps(Str('')))
    print(dumps(Dict({'é': Int(1), '😀': Int(2)}), ensure_ascii=True))
    print(dumps(Dict({'é': Int(1), 'e': Int(2), 'z': Int(3), 'A': Int(4)}), sort_keys=True))
    # builders
    built = Dict({'ok': Bool(True), 'ids': List([Int(1), Null(), Float(0.5)]), 'big': Int(2 ** 100)})
    print(dumps(built))
    print(dumps(List([])), dumps(Dict({})), dumps(List([]), indent=2))
    # round trips
    text = '{"name":"tomato","tags":["red","round"],"n":3,"f":1500.0,"nested":{"a":[true,false,null]}}'
    print(dumps(loads(text)) == text)
    print(dumps(loads(dumps(doc, indent=3))) == dumps(doc))
    # a negative indent is an error
    try:
        dumps(doc, indent=-1)
    catch JSONEncodeError as e:
        print('error:', e.message)
    # nesting: 512 levels can be written, 513 cannot
    deep = List([])
    for i in range(511):
        deep = List([deep])
    print(len(dumps(deep)))
    deeper = List([deep])
    fails(deeper)
