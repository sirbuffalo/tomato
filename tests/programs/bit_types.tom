# bitarray and frozenbitarray (std/builtin/bitarray.tom, available without an import): construction, indexing, slicing, operators, conversions, errors.

def check(label: str, got: str, want: str):
    if got == want:
        print('ok  ' + label)
    else:
        print('BAD ' + label + ': ' + got + ' != ' + want)

def fails(label: str, a: bitarray, b: bitarray):
    try:
        _c = a & b
        print('BAD ' + label + ': no error')
    catch RuntimeError as e:
        print('error: ' + e.message)

class Flags:
    mask: int = 0

    @init
    def make(self, mask: int):
        self.mask = mask

    @bitarray
    def bits(self) -> bitarray:
        return bitarray(self.mask, 8)

def ones(a: bitarray) -> int:
    return a.count()


@main
def main():
    # construction
    print(bitarray('1011'))
    print(bitarray(8))
    print(bitarray(0))
    print(bitarray(8, 8))
    print(bitarray([True, False, True]))
    print(bitarray.zeros(5))
    print(bitarray.from_hex('A2'))
    print(bitarray('') == bitarray.zeros(0))
    print(bitarray(2 ** 70))
    print(len(bitarray(2 ** 70)))

    # indexing and setting
    a = bitarray('1011')
    print(len(a), a[0], a[1], a[-1], a[-4])
    a[1] = True
    a[3] = False
    print(a)
    a.append(True)
    a.append(False)
    print(a, len(a))

    # slices and iteration
    b = bitarray('110010111')
    print(b[2:6], b[:3], b[6:], b[::2], b[::-1], b[-3:], b[10:20] == bitarray(''))
    set_bits = 0
    for bit in b:
        if bit:
            set_bits += 1
    print(set_bits, b.count(), True in b, False in bitarray('111'))

    # operators
    x = bitarray('1100')
    y = bitarray('1010')
    print(x & y, x | y, x ^ y, ~x)
    x &= y
    print(x)
    print(x == bitarray('1000'), x != bitarray('1000'), x == bitarray('10000'))
    fails('different lengths', bitarray('1'), bitarray('11'))
    print(bitarray('0110').shift_left(1), bitarray('0110').shift_right(2))

    # search and counting
    c = bitarray('0001000')
    print(c.find(True), c.find(False), c.find(True, 4), c.any(), c.all(), bitarray('111').all(), bitarray.zeros(3).any())
    print(bitarray.zeros(100).find(True), (~bitarray.zeros(100)).count(), (~bitarray.zeros(100)).find(False))

    # conversion
    big = bitarray('1011001110001111')
    print(big.to_ints(), big.to_hex(), big.to_int())
    print(bitarray.from_ints([179, 143]), bitarray.from_ints([255, 255], 10), bitarray('101').to_ints(), bitarray('101').to_hex())
    print(bitarray('101').to_list())
    print(bitarray.from_hex('b3').to_int())

    # chunk boundaries: 32 bits to a chunk
    long = bitarray.zeros(70)
    long[31] = True
    long[32] = True
    long[69] = True
    print(long.count(), long.find(True), long.find(True, 32), long.find(True, 33), long[-1])
    longer = long.copy()
    longer.extend(long)
    print(len(longer), longer.count(), longer.find(True, 70))
    tail = bitarray('101')
    tail.extend(bitarray('0110'))
    print(tail, len(tail))
    print((~long).count(), len(~long))

    # frozenbitarray
    f = frozenbitarray('1010')
    g = frozenbitarray(bitarray('1010'))
    print(f, f == g, len(f), f[0], f[1:3], f.count(), f & g, ~f)
    print(f.hash() == g.hash(), f.hash() == frozenbitarray('1011').hash(), f.key())
    t = f.thaw()
    t[0] = False
    print(t, f)
    print(bitarray('1100').freeze(), frozenbitarray(6), frozenbitarray.from_hex('f0'), frozenbitarray.zeros(3))
    for bit in f:
        print(bit)

    # errors
    try:
        bitarray('10x')
    catch RuntimeError as e:
        print('error: ' + e.message)
    try:
        print(bitarray('101')[3])
    catch RuntimeError as e:
        print('error: ' + e.message)
    try:
        bitarray(-1)
    catch RuntimeError as e:
        print('error: ' + e.message)
    try:
        bitarray(8, 3)
    catch RuntimeError as e:
        print('error: ' + e.message)
    try:
        bitarray.from_hex('zz')
    catch RuntimeError as e:
        print('error: ' + e.message)

    # an object whose class has a method marked @bitarray is used as that bitarray
    fl = Flags(5)
    print(bitarray(fl), frozenbitarray(fl), ones(fl), bitarray('11111111') & fl, fl.bits())

    # extending an array with itself, aligned to a chunk and not
    same = bitarray.zeros(31)
    same.append(True)
    same.extend(same)
    print(len(same), same.count(), same.find(True, 32))
    d = bitarray('101')
    d.extend(d)
    print(d)
