from itertools import permutations, combinations, combinations_with_replacement, product, product_repeat, accumulate, chain, pairwise, batched, repeat

def show(rows: list[list[int]]):
    text = ''
    for row in rows:
        text += ''.join([str(x) for x in row]) + ' '
    print(len(rows), text)

def flat(xs: list[int]):
    print(''.join([f'{x},' for x in xs]))

@main
def main():
    xs = [1, 2, 3]
    show(permutations(xs))
    show(permutations(xs, 2))
    show(permutations(xs, 0))
    show(permutations(xs, 4))
    show(combinations([1, 2, 3, 4], 2))
    show(combinations(xs, 0))
    show(combinations(xs, 4))
    show(combinations_with_replacement([1, 2, 3], 2))
    show(product([1, 2], [3, 4]))
    show(product_repeat([0, 1], 3))
    show(product_repeat(xs, 0))
    flat(accumulate([1, 2, 3, 4]))
    flat(chain([1, 2], [3]))
    show(pairwise([1, 2, 3, 4]))
    show(batched([1, 2, 3, 4, 5], 2))
    flat(repeat(7, 3))
