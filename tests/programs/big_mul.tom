# Big-number multiplication: big times small and big times big, across the small/big boundary.
def factorial(n: int) -> int:
    result = 1
    for i in range(2, n + 1):
        result *= i
    return result

@main
def main():
    print(factorial(25), factorial(30))
    print(factorial(100) // factorial(98), factorial(100) % 1000000007)
    two62 = 4611686018427387904
    print(two62 * 2, two62 * -2, (two62 - 1) * 1, -two62 * 1, two62 * 1)
    print((two62 * 2) // 2 == two62, (two62 * 2) // two62, (two62 * 3) * 0, 0 * (two62 * 3))
    print(9223372036854775807 * 9223372036854775807)
    print(-9223372036854775808 * 9223372036854775807)
    print(9223372036854775808 * -9223372036854775808)
    p = 2 ** 200
    print(p, p * -1, p * 1, p * 3, p * two62, p * (two62 * 2 + 1))
    print(p * p == 2 ** 400, (p * p) // p == p, (p + 1) * (p - 1) == p * p - 1)
    odd = 3 ** 101
    print(odd * 3 == 3 ** 102, odd * (-3) == -(3 ** 102), odd * 4294967296 == odd * 2 ** 32)
    print(odd * 4294967295 + odd == odd * 2 ** 32, odd * 18446744073709551615 + odd == odd * 2 ** 64)
    print((2 ** 64 + 1) * (2 ** 64 - 1), (2 ** 96 + 5) * 7, (2 ** 95) * 2 ** 31)
    # a big number times a small one that brings it back into the small range
    print((p * 5) // p * 3, (p * 5) % 7, -(p * 5) % 7, (p * 5) // -p)
    # many single-limb multiplications and the matching divisions
    q = 1
    for i in range(1, 400):
        q *= i * 1000003
    r = q
    for i in range(399, 0, -1):
        r //= i * 1000003
    print(r, q % 1000000007, len(str(q)), q > 0, -q < 0)
    # big times big with different lengths
    a = factorial(60)
    b = factorial(35)
    print(a * b == b * a, (a * b) // a == b, (a * b) % a, a * b > a)
    print(a * b)
    print((-a) * b == -(a * b), (-a) * (-b) == a * b)
