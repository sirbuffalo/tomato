class Dog:
    name: str = 'rex'

def describe(x: int | str) -> str:
    if x is int:
        return 'number ' + str(x + 1)
    elif x is str:
        return 'text ' + x
    return 'other'

def pick(flag: bool) -> int | str:
    if flag:
        return 1
    return 'a'

@main
def main():
    print(describe(3), describe('hi'))
    v: int | str | float = 2.5
    print(v, v is float, v is int)
    v = 'now text'
    print(v)
    p = pick(True)
    q = pick(False)
    print(p, q, p is str, q is str)
    n = 3
    print(n is int, n is str)
    for i in range(3):
        w: int | str = i
        if w is int:
            print(w * 2)
