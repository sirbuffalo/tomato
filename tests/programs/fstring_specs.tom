    print(f'[{0:>+8.0e}]')
    print(f'[{0: >-012,.5e}]')
    print(f'[{0:^ 1,.3e}]')
    print(f'[{0:-<03.3f}]')
    print(f'[{0:-<-1.10e}]')
    print(f'[{7:<+,.1f}]')
    print(f'[{7: >+020,.2e}]')
    print(f'[{7:.^-f}]')
    print(f'[{7:_^+,f}]')
    print(f'[{7:^08.0g}]')
    print(f'[{7:.^0,.2g}]')
    print(f'[{7:>+8.0e}]')
    print(f'[{7:< 020,.1g}]')
    print(f'[{7:-<+20,.0e}]')
    print(f'[{7:-<05.1e}]')
    print(f'[{7:$> 01,.10f}]')
    print(f'[{7: 20e}]')
    print(f'[{7:.^-20.10g}]')
    print(f'[{7:*<012.10e}]')
    print(f'[{(-7):>+020,e}]')
    print(f'[{(-7):<01,.10g}]')
    print(f'[{(-7):$>20.0f}]')
    print(f'[{(-7):$>+012.0f}]')
    print(f'[{(-7):_^-08g}]')
    print(f'[{(-7):*< 8,.0g}]')
    print(f'[{(-7):*<+12,.5g}]')
    print(f'[{(-7):$>08,e}]')
    print(f'[{(-7):>-05,.1e}]')
    print(f'[{(-7):$> 12,.0e}]')
    print(f'[{(-7):<-1,.2f}]')
    print(f'[{(-7):-<+012,.2f}]')

