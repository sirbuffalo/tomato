# f-string format specs (D75c): {value:[[fill]align][sign][0][width][,][.precision][type]} with the types s, d, f, e and g.
# The expected output is what Python 3 prints for the same lines.
def text_specs():
    word = 'tomato'
    wide = 'héllo wörld'
    print(f'[{word:10}] [{word:>10}] [{word:<10}] [{word:^10}] [{word:^11}] [{word:*^11}] [{word:->10}] [{word:.3}] [{word:8.3}] [{word:>8.3}] [{word:s}] [{word:6s}]')
    print(f'[{word:3}] [{word:6}] [{word:7}] [{word:0}] [{word:08}] [{word:>08}] [{word:x<08}] [{word:.0}] [{word:10.0}] [{"":5}] [{"":*^5}]')
    print(f'[{wide:15}] [{wide:>15}] [{wide:^15}] [{wide:.4}] [{"日本語":>6}] [{"日本語":·^7}] [{"日本語":.2}]')
    print(f'[{str(7):>4}] [{word[0]:>3}] [{"a" + "b":^6}] [{word.upper():_<9}] [{",".join(["a", "b"]):>8}]')

def int_specs():
    n = 1234567
    m = -42
    print(f'[{n}] [{n:d}] [{n:10}] [{n:<10}] [{n:^10}] [{n:>10}] [{n:*^11}] [{n:010}] [{n:+}] [{n:+d}] [{n: }] [{n:-}] [{n:+012}] [{n: 12}]')
    print(f'[{m}] [{m:d}] [{m:10}] [{m:<10}] [{m:^10}] [{m:010}] [{m:+}] [{m: }] [{m:+010}] [{m:=^10}] [{m:0>10}] [{m:0<10}] [{m:x^9}]')
    print(f'[{n:,}] [{n:,d}] [{n:15,}] [{n:015,}] [{n:016,}] [{n:+,}] [{n:^+16,}] [{n:_>16,}] [{m:,}] [{m:08,}] [{m:+09,}] [{999:,}] [{1000:,}] [{0:,}] [{0:05,}] [{12:010,}]')
    print(f'[{0}] [{0:+}] [{0: }] [{0:5}] [{0:05}] [{-0:3}] [{5:1}] [{5:0}] [{5:00}] [{5:01}] [{5:02}] [{123:2}] [{123:03}] [{123:04}]')
    print(f'[{n:.0f}] [{n:.2f}] [{n:e}] [{n:.3e}] [{n:g}] [{n:.3g}] [{n:f}] [{n:10.1f}] [{m:+.1f}] [{m:08.2f}] [{m:,.2f}] [{n:,.1f}] [{m:.0e}] [{n:.10g}] [{n:,g}]')

def float_specs():
    x = 3.14159
    y = -2.5
    z = 1234567.891
    print(f'[{x}] [{y}] [{z}] [{x:f}] [{x:.0f}] [{x:.1f}] [{x:.2f}] [{x:.3f}] [{x:.10f}] [{x:10.2f}] [{x:<10.2f}] [{x:^10.2f}] [{x:010.2f}] [{x:+.2f}] [{x: .2f}] [{x:-.2f}]')
    print(f'[{y:.0f}] [{y:.1f}] [{y:f}] [{y:10.2f}] [{y:010.2f}] [{y:+.2f}] [{y: .2f}] [{y:^10.1f}] [{y:*>10.1f}] [{y:0<10.1f}] [{y:e}] [{y:.1e}] [{y:g}] [{y:.0g}]')
    print(f'[{z:,}] [{z:,.2f}] [{z:,.0f}] [{z:20,.2f}] [{z:020,.2f}] [{z:+,.1f}] [{z:e}] [{z:.2e}] [{z:g}] [{z:.3g}] [{z:.10g}] [{z:.12g}] [{z:15}] [{z:15.3}]')
    print(f'[{x:e}] [{x:.0e}] [{x:.2e}] [{x:12.3e}] [{x:012.3e}] [{1e22:e}] [{1e-5:e}] [{123456789.0:e}] [{0.0:e}] [{1e100:.3e}] [{-1e-100:.3e}] [{5e-324:e}] [{5e-324:.3g}]')
    print(f'[{x:g}] [{x:.2g}] [{x:.4g}] [{x:10g}] [{x:.0g}] [{x:.1g}] [{100000.0:g}] [{1000000.0:g}] [{1e16:g}] [{0.0001:g}] [{0.00001:g}] [{123456789.0:g}] [{0.5:g}] [{100.0:g}] [{1e-300:g}] [{1.5e300:g}]')
    print(f'[{x:}] [{x:10}] [{x:<10}] [{x:^10}] [{x:010}] [{x:+}] [{x: }] [{1e16:}] [{1e16:25}] [{1.5e22:}] [{1e-5:}] [{1e-5:15}] [{100.0:}] [{100.0:8}] [{12345678.9:,}] [{123456789012345.0:,}] [{1e16:,}] [{1.5e-7:,}]')
    print(f'[{x:.3}] [{x:.1}] [{x:.0}] [{x:.10}] [{100.0:.3}] [{123.0:.3}] [{12.0:.3}] [{1.0:.3}] [{0.5:.3}] [{1e16:.3}] [{1e-5:.3}] [{0.0:.1}] [{0.0:.0}] [{123456.789:.2}] [{123456.789:.8}] [{9.995:.3}] [{99.5:.2}] [{2.5:.1}] [{-0.0:.2}] [{1234567.0:.7}] [{1234567.0:.8}] [{0.1:.17}]')

def negative_zero_and_ties():
    print(f'[{-0.0}] [{-0.0:f}] [{-0.0:.2f}] [{-0.0:+.1f}] [{-0.0: .1f}] [{-0.0:e}] [{-0.0:.0e}] [{-0.0:g}] [{-0.0:8.2f}] [{-0.0:08.2f}] [{-0.0:,.2f}] [{0.0:+.1f}] [{0.0:.1f}]')
    print(f'[{-0.001:.1f}] [{-0.001:.0f}] [{-0.4:.0f}] [{-0.5:.0f}] [{-1.5:.0f}] [{-0.04:.1f}] [{-0.001:+.2f}] [{-0.001:08.1f}] [{-0.0001:.3g}] [{-0.00000001:.2f}]')
    print(f'[{0.5:.0f}] [{1.5:.0f}] [{2.5:.0f}] [{3.5:.0f}] [{4.5:.0f}] [{-2.5:.0f}] [{0.25:.1f}] [{0.35:.1f}] [{0.125:.2f}] [{0.375:.2f}] [{2.675:.2f}] [{2.665:.2f}] [{1.005:.2f}] [{8.345:.2f}] [{1.015:.2f}] [{0.045:.2f}]')
    print(f'[{0.5:.0e}] [{1.5:.0e}] [{2.5:.0e}] [{25.0:.0e}] [{35.0:.0e}] [{0.125:.1e}] [{0.375:.1e}] [{1.25:.1e}] [{1.35:.1e}] [{12345.0:.3e}] [{12355.0:.3e}] [{9.5:.0e}] [{9.99:.1e}] [{99.99:.3g}] [{999.5:.3g}] [{0.5:.1g}] [{2.5:.1g}] [{3.5:.1g}]')
    print(f'[{9.9999999:.2f}] [{99.995:.2f}] [{0.9999:.2f}] [{0.9995:.3f}] [{0.99995:.4f}] [{9.5:.0f}] [{10.5:.0f}] [{999999.5:.0f}] [{1e15 + 0.5:.0f}] [{1e22:.0f}] [{1.5e22:.2f}] [{1e300:.1f}] [{0.1:.20f}] [{0.1:.30f}] [{1/3:.40f}]')

def big_integers():
    big = 10 ** 30 + 12345
    neg = -(10 ** 25) - 7
    edge = 4611686018427387904
    print(f'[{big}] [{big:d}] [{big:40}] [{big:<40}] [{big:^40}] [{big:>40}] [{big:040}] [{big:,}] [{big:45,}] [{big:045,}] [{big:+}] [{big: }] [{big:*^45,}]')
    print(f'[{neg}] [{neg:d}] [{neg:40}] [{neg:040}] [{neg:,}] [{neg:+,}] [{neg:045,}] [{neg:=^40}] [{neg:#>40}]')
    print(f'[{edge}] [{edge:,}] [{edge - 1:,}] [{-edge:,}] [{-edge - 1:,}] [{edge:25,}] [{edge:025,}] [{edge * 2:,}] [{edge * edge:,}] [{edge * edge * edge:30}] [{(10 ** 100):,}]')
    print(f'[{big:e}] [{big:.5e}] [{big:g}] [{big:.30g}] [{big:.2f}] [{big:f}] [{neg:e}] [{neg:.1f}] [{10 ** 22:.0f}] [{10 ** 22 + 1:.0f}] [{2 ** 70:,.1f}] [{2 ** 70:e}]')

def escapes_and_nesting():
    a = 5
    print(f'{{{a:>3}}} {{}} {{{{}}}} {{{a}}} {{{a:03}}} {{{a:<3}}}')
    print(f'{{a}}: {a:3}|{{b}}: {a:<3}|{{{a:^5}}}')
    print(f'{{{{{a:>4}}}}}')
    print(f'[{a:5}]' + f'[{a:<5}]' + f'[{a:^5}]' + f'[{a:>5}]')
    print(f"[{a:*>5}] [{'it':>6}]" + f'[{"say hi":>12}]')
    print(f'{a + 1:5} {a * 2:<5}| {a - 10:+5} {[1, 2, 3][1]:3} {len("abc"):02} {a // 2:>3} {a % 3:^3}|')
    table = {'k': 7}
    print(f'{table["k"]:4}|{table["k"]:<4}|{table["k"]:04}|')
    print(f'{a}:{a:2}:{a:02}:{a:+}:{a:,}:{a:.1f}:{a:e}')
    print(f'{1:}{2:3}{3:03}')
    print(f'{"x":>3}{"y":<3}{"z":^3}|')

def round_trips():
    for v in [0.1, 0.5, 1.0, 2.5, 100.0, 1e15, 1e16, 1.5e-5, 123.456, -0.0, 5e-324]:
        print(f'{v} {v:.3} {v:.3g} {v:.3f} {v:.3e} {v:10.4} {v:+g}')
    for k in [0, 1, -1, 9, 10, 99, 100, 999, 1000, 12345, -12345, 10 ** 18, -(10 ** 18), 2 ** 64]:
        print(f'{k} {k:5} {k:<8} {k:^9} {k:07} {k:,} {k:+} {k:+012,} {k: } {k:.2f} {k:.3e} {k:g}')
    for w in ['', 'a', 'ab', 'abc', 'abcdefgh', 'é', 'ñandú']:
        print(f'[{w:4}] [{w:>4}] [{w:^4}] [{w:.2}] [{w:5.1}] [{w:*^7}] [{w:03}]')

def grid_0():
    print(f'[{0:^ 8.10e}]')
    print(f'[{0:0> 03.10e}]')
    print(f'[{0:0> 3,.3f}]')
    print(f'[{0:.^20d}]')
    print(f'[{0: >+01.0f}]')
