# sin, cos and tan of radian angles against Python 3's math module (the C library), within one unit in the last place (see
# close), so the test holds on glibc, macOS and wasi-libc: multiples of pi/2, tiny, huge and random arguments (D77d). Generated by Python 3.
from math import sin, cos, tan, rad, deg, turn, pi

# one unit in the last place, except next to a zero of sin or cos (loose: one of them below 0.001), where a correct libm
# can be a few units off in cos and so in tan (wasi-libc at 5.3e255: 8): there 16 units, which the old reduction through
# turns still missed by far
def close(got: float, want: float, loose: bool) -> bool:
    if loose:
        return abs(got - want) <= 16.0 * 2.220446049250313e-16 * abs(want) + 1e-320
    return abs(got - want) <= 2.220446049250313e-16 * abs(want)

