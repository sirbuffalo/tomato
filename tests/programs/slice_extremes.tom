# Slices whose step, start or stop is the smallest or largest 64-bit number follow Python's rules like any other: the ends
# are clamped, and a step as big as the sequence (or bigger) takes only the first item it reaches.
@main
def main():
    low = -9223372036854775808
    high = 9223372036854775807
    print('abcdef'[::low], [1, 2, 3][::low], 'abcdef'[4:1:low], (1, 2, 3)[::low], len('abcdef'[1:4:low]))
    print('abcdef'[::high], [1, 2, 3][::high], 'abcdef'[2::high], (1, 2, 3)[1::high])
    print('abcdef'[low:high], [1, 2, 3][low:high], 'abcdef'[high:low:-1], [1, 2, 3][high:low:-2])
