from itertools import progressbar, repeat

@main
def main():
    bar = progressbar(repeat(0, 10), 'work', 10)
    print(bar.render())
    bar.count = 3
    print(bar.render())
    bar.count = 10
    print(bar.render())
    bar.count = 14
    print(bar.render())
    plain = progressbar(repeat(0, 4))
    plain.count = 1
    print(plain.render())
    unknown = progressbar(repeat(0, 0), 'seen')
    unknown.count = 7
    print(unknown.render())
