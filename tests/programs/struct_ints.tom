import struct

@main
def main():
    print(struct.pack_ints('>BxHq', [255, 4660, -2]))
    print(struct.unpack_ints('>BxHq', bytes([255, 0, 18, 52, 255, 255, 255, 255, 255, 255, 255, 254])))
    print(struct.calcsize('>BxHq'))
    print(struct.int_to_bytes(18446744073709551616, 9))
    print(struct.int_from_bytes(bytes([1, 0, 0, 0, 0, 0, 0, 0, 0])))
    print(struct.int_to_bytes(-1, 2, 'little', True), struct.int_from_bytes(b'\xff\xff', 'little', True))
    p = struct.Packer('>')
    p.u16(4660)
    p.i32(-2)
    p.text('hé')
    print(p.bytes())
    r = struct.Reader(p.bytes())
    print(r.read_u16(), r.read_i32(), r.read_text(3), r.remaining())
    r = struct.Reader(b'\xff')
    try:
        r.read_u16()
    catch ValueError:
        print('short', r.pos)
    try:
        r.read_text(1)
    catch ValueError:
        print('utf8', r.pos)
    try:
        struct.unpack_ints('>H', bytes([1]))
    catch struct.StructError:
        print('StructError')
    try:
        struct.pack_ints('B', [256])
    catch OverflowError:
        print('OverflowError')
    print(struct.pack_ints('<2b', [-128, 127]))
    try:
        struct.pack_ints('<b', [128])
    catch OverflowError:
        print('overflow')
    print(struct.pack_ints('<2B', [0, 255]))
    try:
        struct.pack_ints('<B', [256])
    catch OverflowError:
        print('overflow')
    print(struct.pack_ints('<2h', [-32768, 32767]))
    try:
        struct.pack_ints('<h', [32768])
    catch OverflowError:
        print('overflow')
    print(struct.pack_ints('<2H', [0, 65535]))
    try:
        struct.pack_ints('<H', [65536])
    catch OverflowError:
        print('overflow')
    print(struct.pack_ints('<2i', [-2147483648, 2147483647]))
    try:
        struct.pack_ints('<i', [2147483648])
    catch OverflowError:
        print('overflow')
    print(struct.pack_ints('<2I', [0, 4294967295]))
    try:
        struct.pack_ints('<I', [4294967296])
    catch OverflowError:
        print('overflow')
    print(struct.pack_ints('<2l', [-2147483648, 2147483647]))
    try:
        struct.pack_ints('<l', [2147483648])
    catch OverflowError:
        print('overflow')
    print(struct.pack_ints('<2L', [0, 4294967295]))
    try:
        struct.pack_ints('<L', [4294967296])
    catch OverflowError:
        print('overflow')
    print(struct.pack_ints('<2q', [-9223372036854775808, 9223372036854775807]))
    try:
        struct.pack_ints('<q', [9223372036854775808])
    catch OverflowError:
        print('overflow')
    print(struct.pack_ints('<2Q', [0, 18446744073709551615]))
    try:
        struct.pack_ints('<Q', [18446744073709551616])
    catch OverflowError:
        print('overflow')
    print(struct.pack_ints('>2b', [-128, 127]))
    try:
        struct.pack_ints('>b', [128])
    catch OverflowError:
        print('overflow')
    print(struct.pack_ints('>2B', [0, 255]))
    try:
        struct.pack_ints('>B', [256])
    catch OverflowError:
        print('overflow')
    print(struct.pack_ints('>2h', [-32768, 32767]))
    try:
        struct.pack_ints('>h', [32768])
    catch OverflowError:
        print('overflow')
    print(struct.pack_ints('>2H', [0, 65535]))
    try:
        struct.pack_ints('>H', [65536])
    catch OverflowError:
        print('overflow')
    print(struct.pack_ints('>2i', [-2147483648, 2147483647]))
    try:
        struct.pack_ints('>i', [2147483648])
    catch OverflowError:
        print('overflow')
    print(struct.pack_ints('>2I', [0, 4294967295]))
    try:
        struct.pack_ints('>I', [4294967296])
    catch OverflowError:
        print('overflow')
    print(struct.pack_ints('>2l', [-2147483648, 2147483647]))
    try:
        struct.pack_ints('>l', [2147483648])
    catch OverflowError:
        print('overflow')
    print(struct.pack_ints('>2L', [0, 4294967295]))
    try:
        struct.pack_ints('>L', [4294967296])
    catch OverflowError:
        print('overflow')
    print(struct.pack_ints('>2q', [-9223372036854775808, 9223372036854775807]))
    try:
        struct.pack_ints('>q', [9223372036854775808])
    catch OverflowError:
        print('overflow')
    print(struct.pack_ints('>2Q', [0, 18446744073709551615]))
    try:
        struct.pack_ints('>Q', [18446744073709551616])
    catch OverflowError:
        print('overflow')
    print(struct.unpack_ints('<2b', bytes([128, 127])))
    try:
        struct.pack_ints('<b', [-129])
    catch OverflowError:
        print('underflow')
    print(struct.unpack_ints('<2B', bytes([0, 255])))
    try:
        struct.pack_ints('<B', [-1])
    catch OverflowError:
        print('underflow')
    print(struct.unpack_ints('<2h', bytes([0, 128, 255, 127])))
    try:
        struct.pack_ints('<h', [-32769])
    catch OverflowError:
        print('underflow')
    print(struct.unpack_ints('<2H', bytes([0, 0, 255, 255])))
    try:
        struct.pack_ints('<H', [-1])
    catch OverflowError:
        print('underflow')
    print(struct.unpack_ints('<2i', bytes([0, 0, 0, 128, 255, 255, 255, 127])))
    try:
        struct.pack_ints('<i', [-2147483649])
    catch OverflowError:
        print('underflow')
    print(struct.unpack_ints('<2I', bytes([0, 0, 0, 0, 255, 255, 255, 255])))
    try:
        struct.pack_ints('<I', [-1])
    catch OverflowError:
        print('underflow')
    print(struct.unpack_ints('<2l', bytes([0, 0, 0, 128, 255, 255, 255, 127])))
    try:
        struct.pack_ints('<l', [-2147483649])
    catch OverflowError:
        print('underflow')
    print(struct.unpack_ints('<2L', bytes([0, 0, 0, 0, 255, 255, 255, 255])))
    try:
        struct.pack_ints('<L', [-1])
    catch OverflowError:
        print('underflow')
    print(struct.unpack_ints('<2q', bytes([0, 0, 0, 0, 0, 0, 0, 128, 255, 255, 255, 255, 255, 255, 255, 127])))
    try:
        struct.pack_ints('<q', [-9223372036854775809])
    catch OverflowError:
        print('underflow')
    print(struct.unpack_ints('<2Q', bytes([0, 0, 0, 0, 0, 0, 0, 0, 255, 255, 255, 255, 255, 255, 255, 255])))
    try:
        struct.pack_ints('<Q', [-1])
    catch OverflowError:
        print('underflow')
    print(struct.unpack_ints('>2b', bytes([128, 127])))
    try:
        struct.pack_ints('>b', [-129])
    catch OverflowError:
        print('underflow')
    print(struct.unpack_ints('>2B', bytes([0, 255])))
    try:
        struct.pack_ints('>B', [-1])
    catch OverflowError:
        print('underflow')
    print(struct.unpack_ints('>2h', bytes([128, 0, 127, 255])))
    try:
        struct.pack_ints('>h', [-32769])
    catch OverflowError:
        print('underflow')
    print(struct.unpack_ints('>2H', bytes([0, 0, 255, 255])))
    try:
        struct.pack_ints('>H', [-1])
    catch OverflowError:
        print('underflow')
    print(struct.unpack_ints('>2i', bytes([128, 0, 0, 0, 127, 255, 255, 255])))
    try:
        struct.pack_ints('>i', [-2147483649])
    catch OverflowError:
        print('underflow')
    print(struct.unpack_ints('>2I', bytes([0, 0, 0, 0, 255, 255, 255, 255])))
    try:
        struct.pack_ints('>I', [-1])
    catch OverflowError:
        print('underflow')
    print(struct.unpack_ints('>2l', bytes([128, 0, 0, 0, 127, 255, 255, 255])))
    try:
        struct.pack_ints('>l', [-2147483649])
    catch OverflowError:
        print('underflow')
    print(struct.unpack_ints('>2L', bytes([0, 0, 0, 0, 255, 255, 255, 255])))
    try:
        struct.pack_ints('>L', [-1])
    catch OverflowError:
        print('underflow')
    print(struct.unpack_ints('>2q', bytes([128, 0, 0, 0, 0, 0, 0, 0, 127, 255, 255, 255, 255, 255, 255, 255])))
    try:
        struct.pack_ints('>q', [-9223372036854775809])
    catch OverflowError:
        print('underflow')
    print(struct.unpack_ints('>2Q', bytes([0, 0, 0, 0, 0, 0, 0, 0, 255, 255, 255, 255, 255, 255, 255, 255])))
    try:
        struct.pack_ints('>Q', [-1])
    catch OverflowError:
        print('underflow')
    try:
        struct.calcsize('>4')
    catch struct.StructError:
        print('bad format')
    try:
        struct.unpack_ints('B', bytes([1, 2]))
    catch struct.StructError:
        print('long buffer')
    try:
        struct.pack_ints('2B', [1])
    catch struct.StructError:
        print('value count')
    p = struct.Packer()
    p.u8(7)
    p.raw(b'\x03\xff')
    print(p.bytes())
    # an absurd repeat count is refused, not expanded
    for fmt in ['999999999999i', '1000001b', '600000b600000b']:
        try:
            print(struct.calcsize(fmt))
        catch struct.StructError as e:
            print(fmt, e.id)
