# html.escape and html.unescape against Python 3 html (expected output generated with python3 as an oracle only).
import html

def show_escape(text: str):
    print(f'{html.escape(text)}|{html.escape(text, False)}')

def show(text: str):
    print(f'[{html.unescape(text)}]')

# the category of the result of &#N; for every number N, printed where it changes
def category(n: int) -> str:
    result = html.unescape(f'&#{n};')
    if result == '':
        return 'dropped'
    if result == chr(65533):
        return 'replacement'
    if n < 1114112 and (n < 55296 or n > 57343) and result == chr(n):
        return 'same'
    return f'maps to {ord(result)}'

def probes() -> list[int]:
    out: list[int] = []
    for n in range(0, 200):
        out.append(n)
    for n in range(55290, 55300):
        out.append(n)
    for n in range(57340, 57350):
        out.append(n)
    for n in range(64970, 65010):
        out.append(n)
    for plane in range(0, 17):
        for n in range(plane * 65536 + 65530, plane * 65536 + 65541):
            out.append(n)
    out.append(1114112)
    out.append(99999999)
    return out

@main
def main():
    show_escape('')
    show_escape('a')
    show_escape('<')
    show_escape('>')
    show_escape('&')
