    show('&Gt;&gt;&GT&gt&Lt;&lt')
    show('&lg;&lE;&le;&LE;')
    show('&bigstar;&bigtriangleup;')
    show('&ngE;&nGt;&nGtv;')
    # the numbers around every boundary: the low controls, the Windows-1252 range, surrogates, the noncharacters
    # U+FDD0-FDEF and U+xFFFE/U+xFFFF of every plane, and the end of Unicode
    for n in probes():
        print(n, category(n))
    print(html.unescape('&#x1f600;&#X1F600;&#128512') == html.unescape('&#128512;&#128512;&#128512;'))
