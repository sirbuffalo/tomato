class Box:
    n: int = 0

    @init
    def make(self, n: int):
        self.n = n

@main
def main():
    s = 'héllo'
    print(s[-1], s[-5], s[1:-1], s[::-1])
    t = [1, 2, 3]
    t[-1] = 7
    print(t, t[-3])
    for i, x in enumerate(t):
        print(i, x)
    bs: list[Box] = [Box(1), Box(2)]
    for b in bs[1:]:
        print(b.n)
    nested: list[list[str]] = [['a'], ['b', 'c']]
    print(nested[::-1], sorted([3, 1, 2])[:2])
    print(sum([1, 2, 3]) * 2, max(['b', 'a']))
    try:
        print(min([0 * 1][1:]))
    catch RuntimeError as e:
        print('caught', e.message)
