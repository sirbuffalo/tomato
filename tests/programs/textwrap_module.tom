    print('dedent18', '|' + field(dedent('  a\n\n\n  b')) + '|')
    print('dedent19', '|' + field(dedent('        deep\n    shallow\n          deeper')) + '|')
    print('dedent20', '|' + field(dedent('\t\ta\n\t\t\tb')) + '|')
    print('dedent21', '|' + field(dedent('  a\r\n  b\r\n')) + '|')
    print('dedent22', '|' + field(dedent('no indent\n  indent')) + '|')
    print('dedent23', '|' + field(dedent('  # comment\n  code')) + '|')
    print('dedent24', '|' + field(dedent('ab\nac')) + '|')
    print('dedent25', '|' + field(dedent('  \n  \n')) + '|')
    print('dedent26', '|' + field(dedent('a\n \nb')) + '|')
    print('dedent27', '|' + field(dedent('   a\n  　\n   b')) + '|')
    print('indent0', '|' + field(indent('a\nb\n', '> ')) + '|')
    print('indent1', '|' + field(indent('a\n\nb\n', '> ')) + '|')
    print('indent2', '|' + field(indent('a\n  \nb', '> ')) + '|')
