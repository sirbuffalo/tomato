# std/textwrap.tom: wrap, fill, dedent, indent and shorten; expected output comes from Python's textwrap as an oracle
from textwrap import wrap, fill, dedent, indent, shorten

def field(f: str) -> str:
    return f.replace('\\', '\\\\').replace('\n', '\\n').replace('\r', '\\r').replace('\t', '\\t')

def show_lines(label: str, lines: list[str]):
    print(label, len(lines))
    for line in lines:
        print('  |' + field(line) + '|')

def try_wrap(label: str, text: str, width: int):
    try:
        show_lines(label, wrap(text, width))
        if fill(text, width) != '\n'.join(wrap(text, width)):
            print(label, 'fill differs')
    catch ValueError as e:
        print(label, 'ValueError:', e.message)

def try_shorten(label: str, text: str, width: int, placeholder: str):
    try:
        print(label, '|' + field(shorten(text, width, placeholder)) + '|')
    catch ValueError as e:
        print(label, 'ValueError:', e.message)

@main
def main():
    print(wrap('hello world'), fill('hello world'), len(wrap('word ' * 30)))
    print('|' + shorten('hello world, this is a default placeholder test and more text', 40) + '|')
    try_wrap('wrap0', 'The quick brown fox jumps over the lazy dog. Pack my box with five dozen liquor jugs! How vexingly quick daft zebras jump?', 70)
    try_wrap('wrap1', 'The quick brown fox jumps over the lazy dog. Pack my box with five dozen liquor jugs! How vexingly quick daft zebras jump?', 20)
    try_wrap('wrap2', 'The quick brown fox jumps over the lazy dog. Pack my box with five dozen liquor jugs! How vexingly quick daft zebras jump?', 10)
    try_wrap('wrap3', 'The quick brown fox jumps over the lazy dog. Pack my box with five dozen liquor jugs! How vexingly quick daft zebras jump?', 1)
    try_wrap('wrap4', 'The quick brown fox jumps over the lazy dog. Pack my box with five dozen liquor jugs! How vexingly quick daft zebras jump?', 40)
    try_wrap('wrap5', '', 10)
    try_wrap('wrap6', '   ', 10)
    try_wrap('wrap7', 'a', 1)
    try_wrap('wrap8', 'hello', 3)
    try_wrap('wrap9', 'supercalifragilisticexpialidocious', 10)
    try_wrap('wrap10', 'well-known state-of-the-art self-explanatory re-entrant words', 12)
    try_wrap('wrap11', 'a--b---c -- d --e-- f', 6)
    try_wrap('wrap12', 'Look, goof-ball -- use the -b option!', 10)
    try_wrap('wrap13', 'foo-bar-baz-qux-quux', 8)
    try_wrap('wrap14', 'x-y-z-w-v-u', 3)
    try_wrap('wrap15', '--------------------', 7)
    try_wrap('wrap16', 'ab-----cd-ef', 5)
    try_wrap('wrap17', '1234-5678-9012', 6)
    try_wrap('wrap18', 'end- of -start', 5)
    try_wrap('wrap19', 'tab\tseparated\ttext here\tand more', 12)
    try_wrap('wrap20', '\tindented', 6)
    try_wrap('wrap21', 'abc\tdef\n\tghi\rjkl' + chr(11) + 'mno' + chr(12) + 'pqr', 10)
    try_wrap('wrap22', 'line one\nline two\n\nline four', 9)
    try_wrap('wrap23', '  leading and trailing spaces  ', 8)
    try_wrap('wrap24', 'a  b   c    d', 4)
    try_wrap('wrap25', 'multiple    spaces    inside    text', 14)
    try_wrap('wrap26', 'non breaking space and  em space', 10)
    try_wrap('wrap27', '   ', 2)
    try_wrap('wrap28', 'word   word', 3)
    try_wrap('wrap29', '日本語のテキストを折り返す', 5)
    try_wrap('wrap30', 'héllo wörld naïve café', 7)
    try_wrap('wrap31', 'snake_case_word another_word', 10)
    try_wrap('wrap32', 'it\'s a "quoted" text -- really', 9)
    try_wrap('wrap33', 'a-b', 2)
    try_wrap('wrap34', 'a-b', 3)
    try_wrap('wrap35', 'ab-cd', 3)
    try_wrap('wrap36', 'abc-de-fg-hi', 4)
    try_wrap('wrap37', 'word word word word word word word word word word word word word word word word word word word word word word word word word word word word word word ', 33)
    try_wrap('wrap38', 'xxxxxxxxxxxxxxxxxxxxxxxxx', 10)
    try_wrap('wrap39', 'aaa bbbbbbbbbbbbb ccc', 5)
    try_wrap('wrap40', '  x', 1)
    try_wrap('wrap41', 'a b', 1)
    try_wrap('wrap42', '1-2-3-4', 3)
    try_wrap('wrap43', 'well--known', 6)
    try_wrap('wrap44', 're-e-nter', 4)
    try_wrap('wrap45', 'under_score-dash', 7)
    try_wrap('wrap46', '...--...', 4)
    try_wrap('wrap47', 'a b', 5)
    try_wrap('badwidth0', 'abc def', 0)
    try_shorten('shortbadwidth0', 'abc def', 0, ' [...]')
    try_wrap('badwidth1', 'abc def', -1)
    try_shorten('shortbadwidth1', 'abc def', -1, ' [...]')
    try_wrap('badwidth2', 'abc def', -70)
    try_shorten('shortbadwidth2', 'abc def', -70, ' [...]')
    try_shorten('shorten0', 'Hello  world!', 12, ' [...]')
    try_shorten('shorten1', 'Hello  world!', 11, ' [...]')
    try_shorten('shorten2', 'Hello world', 5, ' [...]')
    try_shorten('shorten3', '  Hello  \t world\n and more words here  ', 20, ' [...]')
    try_shorten('shorten4', 'Hello world', 11, ' [...]')
    try_shorten('shorten5', 'Hello world', 100, ' [...]')
    try_shorten('shorten6', '', 10, ' [...]')
    try_shorten('shorten7', '   ', 4, ' [...]')
    try_shorten('shorten8', 'one two three four five six', 16, '...')
    try_shorten('shorten9', 'one two three four five six', 16, ' (more)')
    try_shorten('shorten10', 'one two three four five six', 7, ' [...]')
    try_shorten('shorten11', 'one two three four five six', 6, ' [...]')
    try_shorten('shorten12', 'a very long-hyphenated-word and others', 14, ' [...]')
    try_shorten('shorten13', ' Hello  world　again ', 14, ' [...]')
    try_shorten('shorten14', 'supercalifragilistic word', 12, ' [...]')
    try_shorten('shorten15', 'x y z', 3, ' [...]')
    try_shorten('shorten16', 'Hello world', 8, '')
    try_shorten('shorten17', 'alpha beta gamma delta', 12, ' ...')
    try_shorten('shorten18', 'hello', 5, ' [...]')
    try_shorten('shorten19', 'hello world', 10, '[...]')
    try_shorten('shorten20', 'héllo wörld naïve café', 15, ' …')
    try_shorten('shorten21', 'abc def', 3, '  ')
    try_shorten('shorten22', '日本語 のテキスト を折り返す', 8, '…')
    for text in ['a b', 'c d']:
        print(dedent('  ' + text))
    print('dedent0', '|' + field(dedent('    a\n      b\n    c\n')) + '|')
    print('dedent1', '|' + field(dedent('  \thello\n  \tworld')) + '|')
    print('dedent2', '|' + field(dedent('\thello\n  world')) + '|')
    print('dedent3', '|' + field(dedent('  hello\n\tworld')) + '|')
    print('dedent4', '|' + field(dedent('a\n  b')) + '|')
    print('dedent5', '|' + field(dedent('    a\n\n    b\n')) + '|')
    print('dedent6', '|' + field(dedent('    a\n  \n    b\n')) + '|')
    print('dedent7', '|' + field(dedent('    a\n \t \n    b\n')) + '|')
    print('dedent8', '|' + field(dedent('')) + '|')
