# Every operation that takes or gives a big number, in the places a temporary can be: operands, arguments, conditions,
# conditional expressions, f-strings, comprehensions, conversions and compound assignments. Each must free what it
# made and leave its operands alone (the debug leak check and AddressSanitizer watch).
class Acc:
    total: int = 0
    log: list[int] = []

    def add(self, x: int):
        self.total += x
        self.log.append(self.total)

def huge(n: int) -> int:
    r = 1
    for i in range(1, n + 1):
        r *= i
    return r

def twice(x: int) -> int:
    return x + x

def clamp(x: int, hi: int) -> int:
    if x > hi:
        return hi
    return x

def fixed(x: int) -> int[length=64]:
    return int[length=64](x % 1000)

@main
def main():
    a = huge(25)
    b = huge(24)
    print(a + b == b * 26 + b, a - b < a, a * b > a, -a + a == 0)
    print(a // b, a % 1000, a // -b, -a // b, a % -7, -a % 7)
    print(abs(-a) == a, abs(a) == a, abs(5) == 5)
    print(a ** 2 // a == a, 3 ** 50 > 2 ** 70, (a + 1) ** 3 > a)
    print(a & 1 if a < 100 else 0, 6 & 3, 6 | 3, 6 ^ 3)
    x = a
    x += b
    x -= b
    x *= 2
    x //= 2
    x %= huge(26)
    print(x == a)
    print(f'{a} and {b + 1}')
    print(str(a * a)[:10], len(str(a)), str(-a)[0:3])
    c = a if a > b else b
    d = b if a > b else a
    print(c == a, d == b)
    e = [huge(20 + i) for i in range(4)]
    f = [x * 2 for x in e if x > huge(20)]
    print(len(e), len(f), f[0] == e[1] * 2)
    g = [clamp(v, huge(22)) for v in e]
    print(g[3] == huge(22), g[0] == huge(20))
    print(twice(twice(a)) == a * 4, twice(a) > a, twice(huge(3)))
    print(float(a) > 1.0e24, float(huge(3)), a / b, int(float(huge(18))) > 0)
    print(int[length=64](b % 1000), fixed(a), uint[length=8](a % 100))
    s = 0
    for v in e:
        s += v
    print(s > 0)
    k = 0
    while huge(k + 15) < huge(19):
        k += 1
    print(k)
    acc = Acc()
    for v in e:
        acc.add(v)
        acc.total = acc.total - 1
    print(acc.total > 0, len(acc.log), acc.log[0] == e[0])
    acc.total += a
    acc.total = acc.total * acc.total
    h = [a, b]
    h[0], h[1] = h[1], h[0]
    h[0] += 1
    h[1] *= h[0]
    print(h[0] == b + 1, h[1] == a * (b + 1))
    n = len(h) + len(e)
    print(n, e[0] < e[1] and e[1] < e[2], e[-1] == e[3], e[1:3][0] == e[1])
    q = (a, b, 1)
    r, s2, t = q
    print(r > s2, t)
    i = 0
    total = 0
    while i < 4:
        total = total + e[i] % 1000 + (i if i % 2 == 0 else -i)
        i += 1
    print(total)
    z = 0
    z = z + a * 0
    print(z, a * 0 == 0, a - a == 0, a // a == 1)
    big_neg = -(a * a)
    print(big_neg < 0, big_neg + a * a, big_neg // a == -a)
    m = 2 ** 62
    print(m, m - 1, m + 1, -m, -m - 1, 2 ** 63, -(2 ** 63), 4611686018427387903 + 1)
    print(m * 2 == 2 ** 63, (m + m) // 2 == m, huge(21) // huge(20))
    # Exact and inexact division across 64-bit word boundaries, for each sign pair.
    for bits in [63, 64, 65, 127, 128, 129, 191, 192, 193]:
        divisor = 2 ** bits + 3
        quotient = 2 ** (bits + 5) + 7
        dividend = divisor * quotient + 2
        print(dividend // divisor == quotient, dividend % divisor == 2,
              -dividend // divisor == -quotient - 1, -dividend % divisor == divisor - 2,
              dividend // -divisor == -quotient - 1, dividend % -divisor == 2 - divisor,
              -dividend // -divisor == quotient, -dividend % -divisor == -2,
              (divisor * quotient) // -divisor == -quotient, (divisor * quotient) % -divisor == 0)
