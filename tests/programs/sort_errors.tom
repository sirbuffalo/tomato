class Item:
    name: str
    n: int

    @init
    def make(self, name: str, n: int):
        self.name = name
        self.n = n

def bad_key(it: Item) -> int:
    if it.n == 3:
        raise RuntimeError('no threes')
    return it.n

def bad_cmp(a: Item, b: Item) -> int:
    if a.n + b.n == 7:
        raise RuntimeError('seven')
    return a.n - b.n

def is_even(it: Item) -> bool:
    return it.n % 2 == 0

def name_of(it: Item) -> str:
    return it.name + '!'

@main
def main():
    items: list[Item] = []
    for i in range(10):
        items.append(Item(f'n{i}', i))
    try:
        sorted(items, key=bad_key)
    catch RuntimeError as e:
        print('key failed:', e.message)
    try:
        sorted(items, cmp=bad_cmp)
    catch RuntimeError as e:
        print('cmp failed:', e.message)
    print(len(filter(is_even, items)))
    for s in map(name_of, items):
        print(s)
    for it in sorted(items, key=name_of):
        print(it.name)
