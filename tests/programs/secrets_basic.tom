# std/secrets.tom: lengths, byte ranges, hex text, bounds and errors. The values are random, so only facts that hold
# for every run are printed.
from secrets import token_bytes, token_hex, randbelow

def attempt(what: int):
    try:
        if what == 0:
            print(token_bytes(-1))
        elif what == 1:
            print(token_hex(-5))
        elif what == 2:
            print(randbelow(0))
        else:
            print(randbelow(-7))
    catch ValueError as e:
        print('ValueError:', e.message, e.id)

@main
def main():
    print(len(token_bytes()), len(token_bytes(0)), len(token_bytes(1)), len(token_bytes(1000)))
    print(len(token_hex()), token_hex(0) == '', len(token_hex(3)), len(token_hex(600)))
    values = token_bytes(5000)
    distinct: dict[str, bool] = {}
    for b in values:
        distinct[str(b)] = True
    print(min(values) >= 0, max(values) <= 255, len(distinct) > 200)
    text = token_hex(16)
    digits = '0123456789abcdef'
    hex_only = True
    for c in text:
        if c not in digits:
            hex_only = False
    print(hex_only)
    # two tokens do not repeat (a chance of 2**-128 per run)
    print(token_hex(16) != token_hex(16), token_bytes(16) != token_bytes(16))
    # randbelow stays below its bound, reaches 0 and the top of a small range, and handles huge bounds
    print(randbelow(1), randbelow(1))
    seen = [False, False, False, False, False, False, False]
    for i in range(500):
        v = randbelow(7)
        seen[v] = True
        if v < 0 or v >= 7:
            print('out of range', v)
    print(seen)
    big = 10 ** 40
    ok = True
    for i in range(50):
        v = randbelow(big)
        if v < 0 or v >= big:
            ok = False
    print(ok)
    top = 0
    for i in range(50):
        top = max(top, randbelow(2 ** 70))
    print(top > 2 ** 60)
    attempt(0)
    attempt(1)
    attempt(2)
    attempt(3)
