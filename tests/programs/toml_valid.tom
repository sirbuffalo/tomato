# TOML v1.0.0 documents that must load (and survive dumps then loads); the cases follow the toml-test valid categories.
from toml_show import run

@main
def main():
    run('aot', ['[[p]]', 'n = 1', '[p.sub]', 'k = 1', '[[p]]', 'n = 2', '[[p]]', 'n = 3', '[[p.q]]', 'r = 1'])
    run('arrays', ['a = [1, 2, 3]', 'b = [ "a", "b" , ]', 'c = [1, "a", [2, 3], {x = 1}]', 'd = [', '  1, # one', '  2,', ']', 'e = []'])
    run('basic', ['a = 1', 'b = "x"', "c = 'y'", 'd = true', 'e = 1.5'])
    run('bom', ['﻿a = 1'])
    run('comments', ['# top', 'a = 1 # trailing', '# end'])
    run('crlf', ['a = 1\r', 'b = "x"\r'])
    run('dates', ['a = 1979-05-27T07:32:00Z', 'b = 1979-05-27T00:32:00-07:00', 'c = 1979-05-27T00:32:00.999999-07:00', 'd = 1979-05-27 07:32:00', 'e = 1979-05-27', 'f = 07:32:00', 'g = 00:32:00.999999', 'h = 1979-05-27 07:32:00Z'])
    run('dotted-sub-ok', ['[fruit]', 'apple.color = "red"', '[fruit.apple.texture]', 'smooth = true'])
    run('empty', [''])
    run('esc-all', ['a = "\\b\\t\\n\\f\\r\\"\\\\"'])
    run('float-exact', ['a = 0.30000000000000004', 'b = 5e-324', 'c = 1.7976931348623157e308', 'd = 123456789.12345678'])
    run('f10', ['a = 0e0', 'b = -inf', 'c = +nan', 'd = 1E3'])
    run('f12', ['a = 1.0e1_0'])
    run('f3', ['a = +1_0'])
    run('f6', ['a = 1_000.0'])
    run('floats', ['a = 3.14', 'b = -0.01', 'c = 5e+22', 'd = 1e06', 'e = -2E-2', 'f = 6.626e-34', 'g = 224_617.445_991_228', 'h = inf', 'i = -inf', 'j = nan', 'k = +inf', 'l = -0.0'])
    run('frac-local', ['a = 1979-05-27T07:32:00.5'])
    run('hdr-comment', ['[a]  # c', 'x = 1 ', '  [b]', '  y = 2'])
    run('implicit-then-header', ['[a.b]', '[a]', 'x = 1'])
    run('inline', ['a = { b = 1, c.d = 2, e = { f = [1, 2] } }', 'g = {}'])
    run('ints', ['a = +99', 'b = -17', 'c = 1_000', 'd = 0xDEAD_beef', 'e = 0o755', 'f = 0b1101', 'g = 0', 'h = -0', 'i = 9223372036854775807', 'j = -9223372036854775808'])
    run('ml-arr', ['a = [ # c', '  { x = 1 }, # d', '  [ 1, 2 ] ,', '', ']', 'b = 1'])
    run('ml-crlf', ['a = """\r', 'x\r', 'y"""\r'])
    run('ml-lit-quotes', ["a = '''x''''", "b = '''y'''''"])
    run('quotedkeys', ['"a b" = 1', "'c.d' = 2", 'e."f g".h = 3', '"" = 4'])
    run('strings', ['a = "tab\\there \\u00e9 \\U0001F600 q\\" b\\\\"', "b = 'C:\\path\\n'", 'c = """', 'line1', 'line2 \\', '   continued', 'q"" end"""', "d = '''", 'raw \\n', "''''", 'e = "é日本"'])
    run('tab-ok', ['a = "x\ty"', 'b = [\t1,\t2\t]'])
    run('table-array-sub-order', ['[[a]]', '[a.b]', 'x=1', '[[a]]', '[a.b]', 'x=2'])
    run('tables', ['[a]', 'x = 1', '[a.b]', 'y = 2', '[c]', 'z.w = 3', 'z.v = 4', '[d.e.f]', 'q = 1'])
    run('ws-dots', ['a . b . c = 1', '[ x . "y" ]', 'z = 2'])
