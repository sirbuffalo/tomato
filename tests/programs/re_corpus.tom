# Oracle rows are JSON lines generated by Python 3.14; Python is not needed to run this test.
from json import loads, dumps
from value import Value, List, Int, Str, Null
from re import compile, Match

def spans(m: Match | None, groups: int) -> Value:
    if m is None:
        return Null()
    result: list[Value] = []
    for i in range(groups + 1):
        pair: list[Value] = [Int(m.start(i)), Int(m.end(i))]
        result.append(List(pair))
    return List(result)

def strings(values: list[str]) -> Value:
    result: list[Value] = []
    for value in values:
        result.append(Str(value))
    return List(result)

def same(row: Value, field: str, actual: Value, number: int) -> bool:
    expected = dumps(row[field])
    got = dumps(actual)
    if expected != got:
        print('case', number, field, 'expected', expected, 'got', got)
        return False
    return True

@main
def main(root: str = '.'):
    f = open(root + '/tests/regex/cases.txt')
    data = f.read()
    f.close()
    count = 0
    failed = 0
    for line in data.splitlines():
        row = loads(line)
        p = compile(row['pattern'].as_str(), row['flags'].as_int())
        text = row['text'].as_str()
        count += 1
        ok = same(row, 'match', spans(p.match(text), p.groups), count)
        ok = same(row, 'search', spans(p.search(text), p.groups), count) and ok
        ok = same(row, 'fullmatch', spans(p.fullmatch(text), p.groups), count) and ok
        all_spans: list[Value] = []
        for m in p.finditer(text):
            all_spans.append(spans(m, p.groups))
        ok = same(row, 'finditer', List(all_spans), count) and ok
        ok = same(row, 'findall', strings(p.findall(text)), count) and ok
        grouped: list[Value] = []
        for group in p.findall_groups(text):
            grouped.append(strings(group))
        ok = same(row, 'findall_groups', List(grouped), count) and ok
        ok = same(row, 'split', strings(p.split(text)), count) and ok
        ok = same(row, 'sub', Str(p.sub(row['template'].as_str(), text)), count) and ok
        if not ok:
            failed += 1
    print('ok', count - failed, '/', count)
