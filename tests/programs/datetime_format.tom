# The isoformat / str / strftime of std/datetime.tom against real Python 3 (expected output generated by python's datetime
# module as an oracle). 100000 as an offset means naive.
from datetime import date, time, datetime

def mk(y: int, m: int, d: int, hh: int, mm: int, ss: int, us: int, off: int) -> datetime:
    if off == 100000:
        return datetime(y, m, d, hh, mm, ss, us)
    return datetime(y, m, d, hh, mm, ss, us, off)

def dtshow(y: int, m: int, d: int, hh: int, mm: int, ss: int, us: int, off: int):
    x = mk(y, m, d, hh, mm, ss, us, off)
    print(f'{x}|{x.isoformat()}')

def dtfmt(y: int, m: int, d: int, hh: int, mm: int, ss: int, us: int, off: int, fmt: str):
    print(mk(y, m, d, hh, mm, ss, us, off).strftime(fmt))

def dateshow(y: int, m: int, d: int):
    x = date(y, m, d)
    print(f'{x}|{x.isoformat()}')

def datefmt(y: int, m: int, d: int, fmt: str):
    print(date(y, m, d).strftime(fmt))

def timeshow(hh: int, mm: int, ss: int, us: int):
    x = time(hh, mm, ss, us)
    print(f'{x}|{x.isoformat()}')

def timefmt(hh: int, mm: int, ss: int, us: int, fmt: str):
    print(time(hh, mm, ss, us).strftime(fmt))

