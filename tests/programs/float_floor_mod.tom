# float // and % as Python gives them: the remainder is exact (fmod) with the divisor's sign (a zero too) and the quotient follows from it,
# so floor(x / y) of the rounded quotient is no longer one too big (3.7 // 1e-5 is 369999.0). Floats beyond a double's range (a box
# with an exponent of any size) are exact too: the floor of the true quotient, rounded once. The expected output is Python 3.14's
# (checked on these lines and on 120,000 random pairs; the box lines against exact fractions)
def pair(x: float, y: float):
    print(x, y, '->', x // y, x % y)

def zero(x: float) -> float:
    return x - x

def parts(x: float, y: float) -> bool:
    return (x // y) * y + x % y == x

@main
def main():
    # floor(x / y) of the rounded quotient was one too big here
    pair(3.7, 1e-5)
    pair(-3.7, 1e-5)
    pair(3.7, -1e-5)
    pair(1.0, 0.1)
    pair(0.3, 0.1)
    pair(1e15 + 0.5, 0.1)
    # signs: the result of % has the sign of the divisor, also when it is zero
    pair(7.5, 2.0)
    pair(-7.5, 2.0)
    pair(7.5, -2.0)
    pair(-7.5, -2.0)
    pair(6.0, 2.0)
    pair(-6.0, 2.0)
    pair(6.0, -2.0)
    pair(-6.0, -2.0)
    pair(0.0, 2.0)
    pair(0.0, -2.0)
    pair(-0.0, 2.0)
    pair(-0.0, -2.0)
    pair(2.0 ** 64, -1.0)
    pair(-2.0 ** 64, 1.0)
    pair(1.0, 2.0)
    pair(-1.0, 2.0)
    pair(1.0, -2.0)
    pair(-1.0, -2.0)
    pair(1e-300, 1e300)
    pair(-1e-300, 1e300)
    pair(1e-300, -1e300)
    # a tiny remainder moved by the divisor rounds to the divisor
    pair(-1e-30, 1.0)
    pair(1e-30, -1.0)
    # large quotients
    pair(1e22, 3.0)
    pair(-1e22, 7.0)
    pair(1.7976931348623157e308, 1e-300)
    pair(2.0 ** 1000, 3.0)
    pair(2.0 ** 60, 0.1)
    # the quotient is out of a double's range: the exact floor, as a float of any size
    pair(1.7976931348623157e308, 2.2250738585072014e-308)
    pair(-1.7976931348623157e308, 2.2250738585072014e-308)
    pair(1e300, 1e-300)
    pair(-1e300, 1e-300)
    pair(1e300, -1e-300)
    # floats of any size
    big = 2.0 ** 2000
    pair(big, 3.0)
    pair(big, -3.0)
    pair(-big, 3.0)
    pair(big, 1e300)
    pair(big, 2.0 ** 1999)
    pair(big, 2.0 ** 2000)
    pair(big * 1.5, big)
    pair(-big * 1.5, big)
    pair(big, -big * 1.5)
    pair(big, 2.0 ** 1990)
    pair(3.0, big)
    pair(-3.0, big)
    pair(3.0, -big)
    pair(0.0, big)
    pair(0.0, -big)
    pair(2.0 ** 70, big)
    pair(big / 3.0, 1.0)
    pair(big / 3.0, 7.0)
    pair(2.0 ** -2000, 2.0 ** -2001)
    pair(2.0 ** -2000 * 1.75, 2.0 ** -2000)
    pair(-2.0 ** -2000 * 1.75, 2.0 ** -2000)
    pair(1.0, 2.0 ** -2000)
    pair(-1.0, 2.0 ** -2000)
    # the parts add up to the dividend where the sum does not round (as in Python, which differs from x in exactly these pairs)
    xs = [3.7, -3.7, 1e22, 0.3, 123456.789, -0.1, 2.0 ** 64 + 4096.0, 1e-5, 7.0]
    ys = [1e-5, 0.1, -0.1, 3.0, -7.0, 0.7, 1e-7, 1e22, 2.5]
    ok = True
    for x in xs:
        for y in ys:
            if not parts(x, y):
                print('parts differ', x, y)
                ok = False
    print(ok)
    # a few hundred pairs from a small generator
    seed = 12345
    bad = 0
    for i in range(3000):
        seed = (seed * 1103515245 + 12345) % 2147483648
        x = float(seed % 1000003) / 997.0 - 500.0
        seed = (seed * 1103515245 + 12345) % 2147483648
        y = float(seed % 99991) / 10007.0 + 1e-5
        if i % 3 == 1:
            y = -y
        if not parts(x, y) or (x % y != 0 and (x % y < 0) != (y < 0)):
            bad += 1
    print(bad)
    # ZeroDivisionError as before
    try:
        print(1.0 // zero(1.0))
    catch ZeroDivisionError as e:
        print(e.message)
    try:
        print(big % zero(1.0))
    catch ZeroDivisionError as e:
        print(e.message)
