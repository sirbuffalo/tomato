# Reading dates and times with std/datetime.tom against real Python 3 (expected output generated by python's datetime module
# as an oracle): date_fromisoformat, time_fromisoformat, datetime_fromisoformat, datetime_strptime. Cases that Python reads
# but this module deliberately does not (the basic form 20240309, 24:00, an offset with seconds, a time with an offset, the
# other strptime directives) are not here; they are in tests/runtime/datetime_errors.
from datetime import date_fromisoformat, time_fromisoformat, datetime_fromisoformat, datetime_strptime

def pdate(text: str):
    try:
        print(date_fromisoformat(text))
    catch ValueError:
        print('ValueError')

def ptime(text: str):
    try:
        print(time_fromisoformat(text))
    catch ValueError:
        print('ValueError')

def pdt(text: str):
    try:
        print(datetime_fromisoformat(text).isoformat())
    catch ValueError:
        print('ValueError')

def pstrp(text: str, fmt: str):
    try:
        print(datetime_strptime(text, fmt).isoformat())
    catch ValueError:
        print('ValueError')

