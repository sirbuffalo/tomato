# MessagePack: exact encodings (checked against the specification's tables), decoding every format, round trips
from json import loads, dumps, loads_msgpack, dumps_msgpack, JSONEncodeError
from value import Value, Bin, Ext, Timestamp, Int, Float, Str, List, Dict, Null, Bool

def enc(j: Value):
    print(dumps_msgpack(j).hex())

def dec(h: str):
    print(h[0:24], '->', dumps(loads_msgpack(bytes.fromhex(h))))

@main
def main():
    print('-- encodings')
    enc(Null())
    enc(Bool(True))
    enc(Bool(False))
    for n in [0, 1, 127, 128, 255, 256, 65535, 65536, 4294967295, 4294967296, 9223372036854775807, 9223372036854775808, 18446744073709551615]:
        enc(Int(n))
    for n in [-1, -32, -33, -128, -129, -32768, -32769, -2147483648, -2147483649, -9223372036854775808]:
        enc(Int(n))
    enc(Float(1.5))
    enc(Float(-0.1))
    enc(Float(0.0))
    enc(Str(''))
    enc(Str('a'))
    enc(Str('é€😀'))
    enc(Str('x' * 31))
    print(dumps_msgpack(Str('x' * 32)).hex()[0:8], len(dumps_msgpack(Str('x' * 32))))
    print(dumps_msgpack(Str('x' * 255)).hex()[0:8], len(dumps_msgpack(Str('x' * 255))))
    print(dumps_msgpack(Str('x' * 256)).hex()[0:8], len(dumps_msgpack(Str('x' * 256))))
    print(dumps_msgpack(Str('x' * 65536)).hex()[0:10], len(dumps_msgpack(Str('x' * 65536))))
    enc(List([]))
    enc(List([Int(1), Int(2), Int(3)]))
    big: list[Value] = []
    for i in range(15):
        big.append(Null())
    print(dumps_msgpack(List(big)).hex()[0:4])
    big.append(Null())
    print(dumps_msgpack(List(big)).hex()[0:8])
    enc(Dict({}))
    enc(Dict({'a': Int(1), 'b': List([Bool(True)])}))
    wide: dict[str, Value] = {}
    for i in range(16):
        wide['k' + str(i)] = Null()
    print(dumps_msgpack(Dict(wide)).hex()[0:8])
    enc(Bin(b''))
    enc(Bin(bytes([1, 2, 255])))
    print(dumps_msgpack(Bin(bytes([7] * 256))).hex()[0:8])
    enc(Ext(5, bytes([1])))
    enc(Ext(5, bytes([1, 2])))
    enc(Ext(-5, bytes([1, 2, 3, 4])))
    enc(Ext(1, bytes([1, 2, 3])))
    enc(Ext(127, bytes([0] * 8)))
    enc(Ext(-128, bytes([0] * 16)))
    enc(Ext(9, bytes([0] * 3)))
    enc(Timestamp(0))
    enc(Timestamp(4294967295))
    enc(Timestamp(1, 500))
    enc(Timestamp(17179869183, 999999999))
    enc(Timestamp(17179869184))
    enc(Timestamp(-1))
    enc(Timestamp(-62135596800, 7))
    print('-- decoding')
    dec('c0')
    dec('c2')
    dec('c3')
    dec('7f')
    dec('ff')
    dec('e0')
    dec('cc80')
    dec('cd0100')
    dec('ce00010000')
    dec('cf0000000100000000')
    dec('cfffffffffffffffff')
    dec('d0df')
    dec('d18000')
    dec('d280000000')
    dec('d38000000000000000')
    dec('d3ffffffffffffffff')
    dec('d37fffffffffffffff')
    dec('d34000000000000000')
    dec('cf4000000000000000')
    dec('cf3fffffffffffffff')
    dec('ca3fc00000')
    dec('ca00000001')
    dec('cb3ff8000000000000')
    dec('cbc00c000000000000')
    dec('a0')
    dec('a3616263')
    dec('d9026162')
    dec('da00026162')
    dec('db000000026162')
    dec('a3e282ac')
    dec('90')
    dec('93010203')
    dec('dc0003010203')
    dec('dd00000003010203')
    dec('80')
    dec('81a16101')
    dec('de0001a16101')
    dec('df00000001a16101')
    dec('82a16101a16102')
    print('-- decoded kinds')
    for h in ['c4020aff', 'd40501', 'd5050102', 'c703050102' + '03', 'c80003050102' + '03', 'd6ff00000001', 'd7ff0000000100000002', 'c70cff0000000100000000000000ff', 'ca3fc00000', 'cb3ff8000000000000']:
        j = loads_msgpack(bytes.fromhex(h))
        print(h, j.kind())
    t = loads_msgpack(bytes.fromhex('d7ff000007d000000001'))
    print(t.seconds(), t.nanos())
    t = loads_msgpack(bytes.fromhex('c70cff3b9ac9ffffffffffffffffff'))
    print(t.seconds(), t.nanos())
    e = loads_msgpack(bytes.fromhex('d5fb0102'))
    print(e.ext_type(), e.as_bytes())
    print(loads_msgpack(bytes.fromhex('c4020aff')).as_bytes())
    print('-- round trips')
    doc = loads('{"name":"tomato","tags":["red","round"],"n":3,"f":1500.5,"big":123456789012345678901234567890123,"nested":{"a":[true,false,null,-7]},"u":"日本語 😀"}')
    # the big integer does not fit in 64 bits, so take it out first
    fields = doc.as_dict()
    fields['big'] = Int(-9223372036854775808)
    back = loads_msgpack(dumps_msgpack(doc))
    print(dumps(back) == dumps(doc), dumps(back))
    print(dumps_msgpack(back).hex() == dumps_msgpack(doc).hex())
    bytes_doc = Dict({'bin': Bin(bytes([0, 1, 2, 254, 255])), 'ext': Ext(42, bytes([9, 8, 7])), 'ts': Timestamp(1700000000, 123456789), 'list': List([Bin(b''), Timestamp(-5)])})
    b2 = loads_msgpack(dumps_msgpack(bytes_doc))
    print(b2['bin'].as_bytes(), b2['ext'].ext_type(), b2['ext'].as_bytes(), b2['ts'].seconds(), b2['ts'].nanos(), b2['list'][0].kind(), b2['list'][1].seconds())
    print(dumps_msgpack(b2).hex() == dumps_msgpack(bytes_doc).hex())
    print('-- NaN and infinity: valid MessagePack, kept as floats, and refused by JSON text')
    for h in ['cb7ff8000000000000', 'cbfff0000000000000', 'ca7f800000', 'cb7ff8000000000001', 'ca7fc00001', 'cbfff8000000000001', 'cb7ff0000000000001']:
        f = loads_msgpack(bytes.fromhex(h))
        print(f.kind(), dumps_msgpack(f).hex())
        try:
            print(dumps(f))
        catch JSONEncodeError as e:
            print(e.message)
    print('-- they are not numbers to calculate with: arithmetic stops, int() stops, comparisons follow IEEE')
    inf = loads_msgpack(bytes.fromhex('cb7ff0000000000000')).as_float()
    ninf = loads_msgpack(bytes.fromhex('cbfff0000000000000')).as_float()
    nan = loads_msgpack(bytes.fromhex('cb7ff8000000000000')).as_float()
    for which in range(9):
        try:
            if which == 0:
                print(inf * 2.0)
            elif which == 1:
                print(inf + 1.0)
            elif which == 2:
                print(2.0 - nan)
            elif which == 3:
                print(inf // 2.0)
            elif which == 4:
                print(inf ** 2.0)
            elif which == 5:
                print(2.0 ** inf)
            elif which == 6:
                print(int(inf))
            elif which == 7:
                print(int(nan))
            else:
                print(1.0 / ninf)
        catch RuntimeError as e:
            print(which, e.message)
    print(inf > 10 ** 30, ninf < -(10 ** 30), inf > 5.0, ninf < 5.0, inf == inf, inf > ninf, inf < ninf, ninf != inf)
    print(nan == nan, nan != nan, nan < 5.0, nan > 5.0, nan <= 5.0, nan >= 5.0, 5.0 < nan, nan == 3, nan > 3, nan != 3)
    print(-inf, -ninf, str(nan))
