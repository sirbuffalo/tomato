class P:
    name: str
    age: int

    @init
    def make(self, name: str, age: int):
        self.name = name
        self.age = age

def age_of(p: P) -> int:
    return p.age

def by_name(a: P, b: P) -> int:
    if a.name < b.name:
        return -1
    if a.name > b.name:
        return 1
    return 0

def neg(x: int) -> int:
    return 0 - x

def small(x: int) -> bool:
    return x < 5

def half(x: int) -> float:
    return x / 2

def last(s: str) -> str:
    return s[len(s) - 1:]

@main
def main():
    xs = [5, 3, 9, 1, 7, 3, 2]
    print(sorted(xs, key=neg))
    print(sorted(xs, key=neg))
    ps = [P('bob', 30), P('al', 25), P('cy', 30), P('di', 25)]
    for p in sorted(ps, key=age_of):
        print(p.name)
    for p in sorted(ps, cmp=by_name):
        print(p.name)
    print(map(neg, xs))
    print(map(half, xs))
    print(filter(small, xs))
    print(sorted(['ab', 'ca', 'bb'], key=last))
    big: list[int] = []
    for i in range(1000):
        big.append((i * 7919) % 1009)
    s = sorted(big, key=neg)
    ok = True
    for i in range(len(s) - 1):
        if s[i] < s[i + 1]:
            ok = False
    print(ok)
