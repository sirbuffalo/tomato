# base64 against Python 3 base64 (expected output generated with python3 as an oracle only; the decoders are compared with
# b64decode(validate=True), the strict behavior the API sheet asks for).
import base64

def show_enc(data: list[int]):
    try:
        print(f'{base64.b64encode(data)}|{base64.urlsafe_b64encode(data)}')
    catch ValueError:
        print('ValueError')

def decoded(text: str, urlsafe: bool) -> str:
    try:
        if urlsafe:
            return str(base64.urlsafe_b64decode(text))
        return str(base64.b64decode(text))
    catch ValueError:
        return 'ValueError'

def show_dec(text: str):
    print(f'{decoded(text, False)}|{decoded(text, True)}')

