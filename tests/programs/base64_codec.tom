# base64 against Python 3 base64 (expected output generated with python3 as an oracle only; the decoders are compared with
# b64decode(validate=True), the strict behavior the API sheet asks for).
import base64

def show_enc(data: bytes):
    try:
        print(f'{base64.b64encode(data)}|{base64.urlsafe_b64encode(data)}')
    catch ValueError:
        print('ValueError')

def decoded(text: str, urlsafe: bool) -> str:
    try:
        if urlsafe:
            return str(base64.urlsafe_b64decode(text))
        return str(base64.b64decode(text))
    catch ValueError:
        return 'ValueError'

def show_dec(text: str):
    print(f'{decoded(text, False)}|{decoded(text, True)}')

@main
def main():
    show_enc(b'')
    show_enc(bytes([102]))
    show_enc(bytes([102, 111]))
    show_enc(bytes([102, 111, 111]))
    show_enc(bytes([102, 111, 111, 98]))
    show_enc(bytes([102, 111, 111, 98, 97]))
    show_enc(bytes([102, 111, 111, 98, 97, 114]))
    show_enc(bytes(list(range(256))))
    show_enc(bytes([255, 254, 253]))
    show_enc(bytes([251, 239, 190, 255, 255]))
    show_enc(bytes([0]))
    show_enc(bytes([0, 0]))
    show_enc(bytes([0, 0, 0]))
    show_enc(bytes([104, 195, 169, 108, 108, 111, 32, 230, 151, 165, 230, 156, 172, 32, 240, 159, 152, 128]))
    show_enc(bytes([250, 251, 252, 253, 254, 255, 248, 249]))
    show_enc(bytes([248, 252]))
    show_enc(bytes([255, 255, 255, 255, 255, 255, 255]))
    show_enc(bytes([0, 0, 0, 0]))
    show_enc(bytes([128, 128, 128, 128, 128]))
    show_dec('')
    show_dec('Zg==')
    show_dec('Zm8=')
    show_dec('Zm9v')
    show_dec('Zm9vYg==')
    show_dec('Zm9vYmE=')
    show_dec('Zm9vYmFy')
    show_dec('Zh==')
