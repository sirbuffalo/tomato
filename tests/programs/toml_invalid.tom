# TOML documents that must be refused, with the line and column of the error; the cases follow the toml-test invalid categories.
from toml_show import run

@main
def main():
    run('after-value', ['a = 1 b = 2'])
    run('aot-over-array', ['a = [1]', '[[a]]'])
    run('aot-over-table', ['[a]', '[[a]]'])
    run('array-missing-comma', ['a = [1 2]'])
    run('array-unterminated', ['a = [1, 2'])
    run('bad-comment', ['# x' + chr(0)])
    run('bad-date', ['a = 2021-02-30'])
    run('bad-escape', ['a = "\\q"'])
    run('bad-header', ['[a'])
    run('bad-header2', ['[a] x'])
    run('bad-hex', ['a = 0xg'])
    run('bad-month', ['a = 2021-13-01'])
    run('bad-time', ['a = 25:00:00'])
    run('bad-unicode', ['a = "\\uD800"'])
    run('bare-cr', ['a = 1\rb = 2'])
    run('bare-value', ['a = abc'])
    run('control', ['a = "x' + chr(1) + '"'])
    run('d1', ['a = 1979-05-27T'])
    run('d2', ['a = 1979-05-27T07:32'])
    run('d3', ['a = 1979-05-27 07:32:00+0700'])
    run('d4', ['a = 1979-05-2'])
    run('d5', ['a = 2024-02-29', 'b = 2023-02-29'])
    run('d6', ['a = 07:32:60', 'b = 24:00:00'])
    run('del-char', ['a = "x' + chr(127) + '"'])
    run('dotted-bad', ['[fruit]', 'apple.color = "red"', '[fruit.apple]'])
    run('dotted-bad2', ['[fruit]', 'apple.taste.sweet = true', '[fruit.apple.taste]'])
    run('dotted-then-header', ['[a]', 'b.c = 1', '[a.b]'])
    run('double-underscore', ['a = 1__0'])
    run('dup-quoted', ['a = 1', '"a" = 2'])
    run('dupheader', ['[a]', '[a]'])
    run('dupkey', ['a = 1', 'a = 2'])
    run('dupkey2', ['a = 1', '[a]'])
    run('empty-dotted', ['a..b = 1'])
    run('empty-key', ['= 1'])
    run('empty-str-key-dup', ['"" = 1', "'' = 2"])
    run('esc-e', ['a = "\\e"'])
    run('esc-x', ['a = "\\x41"'])
    run('f1', ['a = 1e'])
    run('f11', ['a = 00.5'])
    run('f13', ['a = 1e' + '4' * 4301])
    run('f2', ['a = 1.e3'])
    run('f4', ['a = 0x_1'])
    run('f5', ['a = 1._0'])
    run('f7', ['a = 0b2'])
    run('f8', ['a = 0x'])
    run('f9', ['a = -0x10'])
    run('float-no-digit', ['a = 1.', 'b = .5'])
    run('hdr-trail-dot', ['[a.]'])
    run('header-then-dotted', ['[a.b]', '[a]', 'b.c = 1'])
    run('inline-extend', ['a = {b = 1}', '[a.c]'])
    run('inline-extend2', ['a = {b = 1}', 'a.c = 2'])
    run('int-range', ['a = 9223372036854775808'])
    run('key-through-string', ['a = "x"', 'a.b = 1'])
    run('leading-zero', ['a = 007'])
    run('ml-too-many', ['a = """x""""""'])
    run('multiline-inline', ['a = {b = 1,', 'c = 2}'])
    run('nested-aot-dup-sub', ['[[a]]', '[a.b]', '[a.b]'])
    run('newline-in-string', ['a = "x', 'y"'])
    run('noeq', ['a 1'])
    run('novalue', ['a ='])
    run('space-bracket', ['[ [a]]'])
    run('str-del', ['a = "x" "y"'])
    run('table-over-aot', ['[[a]]', '[a]'])
    run('trail-dot', ['a. = 1'])
    run('trailing-comma-inline', ['a = {b = 1,}'])
    run('trailing-underscore', ['a = 1_'])
    run('unicode-key', ['ключ = 1'])
    run('unterminated', ['a = "abc'])
    run('unterminated-ml', ['a = """abc'])
