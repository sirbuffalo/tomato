# terminal in the browser playground (tests/run.sh runs this through WebAssembly only): there is no terminal, so open() raises RuntimeError
# and is_tty says False, while the pure parts (color_depth, widths, the key decoder, styles) work.
import terminal
from terminal import KeyDecoder, Style

@main
def main():
    try:
        t = terminal.open()
        print('opened')
        t.close()
    catch RuntimeError as e:
        print('open', e.id, e.message)
    print(terminal.is_tty(0), terminal.is_tty(1), terminal.is_tty(2))
    print(terminal.color_depth('auto'), terminal.color_depth('never'), terminal.color_depth('always'))
    print(terminal.char_width(65), terminal.char_width(20013), terminal.char_width(769), terminal.text_width('ab' + chr(20013)))
    d = KeyDecoder()
    for k in d.feed([27, 91, 49, 59, 53, 67, 104, 195, 169]):
        print(k)
    green = Style(terminal.rgb(0, 150, 57), -1, True)
    print(terminal.styled('x', green, 256) == chr(27) + '[1;38;5;29mx' + chr(27) + '[0m', terminal.styled('x', green, 0))
