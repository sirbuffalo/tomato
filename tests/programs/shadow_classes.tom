# A class, an interface and a constant may also take the name of a built-in (D108a). The code the compiler writes for assert and
# unpacking names the built-in classes AssertionError and ValueError, and still raises those; methods named like built-ins and the
# operator markers (@len, @iter) are not affected.
class range:
    lo: int = 0
    hi: int = 0

    @init
    def make(self, lo: int, hi: int):
        self.lo = lo
        self.hi = hi

    def len(self) -> int:
        return self.hi - self.lo

    def print(self) -> str:
        return f'range {self.lo}..{self.hi}'

class AssertionError:
    message: str = 'mine'

class ValueError:
    code: int = 7

interface sum:
    def total(self) -> int

class Bag implements sum:
    items: list[int] = []

    @init
    def make(self, items: list[int]):
        self.items = items

    def total(self) -> int:
        t = 0
        for x in self.items:
            t += x
        return t

    @len
    def size(self) -> int:
        n = 0
        for _x in self.items:
            n += 1
        return n

    @iter
    def each(self) -> int:
        for x in self.items:
            yield x

const open = 10
const hash = 'seed'

def add(s: sum) -> int:
    return s.total() + open

@main
def main():
    r = range(3, 8)
    print(r.len(), r.print(), r.lo)
    print(AssertionError().message, ValueError().code)
    b = Bag([4, 5, 6])
    print(add(b), len(b), sum_of(b), open, hash)
    # assert still raises the built-in AssertionError, unpacking the built-in ValueError
    try:
        assert 1 > 2, 'one is not above two'
    catch Error as e:
        print(e.message, e.id)
    try:
        x, y = [1, 2, 3]
        print(x, y)
    catch Error as e:
        print(e.message, e.id)
    for i, item in enumerate(b.items):
        print(i, item)
    print([n * n for n in b])

def sum_of(items: Bag) -> int:
    t = 0
    for x in items:
        t += x
    return t
