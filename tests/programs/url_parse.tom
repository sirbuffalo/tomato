# urlparse, urlunparse and urljoin against Python 3 urllib.parse (expected output generated with python3 as an oracle only).
from urlparse import urlparse, urlunparse, urljoin

def show(url: str):
    try:
        p = urlparse(url)
        print(f'{p.scheme}|{p.netloc}|{p.path}|{p.params}|{p.query}|{p.fragment}||{urlunparse(p)}')
    catch ValueError:
        print('ValueError')

def join(base: str, url: str):
    try:
        print(urljoin(base, url))
    catch ValueError:
        print('ValueError')

