def factorial(n: int) -> int:
    if n <= 1:
        return 1
    return n * factorial(n - 1)

def fib(n: int) -> int:
    a = 0
    b = 1
    for i in range(n):
        t = a + b
        a = b
        b = t
    return a

@main
def main():
    print(factorial(30))
    print(fib(150))
    print(2 ** 200)
    big = 123456789012345678901234567890
    print(big, -big, big - big, big + 1)
    print(big // 7, big % 7, -big // 7, -big % 7)
    print(big // 98765432109876543210, big % 98765432109876543210)
    print(big > 5, big < 5, big == big, big != big + 1, -big < big)
    print(7 // 2, -7 // 2, 7 % -2, -7 % 2)
    print(4611686018427387904 * 2, -4611686018427387904 - 1)
    print(9223372036854775807 + 1)
    x: int[length=64] = 1
    print(int(x) + 9223372036854775807 > 0)
    small: int[length=8] = int[length=8](100)
    print(small)
    print(big / 2)
    print(10 ** 20 // 10 ** 18)
    xs: list[int] = [factorial(25), 3]
    print(xs[0], len(xs), factorial(25) in xs)
