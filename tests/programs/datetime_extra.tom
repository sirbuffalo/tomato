# timedelta total_seconds, multiplication and negation, datetime replace, timestamp and combine, against real Python 3 (the
# expected output was generated by python's datetime module as an oracle; every line is one case). Differences from Python:
# negation is td.negated() (there is no unary minus on a class here), `td * n` takes an int on the right only, and a naive
# datetime's timestamp() is read as UTC where Python reads it in the local zone (so only aware values are checked there).
from datetime import date, time, datetime, timedelta, datetime_combine

def secs(days: int, seconds: int, micros: int):
    d = timedelta(days, seconds, micros)
    print(f'{d.total_seconds()}')

def mul(days: int, seconds: int, micros: int, k: int):
    d = timedelta(days, seconds, micros)
    try:
        print(f'{d * k}|{d.negated()}|{d.negated().negated() == d}')
    catch OverflowError:
        print(f'OverflowError|{d.negated()}')

def neg(days: int, seconds: int, micros: int):
    try:
        d = timedelta(days, seconds, micros)
        print(f'{d.negated()}|{d.negated().days} {d.negated().seconds} {d.negated().microseconds}')
    catch OverflowError:
        print('OverflowError')

def stamp(y: int, m: int, d: int, hh: int, mm: int, ss: int, us: int, off: int):
    x = datetime(y, m, d, hh, mm, ss, us, off)
    print(f'{x.timestamp()}')

def combine(y: int, m: int, d: int, hh: int, mm: int, ss: int, us: int):
    print(datetime_combine(date(y, m, d), time(hh, mm, ss, us)))

def combine_off(y: int, m: int, d: int, hh: int, mm: int, ss: int, us: int, off: int):
    print(datetime_combine(date(y, m, d), time(hh, mm, ss, us), off).isoformat())

@main
def main():
    secs(0, 0, 0)
    secs(1, 0, 500000)
    secs(0, 0, 1)
    secs(-1, 0, 0)
    secs(0, 0, -1)
    secs(0, 1, 0)
    secs(0, 3600, 250000)
    secs(365, 12345, 678901)
    secs(999999999, 86399, 999999)
    secs(-999999999, 0, 1)
    secs(104, 54321, 12345)
    mul(1, 2, 3, 0)
    mul(1, 2, 3, 1)
    mul(1, 2, 3, -1)
    mul(0, 0, 1, 7)
    mul(0, 86399, 999999, 3)
    mul(-1, 1, 1, 5)
    mul(10, 0, 0, 100000000)
    mul(10, 0, 0, 99999999)
    mul(-10, 0, 0, 100000000)
    mul(500000000, 0, 0, 2)
    mul(500000000, 0, 0, -2)
    mul(0, 0, 0, 1000000000000)
    neg(0, 0, 0)
    neg(1, 0, 0)
    neg(-1, 0, 0)
    neg(0, 1, 0)
    neg(0, 0, 1)
    neg(-1, 86399, 999999)
    neg(999999999, 86399, 999999)
    neg(-999999999, 0, 0)
    neg(-999999999, 0, -1)
    stamp(1970, 1, 1, 0, 0, 0, 0, 0)
    stamp(2024, 2, 29, 12, 30, 45, 123456, 0)
    stamp(2024, 2, 29, 12, 30, 45, 123456, 330)
    stamp(2024, 2, 29, 12, 30, 45, 123456, -330)
    stamp(1969, 12, 31, 23, 59, 59, 999999, 0)
    stamp(1, 1, 1, 0, 0, 0, 0, 0)
    stamp(9999, 12, 31, 23, 59, 59, 999999, 0)
    stamp(2000, 1, 1, 0, 0, 0, 1, 0)
    stamp(9999, 12, 31, 23, 59, 59, 999999, -1439)
    stamp(1, 1, 1, 0, 0, 0, 0, 1439)
    stamp(3000, 6, 15, 1, 2, 3, 4, 60)
    combine(2024, 3, 9, 16, 30, 0, 0)
    combine(1, 1, 1, 0, 0, 0, 0)
    combine(9999, 12, 31, 23, 59, 59, 999999)
    combine(2024, 2, 29, 1, 2, 3, 4)
    combine_off(2024, 3, 9, 16, 30, 0, 0, 0)
    combine_off(2024, 3, 9, 16, 30, 5, 6, 330)
    combine_off(2024, 3, 9, 16, 30, 5, 6, -60)
    a = datetime(2024, 3, 9, 16, 30, 15, 250000)
    print(a.replace())
    print(a.replace(year=2000))
    print(a.replace(month=12, day=31))
    print(a.replace(hour=0, minute=0, second=0, microsecond=0))
    print(a.replace(microsecond=7))
    print(a.replace(day=1).replace(month=2).isoformat())
    b = datetime(2024, 3, 9, 16, 30, 15, 250000, -90)
    print(b.replace())
    print(b.replace(hour=1))
    print(b.replace(second=0).is_aware)
    print(b.replace(offset_minutes=120).isoformat())
    print(a.replace(offset_minutes=0).isoformat())
    print(a.replace(offset_minutes=0).is_aware)
    print(a.replace(year=1, month=1, day=1).isoformat())
    print(datetime(2024, 1, 31).replace(month=2, day=29))
    for bad in [[2023, 2, 29], [2024, 13, 1], [0, 1, 1], [10000, 1, 1], [2024, 4, 31]]:
        try:
            print(datetime(2024, 1, 1).replace(year=bad[0], month=bad[1], day=bad[2]))
        catch ValueError:
            print('ValueError')
    try:
        print(a.replace(hour=24))
    catch ValueError:
        print('ValueError')
    try:
        print(a.replace(minute=-1))
    catch ValueError:
        print('ValueError')
    try:
        print(a.replace(microsecond=1000000))
    catch ValueError:
        print('ValueError')
    try:
        print(a.replace(offset_minutes=1440))
    catch ValueError:
        print('ValueError')
    print(a.replace(year=2025) - a)
    print(timedelta(2, 3, 4) * 3 + timedelta(1))
