# The std/datetime.tom arithmetic, comparison and range checks against real Python 3 (the expected output was generated by
# python's datetime module as an oracle; every line below is one case). A mixed naive/aware comparison is a ValueError
# here (the approved API), where Python raises TypeError. 100000 as an offset means naive.
from datetime import date, time, datetime, timedelta

def mk(y: int, m: int, d: int, hh: int, mm: int, ss: int, us: int, off: int) -> datetime:
    if off == 100000:
        return datetime(y, m, d, hh, mm, ss, us)
    return datetime(y, m, d, hh, mm, ss, us, off)

def td(days: int, seconds: int, micros: int):
    try:
        d = timedelta(days, seconds, micros)
        print(f'{d}|{d.days}|{d.seconds}|{d.microseconds}')
    catch OverflowError:
        print('OverflowError')
    catch ValueError:
        print('ValueError')

def tdops(a1: int, a2: int, a3: int, b1: int, b2: int, b3: int):
    x = timedelta(a1, a2, a3)
    y = timedelta(b1, b2, b3)
    try:
        print(x + y)
    catch OverflowError:
        print('OverflowError')
    try:
        print(x - y)
    catch OverflowError:
        print('OverflowError')
    print(f'{x == y} {x != y} {x < y} {x <= y} {x > y} {x >= y}')

def dateadd(y: int, m: int, d: int, days: int, seconds: int, micros: int):
    try:
        delta = timedelta(days, seconds, micros)
        base = date(y, m, d)
        try:
            print(base + delta)
        catch OverflowError:
            print('OverflowError')
        try:
            print(base.minus(delta))
        catch OverflowError:
            print('OverflowError')
    catch OverflowError:
        print('OverflowError')
        print('OverflowError')

def dateinfo(y: int, m: int, d: int):
    try:
        x = date(y, m, d)
        print(f'{x}|{x.weekday()}')
    catch ValueError:
        print('ValueError')

def datediff(y1: int, m1: int, d1: int, y2: int, m2: int, d2: int):
    x = date(y1, m1, d1)
    y = date(y2, m2, d2)
    print(f'{y - x}|{x == y} {x != y} {x < y} {x <= y} {x > y} {x >= y}')

def dtadd(y: int, m: int, d: int, hh: int, mm: int, ss: int, us: int, off: int, days: int, seconds: int, micros: int):
    try:
        base = mk(y, m, d, hh, mm, ss, us, off)
        delta = timedelta(days, seconds, micros)
        try:
            print(base + delta)
        catch OverflowError:
            print('OverflowError')
        try:
            print(base.minus(delta))
        catch OverflowError:
            print('OverflowError')
    catch OverflowError:
        print('OverflowError')
        print('OverflowError')

def dtinfo(y: int, m: int, d: int, hh: int, mm: int, ss: int, us: int, off: int):
    try:
        x = mk(y, m, d, hh, mm, ss, us, off)
        print(f'{x}|{x.isoformat()}|{x.weekday()}|{x.year} {x.month} {x.day} {x.hour} {x.minute} {x.second} {x.microsecond}|{x.offset_minutes} {x.is_aware}')
    catch ValueError:
        print('ValueError')

def dtdiff(y1: int, m1: int, d1: int, h1: int, n1: int, s1: int, u1: int, o1: int, y2: int, m2: int, d2: int, h2: int, n2: int, s2: int, u2: int, o2: int):
    x = mk(y1, m1, d1, h1, n1, s1, u1, o1)
    y = mk(y2, m2, d2, h2, n2, s2, u2, o2)
    try:
        print(f'{y - x}|{x == y} {x != y} {x < y} {x <= y} {x > y} {x >= y}')
    catch ValueError:
        print(f'ValueError|{x == y} {x != y} ValueError')

def timeinfo(hh: int, mm: int, ss: int, us: int):
    try:
        x = time(hh, mm, ss, us)
        print(f'{x}|{x.isoformat()}|{x.hour} {x.minute} {x.second} {x.microsecond}')
    catch ValueError:
        print('ValueError')

def timecmp(h1: int, m1: int, s1: int, u1: int, h2: int, m2: int, s2: int, u2: int):
    x = time(h1, m1, s1, u1)
    y = time(h2, m2, s2, u2)
    print(f'{x == y} {x != y} {x < y} {x <= y} {x > y} {x >= y}')

