@main
def main():
    print(1 << 10)
    print(1 << 62)
    print(1 << 100)
    print(-3 << 70)
    print((1 << 100) >> 98)
    print(-5 >> 1)
    print(-1 >> 200)
    print(5 >> 100)
    print(~0)
    print(~5)
    print(~(-1))
    print(~(1 << 100))
    print(255 & ~15)
    print(1 << 3 + 1)
    print(1 | 2 << 1 & 7)
    x = 1
    x <<= 4
    x >>= 1
    print(x)
    a: uint[length=8] = uint[length=8](3)
    print(a << 2)
    print(~a)
    b: int[length=32] = int[length=32](5)
    print(~b)
    print(b >> 1)
    n = 3
    print(7 << n)
    print((1 << 64) - 1 == ~(-1 << 64))
