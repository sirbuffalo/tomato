def num(k: int | float) -> float:
    if k in int:
        return float(k)
    return k

# @neg: unary minus on an object. @rmul: a number on the left of * (the object's method gets the number). Any class can have them.
class Vec:
    x: float = 0.0
    y: float = 0.0

    @init
    def make(self, x: float, y: float):
        self.x = x
        self.y = y

    @neg
    def flipped(self) -> Vec:
        return self.flip()

    def flip(self) -> Vec:
        return Vec(0.0 - self.x, 0.0 - self.y)

    @add
    def plus(self, o: Vec) -> Vec:
        return Vec(self.x + o.x, self.y + o.y)

    @mul
    def times(self, k: int | float) -> Vec:
        return Vec(self.x * num(k), self.y * num(k))

    @rmul
    def scaled(self, k: int | float) -> Vec:
        return Vec(self.x * num(k), self.y * num(k))

    @str
    def text(self) -> str:
        return f'<{self.x} {self.y}>'

# a subclass: the markers are inherited, and a replaced method is the one that runs
class Up(Vec):
    @init
    def make(self, x: float, y: float):
        Vec.make(self, x, y)

    override def flip(self) -> Vec:
        return Vec(self.x, 0.0 - self.y)

# the hooks may return other types than the class
class Count:
    n: int = 0

    @init
    def make(self, n: int):
        self.n = n

    @neg
    def negative(self) -> int:
        return 0 - self.n

    @rmul
    def multiples(self, k: int) -> list[int]:
        return [self.n * k, self.n * k + 1]

# only @neg, no @mul or @rmul; and only @rmul
class Flag:
    on: bool = True

    @init
    def make(self, on: bool):
        self.on = on

    @neg
    def opposite(self) -> Flag:
        return Flag(not self.on)

class Row:
    w: int = 0

    @init
    def make(self, w: int):
        self.w = w

    @rmul
    def repeat(self, k: int) -> str:
        return 'x' * (k * self.w)

# an @rmul method that changes the field the left number was read from: the number it gets is still the old one
class Cell:
    v: int = 0

class Resetter:
    cell: Cell = Cell()
    seen: int = 0

    @init
    def make(self, cell: Cell):
        self.cell = cell

    @rmul
    def reset(self, k: int) -> int:
        self.cell.v = 5
        self.seen = k
        return k + 1

    @mul
    def mult(self, k: int) -> int:
        self.cell.v = 6
        self.seen = k
        return k + 2

    @neg
    def clear(self) -> int:
        self.cell.v = 7
        return self.cell.v

class Slot:
    v: Vec | None = None

    @init
    def make(self, v: Vec | None):
        self.v = v

def negate_all(items: list[Vec]) -> list[Vec]:
    out: list[Vec] = []
    for v in items:
        out.append(-v)
    return out

@main
def main():
    v = Vec(1.0, -2.0)
    print(-v, -(-v), 3 * v, 0.5 * v, -v * 2, 2 * -v, -2 * v, 2 * v * 3, -v + v)
    # a number written in several ways on the left
    k = 4
    f = 1.5
    print(k * v, f * v, (k + 1) * v, (k * 2) * (f * v))
    # the same through a subclass and a list
    u = Up(1.0, 2.0)
    print(-u, 2 * u, -(2 * u))
    print(negate_all([v, u, Vec(0.0, 0.0)]))
    xs = [v, u]
    print(-xs[0], 2 * xs[1], -xs[0] + 3 * xs[1])
    # the hooks may give another type
    c = Count(5)
    print(-c, -c + 1, 3 * c, len(2 * c), 3 * c == [15, 16])
    print((-Flag(True)).on, (-(-Flag(True))).on, -Flag(False) == None)
    print(3 * Row(2), 2 * Row(1) + '!')
    # in a loop, and with a field on the left
    total = Vec(0.0, 0.0)
    for i in range(4):
        total = total + i * v
    print(total)
    box = Vec(2.0, 3.0)
    print(box.x * v, -box, 2 * -box)
    # an optional that holds an object
    s = Slot(Vec(1.0, 1.0))
    t = s.v
    if t is not None:
        print(-t, 2 * t)
    # a number read from a field is not lent to @rmul or @mul
    cell = Cell()
    cell.v = 10 ** 30 + 1
    r = Resetter(cell)
    print(cell.v * r, r.seen, cell.v, cell.v * -r + 1, cell.v)
    cell.v = 10 ** 30 + 1
    print(r * cell.v, r.seen, cell.v)
    # integers and floats are unchanged
    n = 7
    print(-n, -f, 3 * n, 3 * f, -(-n), - -n, 2 * -n)
