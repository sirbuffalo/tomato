# pop, insert, extend, sort, reverse and == on lists, for plain, heap, big-integer and compact (bool, 1/2/4-byte) items
class Dot:
    x: int
    @init
    def init(self, x: int):
        self.x = x

def bad_cmp(a: str, b: str) -> int:
    return len(a) // (len(b) - len(b))

def show_error(label: str, message: str):
    print(label, 'raised', message)

@main
def main():
    xs = [3, 1, 2]
    print(xs.pop(), xs)
    print(xs.pop(0), xs)
    xs.insert(0, 9)
    xs.insert(len(xs), 7)
    xs.insert(-1, 8)
    print(xs)
    xs.extend([4, 5])
    xs.extend(xs)
    print(xs)
    xs.sort()
    print(xs)
    xs.reverse()
    print(xs)
    print(xs.pop(-1), xs.pop(-2), len(xs))

    words = ['pear', 'fig', 'apple']
    words.insert(1, 'kiwi')
    words.sort()
    print(words, words.pop(), words.pop(0), words)
    words.extend(['zz'] * 2)
    words.sort(key=w -> len(w))
    print(words)
    words.sort(cmp=(a, b) -> len(b) - len(a))
    print(words)
    words.reverse()
    print(words)

    big = [2 ** 70, 5, 2 ** 65]
    big.sort()
    print(big)
    big.insert(1, 2 ** 80)
    print(big.pop(), big.pop(0), big)
    big.extend(big)
    big.reverse()
    print(big)

    fl = [2.5, 1.5]
    fl.sort()
    fl.insert(0, 0.5)
    print(fl, fl.pop())

    nested = [[1, 2], [3]]
    nested.insert(0, [0])
    nested.extend(nested)
    print(nested, nested.pop(), nested)

    objs = [Dot(1), Dot(2)]
    objs.insert(1, Dot(5))
    objs.reverse()
    last = objs.pop()
    objs.sort(key=d -> d.x)
    print(last.x, [d.x for d in objs])

    flags = [True, False]
    flags.insert(1, True)
    flags.extend(flags)
    flags.reverse()
    print(flags, flags.pop(), flags.pop(0), flags)

    small = [int[length=8](3), 1, 2]
    small.insert(1, 7)
    small.extend(small)
    print(small, small.pop(), small.pop(2), small)
    small.reverse()
    print(small)
    mid = [int[length=16](300), 100]
    mid.insert(0, 2)
    mid.reverse()
    print(mid, mid.pop())
    wide = [uint[length=32](70000), 5]
    wide.insert(2, 9)
    wide.reverse()
    wide.extend(wide)
    print(wide, wide.pop(1))

    print([1, 2] == [1, 2], [1, 2] == [1, 3], [1, 2] != [1, 2], [1] == [1, 2], xs[:0] == xs[:0])
    print(['a', 'b'] == ['a', 'b'], ['a'] != ['b'], [1.5] == [1.5], [True] == [True])
    print([[1], [2]] == [[1], [2]], [[1], [2]] == [[1], [3]])
    print([2 ** 70] == [2 ** 70], [2 ** 70] == [2 ** 70 + 1])
    print([int[length=8](1)] == [int[length=8](1)], [int[length=8](1)] != [int[length=8](2)])
    print([True, False] == [True, False], [True, False] == [True, True])

    nothing: list[int] = []
    try:
        nothing.pop()
    catch RuntimeError as e:
        show_error('pop()', e.message)
    try:
        nothing.pop(0)
    catch RuntimeError as e:
        show_error('pop(0)', e.message)
    try:
        xs.pop(100)
    catch RuntimeError as e:
        show_error('pop(100)', e.message)
    try:
        xs.pop(-100)
    catch RuntimeError as e:
        show_error('pop(-100)', e.message)
    try:
        xs.insert(100, 1)
    catch RuntimeError as e:
        show_error('insert(100)', e.message)
    try:
        xs.insert(-100, 1)
    catch RuntimeError as e:
        show_error('insert(-100)', e.message)
    try:
        words.sort(cmp=bad_cmp)
    catch RuntimeError as e:
        show_error('sort(cmp)', e.message)
    print(xs, words)
