# The standard library does not see what a program defines (D108a): this program has its own len, range, abs, hash, sum, min, max,
# sorted, round, chr, ord, any, all, map, filter and reversed, which would break the modules below if their code looked them up
# in the program. Each module has its own names and the built-ins, as before.
import json
import csv
import re
import textwrap
import statistics
import datetime
import hashlib
import struct
import itertools
import base64
import urlparse
from math import gcd, is_prime, factorial
from testing import assert_equal, assert_raises

def len(x: str) -> str:
    return 'len:' + x

def range(x: str) -> str:
    return 'range:' + x

def abs(x: str) -> str:
    return 'abs:' + x

def hash(x: str) -> str:
    return 'hash:' + x

def sum(x: str) -> str:
    return 'sum:' + x

def min(x: str) -> str:
    return 'min:' + x

def max(x: str) -> str:
    return 'max:' + x

def sorted(x: str) -> str:
    return 'sorted:' + x

def round(x: str) -> str:
    return 'round:' + x

def chr(x: str) -> str:
    return 'chr:' + x

def ord(x: str) -> str:
    return 'ord:' + x

def any(x: str) -> str:
    return 'any:' + x

def all(x: str) -> str:
    return 'all:' + x

def map(x: str) -> str:
    return 'map:' + x

def filter(x: str) -> str:
    return 'filter:' + x

def reversed(x: str) -> str:
    return 'reversed:' + x

def boom():
    raise ValueError('boom')

@main
def main():
    print(len('a'), range('b'), abs('c'), hash('d'), sum('e'), min('f'), max('g'), sorted('h'), round('i'))
    print(chr('j'), ord('k'), any('l'), all('m'), map('n'), filter('o'), reversed('p'))
    j = json.loads('{"a": [1, 2, {"b": null}], "c": "text"}')
    print(json.dumps(j), json.dumps(j, indent=2, sort_keys=True))
    rows = csv.reader('a,b,"c,d"\n1,2,3\n')
    print(rows)
    m = re.search('(a+)(b*)', 'xxaaabbyy')
    if m is not None:
        print(m.group(), m.start(), m.end(), re.sub('a+', '-', 'baaac'), re.split(',', 'a,b,c'))
    print(textwrap.wrap('the quick brown fox jumps over the lazy dog', 16), textwrap.dedent('  a\n  b'))
    print(statistics.mean([1.0, 2.0, 6.0]), statistics.median([5.0, 1.0, 3.0]))
    d = datetime.date_fromisoformat('2026-11-27')
    print(d, d.weekday())
    print(hashlib.sha256_hex(b'hi'), struct.int_to_bytes(258, 2), struct.int_from_bytes(b'\x01\x02'))
    print(itertools.permutations([1, 2, 3], 2), itertools.accumulate([1, 2, 3]))
    print(base64.b64encode(b'hi'), urlparse.quote('a b'), gcd(12, 18), is_prime(97), factorial(5))
    assert_equal([1, 2], [1, 2])
    e = assert_raises(boom, 'ValueError')
    print(e.message)
    letters = ['x', 'y']
    for i, ch in enumerate(letters):
        print(f'{i}{ch}')
