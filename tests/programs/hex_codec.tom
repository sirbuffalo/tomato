# hex.encode and hex.decode against Python 3 (bytes.hex and binascii.unhexlify; expected output generated with python3 as an oracle only).
import hex

def show_enc(data: bytes):
    try:
        print(hex.encode(data))
    catch ValueError:
        print('ValueError')

def show_dec(text: str):
    try:
        print(hex.decode(text))
    catch ValueError:
        print('ValueError')

@main
def main():
    show_enc(b'')
    show_enc(bytes([102]))
    show_enc(bytes([102, 111]))
    show_enc(bytes([102, 111, 111]))
    show_enc(bytes([102, 111, 111, 98]))
    show_enc(bytes([102, 111, 111, 98, 97]))
    show_enc(bytes([102, 111, 111, 98, 97, 114]))
    show_enc(bytes(list(range(256))))
    show_enc(bytes([255, 254, 253]))
    show_enc(bytes([251, 239, 190, 255, 255]))
    show_enc(bytes([0]))
    show_enc(bytes([0, 0]))
    show_enc(bytes([0, 0, 0]))
    show_enc(bytes([104, 195, 169, 108, 108, 111, 32, 230, 151, 165, 230, 156, 172, 32, 240, 159, 152, 128]))
    show_enc(bytes([250, 251, 252, 253, 254, 255, 248, 249]))
    show_enc(bytes([248, 252]))
    show_enc(bytes([255, 255, 255, 255, 255, 255, 255]))
    show_enc(bytes([0, 0, 0, 0]))
    show_enc(bytes([128, 128, 128, 128, 128]))
    show_dec('')
    show_dec('00')
    show_dec('ff')
    show_dec('FF')
    show_dec('deadbeef')
    show_dec('DEADBEEF')
    show_dec('DeAdBeEf')
    show_dec('0')
    show_dec('abc')
    show_dec('a')
    show_dec('0g')
    show_dec('g0')
    show_dec('zz')
    show_dec(' 00')
    show_dec('00 ')
    show_dec('00 ff')
    show_dec('0x00')
    show_dec('-1')
    show_dec('+1')
    show_dec('é1')
    show_dec('1é')
    show_dec('日本')
    show_dec('\n')
    show_dec('00\n')
    show_dec('0 0')
    show_dec('aA')
    show_dec('00112233445566778899aabbccddeeff')
    show_dec('0123456789abcdefABCDEF')
    show_dec('ｆｆ')
    show_dec('٠٠')
    show_dec('²²')
