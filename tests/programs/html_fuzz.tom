# html.unescape on every 17th named reference of the HTML 5 table (with and without a semicolon, inside text) and on
# random mixtures of reference pieces; expected output generated with python3 as an oracle only.
import html

def show(text: str):
    print(f'[{html.unescape(text)}]')

