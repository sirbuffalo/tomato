# std/cache.tom memoize / Memo: results are remembered, counted, evicted, expired; errors pass through; one to four arguments.
# The functions print when they really run (a function value cannot capture a list yet).
from cache import Clock, Memo, memoize

class FakeClock(Clock):
    t: float = 0.0

    override def now(self) -> float:
        return self.t

def square(x: int) -> int:
    print('run', x)
    return x * x

def shout(s: str) -> str:
    return s + '!'

def add(a: int, b: int) -> int:
    print('add', a, b)
    return a + b

def label(n: int, s: str, big: bool) -> str:
    print('label', n, s, big)
    return f'{s}{n}' + ('!' if big else '')

def scale(a: int, b: int, c: str, d: float) -> float:
    print('scale', a, b, c, d)
    return a * b * d

def fail(x: int) -> int:
    print('try', x)
    if x < 0:
        raise RuntimeError('negative')
    return x + 1

@main
def main():
    m = memoize(square, 2)
    print(m.call(3), m.call(3), m.call(4))
    print(m.results.hits, m.results.misses)
    # capacity 2: 5 evicts 3 (least recently used), so 3 runs again
    print(m.call(5), m.call(3), m.results.evictions)
    m.clear()
    print(m.call(4))
    # text arguments
    u = memoize(shout, 3)
    print(u.call('a'), u.call('a'), u.results.hits)
    # errors are not remembered
    f = memoize(fail, 4)
    try:
        f.call(-1)
    catch RuntimeError as e:
        print('caught', e.message)
    try:
        f.call(-1)
    catch RuntimeError as e:
        print('caught again')
    print(f.call(1), f.call(1), len(f.results))
    # expiry with a fake clock
    clk = FakeClock()
    t = Memo(square, 4, 10.0, clk)
    print(t.call(2), t.call(2))
    clk.t = 11.0
    print(t.call(2), t.results.expirations)
    # capacity 0 remembers nothing
    z = memoize(square, 0)
    print(z.call(2), z.call(2))
    # functions of several arguments: the cache key is all of them
    two = memoize(add, 2)
    print(two.call(1, 2), two.call(1, 2), two.call(2, 1), two.call(1, 2), two.call(3, 3), two.call(2, 1))
    print(two.results.hits, two.results.misses, two.results.evictions, two.results.keys())
    three = memoize(label, 10)
    print(three.call(1, 'a', True), three.call(1, 'a', False), three.call(1, 'a', True))
    four = Memo(scale, 10, 5.0, clk)
    print(four.call(2, 3, 'x', 0.5), four.call(2, 3, 'x', 0.5), four.call(2, 3, 'y', 0.5))
    clk.t = 20.0
    print(four.call(2, 3, 'x', 0.5), four.results.expirations)
    four.clear()
    print(len(four.results), four.results.keys())
