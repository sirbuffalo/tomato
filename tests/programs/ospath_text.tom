# ospath's text functions against a table made from Python's posixpath (generated once from Python 3.14.4, see tests/README.md; the expected
# output is committed): join, split, splitext, basename, dirname, isabs, normpath and relpath. Nothing here depends on the working
# directory or the environment, so it also runs in the browser.
import ospath

def show(text: str) -> str:
    return "'" + text + "'"

def pair(t: tuple[str, str]) -> str:
    return '(' + show(t[0]) + ', ' + show(t[1]) + ')'

@main
def main():
    print("join('a')", show(ospath.join('a')))
    print("join('a', 'b')", show(ospath.join('a', 'b')))
    print("join('a', 'b', 'c')", show(ospath.join('a', 'b', 'c')))
    print("join('/a', 'b')", show(ospath.join('/a', 'b')))
    print("join('a', '/b')", show(ospath.join('a', '/b')))
    print("join('a', '/b', 'c')", show(ospath.join('a', '/b', 'c')))
    print("join('a/', 'b')", show(ospath.join('a/', 'b')))
    print("join('a', 'b/')", show(ospath.join('a', 'b/')))
    print("join('a/', '/b')", show(ospath.join('a/', '/b')))
    print("join('', 'a')", show(ospath.join('', 'a')))
    print("join('a', '')", show(ospath.join('a', '')))
    print("join('', '')", show(ospath.join('', '')))
    print("join('a', '', 'b')", show(ospath.join('a', '', 'b')))
    print("join('', '', 'x')", show(ospath.join('', '', 'x')))
