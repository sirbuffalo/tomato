@main
def main():
    print(floor(2.5), floor(-2.5), floor(7), floor(-7), floor(2.0), floor(-2.0), floor(0.0), floor(-0.0), floor(0.999999999999999), floor(-0.0000001))
    print(ceil(2.5), ceil(-2.5), ceil(7), ceil(-7), ceil(2.0), ceil(-2.0), ceil(0.0), ceil(-0.0), ceil(0.0000001), ceil(-0.999999999999999))
    print(trunc(2.5), trunc(-2.5), trunc(7), trunc(-7), trunc(2.9999999), trunc(-2.9999999), trunc(0.5), trunc(-0.5))
    print(floor(1e20), ceil(1e20 + 0.5), trunc(-1e20), floor(-1e300) == -(10 ** 300) or floor(-1e300) < -(10 ** 299), floor(123456789.987654), ceil(123456789.123456))
    print(floor(10 ** 40), ceil(-(10 ** 40)), trunc(10 ** 40 + 1), floor(4.611686018427388e18), floor(-4.611686018427388e18 - 1e3), ceil(9.00719925474099e15 + 0.5))
    print(isnan(1.5), isnan(0.0), isnan(3), isinf(1.5), isinf(1e300), isinf(3), isfinite(1.5), isfinite(-0.0), isfinite(1e300), isfinite(3))
    print(copysign(3, -0.0), copysign(3.5, -1), copysign(-3.5, 1), copysign(-3.5, -2), copysign(0.0, -1), copysign(-0.0, 1), copysign(0, -5), copysign(5, 0), copysign(2, -2.5), copysign(1e300, -1e-300))
    print(factorial(0), factorial(1), factorial(2), factorial(5), factorial(20), factorial(21), factorial(25), factorial(100))
    print(len(str(factorial(1000))), factorial(30) // factorial(28), factorial(40) % 1000003)
    print(comb(0, 0), comb(1, 0), comb(1, 1), comb(5, 2), comb(5, 3), comb(10, 5), comb(52, 5), comb(100, 50), comb(5, 6), comb(0, 1), comb(60, 30), comb(1000, 3), comb(30, 0), comb(30, 30), comb(200, 100) % 1000003)
    print(perm(0, 0), perm(1, 0), perm(1, 1), perm(5, 2), perm(5, 5), perm(5, 6), perm(10, 3), perm(52, 5), perm(100, 3), perm(30, 15), perm(20, 20), perm(0, 1), perm(100, 50) % 1000003)
    print(isqrt(0), isqrt(1), isqrt(2), isqrt(3), isqrt(4), isqrt(8), isqrt(9), isqrt(15), isqrt(16), isqrt(17), isqrt(99), isqrt(100), isqrt(10 ** 6), isqrt(10 ** 6 - 1), isqrt(10 ** 6 + 1))
    print(isqrt(4611686018427387904), isqrt(4611686018427387903), isqrt(10 ** 18), isqrt(10 ** 18 - 1), isqrt(2 * 10 ** 18), isqrt(10 ** 40), isqrt(10 ** 40 - 1), isqrt(10 ** 40 + 1), isqrt(2 * 10 ** 41), isqrt(7 * 10 ** 99), isqrt(10 ** 200 + 12345))
    print(isqrt(123456789 ** 2), isqrt(123456789 ** 2 - 1), isqrt(123456789 ** 2 + 2 * 123456789), isqrt((10 ** 30 + 7) ** 2), isqrt((10 ** 30 + 7) ** 2 - 1), isqrt(3 ** 200))
    sums()
    print(fsum([]), fsum([0.0]), fsum([-0.0]), fsum([1.5]), fsum([-1.5, 1.5]), fsum([0.5, 0.25, 0.125]), fsum([1e-300, 1e300, -1e300]))
    print(prod([]), prod([5]), prod([1, 2, 3, 4, 5]), prod([-2, 3]), prod([-2, -3]), prod([0, 5]), prod([10 ** 20, 10 ** 20]), prod([7] * 30), prod([i for i in range(1, 25)]) == factorial(24))
