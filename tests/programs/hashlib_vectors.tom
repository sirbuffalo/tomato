import hashlib

@main
def main():
    items: list[int] = []
    for n in range(201):
        data = bytes(items)
        print(n, hashlib.sha256(data).hexdigest(), hashlib.sha224(data).hexdigest(), hashlib.sha1(data).hexdigest(), hashlib.md5(data).hexdigest())
        items.append(n % 256)
    data = bytes(items)
    good = True
    for split in range(201):
        h = hashlib.sha256(data[:200][:split])
        original = h.copy()
        first = h.hexdigest()
        if first != h.hexdigest() or original.hexdigest() != first:
            good = False
        h.update(data[split:200])
        if h.hexdigest() != hashlib.sha256(data[:200]).hexdigest() or original.hexdigest() != first:
            good = False
    h = hashlib.sha256(b'\x01\x02')
    for name in ['sha224', 'sha1', 'md5']:
        expected = hashlib.new(name, data[:200]).hexdigest()
        for split in range(201):
            part = hashlib.new(name, data[:split])
            part.update(data[split:200])
            if part.hexdigest() != expected:
                good = False
    print('incremental', good, h.hexdigest() == hashlib.sha256(b'\x01\x02').hexdigest())
    print('text', hashlib.sha256('hé😀'.encode()).hexdigest())
    two = b'abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq'
    print(hashlib.sha256(two).hexdigest(), hashlib.sha224(two).hexdigest(), hashlib.sha1(two).hexdigest(), hashlib.md5(two).hexdigest())
    long = b'abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmnhijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu'
    print(hashlib.sha256(long).hexdigest(), hashlib.sha224(long).hexdigest(), hashlib.sha1(long).hexdigest(), hashlib.md5(long).hexdigest())
    print('million', hashlib.sha256(b'a' * 1000000).hexdigest())
