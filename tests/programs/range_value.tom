@main
def main():
    # printing shows start, stop and step, even when the program wrote fewer
    print(range(100))
    print(range(1, 100))
    print(range(5, 10, 2))
    print(range(10, 0, -3))
    r = range(5, 10)
    print(r)
    print(str(r), [range(3)])
    # a sequence: length, indexing (negative too), membership
    print(len(range(5)), len(range(3, 3)), len(range(10, 0, -3)), len(range(0, 10, 4)), len(range(5, 0)))
    print(r[0], r[4], r[-1], r[-5])
    print(7 in r, 4 in r, 10 in r, 9 in range(0, 10, 3), 8 in range(0, 10, 3), 4 in range(10, 0, -3), 3 in range(10, 0, -3))
    # slicing gives another range
    print(r[1:3], r[::2], r[::-1], r[-2:], r[:-3], r[10:], r[-100:2], r[::-2])
    print(len(r[1:4]), r[1:4][0])
    print(len(range(1000000000)), range(1000000000)[999999999], 999999999 in range(1000000000))
    # reversed, sorted, sum, min, max and list()
    print(reversed(r), reversed(range(10, 0, -3)), sorted(range(10, 0, -3)), sorted(r))
    print(sum(r), sum(range(101)), sum(range(10, 0, -3)), sum(range(0)), min(r), max(r), min(range(10, 0, -3)), max(range(10, 0, -3)))
    print(list(range(4)), list(range(3, 0, -1)), list(range(0)))
    copy = list(range(3))
    copy.append(9)
    print(copy)
    # equality compares the numbers, not how the range was written
    print(range(3) == range(0, 3, 1), range(0) == range(5, 5), range(5, 10) == range(5, 10, 1), range(3) == range(4), range(5, 10, 2) == range(5, 9, 2), range(1, 2) == range(1, 5, 9))
    print(range(3) != range(0, 3), range(2) != range(3))
    # loops: the compiler counts for all of range(n), range(a, b) and range(a, b, step) (tests/programs/range_step_loop.tom checks them against the range value)
    for i in range(3):
        print(i)
    for i in range(7, 9):
        print(i)
    for i in range(0, 10, 4):
        print(i)
    for i in range(10, 0, -4):
        print(i)
    for i in range(5, 5):
        print('never')
    stop = 3
    for i in range(stop + 1):
        print(i, i * 2)
    total = 0
    for x in r:
        total += x
    print(total)
    for x in r[::-1]:
        if x == 7:
            continue
        if x == 5:
            break
        print(x)
    try:
        bad = range(1, 5, 0)  # allow: unused
    catch RuntimeError as e:
        print('caught', e.message)
    try:
        print(r[5])
    catch RuntimeError as e:
        print('caught', e.message)
    try:
        print(r[-6])
    catch RuntimeError as e:
        print('caught', e.message)
    try:
        print(r[::0])
    catch RuntimeError as e:
        print('caught', e.message)
    try:
        print(min(range(0)))
    catch RuntimeError as e:
        print('caught', e.message)
