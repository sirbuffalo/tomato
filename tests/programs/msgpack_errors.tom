# MessagePack data that must be rejected, and values that cannot be encoded
from json import loads_msgpack, dumps_msgpack, dumps, MsgpackError, JSONEncodeError
from value import Value, Int, Ext, Bin, Timestamp, List, Dict

def bad(h: str):
    try:
        # an odd last digit is dropped (a3616 is a36162's first two bytes), as the old helper did
        print('ACCEPTED', h, dumps(loads_msgpack(bytes.fromhex(h[0:len(h) // 2 * 2]))))
    catch MsgpackError as e:
        print(h[0:20], e.message, e.pos)

def cannot(j: Value):
    try:
        print('ENCODED', dumps_msgpack(j))
    catch MsgpackError as e:
        print(e.message)

@main
def main():
    print('-- decoding')
    bad('')
    bad('c1')
    bad('cd01')
    bad('cf000000000000')
    bad('a3616')
    bad('a36162')
    bad('d9')
    bad('d90261')
    bad('c40361')
    bad('c7')
    bad('d4')
    bad('d40a')
    bad('93010203' + '04')
    bad('c0c0')
    bad('92c0')
    bad('dd00000005c0c0')
    bad('dd7fffffffc0')
    bad('81c001')
    bad('8101' + '01')
    bad('81a16181')
    bad('a1ff')
    bad('a2c328')
    bad('a1e2')
    bad('a3eda080')
    bad('a2c080')
    bad('d6ff00000000' + '00')
    bad('d5ff0000')
    bad('c70dff' + '00' * 13)
    bad('c70cff3b9aca00' + '00' * 8)
    bad('c70cff00000000' + '7fffffffffffffff')
    bad('d7ff' + 'ffffffffffffffff')
    bad('92' + '01')
    print('-- nesting')
    d = ''
    for i in range(512):
        d += '91'
    print(len(dumps(loads_msgpack(bytes.fromhex(d + 'c0')))))
    bad('91' + d + 'c0')
    print('-- encoding')
    cannot(Int(18446744073709551616))
    cannot(Int(-9223372036854775809))
    cannot(Int(10 ** 40))
    cannot(Ext(-1, bytes([1])))
    cannot(Ext(128, bytes([1])))
    cannot(Ext(-129, bytes([1])))
    cannot(Timestamp(1, 1000000000))
    cannot(Timestamp(1, -1))
    cannot(Timestamp(4611686018427387904))
    deep = List([])
    for i in range(511):
        deep = List([deep])
    print(len(dumps_msgpack(deep)))
    cannot(List([deep]))
    cannot(Dict({'a': List([deep])}))
    print('-- bytes that are not bytes: bytes() refuses them before MessagePack is involved')
    for bad_list in [[1, 2, 300], [0 - 1], [10 ** 30], [1, 256], [1, 0 - 1]]:
        try:
            loads_msgpack(bytes(bad_list))
        catch ValueError as e:
            print(e.id, e.message)
    print('-- JSON text cannot hold these')
    items: list[Value] = [Bin(b'\x01'), Ext(3, b'\x01'), Timestamp(5)]
    for j in items:
        try:
            print(dumps(j))
        catch JSONEncodeError as e:
            print(e.message)
