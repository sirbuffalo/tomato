    read('read34', '"abc', ',')
    read('read35', '"a""', ',')
    read('read36', 'a,b,c\n1,2', ',')
    read('read37', '"a"\n"b"\n', ',')
    read('read38', '"a"""\n', ',')
    read('read39', 'a\n', ',')
    read('read40', '"x"\r', ',')
    read('read41', '"x\r"\n', ',')
    read('delim0', 'a,b', '')
    read('delim1', 'a,b', ',,')
    read('delim2', 'a,b', '"')
    read('delim3', 'a,b', '\n')
    read('delim4', 'a,b', '\r')
    write('write0', [['a', 'b', 'c']], ',')
    write('write1', [['a', 'b,c'], ['say "hi"', '']], ',')
    write('write2', [['']], ',')
    write('write3', [[]], ',')
    write('write4', [['', ''], ['']], ',')
    write('write5', [], ',')
    write('write6', [['line1\nline2', 'x'], ['y\rz', 'w']], ',')
    write('write7', [['a;b', 'c']], ';')
    write('write8', [['a;b', 'c,d']], ',')
