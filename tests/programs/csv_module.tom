# std/csv.tom: RFC 4180 reading and writing; expected output comes from Python's csv module (strict mode) as an oracle
from csv import reader, writer, dict_reader

def field(f: str) -> str:
    return f.replace('\\', '\\\\').replace('\n', '\\n').replace('\r', '\\r').replace('\t', '\\t')

def show_rows(label: str, rows: list[list[str]]):
    print(label, len(rows))
    for row in rows:
        out: list[str] = []
        for f in row:
            out.append(field(f))
        print('  [' + '|'.join(out) + ']')

def read(label: str, text: str, delimiter: str = ','):
    try:
        show_rows(label, reader(text, delimiter))
    catch ValueError as e:
        print(label, 'ValueError:', field(e.message))

def write(label: str, rows: list[list[str]], delimiter: str = ','):
    print(label, field(writer(rows, delimiter)))

def read_dicts(label: str, text: str, delimiter: str = ','):
    try:
        records = dict_reader(text, delimiter)
        print(label, len(records))
        for record in records:
            out: list[str] = []
            for k, v in record.items():
                out.append(field(k) + '=' + field(v))
            print('  {' + ';'.join(out) + '}')
    catch ValueError as e:
        print(label, 'ValueError:', field(e.message))

@main
def main():
    read('read0', 'a,b,c', ',')
    read('read1', 'a,b,c\n1,2,3\n', ',')
    read('read2', 'a,b,c\r\n1,2,3\r\n', ',')
    read('read3', '', ',')
    read('read4', '\n', ',')
    read('read5', '\n\n', ',')
    read('read6', 'a,,c', ',')
    read('read7', ',', ',')
    read('read8', ',,', ',')
    read('read9', 'a,', ',')
    read('read10', '"a","b"', ',')
    read('read11', '"a,b",c', ',')
    read('read12', '"say ""hi""",x', ',')
    read('read13', '"line1\nline2",x\ny,z\n', ',')
    read('read14', '"line1\r\nline2",x\r\ny,z\r\n', ',')
    read('read15', '"a\n\nb"', ',')
    read('read16', 'a\n\nb\n', ',')
