    write('write15', [['a b', 'c']], ' ')
    write('write16', [[' ', 'x']], ',')
    write('write17', [['1', '2', '3'], ['4', '5', '6']], ',')
    read_dicts('dict0', 'name,age\nAnn,31\nBob,25\n', ',')
    read_dicts('dict1', 'name,age\r\nAnn,31\r\n', ',')
    read_dicts('dict2', 'a,b,c\n1,2\n', ',')
