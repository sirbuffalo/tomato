# quote, unquote, urlencode and parse_qs against Python 3 urllib.parse (expected output generated with python3 as an oracle only).
from urlparse import quote, unquote, urlencode, parse_qs

def show_quote(text: str, safe: str):
    print(f'[{quote(text, safe)}]')

def show_unquote(text: str):
    print(f'[{unquote(text)}]')

def no_pairs() -> list[tuple[str, str]]:
    return []

def show_encode(pairs: list[tuple[str, str]]):
    print(f'[{urlencode(pairs)}]')

def show_qs(query: str):
    fields = parse_qs(query)
    parts: list[str] = []
    for name, values in fields.items():
        parts.append(f"{name}={','.join(values)}")
    print(f"{'|'.join(parts)}|{len(fields)}")

@main
def main():
    show_quote('', '/')
    show_quote('', '')
    show_quote('abc', '/')
