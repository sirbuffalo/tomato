# float[length=64] is the plain 64-bit double that float is (stage 1 of docs/bigfloat-design.md): the same type, spelled with its size
class Point:
    x: float[length=64]
    y: float = 0.5

    @init
    def make(self, x: float[length=64], y: float[length=64]):
        self.x = x
        self.y = y

    def norm2(self) -> float[length=64]:
        return self.x * self.x + self.y * self.y

class Box[T]:
    item: T

    @init
    def make(self, item: T):
        self.item = item

    def get(self) -> T:
        return self.item

def half(x: float[length=64]) -> float:
    return x / 2

def twice(x: float) -> float[length=64]:
    return x * 2

def total(xs: list[float[length=64]]) -> float:
    t: float[length=64] = 0.0
    for x in xs:
        t += x
    return t

def pick(v: float[length=64] | str) -> str:
    if v in str:
        return 'text ' + v
    return f'number {v}'

def either(flag: bool) -> float[length=64] | int:
    if flag:
        return 2.5
    return 7

def widen(v: int | float) -> float[length=64]:
    if v in int:
        return float(v)
    return v

def apply(f: fn(float[length=64]) -> float, x: float) -> float[length=64]:
    return f(x)

@main
def main():
    a: float[length=64] = 1.5
    b: float = a + 1
    c: float[length=64] = b * 2
    print(a, b, c)
    print(half(c), twice(a), half(twice(a)))
    xs: list[float[length=64]] = [1.0, 2.5, 3.0]
    ys: list[float] = xs
    ys.append(4.0)
    print(total(xs), total(ys), len(xs))
    d: dict[str, float[length=64]] = {'a': 1.5, 'b': 2.5}
    e: dict[str, float] = d
    print(d['a'] + e['b'])
    t: tuple[float[length=64], int] = (2.5, 3)
    u: tuple[float, int] = t
    print(t, u)
    p = Point(3.0, 4.0)
    print(p.norm2(), p.x, p.y)
    bx = Box[float[length=64]](2.25)
    by: Box[float] = Box[float](bx.get())
    print(bx.get() + by.get())
    print(pick(1.5), pick('hi'))
    print(either(True), either(False))
    print(widen(3), widen(1.25))
    print(apply(half, 9.0))
    n: int = 7
    print(float[length=64](n) / 2, float[length=64](a) + 1, float[length=64]('2.5'))
    print(float(n) == float[length=64](n))
    print(a == 1.5, b > a, a + b)
