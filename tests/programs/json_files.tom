# json load(path) / dump(value, path), and toml dump(path): round trips, options, errors.
from json import loads_msgpack, loads, load, dump, dumps, JsonNull, JSONDecodeError, JSONEncodeError
import toml

@main
def main(dir: str = '/tmp'):
    # tests/run.sh passes its own temporary folder: a fixed name in a shared /tmp can belong to another user
    path = dir + '/tomato_json_files_test.json'
    j = loads('{"name": "tomato", "tags": ["red", "round"], "n": 3, "é": null}')
    dump(j, path)
    f = open(path, 'r')
    print(f.read())
    f.close()
    print(dumps(load(path)) == dumps(j))
    dump(j, path, indent=2, sort_keys=True, ensure_ascii=True)
    f = open(path, 'r')
    print(f.read())
    f.close()
    # a shorter value replaces the file
    dump(JsonNull(), path)
    f = open(path, 'r')
    print(f.read())
    f.close()
    # a value JSON cannot hold leaves the file alone
    try:
        dump(loads_msgpack([196, 1, 65]), path)
    catch JSONEncodeError as e:
        print('encode error')
    print(dumps(load(path)))
    # bad content and bad paths
    f = open(path, 'w')
    f.write('{"a": ')
    f.close()
    try:
        load(path)
    catch JSONDecodeError as e:
        print('decode error')
    try:
        load('/tmp/tomato_no_such_dir/x.json')
    catch IOError as e:
        print('load:', e.message)
    try:
        dump(j, '/tmp/tomato_no_such_dir/x.json')
    catch IOError as e:
        print('dump:', e.message)
    # toml
    tpath = dir + '/tomato_json_files_test.toml'
    t = toml.loads('a = 1\n[b]\nc = "x"\n')
    toml.dump(t, tpath)
    print(toml.dumps(toml.load(tpath)) == toml.dumps(t))
    try:
        toml.dump(t, '/tmp/tomato_no_such_dir/x.toml')
    catch IOError as e:
        print('toml dump:', e.message)
    try:
        toml.dump(toml.integer(1), tpath)
    catch RuntimeError as e:
        print(e.message)
    print(toml.dumps(toml.load(tpath)) == toml.dumps(t))
