# gzip (stage 1 of docs/shell-to-tomato-plan.md): compress and decompress, round trips at every level on data of every kind, files made here read by
# the system gzip and files made by it read here, several members, and the errors for data that is wrong. Native only (it starts gzip). The first
# input is a folder for this test's files.
import gzip
import os
import sys

# a repeatable stream of bytes that no match can predict: a linear congruential generator
def noise(n: int, seed: int) -> bytes:
    out: list[int] = []
    x = seed
    for i in range(n):
        x = (x * 1103515245 + 12345) % 2147483648
        out.append((x >> 16) % 256)
    return bytes(out)

def text_data(n: int) -> bytes:
    words = ['tomato', 'is', 'a', 'language', 'for', 'programs', 'that', 'compile', 'to', 'machine', 'code', '\n']
    out = ''
    x = 7
    while len(out) < n:
        x = (x * 1103515245 + 12345) % 2147483648
        out += words[(x >> 16) % len(words)] + ' '
    return out[:n].encode()

def attempt(label: str, data: bytes, limit: int | None = None):
    try:
        got = gzip.decompress(data, limit)
        print(label, 'ok', len(got))
    catch gzip.GzipError as e:
        print(label, e.id, e.message.split(': ')[1])

def sections_round_trips():
    samples: list[bytes] = [b'', b'a', b'hello world', b'abc' * 1000, bytes(100000), noise(70000, 1), text_data(300000), bytes(list(range(256)) * 20)]
    for data in samples:
        sizes = ''
        for level in [1, 6, 9]:
            packed = gzip.compress(data, level)
            sizes += f' {len(packed)}' if len(data) < 1000 else f' {len(packed) * 100 // len(data)}%'
            if gzip.decompress(packed) != data:
                print('ROUND TRIP FAILED', len(data), level)
        print('round trip', len(data), sizes)
    print('same input, same bytes', gzip.compress(b'x' * 5000) == gzip.compress(b'x' * 5000), gzip.compress(b'hi')[:4], gzip.compress(b'hi')[4:8])
    packed = gzip.compress(text_data(200000))
    print('level 9 is not larger than level 1', len(gzip.compress(text_data(200000), 9)) <= len(gzip.compress(text_data(200000), 1)), len(packed) < 200000 // 2)
    # more than one block, and a window that slides (inputs over 128 KiB), with both matches far apart and noise
    big = text_data(400000) + noise(100000, 3) + text_data(400000)
    print('big', gzip.decompress(gzip.compress(big, 5)) == big)

def sections_known():
    # the output of `gzip -9 -n` for these, written out, and a stored block, and two members
    hello = bytes.fromhex('1f8b0800000000000203cb48cdc9c95728cf2fca49010085114a0d0b000000')
    print('gzip hello', gzip.decompress(hello))
    two = hello + hello
    print('two members', gzip.decompress(two))
    print('empty member', gzip.decompress(gzip.compress(b'')) == b'', gzip.decompress(gzip.compress(b'') + gzip.compress(b'x')))

def sections_errors():
    good = gzip.compress(b'hello hello hello hello hello hello')
    attempt('empty', b'')
    attempt('not gzip', b'this is text, not gzip data at all')
    attempt('cut short', good[:len(good) - 5])
    attempt('cut in the header', good[:6])
    attempt('trailer cut', good[:len(good) - 1])
    damaged = good[:12] + bytes([good[12] ^ 255]) + good[13:]
    attempt('damaged', damaged)
    attempt('bad checksum', good[:len(good) - 8] + bytes([good[len(good) - 8] ^ 1]) + good[len(good) - 7:])
    attempt('bad size', good[:len(good) - 1] + bytes([good[len(good) - 1] ^ 1]))
    attempt('after the end', good + b'junk')
    attempt('zeros after the end', good + bytes(20))
    attempt('limit too small', gzip.compress(bytes(100000)), 1000)
    attempt('limit exact', gzip.compress(bytes(1000)), 1000)
    attempt('limit larger', gzip.compress(bytes(1000)), 100000)
    try:
        gzip.compress(b'x', 0)
    catch ValueError as e:
        print('level 0', e.id)
    try:
        gzip.compress(b'x', 10)
    catch ValueError as e:
        print('level 10', e.id)
    try:
        gzip.decompress(good, 0)
    catch ValueError as e:
        print('max_size 0', e.id)

def sections_system(work: str):
    data = text_data(500000) + noise(50000, 9)
    os.write_bytes(work + '/mine.gz', gzip.compress(data, 6))
    t = sys.run(['gzip', '-t', work + '/mine.gz'])
    print('gzip -t reads ours', t.status, len(t.stderr))
    os.write_bytes(work + '/plain', data)
    sys.run(['sh', '-c', 'gzip -dc "$1" > "$2"', 'sh', work + '/mine.gz', work + '/back'], check=True)
    print('gzip -dc gives the data back', os.read_bytes(work + '/back') == data)
    for level in ['-1', '-6', '-9']:
        sys.run(['sh', '-c', 'gzip ' + level + ' -c "$1" > "$2"', 'sh', work + '/plain', work + '/theirs.gz'], check=True)
        print('we read gzip', level, gzip.decompress(os.read_bytes(work + '/theirs.gz')) == data)
    sys.run(['sh', '-c', 'cat "$1" "$1" > "$2"', 'sh', work + '/mine.gz', work + '/twice.gz'], check=True)
    print('two members from files', gzip.decompress(os.read_bytes(work + '/twice.gz')) == data + data)
    t = sys.run(['gzip', '-t', work + '/twice.gz'])
    print('gzip -t reads two', t.status)
    names = ['rnd', 'zeros', 'empty']
    for i, name in enumerate(names):
        d = noise(100000, 5) if i == 0 else (bytes(1000000) if i == 1 else b'')
        os.write_bytes(work + '/' + name, d)
        sys.run(['sh', '-c', 'gzip -c "$1" > "$2"', 'sh', work + '/' + name, work + '/' + name + '.gz'], check=True)
        print('we read gzip of', name, gzip.decompress(os.read_bytes(work + '/' + name + '.gz')) == d)

@main
def main(work: str):
    sections_round_trips()
    sections_known()
    sections_errors()
    sections_system(work)
