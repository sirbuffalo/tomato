# The line editor library std/lineedit.tom without a terminal, as @test functions (`tomato test tests/lineedit_logic.tom`, which
# tests/run.sh runs in debug and release mode): Buffer, History (with the history file and the old ⏎ format), the layout of lines on the
# screen, the frames, and whole editing sessions on a FakeTerminal with scripted keys. The repl's own rules (when Enter runs a piece, the
# indent) are tested in tests/repledit_logic.tom; the real terminal in tests/repl_history.exp.
import os
import terminal
import lineedit
from terminal import Key, Style
from lineedit import Buffer, History, Editor, Result, TermIO, Validator, Highlighter, Completer, Completion, KillRing, Run
from testing import assert_equal, assert_true, assert_false

# ---- helpers ---------------------------------------------------------------------------------------------------------------

# escape codes spelled out: ESC is shown as \e, CR as \r, LF as \n
def spelled(text: str) -> str:
    return text.replace(chr(27), '\\e').replace('\r', '\\r').replace('\n', '\\n')

# A terminal with scripted keys that records every write. A 'resize' key changes the size to the next of `sizes` first.
class FakeTerminal implements TermIO:
    keys: list[Key] = []
    writes: list[str] = []
    rows: int = 24
    cols: int = 80
    sizes: list[tuple[int, int]] = []
    raw: bool = False
    raw_calls: int = 0
    leave_calls: int = 0

    def read_key(self, timeout: int | float = -1.0) -> Key:
        if len(self.keys) == 0:
            return Key('eof')
        k = self.keys[0]
        self.keys = self.keys[1:]
        if k.kind == 'resize' and len(self.sizes) > 0:
            self.rows, self.cols = self.sizes[0]
            self.sizes = self.sizes[1:]
        return k

    def write(self, text: str):
        self.writes.append(text)

    def size(self) -> tuple[int, int]:
        return self.rows, self.cols

    def enter_raw(self):
        self.raw = True
        self.raw_calls += 1

    def leave(self):
        self.raw = False
        self.leave_calls += 1

    # every write as one text
    def output(self) -> str:
        return ''.join(self.writes)

def ch(text: str) -> Key:
    return Key('char', text)

def ctrl(c: str) -> Key:
    return Key('char', c, '', True)

def named(name: str) -> Key:
    return Key('key', '', name)

def chars(text: str) -> list[Key]:
    out: list[Key] = []
    for c in text:
        out.append(ch(c))
    return out

def up() -> Key:
    return named('up')

def down() -> Key:
    return named('down')

def enter() -> Key:
    return named('enter')

# a validator like the repl's, without the lexer: a text whose first line ends with ':' is complete once its last line is empty
class BlockRule implements Validator:
    def complete(self, text: str) -> bool:
        lines = text.split('\n')
        if not lines[0].endswith(':'):
            return True
        return len(lines) > 1 and lines[len(lines) - 1].strip() == ''

class ColonIndent implements lineedit.Indenter:
    def indent_after(self, line: str, before: str) -> str:
        ind = lineedit.leading_spaces(line)
        if line.rstrip(' ').endswith(':'):
            ind += '    '
        return ind

def block_editor(entries: list[str]) -> Editor:
    ed = Editor()
    ed.history = History(entries, 1000)
    ed.validator = BlockRule()
    ed.indenter = ColonIndent()
    return ed

# runs an editor over the keys; the result and the fake terminal
def session(ed: Editor, keys: list[Key]) -> tuple[Result, FakeTerminal]:
    term = FakeTerminal()
    term.keys = keys
    result = ed.read(term)
    return result, term

def buf(text: str, row: int, col: int) -> Buffer:
    b = Buffer()
    b.set_text(text)
    b.row = row
    b.col = col
    return b

def where(b: Buffer) -> str:
    return f'{b.row}:{b.col} ' + b.text().replace('\n', '|')

def temp_path(name: str) -> str:
    folder = os.getenv('TMPDIR')
    if folder is None or folder == '':
        folder = '/tmp'
    return f'{folder}/lineedit_test_{os.getpid()}_{name}'

# ---- Buffer ----------------------------------------------------------------------------------------------------------------

@test.buffer_insert_and_split
def buffer_insert_and_split():
    b = Buffer()
    assert_true(b.is_empty())
    b.insert('ab')
    assert_equal(where(b), '0:2 ab')
    b.left()
    b.insert('X\nY')
    assert_equal(where(b), '1:1 aX|Yb')
    b.insert('\n\n')
    assert_equal(where(b), '3:0 aX|Y||b')
    b.newline('    ')
    assert_equal(where(b), '4:4 aX|Y|||    b')
    b2 = buf('if x:  y', 0, 5)
    b2.newline('    ')                       # the spaces after the cursor give way to the indent
    assert_equal(where(b2), '1:4 if x:|    y')

@test.buffer_backspace_and_delete_join_lines
def buffer_backspace_and_delete_join_lines():
    b = buf('ab\ncd', 1, 0)
    assert_true(b.backspace())
    assert_equal(where(b), '0:2 abcd')
    b.col = 0
    assert_false(b.backspace())
    b = buf('ab\ncd', 0, 2)
    assert_true(b.delete())
    assert_equal(where(b), '0:2 abcd')
    b.end()
    assert_false(b.delete())
    b = buf('héllo', 0, 2)
    b.backspace()
    assert_equal(where(b), '0:1 hllo')

@test.buffer_moves_cross_line_ends
def buffer_moves_cross_line_ends():
    b = buf('ab\ncd', 1, 0)
    assert_true(b.left())
    assert_equal(where(b), '0:2 ab|cd')
    assert_true(b.right())
    assert_equal(where(b), '1:0 ab|cd')
    b.end()
    assert_false(b.right())
    b.row = 0
    b.col = 0
    assert_false(b.left())

@test.buffer_up_down_keep_the_column
def buffer_up_down_keep_the_column():
    b = buf('long line\nab\nanother', 0, 7)
    assert_true(b.down())
    assert_equal(where(b), '1:2 long line|ab|another')
    assert_true(b.down())
    assert_equal(b.col, 2)
    assert_false(b.down())
    assert_true(b.up())
    assert_true(b.up())
    assert_false(b.up())
    assert_equal(b.row, 0)

@test.buffer_words_and_kills
def buffer_words_and_kills():
    b = buf('print(x)  + total', 0, 17)
    b.word_left()
    assert_equal(b.col, 12)
    b.word_left()
    assert_equal(b.col, 10)
    b.word_left()
    assert_equal(b.col, 0)
    b.word_right()
    assert_equal(b.col, 8)
    b = buf('ab\ncd', 1, 0)
    b.word_left()
    assert_equal(where(b), '0:2 ab|cd')
    b.word_right()
    assert_equal(where(b), '1:0 ab|cd')
    b = buf('one two  three', 0, 9)
    assert_equal(b.kill_word_back(), 'two  ')
    assert_equal(where(b), '0:4 one three')
    assert_equal(b.kill_to_end(), 'three')
    assert_equal(where(b), '0:4 one ')
    b.col = 2
    assert_equal(b.kill_to_start(), 'on')
    assert_equal(where(b), '0:0 e ')
    b = buf('ab\ncd', 0, 2)
    assert_equal(b.kill_to_end(), '')         # within the line: it never joins lines
    assert_equal(b.text(), 'ab\ncd')

@test.buffer_indents
def buffer_indents():
    b = buf('        x', 0, 8)
    assert_true(b.dedent_back(4))
    assert_equal(where(b), '0:4     x')
    b.col = 3
    assert_true(b.dedent_back(4))             # to the previous tab stop
    assert_equal(where(b), '0:0  x')
    b = buf('  ab', 0, 3)
    assert_false(b.dedent_back(4))            # not in the indent: a plain backspace
    b = buf('      x', 0, 7)
    b.dedent(4)
    assert_equal(where(b), '0:3   x')
    b.dedent(4)
    b.dedent(4)
    assert_equal(where(b), '0:1 x')
    assert_equal(lineedit.leading_spaces('   a  '), '   ')

@test.buffer_set_text_puts_the_cursor_at_the_end
def buffer_set_text_puts_the_cursor_at_the_end():
    b = Buffer()
    b.set_text('for i in r:\n    print(i)')
    assert_equal(where(b), '1:12 for i in r:|    print(i)')
    assert_equal(lineedit.strip_trailing_lines('a\n  b\n    \n'), 'a\n  b')
    assert_equal(lineedit.strip_trailing_lines('   '), '')
    assert_equal(lineedit.strip_trailing_lines('x'), 'x')

# ---- History ---------------------------------------------------------------------------------------------------------------

@test.history_up_down_and_the_draft
def history_up_down_and_the_draft():
    h = History(['one', 'two', 'three'], 1000)
    assert_false(h.recalled())
    assert_equal(h.previous('typing'), 'three')
    assert_true(h.recalled())
    assert_equal(h.previous('three edited'), 'two')   # edits to a recalled entry are dropped
    assert_equal(h.previous('two'), 'one')
    assert_true(h.previous('one') is None)
    assert_equal(h.next(), 'two')
    assert_equal(h.next(), 'three')
    assert_equal(h.next(), 'typing')                   # past the newest: the draft
    assert_false(h.recalled())
    assert_true(h.next() is None)
    h.add('four')
    assert_equal(h.previous(''), 'four')
    h.reset()
    assert_equal(h.previous('new draft'), 'four')
    assert_equal(h.next(), 'new draft')

@test.history_limit
def history_limit():
    h = History(['a', 'b', 'c', 'd'], 3)
    assert_equal(', '.join(h.entries), 'b, c, d')
    h.add('e')
    assert_equal(', '.join(h.entries), 'c, d, e')
    e = History([], 1000)
    assert_true(e.previous('x') is None)
    assert_true(e.next() is None)

@test.history_file_old_format
def history_file_old_format():
    path = temp_path('old')
    # the file the bash repl wrote: ⏎ inside an entry, a trailing blank line, a tab, a CR and a control character
    os.write_text(path, 'x = 5\nfor i in range(2):⏎    print(i)\n\n\tprint(2)\r\nbad' + chr(7) + 'char\n\n')
    entries = lineedit.read_history(path, '⏎')
    assert_equal(len(entries), 4)
    assert_equal(entries[0], 'x = 5')
    assert_equal(entries[1], 'for i in range(2):\n    print(i)')
    assert_equal(entries[2], '    print(2)')
    assert_equal(entries[3], 'badchar')
    h = lineedit.load_history(path, '⏎', 2)
    assert_equal(len(h.entries), 2)
    os.remove(path)
    assert_equal(len(lineedit.read_history(path, '⏎')), 0)    # no file: no history

@test.history_file_append_and_trim
def history_file_append_and_trim():
    path = temp_path('dir') + '/sub/hist'
    lineedit.append_history(path, 'a = 1', '⏎', 3)              # the folders are made
    lineedit.append_history(path, 'if a:\n    print(a)', '⏎', 3)
    assert_equal(os.read_text(path), 'a = 1\nif a:⏎    print(a)\n')
    lineedit.append_history(path, 'b', '⏎', 3)
    lineedit.append_history(path, 'c', '⏎', 3)
    assert_equal(os.read_text(path), 'if a:⏎    print(a)\nb\nc\n')    # past the limit: only the newest 3
    lineedit.append_history(path, 'two\nlines', '', 0)
    assert_equal(os.read_text(path), '')
    lineedit.append_history(path, 'two\nlines', '', -1)        # joiner '': one line, limit -1: no trimming
    assert_equal(os.read_text(path), 'two lines\n')
    os.remove(path)
    assert_equal(lineedit.clean_text('a\tb\nc' + chr(27) + chr(127) + chr(155) + 'é', '  ', True), 'a  b\ncé')
    assert_equal(lineedit.clean_text('a\nb', '  ', False), 'ab')

# ---- layout ----------------------------------------------------------------------------------------------------------------

def rows_of(lay: lineedit.Layout) -> str:
    parts: list[str] = []
    for r in lay.rows:
        parts.append(str(r))
    return ' '.join(parts) + f' @{lay.cursor_row},{lay.cursor_col}'

@test.layout_rows_and_cursor
def layout_rows_and_cursor():
    assert_equal(rows_of(lineedit.layout([''], '>>> ', '... ', 80, 0, 0)), '0:0-0 @0,4')
    assert_equal(rows_of(lineedit.layout(['for x:', '    y'], '>>> ', '... ', 80, 1, 2)), '0:0-6 1:0-5 @1,6')
    # 4 + 12 cells at width 10: the line wraps after 6 characters, and the row after it starts at column 0
    assert_equal(rows_of(lineedit.layout(['abcdefghijkl'], '>>> ', '... ', 10, 0, 8)), '0:0-6 0:6-12 @1,2')
    assert_equal(rows_of(lineedit.layout(['abcdefghijkl'], '>>> ', '... ', 10, 0, 6)), '0:0-6 0:6-12 @1,0')

@test.layout_exactly_full_rows
def layout_exactly_full_rows():
    # '>>> ' + 6 characters fill a 10-cell row: with the cursor at the end, it goes to a row of its own
    assert_equal(rows_of(lineedit.layout(['abcdef'], '>>> ', '... ', 10, 0, 6)), '0:0-6 0:6-6 @1,0')
    # the cursor elsewhere: no extra row
    assert_equal(rows_of(lineedit.layout(['abcdef'], '>>> ', '... ', 10, 0, 2)), '0:0-6 @0,6')
    assert_equal(rows_of(lineedit.layout(['abcdef', 'x'], '>>> ', '... ', 10, 1, 1)), '0:0-6 1:0-1 @1,5')
    # two full rows
    assert_equal(rows_of(lineedit.layout(['abcdefghijklmnop'], '>>> ', '... ', 10, 0, 16)), '0:0-6 0:6-16 0:16-16 @2,0')

@test.layout_wide_and_combining_characters
def layout_wide_and_combining_characters():
    # 中 takes 2 cells: at column 9 of a 10-cell row it does not fit, so it starts the next row
    assert_equal(rows_of(lineedit.layout(['abcde中'], '>>> ', '... ', 10, 0, 6)), '0:0-5 0:5-6 @1,2')
    assert_equal(rows_of(lineedit.layout(['中中中'], '>>> ', '... ', 10, 0, 3)), '0:0-3 @0,10'.replace('@0,10', '0:3-3 @1,0'))
    # a combining accent takes no cell
    assert_equal(rows_of(lineedit.layout(['e' + chr(769) + 'x'], '>>> ', '... ', 80, 0, 3)), '0:0-3 @0,6')
    assert_equal(rows_of(lineedit.layout(['😀a'], '', '', 80, 0, 1)), '0:0-2 @0,2')

@test.frame_text
def frame_text():
    s = lineedit.Screen()
    f = s.frame(['for i in r:', '    print(i)'], [], '>>> ', '... ', 0, 3, False)
    assert_equal(spelled(f), '\\r\\e[J>>> for i in r:\\r\\n...     print(i)\\e[1A\\e[8G')
    assert_equal(s.cursor_row, 0)
    f = s.frame(['for i in r:', '    print(i)', ''], [], '>>> ', '... ', 2, 0, False)
    assert_equal(spelled(f), '\\r\\e[J>>> for i in r:\\r\\n...     print(i)\\r\\n... \\e[5G')
    assert_equal(s.cursor_row, 2)
    f = s.frame(['x'], [], '>>> ', '... ', 0, 1, False)
    assert_equal(spelled(f), '\\e[2A\\r\\e[J>>> x\\e[6G')

@test.frame_tall_block_shows_a_window
def frame_tall_block_shows_a_window():
    s = lineedit.Screen()
    s.height = 3
    lines = ['a', 'b', 'c', 'd', 'e']
    f = s.frame(lines, [], '>>> ', '... ', 4, 1, False)
    assert_equal(spelled(f), '\\r\\e[J... c\\r\\n... d\\r\\n... e\\e[6G')
    assert_equal(s.cursor_row, 2)
    f = s.frame(lines, [], '>>> ', '... ', 0, 0, False)
    assert_equal(spelled(f), '\\e[2A\\r\\e[J>>> a\\r\\n... b\\r\\n... c\\e[2A\\e[5G')
    f = s.frame(lines, [], '>>> ', '... ', 4, 1, True)        # the last frame: every row
    assert_equal(spelled(f), '\\r\\e[J>>> a\\r\\n... b\\r\\n... c\\r\\n... d\\r\\n... e\\e[6G')

class Shout implements Highlighter:
    def highlight(self, lines: list[str]) -> list[list[Run]]:
        out: list[list[Run]] = []
        for line in lines:
            runs: list[Run] = []
            k = line.find('if')
            if k >= 0:
                runs.append(Run(k, k + 2, Style(terminal.ansi(1))))
            out.append(runs)
        return out

@test.frame_with_runs_and_colors
def frame_with_runs_and_colors():
    s = lineedit.Screen()
    s.colors = 16
    s.prompt_style = Style(terminal.ansi(2))
    s.width = 7
    lines = ['x if y']
    runs = Shout().highlight(lines)
    f = s.frame(lines, runs, '>>> ', '... ', 0, 0, False)
    # the run is split where the line wraps
    assert_equal(spelled(f), '\\r\\e[J\\e[32m>>> \\e[0mx \\e[31mi\\e[0m\\r\\n\\e[31mf\\e[0m y\\e[1A\\e[5G')

# ---- whole sessions on a FakeTerminal --------------------------------------------------------------------------------------

@test.session_type_and_submit
def session_type_and_submit():
    result, term = session(Editor(), chars('1 + 2') + [enter()])
    assert_equal(result.status, 'text')
    assert_equal(result.text, '1 + 2')
    assert_false(term.raw)
    assert_equal(term.raw_calls, 1)
    assert_equal(term.leave_calls, 1)
    out = spelled(term.output())
    assert_true(out.startswith('\\e[?2004h\\r\\e[J>>> \\e[5G'), out)
    assert_true(out.endswith('\\r\\e[J>>> 1 + 2\\e[10G\\r\\n\\e[?2004l'), out)

@test.session_block_with_auto_indent
def session_block_with_auto_indent():
    keys = chars('for i in range(3):') + [enter()] + chars('print(i)') + [enter(), enter()]
    result, term = session(block_editor([]), keys)
    assert_equal(result.status, 'text')
    assert_equal(result.text, 'for i in range(3):\n    print(i)')      # the empty indented last line is not part of it
    out = spelled(term.output())
    assert_true('>>> for i in range(3):\\r\\n...     print(i)\\r\\n...     \\e[9G\\r\\n' in out, out)

@test.session_recall_and_edit_the_middle_line
def session_recall_and_edit_the_middle_line():
    block = 'for i in range(2):\n    x = i\n    print(x)'
    # Up recalls the block with the cursor at its end; Up again goes to its middle line; End, then change it
    keys = [up(), up(), named('end'), named('backspace')] + chars('i * 10') + [down(), named('end'), enter(), enter()]
    result, _term = session(block_editor(['older', block]), keys)
    assert_equal(result.status, 'text')
    assert_equal(result.text, 'for i in range(2):\n    x = i * 10\n    print(x)')

@test.session_up_through_a_block_into_the_entry_before
def session_up_through_a_block_into_the_entry_before():
    block = 'if a:\n    b'
    keys = [up(), up(), up()] + [enter()]
    result, _term = session(block_editor(['first = 1', block]), keys)
    assert_equal(result.text, 'first = 1')
    # Down from the first line of an older entry walks into the newer one; past the newest, the draft comes back
    keys2 = chars('draft') + [up(), up(), up(), down(), down(), down(), enter()]
    result2, _t2 = session(block_editor(['first = 1', block]), keys2)
    assert_equal(result2.text, 'draft')

@test.session_edits_to_a_recalled_entry_are_dropped
def session_edits_to_a_recalled_entry_are_dropped():
    keys = [up()] + chars(' changed') + [up(), down(), enter()]
    result, _term = session(Editor(), keys)
    assert_equal(result.text, ' changed')                       # no history: Up does nothing
    ed = Editor()
    ed.history = History(['one', 'two'], 1000)
    result, _term = session(ed, [up()] + chars('!') + [up(), down(), enter()])
    assert_equal(result.text, 'two')

@test.session_add_and_delete_lines
def session_add_and_delete_lines():
    keys = [up()] + [enter()]          # Enter on the last line of an open block: a new line with its indent
    keys = keys + chars('y = 2') + [named('home'), named('backspace')]
    keys = keys + [ctrl('e'), enter(), enter()]
    result, _term = session(block_editor(['if a:\n    x = 1']), keys)
    # Home goes to column 0 of '    y = 2', Backspace joins it to the line above (no indent there to go back over)
    assert_equal(result.text, 'if a:\n    x = 1    y = 2')
    # Delete at a line's end joins the next line to it
    keys = [up(), up(), up(), ctrl('e'), named('delete'), ctrl('n'), ctrl('e'), enter(), enter()]
    result, _term = session(block_editor(['if a:\n    x = 1\n    y = 2']), keys)
    assert_equal(result.text, 'if a:    x = 1\n    y = 2')

@test.session_enter_inside_a_block_splits_the_line
def session_enter_inside_a_block_splits_the_line():
    keys = [up(), up(), ctrl('e'), enter()] + chars('z = 0') + [ctrl('n'), ctrl('e'), enter(), enter()]
    result, _term = session(block_editor(['if a:\n    x = 1']), keys)
    assert_equal(result.text, 'if a:\n    z = 0\n    x = 1')

@test.session_ctrl_c_and_ctrl_d
def session_ctrl_c_and_ctrl_d():
    result, term = session(Editor(), chars('half') + [ctrl('c')])
    assert_equal(result.status, 'interrupt')
    assert_true(spelled(term.output()).endswith('>>> half\\e[9G\\r\\nKeyboardInterrupt\\r\\n\\e[?2004l'), spelled(term.output()))
    result, term = session(Editor(), [ctrl('d')])
    assert_equal(result.status, 'eof')
    assert_false(term.raw)
    # Ctrl-D on text deletes the character at the cursor
    result, term = session(Editor(), chars('abc') + [ctrl('a'), ctrl('d'), enter()])
    assert_equal(result.text, 'bc')
    # the input ending (the terminal went away) is 'eof' too
    result, term = session(Editor(), chars('abc'))
    assert_equal(result.status, 'eof')

@test.session_paste
def session_paste():
    paste = Key('paste', 'def f():\n\treturn 1\n' + chr(7))
    result, _term = session(block_editor([]), [paste, enter()])
    # inserted as it is (a tab becomes four spaces, control characters go), not submitted and not indented by the paste itself
    assert_equal(result.text, 'def f():\n    return 1')
    result, _term = session(Editor(), [Key('paste', 'a\nb'), enter()])
    assert_equal(result.text, 'a\nb')

@test.session_kills_and_yank
def session_kills_and_yank():
    keys = chars('one two') + [ctrl('w'), ctrl('a')] + [ctrl('y')] + [ctrl('k'), ctrl('y'), ctrl('y'), enter()]
    result, _term = session(Editor(), keys)
    # Ctrl-W cuts 'two', Ctrl-Y at the start puts it back; Ctrl-K then cuts 'one ', and two Ctrl-Y put it back twice
    assert_equal(result.text, 'twoone one ')

@test.session_tabs_and_shift_tab
def session_tabs_and_shift_tab():
    keys = [named('tab'), named('tab')] + chars('x') + [Key('key', '', 'backtab', False, False, True), enter()]
    result, _term = session(Editor(), keys)
    assert_equal(result.text, '    x')
    keys = [named('tab'), named('tab'), named('backspace')] + chars('y') + [enter()]
    result, _term = session(Editor(), keys)
    assert_equal(result.text, '    y')

@test.session_resize_redraws_at_the_new_width
def session_resize_redraws_at_the_new_width():
    ed = Editor()
    term = FakeTerminal()
    term.keys = chars('abcdefghij') + [Key('resize'), ch('k'), enter()]
    term.sizes = [(24, 10)]
    result = ed.read(term)
    assert_equal(result.text, 'abcdefghijk')
    # after the resize, the cursor (after 'j', at cell 14) is on the second row of a 10-cell terminal: the frame goes up one row first
    frames: list[str] = []
    for w in term.writes:
        frames.append(spelled(w))
    assert_equal(frames[len(frames) - 5], '\\e[1A\\r\\e[J>>> abcdef\\r\\nghij\\e[5G')
    assert_equal(frames[len(frames) - 4], '\\e[1A\\r\\e[J>>> abcdef\\r\\nghijk\\e[6G')

@test.session_ctrl_l_and_ignored_keys
def session_ctrl_l_and_ignored_keys():
    keys = chars('a') + [ctrl('l'), ctrl('z'), named('f5'), named('escape'), Key('timeout'), Key('char', 'x', '', False, True), ch('b'), enter()]
    result, term = session(Editor(), keys)
    assert_equal(result.text, 'ab')
    assert_true('\\e[2J\\e[H\\r\\e[J>>> a\\e[6G' in spelled(term.output()))

@test.session_alt_and_ctrl_word_moves
def session_alt_and_ctrl_word_moves():
    keys = chars('one two') + [Key('char', 'b', '', False, True), ch('X'), Key('key', '', 'right', True), ch('Y'), Key('key', '', 'left', True), Key('char', 'f', '', False, True), ch('Z'), enter()]
    result, _term = session(Editor(), keys)
    assert_equal(result.text, 'one XtwoYZ')

@test.session_wide_text
def session_wide_text():
    result, term = session(Editor(), chars('中文 é') + [named('left'), named('backspace'), enter()])
    assert_equal(result.text, '中文é')
    assert_true(spelled(term.output()).endswith('>>> 中文é\\e[10G\\r\\n\\e[?2004l'), spelled(term.output()))

# ---- the kill ring ---------------------------------------------------------------------------------------------------------

@test.kill_ring_keeps_the_newest_and_joins
def kill_ring_keeps_the_newest_and_joins():
    r = KillRing()
    r.size = 3
    r.add('one', False, False)
    r.add('two', False, False)
    assert_equal(r.top(), 'two')
    r.add('three', False, True)                 # joined into the newest cut, after it
    assert_equal(r.top(), 'twothree')
    r.add('x ', True, True)                     # a backward cut goes before it
    assert_equal(r.top(), 'x twothree')
    r.add('', False, False)                     # nothing cut changes nothing
    assert_equal(len(r.entries), 2)
    r.add('four', False, False)
    r.add('five', False, False)
    assert_equal(len(r.entries), 3)             # the oldest is gone
    assert_equal(r.entries[0], 'x twothree')
    assert_equal(r.rotate(), 'four')
    assert_equal(r.rotate(), 'x twothree')
    assert_equal(r.rotate(), 'five')            # round again
    r.size = 1
    r.add('six', False, False)
    assert_equal(len(r.entries), 1)
    assert_equal(r.top(), 'six')

# ---- completion: the pieces ------------------------------------------------------------------------------------------------

@test.common_prefix_of_words
def common_prefix_of_words():
    assert_equal(lineedit.common_prefix([]), '')
    assert_equal(lineedit.common_prefix(['print']), 'print')
    assert_equal(lineedit.common_prefix(['print', 'printf', 'prompt']), 'pr')
    assert_equal(lineedit.common_prefix(['abc', 'xyz']), '')
    assert_equal(lineedit.common_prefix(['ab', 'abc', 'ab']), 'ab')
    assert_equal(lineedit.common_prefix(['é1', 'é2']), 'é')

@test.candidate_rows_in_columns
def candidate_rows_in_columns():
    # down the first column, then the next, as ls does; two spaces between the columns
    rows = lineedit.candidate_rows(['apple', 'apricot', 'banana', 'cherry'], 30, 8)
    assert_equal(rows, ['apple    banana', 'apricot  cherry'])
    assert_equal(lineedit.candidate_rows(['a', 'b'], 80, 8), ['a  b'])
    # a width that holds one column
    assert_equal(lineedit.candidate_rows(['alpha', 'beta'], 8, 8), ['alpha', 'beta'])
    # a row is at most width - 1 cells: a long candidate is cut
    assert_equal(lineedit.candidate_rows(['abcdefghijkl'], 6, 8), ['abcde'])
    # wide characters count two cells
    assert_equal(lineedit.candidate_rows(['中文', 'ab'], 80, 8), ['中文  ab'])

@test.candidate_rows_that_do_not_fit_say_how_many_are_left
def candidate_rows_that_do_not_fit_say_how_many_are_left():
    names: list[str] = []
    for i in range(10):
        names.append(f'a{i}')
    assert_equal(lineedit.candidate_rows(names, 11, 3), ['a0  a2', 'a1  a3', '... 6 more'])
    assert_equal(lineedit.candidate_rows(names, 11, 1), ['... 10 more'])
    assert_equal(len(lineedit.candidate_rows(names, 11, 5)), 5)

@test.frame_lists_candidates_under_the_text
def frame_lists_candidates_under_the_text():
    s = lineedit.Screen()
    s.menu = ['print', 'printf']
    f = s.frame(['pri'], [], '>>> ', '... ', 0, 3, False)
    assert_equal(spelled(f), '\\r\\e[J>>> pri\\r\\nprint   printf\\e[1A\\e[8G')
    assert_equal(s.cursor_row, 0)
    # the next frame starts at the top of the text, and clears the list with the rest
    s.menu = []
    f = s.frame(['pri'], [], '>>> ', '... ', 0, 3, False)
    assert_equal(spelled(f), '\\r\\e[J>>> pri\\e[8G')
    # the last frame (the text submitted) has no list, whatever was left in menu
    s.menu = ['print', 'printf']
    f = s.frame(['pri'], [], '>>> ', '... ', 0, 3, True)
    assert_equal(spelled(f), '\\r\\e[J>>> pri\\e[8G')

@test.frame_list_of_candidates_keeps_to_the_window
def frame_list_of_candidates_keeps_to_the_window():
    s = lineedit.Screen()
    s.height = 4
    s.menu = ['a', 'b', 'c', 'd', 'e', 'f', 'g', 'h', 'i', 'j']
    s.width = 8                                 # two columns: five rows of candidates
    f = s.frame(['x', 'y'], [], '>>> ', '... ', 1, 1, False)
    # two rows of text leave two rows of the window for the list: one of candidates and the count of the others
    assert_equal(spelled(f), '\\r\\e[J>>> x\\r\\n... y\\r\\na  b\\r\\n... 8 more\\e[2A\\e[6G')
    s.height = 2
    f = s.frame(['x', 'y'], [], '>>> ', '... ', 1, 1, False)
    assert_equal(spelled(f), '\\e[1A\\r\\e[J>>> x\\r\\n... y\\e[6G')

# ---- completion: whole sessions --------------------------------------------------------------------------------------------

# completes the word (letters, digits and underscores) before the cursor from a list of words
class Words implements Completer:
    words: list[str] = []

    @init
    def make(self, words: list[str]):
        self.words = words

    def complete(self, line: str, before: str) -> Completion:
        start = len(line)
        while start > 0 and (line[start - 1].isalnum() or line[start - 1] == '_'):
            start -= 1
        typed = line[start:]
        found: list[str] = []
        for w in self.words:
            if typed != '' and w.startswith(typed):
                found.append(w)
        return Completion(start, found)

# always answers the same
class Fixed implements Completer:
    start: int = 0
    words: list[str] = []
    after: str = ''

    @init
    def make(self, start: int, words: list[str], after: str = ''):
        self.start = start
        self.words = words
        self.after = after

    def complete(self, line: str, before: str) -> Completion:
        return Completion(self.start, self.words, self.after)

def with_completer(c: Completer) -> Editor:
    ed = Editor()
    ed.completer = c
    return ed

def completing(words: list[str]) -> Editor:
    ed = Editor()
    ed.completer = Words(words)
    return ed

@test.session_tab_puts_in_the_only_candidate
def session_tab_puts_in_the_only_candidate():
    result, _term = session(completing(['print', 'len', 'range']), chars('x = le') + [named('tab'), chars(')')[0], enter()])
    assert_equal(result.text, 'x = len)')
    # the word is replaced from where it starts, with the whole candidate (which need not start like the word)
    result, _term = session(with_completer(Fixed(4, ['Print'])), chars('1 + pr') + [named('tab'), enter()])
    assert_equal(result.text, '1 + Print')

@test.session_tab_adds_the_text_after_the_only_candidate
def session_tab_adds_the_text_after_the_only_candidate():
    result, _term = session(with_completer(Fixed(0, ['add'], ' ')), chars('a') + [named('tab')] + chars('milk') + [enter()])
    assert_equal(result.text, 'add milk')
    # only for a single candidate: with several the common start is put in, and nothing after it
    result, _term = session(with_completer(Fixed(0, ['add', 'adjust'], ' ')), chars('a') + [named('tab'), enter()])
    assert_equal(result.text, 'ad')

@test.session_tab_gives_the_common_start_and_then_the_list
def session_tab_gives_the_common_start_and_then_the_list():
    ed = completing(['print', 'printf', 'prompt', 'len'])
    term = FakeTerminal()
    term.keys = chars('p') + [named('tab'), named('tab'), ch('i'), named('tab'), named('tab'), enter()]
    result = ed.read(term)
    assert_equal(result.text, 'print')
    frames: list[str] = []
    for w in term.writes:
        frames.append(spelled(w))
    assert_equal(frames[1], '\\r\\e[J>>> \\e[5G')
    assert_equal(frames[3], '\\r\\e[J>>> pr\\e[7G')                                   # the common start of three
    assert_equal(frames[4], '\\r\\e[J>>> pr\\r\\nprint   printf  prompt\\e[1A\\e[7G')   # nothing to add: the list
    assert_equal(frames[5], '\\r\\e[J>>> pri\\e[8G')                             # the next key takes the list away
    assert_equal(frames[6], '\\r\\e[J>>> print\\e[10G')                          # print and printf: the common start is print
    assert_equal(frames[7], '\\r\\e[J>>> print\\r\\nprint   printf\\e[1A\\e[10G')
    assert_equal(frames[8], '\\r\\e[J>>> print\\e[10G')                          # the last frame: no list, the text stays

@test.session_the_list_goes_away_with_an_ignored_key_too
def session_the_list_goes_away_with_an_ignored_key_too():
    term = FakeTerminal()
    term.keys = chars('p') + [named('tab'), named('tab'), named('f5'), enter()]
    ed = completing(['pa', 'pb'])
    result = ed.read(term)
    assert_equal(result.text, 'p')
    out = spelled(term.output())
    assert_true('p\\r\\npa  pb\\e[1A' in out)
    assert_true(out.endswith('>>> p\\e[6G\\r\\n\\e[?2004l'), out)

@test.session_tab_with_no_candidates
def session_tab_with_no_candidates():
    # in an indent Tab puts in the tab text, as before; after text it does nothing
    result, _term = session(completing(['print']), [named('tab')] + chars('zz') + [named('tab'), enter()])
    assert_equal(result.text, '    zz')
    result, _term = session(Editor(), chars('ab') + [named('tab'), enter()])
    assert_equal(result.text, 'ab')
    # the candidates of an empty line are used before the indent
    result, _term = session(with_completer(Fixed(0, ['only'])), [named('tab'), enter()])
    assert_equal(result.text, 'only')

@test.session_tab_in_the_middle_of_a_line_and_a_block
def session_tab_in_the_middle_of_a_line_and_a_block():
    ed = completing(['value'])
    result, _term = session(ed, chars('x = va + 1') + [named('left')] * 4 + [named('tab'), enter()])
    assert_equal(result.text, 'x = value + 1')
    # the completer sees the line up to the cursor and all the text before it
    seen = Spy()
    ed = Editor()
    ed.validator = BlockRule()
    ed.indenter = ColonIndent()
    ed.completer = seen
    session(ed, chars('if x:') + [enter()] + chars('  ab') + [named('tab'), enter(), enter()])
    assert_equal(seen.lines, ['      ab'])
    assert_equal(seen.befores, ['if x:\n      ab'])

class Spy implements Completer:
    lines: list[str] = []
    befores: list[str] = []

    def complete(self, line: str, before: str) -> Completion:
        self.lines.append(line)
        self.befores.append(before)
        return Completion(0, [])

# ---- single-line mode ------------------------------------------------------------------------------------------------------

@test.single_line_enter_always_submits
def single_line_enter_always_submits():
    ed = Editor()
    ed.single_line = True
    ed.validator = BlockRule()                       # not asked
    result, _term = session(ed, chars('if x:') + [enter()])
    assert_equal(result.text, 'if x:')
    result, _term = session(ed, [enter()])
    assert_equal(result.text, '')

@test.single_line_paste_and_history_stay_on_one_line
def single_line_paste_and_history_stay_on_one_line():
    ed = Editor()
    ed.single_line = True
    ed.history = History(['first', 'for x:\n    y'], 1000)
    result, _term = session(ed, chars('a') + [Key('paste', 'b\r\nc\nd'), enter()])
    assert_equal(result.text, 'ab c d')
    # a recalled entry that has several lines comes back as one
    result, _term = session(ed, [up(), enter()])
    assert_equal(result.text, 'for x:     y')
    result, term = session(ed, [up(), up(), ch('!'), enter()])
    assert_equal(result.text, 'first!')
    assert_true('\\r\\n... ' not in spelled(term.output()))
    result, _term = session(ed, chars('d') + [up(), down(), enter()])
    assert_equal(result.text, 'd')

@test.single_line_tab_does_not_indent
def single_line_tab_does_not_indent():
    ed = Editor()
    ed.single_line = True
    result, _term = session(ed, [named('tab')] + chars('x') + [named('tab'), enter()])
    assert_equal(result.text, 'x')
    ed.completer = Words(['value'])
    result, _term = session(ed, chars('va') + [named('tab'), enter()])
    assert_equal(result.text, 'value')

# ---- the kill ring ---------------------------------------------------------------------------------------------------------

@test.session_kill_ring_of_one_is_the_last_cut
def session_kill_ring_of_one_is_the_last_cut():
    ed = Editor()
    result, _term = session(ed, chars('one two three') + [ctrl('w'), ctrl('w'), ctrl('y'), enter()])
    assert_equal(result.text, 'one two ')
    # Alt-Y does nothing without a ring
    result, _term = session(ed, chars('a b') + [ctrl('w'), ctrl('w'), ctrl('y'), Key('char', 'y', '', False, True), enter()])
    assert_equal(result.text, 'a ')

@test.session_kill_ring_joins_cuts_in_a_row_and_alt_y_cycles
def session_kill_ring_joins_cuts_in_a_row_and_alt_y_cycles():
    ed = Editor()
    ed.kill_ring = 3
    # two Ctrl-W in a row are one cut (the second goes in front of the first)
    result, _term = session(ed, chars('one two three') + [ctrl('w'), ctrl('w'), ctrl('y'), enter()])
    assert_equal(result.text, 'one two three')
    # a key between them starts a new cut; Ctrl-Y puts back the newest, Alt-Y steps back through the ring
    ed = Editor()
    ed.kill_ring = 3
    alt_y = Key('char', 'y', '', False, True)
    keys = chars('aa bb cc') + [ctrl('w'), ch('X'), ctrl('w'), ctrl('w'), ctrl('y'), alt_y, enter()]
    result, _term = session(ed, keys)
    # the ring is ['cc', 'bb X'] (the cut of 'X' and the one of 'bb ' joined), the line 'aa ': Ctrl-Y puts back 'bb X', Alt-Y swaps in 'cc'
    assert_equal(result.text, 'aa cc')

@test.session_alt_y_needs_a_yank_just_before_and_survives_reads
def session_alt_y_needs_a_yank_just_before_and_survives_reads():
    ed = Editor()
    ed.kill_ring = 2
    alt_y = Key('char', 'y', '', False, True)
    result, _term = session(ed, chars('one') + [ctrl('u')] + chars('two') + [ctrl('u'), alt_y, enter()])
    assert_equal(result.text, '')                   # Alt-Y without Ctrl-Y first: nothing
    # the ring belongs to the Editor, so the next read can bring the cuts back: 'two', then 'one', 'two', 'one' round the ring
    result, _term = session(ed, [ctrl('y'), alt_y, alt_y, alt_y, enter()])
    assert_equal(result.text, 'one')
    result, _term = session(ed, [ctrl('y'), alt_y, enter()])
    assert_equal(result.text, 'two')
