# A small progress bar, written in Tomato: `from tqdm import tqdm`.
# There is no clock in the language yet, so the bar shows a count and a percentage but no speed or time left.
#
#     bar = tqdm(200, 'copying')
#     for i in range(200):
#         bar.update()
#     bar.close()
#
# update() redraws the bar on standard error (so it does not mix with what the program prints); render() returns the
# same line as text, which is what the tests check. A total of 0 means unknown: the bar shows only the count.

export class tqdm:
    total: int = 0
    count: int = 0
    label: str = ''
    width: int = 30

    @init
    def make(self, total: int, label: str = '', width: int = 30):
        if total < 0:
            raise RuntimeError('a progress bar total cannot be negative')
        if width < 1:
            raise RuntimeError('a progress bar width must be at least 1')
        self.total = total
        self.label = label
        self.width = width

    def render(self) -> str:
        prefix = ''
        if len(self.label) > 0:
            prefix = self.label + ': '
        if self.total == 0:
            return prefix + str(self.count) + 'it'
        shown = self.count
        if shown > self.total:
            shown = self.total
        filled = shown * self.width // self.total
        pct = shown * 100 // self.total
        line = prefix
        if pct < 100:
            line = line + ' '
        if pct < 10:
            line = line + ' '
        line = line + str(pct) + '%|'
        for i in range(self.width):
            if i < filled:
                line = line + '#'
            else:
                line = line + '-'
        return line + '| ' + str(self.count) + '/' + str(self.total)

    def show(self, end: str):
        f = open('/dev/stderr', 'w')
        f.write('\r' + self.render() + end)
        f.close()

    def update(self, n: int = 1):
        self.count = self.count + n
        self.show('')

    def close(self):
        self.show('\n')
