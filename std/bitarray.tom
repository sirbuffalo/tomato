# Packed bit sequences, written in Tomato. `bitarray` and `frozenbitarray` need no import: any file that uses either name gets
# this module (`from bitarray import bitarray, frozenbitarray` also works).
#
#     a = bitarray('1011')              # from text of 0 and 1 (also bitarray([True, False]) from a list of bool)
#     b = bitarray(8)                   # from a whole number, in binary: 1000
#     c = bitarray(8, 8)                # the same with a width: 00001000 (an error if the number needs more bits)
#     z = bitarray.zeros(5)             # five 0 bits
#     h = bitarray.from_hex('A2')       # 10100010, four bits per hex digit
#
# Bit 0 is the leftmost bit, the one written first in the text: bitarray('100')[0] is True. A bitarray is mutable:
# a[i] = True, a.append(bit), a.extend(other). len(a) counts bits. Indexing counts from the end when negative, slices
# follow the rules of lists (a[1:3], a[::-1]), `for bit in a` yields bool, `True in a` asks whether a bit is set, == compares
# the bits, and a & b, a | b, a ^ b and ~a work on whole arrays (a & b, a | b and a ^ b need equal lengths). The text of
# an array is its bits: str(a) is '1011'.
#
# A class can say how to become a bitarray: a method marked @bitarray, taking nothing and returning a bitarray, makes its
# objects usable wherever a bitarray is wanted (bitarray(obj), a & obj, a function parameter typed bitarray).
#
# Conversions: to_ints() packs the bits eight to a byte as a list of whole numbers from 0 to 255, first bit in the top
# of the first byte, the last byte padded with 0 bits (bitarray.from_ints(xs) reads them back, from_ints(xs, nbits) keeps
# only the first nbits); to_hex() and from_hex() do the same with four bits to a digit; to_int() reads the bits as a
# binary number; to_list() gives a list[bool].
#
# frozenbitarray is the same value that cannot change, so it can be passed around and compared without copies: it has
# every method above that does not change the array, plus hash(), key() (the text, a dict key) and thaw() (a bitarray
# copy). a.freeze() makes one from a bitarray, and frozenbitarray(a) does too. The two types do not mix in operators.
#
# Storage: 32 bits to a whole-number chunk in a list (a chunk is always a small, unboxed number), counted with the C
# runtime's popcount; whole-array operations work a chunk at a time, with the shifts and masks of `<<`, `>>`, `&` and `~`.

!tomato_popcount(x: int) -> int

const _FULL = 4294967295

# the chunk with only bit `r` set, counting from the left (bit 0 is the top of the 32)
def _mask(r: int) -> int:
    return 1 << (31 - r)

# the chunk with only the first `r` bits (counting from the left) kept
def _head(r: int) -> int:
    return (_FULL >> (32 - r)) << (32 - r)

# the chunk number q of a list of chunks, or 0 when there is no such chunk
def _chunk(words: list[int], q: int) -> int:
    if q < 0 or q >= len(words):
        return 0
    return words[q]

# the 32 bits that start at bit p of the chunks (bits past either end read as 0)
def _bits32(words: list[int], p: int) -> int:
    q = p >> 5
    s = p & 31
    w0 = _chunk(words, q)
    if s == 0:
        return w0
    return (((w0 & (_FULL >> s)) << s) | (_chunk(words, q + 1) >> (32 - s)))

def _fail_range():
    raise IndexError('the bit index is out of range', 'E28')

def _hex_digit(c: str) -> int:
    o = ord(c)
    if o >= 48 and o <= 57:
        return o - 48
    if o >= 97 and o <= 102:
        return o - 87
    if o >= 65 and o <= 70:
        return o - 55
    raise ValueError('a hex text holds only the digits 0 to 9 and a to f', 'E29')

export class bitarray:
    words: list[int] = []
    n: int = 0

    @init
    def make(self, value: int | str | list[bool] | bitarray = 0, width: int = 0):
        if value in bitarray:
            for w in value.words:
                self.words.append(w)
            self.n = value.n
        elif value in int:
            if value < 0:
                raise ValueError('a bitarray cannot be made from a negative number', 'E30')
            # the digits: whole chunks of 32 bits, then the bits of the top chunk
            top = value
            chunks = 0
            while top >= 4294967296:
                top = top >> 32
                chunks += 1
            digits = chunks * 32 + 1
            top = top >> 1
            while top > 0:
                digits += 1
                top = top >> 1
            if width > 0:
                if digits > width:
                    raise OverflowError('the number does not fit the width of the bitarray', 'E31')
                digits = width
            # the number moved up so that its last digit ends a chunk, then cut into chunks from the low end
            count = (digits + 31) >> 5
            self.words = [0] * count
            self.n = digits
            rest = value << (count * 32 - digits)
            for j in range(count):
                self.words[count - 1 - j] = rest % 4294967296
                rest = rest >> 32
        elif value in str:
            for ch in value:
                if ch == '0':
                    self.append(False)
                elif ch == '1':
                    self.append(True)
                else:
                    raise ValueError('a bitarray text holds only 0 and 1', 'E32')
        else:
            for bit in value:
                self.append(bit)

    @static
    def zeros(self, count: int) -> bitarray:
        if count < 0:
            raise ValueError('a bitarray cannot have a negative length', 'E33')
        a = bitarray('')
        a.words = [0] * ((count + 31) >> 5)
        a.n = count
        return a

    @static
    def from_hex(self, text: str) -> bitarray:
        a = bitarray('')
        a.words = [0] * ((len(text) * 4 + 31) >> 5)
        a.n = len(text) * 4
        i = 0
        for ch in text:
            d = _hex_digit(ch)
            a.words[i >> 5] = a.words[i >> 5] | (d << (28 - (i & 31)))
            i += 4
        return a

    @static
    def from_ints(self, items: list[int], nbits: int = -1) -> bitarray:
        total = len(items) * 8
        if nbits < 0:
            nbits = total
        if nbits > total:
            raise ValueError('there are fewer bits in the list than asked for', 'E34')
        a = bitarray('')
        a.words = [0] * ((nbits + 31) >> 5)
        a.n = nbits
        for k in range(len(items)):
            b = items[k]
            if b < 0 or b > 255:
                raise ValueError('a packed byte must be from 0 to 255', 'E35')
            if k * 8 < nbits:
                a.words[k >> 2] = a.words[k >> 2] | (b << (24 - (k & 3) * 8))
        a.clean()
        return a

    # clears the unused bits of the last chunk, which every whole-array operation relies on being 0
    def clean(self):
        if self.n & 31 != 0:
            last = len(self.words) - 1
            self.words[last] = self.words[last] & _head(self.n & 31)

    def at_index(self, i: int) -> int:
        if i < 0:
            i += self.n
        if i < 0 or i >= self.n:
            _fail_range()
        return i

    @len
    def size(self) -> int:
        return self.n

    @get
    def at(self, i: int) -> bool:
        k = self.at_index(i)
        return self.words[k >> 5] & _mask(k & 31) != 0

    @set
    def put(self, i: int, bit: bool):
        k = self.at_index(i)
        w = k >> 5
        m = _mask(k & 31)
        if bit:
            self.words[w] = self.words[w] | m
        else:
            self.words[w] = self.words[w] & ~m

    def append(self, bit: bool):
        if self.n & 31 == 0:
            self.words.append(0)
        self.n += 1
        if bit:
            w = (self.n - 1) >> 5
            self.words[w] = self.words[w] | _mask((self.n - 1) & 31)

    def extend(self, other: bitarray):
        # a.extend(a) must see the length and chunks as they were before the first bit is added
        count = other.n
        if self.n & 31 == 0:
            for k in range(len(other.words)):
                self.words.append(other.words[k])
            self.n += count
        else:
            # the chunks of other are cut in two: the top part ends the last chunk of self, the rest starts a new one
            src: list[int] = []
            for w in other.words:
                src.append(w)
            s = self.n & 31
            total = self.n + count
            last = len(self.words) - 1
            for k in range(len(src)):
                self.words[last] = self.words[last] | (src[k] >> s)
                if len(self.words) * 32 < total:
                    self.words.append(((src[k] & (_FULL >> (32 - s))) << (32 - s)))
                    last += 1
            self.n = total

    @iter
    def each(self) -> bool:
        for i in range(self.n):
            yield self.words[i >> 5] & _mask(i & 31) != 0

    @contains
    def has(self, bit: bool) -> bool:
        return self.find(bit) >= 0

    @slice
    def part(self, lo: int, hi: int, st: int, flags: int) -> bitarray:
        step = 1
        if flags & 4 != 0:
            step = st
        if step == 0:
            raise ValueError('a slice step cannot be 0', 'E27')
        n = self.n
        if step > 0:
            a = 0
            b = n
            if flags & 1 != 0:
                a = lo
                if a < 0:
                    a = max(a + n, 0)
                a = min(a, n)
            if flags & 2 != 0:
                b = hi
                if b < 0:
                    b = max(b + n, 0)
                b = min(b, n)
        else:
            a = n - 1
            b = -1
            if flags & 1 != 0:
                a = lo
                if a < 0:
                    a = max(a + n, -1)
                a = min(a, n - 1)
            if flags & 2 != 0:
                b = hi
                if b < 0:
                    b = max(b + n, -1)
                b = min(b, n - 1)
        r = bitarray('')
        r.words = []
        r.n = 0
        if step == 1 and b > a:
            # a plain run of bits is copied a chunk at a time
            r.n = b - a
            for k in range((r.n + 31) >> 5):
                r.words.append(_bits32(self.words, a + k * 32))
            r.clean()
            return r
        i = a
        if step > 0:
            while i < b:
                r.append(self.words[i >> 5] & _mask(i & 31) != 0)
                i += step
        else:
            while i > b:
                r.append(self.words[i >> 5] & _mask(i & 31) != 0)
                i += step
        return r

    @eq
    def same(self, other: bitarray) -> bool:
        if self.n != other.n:
            return False
        for k in range(len(self.words)):
            if self.words[k] != other.words[k]:
                return False
        return True

    def need_same_length(self, other: bitarray):
        if self.n != other.n:
            raise ValueError('the two bitarrays must have the same length', 'E36')

    @bitand
    def both(self, other: bitarray) -> bitarray:
        self.need_same_length(other)
        r = bitarray('')
        r.n = self.n
        for k in range(len(self.words)):
            r.words.append(self.words[k] & other.words[k])
        return r

    @bitor
    def either(self, other: bitarray) -> bitarray:
        self.need_same_length(other)
        r = bitarray('')
        r.n = self.n
        for k in range(len(self.words)):
            r.words.append(self.words[k] | other.words[k])
        return r

    @bitxor
    def differ(self, other: bitarray) -> bitarray:
        self.need_same_length(other)
        r = bitarray('')
        r.n = self.n
        for k in range(len(self.words)):
            r.words.append(self.words[k] ^ other.words[k])
        return r

    @invert
    def flipped(self) -> bitarray:
        r = bitarray('')
        r.n = self.n
        for k in range(len(self.words)):
            r.words.append(self.words[k] ^ _FULL)
        r.clean()
        return r

    # the same bits moved `count` places towards the end (shift_right) or the start (shift_left), the length unchanged and
    # the places left open filled with 0
    def shift_left(self, count: int) -> bitarray:
        if count < 0:
            return self.shift_right(-count)
        if count >= self.n:
            return bitarray.zeros(self.n)
        r = bitarray.zeros(self.n)
        for k in range(len(r.words)):
            r.words[k] = _bits32(self.words, k * 32 + count)
        r.clean()
        return r

    def shift_right(self, count: int) -> bitarray:
        if count < 0:
            return self.shift_left(-count)
        if count >= self.n:
            return bitarray.zeros(self.n)
        r = bitarray.zeros(self.n)
        for k in range(len(r.words)):
            r.words[k] = _bits32(self.words, k * 32 - count)
        r.clean()
        return r

    def count(self) -> int:
        total = 0
        for w in self.words:
            total += !tomato_popcount(w)
        return total

    def any(self) -> bool:
        for w in self.words:
            if w != 0:
                return True
        return False

    def all(self) -> bool:
        return self.count() == self.n

    # the index of the first bit equal to `bit` at or after `start`, or -1
    def find(self, bit: bool, start: int = 0) -> int:
        i = start
        if i < 0:
            i = max(i + self.n, 0)
        while i < self.n:
            w = self.words[i >> 5]
            if i & 31 == 0:
                if bit and w == 0:
                    i += 32
                    continue
                if not bit and w == _FULL:
                    i += 32
                    continue
            if (w & _mask(i & 31) != 0) == bit:
                return i
            i += 1
        return -1

    def copy(self) -> bitarray:
        r = bitarray('')
        r.n = self.n
        for w in self.words:
            r.words.append(w)
        return r

    def freeze(self) -> frozenbitarray:
        return frozenbitarray(self)

    def to_list(self) -> list[bool]:
        out: list[bool] = []
        for i in range(self.n):
            out.append(self.words[i >> 5] & _mask(i & 31) != 0)
        return out

    def to_ints(self) -> list[int]:
        out: list[int] = []
        nbytes = (self.n + 7) // 8
        for k in range(nbytes):
            out.append((self.words[k >> 2] >> (24 - (k & 3) * 8)) & 255)
        return out

    def to_hex(self) -> str:
        digits = '0123456789abcdef'
        out: list[str] = []
        i = 0
        while i < self.n:
            out.append(digits[(self.words[i >> 5] >> (28 - (i & 31))) & 15])
            i += 4
        return ''.join(out)

    def to_int(self) -> int:
        v = 0
        for k in range(len(self.words)):
            v = (v << 32) + self.words[k]
        return v >> (len(self.words) * 32 - self.n)

    @str
    def text(self) -> str:
        parts: list[str] = []
        for i in range(self.n):
            if self.words[i >> 5] & _mask(i & 31) != 0:
                parts.append('1')
            else:
                parts.append('0')
        return ''.join(parts)

export class frozenbitarray:
    private bits: bitarray = bitarray('')

    @init
    def make(self, value: int | str | list[bool] | bitarray = 0, width: int = 0):
        if value in bitarray:
            self.bits = value.copy()
        elif value in int:
            self.bits = bitarray(value, width)
        elif value in str:
            self.bits = bitarray(value)
        else:
            self.bits = bitarray(value)

    @static
    def zeros(self, count: int) -> frozenbitarray:
        return frozenbitarray(bitarray.zeros(count))

    @static
    def from_hex(self, text: str) -> frozenbitarray:
        return frozenbitarray(bitarray.from_hex(text))

    @static
    def from_ints(self, items: list[int], nbits: int = -1) -> frozenbitarray:
        return frozenbitarray(bitarray.from_ints(items, nbits))

    @len
    def size(self) -> int:
        return self.bits.n

    @get
    def at(self, i: int) -> bool:
        return self.bits[i]

    @iter
    def each(self) -> bool:
        for bit in self.bits:
            yield bit

    @contains
    def has(self, bit: bool) -> bool:
        return self.bits.find(bit) >= 0

    @slice
    def part(self, lo: int, hi: int, st: int, flags: int) -> frozenbitarray:
        return frozenbitarray(self.bits.part(lo, hi, st, flags))

    @eq
    def same(self, other: frozenbitarray) -> bool:
        return self.bits == other.bits

    @bitand
    def both(self, other: frozenbitarray) -> frozenbitarray:
        return frozenbitarray(self.bits & other.bits)

    @bitor
    def either(self, other: frozenbitarray) -> frozenbitarray:
        return frozenbitarray(self.bits | other.bits)

    @bitxor
    def differ(self, other: frozenbitarray) -> frozenbitarray:
        return frozenbitarray(self.bits ^ other.bits)

    @invert
    def flipped(self) -> frozenbitarray:
        return frozenbitarray(~self.bits)

    def shift_left(self, count: int) -> frozenbitarray:
        return frozenbitarray(self.bits.shift_left(count))

    def shift_right(self, count: int) -> frozenbitarray:
        return frozenbitarray(self.bits.shift_right(count))

    def count(self) -> int:
        return self.bits.count()

    def any(self) -> bool:
        return self.bits.any()

    def all(self) -> bool:
        return self.bits.all()

    def find(self, bit: bool, start: int = 0) -> int:
        return self.bits.find(bit, start)

    def thaw(self) -> bitarray:
        return self.bits.copy()

    def to_list(self) -> list[bool]:
        return self.bits.to_list()

    def to_ints(self) -> list[int]:
        return self.bits.to_ints()

    def to_hex(self) -> str:
        return self.bits.to_hex()

    def to_int(self) -> int:
        return self.bits.to_int()

    # a number that is the same for equal arrays (a frozenbitarray never changes, so it can be kept)
    def hash(self) -> int:
        h = self.bits.n
        for w in self.bits.words:
            h = (h * 1000003 + w) % 2305843009213693951
        return h

    # the bits as text: equal arrays have equal keys, so this is what a dict key or a set member uses
    def key(self) -> str:
        return str(self.bits)

    @str
    def text(self) -> str:
        return str(self.bits)
