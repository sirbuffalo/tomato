# An HTTP client in the style of Python's requests. Use it with: import requests
#
#     r = await requests.get('https://example.com')
#     print(r.status, r.ok, r.headers['content-type'])
#     print(r.text)
#
# Every call is async and is awaited, like input(): other tasks run while a request is on its way, and requests started
# with `start` really overlap. Natively the runtime does the network work through the system's libcurl (loaded when the first
# request starts, so a program that never makes a request needs nothing); the browser playground has no network access here,
# so there every request raises ConnectionError.
#
# A 404 or 500 is not an error by itself: r.status says what happened, and r.raise_for_status() raises HTTPError when you want that.

# the runtime's request functions (runtime/tomato_rt.c); a request is a number, and await _http_wait(n) waits for it
!tomato_http_start(method: str, url: str, headers: str, body: str, body_mode: int, timeout: float, follow: int, max_redirects: int) -> int
!tomato_http_status(id: int) -> int
!tomato_http_error_kind(id: int) -> int
!tomato_http_error_text(id: int) -> str
!tomato_http_body_len(id: int) -> int
!tomato_http_body_byte(id: int, i: int) -> int
!tomato_http_url(id: int) -> str
!tomato_http_headers(id: int) -> str
!tomato_http_text(id: int) -> str
!tomato_http_free(id: int)

# Everything this library raises is a RequestError, so `catch RequestError` handles any failure of a request.
export class RequestError(IOError):
    @init
    def make_request_error(self, message: str):
        IOError.make_io(self, message)

# The server could not be reached: its name was not found, it refused, the connection dropped, or the TLS handshake failed.
export class ConnectionError(RequestError):
    @init
    def make_connection_error(self, message: str):
        RequestError.make_request_error(self, message)

# The request took longer than its timeout.
export class TimeoutError(RequestError):
    @init
    def make_timeout_error(self, message: str):
        RequestError.make_request_error(self, message)

# The url is not an http:// or https:// address, or another part of the request cannot be sent.
export class InvalidURL(RequestError):
    @init
    def make_invalid_url(self, message: str):
        RequestError.make_request_error(self, message)

# The server sent too many redirects (more than max_redirects, or a loop).
export class TooManyRedirects(RequestError):
    @init
    def make_too_many_redirects(self, message: str):
        RequestError.make_request_error(self, message)

# Raised by raise_for_status() for a 4xx or 5xx answer; status holds the code.
export class HTTPError(RequestError):
    status: int = 0

    @init
    def make_http_error(self, message: str, status: int):
        RequestError.make_request_error(self, message)
        self.status = status

# What the server answered. status is the code (200, 404, ...), ok is True below 400, text is the body as text (bytes that are
# not valid UTF-8 become U+FFFD), content is the body as a list of byte values, headers has lower-case names (a name sent
# twice joins its values with ', '), and url is the address after redirects.
export class Response:
    status: int = 0
    ok: bool = False
    url: str = ''
    text: str = ''
    headers: dict[str, str] = {}
    content: list[int] = []

    def raise_for_status(self):
        if self.status >= 400:
            kind = 'Client Error'
            if self.status >= 500:
                kind = 'Server Error'
            raise HTTPError(f'{self.status} {kind} for url: {self.url}', self.status)

# The body as JSON is r.json() once the json library exists; until then parse r.text yourself.

def _unreserved(c: str) -> bool:
    return c.isalpha() and ord(c) < 128 or c.isdigit() or c in ['-', '_', '.', '~']

def _hex(n: int) -> str:
    digits = '0123456789ABCDEF'
    return '%' + digits[n // 16] + digits[n % 16]

# percent-encoding of text for a url query or a form: quote('a b&c') is 'a%20b%26c'
export def quote(text: str) -> str:
    out = ''
    for c in text:
        if _unreserved(c):
            out += c
            continue
        n = ord(c)
        if n < 128:
            out += _hex(n)
        elif n < 2048:
            out += _hex(192 + n // 64) + _hex(128 + n % 64)
        elif n < 65536:
            out += _hex(224 + n // 4096) + _hex(128 + (n // 64) % 64) + _hex(128 + n % 64)
        else:
            out += _hex(240 + n // 262144) + _hex(128 + (n // 4096) % 64) + _hex(128 + (n // 64) % 64) + _hex(128 + n % 64)
    return out

def _form(fields: dict[str, str]) -> str:
    parts: list[str] = []
    for k in fields.keys():
        parts.append(quote(k) + '=' + quote(fields[k]))
    return '&'.join(parts)

def _header_lines(headers: dict[str, str]) -> str:
    out = ''
    for k in headers.keys():
        v = headers[k]
        if '\n' in k or '\r' in k or '\n' in v or '\r' in v or ':' in k:
            raise InvalidURL(f"the header '{k}' has a line break or a colon in its name")
        out += k + ': ' + v + '\n'
    return out

def _has_header(headers: dict[str, str], name: str) -> bool:
    for k in headers.keys():
        if k.lower() == name:
            return True
    return False

def _parse_headers(raw: str) -> dict[str, str]:
    out: dict[str, str] = {}
    for line in raw.split('\n'):
        line = line.strip()
        i = line.find(':')
        if i <= 0:
            continue
        name = line[:i].strip().lower()
        value = line[i + 1:].strip()
        if name in out:
            out[name] = out[name] + ', ' + value
        else:
            out[name] = value
    return out

# the general call: request('GET', url, ...). Use get, post and the others for the common cases.
#   params   added to the url as ?name=value&...
#   data     the body as text, sent as it is
#   form     the body as an HTML form made from a dict (application/x-www-form-urlencoded)
#   json     the body as JSON text (Content-Type: application/json)
#   headers  extra request headers
#   timeout  seconds for the whole request (0 means no limit); TimeoutError when it runs out
#   follow_redirects, max_redirects   follow 3xx answers (the default), at most that many times
export async def request(method: str, url: str, params: dict[str, str] = {}, data: str = '', form: dict[str, str] = {},
                         json: str = '', headers: dict[str, str] = {}, timeout: float = 0.0,
                         follow_redirects: bool = True, max_redirects: int = 20) -> Response:
    hdr: dict[str, str] = {}
    for k in headers.keys():
        hdr[k] = headers[k]
    full = url
    if len(params) > 0:
        sep = '?'
        if '?' in url:
            sep = '&'
        full = url + sep + _form(params)
    body = ''
    has_body = 0
    if json != '':
        body = json
        has_body = 1
        if not _has_header(hdr, 'content-type'):
            hdr['Content-Type'] = 'application/json'
    elif len(form) > 0:
        has_body = 1
        body = _form(form)
        if not _has_header(hdr, 'content-type'):
            hdr['Content-Type'] = 'application/x-www-form-urlencoded'
    elif data != '':
        has_body = 1
        body = data
    follow = 0
    if follow_redirects:
        follow = 1
    id = !tomato_http_start(method.upper(), full, _header_lines(hdr), body, has_body, float(timeout), follow, max_redirects)
    try:
        await _http_wait(id)
        kind = !tomato_http_error_kind(id)
        if kind != 0:
            message = !tomato_http_error_text(id)
            if kind == 2:
                raise TimeoutError(message)
            if kind == 3:
                raise InvalidURL(message)
            if kind == 4:
                raise TooManyRedirects(message)
            if kind == 5:
                raise RequestError(message)
            raise ConnectionError(message)
        r = Response()
        r.status = !tomato_http_status(id)
        r.ok = r.status < 400
        r.url = !tomato_http_url(id)
        r.text = !tomato_http_text(id)
        r.headers = _parse_headers(!tomato_http_headers(id))
        # content is copied byte by byte: fine for ordinary pages, slow and memory-heavy for bodies of hundreds of megabytes
        n = !tomato_http_body_len(id)
        content: list[int] = []
        for i in range(n):
            content.append(!tomato_http_body_byte(id, i))
        r.content = content
        return r
    finally:
        !tomato_http_free(id)

export async def get(url: str, params: dict[str, str] = {}, headers: dict[str, str] = {}, timeout: float = 0.0,
                     follow_redirects: bool = True, max_redirects: int = 20) -> Response:
    return await request('GET', url, params=params, headers=headers, timeout=timeout, follow_redirects=follow_redirects, max_redirects=max_redirects)

export async def head(url: str, params: dict[str, str] = {}, headers: dict[str, str] = {}, timeout: float = 0.0,
                      follow_redirects: bool = False, max_redirects: int = 20) -> Response:
    return await request('HEAD', url, params=params, headers=headers, timeout=timeout, follow_redirects=follow_redirects, max_redirects=max_redirects)

export async def delete(url: str, params: dict[str, str] = {}, headers: dict[str, str] = {}, timeout: float = 0.0,
                        follow_redirects: bool = True, max_redirects: int = 20) -> Response:
    return await request('DELETE', url, params=params, headers=headers, timeout=timeout, follow_redirects=follow_redirects, max_redirects=max_redirects)

export async def post(url: str, params: dict[str, str] = {}, data: str = '', form: dict[str, str] = {}, json: str = '',
                      headers: dict[str, str] = {}, timeout: float = 0.0, follow_redirects: bool = True, max_redirects: int = 20) -> Response:
    return await request('POST', url, params=params, data=data, form=form, json=json, headers=headers, timeout=timeout, follow_redirects=follow_redirects, max_redirects=max_redirects)

export async def put(url: str, params: dict[str, str] = {}, data: str = '', form: dict[str, str] = {}, json: str = '',
                     headers: dict[str, str] = {}, timeout: float = 0.0, follow_redirects: bool = True, max_redirects: int = 20) -> Response:
    return await request('PUT', url, params=params, data=data, form=form, json=json, headers=headers, timeout=timeout, follow_redirects=follow_redirects, max_redirects=max_redirects)

export async def patch(url: str, params: dict[str, str] = {}, data: str = '', form: dict[str, str] = {}, json: str = '',
                       headers: dict[str, str] = {}, timeout: float = 0.0, follow_redirects: bool = True, max_redirects: int = 20) -> Response:
    return await request('PATCH', url, params=params, data=data, form=form, json=json, headers=headers, timeout=timeout, follow_redirects=follow_redirects, max_redirects=max_redirects)
