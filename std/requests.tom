# An HTTP client in the style of Python's requests. Use it with: import requests
#
#     r = await requests.get('https://example.com')
#     print(r.status, r.ok, r.headers['content-type'])
#     print(r.text)
#
# Every call is async and is awaited, like input(): other tasks run while a request is on its way, and requests started
# with `start` really overlap. Natively the runtime does the network work through the system's libcurl (loaded when the
# first request starts, so a program that never makes a request needs nothing); the browser playground has no network
# access here, so there every request raises ConnectionError.
#
# A 404 or 500 is not an error by itself: r.status says what happened, and r.raise_for_status() raises HTTPError when
# you want that.

from json import loads, dumps
from value import Value

# the runtime's request functions (runtime/tomato_rt.c); a request is a number, and await _http_wait(n) waits for it
!tomato_http_start(method: str, url: str, headers: str, body: bytes, body_mode: int, timeout: float, follow: int,
                   max_redirects: int) -> int
!tomato_http_status(id: int) -> int
!tomato_http_error_kind(id: int) -> int
!tomato_http_error_text(id: int) -> str
!tomato_http_content(id: int) -> bytes
!tomato_http_url(id: int) -> str
!tomato_http_headers(id: int) -> str
!tomato_http_text(id: int) -> str
!tomato_http_free(id: int)
!tomato_http_download(url: str, path: str, https_only: int, max_bytes: int, timeout: float) -> int
!tomato_http_dl_size(id: int) -> int

# Every failure of a request is an IOError, so `catch IOError` handles any of them. A failure that is not about the connection or
# the time it took is a RequestError (below). The two that are, ConnectionError and TimeoutError, extend the built-in classes of those
# names instead, so `catch ConnectionError` and `catch TimeoutError` handle them together with the other libraries' (D114a); a class
# has one parent, so they are not RequestErrors.
export class RequestError(IOError):
    pass

# The server could not be reached: its name was not found, it refused, the connection dropped, or the TLS handshake
# failed.
export class ConnectionError(ConnectionError):
    pass

# The request took longer than its timeout.
export class TimeoutError(TimeoutError):
    pass

# The url is not an http:// or https:// address, or another part of the request cannot be sent.
export class InvalidURL(RequestError):
    pass

# The server sent too many redirects (more than max_redirects, or a loop).
export class TooManyRedirects(RequestError):
    pass

# Raised by raise_for_status() for a 4xx or 5xx answer; status holds the code.
export class HTTPError(RequestError):
    status: int = 0

    @init
    def make_http_error(self, message: str, status: int, id: str = ''):
        IOError.make_io(self, message, id)
        self.status = status

# What the server answered. status is the code (200, 404, ...), ok is True below 400, text is the body as text (bytes
# that are not valid UTF-8 become U+FFFD), content is the body as bytes, headers has lower-case names (a
# name sent twice joins its values with ', '), and url is the address after redirects.
export class Response:
    status: int = 0
    ok: bool = False
    url: str = ''
    text: str = ''
    headers: dict[str, str] = {}
    content: bytes = b''

    # the body parsed as JSON; JSONDecodeError when it is not JSON
    def json(self) -> Value:
        return loads(self.text)

    def raise_for_status(self):
        if self.status >= 400:
            kind = 'Server Error' if self.status >= 500 else 'Client Error'
            raise HTTPError(f'{self.status} {kind} for url: {self.url}', self.status, 'E358')

def _unreserved(c: str) -> bool:
    return ord(c) < 128 and (c.isalpha() or c.isdigit()) or c in ['-', '_', '.', '~']

def _hex(n: int) -> str:
    digits = '0123456789ABCDEF'
    return '%' + digits[n // 16] + digits[n % 16]

# percent-encoding of text for a url query or a form: quote('a b&c') is 'a%20b%26c'
export def quote(text: str) -> str:
    out = ''
    for c in text:
        if _unreserved(c):
            out += c
            continue
        n = ord(c)
        if n < 128:
            out += _hex(n)
        elif n < 2048:
            out += _hex(192 + n // 64) + _hex(128 + n % 64)
        elif n < 65536:
            out += _hex(224 + n // 4096) + _hex(128 + (n // 64) % 64) + _hex(128 + n % 64)
        else:
            out += _hex(240 + n // 262144) + _hex(128 + (n // 4096) % 64) + _hex(128 + (n // 64) % 64)
            out += _hex(128 + n % 64)
    return out

def _form(fields: dict[str, str]) -> str:
    parts: list[str] = []
    for k, v in fields.items():
        parts.append(f'{quote(k)}={quote(v)}')
    return '&'.join(parts)

# the timeout as a float: a whole number of seconds is as good as a float (as for asyncio.wait_for)
def _seconds(timeout: int | float) -> float:
    if timeout is int:
        return float(timeout)
    return timeout

def _header_lines(headers: dict[str, str]) -> str:
    out = ''
    for k, v in headers.items():
        if '\n' in k or '\r' in k or '\n' in v or '\r' in v or ':' in k:
            raise InvalidURL(f"the header '{k}' has a line break or a colon in its name", 'E359')
        out += f'{k}: {v}\n'
    return out

def _has_header(headers: dict[str, str], name: str) -> bool:
    for k in headers:
        if k.lower() == name:
            return True
    return False

def _parse_headers(raw: str) -> dict[str, str]:
    out: dict[str, str] = {}
    for line in raw.split('\n'):
        line = line.strip()
        i = line.find(':')
        if i <= 0:
            continue
        name = line[:i].strip().lower()
        value = line[i + 1:].strip()
        if name in out:
            out[name] += f', {value}'
        else:
            out[name] = value
    return out

# the bytes of a body given as text (its UTF-8) or as bytes
def _body_bytes(data: str | bytes) -> bytes:
    if data is bytes:
        return data
    return data.encode()

# the general call: request('GET', url, ...). Use get, post and the others for the common cases.
#   params   added to the url as ?name=value&...
#   data     the body as text (sent as its UTF-8) or as bytes, sent as they are
#   form     the body as an HTML form made from a dict (application/x-www-form-urlencoded)
#   json     the body as JSON (Content-Type: application/json): a Value value (sent as dumps(value)) or ready-made
#            JSON text
#   headers  extra request headers
#   timeout  seconds for the whole request (0 means no limit); TimeoutError when it runs out
#   follow_redirects, max_redirects   follow 3xx answers (the default), at most that many times
export async def request(method: str, url: str, params: dict[str, str] = {}, data: str | bytes = '', form: dict[str, str] = {},
                         json: str | Value = '', headers: dict[str, str] = {}, timeout: int | float = 0.0,
                         follow_redirects: bool = True, max_redirects: int = 20) -> Response:
    hdr: dict[str, str] = {}
    for k, v in headers.items():
        hdr[k] = v
    full = url
    if len(params) > 0:
        sep = '?'
        if '?' in url:
            sep = '&'
        full = url + sep + _form(params)
    body = b''
    has_body = 0
    json_given = False
    if json is str:
        if json != '':
            json_given = True
            body = json.encode()
    else:
        json_given = True
        body = dumps(json).encode()
    if json_given:
        has_body = 1
        if not _has_header(hdr, 'content-type'):
            hdr['Content-Type'] = 'application/json'
    elif len(form) > 0:
        has_body = 1
        body = _form(form).encode()
        if not _has_header(hdr, 'content-type'):
            hdr['Content-Type'] = 'application/x-www-form-urlencoded'
    else:
        body = _body_bytes(data)
        if len(body) > 0:
            has_body = 1
    follow = 1 if follow_redirects else 0
    id = !tomato_http_start(method.upper(), full, _header_lines(hdr), body, has_body, _seconds(timeout), follow,
                            max_redirects)
    try:
        await _http_wait(id)
        kind = !tomato_http_error_kind(id)
        if kind != 0:
            message = !tomato_http_error_text(id)
            if kind == 2:
                raise TimeoutError(message, 'E360')
            if kind == 3:
                raise InvalidURL(message, 'E361')
            if kind == 4:
                raise TooManyRedirects(message, 'E362')
            if kind == 5:
                raise RequestError(message, 'E363')
            raise ConnectionError(message, 'E364')
        r = Response()
        r.status = !tomato_http_status(id)
        r.ok = r.status < 400
        r.url = !tomato_http_url(id)
        r.text = !tomato_http_text(id)
        r.headers = _parse_headers(!tomato_http_headers(id))
        r.content = !tomato_http_content(id)
        return r
    finally:
        !tomato_http_free(id)

export async def get(url: str, params: dict[str, str] = {}, headers: dict[str, str] = {}, timeout: int | float = 0.0,
                     follow_redirects: bool = True, max_redirects: int = 20) -> Response:
    return await request('GET', url, params=params, headers=headers, timeout=timeout,
                         follow_redirects=follow_redirects, max_redirects=max_redirects)

export async def head(url: str, params: dict[str, str] = {}, headers: dict[str, str] = {}, timeout: int | float = 0.0,
                      follow_redirects: bool = False, max_redirects: int = 20) -> Response:
    return await request('HEAD', url, params=params, headers=headers, timeout=timeout,
                         follow_redirects=follow_redirects, max_redirects=max_redirects)

export async def delete(url: str, params: dict[str, str] = {}, headers: dict[str, str] = {}, timeout: int | float = 0.0,
                        follow_redirects: bool = True, max_redirects: int = 20) -> Response:
    return await request('DELETE', url, params=params, headers=headers, timeout=timeout,
                         follow_redirects=follow_redirects, max_redirects=max_redirects)

export async def post(url: str, params: dict[str, str] = {}, data: str | bytes = '', form: dict[str, str] = {},
                      json: str | Value = '', headers: dict[str, str] = {}, timeout: int | float = 0.0,
                      follow_redirects: bool = True, max_redirects: int = 20) -> Response:
    return await request('POST', url, params=params, data=data, form=form, json=json, headers=headers,
                         timeout=timeout, follow_redirects=follow_redirects, max_redirects=max_redirects)

export async def put(url: str, params: dict[str, str] = {}, data: str | bytes = '', form: dict[str, str] = {},
                     json: str | Value = '', headers: dict[str, str] = {}, timeout: int | float = 0.0,
                     follow_redirects: bool = True, max_redirects: int = 20) -> Response:
    return await request('PUT', url, params=params, data=data, form=form, json=json, headers=headers,
                         timeout=timeout, follow_redirects=follow_redirects, max_redirects=max_redirects)

export async def patch(url: str, params: dict[str, str] = {}, data: str | bytes = '', form: dict[str, str] = {},
                       json: str | Value = '', headers: dict[str, str] = {}, timeout: int | float = 0.0,
                       follow_redirects: bool = True, max_redirects: int = 20) -> Response:
    return await request('PATCH', url, params=params, data=data, form=form, json=json, headers=headers,
                         timeout=timeout, follow_redirects=follow_redirects, max_redirects=max_redirects)

# Downloads url to the file `path` and gives the number of bytes written, without holding the body in memory. The answer is written under
# another name beside `path` and renamed over it when it arrived whole and the status was a success (200 to 299), so `path` is never half a
# download and a failure leaves any earlier file as it was (and no partial file). A 4xx or 5xx answer raises HTTPError, and nothing is written.
#   https_only   True (the default): the address, and every redirect on the way, must be https://; an http:// address is an InvalidURL before
#                anything is sent, and a redirect to http:// ends the download with an InvalidURL. False allows http:// as well. (Only the
#                tests of this library and of `tomato update` can turn on file:// addresses and an http:// first address with https_only,
#                with the variables TOMATO_DOWNLOAD_ALLOW_FILE and TOMATO_DOWNLOAD_ALLOW_HTTP_FIRST; the answer is not checked against anything
#                here: check its sha256_file.)
#   max_bytes    stops the download with a RequestError when the body is longer than this (None: no limit)
#   timeout      seconds for the whole download (0 means no limit); TimeoutError when it runs out
# Redirects are followed (at most 20). A file that cannot be written is an IOError. New (unstable): stage 1 of docs/shell-to-tomato-plan.md.
export async def download(url: str, path: str, https_only: bool = True, max_bytes: int | None = None, timeout: float = 0.0) -> int:
    if chr(0) in path:
        raise ValueError('a path or name cannot contain a NUL character', 'E511')
    limit = -1
    if max_bytes is not None:
        if max_bytes < 0:
            raise ValueError('max_bytes cannot be negative', 'E663')
        limit = max_bytes
    id = !tomato_http_download(url, path, 1 if https_only else 0, limit, float(timeout))
    try:
        await _http_wait(id)
        kind = !tomato_http_error_kind(id)
        if kind != 0:
            message = !tomato_http_error_text(id)
            if kind == 2:
                raise TimeoutError(message, 'E360')
            if kind == 3:
                raise InvalidURL(message, 'E361')
            if kind == 4:
                raise TooManyRedirects(message, 'E362')
            if kind == 5 or kind == 7:
                raise RequestError(message, 'E363')
            if kind == 6:
                raise IOError(message, 'E515')
            raise ConnectionError(message, 'E364')
        status = !tomato_http_status(id)
        if status >= 400:
            what = 'Server Error' if status >= 500 else 'Client Error'
            raise HTTPError(f'{status} {what} for url: {url}', status, 'E358')
        if status != 0 and (status < 200 or status > 299):
            raise RequestError(f'the answer to the download was {status}, not a success', 'E363')
        return !tomato_http_dl_size(id)
    finally:
        !tomato_http_free(id)
