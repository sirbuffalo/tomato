# Regular expressions; see docs/regex.md. Module-level calls compile each time.
# Keep a Pattern when reusing a regex.

export const IGNORECASE = 2
export const MULTILINE = 8
export const DOTALL = 16
export const VERBOSE = 64
export const ASCII = 256
export const I = 2
export const M = 8
export const S = 16
export const X = 64
export const A = 256

# Python's re.escape escapes regex metacharacters, whitespace and the characters
# that have special meaning in verbose patterns or character classes.
export def escape(text: str) -> str:
    parts: list[str] = []
    for c in text:
        if c in '()[]{}?*+-|^$\\.&~# \t\n\r' or ord(c) == 11 or ord(c) == 12:
            parts.append('\\')
        parts.append(c)
    return ''.join(parts)

export class RegexError(RuntimeError):
    pos: int = 0

    @init
    def make_regex(self, message: str, pos: int = 0, id: str = ''):
        RuntimeError.make(self, message, id)
        self.pos = pos

# Parser nodes occupy six integer slots: kind, first, second, lower, upper, lazy.
# Child references are node indices, not byte offsets. Class text is held separately.
# The parser is deliberately separate from the execution program so repeated
# expressions can be compiled without retaining executable closures.
class _Parser:
    source: str = ''
    pos: int = 0
    groups: int = 0
    depth: int = 0
    flags: int = 0
    groupindex: dict[str, int] = {}
    closed: list[int] = []
    lookbehind_groups: list[int] = []
    nodes: list[int] = []
    classes: list[list[int]] = []

    @init
    def make(self, source: str, flags: int = 0):
        self.source = source
        self.flags = flags
        self.groupindex = {}
        self.closed = []
        self.lookbehind_groups = []
        self.nodes = []
        self.classes = []

    def node(self, kind: int, a: int = 0, b: int = 0, lo: int = 0, hi: int = 0, lazy: int = 0) -> int:
        n = len(self.nodes) // 6
        self.nodes.extend([kind, a, b, lo, hi, lazy])
        return n

    def peek(self) -> str:
        if self.pos >= len(self.source):
            return ''
        return self.source[self.pos]

    def take(self) -> str:
        c = self.peek()
        if c != '':
            self.pos += 1
        return c

    def parse(self) -> int:
        root = self.alternative()
        if self.pos != len(self.source):
            raise RegexError('unexpected character', self.pos, 'E486')
        return root

    def alternative(self) -> int:
        left = self.sequence()
        count = 1
        while self.peek() == '|':
            self.take()
            # the compiler recurses once per alternative or sequence item (see group), so both counts are limited
            count += 1
            if count > 10000:
                raise RegexError('too many alternatives', self.pos, 'E491')
            right = self.sequence()
            left = self.node(6, left, right)
        return left

    def sequence(self) -> int:
        left = self.node(0)
        count = 0
        while self.peek() != '' and self.peek() != ')' and self.peek() != '|':
            if (self.flags & VERBOSE) != 0 and self.peek() in ' \t\n\r' + chr(11) + chr(12):
                self.take()
                continue
            if (self.flags & VERBOSE) != 0 and self.peek() == '#':
                while self.peek() != '' and self.peek() != '\n':
                    self.take()
                continue
            right = self.repeated()
            count += 1
            if count > 10000:
                raise RegexError('pattern sequence is too long', self.pos, 'E491')
            left = self.node(5, left, right)
        return left

    def skip_ignored(self):
        if (self.flags & VERBOSE) == 0:
            return
        while True:
            if self.peek() != '' and self.peek() in ' \t\n\r' + chr(11) + chr(12):
                self.take()
            elif self.peek() == '#':
                while self.peek() != '' and self.peek() != '\n':
                    self.take()
            else:
                break

    def brace_repeat(self) -> bool:
        if self.peek() != '{':
            return False
        i = self.pos + 1
        digits = 0
        while i < len(self.source) and self.source[i] >= '0' and self.source[i] <= '9':
            i += 1
            digits += 1
        comma = i < len(self.source) and self.source[i] == ','
        if comma:
            i += 1
            while i < len(self.source) and self.source[i] >= '0' and self.source[i] <= '9':
                i += 1
        return (digits > 0 or comma) and i < len(self.source) and self.source[i] == '}'

    def repeated(self) -> int:
        begin = self.pos
        atom = self.atom()
        self.skip_ignored()
        quantifier_pos = self.pos
        kind = self.nodes[atom * 6]
        if kind == 1 or kind == 2 or kind == 3 or kind == 4 or kind == 9 or kind == 11:
            self.nodes[atom * 6 + 3] = self.flags
        c = self.peek()
        lo = 0
        hi = 0
        quantifier = True
        if c == '*':
            self.take()
            hi = -1
        elif c == '+':
            self.take()
            lo = 1
            hi = -1
        elif c == '?':
            self.take()
            hi = 1
        elif c == '{':
            begin = self.pos
            self.take()
            lo = self.number()
            comma = self.peek() == ','
            if comma:
                self.take()
                hi = self.number()
                if lo < 0:
                    lo = 0
            else:
                hi = lo
            if self.peek() != '}' or lo < 0:
                self.pos = begin
                quantifier = False
            else:
                self.take()
                # a counted repeat is unrolled into the program, so its count is limited (Python allows far larger ones)
                if lo > 65535 or hi > 65535:
                    raise RegexError('repeat count is too large', begin, 'E490')
                if not comma and hi < 0:
                    self.pos = begin
                    quantifier = False
                elif hi >= 0 and hi < lo:
                    raise RegexError('invalid repeat range', begin, 'E490')
        else:
            quantifier = False
        if not quantifier:
            return atom
        # as in Python, ^ $ \A \Z \b and \B cannot be repeated (a group around one can, and so can a lookaround)
        if kind == 4 and self.source[begin] != '(':
            raise RegexError('nothing to repeat', quantifier_pos, 'E490')
        lazy = 0
        if self.peek() == '?':
            self.take()
            lazy = 1
        elif self.peek() == '+':
            raise RegexError('possessive quantifiers are not supported', self.pos, 'E491')
        if self.peek() == '*' or self.peek() == '+' or self.peek() == '?' or self.brace_repeat():
            raise RegexError('multiple repeat', self.pos, 'E490')
        return self.node(7, atom, 0, lo, hi, lazy)

    def number(self) -> int:
        start = self.pos
        value = 0
        while self.peek() != '' and self.peek() >= '0' and self.peek() <= '9':
            value = value * 10 + ord(self.take()) - 48
        return -1 if self.pos == start else value

    def atom(self) -> int:
        start = self.pos
        c = self.take()
        if c == '*' or c == '+' or c == '?':
            raise RegexError('nothing to repeat', start, 'E490')
        if c == '{':
            self.pos = start
            if self.brace_repeat():
                raise RegexError('nothing to repeat', start, 'E490')
            self.pos += 1
        if c == '.':
            return self.node(2)
        if c == '^' or c == '$':
            return self.node(4, ord(c))
        if c == '[':
            return self.character_class(start)
        if c == '(':
            return self.group(start)
        if c == '\\':
            return self.escaped(start)
        return self.node(1, ord(c))

    def group(self, start: int) -> int:
        capture = True
        name = ''
        look = 0
        saved_flags = self.flags
        if self.peek() == '?':
            self.take()
            marker = self.take()
            if marker == ':':
                capture = False
            elif marker == '#':
                while self.peek() != '' and self.peek() != ')':
                    self.take()
                if self.take() != ')':
                    raise RegexError('unclosed comment', start, 'E488')
                return self.node(0)
            elif marker == '=' or marker == '!':
                capture = False
                look = 1 if marker == '=' else 2
            elif marker == '<':
                sign = self.take()
                if sign != '=' and sign != '!':
                    raise RegexError('unknown group extension', start, 'E488')
                capture = False
                look = 3 if sign == '=' else 4
            elif marker == 'P':
                form = self.take()
                if form == '=':
                    name = self.group_name(')', start)
                    if name not in self.groupindex:
                        raise RegexError('unknown group name', start, 'E492')
                    if self.groupindex[name] not in self.closed or (len(self.lookbehind_groups) > 0 and self.groupindex[name] > self.lookbehind_groups[len(self.lookbehind_groups) - 1]):
                        raise RegexError('group reference is not available here', start, 'E492')
                    return self.node(11, self.groupindex[name])
                if form != '<':
                    raise RegexError('unknown group extension', start, 'E488')
                name = self.group_name('>', start)
                if name in self.groupindex:
                    raise RegexError('duplicate group name', start, 'E488')
            elif marker != '' and marker in 'imsxa-':
                capture = False
                add = 0
                remove = 0
                removing = False
                saw_flag = False
                while marker != '':
                    if marker == '-':
                        if removing:
                            raise RegexError('bad inline flags', start, 'E488')
                        removing = True
                        marker = self.take()
                        continue
                    bit = 0
                    if marker == 'i':
                        bit = IGNORECASE
                    elif marker == 'm':
                        bit = MULTILINE
                    elif marker == 's':
                        bit = DOTALL
                    elif marker == 'x':
                        bit = VERBOSE
                    elif marker == 'a':
                        bit = ASCII
                    if bit == 0:
                        break
                    saw_flag = True
                    if removing:
                        if bit == ASCII:
                            raise RegexError('ASCII flag cannot be removed', start, 'E488')
                        remove = remove | bit
                    else:
                        add = add | bit
                    marker = self.take()
                if not saw_flag or (add & remove) != 0 or (removing and remove == 0):
                    raise RegexError('bad inline flags', start, 'E488')
                new_flags = (self.flags | add) & ~remove
                if marker == ')':
                    if start != 0 or removing:
                        raise RegexError('global flags must be at the start', start, 'E488')
                    self.flags = new_flags
                    return self.node(0)
                if marker != ':':
                    raise RegexError('unknown inline flags', start, 'E488')
                self.flags = new_flags
            else:
                raise RegexError('group extension is not supported', start, 'E491')
        group = 0
        if capture:
            self.groups += 1
            group = self.groups
            if name != '':
                self.groupindex[name] = group
        if look >= 3:
            self.lookbehind_groups.append(self.groups)
        # the parser and compiler recurse once per nesting level, so an unbounded depth would end the program with an
        # uncatchable stack overflow; a limit makes a hostile pattern an ordinary RegexError
        self.depth += 1
        if self.depth > 1000:
            raise RegexError('pattern is nested too deeply', start, 'E491')
        child = self.alternative()
        self.depth -= 1
        if look >= 3:
            self.lookbehind_groups.pop()
        if self.take() != ')':
            raise RegexError('unclosed group', start, 'E488')
        self.flags = saved_flags
        if capture:
            self.closed.append(group)
            return self.node(8, child, group)
        if look != 0:
            n = self.node(10, child, look)
            self.nodes[n * 6 + 4] = start
            return n
        return child

    def group_name(self, end: str, start: int) -> str:
        chars: list[str] = []
        while self.peek() != '' and self.peek() != end:
            chars.append(self.take())
        if self.take() != end or len(chars) == 0:
            raise RegexError('bad group name', start, 'E488')
        name = ''.join(chars)
        if not (name[0].isalpha() or name[0] == '_'):
            raise RegexError('bad group name', start, 'E488')
        for c in name:
            if not (c.isalpha() or c.isdigit() or c == '_'):
                raise RegexError('bad group name', start, 'E488')
        return name

    def class_item(self, start: int) -> int:
        c = self.take()
        if c != '\\':
            return ord(c)
        if self.peek() == 'b':
            self.take()
            return 8
        n = self.escaped(start, True)
        kind = self.nodes[n * 6]
        if kind == 9:
            return -self.nodes[n * 6 + 1] - 1
        if kind != 1:
            raise RegexError('invalid escape in character class', start, 'E489')
        return self.nodes[n * 6 + 1]

    def character_class(self, start: int) -> int:
        negate = 0
        if self.peek() == '^':
            self.take()
            negate = 1
        pairs: list[tuple[int, int]] = []
        if self.peek() == ']':
            self.take()
            pairs.append((93, 93))
        while self.peek() != '' and self.peek() != ']':
            first = self.class_item(start)
            last = first
            if self.peek() == '-' and self.pos + 1 < len(self.source) and self.source[self.pos + 1] != ']':
                self.take()
                last = self.class_item(start)
                if first < 0 or last < 0 or first > last:
                    raise RegexError('invalid character class range', start, 'E489')
            pairs.append((first, last))
        if self.take() != ']':
            raise RegexError('unclosed character class', start, 'E489')
        for i in range(1, len(pairs)):
            pair = pairs[i]
            j = i
            while j > 0 and (pairs[j - 1][0] > pair[0] or (pairs[j - 1][0] == pair[0] and pairs[j - 1][1] > pair[1])):
                pairs[j] = pairs[j - 1]
                j -= 1
            pairs[j] = pair
        ranges: list[int] = [negate]
        for pair in pairs:
            if pair[0] >= 0 and len(ranges) > 1 and ranges[len(ranges) - 2] >= 0 and pair[0] <= ranges[len(ranges) - 1] + 1:
                ranges[len(ranges) - 1] = max(ranges[len(ranges) - 1], pair[1])
            else:
                ranges.append(pair[0])
                ranges.append(pair[1])
        index = len(self.classes)
        self.classes.append(ranges)
        return self.node(3, index)

    def octal_digit(self) -> bool:
        return self.peek() != '' and self.peek() >= '0' and self.peek() <= '7'

    # An octal escape, as in Python: after the first digit up to two more octal digits, and the value must be at most 0o377.
    def octal_escape(self, first: str, start: int) -> int:
        value = ord(first) - 48
        for i in range(2):
            if not self.octal_digit():
                break
            value = value * 8 + ord(self.take()) - 48
        if value > 255:
            raise RegexError('octal escape is out of range', start, 'E487')
        return self.node(1, value)

    def escaped(self, start: int, in_class: bool = False) -> int:
        c = self.take()
        if c == '':
            raise RegexError('trailing escape', start, 'E487')
        if c in 'dDwWsS':
            return self.node(9, ord(c))
        if c in 'AZbB':
            return self.node(4, ord(c))
        if c == 'n':
            return self.node(1, 10)
        if c == 't':
            return self.node(1, 9)
        if c == 'r':
            return self.node(1, 13)
        if c == 'f':
            return self.node(1, 12)
        if c == 'v':
            return self.node(1, 11)
        if c == 'a':
            return self.node(1, 7)
        if c == '0':
            return self.octal_escape(c, start)
        if in_class and c >= '1' and c <= '7':
            return self.octal_escape(c, start)
        if in_class and (c == '8' or c == '9'):
            raise RegexError('unknown escape', start, 'E487')
        if c >= '1' and c <= '9':
            group = ord(c) - 48
            if self.peek() >= '0' and self.peek() <= '9' and self.peek() != '':
                second = self.take()
                # three octal digits are a character (at most 0o377), not a group reference, as in Python
                if c <= '7' and second <= '7' and self.octal_digit():
                    value = (ord(c) - 48) * 64 + (ord(second) - 48) * 8 + ord(self.take()) - 48
                    if value > 255:
                        raise RegexError('octal escape is out of range', start, 'E487')
                    return self.node(1, value)
                group = group * 10 + ord(second) - 48
            if group not in self.closed or (len(self.lookbehind_groups) > 0 and group > self.lookbehind_groups[len(self.lookbehind_groups) - 1]):
                raise RegexError('unknown group reference', start, 'E492')
            return self.node(11, group)
        if c == 'x' or c == 'u' or c == 'U':
            length = 2 if c == 'x' else (4 if c == 'u' else 8)
            value = 0
            for i in range(length):
                digit = self.take()
                n = '0123456789abcdef'.find(digit.lower()) if digit != '' else -1
                if n < 0:
                    raise RegexError('bad hexadecimal escape', start, 'E487')
                value = value * 16 + n
            if value > 1114111 or (value >= 55296 and value <= 57343):
                raise RegexError('invalid character escape', start, 'E487')
            return self.node(1, value)
        if c == 'G' or c == 'N' or c == 'p' or c == 'P':
            raise RegexError('escape is not supported', start, 'E491')
        if c.isalpha() and ord(c) < 128:
            raise RegexError('unknown escape', start, 'E487')
        return self.node(1, ord(c))

# The execution program uses four integer slots per instruction. Branch targets
# are instruction indices. Compiling backwards makes concatenation and bounded
# repetition share one continuation without patch lists.
class _Compiler:
    nodes: list[int] = []
    code: list[int] = []
    guards: int = 0

    @init
    def make(self, nodes: list[int]):
        self.nodes = nodes
        self.code = []

    def emit(self, op: int, a: int = 0, b: int = 0, flags: int = 0) -> int:
        at = len(self.code) // 4
        # nested counted repeats multiply, so the size of the whole program is limited as well
        if at >= 500000:
            raise RegexError('pattern is too large', 0, 'E491')
        self.code.extend([op, a, b, flags])
        return at

    # -1 means a variable-width expression.
    def width(self, index: int) -> int:
        at = index * 6
        kind = self.nodes[at]
        a = self.nodes[at + 1]
        b = self.nodes[at + 2]
        if kind == 0 or kind == 4 or kind == 10:
            return 0
        if kind == 1 or kind == 2 or kind == 3 or kind == 9:
            return 1
        if kind == 8:
            return self.width(a)
        if kind == 11:
            for i in range(len(self.nodes) // 6):
                if self.nodes[i * 6] == 8 and self.nodes[i * 6 + 2] == a:
                    return self.width(self.nodes[i * 6 + 1])
            return -1
        if kind == 5 or kind == 6:
            left = self.width(a)
            right = self.width(b)
            if left < 0 or right < 0:
                return -1
            if kind == 5:
                return left + right
            return left if left == right else -1
        if kind == 7:
            low = self.nodes[at + 3]
            high = self.nodes[at + 4]
            w = self.width(a)
            if w == 0:
                return 0
            if w < 0 or low != high:
                return -1
            return w * low
        return -1

    # Can the expression match the empty string? Assertions and references count as able to (a safe answer for the caller).
    def nullable(self, index: int) -> bool:
        at = index * 6
        kind = self.nodes[at]
        a = self.nodes[at + 1]
        b = self.nodes[at + 2]
        if kind == 1 or kind == 2 or kind == 3 or kind == 9:
            return False
        if kind == 8:
            return self.nullable(a)
        if kind == 5:
            return self.nullable(a) and self.nullable(b)
        if kind == 6:
            return self.nullable(a) or self.nullable(b)
        if kind == 7:
            return self.nodes[at + 3] == 0 or self.nullable(a)
        return True

    def build(self, index: int, next: int) -> int:
        at = index * 6
        kind = self.nodes[at]
        a = self.nodes[at + 1]
        b = self.nodes[at + 2]
        flags = self.nodes[at + 3]
        if kind == 0:
            return next
        if kind == 1 or kind == 2 or kind == 3 or kind == 4 or kind == 9 or kind == 11:
            return self.emit(kind, a, next, flags)
        if kind == 5:
            right = self.build(b, next)
            return self.build(a, right)
        if kind == 6:
            left = self.build(a, next)
            right = self.build(b, next)
            return self.emit(6, left, right)
        if kind == 8:
            close = self.emit(8, b * 2 + 1, next)
            inside = self.build(a, close)
            return self.emit(8, b * 2, inside)
        if kind == 7:
            lo = self.nodes[at + 3]
            hi = self.nodes[at + 4]
            lazy = self.nodes[at + 5] != 0
            result = next
            if hi < 0:
                branch = self.emit(6)
                guard_index = self.guards
                self.guards += 1
                inside = self.build(a, branch)
                guard = self.emit(12, guard_index, inside)
                self.code[branch * 4 + 1] = next if lazy else guard
                self.code[branch * 4 + 2] = guard if lazy else next
                result = branch
            else:
                # As in Python, once the required copies are done, an optional copy is not started where the previous optional copy
                # started (that one matched the empty string), so the repeat stops after an empty iteration; this only matters when
                # the body can match the empty string.
                guard_index = -1
                if hi > lo and self.nullable(a):
                    guard_index = self.guards
                    self.guards += 1
                # the copies are nested, so skipping a copy skips all the later ones
                for i in range(hi - lo):
                    inside = self.build(a, result)
                    if guard_index >= 0:
                        inside = self.emit(12, guard_index, inside)
                    result = self.emit(6, next if lazy else inside, inside if lazy else next)
                if guard_index >= 0:
                    result = self.emit(14, guard_index, result)
            for i in range(lo):
                result = self.build(a, result)
            return result
        if kind == 10:
            width = 0
            if b >= 3:
                width = self.width(a)
                if width < 0:
                    raise RegexError('lookbehind requires fixed width', self.nodes[at + 4], 'E488')
            stop = self.emit(13)
            inside = self.build(a, stop)
            return self.emit(10, inside, next, width * 8 + b)
        raise RuntimeError('unknown regex node', 'E11')

# Unicode rules use the same one-character tables as Tomato's string methods.
def _word(c: str, flags: int) -> bool:
    if c == '':
        return False
    if (flags & ASCII) != 0 and ord(c) >= 128:
        return False
    return c == '_' or c.isalpha() or c.isdigit()

def _category(c: str, category: int, flags: int) -> bool:
    if c == '':
        return False
    ch = chr(category)
    lower = ch.lower()
    test = False
    if lower == 'w':
        test = _word(c, flags)
    elif lower == 'd':
        test = c.isdigit() and ((flags & ASCII) == 0 or ord(c) < 128)
    else:
        test = _space(ord(c), flags)
    return not test if ch != lower else test

# \s: the characters Python's str.isspace() accepts (tab to carriage return, U+001C to U+001F, space, U+0085, U+00A0, U+1680,
# U+2000 to U+200A, U+2028, U+2029, U+202F, U+205F and U+3000); the ASCII flag keeps only tab to carriage return and space.
def _space(code: int, flags: int) -> bool:
    if code == 32 or (code >= 9 and code <= 13):
        return True
    if (flags & ASCII) != 0 or code < 28:
        return False
    return code <= 31 or code == 133 or code == 160 or code == 5760 or (code >= 8192 and code <= 8202) or code == 8232 or code == 8233 or code == 8239 or code == 8287 or code == 12288


def _equal(a: int, b: int, flags: int) -> bool:
    if a == b:
        return True
    if (flags & IGNORECASE) == 0:
        return False
    if (flags & ASCII) != 0 and (a >= 128 or b >= 128):
        return False
    return _simple_lower(a) == _simple_lower(b) or _simple_upper(a) == _simple_upper(b)

# Matching ignoring case uses the one-letter (simple) case mappings, as Python's re does; str.lower() and str.upper() use the
# full mappings, which can be longer ('ß'.upper() is 'SS'). The simple lower case differs from lower() only for U+0130; the
# simple upper case is upper() when that is one letter, else the titlecase when that is, else the letter itself (U+1F80 has
# the simple upper case U+1F88, which is also its titlecase).
def _simple_lower(c: int) -> int:
    if c == 304:
        return 105
    s = chr(c).lower()
    if len(s) == 1:
        return ord(s)
    return c

def _simple_upper(c: int) -> int:
    ch = chr(c)
    s = ch.upper()
    if len(s) == 1:
        return ord(s)
    s = ch.title()
    if len(s) == 1:
        return ord(s)
    return c

def _range_contains(spec: list[int], value: int) -> bool:
    # Ranges can overlap, so binary-search the last start <= value and retain
    # the largest end in the prefix. The parser merges overlaps below.
    lo = 0
    hi = (len(spec) - 1) // 2
    while lo < hi:
        mid = (lo + hi) // 2
        if spec[1 + mid * 2] <= value:
            lo = mid + 1
        else:
            hi = mid
    if lo == 0:
        return False
    return value <= spec[2 + (lo - 1) * 2]

def _class_match(spec: list[int], c: int, flags: int) -> bool:
    found = _range_contains(spec, c)
    if (flags & IGNORECASE) != 0 and ((flags & ASCII) == 0 or c < 128):
        found = found or _range_contains(spec, _simple_lower(c)) or _range_contains(spec, _simple_upper(c))
    i = 1
    while i < len(spec) and spec[i] < 0:
        if _category(chr(c), -spec[i] - 1, flags):
            found = True
        i += 2
    return not found if spec[0] != 0 else found

class _Budget:
    steps: int = 0
    limit: int = 0

    @init
    def make(self, limit: int):
        self.limit = limit

# Returns the capture slots, or an empty list when no path matches. Every choice
# stores a complete snapshot, so captures and loop guards are restored on failure.
def _run(code: list[int], classes: list[list[int]], entry: int, chars: list[int], start: int, endpos: int, groups: int, guards: int, full: bool, nonempty: bool, budget: _Budget) -> list[int]:
    slots: list[int] = []
    for i in range((groups + 1) * 2 + guards):
        slots.append(-1)
    stack: list[int] = []
    pc = entry
    pos = start
    steps = budget.steps
    limit = budget.limit
    while True:
        steps += 1
        if steps > limit:
            raise RegexError('too many steps (catastrophic backtracking?)', 0, 'E493')
        at = pc * 4
        op = code[at]
        a = code[at + 1]
        b = code[at + 2]
        flags = code[at + 3]
        failed = False
        if op == 0:
            if (not full or pos == endpos) and (not nonempty or pos != start):
                budget.steps = steps
                return slots
            failed = True
        elif op == 10:
            kind = flags % 8
            width = flags // 8
            if kind >= 3 and pos < width:
                if kind == 4:
                    pc = b
                else:
                    failed = True
            else:
                stack.append(-(b * 4 + kind))
                stack.append(pos)
                stack.extend(slots)
                steps += len(slots) // 8      # a choice copies every capture slot, so it costs more than one step when there are many groups
                if kind >= 3:
                    pos -= width
                pc = a
        elif op == 13:
            # Discard choices made inside this assertion, retaining its captures
            # only for a successful positive assertion.
            marker = 0
            saved_pos = pos
            old: list[int] = []
            while len(stack) > 0:
                old = []
                for i in range(len(slots)):
                    old.append(stack.pop())
                old.reverse()
                saved_pos = stack.pop()
                marker = stack.pop()
                if marker < 0:
                    break
            kind = (-marker - 1) % 4 + 1
            next = (-marker - kind) // 4
            pos = saved_pos
            if kind == 1 or kind == 3:
                for i in range((groups + 1) * 2, len(slots)):
                    slots[i] = old[i]
                pc = next
            else:
                slots = old
                failed = True
        elif op == 6:
            stack.append(b)
            stack.append(pos)
            stack.extend(slots)
            steps += len(slots) // 8
            pc = a
        elif op == 8:
            slots[a] = pos
            pc = b
        elif op == 14:
            slots[(groups + 1) * 2 + a] = -1
            pc = b
        elif op == 12:
            guard = (groups + 1) * 2 + a
            if slots[guard] == pos:
                failed = True
            else:
                slots[guard] = pos
                pc = b
        elif op == 4:
            before = chr(chars[pos - 1]) if pos > 0 else ''
            after = chr(chars[pos]) if pos < endpos else ''
            valid = False
            if a == 94:
                valid = pos == 0 or ((flags & MULTILINE) != 0 and before == '\n')
            elif a == 36:
                valid = pos == endpos or (after == '\n' and ((flags & MULTILINE) != 0 or pos + 1 == endpos))
            elif a == 65:
                valid = pos == 0
            elif a == 90:
                valid = pos == endpos
            elif a == 98:
                valid = _word(before, flags) != _word(after, flags)
            elif a == 66:
                valid = _word(before, flags) == _word(after, flags)
            if valid:
                pc = b
            else:
                failed = True
        elif op == 11:
            begin = slots[a * 2]
            finish = slots[a * 2 + 1]
            if begin < 0 or finish < 0 or pos + finish - begin > endpos:
                failed = True
            else:
                # the comparison costs as many steps as the characters it looks at, and stops at the first difference
                i = 0
                while i < finish - begin:
                    if not _equal(chars[begin + i], chars[pos + i], flags):
                        failed = True
                        break
                    i += 1
                steps += i
                if not failed:
                    pos += finish - begin
                    pc = b
        elif pos >= endpos:
            failed = True
        else:
            c = chars[pos]
            valid = False
            if op == 1:
                valid = _equal(c, a, flags)
            elif op == 2:
                valid = c != 10 or (flags & DOTALL) != 0
            elif op == 3:
                valid = _class_match(classes[a], c, flags)
            elif op == 9:
                valid = _category(chr(c), a, flags)
            if valid:
                pos += 1
                pc = b
            else:
                failed = True
        if failed:
            while True:
                if len(stack) == 0:
                    budget.steps = steps
                    return []
                for i in range(len(slots) - 1, -1, -1):
                    slots[i] = stack.pop()
                pos = stack.pop()
                pc = stack.pop()
                if pc >= 0:
                    break
                kind = (-pc - 1) % 4 + 1
                next = (-pc - kind) // 4
                if kind == 2 or kind == 4:
                    pc = next
                    break

# The step budget of a call is step_limit plus 16 steps for each character of the text, so that plain forward progress over a long
# text (a few steps per start position) never uses up the budget; only backtracking beyond that allowance does.
def _budget(limit: int, end: int) -> _Budget:
    return _Budget(limit + 16 * end)


def _find_prefix(chars: list[int], prefix: list[int], start: int, endpos: int) -> int:
    # the first index at or after start where prefix lies wholly before endpos, or -1; a scan over the code points,
    # because str.find with positions converts character offsets to byte offsets and costs the whole text on each call
    n = len(prefix)
    first = prefix[0]
    last = endpos - n
    i = start
    while i <= last:
        if chars[i] == first:
            k = 1
            while k < n and chars[i + k] == prefix[k]:
                k += 1
            if k == n:
                return i
        i += 1
    return -1


def _codes(text: str) -> list[int]:
    result: list[int] = []
    for c in text:
        result.append(ord(c))
    return result

export class Pattern:
    pattern: str = ''
    flags: int = 0
    groups: int = 0
    groupindex: dict[str, int] = {}
    step_limit: int = 20000000
    private code: list[int] = []
    private classes: list[list[int]] = []
    private entry: int = 0
    private guards: int = 0
    private prefix: list[int] = []
    private cached_text: str = ''
    private cached_chars: list[int] = []
    private cached: bool = False

    @init
    def make(self, pattern: str, flags: int = 0):
        if flags < 0 or (flags & ~346) != 0:
            raise ValueError('unsupported regular expression flags', 'E495')
        self.pattern = pattern
        parser = _Parser(pattern, flags)
        root = parser.parse()
        compiler = _Compiler(parser.nodes)
        end = compiler.emit(0)
        close = compiler.emit(8, 1, end)
        body = compiler.build(root, close)
        self.entry = compiler.emit(8, 0, body)
        self.code = compiler.code
        self.classes = parser.classes
        self.guards = compiler.guards
        self.groups = parser.groups
        self.groupindex = parser.groupindex
        self.flags = parser.flags
        prefix: list[int] = []
        pc = self.entry
        while True:
            op = self.code[pc * 4]
            if op == 8:
                pc = self.code[pc * 4 + 2]
            elif op == 1 and (self.code[pc * 4 + 3] & IGNORECASE) == 0:
                prefix.append(self.code[pc * 4 + 1])
                pc = self.code[pc * 4 + 2]
            else:
                break
        self.prefix = prefix

    # match, search and fullmatch keep the code points of the last text they saw, so a loop that advances `pos` over one
    # text converts it once instead of once per call
    def private codes_of(self, text: str) -> list[int]:
        if self.cached and text == self.cached_text:
            return self.cached_chars
        chars = _codes(text)
        self.cached_text = text
        self.cached_chars = chars
        self.cached = True
        return chars

    def private locate(self, text: str, chars: list[int], pos: int, endpos: int, scan: bool, full: bool, nonempty: bool, budget: _Budget) -> Match | None:
        candidate = pos
        while candidate <= endpos:
            if scan and len(self.prefix) != 0:
                candidate = _find_prefix(chars, self.prefix, candidate, endpos)
                if candidate < 0:
                    break
            slots = _run(self.code, self.classes, self.entry, chars, candidate, endpos, self.groups, self.guards, full, nonempty, budget)
            if len(slots) != 0:
                return Match(text, pos, endpos, self, slots)
            if not scan:
                break
            candidate += 1
        return None

    def match(self, text: str, pos: int = 0, endpos: int = -1) -> Match | None:
        chars = self.codes_of(text)
        end = len(chars) if endpos < 0 else min(endpos, len(chars))
        start = min(len(chars), max(0, pos))
        return self.locate(text, chars, start, end, False, False, False, _budget(self.step_limit, end))

    def search(self, text: str, pos: int = 0, endpos: int = -1) -> Match | None:
        chars = self.codes_of(text)
        end = len(chars) if endpos < 0 else min(endpos, len(chars))
        start = min(len(chars), max(0, pos))
        return self.locate(text, chars, start, end, True, False, False, _budget(self.step_limit, end))

    def fullmatch(self, text: str, pos: int = 0, endpos: int = -1) -> Match | None:
        chars = self.codes_of(text)
        end = len(chars) if endpos < 0 else min(endpos, len(chars))
        start = min(len(chars), max(0, pos))
        return self.locate(text, chars, start, end, False, True, False, _budget(self.step_limit, end))

    def private collect(self, text: str, limit: int) -> list[Match]:
        if limit < 0:
            return []
        chars = _codes(text)
        end = len(chars)
        budget = _budget(self.step_limit, end)
        result: list[Match] = []
        cursor = 0
        after_empty = False
        while cursor <= end:
            found = self.locate(text, chars, cursor, end, not after_empty, False, after_empty, budget)
            if found is None:
                if after_empty:
                    cursor += 1
                    after_empty = False
                    continue
                break
            found.pos = 0
            result.append(found)
            if limit > 0 and len(result) >= limit:
                break
            start = found.start()
            cursor = found.end()
            after_empty = start == cursor
        return result

    def finditer(self, text: str) -> list[Match]:
        return self.collect(text, 0)

    def findall(self, text: str) -> list[str]:
        result: list[str] = []
        for m in self.finditer(text):
            result.append(m.group())
        return result

    def findall_groups(self, text: str) -> list[list[str]]:
        result: list[list[str]] = []
        for m in self.finditer(text):
            result.append(m.groups())
        return result

    def sub(self, repl: str, text: str, count: int = 0) -> str:
        return self.subn(repl, text, count)[0]

    def subn(self, repl: str, text: str, count: int = 0) -> tuple[str, int]:
        empty_slots: list[int] = []
        for i in range((self.groups + 1) * 2):
            empty_slots.append(-1)
        Match(text, 0, len(text), self, empty_slots).expand(repl)
        parts: list[str] = []
        cursor = 0
        done = 0
        for m in self.collect(text, count):
            parts.append(text[cursor:m.start()])
            parts.append(m.expand(repl))
            cursor = m.end()
            done += 1
        parts.append(text[cursor:len(text)])
        return ''.join(parts), done

    def sub_with(self, repl: fn(Match) -> str, text: str, count: int = 0) -> str:
        parts: list[str] = []
        cursor = 0
        done = 0
        for m in self.collect(text, count):
            parts.append(text[cursor:m.start()])
            parts.append(repl(m))
            cursor = m.end()
            done += 1
        parts.append(text[cursor:len(text)])
        return ''.join(parts)

    def split(self, text: str, maxsplit: int = 0) -> list[str]:
        result: list[str] = []
        cursor = 0
        done = 0
        for m in self.collect(text, maxsplit):
            result.append(text[cursor:m.start()])
            result.extend(m.groups())
            cursor = m.end()
            done += 1
        result.append(text[cursor:len(text)])
        return result

export class Match:
    string: str = ''
    pos: int = 0
    endpos: int = 0
    re: Pattern
    private slots: list[int] = []

    @init
    def make(self, text: str, pos: int, endpos: int, pattern: Pattern, slots: list[int]):
        self.string = text
        self.pos = pos
        self.endpos = endpos
        self.re = pattern
        self.slots = slots

    def private index(self, key: int | str) -> int:
        if key is str:
            if key not in self.re.groupindex:
                raise IndexError(f'no such group {key}', 'E496')
            return self.re.groupindex[key]
        if key < 0 or key > self.re.groups:
            raise IndexError(f'no such group {key}', 'E496')
        return key

    def start(self, key: int | str = 0) -> int:
        return self.slots[self.index(key) * 2]

    def end(self, key: int | str = 0) -> int:
        return self.slots[self.index(key) * 2 + 1]

    def span(self, key: int | str = 0) -> tuple[int, int]:
        return self.start(key), self.end(key)

    def matched(self, key: int | str = 0) -> bool:
        return self.start(key) >= 0

    def group(self, key: int | str = 0) -> str:
        a = self.start(key)
        if a < 0:
            return ''
        return self.string[a:self.end(key)]

    def groups(self) -> list[str]:
        result: list[str] = []
        for i in range(1, self.re.groups + 1):
            result.append(self.group(i))
        return result

    def groupdict(self) -> dict[str, str]:
        result: dict[str, str] = {}
        for name in self.re.groupindex:
            result[name] = self.group(name)
        return result

    def expand(self, template: str) -> str:
        parts: list[str] = []
        i = 0
        while i < len(template):
            c = template[i]
            i += 1
            if c != '\\':
                parts.append(c)
                continue
            if i == len(template):
                raise RegexError('trailing escape in replacement', i - 1, 'E494')
            c = template[i]
            i += 1
            if c == 'g':
                if i >= len(template) or template[i] != '<':
                    raise RegexError('bad group reference in replacement', i - 2, 'E494')
                i += 1
                begin = i
                while i < len(template) and template[i] != '>':
                    i += 1
                if i == len(template) or i == begin:
                    raise RegexError('bad group reference in replacement', begin, 'E494')
                key = template[begin:i]
                i += 1
                try:
                    parts.append(self.group(int(key)) if key.isdigit() else self.group(key))
                catch IndexError as error:
                    raise RegexError(error.message, begin, 'E494')
            elif c == '0':
                # an octal escape as in Python: \0 and up to two more octal digits
                value = 0
                for k in range(2):
                    if i < len(template) and template[i] >= '0' and template[i] <= '7':
                        value = value * 8 + ord(template[i]) - 48
                        i += 1
                parts.append(chr(value))
            elif c >= '1' and c <= '9':
                key = c
                if i < len(template) and template[i] >= '0' and template[i] <= '9':
                    key += template[i]
                    i += 1
                    # three octal digits are a character (at most \377), not a group reference, as in Python
                    if c <= '7' and template[i - 1] <= '7' and i < len(template) and template[i] >= '0' and template[i] <= '7':
                        value = (ord(c) - 48) * 64 + (ord(template[i - 1]) - 48) * 8 + ord(template[i]) - 48
                        i += 1
                        if value > 255:
                            raise RegexError('octal escape is out of range', i - 4, 'E494')
                        parts.append(chr(value))
                        continue
                try:
                    parts.append(self.group(int(key)))
                catch IndexError as error:
                    raise RegexError(error.message, i - len(key) - 1, 'E494')
            elif c == 'n':
                parts.append('\n')
            elif c == 't':
                parts.append('\t')
            elif c == 'r':
                parts.append('\r')
            elif c == 'a':
                parts.append(chr(7))
            elif c == 'b':
                parts.append(chr(8))
            elif c == 'f':
                parts.append(chr(12))
            elif c == 'v':
                parts.append(chr(11))
            elif c == '\\':
                parts.append('\\')
            elif c.isalpha() and ord(c) < 128:
                raise RegexError('unknown escape in replacement', i - 2, 'E494')
            else:
                parts.append('\\' + c)
        return ''.join(parts)

export def compile(pattern: str, flags: int = 0) -> Pattern:
    return Pattern(pattern, flags)

export def match(pattern: str, text: str, flags: int = 0) -> Match | None:
    return compile(pattern, flags).match(text)

export def search(pattern: str, text: str, flags: int = 0) -> Match | None:
    return compile(pattern, flags).search(text)

export def fullmatch(pattern: str, text: str, flags: int = 0) -> Match | None:
    return compile(pattern, flags).fullmatch(text)

export def findall(pattern: str, text: str, flags: int = 0) -> list[str]:
    return compile(pattern, flags).findall(text)

export def findall_groups(pattern: str, text: str, flags: int = 0) -> list[list[str]]:
    return compile(pattern, flags).findall_groups(text)

export def finditer(pattern: str, text: str, flags: int = 0) -> list[Match]:
    return compile(pattern, flags).finditer(text)

export def sub(pattern: str, repl: str, text: str, count: int = 0, flags: int = 0) -> str:
    return compile(pattern, flags).sub(repl, text, count)

export def sub_with(pattern: str, repl: fn(Match) -> str, text: str, count: int = 0, flags: int = 0) -> str:
    return compile(pattern, flags).sub_with(repl, text, count)

export def subn(pattern: str, repl: str, text: str, count: int = 0, flags: int = 0) -> tuple[str, int]:
    return compile(pattern, flags).subn(repl, text, count)

export def split(pattern: str, text: str, maxsplit: int = 0, flags: int = 0) -> list[str]:
    return compile(pattern, flags).split(text, maxsplit)
