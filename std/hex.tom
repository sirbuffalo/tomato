# Hexadecimal text for binary data, as Python's `bytes.hex()` and `bytes.fromhex()` (`import hex`). Binary data is
# `bytes`:
#
#     print(hex.encode(b'\xde\xad\xbe\xef'))      # deadbeef
#     print(hex.decode('DEADbeef'))                  # b'\xde\xad\xbe\xef'
#
#   encode(data: bytes) -> str          two lower-case digits per byte
#   decode(text: str) -> bytes          two digits (either case) per byte
#
# Decoding is strict, as Python's `binascii.unhexlify` is, and unlike `bytes.fromhex`: an odd number of digits or any
# character that is not 0-9, a-f or A-F (spaces included) is a ValueError.

# Lower-case hex digits of the bytes.
export def encode(data: bytes) -> str:
    return data.hex()

def _digit(c: str) -> int:
    n = ord(c)
    if n >= 48 and n <= 57:
        return n - 48
    if n >= 97 and n <= 102:
        return n - 87
    if n >= 65 and n <= 70:
        return n - 55
    raise ValueError(f"a hex text holds only the digits 0-9 and a-f, but got '{c}'", 'E395')

# The bytes of a hex text.
export def decode(text: str) -> bytes:
    if len(text) % 2 != 0:
        raise ValueError(f'a hex text needs an even number of digits, but got {len(text)}', 'E394')
    out: list[int] = []
    for i in range(0, len(text), 2):
        out.append(_digit(text[i]) * 16 + _digit(text[i + 1]))
    return bytes(out)
